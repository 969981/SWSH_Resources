[
  {
    "index": 0,
    "flags": 0,
    "text": "\u30D5\u30AC\u30FC\uFF01\u3000\u30D5\u30AC\u30AC\u30AC\u30FC\uFF01\\c\\n\u304A\u308C\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u3060\uFF01\\n\u304A\u307E\u3048\u3000\u304A\u308C\u3068\u3000\u52DD\u8CA0\u3057\u308D\u30FC\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u307E\u3042\u3000\u304D\u3044\u3066\u304F\u308C\\c\\n\u30D2\u30D0\u30CB\u30FC\u3068\u3000\u30E4\u30AF\u30C7\u306F\\n\u540C\u3058\u3000\u7A2E\u65CF\u304B\uFF1F\u3000\u9055\u3046\u3060\u308D\u3046\uFF1F\\c\\n\u3067\u3082\u3000\u304A\u308C\u305F\u3061\u306F\u3000\u305D\u308C\u3092\u307E\u3068\u3081\u3066\\n\u30DD\u30B1\u30E2\u30F3\u3068\u3000\u547C\u3076\\c\\n\u30D2\u30D0\u30CB\u30FC\u3068\u3000\u304A\u308C\u3082\u3000\u9055\u3046\u7A2E\u65CF\\n\u304A\u308C\u3068\u3000\u30E4\u30AF\u30C7\u3082\u3000\u9055\u3046\u7A2E\u65CF\u3060\\c\\n\u3060\u3063\u305F\u3089\u3000\u304A\u308C\u3092\u3000\u30DD\u30B1\u30E2\u30F3\u3068\\n\u547C\u3093\u3067\u3082\u3000\u304B\u307E\u308F\u306A\u3044\u3058\u3083\u306A\u3044\u304B"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u2026\u2026\u3044\u3084\\n\u6C17\u3092\u3064\u304B\u3063\u3066\u304F\u308C\u306A\u304F\u3066\u3000\u3044\u3044\u3093\u3060\\r\\n\u7121\u7406\u304C\u3042\u308B\u306E\u306F\u3000\u81EA\u5206\u3082\u3000\u308F\u304B\u3063\u3066\u308B\\c\\n\u304A\u308C\u306F\u2026\u2026\\n\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u306A\u308A\u305F\u304B\u3063\u305F\u3093\u3060\u3088"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u306A\u308C\u307E\u3059\u3088"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u2026\u2026\u30D5\u30A1\u30A4\u30C8\u3067\u3059"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u305D\u3046\u3060\uFF01\u3000\u30D5\u30A1\u30C3\u30B7\u30E7\u30F3\u3092\u3000\u5909\u3048\u308C\u3070\\n\u6C17\u6301\u3061\u3082\u3000\u5909\u308F\u308B\u3060\u308D\u3046\\c\\n\u3064\u307E\u308A\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u6C17\u6301\u3061\u306B\u3000\u306A\u308C\u3070\\n\u3042\u308B\u610F\u5473\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u306A\u308C\u305F\u3068\\r\\n\u3044\u3063\u3066\u3082\u3000\u3044\u3044\u306E\u3067\u306F\u306A\u3044\u304B\uFF01\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u304D\u307F\uFF01\u3000\u304A\u308C\u306E\u3000\u71C3\u3048\u3042\u304C\u308B\u3000\u6C17\u6301\u3061\u3092\\n\u8868\u73FE\u3057\u3066\u3044\u308B\u3088\u3046\u306A\u3000\u670D\u3092\uFF01\\c\\n\u708E\u3092\u611F\u3058\u308B\u3000\u30C7\u30B6\u30A4\u30F3\u306E\u3000\u670D\u3092\uFF01\\n\u304A\u308C\u306E\u524D\u3067\u3000\u7740\u3066\u304F\u308C\u306A\u3044\u304B\u306D\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u2026\u2026\u3044\u3084\\n\u6C17\u3092\u3064\u304B\u3063\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u305F\u3044\u304C\\r\\n\u305D\u308C\u3067\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u306A\u308C\u306A\u3044\u3093\u3060\u3088\\c\\n\u708E\u3092\u611F\u3058\u308B\u3000\u30C7\u30B6\u30A4\u30F3\u306E\u3000\u670D\u3092\uFF01\\n\u304A\u308C\u306E\u524D\u3067\u3000\u7740\u3066\u304F\u308C\u306A\u3044\u304B\u306D\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u306A\u3093\u3060\u3044\uFF1F\u3000\u305D\u3044\u3064\u306F\uFF1F\u3000\u307E\u308B\u3067\\n\u304A\u308C\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u306A\u3063\u305F\u3088\u3046\u3060\\c\\n\u708E\u3092\u611F\u3058\u308B\u3000\u71B1\u3044\u3000\u30A2\u30A4\u30C6\u30E0\u306A\u3089\\n\u8EAB\u306B\u3064\u3051\u308B\u3053\u3068\u3067\u3000\u6C17\u6301\u3061\u304C\u5909\u308F\u308A\\r\\n\u304A\u308C\u3092\u3000\u307B\u306E\u304A\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u3057\u3066\u304F\u308C\u308B\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6C17\u3092\u3064\u304B\u3063\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\u3046\uFF01\\n\u3055\u3055\u3084\u304B\u306A\u3000\u3082\u306E\u3060\u304C\u3000\u53D7\u3051\u53D6\u3063\u3066\u304F\u308C\\c\\n\u30A2\u30AF\u30ED\u30D0\u30C3\u30C8\u306E\u3000\u6280\u306F\\n\u9053\u5177\u3092\u3000\u6301\u3063\u3066\u3044\u306A\u3044\u3068\\r\\n\u30C0\u30E1\u30FC\u30B8\u304C\u3000\u5897\u3048\u308B\u306E\u3060\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u304A\u308C\u3000\u8003\u3048\u305F\u3093\u3060\u3051\u3069\u3055\u3000\u3082\u3057\\n\u304A\u308C\u304C\u3000\u30A6\u30C3\u30A6\u306B\u3000\u98F2\u307E\u308C\u305F\u3068\u304D\\r\\n\u3060\u308C\u304B\u306B\u3000\u6355\u307E\u3048\u3089\u308C\u305F\u3089\\c\\n\u304A\u308C\u3082\u3000\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\u306B\\n\u5165\u3063\u305F\u3053\u3068\u306B\u3000\u306A\u308B\u3088\u306A\uFF1F\\c\\n\u305D\u3046\u3057\u305F\u3089\u3000\u304A\u308C\u306F\u3000\u4EBA\u985E\u3067\\n\u306F\u3058\u3081\u3066\u3000\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\u306B\\r\\n\u6355\u307E\u3063\u305F\u3000\u7537\uFF01\u3000\u306B\u306A\u3089\u306A\u3044\u304B\u306A\uFF1F\\c\\n\u3059\u306A\u308F\u3061\\n\u304A\u308C\u3000\u30A4\u30B3\u30FC\u30EB\u3000\u30DD\u30B1\u30E2\u30F3\u3000\u306A\u306E\u3067\u306F\uFF1F\\r\\n\u9055\u3046\u304B\uFF1F\u3000\u3046\u3093\u3000\u9055\u3046\u306A\uFF01"
  },
