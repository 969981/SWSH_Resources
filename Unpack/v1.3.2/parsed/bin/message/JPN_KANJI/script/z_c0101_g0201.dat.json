[
  {
    "index": 0,
    "flags": 0,
    "text": "\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\uFF01\\c\\n\u30AB\u30D6\u3055\u3093\u306B\u3000\u6311\u3080\u306A\u3089\\n\u30BF\u30FC\u30D5\u30BF\u30A6\u30F3\u306E\u3000\u304F\u3055\u30D0\u30C3\u30B8\u3068\\r\\n\u30D0\u30A6\u30BF\u30A6\u30F3\u306E\u3000\u307F\u305A\u30D0\u30C3\u30B8\u304C\u3000\u3044\u308B\u305E\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u304A\u304A\u3000\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\uFF01\\n\u30D0\u30C3\u30B8\u304C\u3000\uFF12\u3064\u3068\u306F\u3000\u3059\u3070\u3089\u3057\u3044\u305E\uFF01\\c\\n\u30AB\u30D6\u3055\u3093\u3060\u304C\u3000\u7279\u8A13\u3067\\n\u7B2C\u4E8C\u9271\u5C71\u306B\u3000\u3044\u308B\u3089\u3057\u3044\u305C\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u3042\u3089\u2026\u2026\u3000\u672C\u65E5\u306F\u3000\u9045\u3044\u306E\u3067\\n\u307E\u305F\u3000\u660E\u65E5\u3000\u3044\u3089\u3057\u3066\u304F\u3060\u3055\u3044\\c\\n\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u306E\u3000\u307F\u306A\u3055\u3093\u306F\\n\u30DB\u30C6\u30EB\u3000\u30B9\u30DC\u30DF\u30FC\u30A4\u30F3\u306B\u3000\u6CCA\u307E\u308C\u307E\u3059\u3088"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u540C\u58EB\\n\u529B\u306E\u3000\u9650\u308A\u3092\u3000\u5C3D\u304F\u3057\u307E\u3057\u3087\u3046\u306D"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u307E\u305A\u306F\u3000\u30BF\u30FC\u30D5\u30BF\u30A6\u30F3\u306D\uFF01\\n\u3055\u3042\u3000\uFF13\u756A\u9053\u8DEF\u306B\u3000\u5411\u304B\u3044\u307E\u3057\u3087\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u3053\u3053\u307E\u3067\u3000\u304D\u305F\u3051\u308C\u3069\u2026\u2026\\n\u52DD\u3066\u308B\u3000\u81EA\u4FE1\u304C\u3000\u306A\u304F\u306A\u3063\u305F\u3088\\r\\n\u306F\u3042\u3000\u3069\u3046\u3057\u3088\u3046\u304B\u306A\u3042"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u3042\u306A\u305F\u306E\u3000\u30DD\u30B1\u30E2\u30F3\\n\u304C\u3093\u3070\u308C\u308B\u306E\u3000\u3059\u3054\u3044\u3088\u306D\u2026\u2026\\c\\n\u8A66\u5408\u3092\u3000\u307F\u3066\u3044\u305F\u3089\\n\u306A\u3093\u3060\u304B\u3000\u5FDC\u63F4\u3055\u308C\u305F\u307F\u305F\u3044"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u958B\u4F1A\u5F0F\u2026\u2026\\n\u5BB6\u65CF\u3082\u3000\u30C6\u30EC\u30D3\u3067\u3000\u307F\u3066\u3044\u308B\u2026\u2026\\c\\n\u3082\u3046\u4E00\u5EA6\u3000\u93E1\u3067\\n\u9AEA\u578B\u3092\u3000\u30C1\u30A7\u30C3\u30AF\u3059\u308B\u304B"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u30ED\u30FC\u30BA\u59D4\u54E1\u9577\u306E\u3000\u3042\u3044\u3055\u3064\u2026\u2026\\n\u304C\u305C\u3093\u3000\u3084\u308B\u6C17\u304C\u3000\u3067\u3066\u304D\u307E\u3057\u305F\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u304F\u3055\u30D0\u30C3\u30B8\u2026\u2026\u3000\u307F\u305A\u30D0\u30C3\u30B8\u2026\u2026\\n\u3067\u3082\u3000\u307B\u306E\u304A\u30D0\u30C3\u30B8\u306F\u3000\u53D6\u308C\u308B\u306E\u304B"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u30AB\u30D6\u3055\u3093\u306B\u3000\u52DD\u3063\u305F\u3060\u3068\uFF01\uFF1F\\n\u304D\u307F\u306F\u3000\u3059\u3054\u3044\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u3060\\c\\n\u4ED6\u306E\u3000\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u306B\u3082\\n\u52DD\u8CA0\u3092\u3000\u6311\u307E\u308C\u308B\u304B\u3082\u306A"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4ECA\u56DE\u306E\u3000\u5927\u4F1A\u306F\u3000\u59D4\u54E1\u9577\u3084\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306B\u3000\u63A8\u85A6\u3055\u308C\u305F\\r\\n\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u304C\u3000\u3044\u308B\u3093\u3060\u3063\u3066"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uFF18\u500B\u306E\u3000\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\u3000\u96C6\u3081\u308B\u2026\u2026\\n\u306A\u3093\u3060\u304B\u3000\u5B9D\u96C6\u3081\u3000\u307F\u305F\u3044\u306D\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3068\u306E\u3000\u8A66\u5408\\n\u3069\u3093\u306A\u3000\u6226\u3044\u306B\u3000\u306A\u308B\u304B\u3057\u3089"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u30C0\u30F3\u30C7\u3055\u3093\u306B\u3000\u63A8\u85A6\u3055\u308C\u305F\\n\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u306D\\r\\n\u30AB\u30D6\u3055\u3093\u306B\u3000\u6311\u3080\u306A\u3093\u3066\u3000\u3055\u3059\u304C"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u3055\u3059\u304C\u306F\u3000\u30C0\u30F3\u30C7\u3055\u3093\u306D\\c\\n\u3042\u306A\u305F\u306E\u3088\u3046\u306A\u3000\u512A\u308C\u305F\u3000\u624D\u80FD\u306E\\n\u6301\u3061\u4E3B\u3092\u3000\u63A8\u85A6\u3059\u308B\u3060\u306A\u3093\u3066"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u958B\u4F1A\u5F0F\u306E\u3000\u524D\u304B\u3089\\n\u30D3\u30D3\u30C3\u3066\u3066\u3000\u3069\u3046\u3059\u308B\u306E\u3088\u3000\u3042\u305F\u3057\u2026\u2026\\c\\n\u30DC\u30FC\u30EB\u306E\u3000\u4E2D\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u305F\u3061\u306F\\n\u3084\u308B\u6C17\u3067\u3000\u6E80\u3061\u3042\u3075\u308C\u3066\u3044\u308B\u306E\u306B\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u3042\u3053\u304C\u308C\u306E\u3000\u30B9\u30BF\u30B8\u30A2\u30E0\u306B\u3000\u7ACB\u3066\u305F\u2026\u2026\\n\u4ECA\u5EA6\u306F\u3000\u8A66\u5408\u3067\u3000\u7ACB\u3063\u3066\u307F\u305B\u308B\uFF01\\c\\n\u3046\u3046\u3093\u3000\u52DD\u5229\u3057\u3066\\n\u307F\u3093\u306A\u3092\u3000\u8208\u596E\u3055\u305B\u3061\u3083\u3046\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u3053\u308C\u3060\u3051\u306E\u3000\u53C2\u52A0\u8005\u304C\u3000\u3044\u3066\u3082\\n\u52DD\u3061\u6B8B\u308B\u306E\u306F\u3000\u308F\u305A\u304B\u3000\u306A\u3093\u3060\u3088\u2026\u2026"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3092\u3000\u307F\u3066\u3000\u6E80\u8DB3\u2026\u2026\\n\u3044\u3044\u3048\u3000\u5012\u3059\u306E\u304C\u3000\u76EE\u6A19\u3060\u3088"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\\n\u3064\u3044\u306B\u3000\u958B\u5E55\u3067\u3059\u306D\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u3088\u3057\uFF01\u3000\uFF13\u756A\u9053\u8DEF\u3067\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u935B\u3048\u3088\u3046"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u307B\u306E\u304A\u306E\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\\n\u30AB\u30D6\u3055\u3093\u306B\u3000\u6311\u307F\u307E\u3059"
