  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u308F\u3051\u306E\u3000\u308F\u304B\u3089\u306A\u3044\u3000\u30D0\u30A2\u3055\u3093\u306B\\n\u30D5\u30A7\u30A2\u30EA\u30FC\u30BF\u30A4\u30D7\u306B\u3000\u3064\u3044\u3066\\r\\n\u671D\u6669\u3000\u305F\u305F\u304D\u3053\u307E\u308C\u308B\u3057\uFF01\\c\\n\u308F\u304B\u308A\u307E\u3059\u304B\uFF1F\\n\u30D4\u30F3\u30AF\u8272\u306B\u3000\u56F2\u307E\u308C\u3066\\c\\n\u30D5\u30A7\u30A2\u30EA\u30FC\u30BF\u30A4\u30D7\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u3067\\n\u30AF\u30A4\u30BA\u3068\u3000\u52DD\u8CA0\u306E\u3000\u6BCE\u65E5\uFF01[VAR 0114(000C)]"
  },
  {
