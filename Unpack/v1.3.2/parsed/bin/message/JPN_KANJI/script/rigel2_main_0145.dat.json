  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4EBA\u306E\u5B50\u3088\\n\u3088\u304F\u305E\u3000\u3084\u3063\u305F\u3067\u3042\u308B[VAR 0114(0079)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u305D\u306E\u3000\u306B\u3093\u3058\u3093\u3092\u3000\u3082\u3061\u3044\u308C\u3070\\n\u6211\u304C\u3000\u611B\u99AC\u3092\\r\\n\u304A\u3073\u304D\u5BC4\u305B\u308B\u3053\u3068\u3000\u53F6\u3044\u3057\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u3042\u3068\u306F\u3000\u30E8\u306E\u3000\u529B\u3092\u3000\u5897\u5E45\u3059\u308B\\n\u30AD\u30BA\u30CA\u306E\u30BF\u30C5\u30CA\u3000\u3055\u3048\u3000\u3042\u308C\u3070\\r\\n\u305F\u3084\u3059\u304F\u3000\u611B\u99AC\u3092\u3000\u4E57\u308A\u3053\u306A\u305B\u308B\u304C\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u3082\u306F\u3084\u3000\u4EBA\u9593\u304B\u3089\u3000\u3042\u308C\u3092\\n\u6367\u3052\u3089\u308C\u308B\u3053\u3068\u306F\u3000\u306A\u3044\u3067\u3042\u308D\u3046[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u30D0\u30B7\u30ED\u30A9\u30FC\u30B9\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u30D0\u30AF\u30ED\u30A9\u30FC\u30B9\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u3042\u3084\u3064\u306F\u3000\u6211\u304C\u3000\u611B\u99AC\\n\u2026\u2026\u30D6\u30EA\u30B6\u30DD\u30B9\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u3042\u3084\u3064\u306F\u3000\u6211\u304C\u3000\u611B\u99AC\\n\u2026\u2026\u30EC\u30A4\u30B9\u30DD\u30B9\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u3042\u306E\u3000\u767D\u304F\u3000\u8F1D\u304F\u3000\u6BDB\u4E26\u307F\uFF01\\n\u7C97\u66B4\u3000\u72FC\u85C9\u306B\u3000\u8D70\u308B\u3000\u59FF\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u3042\u306E\u3000\u9ED2\u304F\u3000\u8F1D\u304F\u3000\u6BDB\u4E26\u307F\uFF01\\n\u7C97\u66B4\u3000\u72FC\u85C9\u306B\u3000\u8D70\u308B\u3000\u59FF\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u51FA\u9022\u3044\u3057\u9803\u3068\u3000\u5FAE\u5875\u3082\u3000\u5909\u308F\u3089\u306C\\n\u3042\u3042\u3000\u61D0\u304B\u3057\u3000\u61D0\u304B\u3057\u3084\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u30B7\u30ED\u30A9\u30FC\u30B9\u2026\u2026"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u30AF\u30ED\u30A9\u30FC\u30B9\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u304A\u305D\u3089\u304F\u3000\u3042\u3084\u3064\u306F\\n\u306B\u3093\u3058\u3093\u306E\u3000\u5302\u3044\u3092\u3000\u611F\u3058\u3068\u3063\u305F\u304C\\r\\n\u8A73\u3057\u3044\u5834\u6240\u307E\u3067\u306F\u3000\u308F\u304B\u3089\u306C\u3068\u307F\u305F[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u8D70\u308A\u53BB\u3063\u305F\u3000\u65B9\u89D2\u304B\u3089\\n\u6751\u306B\u3000\u306B\u3093\u3058\u3093\u3092\u3000\u596A\u3044\u306B\u3044\u3063\u305F\u306E\u3084\u3082[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u3060\u3068\u3059\u308B\u3068\u3000\u4EBA\u306E\u5B50\u3088\\n\u30D5\u30EA\u30FC\u30BA\u6751\u304C\u3000\u5371\u3046\u3044\uFF01\\r\\n\u6025\u3044\u3067\u3000\u5411\u304B\u3046\u3067\u3042\u308B\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u30AA\u2026\u2026\u30AA\u30A4\u30E9\u306E\u3000\u7551\u306F\\n\u304A\u307E\u3048\u306A\u3093\u304B\u306B\u3000\u8352\u3089\u3055\u305B\u306D\u3047\u305E\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u305F\u3000\u5927\u5909\u3058\u3083\u3042\uFF01\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u6751\u3067\u3000\u66B4\u308C\u3068\u308B\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u3042\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u2026\u2026\\n\u307E\u3055\u304B\u3000\u304A\u3068\u304E\u8A71\u306E\uFF01\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u3042\u3093\u306A\u3000\u3067\u3063\u304B\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n\u66B4\u308C\u3089\u308C\u305F\u3089\u3000\u305F\u307E\u3063\u305F\u3082\u3093\u3058\u3083\u306A\u3044\uFF01\\c\\n\u8AB0\u304B\u3000\u3042\u306E\u3000\u66B4\u308C\u3093\u574A\u3092\\n\u9759\u304B\u306B\u3000\u3055\u305B\u3068\u304F\u308C\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u306A\u3093\u3060\u304B\u3000\u3055\u308F\u304C\u3057\u3044\u308F\u306D\u3047\\n\u304A\u796D\u308A\u306E\u3000\u5B63\u7BC0\u304B\u3057\u3089\uFF1F"
