[
  {
    "index": 0,
    "flags": 0,
    "text": "\u308F\u305F\u3057\u306F\u3000\u4EBA\u547C\u3093\u3067\\n\u6398\u308A\u51FA\u3057\u30DE\u30C0\u30E0\u2026\u2026\\c\\n\u6398\u308A\u51FA\u3057\u30AA\u30E4\u30B8\u306B\u306F\u3000\u4F1A\u3063\u305F\uFF1F\\n\u308F\u305F\u3057\u306E\u3000\u30D1\u30FC\u30C8\u30CA\u30FC\u3000\u306A\u306E\u3088"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u76F8\u68D2\u306E\u3000\u30B9\u30B3\u30C3\u30D7\u2026\u2026\u3000\u30DE\u30A4\u30FB\u30B9\u30D7\u30FC\u30F3\u3067\\n\u7A74\u6398\u308A\u3068\u3000\u30B9\u30EA\u30EB\u3092\u3000\u697D\u3057\u3093\u3067\u308B\u306E"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u51FA\u4F1A\u3048\u305F\u8A18\u5FF5\u306B\u3000\u30E8\u30ED\u30A4\u3053\u3046\u305B\u304D\u3092\\n\uFF11\u500B\u3000\u5DEE\u3057\u4E0A\u3052\u305F\u3044\u3000\u6C17\u5206\u2026\u2026"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u2026\u2026\u3044\u3044\u3048\uFF01\u3000\u3067\u3082\uFF01\uFF01\\c\\n\u3042\u306A\u305F\u306F\u3000\u30E8\u30ED\u30A4\u3053\u3046\u305B\u304D\u3092\\n\u305D\u306E\u307E\u307E\u3000\u53D7\u3051\u53D6\u308B\u3053\u3068\u3082\u3000\u3067\u304D\u308B\u3057\\c\\n\u305D\u308C\u3092\u3000\u5143\u624B\u306B\u3000\u7A74\u6398\u308A\u3057\u3066\\n\u3053\u3046\u305B\u304D\u3092\u3000\u5897\u3084\u3059\u3053\u3068\u3082\u3000\u3067\u304D\u308B\u306E\u3088"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u305F\u3060\u3057\uFF01\u3000\u6398\u3063\u3066\u308B\u3000\u9014\u4E2D\u3067\\n\u30DE\u30A4\u30FB\u30B9\u30D7\u30FC\u30F3\u304C\u3000\u58CA\u308C\u305F\u3089\\r\\n\u3042\u306A\u305F\u306E\u3000\u3068\u308A\u3076\u3093\u306F\u3000\u30BC\u30ED\u2026\u2026"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u30EC\u30DD\u30FC\u30C8\u3092\u3000\u66F8\u3044\u3066\u3082\u3089\u3046\u3051\u3069\\n\u3042\u306A\u305F\u304C\u3000\u30B9\u30EA\u30EB\u3092\u3000\u6C42\u3081\u308B\u306A\u3089\\r\\n\u308F\u305F\u3057\u306B\u3000\u4EBA\u751F\u3000\u305F\u304F\u3057\u3066\u307F\u308B\uFF1F"
