  },
  {
    "index": 48,
    "flags": 0,
    "text": "Ei erhalten: [VAR 0201(0007)].[VAR 0201(0006)].20[VAR 0201(0005)]\\nHerkunft: [VAR FF00(0002)][VAR 0105(0008)][VAR FF00(0000)]\\nAus dem Ei geschl\u00FCpft: [VAR 0201(0002)].[VAR 0201(0001)].20[VAR 0201(0000)]\\nOrt: [VAR FF00(0002)][VAR 0105(0004)][VAR FF00(0000)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "Ei erhalten: [VAR 0201(0007)].[VAR 0201(0006)].20[VAR 0201(0005)]\\nHerkunft: [VAR FF00(0002)][VAR 0105(0008)][VAR FF00(0000)]\\nOffenbar aus dem Ei geschl\u00FCpft:\\n[VAR 0201(0002)].[VAR 0201(0001)].20[VAR 0201(0000)]\\nOrt: [VAR FF00(0002)][VAR 0105(0004)][VAR FF00(0000)]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "Liebt es zu essen."
  },
  {
    "index": 51,
    "flags": 0,
    "text": "Nickt oft ein."
  },
  {
    "index": 52,
    "flags": 0,
    "text": "Schl\u00E4ft gern."
  },
  {
    "index": 53,
    "flags": 0,
    "text": "Macht oft Unordnung."
  },
  {
    "index": 54,
    "flags": 0,
    "text": "Mag es, sich zu entspannen."
  },
  {
    "index": 55,
    "flags": 0,
    "text": "Ist stolz auf seine St\u00E4rke."
  },
  {
    "index": 56,
    "flags": 0,
    "text": "Pr\u00FCgelt sich gern."
  },
  {
    "index": 57,
    "flags": 0,
    "text": "Besitzt Temperament."
  },
  {
    "index": 58,
    "flags": 0,
    "text": "Liebt K\u00E4mpfe."
  },
  {
    "index": 59,
    "flags": 0,
    "text": "Ist impulsiv."
  },
  {
    "index": 60,
    "flags": 0,
    "text": "Hat einen robusten K\u00F6rper."
  },
  {
    "index": 61,
    "flags": 0,
    "text": "Kann Treffer gut verkraften."
  },
  {
    "index": 62,
    "flags": 0,
    "text": "Ist \u00E4u\u00DFerst z\u00E4h."
  },
  {
    "index": 63,
    "flags": 0,
    "text": "Hat eine gute Ausdauer."
  },
  {
    "index": 64,
    "flags": 0,
    "text": "Ist beharrlich."
  },
  {
    "index": 65,
    "flags": 0,
    "text": "Ist gerne schnell unterwegs."
  },
  {
    "index": 66,
    "flags": 0,
    "text": "Achtet auf Ger\u00E4usche."
  },
  {
    "index": 67,
    "flags": 0,
    "text": "Ist ungest\u00FCm und einf\u00E4ltig."
  },
  {
    "index": 68,
    "flags": 0,
    "text": "Ist ein bisschen albern."
  },
  {
    "index": 69,
    "flags": 0,
    "text": "Fl\u00FCchtet schnell."
  },
  {
    "index": 70,
    "flags": 0,
    "text": "Ist sehr neugierig."
  },
  {
    "index": 71,
    "flags": 0,
    "text": "Ist hinterh\u00E4ltig."
  },
  {
    "index": 72,
    "flags": 0,
    "text": "Ist \u00E4u\u00DFerst gerissen."
  },
  {
    "index": 73,
    "flags": 0,
    "text": "Ist oft in Gedanken."
  },
  {
    "index": 74,
    "flags": 0,
    "text": "Ist sehr pedantisch."
  },
  {
    "index": 75,
    "flags": 0,
    "text": "Besitzt einen starken Willen."
  },
  {
    "index": 76,
    "flags": 0,
    "text": "Ist etwas eitel."
  },
  {
    "index": 77,
    "flags": 0,
    "text": "Ist sehr aufs\u00E4ssig."
  },
  {
    "index": 78,
    "flags": 0,
    "text": "Hasst Niederlagen."
  },
  {
    "index": 79,
    "flags": 0,
    "text": "Ist dickk\u00F6pfig."
  },
  {
    "index": 80,
    "flags": 0,
    "text": "Geheimnisvolles Pok\u00E9mon-Ei erhalten:\\n[VAR 0201(0007)].[VAR 0201(0006)].20[VAR 0201(0005)]\\nHerkunft: [VAR FF00(0002)][VAR 0105(0008)][VAR FF00(0000)]"
  },
  {
    "index": 81,
    "flags": 0,
    "text": "Geheimnisvolles Pok\u00E9mon-Ei erhalten:\\n[VAR 0201(0002)].[VAR 0201(0001)].20[VAR 0201(0000)]\\nHerkunft: [VAR FF00(0002)][VAR 0105(0004)][VAR FF00(0000)]"
  },
  {
    "index": 82,
    "flags": 0,
    "text": "Sehr geheimnisvolles Pok\u00E9mon-Ei erhalten:\\n[VAR 0201(0007)].[VAR 0201(0006)].20[VAR 0201(0005)]\\nHerkunft: [VAR FF00(0002)][VAR 0105(0008)][VAR FF00(0000)]"
  },
  {
    "index": 83,
    "flags": 0,
    "text": "Sehr geheimnisvolles Pok\u00E9mon-Ei erhalten:\\n[VAR 0201(0002)].[VAR 0201(0001)].20[VAR 0201(0000)]\\nHerkunft: [VAR FF00(0002)][VAR 0105(0004)][VAR FF00(0000)]"
  },
  {
    "index": 84,
    "flags": 0,
    "text": "Geheimnisvolles Pok\u00E9mon-Ei erhalten:\\n[VAR 0201(0007)].[VAR 0201(0006)].20[VAR 0201(0005)]\\nHerkunft: [VAR FF00(0002)][VAR 0105(0008)][VAR FF00(0000)]"
  },
  {
    "index": 85,
    "flags": 0,
    "text": "Der \u201EEipr\u00FCfer\u201C erkennt:\\nMan kann schon etwas h\u00F6ren!\\nEs wird wohl bald schl\u00FCpfen!"
  },
  {
    "index": 86,
    "flags": 0,
    "text": "Der \u201EEipr\u00FCfer\u201C erkennt:\\nManchmal bewegt es sich!\\nEs braucht wohl noch ein Weilchen."
  },
  {
    "index": 87,
    "flags": 0,
    "text": "Der \u201EEipr\u00FCfer\u201C erkennt:\\nWas wird da wohl schl\u00FCpfen?\\nEs wird sicher noch lange dauern."
  },
  {
    "index": 88,
    "flags": 0,
    "text": "Der \u201EEipr\u00FCfer\u201C erkennt:\\nDieses Ei braucht sicher noch sehr viel Zeit."
  }
