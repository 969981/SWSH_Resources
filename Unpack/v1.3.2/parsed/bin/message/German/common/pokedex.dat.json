    "index": 59,
    "flags": 0,
    "text": "[~ 59]"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "Bitte w\u00E4hle ein Pok\u00E9mon aus deinem Team,\\ndas abgelegt werden soll.\\c"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "[VAR 1601(0000,0000)][VAR 0102(0000)] wurde in dein Team\\naufgenommen.\\c"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "[VAR 0102(0000)] wird in dein Team aufgenommen\\nund [VAR 0102(0001)] in eine PC-Box geschickt.\\c"
  },
  {
    "index": 63,
