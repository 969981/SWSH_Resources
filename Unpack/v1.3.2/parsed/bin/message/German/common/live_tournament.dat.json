  },
  {
    "index": 51,
    "flags": 0,
    "text": "Verbindung trennen?"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "Die Verbindung wurde getrennt."
  },
  {
    "index": 53,
    "flags": 0,
    "text": "M\u00F6chtest du ein Kampfteam registrieren,\\ndas am Turnier teilnehmen soll?"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "Willst du aus dem folgenden Turnier aussteigen?\\n\u201E[VAR 01AF(0000)]\u201C"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "Nach dem Ausstieg ist eine erneute Teilnahme\\nan diesem Turnier nicht m\u00F6glich.\\c\\nM\u00F6chtest du wirklich aus dem Turnier\\n\u201E[VAR 01AF(0000)]\u201C\\r\\naussteigen?"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "Du wurdest abgemeldet von dem Turnier\\n\u201E[VAR 01AF(0000)]\u201C\\r\\nund dein Kampfteam ist wieder freigegeben.\\c"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "Die Registrierung des Kampfteams wurde\\nabgebrochen.\\c"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "[~ 58]"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "Du hast bislang noch keine K\u00E4mpfe bestritten.\\c"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "Gegnersuche wird\\nausgef\u00FChrt..."
  },
  {
    "index": 61,
    "flags": 0,
    "text": "Verbindung wird hergestellt...\\nBitte warte einen Moment."
  },
  {
    "index": 62,
    "flags": 0,
    "text": "Bitte warte auf das Startsignal und dr\u00FCcke dann\\nden A-Knopf."
  },
  {
    "index": 63,
