  {
    "index": 152,
    "flags": 0,
    "text": "Ich tausche gerade mit [VAR 0100(0000)]!\\nDas macht total Spa\u00DF!"
  },
  {
    "index": 153,
    "flags": 0,
    "text": "Ich f\u00FChre gerade einen Zaubertausch durch!\\nWas f\u00FCr ein Pok\u00E9mon ich wohl bekomme?"
  },
  {
    "index": 154,
    "flags": 0,
    "text": "Ich hab gerade ein Pok\u00E9mon per Link-Tausch\\nerhalten und es hat sich entwickelt!"
  },
  {
    "index": 155,
    "flags": 0,
    "text": "[VAR 0202(0000)] [VAR 1101(0000,0506)]PersonLeute tausch[VAR 1101(0000,0201)]ten gerade in meiner N\u00E4he!\\nWie gro\u00DFartig ist das denn!"
  },
  {
    "index": 156,
    "flags": 0,
    "text": "Ich stecke gerade mitten in einem Einzelkampf!\\nVerlieren kommt nicht in Frage!"
  },
  {
    "index": 157,
    "flags": 0,
    "text": "Ich stecke gerade mitten in einem Doppelkampf!\\nVerlieren kommt nicht in Frage!"
  },
  {
    "index": 158,
    "flags": 0,
    "text": "Ich stecke gerade mitten in einem Multikampf!\\nVerlieren kommt nicht in Frage!"
  },
  {
    "index": 159,
    "flags": 0,
    "text": "[VAR 0202(0000)] [VAR 1101(0000,0506)]PersonLeute k\u00E4mpf[VAR 1101(0000,0201)]ten gerade in meiner N\u00E4he!\\nWie gro\u00DFartig ist das denn!"
  },
  {
    "index": 160,
    "flags": 0,
    "text": "Ich hab [VAR 0100(0000)] in einem Einzelkampf\\nbesiegt! Das war super!"
  },
  {
    "index": 161,
    "flags": 0,
    "text": "Ich hab [VAR 0100(0000)] in einem Doppelkampf\\nbesiegt! Das war super!"
  },
  {
    "index": 162,
    "flags": 0,
    "text": "Ich hab [VAR 0100(0000)] in einem Multikampf\\nbesiegt! Das war super!"
  },
  {
    "index": 163,
    "flags": 0,
    "text": "Ich hab zusammen mit anderen Trainern\\n[VAR 0101(0000)] besiegt!"
  },
  {
    "index": 164,
    "flags": 0,
    "text": "Ich hab mich mit anderen Trainern verb\u00FCndet und\\nein [VAR 0101(0000)] gefangen!"
  },
  {
    "index": 165,
    "flags": 0,
    "text": "Zeit f\u00FCr Pok\u00E9Camping! Ich werd es mir mit\\nmeinen Pok\u00E9mon so richtig gut gehen lassen!"
  },
  {
    "index": 166,
    "flags": 0,
    "text": "Ich hab zusammen mit meinen Pok\u00E9mon beim\\nPok\u00E9Camping ein richtig leckeres Curry gekocht!"
  },
  {
    "index": 167,
    "flags": 0,
    "text": "Ich werde zusammen mit anderen Trainern\\neinen Dyna-Raid machen!"
  },
  {
    "index": 168,
    "flags": 0,
    "text": "Ein Link-Tausch hilft dabei, den eigenen Horizont\\nzu erweitern! Wer m\u00F6chte mit mir tauschen?"
  },
  {
    "index": 169,
    "flags": 0,
    "text": "Einzelk\u00E4mpfe sind immer aufregend!\\nWer hat Lust auf einen Kampf?"
  },
  {
    "index": 170,
    "flags": 0,
    "text": "Doppelk\u00E4mpfe erfordern kluge taktische Z\u00FCge!\\nWer will sich mit mir messen?"
  },
  {
    "index": 171,
    "flags": 0,
    "text": "Bei Multik\u00E4mpfen haben alle ihren Spa\u00DF!\\nWer will mitmachen?"
  },
  {
    "index": 172,
    "flags": 0,
    "text": "Ich hab ein Pok\u00E9mon gefunden!\\nWer will an einem Dyna-Raid teilnehmen?"
  },
  {
