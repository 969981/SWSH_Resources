  },
  {
    "index": 299,
    "flags": 0,
    "text": "Suche l\u00E4uft..."
  },
  {
    "index": 300,
    "flags": 0,
    "text": "[~ 300]"
  },
  {
    "index": 301,
    "flags": 0,
    "text": "[~ 301]"
  },
  {
    "index": 302,
    "flags": 0,
    "text": "[~ 302]"
  },
  {
    "index": 303,
    "flags": 0,
    "text": "[~ 303]"
  },
  {
    "index": 304,
    "flags": 0,
    "text": "Es wird nach einem Spieler gesucht...\\c\\nDu kannst den Suchvorgang abbrechen, indem du\\neine andere Option aus dem Men\u00FC w\u00E4hlst.\\c"
  },
  {
    "index": 305,
    "flags": 0,
    "text": "Es wird nach einem Spieler gesucht...\\c\\nDu kannst den Suchvorgang abbrechen, indem du\\neine andere Option aus dem Men\u00FC w\u00E4hlst.\\c"
  },
  {
    "index": 306,
    "flags": 0,
    "text": " Sperrliste"
  },
  {
    "index": 307,
    "flags": 0,
    "text": "Der Suchvorgang wurde abgebrochen.\\c"
  },
  {
    "index": 308,
    "flags": 0,
    "text": "Sticker filtern"
  },
  {
    "index": 309,
    "flags": 0,
    "text": "Kartentausch"
  },
  {
    "index": 310,
    "flags": 0,
    "text": "Zaubertausch"
  },
  {
    "index": 311,
    "flags": 0,
    "text": "Dein System befindet sich im Flugzeugmodus,\\nsodass keine Verbindung zu anderen Spielern\\nhergestellt werden kann.\\n\\nDeaktiviere den Flugzeugmodus und versuche es\\nanschlie\u00DFend erneut."
  },
  {
    "index": 312,
    "flags": 0,
    "text": "Deine Software-Version ist veraltet, sodass keine\\nVerbindung zu anderen Spielern hergestellt\\nwerden kann.\\n\\nDu musst ein Software-Update durchf\u00FChren, um\\ndich mit anderen Spielern verbinden zu k\u00F6nnen.\\nWeitere Einzelheiten gibt es auf der offiziellen\\nInternetseite.\\c"
  },
  {
    "index": 313,
    "flags": 0,
    "text": "Der Zaubertausch erm\u00F6glicht es dir, Pok\u00E9mon\\nauf magische Art zu tauschen.\\c\\nDu brauchst nichts weiter zu tun, als ein Pok\u00E9mon\\nzum Tausch auszuw\u00E4hlen. Der Rest ist Magie!\\c\\nW\u00E4hrend du dich deinem Abenteuer widmest,\\nwird automatisch nach einem Tauschpartner\\r\\ngesucht und der Tausch durchgef\u00FChrt.\\c\\nWarum w\u00E4hlst du nicht gleich ein Pok\u00E9mon aus\\nund versuchst dein Gl\u00FCck?\\c"
  },
  {
    "index": 314,
    "flags": 0,
    "text": "Es wird nach Ligakarten gesucht...\\c\\nDu kannst den Suchvorgang abbrechen,\\nindem du eine Kommunikationsoption\\r\\naus dem Men\u00FC w\u00E4hlst.\\c"
  },
  {
    "index": 315,
    "flags": 0,
    "text": "M\u00F6chtest du den Tausch starten?"
  },
  {
    "index": 316,
    "flags": 0,
    "text": "Passwort eingeben"
  },
  {
    "index": 317,
    "flags": 0,
    "text": "Tauschen"
  },
  {
    "index": 318,
    "flags": 0,
    "text": "Du hast das folgende Passwort festgelegt:\\n[VAR 0203(0000,0000)] [VAR 0203(0001,0000)]\\c\\nM\u00F6chtest du mit diesem Passwort fortfahren?"
  },
  {
    "index": 319,
    "flags": 0,
    "text": "Du hast kein Passwort eingegeben.\\c\\nOhne Passwort wirst du eventuell mit einem\\nbeliebigen Spieler verbunden und nicht mit der\\r\\nPerson, mit der du spielen m\u00F6chtest.\\c\\nM\u00F6chtest du fortfahren?"
  },
  {
    "index": 320,
    "flags": 0,
    "text": "M\u00F6chtest du [VAR 0100(0000)] auf deine\\nSperrliste setzen?"
  },
  {
    "index": 321,
    "flags": 0,
    "text": "Mit einem gesperrten Spieler kannst du nicht\\n\u00FCber die Kommunikationsfunktionen spielen.\\c\\nWillst du den Spieler wirklich sperren?\\n(Du kannst Spieler auch wieder entsperren.)"
  },
  {
    "index": 322,
    "flags": 0,
    "text": "[VAR 0100(0000)] wurde gesperrt.\\c\\nIm Ypsi-Com-Men\u00FC kannst du unter \u201EProfil\u201C\\ndeine Sperrliste \u00FCberpr\u00FCfen.\\c"
  },
  {
    "index": 323,
    "flags": 0,
    "text": "Ja"
  },
  {
    "index": 324,
    "flags": 0,
    "text": "Nein"
  },
  {
    "index": 325,
    "flags": 0,
    "text": " Lokale Verbindung"
  },
  {
    "index": 326,
    "flags": 0,
    "text": "Dieser Spieler sucht nicht mehr nach Teilnehmern\\nf\u00FCr seinen Dyna-Raid.\\c\\nDeine alten Sticker werden gel\u00F6scht und durch\\nneue ersetzt.\\c"
  },
  {
    "index": 327,
    "flags": 0,
    "text": "Wer m\u00F6chte seine Ligakarte mit mir tauschen?"
  },
  {
    "index": 328,
    "flags": 0,
    "text": "[~ 328]"
  },
  {
    "index": 329,
    "flags": 0,
    "text": "Du kannst gerade keine Ligakarten tauschen.\\c"
  },
  {
    "index": 330,
    "flags": 0,
    "text": "Dein Album ist voll.\\c\\nUm Ligakarten tauschen zu k\u00F6nnen, musst du\\nzun\u00E4chst in deinem Album Platz schaffen.\\c"
  },
  {
    "index": 331,
    "flags": 0,
    "text": "Abbrechen"
  },
  {
    "index": 332,
    "flags": 0,
    "text": "Diese Person befindet sich bereits auf deiner\\nSperrliste.\\c"
  },
  {
    "index": 333,
    "flags": 0,
    "text": "Du kannst dich nicht selbst auf deine\\nSperrliste setzen.\\c"
  },
  {
    "index": 334,
    "flags": 0,
    "text": "Wenn du ein Passwort eingibst, k\u00F6nnen sich nur\\nSpieler mit dir verbinden, die dasselbe Passwort\\r\\neingeben.\\c"
  },
  {
    "index": 335,
    "flags": 0,
    "text": "Du kannst vor\u00FCbergehend keinen Link-Tausch\\ndurchf\u00FChren, da dein letzter Tausch durch einen\\r\\nVerbindungsfehler, das Ausschalten der Konsole\\r\\noder \u00C4hnliches abgebrochen wurde.\\c\\nBitte \u00E4ndere nicht die Zeiteinstellungen der\\nKonsole und versuche es sp\u00E4ter erneut.\\c"
  },
  {
    "index": 336,
    "flags": 0,
    "text": "Der Tausch kann nicht durchgef\u00FChrt werden,\\nda du keine Pok\u00E9mon in deinen PC-Boxen hast.\\c\\nBitte versuche es erneut, nachdem du deine\\nPC-Boxen mit Pok\u00E9mon gef\u00FCllt hast.\\c"
  },
  {
    "index": 337,
    "flags": 0,
    "text": "Der Tausch kann nicht durchgef\u00FChrt werden,\\nda du nur ein Pok\u00E9mon besitzt.\\c\\nBitte versuche es erneut, nachdem du einige\\nPok\u00E9mon gefangen hast.\\c"
  },
  {
    "index": 338,
    "flags": 0,
    "text": "Du kannst gerade nicht an einem Doppelkampf\\nteilnehmen, da du nicht \u00FCber mindestens zwei\\r\\nkampff\u00E4hige Pok\u00E9mon verf\u00FCgst.\\c\\nBesorge dir noch mindestens ein weiteres\\nPok\u00E9mon und versuche es erneut.\\c"
  },
  {
    "index": 339,
    "flags": 0,
    "text": "Verbindung wird aufgebaut...\\nBitte warte einen Moment."
  },
  {
    "index": 340,
    "flags": 0,
    "text": "Bei dem ausgew\u00E4hlten Pok\u00E9mon liegt\\nein Problem vor.\\c"
  },
  {
    "index": 341,
    "flags": 0,
    "text": "Bei der Daten\u00FCbertragung ist ein Fehler\\naufgetreten.\\c"
  },
  {
    "index": 342,
    "flags": 0,
    "text": "Online-Verbindung"
  },
  {
    "index": 343,
    "flags": 0,
    "text": "Lokale Verbindung"
  },
  {
    "index": 344,
    "flags": 0,
    "text": "Du hast [VAR 0101(0000)] auf einem\\nDynamax-Abenteuer besiegt!"
  },
  {
    "index": 345,
    "flags": 0,
    "text": "Du hast [VAR 0101(0000)] auf einem\\nDynamax-Abenteuer besiegt!"
  }
]
