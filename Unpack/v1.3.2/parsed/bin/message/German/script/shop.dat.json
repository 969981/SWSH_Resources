  },
  {
    "index": 98,
    "flags": 0,
    "text": "Ich verkaufe verschiedene Sorten von duftendem\\nRauch. M\u00F6chtest du mir welchen abkaufen?"
  },
  {
    "index": 99,
    "flags": 0,
    "text": "Bis zum n\u00E4chsten Mal!"
  },
  {
    "index": 100,
    "flags": 0,
    "text": "Kann ich sonst noch was f\u00FCr dich tun?"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "Aha, [VAR 0109(0000)] willst du also.\\nWie viele Exemplare m\u00F6chtest du kaufen?"
  },
  {
    "index": 102,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kostet\\n[VAR 0206(0002,002E)] \uE300. Einverstanden?"
  },
  {
    "index": 103,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kosten\\n[VAR 0206(0002,002E)] \uE300. Einverstanden?"
  },
  {
    "index": 104,
    "flags": 0,
    "text": "Vielen Dank! Hier hast du deinen Rauch.\\nIch freue mich auf deinen n\u00E4chsten Einkauf!\\c"
  },
  {
    "index": 105,
    "flags": 0,
    "text": "Hoppla! In deinem Beutel ist offenbar nicht mehr\\ngenug Platz...\\c"
  },
  {
    "index": 106,
    "flags": 0,
    "text": "Tut mir leid, aber du hast nicht genug Geld...\\c"
  },
  {
    "index": 107,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kostet\\n[VAR 0206(0002,202F)] GP. Einverstanden?"
  },
  {
    "index": 108,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kosten\\n[VAR 0206(0002,202F)] GP. Einverstanden?"
  },
  {
    "index": 109,
    "flags": 0,
    "text": "Hallo! Bei mir kannst du Naturheilmittel erstehen.\\nIch mache dir einen besonders g\u00FCnstigen Preis!"
  },
  {
    "index": 110,
    "flags": 0,
    "text": "Danke f\u00FCr deinen Besuch!\\nBis zum n\u00E4chsten Mal."
  },
  {
    "index": 111,
    "flags": 0,
    "text": "Darf\u2019s sonst noch was sein?"
  },
  {
    "index": 112,
    "flags": 0,
    "text": "Wie viele [VAR 1001][VAR 0110(0000)]\\nsollen es sein?"
  },
  {
    "index": 113,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kostet\\n[VAR 0206(0002,002E)] \uE300. Einverstanden?"
  },
  {
    "index": 114,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kosten\\n[VAR 0206(0002,002E)] \uE300. Einverstanden?"
  },
  {
    "index": 115,
    "flags": 0,
    "text": "Hier hast du deine Ware. Eine sehr gesunde\\nWahl, wenn ich das sagen darf!\\c"
  },
  {
    "index": 116,
    "flags": 0,
    "text": "Oh, daf\u00FCr hast du leider keinen Platz.\\c"
  },
  {
    "index": 117,
    "flags": 0,
    "text": "Huch? Tut mir leid, aber dein Gespartes reicht\\nleider nicht.\\c"
  },
  {
    "index": 118,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kostet\\n[VAR 0206(0002,202F)] GP. Einverstanden?"
  },
  {
    "index": 119,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kosten\\n[VAR 0206(0002,202F)] GP. Einverstanden?"
  },
  {
    "index": 120,
    "flags": 0,
    "text": "Hallo! Wie w\u00E4re es mit ein paar frisch\\ngepfl\u00FCckten Beeren?"
  },
  {
    "index": 121,
    "flags": 0,
    "text": "Danke f\u00FCr deinen Besuch!"
  },
  {
    "index": 122,
    "flags": 0,
    "text": "M\u00F6chtest du noch mehr Beeren kaufen?"
  },
  {
    "index": 123,
    "flags": 0,
    "text": "Wie viele [VAR 1001][VAR 0109(0000)] m\u00F6chtest du?"
  },
  {
    "index": 124,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kostet\\n[VAR 0206(0002,002E)] \uE300. Einverstanden?"
  },
  {
    "index": 125,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 1001][VAR 010A(0000)] kosten\\n[VAR 0206(0002,002E)] \uE300. Einverstanden?"
  },
  {
    "index": 126,
    "flags": 0,
    "text": "Hier hast du deine Ware. Dein[VAR 1101(00FD,100D)] Pok\u00E9mon wirde Pok\u00E9mon werden\\nsich bestimmt \u00FCber einen Snack freuen.\\c"
  },
  {
    "index": 127,
    "flags": 0,
    "text": "Nanu? Du hast offenbar nicht genug Platz in\\ndeinem Beutel...\\c"
  },
  {
    "index": 128,
    "flags": 0,
    "text": "Du hast offenbar nicht genug Geld. Tut mir leid,\\naber ich muss auch von etwas leben.\\c"
  },
  {
    "index": 129,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)] kostet\\n[VAR 0206(0002,202F)] GP. Einverstanden?"
  },
  {
    "index": 130,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 1001][VAR 010A(0000)] kosten\\n[VAR 0206(0002,202F)] GP. Einverstanden?"
  },
