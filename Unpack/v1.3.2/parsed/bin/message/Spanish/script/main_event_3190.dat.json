  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u00A1Por fin hab\u00E9is llegado! Llevo todo este tiempo\\nintentando tranquilizar a [VAR 0101(0001)]...[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
