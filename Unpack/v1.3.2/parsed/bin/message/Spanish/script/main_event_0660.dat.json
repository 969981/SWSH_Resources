  },
  {
    "index": 18,
    "flags": 0,
    "text": "Preparad[VAR 1100(00FF,0101)]oa, list[VAR 1100(00FF,0101)]oa... \u00A1ya!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u00A1Misi\u00F3n de gimnasio completada!"
