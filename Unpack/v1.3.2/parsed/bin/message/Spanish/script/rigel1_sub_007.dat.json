  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u00BFEn qu\u00E9 consiste?"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "Salir"
  },
  {
    "index": 29,
    "flags": 4,
