  {
    "index": 171,
    "flags": 0,
    "text": "\u00BFCu\u00E1nt[VAR 1100(0001,0101)]oas [VAR 1001][VAR 010A(0001)]\\nquieres usar?"
  },
  {
    "index": 172,
    "flags": 0,
    "text": "No puedes montar en la bici mientras ojeas la\\nBolsa.\\c"
  },
  {
    "index": 173,
    "flags": 0,
    "text": "No puedes pescar mientras ojeas la Bolsa.\\c"
  },
  {
    "index": 174,
    "flags": 0,
    "text": "No puedes usar la Caja de Pok\u00E9mon mientras\\nojeas la Bolsa.\\c"
  },
