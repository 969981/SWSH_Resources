    "index": 187,
    "flags": 0,
    "text": "\u00BFQuieres recibir la Tarjeta de Liga del otro\\njugador?"
  },
  {
    "index": 188,
    "flags": 0,
    "text": "\u00BFQuieres intercambiar tu [VAR 0101(0001)] por\\nel [VAR 0101(0000)] del otro jugador?"
  },
  {
    "index": 189,
    "flags": 0,
    "text": "No puedes intercambiar este Huevo.\\c"
  },
  {
    "index": 190,
    "flags": 4,
    "text": "Intercambiar"
  },
  {
    "index": 191,
    "flags": 0,
    "text": "Confirmar"
  },
  {
    "index": 192,
    "flags": 0,
    "text": "[VAR 0201(0000)]/[VAR 0201(0001)]"
  },
  {
    "index": 193,
    "flags": 0,
    "text": "[VAR 0102(0000)]"
  },
  {
    "index": 194,
    "flags": 0,
    "text": "No puedes intercambiar este Pok\u00E9mon.\\c"
  },
  {
    "index": 195,
    "flags": 0,
    "text": "No tienes ning\u00FAn Pok\u00E9mon que puedas\\nintercambiar.\\c"
  },
  {
    "index": 196,
    "flags": 0,
    "text": "No puedes intercambiar Huevos.\\c"
  },
  {
    "index": 197,
    "flags": 4,
    "text": "Este Pok\u00E9mon est\u00E1 registrado en tu Equipo de\\nCombate, por lo que no lo puedes intercambiar.\\c"
  },
  {
    "index": 198,
    "flags": 4,
    "text": "Este Pok\u00E9mon lleva un objeto especial, por lo\\nque no lo puedes intercambiar.\\c"
  },
  {
    "index": 199,
    "flags": 0,
    "text": "\u00BFQuieres a\u00F1adir a [VAR 0100(0000)] a la lista de\\njugadores bloqueados?"
  },
  {
    "index": 200,
    "flags": 0,
    "text": "No podr\u00E1s volver a comunicarte con quienes\\na\u00F1adas a la lista de jugadores bloqueados.\\c\\n\u00BFQuieres a\u00F1adir a esta persona a la lista?\\n(Podr\u00E1s desbloquearla m\u00E1s adelante)."
  },
  {
    "index": 201,
    "flags": 0,
    "text": "Has a\u00F1adido a esta persona a la lista de\\njugadores bloqueados. Se anular\u00E1 el intercambio.\\c"
  },
  {
    "index": 202,
    "flags": 0,
    "text": "Ya has a\u00F1adido a esta persona a la lista de\\njugadores bloqueados.\\c"
  },
  {
    "index": 203,
    "flags": 0,
    "text": "No se ha podido a\u00F1adir a esta persona a la lista\\nde jugadores bloqueados.\\c"
  },
  {
    "index": 204,
    "flags": 0,
    "text": " Seleccionar"
  },
  {
    "index": 205,
    "flags": 0,
    "text": "Ver informaci\u00F3n del equipo rival"
  },
  {
    "index": 206,
    "flags": 0,
    "text": "[~ 206]"
  },
  {
    "index": 207,
    "flags": 0,
    "text": "No puedes cambiar el objeto que lleva un\\nPok\u00E9mon mientras est\u00E9 participando en un\\r\\nintercambio m\u00E1gico.\\c"
  },
  {
    "index": 208,
    "flags": 0,
    "text": "No puedes marcar un Pok\u00E9mon que est\u00E9\\nparticipando en un intercambio m\u00E1gico.\\c"
  },
  {
    "index": 209,
    "flags": 0,
    "text": "No puedes liberar un Pok\u00E9mon que est\u00E9\\nparticipando en un intercambio m\u00E1gico.\\c"
  },
  {
    "index": 210,
    "flags": 0,
    "text": "No puedes mover un Pok\u00E9mon que est\u00E9\\nparticipando en un intercambio m\u00E1gico.\\c"
  },
  {
    "index": 211,
    "flags": 0,
    "text": "No puedes registrar en un Equipo de Combate\\nun Pok\u00E9mon que est\u00E9 participando en un\\r\\nintercambio m\u00E1gico.\\c"
  },
  {
    "index": 212,
    "flags": 0,
    "text": "No puedes seleccionar un Huevo.\\c"
  },
  {
    "index": 213,
