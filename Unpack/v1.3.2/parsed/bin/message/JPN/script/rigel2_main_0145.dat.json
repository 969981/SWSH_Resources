  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u3072\u3068\u306E\u3053\u3088\\n\u3088\u304F\u305E\u3000\u3084\u3063\u305F\u3067\u3042\u308B[VAR 0114(0079)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u305D\u306E\u3000\u306B\u3093\u3058\u3093\u3092\u3000\u3082\u3061\u3044\u308C\u3070\\n\u308F\u304C\u3000\u3042\u3044\u3070\u3092\\r\\n\u304A\u3073\u304D\u3088\u305B\u308B\u3053\u3068\u3000\u304B\u306A\u3044\u3057\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u3042\u3068\u306F\u3000\u30E8\u306E\u3000\u3061\u304B\u3089\u3092\u3000\u305E\u3046\u3075\u304F\u3059\u308B\\n\u30AD\u30BA\u30CA\u306E\u30BF\u30C5\u30CA\u3000\u3055\u3048\u3000\u3042\u308C\u3070\\r\\n\u305F\u3084\u3059\u304F\u3000\u3042\u3044\u3070\u3092\u3000\u306E\u308A\u3053\u306A\u305B\u308B\u304C\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u3082\u306F\u3084\u3000\u306B\u3093\u3052\u3093\u304B\u3089\u3000\u3042\u308C\u3092\\n\u3055\u3055\u3052\u3089\u308C\u308B\u3053\u3068\u306F\u3000\u306A\u3044\u3067\u3042\u308D\u3046[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u30D0\u30B7\u30ED\u30A9\u30FC\u30B9\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u30D0\u30AF\u30ED\u30A9\u30FC\u30B9\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u3042\u3084\u3064\u306F\u3000\u308F\u304C\u3000\u3042\u3044\u3070\\n\u2026\u2026\u30D6\u30EA\u30B6\u30DD\u30B9\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u3042\u3084\u3064\u306F\u3000\u308F\u304C\u3000\u3042\u3044\u3070\\n\u2026\u2026\u30EC\u30A4\u30B9\u30DD\u30B9\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u3042\u306E\u3000\u3057\u308D\u304F\u3000\u304B\u304C\u3084\u304F\u3000\u3051\u306A\u307F\uFF01\\n\u305D\u307C\u3046\u3000\u308D\u3046\u305C\u304D\u306B\u3000\u306F\u3057\u308B\u3000\u3059\u304C\u305F\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u3042\u306E\u3000\u304F\u308D\u304F\u3000\u304B\u304C\u3084\u304F\u3000\u3051\u306A\u307F\uFF01\\n\u305D\u307C\u3046\u3000\u308D\u3046\u305C\u304D\u306B\u3000\u306F\u3057\u308B\u3000\u3059\u304C\u305F\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u3067\u3042\u3044\u3057\u3053\u308D\u3068\u3000\u307F\u3058\u3093\u3082\u3000\u304B\u308F\u3089\u306C\\n\u3042\u3042\u3000\u306A\u3064\u304B\u3057\u3000\u306A\u3064\u304B\u3057\u3084\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u30B7\u30ED\u30A9\u30FC\u30B9\u2026\u2026"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u30AF\u30ED\u30A9\u30FC\u30B9\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u304A\u305D\u3089\u304F\u3000\u3042\u3084\u3064\u306F\\n\u306B\u3093\u3058\u3093\u306E\u3000\u306B\u304A\u3044\u3092\u3000\u304B\u3093\u3058\u3068\u3063\u305F\u304C\\r\\n\u304F\u308F\u3057\u3044\u3070\u3057\u3087\u3000\u307E\u3067\u306F\u3000\u308F\u304B\u3089\u306C\u3068\u307F\u305F[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u306F\u3057\u308A\u3055\u3063\u305F\u3000\u307B\u3046\u304C\u304F\u3000\u304B\u3089\\n\u3080\u3089\u306B\u3000\u306B\u3093\u3058\u3093\u3092\u3000\u3046\u3070\u3044\u306B\u3044\u3063\u305F\u306E\u3084\u3082[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u3060\u3068\u3059\u308B\u3068\u3000\u3072\u3068\u306E\u3053\u3088\\n\u30D5\u30EA\u30FC\u30BA\u3080\u3089\u304C\u3000\u3042\u3084\u3046\u3044\uFF01\\r\\n\u3044\u305D\u3044\u3067\u3000\u3080\u304B\u3046\u3067\u3042\u308B\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u30AA\u2026\u2026\u30AA\u30A4\u30E9\u306E\u3000\u306F\u305F\u3051\u306F\\n\u304A\u307E\u3048\u306A\u3093\u304B\u306B\u3000\u3042\u3089\u3055\u305B\u306D\u3047\u305E\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u305F\u3000\u305F\u3044\u3078\u3093\u3058\u3083\u3042\uFF01\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3080\u3089\u3067\u3000\u3042\u3070\u308C\u3068\u308B\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u3042\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u2026\u2026\\n\u307E\u3055\u304B\u3000\u304A\u3068\u304E\u3070\u306A\u3057\u306E\uFF01\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u3042\u3093\u306A\u3000\u3067\u3063\u304B\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n\u3042\u3070\u308C\u3089\u308C\u305F\u3089\u3000\u305F\u307E\u3063\u305F\u3082\u3093\u3058\u3083\u306A\u3044\uFF01\\c\\n\u3060\u308C\u304B\u3000\u3042\u306E\u3000\u3042\u3070\u308C\u3093\u307C\u3046\u3092\\n\u3057\u305A\u304B\u306B\u3000\u3055\u305B\u3068\u304F\u308C\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u306A\u3093\u3060\u304B\u3000\u3055\u308F\u304C\u3057\u3044\u308F\u306D\u3047\\n\u304A\u307E\u3064\u308A\u306E\u3000\u304D\u305B\u3064\u3000\u304B\u3057\u3089\uFF1F"
  },
  {
    "index": 24,
    "flags": 0,
