    "text": "\u304A\u3068\u304F\u306A\u3000\u3051\u3044\u3058\u3070\u3093\uFF01\\c\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u3064\u304B\u307E\u3048\u3088\u3046\u3068\u3000\u3057\u305F\u3068\u304D\\n\u306A\u3052\u305F\u3000\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\u3000\u306A\u3069\u304C\\r\\n\uFF11\u304B\u3044\u3057\u304B\u3000\u3086\u308C\u306A\u3044\u3068\u304D\u304C\u3000\u3042\u308A\u307E\u3059\\c\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u305F\u304F\u3055\u3093\u3000\u3064\u304B\u307E\u3048\u308B\u307B\u3069\\n\u306F\u3063\u305B\u3044\u3000\u3057\u3084\u3059\u304F\u306A\u308B\u3000\u3052\u3093\u3057\u3087\u3046\u3067\\c\\n\u3044\u3064\u3082\u3088\u308A\u3000\u3064\u304B\u307E\u3048\u3084\u3059\u304F\u306A\u308B\u305F\u3081\\n\u307B\u304B\u304F\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u3068\u3000\u3044\u3044\u307E\u3059\uFF01"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uFF11\uFF10\u3070\u3093\u3069\u3046\u308D"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u304A\u3068\u304F\u306A\u3000\u3051\u3044\u3058\u3070\u3093\uFF01\\c\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u305F\u3044\u306A\u3044\u304B\u3089\u3000\u306F\u306A\u305F\u308C\u305F\\n\u3068\u304F\u3057\u3085\u306A\u3000\u30D1\u30EF\u30FC\u306F\\r\\n\u307E\u308F\u308A\u306E\u3000\u304F\u3046\u304B\u3093\u3092\u3000\u3086\u304C\u307E\u305B\\c\\n\u3058\u3063\u3055\u3044\u306E\u3000\u304A\u304A\u304D\u3055\u3088\u308A\u3082\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u304D\u3087\u3060\u3044\u306B\u3000\u307F\u305B\u307E\u3059\\r\\n\u3053\u308C\u3092\u3000\u30C0\u30A4\u30DE\u30C3\u30AF\u30B9\u3068\u3000\u3044\u3044\u307E\u3059\\c\\n\u306A\u304B\u306B\u306F\u3000\u30C0\u30A4\u30DE\u30C3\u30AF\u30B9\u3067\u3000\u3059\u304C\u305F\u304C\\n\u304B\u308F\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3044\u307E\u3059\\r\\n\u3053\u308C\u3092\u3000\u30AD\u30E7\u30C0\u30A4\u30DE\u30C3\u30AF\u30B9\u3068\u3000\u3044\u3044\u307E\u3059"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u30B7\u30E5\u30FC\u30C8\u30B7\u30C6\u30A3\\n\u30ED\u30FC\u30BA\u3044\u3044\u3093\u3061\u3087\u3046\u306B\u3000\u3088\u3063\u3066\\r\\n\u3051\u3044\u304B\u304F\u3066\u304D\u306B\u3000\u3064\u304F\u3089\u308C\u305F\u3000\u3060\u3044\u3068\u3057"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u3072\u308D\u3044\u3000\u30B7\u30E5\u30FC\u30C8\u30B7\u30C6\u30A3\u306E\u3000\u3044\u3069\u3046\u306B\u306F\\n\u30B7\u30E5\u30FC\u30C8\u30B7\u30C6\u30A3\u3000\u305B\u3093\u3082\u3093\u306E\\r\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u304B\\r\\n\u30E2\u30CE\u30EC\u30FC\u30EB\u3092\u3000\u3054\u308A\u3088\u3046\u3000\u304F\u3060\u3055\u3044"
  },
  {
    "index": 53,
    "flags": 0,
