    "index": 0,
    "flags": 0,
    "text": "\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\uFF01\\c\\n\u30AB\u30D6\u3055\u3093\u306B\u3000\u3044\u3069\u3080\u306A\u3089\\n\u30BF\u30FC\u30D5\u30BF\u30A6\u30F3\u306E\u3000\u304F\u3055\u30D0\u30C3\u30B8\u3068\\r\\n\u30D0\u30A6\u30BF\u30A6\u30F3\u306E\u3000\u307F\u305A\u30D0\u30C3\u30B8\u304C\u3000\u3044\u308B\u305E\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u304A\u304A\u3000\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\uFF01\\n\u30D0\u30C3\u30B8\u304C\u3000\uFF12\u3064\u3068\u306F\u3000\u3059\u3070\u3089\u3057\u3044\u305E\uFF01\\c\\n\u30AB\u30D6\u3055\u3093\u3060\u304C\u3000\u3068\u3063\u304F\u3093\u3067\\n\u3060\u3044\u306B\u3053\u3046\u3056\u3093\u306B\u3000\u3044\u308B\u3089\u3057\u3044\u305C\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u3042\u3089\u2026\u2026\u3000\u307B\u3093\u3058\u3064\u306F\u3000\u304A\u305D\u3044\u306E\u3067\\n\u307E\u305F\u3000\u3042\u3057\u305F\u3000\u3044\u3089\u3057\u3066\u304F\u3060\u3055\u3044\\c\\n\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u306E\u3000\u307F\u306A\u3055\u3093\u306F\\n\u30DB\u30C6\u30EB\u3000\u30B9\u30DC\u30DF\u30FC\u30A4\u30F3\u306B\u3000\u3068\u307E\u308C\u307E\u3059\u3088"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u3000\u3069\u3046\u3057\\n\u3061\u304B\u3089\u306E\u3000\u304B\u304E\u308A\u3092\u3000\u3064\u304F\u3057\u307E\u3057\u3087\u3046\u306D"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u307E\u305A\u306F\u3000\u30BF\u30FC\u30D5\u30BF\u30A6\u30F3\u306D\uFF01\\n\u3055\u3042\u3000\uFF13\u3070\u3093\u3069\u3046\u308D\u306B\u3000\u3080\u304B\u3044\u307E\u3057\u3087\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u3053\u3053\u307E\u3067\u3000\u304D\u305F\u3051\u308C\u3069\u2026\u2026\\n\u304B\u3066\u308B\u3000\u3058\u3057\u3093\u304C\u3000\u306A\u304F\u306A\u3063\u305F\u3088\\r\\n\u306F\u3042\u3000\u3069\u3046\u3057\u3088\u3046\u304B\u306A\u3042"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u3042\u306A\u305F\u306E\u3000\u30DD\u30B1\u30E2\u30F3\\n\u304C\u3093\u3070\u308C\u308B\u306E\u3000\u3059\u3054\u3044\u3088\u306D\u2026\u2026\\c\\n\u3057\u3042\u3044\u3092\u3000\u307F\u3066\u3044\u305F\u3089\\n\u306A\u3093\u3060\u304B\u3000\u304A\u3046\u3048\u3093\u3000\u3055\u308C\u305F\u307F\u305F\u3044"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u3000\u304B\u3044\u304B\u3044\u3057\u304D\u2026\u2026\\n\u304B\u305E\u304F\u3082\u3000\u30C6\u30EC\u30D3\u3067\u3000\u307F\u3066\u3044\u308B\u2026\u2026\\c\\n\u3082\u3046\u3044\u3061\u3069\u3000\u304B\u304C\u307F\u3067\\n\u304B\u307F\u304C\u305F\u3092\u3000\u30C1\u30A7\u30C3\u30AF\u3059\u308B\u304B"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u30ED\u30FC\u30BA\u3044\u3044\u3093\u3061\u3087\u3046\u306E\u3000\u3042\u3044\u3055\u3064\u2026\u2026\\n\u304C\u305C\u3093\u3000\u3084\u308B\u304D\u304C\u3000\u3067\u3066\u304D\u307E\u3057\u305F\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u304F\u3055\u30D0\u30C3\u30B8\u2026\u2026\u3000\u307F\u305A\u30D0\u30C3\u30B8\u2026\u2026\\n\u3067\u3082\u3000\u307B\u306E\u304A\u30D0\u30C3\u30B8\u306F\u3000\u3068\u308C\u308B\u306E\u304B"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u30AB\u30D6\u3055\u3093\u306B\u3000\u304B\u3063\u305F\u3060\u3068\uFF01\uFF1F\\n\u304D\u307F\u306F\u3000\u3059\u3054\u3044\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u3060\\c\\n\u307B\u304B\u306E\u3000\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u306B\u3082\\n\u3057\u3087\u3046\u3076\u3092\u3000\u3044\u3069\u307E\u308C\u308B\u304B\u3082\u306A"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u3053\u3093\u304B\u3044\u306F\u3000\u3044\u3044\u3093\u3061\u3087\u3046\u3084\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306B\u3000\u3059\u3044\u305B\u3093\u3000\u3055\u308C\u305F\\r\\n\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u304C\u3000\u3044\u308B\u3093\u3060\u3063\u3066"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uFF18\u3053\u306E\u3000\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\u3000\u3042\u3064\u3081\u308B\u2026\u2026\\n\u306A\u3093\u3060\u304B\u3000\u305F\u304B\u3089\u3042\u3064\u3081\u3000\u307F\u305F\u3044\u306D\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3068\u306E\u3000\u3057\u3042\u3044\\n\u3069\u3093\u306A\u3000\u305F\u305F\u304B\u3044\u306B\u3000\u306A\u308B\u304B\u3057\u3089"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u30C0\u30F3\u30C7\u3055\u3093\u306B\u3000\u3059\u3044\u305B\u3093\u3000\u3055\u308C\u305F\\n\u30B8\u30E0\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u306D\\r\\n\u30AB\u30D6\u3055\u3093\u306B\u3000\u3044\u3069\u3080\u306A\u3093\u3066\u3000\u3055\u3059\u304C"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u3055\u3059\u304C\u306F\u3000\u30C0\u30F3\u30C7\u3055\u3093\u306D\\c\\n\u3042\u306A\u305F\u306E\u3088\u3046\u306A\u3000\u3059\u3050\u308C\u305F\u3000\u3055\u3044\u306E\u3046\u306E\\n\u3082\u3061\u306C\u3057\u3092\u3000\u3059\u3044\u305B\u3093\u3000\u3059\u308B\u3060\u306A\u3093\u3066"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u304B\u3044\u304B\u3044\u3057\u304D\u306E\u3000\u307E\u3048\u304B\u3089\\n\u30D3\u30D3\u30C3\u3066\u3066\u3000\u3069\u3046\u3059\u308B\u306E\u3088\u3000\u3042\u305F\u3057\u2026\u2026\\c\\n\u30DC\u30FC\u30EB\u306E\u3000\u306A\u304B\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u305F\u3061\u306F\\n\u3084\u308B\u304D\u3067\u3000\u307F\u3061\u3042\u3075\u308C\u3066\u3044\u308B\u306E\u306B\uFF01"
