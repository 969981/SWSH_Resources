  },
  {
    "index": 207,
    "flags": 0,
    "text": "You can\u2019t change this Pok\u00E9mon\u2019s held item,\\nbecause it has been selected for Surprise Trade.\\c"
  },
  {
    "index": 208,
    "flags": 0,
    "text": "You can\u2019t mark this Pok\u00E9mon, because it has been\\nselected for Surprise Trade.\\c"
  },
  {
    "index": 209,
    "flags": 0,
    "text": "You can\u2019t release this Pok\u00E9mon, because it has\\nbeen selected for Surprise Trade.\\c"
  },
  {
    "index": 210,
    "flags": 0,
    "text": "You can\u2019t move this Pok\u00E9mon, because it has been\\nselected for Surprise Trade.\\c"
  },
  {
    "index": 211,
    "flags": 0,
    "text": "You can\u2019t register this Pok\u00E9mon for a Battle Team,\\nbecause it has been selected for Surprise Trade.\\c"
  },
  {
    "index": 212,
    "flags": 0,
    "text": "You can\u2019t select an Egg.\\c"
