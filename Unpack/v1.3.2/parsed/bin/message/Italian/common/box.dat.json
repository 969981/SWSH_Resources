    "index": 182,
    "flags": 0,
    "text": "C\u2019\u00E8 un problema con il Pok\u00E9mon dell\u2019altro\\ngiocatore. Non \u00E8 possibile eseguire lo scambio.\\c"
  },
  {
    "index": 183,
    "flags": 0,
    "text": "C\u2019\u00E8 un problema con il tuo Pok\u00E9mon.\\nNon \u00E8 possibile eseguire lo scambio.\\c"
  },
  {
    "index": 184,
    "flags": 4,
    "text": "Attenzione!\\nSe durante uno scambio la console si spegne\\no si verifica un errore di comunicazione,\\nper un po\u2019 non potrai fare scambi."
  },
  {
    "index": 185,
    "flags": 0,
    "text": "Salvataggio in corso.\\nNon spegnere la console."
  },
  {
    "index": 186,
    "flags": 0,
    "text": "Comunicazione in corso.\\nAttendi..."
  },
  {
    "index": 187,
    "flags": 0,
    "text": "Vuoi ricevere la Card Lega Pok\u00E9mon dell\u2019altro\\nAllenatore?"
  },
  {
    "index": 188,
    "flags": 0,
    "text": "Vuoi scambiare il tuo [VAR 0101(0001)] con\\n[VAR 1500(0000,0001)][VAR 0101(0000)] dell\u2019altro Allenatore?"
  },
  {
    "index": 189,
    "flags": 0,
    "text": "Questo Uovo non pu\u00F2 essere scambiato.\\c"
  },
  {
    "index": 190,
    "flags": 8,
    "text": "Scambia"
  },
  {
    "index": 191,
    "flags": 0,
    "text": "Seleziona"
  },
  {
    "index": 192,
    "flags": 0,
    "text": "[VAR 0201(0000)]/[VAR 0201(0001)]"
  },
  {
    "index": 193,
    "flags": 0,
    "text": "[VAR 0102(0000)]"
  },
  {
    "index": 194,
    "flags": 0,
    "text": "Questo Pok\u00E9mon non pu\u00F2 essere scambiato.\\c"
  },
  {
    "index": 195,
    "flags": 0,
    "text": "Non hai Pok\u00E9mon da scambiare.\\c"
  },
  {
    "index": 196,
    "flags": 0,
    "text": "Non puoi scambiare un Uovo.\\c"
  },
  {
    "index": 197,
    "flags": 0,
    "text": "Non puoi scambiare un Pok\u00E9mon\\nregistrato nella Squadra Lotta.\\c"
  },
  {
    "index": 198,
    "flags": 0,
    "text": "Questo Pok\u00E9mon ha uno strumento speciale\\ne non pu\u00F2 essere scambiato.\\c"
  },
  {
    "index": 199,
    "flags": 0,
    "text": "Vuoi aggiungere [VAR 0100(0000)] alla lista\\ndegli utenti bloccati?"
  },
  {
    "index": 200,
    "flags": 0,
    "text": "Non potrai giocare tramite le funzioni di\\ncomunicazione con gli utenti bloccati.\\c\\nVuoi davvero bloccare questo utente?\\n(\u00C8 possibile sbloccarlo in seguito)"
  },
  {
    "index": 201,
    "flags": 4,
    "text": "Hai aggiunto il giocatore alla lista degli utenti\\nbloccati. Lo scambio avr\u00E0 termine.\\c"
  },
  {
    "index": 202,
    "flags": 0,
    "text": "Questa persona \u00E8 gi\u00E0 stata aggiunta\\nalla lista degli utenti bloccati.\\c"
  },
  {
    "index": 203,
    "flags": 0,
    "text": "Non \u00E8 stato possibile aggiungere il giocatore\\nalla lista degli utenti bloccati.\\c"
  },
  {
    "index": 204,
    "flags": 0,
    "text": " Ok"
  },
  {
    "index": 205,
    "flags": 0,
    "text": "Guarda le info dell\u2019altro Pok\u00E9mon"
  },
  {
    "index": 206,
    "flags": 0,
    "text": "[~ 206]"
  },
  {
    "index": 207,
    "flags": 0,
    "text": "Non puoi modificare lo strumento di un Pok\u00E9mon\\nselezionato per uno scambio magico.\\c"
  },
  {
    "index": 208,
    "flags": 0,
    "text": "Non puoi aggiungere o rimuovere simboli a un\\nPok\u00E9mon selezionato per uno scambio magico.\\c"
  },
  {
    "index": 209,
    "flags": 0,
    "text": "Non puoi liberare un Pok\u00E9mon selezionato\\nper uno scambio magico.\\c"
  },
  {
    "index": 210,
    "flags": 0,
    "text": "Non puoi spostare un Pok\u00E9mon selezionato\\nper uno scambio magico.\\c"
  },
  {
    "index": 211,
    "flags": 0,
    "text": "Non puoi registrare in una Squadra Lotta un\\nPok\u00E9mon selezionato per uno scambio magico.\\c"
  },
  {
    "index": 212,
    "flags": 0,
    "text": "Non puoi scegliere un Uovo.\\c"
  },
  {
    "index": 213,
    "flags": 0,
    "text": "Non puoi scegliere un Pok\u00E9mon della\\nSquadra Lotta.\\c"
  },
  {
    "index": 214,
    "flags": 0,
    "text": "Non puoi scegliere un Pok\u00E9mon selezionato\\nper uno scambio magico.\\c"
  },
  {
    "index": 215,
    "flags": 0,
    "text": "Non puoi scegliere un Pok\u00E9mon della squadra.\\c"
  },
  {
    "index": 216,
    "flags": 0,
    "text": "Non puoi selezionare altri Pok\u00E9mon.\\c"
  },
  {
    "index": 217,
    "flags": 0,
    "text": "Non puoi scegliere un Pok\u00E9mon esausto.\\c"
  },
  {
    "index": 218,
    "flags": 0,
    "text": "Questo Pok\u00E9mon \u00E8 troppo speciale per poter\\nessere scambiato tramite scambio magico!\\c"
  },
  {
    "index": 219,
    "flags": 0,
    "text": "Non puoi scegliere quel Pok\u00E9mon.\\c"
  },
  {
    "index": 220,
    "flags": 0,
    "text": "Non ci sono Pok\u00E9mon selezionabili.\\c"
  },
  {
    "index": 221,
    "flags": 0,
    "text": "[~ 221]"
  },
