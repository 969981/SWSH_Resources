  {
    "index": 299,
    "flags": 0,
    "text": "Ricerca in corso..."
  },
  {
    "index": 300,
    "flags": 0,
    "text": "[~ 300]"
  },
  {
    "index": 301,
    "flags": 0,
    "text": "[~ 301]"
  },
  {
    "index": 302,
    "flags": 0,
    "text": "[~ 302]"
  },
  {
    "index": 303,
    "flags": 0,
    "text": "[~ 303]"
  },
  {
    "index": 304,
    "flags": 0,
    "text": "Verr\u00E0 cercato un giocatore.\\c\\nPuoi interrompere la ricerca selezionando\\nun\u2019altra opzione nel menu Y-Comm.\\c"
  },
  {
    "index": 305,
    "flags": 0,
    "text": "Verr\u00E0 cercato un giocatore.\\c\\nPuoi interrompere la ricerca selezionando\\nl\u2019opzione nel menu Y-Comm.\\c"
  },
  {
    "index": 306,
    "flags": 0,
    "text": " Utenti bloccati"
  },
  {
    "index": 307,
    "flags": 0,
    "text": "La ricerca \u00E8 stata interrotta.\\c"
  },
  {
    "index": 308,
    "flags": 0,
    "text": "Filtra sticker"
  },
  {
    "index": 309,
    "flags": 8,
    "text": "Scambia card"
  },
  {
    "index": 310,
    "flags": 8,
    "text": "Scambio magico"
  },
  {
    "index": 311,
    "flags": 0,
    "text": "Non puoi connetterti con altri utenti perch\u00E9\\nla console ha la modalit\u00E0 aereo attiva.\\n\\nRiprova quando sar\u00E0 possibile disattivare\\nla modalit\u00E0 aereo."
  },
  {
    "index": 312,
    "flags": 0,
    "text": "La versione del gioco non \u00E8 aggiornata.\\nPer connetterti con altri giocatori devi prima\\naggiornare il gioco.\\nPer ulteriori informazioni, visita il sito Pok\u00E9mon\\nufficiale.\\c"
  },
  {
    "index": 313,
    "flags": 0,
    "text": "Come dice il nome stesso, lo scambio magico\\n\u00E8 uno scambio in link che ha dell\u2019incredibile!\\c\\nNon devi far altro che scegliere quale Pok\u00E9mon\\nvuoi scambiare...\\c\\n... quindi tornare alla tua avventura e, quando\\nverr\u00E0 individuato l\u2019Allenatore giusto, lo scambio\\r\\navverr\u00E0 come per magia!\\c\\nProva a scegliere un Pok\u00E9mon da scambiare!\\c"
  },
  {
    "index": 314,
    "flags": 0,
    "text": "Sar\u00E0 avviato lo scambio di Card della Lega\\nPok\u00E9mon.\\c\\nPuoi interrompere lo scambio selezionando\\nun\u2019altra opzione nel menu Y-Comm.\\c"
  },
  {
    "index": 315,
    "flags": 0,
    "text": "Vuoi iniziare lo scambio?"
  },
  {
    "index": 316,
    "flags": 4,
    "text": "Imposta password"
  },
  {
    "index": 317,
    "flags": 4,
    "text": "Inizia"
  },
  {
    "index": 318,
    "flags": 0,
    "text": "La password \u00E8:\\n[VAR 0203(0000,0000)] [VAR 0203(0001,0000)]\\c\\nVuoi continuare?"
  },
  {
    "index": 319,
    "flags": 4,
    "text": "Hai scelto di non usare una password.\\c\\nQuesto significa che potrebbe connettersi\\ncon te una persona diversa da quella con cui\\r\\nvolevi giocare.\\c\\nVuoi continuare?"
  },
  {
    "index": 320,
    "flags": 0,
    "text": "Vuoi aggiungere [VAR 0100(0000)] alla lista\\ndegli utenti bloccati?"
  },
  {
    "index": 321,
    "flags": 0,
    "text": "Non potrai giocare tramite le funzioni di\\ncomunicazione con gli utenti bloccati.\\c\\nVuoi davvero bloccare questo utente?\\n(\u00C8 possibile sbloccarlo in seguito)"
  },
  {
    "index": 322,
    "flags": 4,
    "text": "Hai aggiunto [VAR 0100(0000)] alla lista\\ndegli utenti bloccati.\\c\\nPer vedere la lista, accedi alle Funzioni Y-Comm\\ne seleziona \u201CProfilo\u201D.\\c"
  },
  {
    "index": 323,
    "flags": 0,
    "text": "S\u00EC"
  },
  {
    "index": 324,
    "flags": 0,
    "text": "No"
  },
  {
    "index": 325,
    "flags": 0,
    "text": " Comunicazione locale"
  },
  {
    "index": 326,
    "flags": 0,
    "text": "Questo giocatore non sta pi\u00F9 cercando Allenatori\\nper il suo Raid Dynamax.\\c\\nI vecchi sticker saranno rimossi e riceverai quelli\\nattivi.\\c"
  },
  {
    "index": 327,
    "flags": 0,
    "text": "Chi vuole scambiare Card della Lega Pok\u00E9mon?"
  },
  {
    "index": 328,
    "flags": 0,
    "text": "[~ 328]"
  },
  {
    "index": 329,
    "flags": 4,
    "text": "Al momento non \u00E8 possibile scambiare card.\\c"
  },
  {
    "index": 330,
    "flags": 0,
    "text": "L\u2019album \u00E8 pieno.\\c\\nPer scambiare Card della Lega Pok\u00E9mon,\\nfai spazio nell\u2019album.\\c"
  },
  {
    "index": 331,
    "flags": 4,
    "text": "Esci"
  },
  {
    "index": 332,
    "flags": 0,
    "text": "Questa persona \u00E8 gi\u00E0 stata aggiunta\\nalla lista degli utenti bloccati.\\c"
  },
  {
    "index": 333,
    "flags": 0,
    "text": "Non puoi aggiungerti alla tua lista degli utenti\\nbloccati!\\c"
  },
  {
    "index": 334,
    "flags": 0,
    "text": "Se imposti una password, potrai usare le\\nfunzioni di comunicazione solo con i giocatori\\r\\nche usano la stessa password.\\c"
  },
  {
    "index": 335,
    "flags": 4,
    "text": "Al momento non puoi fare scambi in link perch\u00E9\\nil tuo ultimo scambio \u00E8 stato interrotto prima\\r\\ndi essere completato, a causa di un errore di\\r\\ncomunicazione o dello spegnimento della console.\\c\\nRiprova pi\u00F9 tardi, assicurandoti di non modificare\\nl\u2019orologio della console Nintendo Switch.\\c"
  },
  {
    "index": 336,
    "flags": 0,
    "text": "Non puoi iniziare uno scambio perch\u00E9 non hai\\nPok\u00E9mon nei Box.\\c\\nCattura altri Pok\u00E9mon e riprova.\\c"
  },
  {
    "index": 337,
    "flags": 0,
    "text": "Non puoi iniziare uno scambio perch\u00E9 hai\\nsolo due Pok\u00E9mon.\\c\\nCattura altri Pok\u00E9mon e riprova.\\c"
  },
  {
    "index": 338,
    "flags": 0,
    "text": "Non puoi affrontare una Lotta in Doppio se non\\nhai almeno due Pok\u00E9mon.\\c\\nRiprova quando avrai abbastanza Pok\u00E9mon\\nin squadra.\\c"
  },
  {
    "index": 339,
    "flags": 0,
    "text": "Collegamento in corso.\\nAttendi..."
  },
  {
    "index": 340,
    "flags": 0,
    "text": "C\u2019\u00E8 un problema con il Pok\u00E9mon.\\c"
  },
  {
    "index": 341,
    "flags": 4,
    "text": "Impossibile stabilire la comunicazione.\\c"
  },
  {
    "index": 342,
    "flags": 4,
    "text": "Internet"
  },
  {
    "index": 343,
    "flags": 0,
    "text": "Comunicazione locale"
  },
  {
    "index": 344,
    "flags": 4,
    "text": "Ho sconfitto [VAR 1002][VAR 1502(0000,0001)][VAR 0101(0000)]\\nin un\u2019Avventura Dynamax!"
  },
  {
    "index": 345,
    "flags": 4,
    "text": "Ho sconfitto [VAR 1002][VAR 1502(0000,0001)][VAR 0101(0000)]\\nin un\u2019Avventura Dynamax!"
  }
]
