  {
    "index": 42,
    "flags": 0,
    "text": "Per partecipare a una Gara in Diretta\\ndevi avere il Certificato Partecipante.\\c\\nCome vuoi riceverlo?"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "Ricezione del Certificato Partecipante in corso...\\nPremi il pulsante B per annullare l\u2019operazione."
  },
  {
    "index": 44,
    "flags": 0,
    "text": "L\u2019operazione \u00E8 stata annullata.\\c"
  },
  {
    "index": 45,
    "flags": 4,
    "text": "Hai ricevuto il Certificato Partecipante.\\c"
  },
  {
    "index": 46,
    "flags": 4,
    "text": "Impossibile ricevere il Certificato Partecipante.\\nRiprova dall\u2019inizio.\\c"
  },
  {
    "index": 47,
    "flags": 4,
    "text": "Hai raggiunto il numero di lotte prefissato.\\nComplimenti, ora puoi riposare!\\c"
  },
  {
    "index": 48,
    "flags": 0,
