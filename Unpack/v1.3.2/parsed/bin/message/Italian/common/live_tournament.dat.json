  },
  {
    "index": 51,
    "flags": 0,
    "text": "Vuoi interrompere la ricerca?"
  },
  {
    "index": 52,
    "flags": 4,
    "text": "Interruzione della comunicazione in corso..."
  },
  {
    "index": 53,
    "flags": 0,
    "text": "Vuoi iscrivere una Squadra Lotta con cui\\npartecipare alla gara?"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "Vuoi davvero abbandonare la gara\\n\u201C[VAR 01AF(0000)]\u201D?"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "Se annulli l\u2019iscrizione alla gara, non vi potrai\\npi\u00F9 partecipare.\\c\\nVuoi davvero abbandonare la gara\\n\u201C[VAR 01AF(0000)]\u201D?"
  },
  {
    "index": 56,
    "flags": 4,
    "text": "Hai abbandonato la gara\\n\u201C[VAR 01AF(0000)]\u201D.\\c\\nLa Squadra Lotta \u00E8 stata sbloccata.\\c"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "L\u2019iscrizione della Squadra Lotta \u00E8 stata\\nannullata.\\c"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "[~ 58]"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "Non hai ancora affrontato nessuna lotta.\\c"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "Ricerca di un avversario\\nin corso..."
  },
  {
    "index": 61,
    "flags": 0,
    "text": "Collegamento in corso.\\nAttendi..."
  },
  {
    "index": 62,
    "flags": 0,
    "text": "Quando verr\u00E0 dato il segnale d\u2019inizio,\\npremi il pulsante A."
  },
  {
    "index": 63,
    "flags": 0,
    "text": "Le regole di gara non coincidono.\\c"
