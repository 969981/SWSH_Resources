  },
  {
    "index": 155,
    "flags": 0,
    "text": "Complimenti per aver catturato tutti i Pok\u00E9mon\\nconsigliati!\\c"
  },
  {
    "index": 156,
    "flags": 0,
    "text": "Sembra che tu abbia ancora parecchi Pok\u00E9mon\\nda catturare! Datti da fare!\\c"
  },
  {
    "index": 157,
    "flags": 4,
    "text": "Hai catturato tutti i Pok\u00E9mon dei dintorni!\\c"
  },
  {
    "index": 158,
    "flags": 4,
    "text": "Hai catturato tutti i Pok\u00E9mon che si possono\\nregistrare nel Pok\u00E9dex! Complimenti!\\c\\nOra potresti provare a catturare anche\\nle diverse forme e le varianti cromatiche!\\c"
  },
  {
    "index": 159,
    "flags": 0,
    "text": "S\u00EC"
  },
  {
    "index": 160,
