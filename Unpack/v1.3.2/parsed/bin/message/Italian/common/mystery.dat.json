  },
  {
    "index": 150,
    "flags": 0,
    "text": "Salvataggio in corso.\\nNon spegnere la console."
  },
  {
    "index": 151,
    "flags": 4,
    "text": "Hai ricevuto il seguente strumento:\\n[VAR 0109(0000)] \u00D7[VAR 0202(0001)]"
  },
  {
    "index": 152,
    "flags": 4,
