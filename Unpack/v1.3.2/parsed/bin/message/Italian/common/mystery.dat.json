  },
  {
    "index": 1,
    "flags": 0,
    "text": "Non c\u2019\u00E8 spazio per altri Pok\u00E9mon.\\nVuoi provare comunque a ricevere un dono?"
  },
  {
    "index": 2,
    "flags": 4,
    "text": "Attenzione!\\nSe la console si spegne o la connessione\\nsi interrompe mentre stai ricevendo un dono\\ntramite codice seriale o password, potresti\\nnon essere pi\u00F9 in grado di utilizzare\\nlo stesso codice seriale o la stessa password\\nper ricevere il dono.\\nControlla il livello di carica della batteria\\ndella console o la connessione per assicurarti\\nche non ci siano problemi."
  },
  {
    "index": 3,
    "flags": 4,
    "text": "Attenzione!\\nSe il Nintendo Switch o la Pok\u00E9 Ball Plus\\nsi spengono o se la connessione si interrompe\\nmentre stai ricevendo un dono, potresti\\nnon essere pi\u00F9 in grado di riceverlo.\\nAssicurati che la batteria sia abbastanza carica\\ne che la connessione sia stabile."
  },
  {
    "index": 4,
    "flags": 4,
    "text": "Attenzione!\\nHai inserito pi\u00F9 volte un codice seriale\\no una password errati e per un po\u2019 non\\npotrai inserire codici o password.\\n\\nAttendi un po\u2019 prima di riprovare."
  },
  {
    "index": 5,
    "flags": 4,
    "text": "Attenzione!\\nHai inserito pi\u00F9 volte un codice seriale\\no una password errati.\\nLa ricezione di doni dalla Pok\u00E9 Ball Plus\\n\u00E8 sospesa.\\n\\nAttendi un po\u2019 prima di riprovare."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "Controllo in corso.\\nNon spegnere la console."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "Collegamento in corso.\\nNon spegnere la console."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "Vuoi inserire nuovamente il codice seriale\\no la password?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "Ricerca di un dono in corso."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "Si \u00E8 verificato un problema con la ricezione\\ndel dono."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "Non sono stati trovati doni."
  },
  {
    "index": 12,
    "flags": 4,
    "text": "Interruzione della comunicazione.\\nAttendi..."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "Seleziona il dono che vuoi ricevere."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "Vuoi annullare la ricezione?"
  },
  {
    "index": 15,
    "flags": 4,
    "text": "Hai gi\u00E0 ricevuto questo dono.\\nNon puoi riceverlo di nuovo."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "Non c\u2019\u00E8 spazio per altri Pok\u00E9mon.\\nRiprova dopo aver fatto un po\u2019 di spazio\\nin squadra o nei Box."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "Ricezione del dono in corso.\\nNon spegnere la console."
  },
  {
    "index": 18,
    "flags": 4,
    "text": "\u00C8 stato trovato un dono, ma non puoi ottenerlo\\ncon questo software."
  },
  {
    "index": 19,
    "flags": 0,
    "text": "Verr\u00E0 stabilito il collegamento a Internet.\\nIl gioco verr\u00E0 salvato. Vuoi continuare?"
