  },
  {
    "index": 153,
    "flags": 4,
    "text": "Hai ricevuto i seguenti strumenti:\\n[VAR 0109(0000)] \u00D7[VAR 0202(0001)]\\n[VAR 0109(0002)] \u00D7[VAR 0202(0003)]"
  },
  {
    "index": 154,
    "flags": 4,
    "text": "Hai ricevuto i seguenti strumenti:\\n[VAR 0109(0000)] \u00D7[VAR 0202(0001)]\\n[VAR 0109(0002)] \u00D7[VAR 0202(0003)]\\n[VAR 0109(0004)] \u00D7[VAR 0202(0005)]"
  },
  {
