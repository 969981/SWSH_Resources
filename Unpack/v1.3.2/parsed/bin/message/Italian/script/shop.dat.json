  {
    "index": 98,
    "flags": 0,
    "text": "Senti che profumo intenso! Che ne dici di\\ndeliziarti con qualche fragranza esotica?"
  },
  {
    "index": 99,
    "flags": 8,
    "text": "Spero di rivederti presto."
  },
  {
    "index": 100,
    "flags": 0,
    "text": "Desideri altro?"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "[VAR 1501(0000,0000)][VAR 0109(0000)]?\\n[VAR 1001]Quant[VAR 1102(0000,0101,0101)]oaie ne vuoi?"
  },
  {
    "index": 102,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)]?\\nFanno [VAR 0206(0002,002E)] \uE300."
  },
  {
    "index": 103,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)]?\\nFanno [VAR 0206(0002,002E)] \uE300."
  },
  {
    "index": 104,
    "flags": 4,
    "text": "Eccoti servit[VAR 1100(00FF,0101)]oa.\\nTorna pure a trovarmi quando vuoi.\\c"
  },
  {
    "index": 105,
    "flags": 4,
    "text": "Accidenti... Sembra che siano un po\u2019 troppi.\\nNon hai pi\u00F9 spazio...\\c"
  },
  {
    "index": 106,
    "flags": 0,
    "text": "Mi spiace ma non hai abbastanza soldi...!\\c"
  },
  {
    "index": 107,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)]?\\nFanno [VAR 0206(0002,002E)] PL."
  },
  {
    "index": 108,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)]?\\nFanno [VAR 0206(0002,002E)] PL."
  },
  {
    "index": 109,
    "flags": 4,
    "text": "Ehi, ciao! Vendo rimedi naturali! Sto ancora\\nimparando, ma ci\u00F2 che offro \u00E8 di ottima qualit\u00E0!"
  },
  {
    "index": 110,
    "flags": 0,
    "text": "Grazie! Sempre al tuo servizio!"
  },
  {
    "index": 111,
    "flags": 0,
    "text": "Che te ne pare, eh?!\\nMagari vuoi pure qualcos\u2019altro?"
  },
  {
    "index": 112,
    "flags": 0,
    "text": "Quante [VAR 1001][VAR 010A(0000)] vuoi?"
  },
  {
    "index": 113,
    "flags": 4,
    "text": "Allora, [VAR 0202(0001)] [VAR 010A(0000)], giusto?\\nFanno [VAR 0206(0002,002E)] \uE300. Bene cos\u00EC?"
  },
  {
    "index": 114,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)], giusto?\\nIn tutto fanno [VAR 0206(0002,002E)] \uE300. Bene cos\u00EC?"
  },
  {
    "index": 115,
    "flags": 4,
    "text": "Ecco qua, prendi!\\nI miei sono rimedi efficacissimi! Vedrai che roba!\\c"
  },
  {
    "index": 116,
    "flags": 4,
    "text": "Ehi, dove la metti tutta questa roba?\\nNon hai abbastanza spazio!\\c"
  },
  {
    "index": 117,
    "flags": 0,
    "text": "Ma... Guarda che questi soldi non bastano.\\nTi toccher\u00E0 metterne da parte di pi\u00F9...\\c"
  },
  {
    "index": 118,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)]?\\nFanno [VAR 0206(0002,002E)] PL."
  },
  {
    "index": 119,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)]?\\nFanno [VAR 0206(0002,002E)] PL."
  },
  {
    "index": 120,
    "flags": 0,
    "text": "Bacche! Bacche fresche appena raccolte!\\nTi interessa?"
  },
  {
    "index": 121,
    "flags": 0,
    "text": "Grazie per la visita! Alla prossima!"
  },
  {
    "index": 122,
    "flags": 0,
    "text": "Vuoi comprare altre bacche?"
  },
  {
    "index": 123,
    "flags": 0,
    "text": "Quante [VAR 0109(0000)] vuoi?"
  },
  {
    "index": 124,
    "flags": 4,
    "text": "Allora... [VAR 0202(0001)] [VAR 010A(0000)], eh?\\nFanno [VAR 0206(0002,002E)] \uE300!"
  },
  {
    "index": 125,
    "flags": 4,
    "text": "Allora... [VAR 0202(0001)] [VAR 010A(0000)], eh?\\nFanno [VAR 0206(0002,002E)] \uE300!"
  },
  {
    "index": 126,
    "flags": 4,
    "text": "Ecco a te! Vedrai come si leccheranno i baffi\\ni tuoi Pok\u00E9mon!\\c"
  },
  {
    "index": 127,
    "flags": 0,
    "text": "Perbacco! Non hai spazio per tutte queste\\nbacche!\\c"
  },
  {
    "index": 128,
    "flags": 0,
    "text": "Perbacco! Non hai soldi per le mie bacche!\\nSpiacente ma non possiamo fare affari...\\c"
  },
  {
    "index": 129,
    "flags": 0,
    "text": "[VAR 0202(0001)] [VAR 010A(0000)]?\\nFanno [VAR 0206(0002,002E)] PL."
  },
  {
    "index": 130,
