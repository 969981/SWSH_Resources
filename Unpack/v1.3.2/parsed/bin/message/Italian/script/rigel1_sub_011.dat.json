  },
  {
    "index": 5,
    "flags": 0,
    "text": "Di-Di... Diglett!!!"
  },
  {
    "index": 6,
    "flags": 4,
    "text": "Ah! Diglett!\\nEcco dov\u2019eri finito!"
  },
  {
    "index": 7,
    "flags": 4,
    "text": "Ahahah, piccola peste!\\nMi hai fatto preoccupare!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "Dig!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "Grazie per aver trovato il mio Diglett!"
  },
  {
    "index": 10,
    "flags": 4,
    "text": "\u00C8 un Diglett?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "Viene da Alola?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "Questo \u00E8 un Diglett di Alola!"
  },
  {
    "index": 13,
    "flags": 4,
    "text": "\u00C8 una forma regionale...\\c\\nIl suo aspetto cambia a seconda della regione\\nda cui proviene."
  },
  {
    "index": 14,
    "flags": 4,
    "text": "Oh! Non mi sarei mai aspettato di trovare qui\\nqualcuno che sapesse da dove viene!"
  },
  {
    "index": 15,
    "flags": 4,
    "text": "\u00C8 proprio come hai detto tu!\\nQuesto \u00E8 un Diglett di Alola!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "Mentre ero in viaggio in quella regione, sono\\nstato rapito dal fascino di quei tre peletti..."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "Ne ho catturati un sacco...\\c\\nMa dopo essere tornato qui, mi sono distratto\\nun attimo e sono spariti tutti..."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "Digl\u00EC!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "Comunque tu sei riuscit[VAR 1100(00FF,0101)]oa a trovare un Diglett\\nnascosto sottoterra..."
  },
  {
    "index": 20,
    "flags": 0,
    "text": "Ci vuole talento per fare una cosa del genere!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "Se non ti dispiace, potresti aiutarmi a trovare\\nanche gli altri Diglett?"
  },
  {
    "index": 22,
    "flags": 4,
    "text": "Oh, ma che gentile!\\nNon ho parole per ringraziarti!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "Non ti preoccupare, \u00E8 facile!\\c\\nSe trovi tre peletti mentre vai in giro,\\nbasta solo che li esamini."
  },
  {
    "index": 24,
    "flags": 0,
    "text": "Finora hai trovato [VAR 0202(0001)] Diglett...\\nNe riman[VAR 1101(0002,0401)]egono ancora [VAR 0202(0002)]."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "Se li trovi, di\u2019 loro di tornare a casa!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "Se lo trovi, digli di tornare a casa!"
  },
  {
    "index": 27,
    "flags": 4,
    "text": "Ehil\u00E0!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "Grazie al tuo aiuto, [VAR 0202(0001)] altr[VAR 1101(0001,0101)]oi Diglett\\n[VAR 1101(0001,0C09)]\u00E8 tornatosono tornati a casa!"
  },
  {
    "index": 29,
    "flags": 4,
    "text": "E c\u2019\u00E8 anche chi si \u00E8 evoluto in Dugtrio!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "Se trovi altri di questi tre peletti, rimandali\\nda me!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "Sono cos\u00EC felice che siano tornati cos\u00EC\\ntanti Diglett..."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "Voglio regalarti questo Pok\u00E9mon!"
  },
  {
    "index": 33,
    "flags": 4,
    "text": "\u00C8 un Pok\u00E9mon che ho incontrato ad Alola,\\nproprio come Diglett!"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "Voglio regalarti questo strumento!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "Vediamo... Con questo sono tornati..."
  },
  {
    "index": 36,
    "flags": 0,
    "text": "151 Diglett?!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "Non so come ringraziarti!\\nPer merito tuo tutti i miei Diglett sono tornati!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "Dilettt!!"
  },
  {
    "index": 39,
    "flags": 8,
    "text": "Sta dicendo che ti sei meritat[VAR 1100(00FF,0101)]oa il loro rispetto\\nper averli trovati tutti."
