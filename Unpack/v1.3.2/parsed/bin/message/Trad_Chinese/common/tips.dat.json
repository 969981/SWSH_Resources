    "text": "\uFF39\uFF39\u901A\u8A0A"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u900F\u904E\uFF39\uFF39\u901A\u8A0A\uFF0C\\n\u53EF\u4EE5\u4E00\u908A\u5192\u96AA\uFF0C\\n\u4E00\u908A\u8DDF\u5176\u4ED6\u73A9\u5BB6\u4EA4\u63DB\u5BF6\u53EF\u5922\\n\u6216\u9032\u884C\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\n\u4EAB\u53D7\u5404\u7A2E\u9023\u7DDA\u7684\u6A02\u8DA3\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9019\u53EB\u505A\u5716\u7AE0\u3002\\n\u53EA\u8981\u5728\uFF39\uFF39\u901A\u8A0A\u4E2D\\n\u9078\u64C7\u300C\u9023\u7DDA\u300D\u9805\u76EE\uFF0C\\n\u5728\u958B\u59CB\u9023\u7DDA\u5F8C\uFF0C\\n\u5C31\u80FD\u628A\u5BE6\u6CC1\u8CBC\u50B3\u9001\u7D66\u5176\u4ED6\u73A9\u5BB6\uFF01\\n\u9084\u6703\u6709\u8A0A\u606F\u5BEB\u5728\u5BE6\u6CC1\u8CBC\u4E0A\u9762\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4E00\u822C\u60C5\u6CC1\u4E0B\uFF0C\\n\uFF39\uFF39\u901A\u8A0A\u6703\u548C\u9644\u8FD1\u7684\u73A9\u5BB6\u9023\u7DDA\u3002\\n\u5728\u6309\u4E0B\uFF0B\u9375\u9023\u4E0A\u7DB2\u8DEF\u5F8C\uFF0C\\n\u5C31\u80FD\u548C\u5168\u4E16\u754C\u7684\u73A9\u5BB6\u9023\u7DDA\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7576\u5728\u5192\u96AA\u6642\u6536\u5230\u5BE6\u6CC1\u8CBC\uFF0C\\n\u5C31\u8868\u793A\u6709\u53EF\u4EE5\u900F\u904E\u9023\u7DDA\\n\u4E00\u8D77\u73A9\u7684\u4EBA\uFF01\\n\\n\u6309\u4E0B\uFF39\u9375\u5C0B\u627E\u9023\u7DDA\u5C0D\u8C61\u5427\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u53EA\u8981\u9078\u64C7\u5370\u6709\\n\u5BF6\u53EF\u5922\u526A\u5F71\u7684\u5BE6\u6CC1\u8CBC\uFF0C\\n\u5C31\u80FD\u548C\u670B\u53CB\u4E00\u8D77\\n\u8207\u5BF6\u53EF\u5922\u5C0D\u6230\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u806F\u76DF\u5361"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u900F\u904E\u806F\u76DF\u5361\u4F86\u5C55\u793A\\n\u81EA\u5DF1\u7684\u500B\u4EBA\u8CC7\u8A0A\u5427\uFF01\\n\u53EA\u8981\u7528\u8A2D\u7F6E\u5728\u5404\u5730\\n\u5BF6\u53EF\u5922\u4E2D\u5FC3\u88E1\u7684\\n\u88FD\u5361\u5DE5\u5177\u4F86\u7DE8\u8F2F\u806F\u76DF\u5361\uFF0C\\n\u5C31\u80FD\u66F4\u65B0\u5361\u7247\u8CC7\u8A0A\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6BCF\u500B\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\\n\u90FD\u6301\u6709\u5404\u81EA\u7684\u806F\u76DF\u5361\uFF0C\\n\u4E26\u80FD\u900F\u904E\u9023\u7DDA\u4F86\u4EA4\u63DB\u3002\\n\u5728\uFF38\u9375\u9078\u55AE\u7684\u806F\u76DF\u5361\u4E2D\\n\u9078\u64C7\u806F\u76DF\u5361\u518A\uFF0C\\n\u5C31\u80FD\u67E5\u770B\u6536\u96C6\u5230\u7684\u806F\u76DF\u5361\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5728\uFF38\u9375\u9078\u55AE\u7684\u806F\u76DF\u5361\u4E2D\\n\u9078\u64C7\u806F\u76DF\u5361\u518A\uFF0C\\n\u5C31\u80FD\u67E5\u770B\u904E\u5F80\u6536\u5230\u7684\u806F\u76DF\u5361\u3002\\n\\n\u9084\u80FD\u67E5\u770B\u900F\u904E\u9023\u7DDA\\n\u7372\u5F97\u7684\u806F\u76DF\u5361\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5C0D\u6230\u7AF6\u6280\u5834"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5728\u5C0D\u6230\u7AF6\u6280\u5834\\n\u53EF\u4EE5\u8DDF\u4E16\u754C\u5404\u5730\u7684\u4EBA\\n\u9032\u884C\u9023\u7DDA\u5C0D\u6230\uFF0C\\n\u9084\u80FD\u53C3\u52A0\u5404\u5F0F\u5404\u6A23\u7684\u5927\u8CFD\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u81EA\u7531\u5C0D\u6230\u662F\u500B\u80FD\u96A8\u610F\u8DDF\\n\u5176\u4ED6\u73A9\u5BB6\u9032\u884C\u5C0D\u6230\u7684\u6A21\u5F0F\u3002\\n\u4E5F\u8A31\u80FD\u770B\u898B\u610F\u5916\u7684\u5BF6\u53EF\u5922\\n\u548C\u62DB\u5F0F\u4E5F\u8AAA\u4E0D\u5B9A\uFF1F"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u7D1A\u5225\u5C0D\u6230\u662F\u500B\u900F\u904E\u6FC0\u70C8\u7684\u5C0D\u6230\\n\u4F86\u722D\u596A\u66F4\u9AD8\u7D1A\u5225\u7684\u6A21\u5F0F\u3002\\n\u8C61\u5FB5\u8457\u5BE6\u529B\u7684\u7D1A\u5225\u6703\u96A8\u8457\\n\u5C0D\u6230\u7684\u7D50\u679C\u800C\u6709\u6240\u6539\u8B8A\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5728\u7DB2\u8DEF\u5927\u8CFD\u4E2D\uFF0C\\n\u6703\u4F7F\u7528\u4E00\u7A2E\u540D\u70BA\u7A4D\u5206\u7684\u6578\u5B57\\n\u4F86\u8868\u793A\u8A13\u7DF4\u5BB6\u7684\u5BE6\u529B\u3002\\n\u8A13\u7DF4\u5BB6\u5C07\u5728\u4E00\u5B9A\u671F\u9593\u5167\u9032\u884C\u5C0D\u6230\uFF0C\\n\u518D\u6BD4\u8F03\u7A4D\u5206\u7684\u591A\u5BE1\u3002\\n\u8207\u5176\u4ED6\u6A21\u5F0F\u4E0D\u540C\uFF0C\\n\u8A13\u7DF4\u5BB6\u9700\u81EA\u884C\u5C0B\u627E\u5927\u8CFD\u4F86\u53C3\u52A0\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6975\u5DE8\u5316"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4F3D\u52D2\u723E\u5730\u5340\u7684\u5BF6\u53EF\u5922\\n\u80FD\u5728\u7279\u5B9A\u7684\u5730\u65B9\u8B8A\u5927\uFF0C\\n\u9019\u7A2E\u73FE\u8C61\u5C31\u53EB\u505A\u6975\u5DE8\u5316\u3002\\n\u5728\u6975\u5DE8\u8155\u5E36\u767C\u5149\u6642\\n\u6309\u4E0B[VAR FF00(0006)]\u6975\u5DE8\u5316\u6309\u9215[VAR FF00(0000)]\uFF0C\\n\u5BF6\u53EF\u5922\u5C31\u6703\u6975\u5DE8\u5316\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6975\u5DE8\u5316\u7684\u6301\u7E8C\u6642\u9593\u662F[VAR FF00(0006)]\uFF13\u56DE\u5408[VAR FF00(0000)]\uFF01\\n\\n\u5728\u9019\u6BB5\u671F\u9593\uFF0C\\n\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u5C07\u80FD\u4F7F\u51FA\\n\u5F37\u529B\u7684[VAR FF00(0006)]\u6975\u5DE8\u62DB\u5F0F[VAR FF00(0000)]\u3002\\n\u6B64\u5916\uFF0C\u6975\u5DE8\u62DB\u5F0F\\n\u9084\u80FD\u7522\u751F\u7279\u5225\u7684\u6548\u679C\u3002\\n\u62DB\u5F0F\u7684\u6548\u679C\u5C07\u6839\u64DA\\n\u5C6C\u6027\u800C\u6709\u6240\u6539\u8B8A\u3002\\n\\n\u770B\u6E96\u6975\u5DE8\u5316\u7684\u6642\u6A5F\uFF0C\\n\u8D0F\u53D6\u52DD\u5229\u5427\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u9732\u71DF"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u5728\u5BF6\u53EF\u5922\u9732\u71DF\u4E2D\uFF0C\\n\u53EF\u4EE5\u900F\u904E\u8DDF\u5BF6\u53EF\u5922\u4E00\u8D77\u73A9\\n\u548C\u5403\u6599\u7406\u4F86\u52A0\u6DF1\u5F7C\u6B64\u7684\u611F\u60C5\uFF01\\n\u548C\u5BF6\u53EF\u5922\u591A\u73A9\u73A9\uFF0C\\n\u8AAA\u4E0D\u5B9A\u7260\u5011\u6703\u66F4\u52AA\u529B\u5C0D\u6230\u5594\uFF1F"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u4E5F\u8A66\u8457\u7528Joy-Con\u73A9\u73A9\u770B\u5427\uFF01\\n\u53D6\u4E0B\u4E26\u63EE\u52D5Joy-Con\uFF0C\\n\u5C31\u53EF\u4EE5\u6295\u64F2\u7CBE\u9748\u7403\u6216\\n\u63EE\u821E\u5BF6\u53EF\u5C3E\u8349\u4F86\u8DDF\u5BF6\u53EF\u5922\u73A9\uFF01\\n\u53EA\u8981\u5BF6\u53EF\u5C3E\u8349\u63EE\u821E\u5F97\u597D\uFF0C\\n\u4E5F\u80FD\u5438\u5F15\u5BF6\u53EF\u5922\u7684\u6CE8\u610F\uFF01"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u5728\u66E0\u91CE\u5730\u5E36\u9732\u71DF\u6642\uFF0C\\n\u6700\u591A\u53EF\u4EE5\u548C\uFF14\u500B\u73A9\u5BB6\u4E00\u8D77\u73A9\u3002\\n\u5076\u723E\u4E5F\u6703\u6709\u4E9B\u6C92\u9047\u5230\u904E\u7684\\n\u4EBA\u548C\u5BF6\u53EF\u5922\u9032\u5230\u71DF\u5730\u88E1\u3002\\n\u5927\u5BB6\u4E00\u8D77\u958B\u5FC3\u5730\u73A9\u5427\uFF01"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6599\u7406"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u9078\u64C7\u81EA\u5DF1\u559C\u6B61\u7684\\n\u98DF\u6750\u548C\u6A39\u679C\u4F86\u505A\u6599\u7406\u5427\uFF01\\n\\n\u4F7F\u7528\u73CD\u8CB4\u7684\u98DF\u6750\u6216\\n\u653E\u5165\u5927\u91CF\u6A39\u679C\uFF0C\\n\u6703\u4EE4\u6599\u7406\u8B8A\u5F97\u66F4\u52A0\u7F8E\u5473\u3002"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u6599\u7406\u958B\u59CB\u4E4B\u5F8C\uFF0C\\n\u7528\u5718\u6247\u8ABF\u6574\u706B\u529B\uFF0C\\n\u6216\u4EE5\u6E6F\u52FA\u5C0F\u5FC3\u652A\u62CC\u5427\uFF01\\n\u6700\u5F8C\uFF0C\u5728\u9069\u7576\u7684\u6642\u6A5F\\n\u50BE\u6CE8\u81EA\u5DF1\u5C0D\u5BF6\u53EF\u5922\u7684\u771F\u5FC3\uFF0C\\n\u6599\u7406\u5C31\u5B8C\u6210\u4E86\uFF01"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6599\u7406\u5B8C\u6210\u4E4B\u5F8C\uFF0C\\n\u5C31\u548C\u5927\u5BB6\u4E00\u8D77\u5403\u5427\uFF01\\n\u6599\u7406\u80FD\u5E36\u4F86\u8A31\u591A\u4E0D\u540C\u7684\u6548\u679C\uFF0C\\n\u4F8B\u5982\u53EF\u4EE5\u8B93\u53C3\u52A0\u9732\u71DF\u7684\\n\u5BF6\u53EF\u5922\u6062\u5FA9\u6D3B\u529B\u6216\u662F\\n\u548C\u5BF6\u53EF\u5922\u8B8A\u5F97\u53CB\u597D\u7B49\u7B49\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "[~ 34]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u5DE2\u7A74"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u5728\u66E0\u91CE\u5730\u5E36\u767C\u51FA\u7D05\u5149\u7684\u5730\u65B9\\n\u5C31\u662F\u5BF6\u53EF\u5922\u5DE2\u7A74\u3002\\n\u90A3\u88E1\u96B1\u85CF\u8457\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\uFF0C\\n\u53EA\u8981\u524D\u53BB\u8ABF\u67E5\uFF0C\\n\u4E0D\u7BA1\u662F\u4E00\u500B\u4EBA\u9084\u662F\u56DB\u500B\u4EBA\\n\u90FD\u80FD\u5920\u6311\u6230\uFF01"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u5982\u679C\u5BF6\u53EF\u5922\u5DE2\u7A74\u6C92\u6709\u51FA\u73FE\u5149\u67F1\uFF0C\\n\u53EA\u8981\u628A\u8A31\u9858\u661F\u788E\u7247\u4E1F\u9032\u53BB\uFF0C\\n\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u5C31\u6703\u51FA\u73FE\uFF01\\n\u8A66\u8457\u5F80\u611F\u8208\u8DA3\u7684\u5BF6\u53EF\u5922\u5DE2\u7A74\\n\u6295\u64F2\u8A31\u9858\u661F\u788E\u7247\u5427\uFF01"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u5728\u767C\u5149\u7684\u5BF6\u53EF\u5922\u5DE2\u7A74\\n\u53EF\u4EE5\u7372\u5F97\u4E00\u7A2E\u53EB\u505A\uFF37\u7684\u80FD\u91CF\u3002\\n\\n\u628A\uFF37\u4EA4\u7D66\u66E0\u91CE\u5730\u5E36\u7684\u8A13\u7DF4\u5BB6\uFF0C\\n\u5C31\u80FD\u5F97\u5230\u5404\u5F0F\u5404\u6A23\u7684\u9053\u5177\uFF01"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u6975\u5DE8\u5718\u9AD4\u6230"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u53EA\u8981\u6253\u6557\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\uFF0C\\n\u5C31\u80FD\u6349\u4F4F\u7260\u5011\u3002\\n\\n\u9664\u6B64\u4E4B\u5916\u9084\u80FD\u7372\u5F97\u7121\u6CD5\u5728\\n\u5176\u4ED6\u5730\u65B9\u627E\u5230\u7684\u73CD\u8CB4\u9053\u5177\u3002"
  },
  {
