[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F3D\u52D2\u723E\u99AC\u85A9\u62C9\u9999\u6599\u6563\u767C\u51FA\\n\u4EE4\u4EBA\u98DF\u6307\u5927\u52D5\u7684\u9999\u6C23\u3002\\n\u6700\u7C21\u55AE\u7684\u57FA\u672C\u6B3E\u5496\u54E9\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F3D\u52D2\u723E\u99AC\u85A9\u62C9\u9999\u6599\u7684\u9999\u6C23\\n\u896F\u6258\u51FA\u55AE\u7D14\u800C\u9BAE\u660E\u7684\u8FA3\u5473\u3002\\n\u975E\u5E38\u57FA\u672C\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F3D\u52D2\u723E\u99AC\u85A9\u62C9\u9999\u6599\u7684\u9999\u6C23\\n\u51F8\u986F\u51FA\u6FC3\u539A\u7684\u6F80\u5473\u3002\\n\u5BB9\u6613\u5165\u53E3\u7684\u57FA\u672C\u6B3E\u5496\u54E9\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F3D\u52D2\u723E\u99AC\u85A9\u62C9\u9999\u6599\u7684\u9999\u6C23\u4E2D\\n\u860A\u542B\u7684\u6FC3\u90C1\u751C\u5473\u662F\u6700\u5927\u4EAE\u9EDE\u3002\\n\u662F\u53D7\u773E\u4EBA\u559C\u611B\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F3D\u52D2\u723E\u99AC\u85A9\u62C9\u9999\u6599\u7684\u9999\u6C23\\n\u5F37\u70C8\u896F\u6258\u51FA\u4E86\u5496\u54E9\u7684\u82E6\u5473\u3002\\n\u76F8\u7576\u57FA\u672C\u6B3E\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F3D\u52D2\u723E\u99AC\u85A9\u62C9\u9999\u6599\u7684\u9999\u6C23\\n\u4F7F\u9178\u5473\u8B8A\u5F97\u6EAB\u548C\u9806\u53E3\u3002\\n\u5341\u5206\u7C21\u55AE\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u56E0\u70BA\u8ABF\u5473\u7C21\u55AE\uFF0C\\n\u53CD\u800C\u66F4\u52A0\u51F8\u986F\u51FA\u4E86\\n\u6C34\u716E\u9999\u8178\u7F8E\u5473\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4EE5\u5E36\u6709\u8FA3\u5473\u7684\u5496\u54E9\u91AC\\n\u896F\u6258\u51FA\u9999\u8178\u672C\u8EAB\\n\u9BAE\u7F8E\u6ECB\u5473\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u82E6\u6F80\u7684\u5496\u54E9\u91AC\u4E2D\u548C\u4E86\\n\u9999\u8178\u7684\u6CB9\u81A9\u611F\u3002\\n\u5F88\u5BB9\u6613\u5165\u53E3\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u9999\u8178\u7684\u9BAE\u5473\u548C\\n\u5FAE\u751C\u7684\u5496\u54E9\u91AC\u5F88\u642D\u8ABF\u3002\\n\u662F\u5F88\u7CBE\u7DFB\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9999\u8178\u7684\u53E3\u611F\u548C\\n\u82E6\u6F80\u7684\u5496\u54E9\u91AC\u5F88\u642D\u8ABF\u3002\\n\u662F\u8F03\u9069\u5408\u5927\u4EBA\u5403\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9178\u5473\u660E\u986F\u7684\u5496\u54E9\u91AC\\n\u642D\u914D\u6ECB\u5473\u6FC3\u539A\u7684\u9999\u8178\u3002\\n\u8B93\u4EBA\u98DF\u6B32\u5927\u632F\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4EE5\u98FD\u4F2F\u79D8\u50B3\u7684\u98DF\u6750\u88FD\u6210\u3002\\n\u5206\u91CF\u9A5A\u4EBA\u4E14\u80FD\u4EAB\u53D7\u5230\\n\u5F37\u70C8\u5C64\u6B21\u611F\u7684\u5496\u54E9\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5C64\u6B21\u8C50\u5BCC\u7684\u8FA3\u5473\u8207\\n\u53E3\u611F\u5F37\u70C8\u7684\u98DF\u6750\u76F8\u9047\uFF0C\\n\u5275\u9020\u51FA\u4E86\u773C\u524D\u9019\u9053\u5947\u8E5F\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6F80\u5473\u548C\u6CB9\u8102\u7684\u7D55\u5999\u642D\u914D\uFF0C\\n\u6DF1\u53D7\u7537\u5973\u8001\u5C11\u559C\u611B\uFF0C\\n\u662F\u4EE4\u4EBA\u5B89\u5FC3\u7684\u7A69\u5B9A\u6ECB\u5473\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4E4D\u770B\u4E4B\u4E0B\u4E0D\u642D\u8ABF\u7684\u7D44\u5408\uFF0C\\n\u537B\u540C\u6642\u5B58\u5728\u8457\u7121\u53EF\u6BD4\u64EC\u7684\\n\u5C64\u6B21\u611F\u548C\u6E05\u723D\u611F\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5373\u4F7F\u5728\u5674\u6E67\u800C\u51FA\u7684\u6CB9\u8102\u4E2D\uFF0C\\n\u5496\u54E9\u91AC\u5FAE\u5FAE\u7684\u82E6\u5473\u4ECD\u7136\\n\u88AB\u51F8\u986F\u4E86\u51FA\u4F86\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5496\u54E9\u91AC\u7684\u9178\u5473\u6210\u529F\\n\u6291\u5236\u4E86\u98DF\u6750\u7684\u96DC\u5473\uFF0C\\n\u53EA\u5C07\u9BAE\u5473\u8403\u53D6\u800C\u51FA\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F7F\u7528\u4E86\u64DA\u8AAA\u662F\u5DF4\u54C8\\n\u79D8\u85CF\u7684\u7368\u5BB6\u98DF\u6750\\n\u6240\u88FD\u6210\u7684\u73CD\u8CB4\u5496\u54E9\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u9BAE\u5473\u5F37\u70C8\u7684\u98DF\u6750\u548C\\n\u5E36\u6709\u8FA3\u5473\u7684\u5496\u54E9\u91AC\\n\u53EF\u4EE5\u8AAA\u662F\u9EC3\u91D1\u7D44\u5408\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5496\u54E9\u91AC\u6E05\u723D\u7684\u6F80\u5473\\n\u9032\u4E00\u6B65\u51F8\u986F\u51FA\u4E86\\n\u98DF\u6750\u6FC3\u539A\u7684\u5473\u9053\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u5F37\u70C8\u7684\u751C\u5473\u548C\u5C64\u6B21\u611F\u3002\\n\u5982\u679C\u60F3\u8981\u81EA\u7A31\u5496\u54E9\u901A\uFF0C\\n\u5C31\u7D55\u4E0D\u80FD\u932F\u904E\u9019\u9053\u5496\u54E9\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u8B93\u820C\u982D\u767C\u9EBB\u7684\u9BAE\u7F8E\u6ECB\u5473\u3002\\n\u504F\u82E6\u7684\u8ABF\u5473\u628A\u98DF\u6750\u7684\u5473\u9053\\n\u66F4\u52A0\u9BAE\u660E\u5730\u896F\u6258\u51FA\u4F86\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6CBE\u6EFF\u9178\u5473\u5496\u54E9\u91AC\\n\u7684\u98DF\u6750\u4E0D\u7BA1\u5403\u591A\u5C11\\n\u90FD\u4E0D\u6703\u89BA\u5F97\u81A9\u3002"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5728\u6B63\u7D71\u7684\u5496\u54E9\u91AC\u88E1\\n\u71C9\u5F97\u6070\u5230\u597D\u8655\u7684\u8C46\u5B50\u3002\\n\u5341\u5206\u55AE\u7D14\u7684\u5473\u9053\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u5496\u54E9\u91AC\u5F37\u70C8\u7684\u8FA3\u5473\\n\u548C\u8C46\u5B50\u81EA\u7136\u7684\u751C\u5473\\n\u5F62\u6210\u4E86\u6709\u8DA3\u7684\u5C0D\u6BD4\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5496\u54E9\u91AC\u7684\u6F80\u5473\u914D\u4E0A\u8C46\u5B50\\n\u55AE\u7D14\u800C\u6E05\u6DE1\u7684\u9BAE\u5473\u3002\\n\u96D6\u7136\u8CEA\u6A38\u537B\u4EE4\u4EBA\u767E\u5403\u4E0D\u81A9\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u504F\u751C\u7684\u8ABF\u5473\u8B93\u539F\u672C\\n\u6E05\u6DE1\u7684\u8C46\u5B50\u7522\u751F\u4E86\\n\u6EAB\u6F64\u800C\u6709\u6DF1\u5EA6\u7684\u5473\u9053\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u5496\u54E9\u91AC\u7684\u82E6\u5473\u4E2D\u548C\u4E86\\n\u8C46\u5B50\u7279\u6709\u7684\u8165\u5473\u3002\\n\u8B93\u8A0E\u53AD\u8C46\u5B50\u7684\u4EBA\u4E5F\u8B9A\u4E0D\u7D55\u53E3\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u8C46\u5B50\u7684\u9999\u8106\u53E3\u611F\u8207\\n\u9178\u5473\u5496\u54E9\u91AC\u7684\u642D\u914D\uFF0C\\n\u5F77\u5F7F\u5728\u6F14\u594F\u7F8E\u9E97\u7684\u548C\u8072\u4E00\u822C\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uFF12\u7A2E\u78B3\u6C34\u5316\u5408\u7269\u7684\u7D44\u5408\\n\u8B93\u4EBA\u60F3\u4E0D\u5403\u98FD\u90FD\u96E3\u3002\\n\u4EBA\u4EBA\u90FD\u80FD\u8F15\u9B06\u4E0A\u624B\u7684\u6599\u7406\u3002"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u96A8\u624B\u653E\u4E0A\u53BB\u7684\u70E4\u5410\u53F8\u5728\\n\u8FA3\u5473\u5496\u54E9\u91AC\u7684\u914D\u5408\u4E0B\uFF0C\\n\u610F\u5916\u5730\u53EF\u4EE5\u8F15\u9B06\u5403\u5B8C\u3002"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u5148\u628A\u70E4\u5410\u53F8\u6495\u6210\u5C0F\u584A\uFF0C\\n\u548C\u5496\u54E9\u91AC\u5145\u5206\u6DF7\u5408\u4E4B\u5F8C\uFF0C\\n\u6F80\u5473\u5C31\u6703\u8B8A\u5F97\u67D4\u548C\u5BB9\u6613\u5165\u53E3\u3002"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u751C\u5496\u54E9\u91AC\u5B9B\u5982\u679C\u91AC\u4E00\u822C\u3002\\n\u653E\u5230\u9999\u5473\u56DB\u6EA2\u7684\u70E4\u5410\u53F8\u4E0A\uFF0C\\n\u5403\u8D77\u4F86\u4E0D\u53EF\u601D\u8B70\u5730\u7F8E\u5473\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u70E4\u6210\u91D1\u9EC3\u8272\u7684\u9999\u5674\u5674\u5410\u53F8\\n\u548C\u5496\u54E9\u91AC\u7684\u82E6\u5473\u5F62\u6210\u4E86\\n\u4E00\u7A2E\u4E0D\u53EF\u601D\u8B70\u7684\u5354\u8ABF\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u70E4\u5410\u53F8\u9B06\u8EDF\u7684\u53E3\u611F\\n\u8CE6\u4E88\u4E86\u9178\u5473\u5496\u54E9\u91AC\\n\u66F4\u6709\u5C64\u6B21\u611F\u7684\u98A8\u5473\u3002"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u80FD\u540C\u6642\u4EAB\u53D7\u5230\u5496\u54E9\u98EF\u548C\\n\u5496\u54E9\u901A\u5FC3\u9EB5\u7684\u4E00\u9053\u5496\u54E9\u3002\\n\u5728\u809A\u5B50\u9913\u7684\u6642\u5019\u5403\u5427\u3002"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u70BA\u4E86\u767C\u63EE\u504F\u8FA3\u8ABF\u5473\u7684\u7279\u8272\uFF0C\\n\u5EFA\u8B70\u4E00\u958B\u59CB\u53EF\u4EE5\u5148\u628A\\n\u6750\u6599\u5168\u90E8\u652A\u62CC\u5747\u52FB\u518D\u5403\u3002"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6F80\u5473\u548C\u901A\u5FC3\u9EB5\u4E5F\u5F88\u642D\u8ABF\u3002\\n\u80FD\u5920\u540C\u6642\u4EAB\u53D7\u7C73\u98EF\u548C\\n\u901A\u5FC3\u9EB5\uFF12\u7A2E\u78B3\u6C34\u5316\u5408\u7269\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u59D1\u4E14\u4E0D\u8AD6\u5916\u89C0\uFF0C\u5473\u9053\u662F\u5F88\u68D2\u7684\u3002\\n\u751C\u5473\u7D2E\u5BE6\u7684\u5496\u54E9\u4E0D\u7BA1\u662F\u914D\\n\u901A\u5FC3\u9EB5\u6216\u7C73\u98EF\u90FD\u975E\u5E38\u9069\u5408\u3002"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u5E36\u8457\u5F37\u70C8\u82E6\u5473\u7684\u6FC3\u539A\u8ABF\u5473\\n\u5728\u52A0\u5165\u4E86\u901A\u5FC3\u9EB5\u4E4B\u5F8C\\n\u986F\u5F97\u6070\u5230\u597D\u8655\u3002"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u63A8\u85A6\u7D66\u8CAA\u5FC3\u5730\u540C\u6642\u60F3\u5403\u5496\u54E9\u98EF\\n\u548C\u901A\u5FC3\u9EB5\u7684\u4F60\u3002\u9178\u5473\u5F37\u70C8\u7684\\n\u5496\u54E9\u91AC\u6703\u8B93\u4F60\u80C3\u53E3\u5927\u958B\u3002"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u591A\u7A2E\u83C7\u985E\u7684\u9BAE\u5473\\n\u878D\u5165\u5230\u5496\u54E9\u91AC\u88E1\uFF0C\\n\u8B8A\u6210\u4E86\u4EBA\u9593\u7F8E\u5473\u3002"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u5F15\u51FA\u83C7\u985E\u9BAE\u5473\u7684\u79D8\u8A23\\n\u5728\u65BC\u76E1\u53EF\u80FD\u5730\u5F37\u8ABF\\n\u5496\u54E9\u91AC\u7684\u8FA3\u5473\u3002"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u5404\u7A2E\u83C7\u985E\u7684\u5473\u9053\u91CD\u758A\\n\u5728\u4E00\u8D77\uFF0C\u8B93\u5496\u54E9\u91AC\u7684\\n\u6F80\u5473\u8B8A\u5F97\u6EAB\u548C\u9806\u53E3\u3002"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u6CBE\u6EFF\u9999\u751C\u5496\u54E9\u91AC\u7684\u83C7\u985E\\n\u4E00\u5165\u53E3\uFF0C\u5C31\u80FD\u8B93\u4EBA\u4EAB\u53D7\u5230\\n\u723D\u8106\u5F48\u7259\u7684\u53E3\u611F\u3002"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u56E0\u70BA\u83C7\u985E\u7279\u6709\u7684\u6210\u5206\uFF0C\\n\u8B93\u4EBA\u66F4\u80FD\u54C1\u5690\u5230\u5496\u54E9\u91AC\\n\u82E6\u5473\u7684\u500B\u6027\u6D3E\u5496\u54E9\u3002"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u83C7\u985E\u7684\u5C64\u6B21\u611F\u548C\u5496\u54E9\u91AC\\n\u7684\u9178\u5473\u7522\u751F\u51FA\u8907\u96DC\u537B\u53C8\\n\u8B93\u4EBA\u56DE\u5473\u7121\u7AAE\u7684\u7F8E\u5473\u3002"
