    "text": "[~ 5]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5C0F\u6642\u5019\u662F\u500B\u611B\u54ED\u9B3C\uFF0C\\n\u4F46\u81EA\u5F9E\u548C\u54E5\u54E5\u9001\u7684\u5BF6\u53EF\u5922\\n\u73A9\u5728\u4E00\u8D77\u5F8C\u8B8A\u5F97\u6BD4\u8F03\u6A02\u89C0\uFF0C\\n\u800C\u5979\u4F5C\u70BA\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\\n\u7684\u624D\u80FD\u4E5F\u958B\u59CB\u7A81\u98DB\u731B\u9032\u3002\\n\u672C\u4F86\u662F\u70BA\u4E86\u9010\u6F38\u856D\u689D\u7684\\n\u57CE\u93AE\u53C3\u52A0\u9053\u9928\u6311\u6230\uFF0C\\n\u537B\u958B\u59CB\u5C0D\u90FD\u5E02\u7684\u6642\u88DD\u5E97\\n\u7522\u751F\u4E86\u8208\u8DA3\u3002\\n\u5728\u8001\u5BB6\u5C16\u91D8\u93AE\u662F\u4EBA\u6C23\u5076\u50CF\uFF0C\\n\u4F46\u672C\u4EBA\u4E26\u4E0D\u60F3\u51FA\u540D\u3002\\n\u4E0D\u904E\u5979\u4F3C\u4E4E\u89BA\u5F97\u6709\u5436\u558A\u968A\\n\u9019\u6A23\u7684\u52A0\u6CB9\u5718\u5B58\u5728\u5F88\u8B93\u5979\u5B89\u5FC3\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5728\u54E5\u54E5\u8076\u6893\u7684\u4EFB\u547D\u4E0B\\n\u7576\u4E0A\u4E86\u5C16\u91D8\u93AE\u7684\u9053\u9928\u9928\u4E3B\u3002\\n\u982D\u865F\u642D\u6A94\u83AB\u9B6F\u8C9D\u53EF\\n\u662F\uFF15\u6B72\u6642\u54E5\u54E5\u5E6B\u5FD9\u6293\u5230\u7684\u3002\\n\u4E0D\u904E\u5230\u73FE\u5728\u9084\u662F\u88AB\u83AB\u9B6F\u8C9D\u53EF\\n\u9670\u6674\u4E0D\u5B9A\u7684\u500B\u6027\u800D\u5F97\u5718\u5718\u8F49\u3002\\n\u56E0\u70BA\u5C16\u91D8\u93AE\u7684\u8AAA\u8A71\u65B9\u5F0F\u5F88\u6709\u885D\u64CA\u6027\uFF0C\\n\u6A21\u4EFF\u746A\u4FD0\u7684\u7C89\u7D72\u8D8A\u4F86\u8D8A\u591A\u4E86\u3002\\n\u96D6\u7136\u751F\u6C23\u6642\u81C9\u4E0A\u770B\u4E0D\u51FA\u4F86\uFF0C\\n\u53EF\u662F\u4E00\u751F\u6C23\u5C31\u5F88\u96E3\u5E73\u975C\u4E0B\u4F86\u3002"
  },
