  },
  {
    "index": 95,
    "flags": 0,
    "text": "\u66FE\u662F\u683C\u9B25\u5C6C\u6027\u7684\u9053\u9928\u9928\u4E3B\uFF0C\\n\u540C\u6642\u4E5F\u662F\u6B77\u5E74\u4F86\u6700\u5F37\u7684\u51A0\u8ECD\u3002\\n\u64C1\u6709\u9577\u9054\uFF11\uFF18\u5E74\u7684\u4E0D\u6557\u7D00\u9304\u3002\\n\u7576\u5E74\u7684\u4ED6\u7531\u65BC\u904E\u5EA6\u8FFD\u6C42\u5BE6\u529B\uFF0C\\n\u4E0D\u8AD6\u662F\u5C0D\u4EBA\u6216\u5C0D\u5DF1\u90FD\u975E\u5E38\u56B4\u53B2\u3002\\n\u4F46\u5728\u9000\u4F11\u4E26\u4E14\u74B0\u904A\u4E86\u4E16\u754C\u4E4B\u5F8C\uFF0C\\n\u500B\u6027\u4E0D\u77E5\u70BA\u4F55\u5C31\u6709\u4E86\u5DE8\u5927\u7684\u8F49\u8B8A\u3002\\n\u6709\u5929\u7A81\u7136\u8CB7\u4E0B\u4E86\u7121\u4EBA\u5CF6\uFF0C\\n\u8B93\u5468\u570D\u7684\u4EBA\u90FD\u975E\u5E38\u9A5A\u8A1D\u3002\\n\u7576\u88AB\u554F\u5230\u7406\u7531\u6642\uFF0C\\n\u4ED6\u7B11\u8457\u56DE\u7B54\u8AAA\uFF1A\\n\u300C\u4E16\u754C\u4E0A\u6709\u5404\u5F0F\u5404\u6A23\u7684\u5F37\u5927\uFF0C\\n\u8001\u982D\u5152\u6211\u53EA\u662F\u60F3\u591A\u898B\u8B58\u4E00\u756A\u5695\uFF01\u300D\\n\u70BA\u93A7\u5CF6\u53D6\u540D\u7684\u4EBA\u4E5F\u662F\u4ED6\u3002"
  },
  {
    "index": 96,
    "flags": 0,
    "text": "\u7167\u7247\u662F\u7D04\uFF15\uFF10\u5E74\u524D\uFF0C\\n\u5728\u4E00\u756A\u7E8F\u9B25\u5F8C\u6253\u6557\u4E86\u7D20\u6709\u6069\u6028\u7684\\n\u5996\u7CBE\u5C6C\u6027\u9053\u9928\u9928\u4E3B\uFF0C\u596A\u5F97\u512A\u52DD\u7684\u77AC\u9593\u3002\\n\u7576\u5E74\u7684\u4ED6\u96D6\u7136\u662F\u500B\u4E0D\u66FE\u88AB\u6253\u6557\u7684\u51A0\u8ECD\uFF0C\\n\u4F46\u81EA\u5F9E\u642D\u6A94\u5BF6\u53EF\u5922\u6B7B\u53BB\u5F8C\\n\u5C31\u9010\u6F38\u5931\u53BB\u5149\u5F69\uFF0C\u4E0D\u6557\u7D00\u9304\u4E5F\u88AB\u6253\u7834\u3002\\n\u96D6\u7136\u5931\u53BB\u4E86\u51A0\u8ECD\u7684\u5BF6\u5EA7\uFF0C\\n\u4F46\u4ED6\u4ECD\u820A\u64C1\u6709\u58D3\u5012\u6027\u7684\u4EBA\u6C23\u3002\\n\u76F4\u5230\u7576\u6642\u7684\u806F\u76DF\u6703\u9577\u5411\u4ED6\u63D0\u51FA\u4E86\\n\u6253\u5047\u8CFD\u4F86\u7372\u5F97\u512A\u52DD\u7684\u9080\u8ACB\uFF0C\\n\u8B93\u4ED6\u6C7A\u5B9A\u5F9E\u6B64\u5F15\u9000\u3002\\n\u9000\u4F11\u5F8C\uFF0C\u4ED6\u5C31\u5C0D\u73A9\u904A\u6232\u4E0A\u766E\u4E86\u3002\\n\u64DA\u8AAA\u5728\u73FE\u5F79\u6642\uFF0C\u4ED6\u662F\u70BA\u4E86\u8981\u7DAD\u6301\u5F62\u8C61\uFF0C\\n\u6240\u4EE5\u4E00\u76F4\u90FD\u5FCD\u8457\u6C92\u53BB\u78B0\u904A\u6232\u3002"
  },
  {
    "index": 97,
    "flags": 0,
    "text": "\u539F\u672C\u662F\u8CBF\u6613\u516C\u53F8\u7684\u793E\u9577\u3002\\n\u70BA\u4E86\u5DE5\u4F5C\u800C\u5728\u5168\u4E16\u754C\u98DB\u4F86\u98DB\u53BB\u6642\\n\u5728\u4F3D\u52D2\u723E\u5730\u5340\u8207\u99AC\u58EB\u5FB7\u4E00\u898B\u937E\u60C5\uFF0C\\n\u65BC\u662F\u5C31\u9583\u96FB\u7D50\u5A5A\u4E86\u3002\\n\u5728\u6B66\u9928\uFF0C\u8EAB\u70BA\u5E2B\u6BCD\u7684\u5979\u4E0D\u50C5\\n\u4E00\u624B\u5305\u8FA6\u6383\u5730\u3001\u6599\u7406\u3001\u7D93\u71DF\u3001\u5BA3\u50B3\uFF0C\\n\u540C\u6642\u4E5F\u975E\u5E38\u7167\u9867\u5F92\u5F1F\u5011\u7684\u5FC3\u7406\u5065\u5EB7\u3002\\n\u6975\u5DE8\u6E6F\u6700\u521D\u4E5F\u662F\u51FA\u81EA\u5979\u7684\u624B\u3002\\n\u7576\u6642\u5979\u662F\u70BA\u4E86\u7BC0\u7701\u958B\u652F\uFF0C\\n\u65BC\u662F\u5C07\u68EE\u6797\u7684\u8611\u83C7\u4E1F\u9032\u4E86\u6E6F\u88E1\u7576\u98DF\u6750\uFF0C\\n\u60F3\u4E0D\u5230\u5BF6\u53EF\u5922\u7ADF\u7136\u5C31\u8D85\u6975\u5DE8\u5316\u4E86\u3002\\n\u76EE\u524D\u7684\u91CE\u5FC3\u662F\u5C07\u6975\u5DE8\u6E6F\\n\u505A\u6210\u5373\u98DF\u98DF\u54C1\uFF0C\u92B7\u552E\u5230\u5168\u4E16\u754C\u3002\\n\u5EA7\u53F3\u9298\u662F\u300C\u5169\u4EBA\u4E09\u8173\u300D\u3002"
  },
  {
    "index": 98,
    "flags": 0,
    "text": "\u539F\u672C\u4E26\u4E0D\u662F\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\uFF0C\\n\u4F46\u96A8\u8457\u5979\u5728\u4E08\u592B\u7684\u9080\u8ACB\u4E0B\\n\u958B\u59CB\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\n\u5979\u7684\u624D\u80FD\u5C31\u8FC5\u901F\u5730\u767C\u82BD\u958B\u82B1\u4E86\u3002\\n\u5F92\u5F1F\u5011\u90FD\u6084\u6084\u8A8D\u70BA\\n\u5979\u7684\u5BE6\u529B\u8AAA\u4E0D\u5B9A\u5DF2\u7D93\u80FD\\n\u8207\u73FE\u5728\u7684\u99AC\u58EB\u5FB7\u4E26\u99D5\u9F4A\u9A45\u3002\\n\u7531\u65BC\u7D93\u5E38\u5728\u7167\u9867\u529B\u6C23\u5F88\u5927\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u871C\u8449\u672C\u4EBA\u4E5F\u7DF4\u5C31\u4E86\u4E00\u8EAB\u602A\u529B\u3002\\n\u8D77\u521D\u5979\u5F88\u6297\u62D2\u8EAB\u4E0A\\n\u9577\u4E86\u8D8A\u4F86\u8D8A\u591A\u7684\u808C\u8089\uFF0C\\n\u4F46\u56E0\u70BA\u8EAB\u6750\u80FD\u5920\u7DAD\u6301\u4E0D\u8B8A\uFF0C\\n\u73FE\u5728\u5979\u4F3C\u4E4E\u89BA\u5F97\u9019\u6A23\u4E5F\u633A\u4E0D\u932F\u7684\u3002"
  },
  {
    "index": 99,
    "flags": 0,
    "text": "\u51FA\u8EAB\u65BC\u6B77\u53F2\u60A0\u4E45\u7684\u8D85\u80FD\u529B\u4E16\u5BB6\u3002\\n\u6B77\u5C46\u7684\u8D85\u80FD\u529B\u5C6C\u6027\u9053\u9928\u9928\u4E3B\\n\u90FD\u8207\u8CFD\u5BF6\u5229\u6709\u8840\u7DE3\u95DC\u4FC2\u3002\\n\u8EAB\u70BA\u9019\u4E9B\u4EBA\u7684\u5F8C\u88D4\uFF0C\\n\u4ED6\u5F9E\u51FA\u751F\u524D\u4E5F\u5C31\u6CE8\u5B9A\u5FC5\u9808\\n\u4E00\u80A9\u6311\u8D77\u8D85\u80FD\u529B\u5C6C\u6027\u7684\u9053\u9928\u3002\\n\u96D6\u7136\u4ED6\u5F9E\u61C2\u4E8B\u7684\u6642\u5019\u8D77\\n\u5C31\u80FD\u7528\u5FF5\u529B\u81EA\u5728\u5730\u79FB\u52D5\u7269\u9AD4\uFF0C\\n\u4F46\u4E26\u6C92\u6709\u77AC\u9593\u79FB\u52D5\u6216\\n\u8B80\u5FC3\u8853\u7B49\u5176\u4ED6\u7684\u8D85\u80FD\u529B\uFF0C\\n\u56E0\u6B64\u88AB\u89AA\u621A\u5011\u8CBC\u4E0A\u4E86\u4E0D\u6210\u6750\u7684\u6A19\u7C64\u3002\\n\u4ED6\u6253\u5F9E\u5FC3\u88E1\u5C0A\u656C\u8457\\n\u4E0D\u8AD6\u88AB\u5225\u4EBA\u600E\u9EBC\u8AAA\\n\u90FD\u6C38\u9060\u6211\u884C\u6211\u7D20\u7684\u5446\u5446\u7378\u3002"
  },
  {
    "index": 100,
    "flags": 0,
    "text": "\u81EA\u5C0A\u5FC3\u5F88\u5F37\uFF0C\u6BCF\u6B21\u6253\u8F38\u90FD\u6703\\n\u7528\u8D85\u80FD\u529B\u628A\u5C0D\u624B\u6D6E\u5728\u7A7A\u4E2D\uFF0C\\n\u56E0\u6B64\u88AB\u514D\u53BB\u4E86\u9053\u9928\u8A13\u7DF4\u5BB6\u7684\u8077\u52D9\u3002\\n\u6B63\u7576\u4ED6\u81EA\u66B4\u81EA\u68C4\u6642\uFF0C\\n\u5446\u5446\u7378\u6E4A\u5DE7\u64BF\u4F86\u4E86\u99AC\u5E2B\u5085\u6B66\u9928\u7684\u50B3\u55AE\uFF0C\\n\u65BC\u662F\u5C31\u6709\u4E86\u4ECA\u5929\u3002\\n\u525B\u5230\u6B66\u9928\u6642\u5E38\u548C\u5176\u4ED6\u7684\u5F92\u5F1F\u8D77\u885D\u7A81\uFF0C\\n\u4F46\u5728\u5E2B\u5085\u3001\u5E2B\u6BCD\u7684\u9AD4\u8CBC\u76F8\u5F85\u4E0B\uFF0C\\n\u4ED6\u6F38\u6F38\u655E\u958B\u4E86\u5FC3\uFF0C\\n\u500B\u6027\u4E5F\u8B8A\u5F97\u7A0D\u5FAE\u67D4\u548C\u4E00\u9EDE\u3002\\n\u6700\u8FD1\u70BA\u4E86\u8981\u8B93\u67D0\u500B\u5F8C\u8F29\u5C0D\u4ED6\u53E6\u773C\u76F8\u770B\uFF0C\\n\u6703\u5077\u5077\u5730\u5E36\u8457\u5446\u6BBC\u7378\\n\u5728\u4E0D\u70BA\u4EBA\u77E5\u7684\u5730\u65B9\u52E4\u596E\u8A13\u7DF4\u3002"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "\u539F\u672C\u662F\u500B\u5730\u4E0B\u5076\u50CF\uFF0C\\n\u4EE5\u300C\u5B0C\u6EF4\u6EF4\u3001\u6BD2\u8FA3\u8FA3\u300D\u7684\u5F62\u8C61\u4E3B\u984C\\n\u52AA\u529B\u5730\u81EA\u6211\u884C\u92B7\u3002\\n\u5979\u8FA6\u4E86\u6F14\u5531\u6703\u3001\u6B4C\u8FF7\u6D3B\u52D5\uFF0C\\n\u4E26\u4E14\u92B7\u552E\u81EA\u88FD\u7684\u5468\u908A\u5546\u54C1\uFF0C\\n\u4F46\u662F\u51FA\u9053\u66F2\u3008\u88AB\u514B\u62C9\u62C9\u6BD2\u5F97\u50CF\u500B\u50BB\u74DC\u3009\\n\u53EA\u8CE3\u51FA\u4E86\uFF18\u5F35\uFF23\uFF24\u3002\\n\u8A8D\u70BA\u53EA\u8981\u7576\u4E0A\u9053\u9928\u9928\u4E3B\\n\u5C31\u80FD\u5927\u7D05\u5927\u7D2B\uFF0C\\n\u56E0\u6B64\u6C7A\u5B9A\u6210\u70BA\u9053\u9928\u8A13\u7DF4\u5BB6\u3002\\n\u9078\u64C7\u6BD2\u5C6C\u6027\u662F\u56E0\u70BA\\n\u5979\u89BA\u5F97\u6BD2\u5C6C\u6027\u7B26\u5408\u81EA\u5DF1\u7684\u5F62\u8C61\uFF0C\\n\u800C\u4E14\u4F3C\u4E4E\u52C1\u6575\u5F88\u5C11\uFF0C\\n\u53EF\u4EE5\u8B93\u5979\u8F15\u8F15\u9B06\u9B06\u62FF\u5230\u7B2C\u4E00\u540D\u3002"
  },
  {
    "index": 102,
    "flags": 0,
    "text": "\u6BD2\u5C6C\u6027\u9053\u9928\u7684\u8A13\u7DF4\\n\u6BD4\u5979\u60F3\u50CF\u4E2D\u9084\u8981\u56B4\u82DB\uFF0C\\n\u8B93\u5979\u5169\u5929\u5C31\u9003\u4E4B\u592D\u592D\u4E86\u3002\\n\u5C31\u5728\u9019\u6642\u5019\uFF0C\u5979\u900F\u904E\u6DF1\u591C\u7BC0\u76EE\u7684\u5EE3\u544A\\n\u5F97\u77E5\u4E86\u99AC\u5E2B\u5085\u6B66\u9928\u7684\u5B58\u5728\u3002\\n\u5FC3\u60F3\u90A3\u88E1\u7684\u5E2B\u5085\u770B\u8D77\u4F86\u5F88\u6EAB\u548C\uFF0C\\n\u61C9\u8A72\u662F\u53EF\u4EE5\u8212\uFF5E\u8212\u670D\u670D\u5730\u8B8A\u5F37\uFF0C\\n\u65BC\u662F\u7ACB\u523B\u5C31\u6253\u4E86\u96FB\u8A71\u53BB\u62DC\u5E2B\u3002\\n\u5E73\u6642\u9664\u4E86\u536F\u8DB3\u5168\u529B\u53BB\u5F97\u4EBA\u75BC\u611B\u4E4B\u5916\uFF0C\\n\u4E00\u9EDE\u90FD\u4E0D\u60F3\u8981\u8A8D\u771F\u8655\u4E8B\uFF0C\\n\u56E0\u6B64\u5C0D\u4FEE\u884C\u4E5F\u7E3D\u662F\u6577\u884D\u4E86\u4E8B\u3002\\n\u4F46\u6700\u8FD1\u70BA\u4E86\u8981\u8B93\u67D0\u500B\u5F8C\u8F29\u5C0D\u5979\u53E6\u773C\u76F8\u770B\uFF0C\\n\u6703\u5077\u5077\u5730\u5E36\u8457\u5446\u6BBC\u7378\\n\u5728\u4E0D\u70BA\u4EBA\u77E5\u7684\u5730\u65B9\u78E8\u7DF4\u81EA\u5DF1\u3002"
  },
  {
    "index": 103,
    "flags": 0,
    "text": "\u66FE\u662F\u92FC\u5C6C\u6027\u9053\u9928\u7684\u9053\u9928\u9928\u4E3B\u3002\\n\u5C0D\u6230\u98A8\u683C\u8C6A\u723D\u4E14\u5F37\u52C1\uFF0C\\n\u5728\u4ED6\u5C0D\u6230\u4E4B\u5F8C\u7684\u5C0D\u6230\u5834\\n\u7E3D\u662F\u9700\u8981\u8CBB\u4E00\u756A\u529F\u592B\u53BB\u6574\u7406\u3002\\n\u4ED6\u4EE5\u300C\u92FC\u8001\u5927\u300D\u7684\u66B1\u7A31\u5EE3\u53D7\u6B61\u8FCE\uFF0C\\n\u81F3\u4ECA\u9084\u662F\u6709\u8A31\u591A\u71B1\u70C8\u7684\u7537\u6027\u7C89\u7D72\u3002\\n\u9019\u5F35\u7167\u7247\u662F\u4ED6\u524D\u5F80\\n\u738B\u51A0\u96EA\u539F\u4E4B\u524D\u5408\u6210\u7684\u3002\\n\u4ED6\u5C07\u9019\u5F35\u8096\u50CF\u7167\u593E\u9032\u4E86\\n\u89AA\u624B\u88FD\u4F5C\u7684\u65C5\u884C\u624B\u518A\u88E1\uFF0C\\n\u53EF\u662F\u7ACB\u523B\u5C31\u88AB\u5973\u5152\u4E1F\u6389\u4E86\u3002\\n\u4ED6\u5C0D\u9019\u5F35\u7167\u7247\u9817\u6EFF\u610F\uFF0C\\n\u56E0\u6B64\u4E5F\u628A\u5B83\u7528\u5728\u806F\u76DF\u5361\u4E0A\u3002"
  },
  {
    "index": 104,
    "flags": 0,
    "text": "\u96D6\u7136\u5F88\u5C11\u5728\u6B63\u5F0F\u5834\u5408\u88AB\u63D0\u8D77\uFF0C\\n\u4F46\u4ED6\u662F\u6D1B\u8332\u7684\u89AA\u5F1F\u5F1F\u3002\\n\u81EA\u51FA\u751F\u4EE5\u4F86\uFF0C\u4ED6\u5728\u6210\u9577\u7684\u8DEF\u4E0A\\n\u4E00\u518D\u5730\u88AB\u62FF\u4F86\u8207\u512A\u79C0\u7684\u54E5\u54E5\u505A\u6BD4\u8F03\uFF0C\\n\u56E0\u6B64\u8B8A\u5F97\u53DB\u9006\u4E14\u8207\u793E\u6703\u683C\u683C\u4E0D\u5165\u3002\\n\u96E2\u5BB6\u51FA\u8D70\u5F8C\uFF0C\u4ED6\u7684\u5BE6\u529B\u7372\u5F97\u8CDE\u8B58\uFF0C\\n\u53D7\u9080\u7576\u4E86\u9053\u9928\u9928\u4E3B\u3002\\n\u4ED6\u751A\u81F3\u4E00\u5EA6\u767B\u4E0A\u904E\u51A0\u8ECD\u5BF6\u5EA7\uFF0C\\n\u4F46\u6D1B\u8332\u4E5F\u96A8\u5F8C\u63A5\u4E0B\u4E86\u6703\u9577\u7684\u8077\u4F4D\u3002\\n\u6D1B\u8332\u7684\u5B58\u5728\u8B93\u4ED6\u5F9E\u6B64\\n\u81EA\u806F\u76DF\u7684\u821E\u53F0\u4E0A\u92B7\u8072\u533F\u8DE1\u3002\\n\u540C\u884C\u968A\u4F0D\u4E2D\u7684\u5927\u738B\u9285\u8C61\u662F\u7531\\n\u4ED6\u5C0F\u6642\u5019\u548C\u54E5\u54E5\u4E00\u8D77\u6349\u5230\u7684\\n\u7B2C\u4E00\u96BB\u9285\u8C61\u9032\u5316\u800C\u4F86\u7684\u3002"
  }
]
