    "text": "\u8DE9\u4EC0\u9EBC\u561B\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8D70\uFF0C\u6211\u5011\u53BB\u5831\u5230\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u5011\u662F\u4F86\u53C3\u52A0\u9053\u9928\u6311\u6230\u55CE\uFF1F\\n\u8ACB\u51FA\u793A\u63A8\u85A6\u51FD\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54CE\u5440\u2026\u2026\u6211\u7B2C\u4E00\u6B21\u898B\u5230\\n\u51A0\u8ECD\u7684\u63A8\u85A6\u51FD\u5462\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u7684\u4E5F\u662F\u5594\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4EC0\u9EBC\uFF01\u51A0\u8ECD\u4E39\u5E1D\\n\u7ADF\u7136\u4E00\u6B21\u63A8\u85A6\u4E86\u5169\u500B\u4EBA\uFF01\uFF1F\\r\\n\u4F60\u5011\u7A76\u7ADF\u662F\u4F55\u65B9\u795E\u8056\u2026\u2026"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u53EB\u8D6B\u666E\uFF01\\c\\n\u6211\u662F\u4E39\u5E1D\u7684\u5F1F\u5F1F\uFF01\u800C\u4E14\uFF0C\\n\u6211\u6703\u662F\u672A\u4F86\u7684\u51A0\u8ECD\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5565\uFF1F\u554A\uFF0C\u597D\u7684\u2026\u2026\\n\u8ACB\u7A0D\u5019\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5169\u4F4D\u7684\u5831\u5230\u624B\u7E8C\u90FD\u8FA6\u597D\u4E86\u3002\\c\\n\u63A5\u4E0B\u4F86\uFF0C\u8ACB\u6311\u9078\u559C\u611B\u7684\u865F\u78BC\u3002\\c\\n\u6240\u9078\u7684\u865F\u78BC\u6703\u5370\u5728\u7AF6\u6280\u670D\u4E0A\uFF0C\\n\u4F5C\u70BA\u9053\u9928\u6311\u6230\u6642\u7684\u80CC\u865F\u5594\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 01C4(0001)]\u865F\uFF0C\u662F\u5427\uFF01\\n\u90A3\u6211\u5C31\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u767B\u8A18\u4E86\u3002\\c\\n\u9084\u6709\uFF0C\u8ACB\u6234\u4E0A\u6311\u6230\u8005\u8155\u5E36\uFF0C\\n\u4EE5\u8868\u793A[VAR 1100(00FF,0101)]\u4F60\u59B3\u53C3\u52A0\u4E86\u9053\u9928\u6311\u6230\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u660E\u5929\u6703\u5728\u9019\u88E1\u8209\u884C\\n\u9053\u9928\u6311\u6230\u7684\u958B\u5E55\u5178\u79AE\u3002\\c\\n\u53EA\u8981\u662F\u53C3\u52A0\u9053\u9928\u6311\u6230\u7684\u9078\u624B\uFF0C\\n\u90FD\u53EF\u4EE5\u4F4F\u5728\u542B\u7F9E\u82DE\u65C5\u5E97\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6703\u9577\u771F\u662F\u5927\u624B\u7B46\u554A\uFF01\\c\\n\u597D\uFF0C\u6211\u5011\u54BB\uFF5E\u5730\\n\u885D\u53BB\u542B\u7F9E\u82DE\u65C5\u5E97\u8FA6\u5165\u4F4F\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u77A7[VAR 1100(00FF,0101)]\u4F60\u59B3\u6771\u5F35\u897F\u671B\u7684\u6A23\u5B50\u2026\u2026\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u7B2C\u4E00\u6B21\u5230\u9019\u9EBC\u5927\u7684\u57CE\u5E02\u5427\uFF1F\\n\u4E0D\u779E[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\uFF0C\u5176\u5BE6\u6211\u4E5F\u662F\u3002[VAR 0114(0042)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u62FF\u7684\u662F\u806F\u76DF\u6703\u9577\u7684\u63A8\u85A6\u51FD\u2026\u2026\\n\u53EF\u8AAA\u6211\u662F\u7CBE\u82F1\u4E2D\u7684\u7CBE\u82F1\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u6A23\u6D6A\u8CBB\u6211\u7684\u6642\u9593\uFF0C\\n\u5BE6\u5728\u662F\u592A\u7F6A\u904E\u4E86\u3002[VAR 0114(0042)]"
  },
  {
