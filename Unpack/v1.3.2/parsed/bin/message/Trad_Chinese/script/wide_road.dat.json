  {
    "index": 143,
    "flags": 0,
    "text": "\u628A\u5012\u4E0B\u7684\u5BF6\u53EF\u5922\u5E36\u56DE\u57FA\u5730\u4F11\u606F\u5427\uFF01"
  },
  {
    "index": 144,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u90FD\u6062\u5FA9\u6D3B\u529B\u4E86\uFF01"
  },
  {
    "index": 145,
    "flags": 0,
    "text": "\u807D\u6211\u8AAA\uFF0C\u807D\u6211\u8AAA\uFF01\u525B\u624D\u5440\uFF01\\n\u6211\u64BF\u5230\u4E86\u597D\uFF5E\u591A\u7684\u7403\u679C\u5594\uFF01\\c\\n\u53EA\u8981\u7D66\u6211[VAR 0203(0000,0000)]\uFF37\uFF0C\\n\u6211\u5C31\u7279\u5225\u628A\u7403\u679C\u8B93\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\uFF01"
  },
  {
    "index": 146,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u7684\u4E0D\u8981\u55CE\uFF1F\\n\u7403\u679C\u662F\u5F88\u96E3\u6536\u96C6\u7684\u8036\uFF5E"
  },
  {
    "index": 147,
    "flags": 0,
    "text": "\u6211\u64BF\u5230\u7684\u7403\u679C\uFF01\\n\u4F86\uFF0C\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01"
  },
  {
    "index": 148,
    "flags": 0,
    "text": "\u6B66\u9928\u88E1\u6709\u500B\u53EB\u505A\u6A5F\u5668\u9D98\u7684\u6771\u897F\u3002\\n\u807D\u8AAA\u5982\u679C\u653E\uFF14\u500B\u7403\u679C\u9032\u53BB\u2026\u2026\\c\\n\u6709\uFF5E\u6642\u6703\u8B8A\u51FA\u7A00\u5947\u7684\u7403\u4F86\u5594\u3002"
  },
  {
    "index": 149,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\uFF37\u4E0D\u5920\u5594\uFF01\\n\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6536\u96C6\u5920\uFF37\uFF0C\u6211\u518D\u628A\u7403\u679C\u8B93\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01"
  },
  {
    "index": 150,
    "flags": 0,
    "text": "\u5E74\u8F15\u4EBA\u90FD\u8DD1\u53BB\u90FD\u5E02\u751F\u6D3B\u5566\u3002\\c\\n\u9019\u5152\u53EA\u6709\u8001\u4EBA\u5BB6\u548C\u5BF6\u53EF\u5922\\n\u76F8\u4F9D\u70BA\u547D\u5730\u52C9\u5F37\u904E\u65E5\u5B50\u3002"
  },
  {
    "index": 151,
    "flags": 0,
    "text": "\u6751\u5B50\u88E1\u7684\u4EBA\u9700\u8981\u5403\u591A\u5C11\uFF0C\\n\u8FB2\u4F5C\u7269\u5C31\u7A2E\u591A\u5C11\u3002\\c\\n\u4E0D\u6D6A\u8CBB\u6771\u897F\u7684\u751F\u6D3B\u2026\u2026\\n\u9019\u5C31\u662F\u6240\u8B02\u7684\u300C\u81EA\u7D66\u81EA\u8DB3\u300D\u554A\u3002"
  },
  {
    "index": 152,
    "flags": 0,
