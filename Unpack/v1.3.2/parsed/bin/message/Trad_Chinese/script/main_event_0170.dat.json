[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF01\\n[VAR 0100(0000)]\uFF01\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54A6\uFF1F\u2026\u2026\u5927\u54E5\uFF1F\\n\u4F60\u4E0D\u662F\u8DEF\u75F4\u55CE\uFF1F\u7ADF\u7136\u80FD\u627E\u5230\u9019\u88E1\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u9019\u5C0F\u5B50\uFF0C\u8B93\u6211\u9019\u9EBC\u64D4\u5FC3\uFF0C\\n\u9084\u800D\u5634\u76AE\u5B50\uFF01\\c\\n\u6211\u7B49\u4E86\u534A\u5929\u90FD\u7B49\u4E0D\u5230\u4F60\u5011\uFF0C\\n\u6240\u4EE5\u624D\u4F86\u627E\u4EBA\u7684\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF0C\u6BDB\u8FAE\u7F8A\u5462\u2026\u2026\uFF01\uFF1F\\n\u6211\u5011\u662F\u4F86\u6551\u7260\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6BDB\u54A9\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7260\u6C92\u4E8B\u3002\\c\\n\u4E0D\u904E\uFF0C\u525B\u624D\u6211\u5230\u9019\u88E1\u6642\uFF0C\\n\u4F60\u5011\u5168\u90FD\u660F\u5012\u5728\u5730\u4E0A\u3002\\c\\n\u4E8B\u60C5\u7684\u4F86\u9F8D\u53BB\u8108\u6211\u61C2\u4E86\u3002\\n\u64C5\u95D6\u68EE\u6797\u662F\u8A72\u597D\u597D\u7F75\u4E00\u9813\u2026\u2026\\c\\n\u4F46\u6211\u627F\u8A8D\uFF0C\u4F60\u5011\u52C7\u6C23\u53EF\u5609\uFF01\\n\u5E79\u5F97\u597D\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u771F\u662F\u5E78\u597D\u8036\uFF0C[VAR 0100(0000)]\u3002\\c\\n\u6211\u5011\u88AB\u6FC3\u9727\u5305\u570D\uFF0C\\n\u9084\u548C\u795E\u79D8\u7684\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\r\\n\u9019\u4E9B\u90FD\u6C92\u6709\u767D\u8CBB\u5462\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u795E\u79D8\u7684\u2026\u2026\uFF1F\\n\u4F60\u5011\u7A76\u7ADF\u662F\u898B\u5230\u4E86\u4EC0\u9EBC\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5C31\u662F\u611F\u89BA\u5F88\u5F37\uFF0C\\n\u5B58\u5728\u611F\u7206\u8868\u7684\u5BF6\u53EF\u5922\u3002\\r\\n\u800C\u4E14\uFF0C\u4F7F\u51FA\u7684\u62DB\u5F0F\u5C0D\u7260\u90FD\u6C92\u6548\u2026\u2026\\r\\n\u597D\u50CF\u62DB\u5F0F\u6703\u7A7F\u900F\u904E\u53BB\u4E00\u6A23\u3002[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u62DB\u5F0F\u6703\u7A7F\u900F\u904E\u53BB\u2026\u2026\uFF1F\\c\\n\u50B3\u805E\u4E2D\u4F4F\u5728\u5FAE\u5BD0\u68EE\u6797\u4E2D\u7684\u5BF6\u53EF\u5922\\n\u96E3\u9053\u53EA\u662F\u5E7B\u5F71\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u5011\u597D\u597D\u935B\u934A\u81EA\u5DF1\uFF0C\u589E\u5F37\u5BE6\u529B\uFF0C\\n\u8AAA\u4E0D\u5B9A\u54EA\u5929\u5C31\u80FD\u89E3\u958B\u9019\u500B\u8B0E\u4E86\u3002[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u73FE\u5728\u9084\u662F\u5148\u96E2\u958B\u5FAE\u5BD0\u68EE\u6797\u5427\u3002\\n\u653E\u5FC3\uFF01\u6211\u6703\u966A\u8457\u4F60\u5011\u7684\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u96D6\u7136\u88AB\u5927\u54E5\u7F75\u4E86\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u525B\u624D\u90A3\u771F\u662F\u500B\u8D85\u8B9A\u7684\u7D93\u9A57\u8036\uFF01\\n\u9019\u4E00\u5B9A\u6703\u662F\u6211\u8D6B\u666E\u50B3\u8AAA\u88E1\u7684\u4E00\u9801\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  }
]
