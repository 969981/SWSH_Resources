    "text": "\u597D\uFF5E\\n\u7562\u7ADF\uFF0C\u6709\u5099\u7121\u60A3\u561B\u3002[VAR 0114(000E)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u63A5\u4E0B\u4F86\u8981\u9762\u5C0D\u7684\u662F\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6E96\u5099\u597D\u4E86\u55CE\uFF1F[VAR 0114(000E)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u8981\u662F\u88AB\u6211\u6349\u5230\u7528\u5BF6\u53EF\u5922\\n\u7838\u4E86\u6211\u821E\u53F0\u7684\u8A13\u7DF4\u5BB6\uFF0C\\r\\n\u6211\u4E00\u5B9A\u6703\u7D66\u4ED6\u984F\u8272\u77A7\u77A7\u7684\u3002[VAR 0114(0016)]"
