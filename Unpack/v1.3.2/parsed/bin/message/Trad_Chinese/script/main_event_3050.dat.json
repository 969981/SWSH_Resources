    "text": "\u55EF\uFF1F[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u2026\u2026[VAR 0114(0016)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5662\uFF5E\uFF01\u51A0\u8ECD\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u4F86\u5566\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u5011\u5728\u804A\u5929\u55CE\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u597D\u4E45\u4E0D\u898B"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9084\u9019\u9EBC\u60A0\u54C9\u5730\u6253\u62DB\u547C\u3002\\c\\n\u770B\u4F86\u9019\u4F4D\u65B0\u51A0\u8ECD\u7684\u5FC3\u81DF\u4E4B\u5927\uFF0C\\n\u548C\u6975\u5DE8\u5316\u7684\u5BF6\u53EF\u5922\u6709\u5F97\u62FC\u5594\u3002[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u662F\u9019\u6A23\u7684\u2026\u2026\\n\u525B\u624D\u6211\u548C\u8076\u6893\u6B63\u5728\u6253\u8868\u6F14\u8CFD\uFF0C\\c\\n\u7D50\u679C\u6709\u96BB\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\\n\u534A\u9014\u95D6\u4E86\u9032\u4F86\uFF5E\\r\\n\u800C\u4E14\u9084\u4E0D\u77E5\u9053\u662F\u54EA\u500B\u8A13\u7DF4\u5BB6\u7684\u5462\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u5011\u6B63\u5728\u758F\u6563\u89C0\u773E\u548C\u8077\u54E1\u3002[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u540E\u540E\uFF5E\uFF01\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5317\u5074\u7684\u89C0\u773E\u5168\u90FD\u758F\u6563\u56C9\uFF01\\c\\n\u2026\u2026\u6211\u731C\u4F60\u5011\u90FD\u5DF2\u7D93\u807D\u5230\u4E86\uFF0C\\n\u90A3\u96BB\u6975\u5DE8\u5316\u7684\u5BF6\u53EF\u5922\u9084\u5728\u5927\u9B27\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF0C\u611F\u8B1D\u4F60\u56C9\u3002\\n\u4E0D\u6127\u662F\u9053\u9928\u6311\u6230\u8005\uFF0C\\r\\n\u771F\u662F\u53EF\u9760\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F46\u662F\u6211\u5728\u6E96\u6C7A\u8CFD\\n\u5C31\u6C92\u6232\u5531\u4E86\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u554A\uFF0C[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u4E00\u8DEF\u8FFD\u8457\u7D05\u8863\u4EBA\u548C\u85CD\u8863\u4EBA\uFF0C\\n\u7136\u5F8C\u770B\u5230\u4ED6\u5011\u9032\u4E86\u8349\u8DEF\u7AF6\u6280\u5834\u3002[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8DDF\u9032\u4F86\u5F8C\uFF0C\\n\u5C31\u7A81\u7136\u767C\u751F\u4E86\u9019\u7A2E\u4E8B\u3002\\c\\n\u7E3D\u4E0D\u80FD\u653E\u8457\u4E0D\u7BA1\u5427\uFF1F\\n\u6240\u4EE5\u6211\u5C31\u7559\u4E0B\u4F86\u5E6B\u5FD9\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6240\u4EE5\u2026\u2026\u5C0D\u4E0D\u8D77\uFF01\\n\u6211\u8DDF\u4E1F\u90A3\u5169\u500B\u50A2\u4F19\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u9019\u6A23\u554A\uFF5E\\c\\n\u96D6\u7136\u6211\u4E5F\u5F88\u597D\u5947\\n\u8D6B\u666E\u6B63\u5728\u8DDF\u8E64\u7684\u53EF\u7591\u4EBA\u7269\u2026\u2026[VAR 0114(000E)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F46\u6211\u5011\u9084\u662F\u5148\u53BB\u5B89\u64AB\u90A3\u96BB\\n\u6B63\u5728\u5927\u9B27\u7684\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u5427\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u7260\u662F\u500B\u975E\u5E38\u68D8\u624B\u7684\u5C0D\u624B\u5462\uFF5E\\c\\n\u5982\u679C\u51A0\u8ECD[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u4E5F\u80FD\u5E6B\u5FD9\u51FA\u4EFD\u529B\uFF0C\u90A3\u5C31\u592A\u597D\u4E86\u3002[VAR 0114(000E)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6C92\u554F\u984C\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u7B49\u6211\u4E00\u4E0B"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u6211\u5011\u5F80\u5C0D\u6230\u5834\u53BB\u5427\u3002[VAR 0114(000E)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u4E5F\u4F86\u5E6B\u500B\u5FD9\u3002[VAR 0114(0016)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u96D6\u7136\u9019\u4E0D\u662F\u5BF6\u53EF\u5922\u7684\u932F\uFF0C\\n\u4F46\u662F\u6211\u7684\u821E\u53F0\u5C31\u9019\u6A23\u88AB\u7838\u4E86\uFF0C\\r\\n\u9084\u771F\u662F\u6709\u9EDE\u56A5\u4E0D\u4E0B\u9019\u53E3\u6C23\u5462\u3002[VAR 0114(0016)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u558F\uFF0C\u524D\u51A0\u8ECD\u7684\u5F1F\u5F1F\uFF0C\\n\u4F60\u4E5F\u4E00\u8D77\u4F86\u3002[VAR 0114(0016)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6211\u5373\u4F7F\u53BB\u4E86\\n\u5927\u6982\u4E5F\u7121\u80FD\u70BA\u529B\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u8AAA\u4E0D\u5B9A\u9084\u6703\u62D6\u7D2F\u5927\u5BB6\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6211\u731C\uFF0C\u5982\u679C\u662F\u4E39\u5E1D\u7684\u8A71\uFF0C\\n\u4ED6\u61C9\u8A72\u4E0D\u6703\u8FF7\u60D8\u5427\u3002\\c\\n\u2026\u2026\u96D6\u7136\u4ED6\u6703\u8FF7\u8DEF\u5C31\u662F\u4E86\u3002[VAR 0114(0016)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u8D70\u56C9\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6211\u3001\u6211\u77E5\u9053\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u9019\u8A72\u8AAA\u8076\u6893\u4E0D\u6127\u662F\u500B\u5927\u54E5\u55CE\uFF1F\\n\u4ED6\u771F\u662F\u6703\u5E36\u52D5\u4EBA\u5462\uFF5E[VAR 0114(000E)]"
  },
  {
