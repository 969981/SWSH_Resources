    "flags": 0,
    "text": "\u6709\u6A5F\u6703\u518D\u9EBB\u7169[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u554A\uFF0C\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u554A\uFF01\\c\\n\u6211\u53C8\u60F3\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E6B\u5FD9\u5916\u9001\u6599\u7406\u4E86\uFF0C\\n\u4E0D\u77E5\u9053\u884C\u4E0D\u884C\u5462\uFF1F"
