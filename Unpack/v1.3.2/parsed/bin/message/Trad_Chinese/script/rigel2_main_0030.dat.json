  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u597D\u5F97\u4E00\u500B\u982D\u5169\u500B\u5927\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9019\u500B\u7206\u56C9\u5506\u7684\u7814\u7A76\u54E1\\n\u975E\u5F97\u8981\u64CB\u6211\u7684\u8DEF\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u60A8\u7ADF\u7136\u8AAA\u6211\u662F\u56C9\u5506\u7684\u7814\u7A76\u54E1\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u90A3\u662F\u56E0\u70BA\u60A8\u4E0D\u9858\u610F\u807D\u6211\u7684\u8AAA\u660E\u554A\uFF01"
  },
  {
