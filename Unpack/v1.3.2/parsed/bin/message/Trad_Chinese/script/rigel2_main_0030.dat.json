  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u70BA\u4EC0\u9EBC\u554A\uFF01\u6211\u5BB6\u53EF\u611B\u7684\u5C0F\u590F\u590F\\n\u5C31\u5728\u9019\u88E1\u9762\uFF0C\u4E0D\u662F\u55CE\uFF01\uFF1F[VAR 0114(0076)]"
