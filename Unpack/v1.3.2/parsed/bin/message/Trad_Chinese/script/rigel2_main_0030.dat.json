  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6240\u4EE5\u554A\uFF0C\\n\u6211\u4E5F\u8981\u53BB\u5927\u5192\u96AA\uFF01\\r\\n\u6211\u73FE\u5728\u5C31\u8981\u53BB\uFF01\u7ACB\u523B\u5C31\u8981\u53BB\uFF01\uFF01[VAR 0114(0076)]"
