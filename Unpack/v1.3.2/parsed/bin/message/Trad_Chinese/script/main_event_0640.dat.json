    "text": "\u6C34\u821F\u93AE"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5F88\u62B1\u6B49\uFF01\\n\u6703\u9577\u7684\u884C\u7A0B\u975E\u5E38\u7DCA\u8FEB\u2026\u2026\\c\\n\u8ACB\u5927\u5BB6\u591A\u591A\u5305\u6DB5\uFF01\\n\u4E0D\u597D\u610F\u601D\uFF0C\u8ACB\u56DE\u5427\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u597D\u5427\uFF5E\\n\u6703\u9577\uFF0C\u518D\u898B\u56C9\u266A"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5662\uFF0C\u5404\u4F4D\u2026\u2026\\n\u6211\u9084\u53EF\u4EE5\u518D\u7C3D\u540D\u5537\uFF1F\\c\\n\u9084\u6709\u6211\u7684\u5BF6\u53EF\u5922\u806F\u76DF\u5361\\n\u53EF\u4EE5\u9001\u5927\u5BB6\u7576\u5C0F\u79AE\u7269\u5537\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u82E5\u662F\u6C92\u6709\u7C89\u7D72\u7684\u652F\u6301\uFF0C\\n\u6211\u5011\u5C31\u6C92\u6709\u4ECA\u5929\u7684\u4E00\u5207\u5566\u3002\\c\\n\u9019\u6A23\u7121\u79AE\u5730\u8D95\u4EBA\u8D70\uFF0C\u5BE6\u5728\u662F\u2026\u2026\\n\u5967\u5229\u8587\uFF0C\u59B3\u662F\u4E0D\u662F\u592A\u7121\u60C5\u4E86\u5440\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7576\u7136\uFF0C\u6211\u5011\u8981\u73CD\u60DC\u7C89\u7D72\u3002\\n\u4F46\u662F\u6703\u9577\uFF0C\u70BA\u4E86\u4ED6\u5011\uFF0C\\r\\n\u60A8\u66F4\u662F\u9700\u8981\u597D\u597D\u5DE5\u4F5C\u554A\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6D1B\u8332\u6703\u9577\uFF0C\\n\u6211\u4E5F\u6703\u70BA\u60A8\u76E1\u5168\u529B\u7684\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5443\uFF5E\\n\u6211\u8A18\u5F97\u4F60\u662F\u2026\u2026[VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u662F\u5F7C\u7279\u3002[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF01\u662F\u5F7C\u7279\uFF01\\c\\n\u4EE5\u524D\u6211\u9001\u4F60\u5BF6\u53EF\u5922\u6642\uFF0C\\n\u4F60\u9084\u662F\u500B\u5C0F\u4E0D\u9EDE\u5462\u3002\\r\\n\u770B\u770B\u4F60\u73FE\u5728\uFF0C\u771F\u662F\u98A8\u91C7\u5802\u5802\u554A\u3002[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u80FD\u5728\u9019\u6B21\u7684\u9053\u9928\u6311\u6230\\n\u6230\u52DD\u5230\u5E95\u7684\u4EBA\uFF0C\u82E5\u4E0D\u662F\u4F60\u2026\u2026\\r\\n\u5C31\u662F\u51A0\u8ECD\u63A8\u85A6\u7684\u8A13\u7DF4\u5BB6\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8EAB\u70BA\u6703\u9577\u89AA\u81EA\u9078\u4E2D\u7684\u8A13\u7DF4\u5BB6\uFF0C\\n\u6211\u662F\u4E0D\u6703\u8F38\u7D66\u4EFB\u4F55\u4EBA\u7684\uFF01\\r\\n\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u5148\u5931\u966A\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F[VAR 0100(0000)]\u5427\uFF01\\c\\n\u6211\u4E5F\u5F88\u597D\u5947\\n\u4E39\u5E1D\u70BA\u4EC0\u9EBC\u6703\u63A8\u85A6[VAR 1100(00FF,0101)]\u4F60\u59B3\u5537\u3002[VAR 0114(0006)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF01\u6211\u771F\u662F\u592A\u8070\u660E\u5566\uFF01\\n\u6211\u60F3\u5230\u4E00\u500B\u597D\u4E3B\u610F\u5462\u3002[VAR 0114(0006)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u63A5\u4E0B\u4F86\u5C31\u8981\u53BB\u6311\u6230\\n\u9053\u9928\u9928\u4E3B\u9732\u7483\u5A1C\u4E86\uFF0C\u5C0D\u4E0D\u5C0D\uFF1F\\c\\n\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u5230\u9053\u9928\u5FBD\u7AE0\u5F8C\uFF0C\\n\u8B93\u6211\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u6176\u795D\u4E00\u4E0B\u5427\uFF01\\r\\n\u6211\u5F88\u60F3\u597D\u597D\u8A8D\u8B58[VAR 1100(00FF,0101)]\u4F60\u59B3\u5462\u3002[VAR 0114(0006)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6703\u9577\uFF0C\\n\u60A8\u7684\u6642\u9593\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u70BA\u4E86\u4F3D\u52D2\u723E\u5730\u5340\u7684\u672A\u4F86\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\u597D\u8868\u73FE\u5537\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6703\u9577\u6703\u524D\u5F80\u93AE\u4E0A\u7684\u6D77\u9BAE\u9910\u5EF3\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5225\u8B93\u6703\u9577\u4E7E\u7B49\u4E86\uFF0C\\n\u76E1\u5FEB\u53BB\u8D0F\u5F97\u9053\u9928\u5FBD\u7AE0\u5427\u3002[VAR 0114(0007)]"
