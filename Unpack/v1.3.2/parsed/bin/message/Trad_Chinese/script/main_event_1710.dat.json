[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5927\u5BB6\u4E45\u7B49\u4E86\uFF01\\n\u671F\u5F85\u5DF2\u4E45\u7684\u51A0\u8ECD\u76C3\uFF0C\\r\\n\u6C7A\u8CFD\u7D42\u65BC\u8981\u958B\u59CB\u56C9\uFF01\\c\\n\u7B2C\uFF11\u56DE\u5408\u7684\u9996\u6230\uFF0C\\n\u767B\u5834\u7684\u662F\u2026\u2026[VAR 0114(0018)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u51A0\u8ECD\u63A8\u85A6\u7684\u9053\u9928\u6311\u6230\u8005\uFF0C\\n[VAR 0100(0000)]\u9078\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5C0D\u624B\u662F\u4EE4\u4EBA\u9A5A\u8277\u7684\u6FC0\u72C2\u4E4B\u6D6A\uFF01\\n\u4F7F\u7528\u6C34\u5C6C\u6027\u5BF6\u53EF\u5922\u7684\u4F73\u4EBA\uFF0C\\r\\n\u9732\u7483\u5A1C\u9078\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u548C\u7576\u521D\u5728\u6C34\u821F\u7AF6\u6280\u5834\u5C0D\u6230\u6642\u6BD4\u8D77\u4F86\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BE6\u529B\u7C21\u76F4\u662F\u4E0D\u53EF\u540C\u65E5\u800C\u8A9E\u2026\u2026\\c\\n\u7121\u6575\u7684\u51A0\u8ECD\u4E39\u5E1D\uFF0C\\n\u770B\u4EBA\u7684\u773C\u5149\u679C\u7136\u4E5F\u662F\u51A0\u8ECD\u7D1A\u7684\u3002[VAR 0114(000F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u65E2\u4E0D\u662F\u51A0\u8ECD\uFF0C\\n\u4E5F\u4E0D\u6703\u6210\u70BA\u51A0\u8ECD\u3002\\c\\n\u56E0\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u4E39\u5E1D\uFF0C\\n\u90FD\u6703\u6557\u5728\u6211\u9732\u7483\u5A1C\u7684\u624B\u4E2D\u3002[VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u4E0D\u6703\u4F4E\u4F30[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BE6\u529B\uFF01\\c\\n\u9019\u6B21\uFF0C\u6211\u4E00\u5B9A\u6703\u7528\u6975\u5DE8\u5316\\n\u5C07\u4F60\u5011\u6C96\u5230\u4E16\u754C\u7684\u76E1\u982D\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7372\u52DD\u7684\u662F[VAR 0100(0000)]\uFF01\\c\\n\u7E7C\u9053\u9928\u6311\u6230\u4E4B\u5F8C\uFF0C\\n[VAR 1100(00FF,0101)]\u4ED6\u5979\u518D\u6B21\u64CA\u6557\u4E86\u9732\u7483\u5A1C\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u5011\u7684\u5B58\u5728\u611F\u5BE6\u5728\u662F\u592A\u5F37\u5927\u4E86\u2026\u2026\\c\\n\u5373\u4F7F\u8B93\u6211\u7684\u642D\u6A94\u6975\u5DE8\u5316\uFF0C\\n\u4E5F\u6C92\u8FA6\u6CD5\u628A\u4F60\u5011\u6C96\u57AE\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u5DEE\u9EDE\u5FD8\u4E86\uFF0C\\n\u7D22\u59AE\u4E9E\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8A55\u50F9\u4E5F\u5F88\u9AD8\u5462\u3002\\c\\n\u7576\u521D\u6211\u771F\u662F\u8A72\u597D\u597D\u807D\u4E00\u4E0B\\n\u5979\u662F\u600E\u9EBC\u8A87\u734E[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u3002[VAR 0114(000F)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u73FE\u5728\uFF0C\u4F3D\u52D2\u723E\u7684\u4EBA\\n\u80AF\u5B9A\u90FD\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u760B\u72C2\u4E86\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u4E58\u8457\u9019\u6CE2\u52DD\u5229\u7684\u6D6A\u6F6E\uFF0C\\n\u4E00\u9F13\u4F5C\u6C23\u6649\u7D1A\u5230\u6C7A\u6230\u5427\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5404\u4F4D\u89C0\u773E\uFF0C\u7B2C\uFF11\u56DE\u5408\u7684\u7B2C\uFF12\u5834\u5C0D\u6230\\n\u5F88\u5FEB\u5C31\u8981\u958B\u59CB\u4E86\u3002\\r\\n\u656C\u8ACB\u7A0D\u5019\u3002[VAR 0114(0018)]"
  }
