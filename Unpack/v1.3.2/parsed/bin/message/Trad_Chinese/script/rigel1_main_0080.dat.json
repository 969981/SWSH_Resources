  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u53EA\u8981\u7D66\u90A3\u5B69\u5B50\u93A7\u7532\u7926\u77F3\uFF0C\\n\u4ED6\u5C31\u6703\u6559\u5BF6\u53EF\u5922\u5B78\u6703\u62DB\u5F0F\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u8A66\u8A66\u770B\u5594\u3002[VAR 0114(0074)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u9019\u4E9B\u5B69\u5B50\u5728\u9032\u5316\uFF12\u6B21\u4E4B\u5F8C\\n\u5C31\u80FD\u8D85\u6975\u5DE8\u5316\u4E86\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u8981\u597D\u597D\u57F9\u80B2\u7260\u5594\u3002[VAR 0114(0074)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6975\u5DE8\u5316\u2026\u2026\u90A3\u6B63\u662F\\n\u4F3D\u52D2\u723E\u5BF6\u53EF\u5922\u7684\u795E\u79D8\u4E4B\u8655\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4E0D\u50C5\u5916\u89C0\u6703\u6539\u8B8A\uFF0C\\n\u4F7F\u51FA\u7684\u62DB\u5F0F\u4E5F\u6703\u8B8A\u5316\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5728\u6975\u5DE8\u5316\u4E2D\uFF0C\\n\u66F4\u7279\u5225\u7684\u5C31\u662F\u8D85\u6975\u5DE8\u5316\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u8AAA\u5230\u8D85\u6975\u5DE8\u5316\uFF0C\\n\u7576\u7136\u5C31\u662F\u99AC\u5E2B\u5085\u6B66\u9928\u79D8\u50B3\u7684\u90A3\u6771\u897F\uFF01\\r\\n\u559D\u4E0B\u5C31\u80FD[VAR FF00(0006)]\u8D85\u6975\u5DE8[VAR FF00(0000)]\u7684\uFF01[VAR FF00(0006)]\u6975\u5DE8\u6E6F[VAR FF00(0000)]\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u8001\u982D\u5152\u6211\u597D\u4E45\u6C92\u559D\u5230\\n\u653E\u6EFF\u4E86[VAR FF00(0006)]\u6975\u5DE8\u83C7\u83C7[VAR FF00(0000)]\u7684\u6975\u5DE8\u6E6F\u4E86\u3002\\r\\n\u597D\u60F3\u559D\u554A\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u2026\u2026\u6240\u4EE5\u5462\uFF01\\n\u7B2C\uFF12\u500B\u4FEE\u884C\u662F\u63A1\u8611\u83C7\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u53BB\u63A1\u6536\u8D85\u6975\u5DE8\u5316\u7684\u95DC\u9375\u98DF\u6750\uFF01\\n\u6975\u5DE8\u83C7\u83C7\u5427\uFF01\u63A1\uFF13\u500B\u5C31\u597D\u5695\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6975\u5DE8\u83C7\u83C7\u662F[VAR FF00(0006)]\u7D05\u8272[VAR FF00(0000)]\u7684\uFF01\\n\u800C\u4E14\u6709[VAR FF00(0006)]\u6F29\u6E26\u82B1\u7D0B[VAR FF00(0000)]\uFF01\\c\\n\u8001\u982D\u5152\u6211\u731C\u5B83\u6703\u9577\u5728\\n\u53C8\u6FD5\u53C8\u6697\u7684\u5730\u65B9\u5537\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u5C31\u662F\u9019\u9EBC\u56DE\u4E8B\u5566\uFF01\\n\u958B\u59CB\u4FEE\u884C\uFF01\\r\\n\u62DC\u8A17\u5695\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u54E6\u2026\u2026\u55DA\u5594\u5594\u5594\u5594\uFF01\uFF01"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u4E0D\u597D\u610F\u601D\u5594\uFF5E\u6211\u5440\uFF5E\\n\u9084\u4E0D\u89BA\u5F97[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u591A\u53B2\u5BB3\u5462\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u9019\u6B21\u7684\u4FEE\u884C\uFF0C\\n\u4EBA\u5BB6\u6211\u662F\u7D55\uFF5E\u4E0D\u6703\u8F38\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5566\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6211\u7684\u547D\u904B\u9084\u4E0D\u5141\u8A31\u6211\\n\u8A8D\u540C[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BE6\u529B\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u6211\u8981\u6436\u5148\u627E\u5230\u6975\u5DE8\u83C7\u83C7\uFF0C\\n\u628A\u52DD\u5229\u7A69\u7A69\u5730\u63E1\u5728\u624B\u4E2D\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u7B2C\uFF12\u500B\u4FEE\u884C\u662F\\n\u53BB\u63A1\uFF13\u500B\u6975\u5DE8\u83C7\u83C7\u56DE\u4F86\uFF01\\c\\n\u6975\u5DE8\u83C7\u83C7\u662F\\n\u6709\u6F29\u6E26\u82B1\u7D0B\u7684\u7D05\u8272\u8611\u83C7\u3002\\c\\n\u8001\u982D\u5152\u6211\u731C\u5B83\u6703\u9577\u5728\\n\u53C8\u6FD5\u53C8\u6697\u7684\u5730\u65B9\u5537\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u6211\u5011\u6703\u66AB\u6642\u5728\u9019\u88E1\u81EA\u4E3B\u8A13\u7DF4\u7684\uFF5E\uFF01"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6240\u4EE5\u8AAA\uFF0C\u6975\u5DE8\u83C7\u83C7\u662F\u9577\u5728\\n\u5C08\u6CE8\u68EE\u6797\u55CE\uFF1F\\r\\n\u9084\u662F\u6703\u5728\u7A7F\u904E\u68EE\u6797\u7684\u6D1E\u7A74\u88E1\uFF1F"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u55EF\uFF1F\u6211\u5C31\u5728\u6B64\u7559\u5B88\u4E86\u2026\u2026\\c\\n\u56E0\u70BA\u6211\u6C92\u6709\u5B8C\u6210\u5446\u5446\u7378\u7684\u4FEE\u884C\u54EA\u3002"
  },
  {
