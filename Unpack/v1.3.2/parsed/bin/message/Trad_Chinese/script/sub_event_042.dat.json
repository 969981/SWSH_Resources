  {
    "index": 4,
    "flags": 0,
    "text": "\u6B38\uFF1F[VAR 1100(00FF,0101)]\u4F60\u59B3\u9858\u610F\u5E6B\u5FD9\\n\u4E00\u8D77\u627E\u6CE1\u6CAB\u6817\u9F20\uFF1F\u8B1D\u8B1D\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u7684\u6CE1\u6CAB\u6817\u9F20\u559C\u6B61\\n\u73A9\u6C34\u548C\u6307\u54E8\u7684\u8072\u97F3\uFF01\\c\\n\u5982\u679C\u6709\u7A4D\u4E86\u6C34\u7684\u5730\u65B9\uFF0C\\n\u7260\u4E00\u5B9A\u6703\u8EB2\u5728\u88E1\u9762\uFF01\\c\\n\u4E0D\u904E\u6A5F\u64CE\u5E02\u88E1\u982D\\n\u6709\u90A3\u6A23\u7684\u5730\u65B9\u55CE\u2026\u2026\uFF1F\\c\\n\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u807D\u5230\u300C\u5657\u7D66\uFF5E\u300D\u9019\u6A23\u5947\u5999\u7684\u53EB\u8072\uFF0C\\n\u8A18\u5F97\u5439\u5439\u6307\u54E8\u53EB\u7260\u770B\u770B\uFF01"
  },
