  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6F02\u4EAE\u5730\u5B8C\u6210\u4E86\u9053\u9928\u4EFB\u52D9\uFF01"
