  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6C92\u4EC0\u9EBC"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7D2F\u7A4D\uFF15\u5206\u5373\u53EF\u904E\u95DC\uFF01\\c\\n\u6253\u5012\u8349\u53E2\u88E1\u7684\u5BF6\u53EF\u5922\u6642\uFF0C\\n\u53EF\u4EE5\u7372\u5F97\uFF11\u5206\u3002\\r\\n\u6355\u6349\u6210\u529F\u6642\u53EF\u4EE5\u7372\u5F97\uFF12\u5206\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E00\u65E6\u4E2D\u9014\u9000\u51FA\u5F8C\uFF0C\\n\u4E0B\u6B21\u5C31\u5FC5\u9808\u91CD\u65B0\u958B\u59CB\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u78BA\u5B9A\u8981\u9000\u51FA\u55CE\uFF1F"
