[
  {
    "index": 0,
    "flags": 0,
    "text": "\u706B\u5C6C\u6027\u5BF6\u53EF\u5922\u9053\u9928\u7684\\n\u9053\u9928\u4EFB\u52D9\u662F\uFF5E\uFF01\\c\\n\u6355\u6349\u5BF6\u53EF\u5922\uFF0C\\n\u7D2F\u7A4D\u904E\u95DC\u6240\u9700\u7684\u7A4D\u5206\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8A13\u7DF4\u5BB6\u9700\u8981\u7D2F\u7A4D\uFF15\u5206\u624D\u7B97\u4EFB\u52D9\u5B8C\u6210\uFF01\\c\\n\u6253\u5012\u8349\u53E2\u88E1\u7684\u5BF6\u53EF\u5922\u6642\uFF0C\\n\u53EF\u4EE5\u7372\u5F97\uFF11\u5206\u3002\\r\\n\u6355\u6349\u6210\u529F\u6642\u53EF\u4EE5\u7372\u5F97\uFF12\u5206\u3002\\c\\n\u8ACB\u7559\u610F\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6703\u548C\u5176\u4ED6\u7684\u8A13\u7DF4\u5BB6\\n\u4E00\u8D77\u8207\u5BF6\u53EF\u5922\u5C0D\u6230\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E5F\u5C31\u662F\u8AAA\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FC5\u9808\u89C0\u5BDF\u5176\u4ED6\u8A13\u7DF4\u5BB6\u7684\u884C\u52D5\uFF0C\\r\\n\u4E26\u4E14\u63A1\u53D6\u6700\u4F73\u7684\u7B56\u7565\u4F86\u7D2F\u7A4D\u5206\u6578\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u9053\u9928\u4EFB\u52D9\u958B\u59CB\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
