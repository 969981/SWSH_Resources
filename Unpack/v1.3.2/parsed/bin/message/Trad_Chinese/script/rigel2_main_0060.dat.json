  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5509\u2026\u2026\u6211\u8AAA\u9019\u8D9F\u65C5\u884C\u554A\uFF01\\n\u6211\u53EF\u662F\u70BA\u4E86\u5C0F\u590F\u590F\u5979\u6311\u71C8\u591C\u6230\uFF0C\\r\\n\u624D\u7D42\u65BC\u5F04\u51FA\u9019\u500B\u63A2\u96AA\u8A08\u756B\u7684\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 20,
