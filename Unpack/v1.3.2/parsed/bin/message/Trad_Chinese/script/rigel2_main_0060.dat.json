    "text": "\u4E5F\u8A31\u5979\u6B63\u503C\u90A3\u500B\\n\u60F3\u8981\u81EA\u5DF1\u53BB\u8A66\u8A66\u5F88\u591A\u4E8B\u7684\u5E74\u7D00\u5427\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
