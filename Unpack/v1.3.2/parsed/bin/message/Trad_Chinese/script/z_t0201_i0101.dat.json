    "text": "\u80D6\u6C6A\u6C6A\u6C6A\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u300C\u95DC\u65BC\u5BF6\u53EF\u5922\u7684\u8B8A\u5316\u300D\\n\u5BF6\u53EF\u5922\u4E0D\u50C5\u6703\u56E0\u70BA\\n\u7B49\u7D1A\u63D0\u5347\u800C\u6539\u8B8A\u6A23\u5B50\uFF0C\\n\u4E5F\u6703\u56E0\u70BA\u9053\u5177\u7684\u5F71\u97FF\u6216\\n\u5834\u6240\u800C\u4F7F\u6A23\u5B50\u7522\u751F\u8B8A\u5316\u3002\\c\\n\u4E00\u822C\u63A8\u6E2C\u662F\u7531\u65BC\u860A\u85CF\u5728\\n\u5BF6\u53EF\u5922\u9AD4\u5167\u7684\u67D0\u7A2E\u56E0\u5B50\uFF0C\\n\u4F7F\u7260\u5011\u7684\u6A23\u8C8C\u6216\u6027\u8CEA\u6539\u8B8A\uFF0C\\n\u4F46\u81F3\u4ECA\u4ECD\u6C92\u6709\u627E\u5230\u6C7A\u5B9A\u6027\u7684\u8B49\u64DA\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u300C\u5BF6\u53EF\u5922\u7684\u6975\u5DE8\u5316\u300D\\n\u5BF6\u53EF\u5922\u5DE8\u5927\u5316\u7684\u73FE\u8C61\u88AB\u7A31\u70BA\u6975\u5DE8\u5316\u3002\\n\u76EE\u524D\u78BA\u8A8D\u53EA\u6709\u5728\u4F3D\u52D2\u723E\u5730\u5340\u7684\u7279\u5B9A\u5834\u6240\uFF0C\\n\u4EE5\u53CA\u7279\u5B9A\u7684\u689D\u4EF6\u4E0B\u6703\u767C\u751F\u6B64\u73FE\u8C61\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u300C\u5BF6\u53EF\u5922\u7684\u5DE8\u5927\u5316\u300D\\n\u57FA\u672C\u4E0A\u5BF6\u53EF\u5922\u9032\u5316\u5F8C\\n\u6703\u8B8A\u5F97\u66F4\u5F37\u66F4\u5927\u3002\\n\u8B93\u8EAB\u9AD4\u770B\u8D77\u4F86\u66F4\u5927\\n\u662F\u751F\u5B58\u672C\u80FD\u7684\u4E00\u7A2E\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u597D\u4E45\u4E0D\u898B\uFF0C\\n\u51A0\u8ECD[VAR 0100(0000)]\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5C0D\u65BC\u4E4B\u524D\u8B93[VAR 0101(0001)]\u5931\u63A7\u7684\u4E8B\uFF0C\\n\u6211\u771F\u7684\u611F\u5230\u975E\u5E38\u62B1\u6B49\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u70BA\u4E86\u5F4C\u88DC\u6211\u5011\u72AF\u4E0B\u7684\u7F6A\u904E\uFF0C\\n\u7D22\u5FB7\u5927\u4EBA\u3001\u897F\u723E\u8FEA\u5927\u4EBA\uFF0C\u9084\u6709\u6211\uFF0C\\r\\n\u90FD\u5728\u7576\u7FA9\u5DE5\u5462\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7ADF\u7136\u6703\u62DC\u8A17\u9A19\u904E\u81EA\u5DF1\u7684\u4EBA\\n\u5E6B\u5FD9\u7559\u5B88\u7814\u7A76\u6240\u2026\u2026\\c\\n\u7D22\u59AE\u4E9E\u535A\u58EB\u771F\u662F\u6709\u5EA6\u91CF\u554A\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5230\u6700\u5F8C\uFF0C\\n\u6211\u9084\u662F\u56DE\u5230\u9019\u88E1\u5DE5\u4F5C\u4E86\u3002\\c\\n\u9019\u6B21\u6211\u6703\u8AA0\u5FC3\u8AA0\u610F\u5730\u5E6B\u5FD9\u7684\u2026\u2026\\n\u5475\u5475\u5475\u3002"
  },
  {
