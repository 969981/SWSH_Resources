    "text": "\u9053\u9928\u6311\u6230\u8005\uFF01\\c\\n\u60F3\u6311\u6230\u5361\u856A\u7684\u8A71\uFF0C\\n\u5F97\u5148\u62FF\u5230\u8349\u8DEF\u93AE\u7684\u8349\u4E4B\u5FBD\u7AE0\uFF0C\\r\\n\u4EE5\u53CA\u6C34\u821F\u93AE\u7684\u6C34\u4E4B\u5FBD\u7AE0\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8B9A\u554A\uFF01\u9053\u9928\u6311\u6230\u8005\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\uFF12\u500B\u9053\u9928\u5FBD\u7AE0\uFF0C\u771F\u662F\u592A\u5091\u51FA\u4E86\uFF01\\c\\n\u4E0D\u904E\uFF0C\u5361\u856A\u597D\u50CF\u6B63\u5728\\n\u7B2C\u4E8C\u7926\u5C71\u7279\u8A13\u5462\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F9E\u6C34\u821F\u93AE\u904E\u53BB\u770B\u770B\u5427\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u8005\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u5F97\u597D\u554A\uFF01\\c\\n\u9053\u9928\u6311\u6230\u4E26\u4E0D\u5BB9\u6613\u2026\u2026\\n\u80FD\u5920\u524D\u4F86\u6311\u6230\u5361\u856A\u7684\u4EBA\u4E26\u4E0D\u591A\u3002\\r\\n\u6211\u7ACB\u523B\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u8FA6\u7406\u5831\u5230\u5427\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u597D\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\u4E0D\u7528\u6025\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u96A8\u6642\u518D\u4F86\u6311\u6230\u5427\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u65E2\u7136\u8981\u9032\u884C\u9053\u9928\u6311\u6230\uFF0C\\n\u5C31\u5148\u53BB\u63DB\u4E0A\u7AF6\u6280\u670D\u5427\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210\u9053\u9928\u4EFB\u52D9\u4E86\uFF01\\n\u606D\u559C\u554A\uFF01\u592A\u7CBE\u5F69\u4E86\uFF01\\c\\n\u63A5\u4E0B\u4F86\u5C31\u8981\u8207\u5361\u856A\u5C0D\u6230\u4E86\uFF0C\\n\u52DD\u8CA0\u7684\u95DC\u9375\u5C31\u5728\u65BC\u2026\u2026\\r\\n\u8AB0\u80FD\u6BD4\u5C0D\u65B9\u66F4\u706B\u71B1\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u706B\u5C6C\u6027\u7684\u9053\u9928\u4EFB\u52D9\\n\u7D55\u5C0D\u4E0D\u540C\u51E1\u97FF\uFF01\u8ACB\u5427\uFF01"
