    "flags": 0,
    "text": "\u563F\u2026\u2026\uFF01\u5225\u8DD1\u554A\uFF01\\n\u6211\u5011\u9700\u8981\u4F60\u5011\u7684\u5E6B\u5FD9\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u5011\u5006\u2026\u2026\\n\u600E\u9EBC\u4E86\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5565\uFF01\uFF1F\u59B3\u6C92\u770B\u5230\u55CE\uFF1F\\n\u90A3\u5C0D\u5BF6\u53EF\u5922\u5C31\u662F\u528D\u8207\u76FE\uFF01\\r\\n\u53EF\u662F\uFF0C\u7260\u5011\u6D88\u5931\u5728\u68EE\u6797\u88E1\u4E86\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u9084\u597D\u5427\uFF1F\\n\u6211\u53EA\u6709\u770B\u5230\u4F60\u5011\u5006\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9019\u2026\u2026\\n\u96E3\u9053\u6211\u5011\u770B\u5230\u7684\u662F\u5E7B\u5F71\u55CE\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5728\u8ABF\u67E5\u4E86\u5916\u570B\u7684\u6587\u737B\u5F8C\uFF0C\\n\u6211\u7D42\u65BC\u627E\u5230\u7D00\u9304\u4E86\u3002\\c\\n\u528D\u7684\u5BF6\u53EF\u5922\u53EB\u505A\u84BC\u97FF\uFF0C\\n\u76FE\u7684\u5BF6\u53EF\u5922\u53EB\u505A\u85CF\u746A\u7136\u7279\u3002\\c\\n\u7260\u5011\u64DA\u8AAA\u662F\u751F\u65BC\u9059\u9060\u7684\u5730\u65B9\u2026\u2026\\n\u662F\u4F86\u81EA\u5FAE\u5BD0\u68EE\u6797\u5F7C\u7AEF\u7684\u5BF6\u53EF\u5922\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9019\u6A23\u554A\u2026\u2026\\n\u8B1D\u56C9\uFF0C\u7D22\u59AE\u4E9E\u3002[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u597D\u8036\uFF01\u96D6\u7136\u53EA\u662F\u5E7B\u5F71\uFF0C\\n\u4F46\u662F\u6211\u5011\u53C8\u9047\u898B\u90A3\u5C0D\u5BF6\u53EF\u5922\u4E86\uFF01\\c\\n\u7260\u5011\u4F7F\u7528\u7684\u528D\u8207\u76FE\\n\u4E00\u5B9A\u4E5F\u662F\u5B58\u5728\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u88AB\u7A31\u70BA\u528D\u8207\u76FE\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u84BC\u97FF\u8207\u85CF\u746A\u7136\u7279\u2026\u2026\\c\\n\u7260\u5011\u8AAA\u4E0D\u5B9A\u5C31\u6C89\u7761\u5728\\n\u96E2\u6545\u9109\u8F03\u8FD1\u7684\u5FAE\u5BD0\u68EE\u6797\u3002\\c\\n\u800C\u4E14\uFF0C\u61C9\u8A72\u662F\u5728\u5BE7\u975C\\n\u4E14\u6C92\u6709\u4EBA\u6703\u9760\u8FD1\u7684\u68EE\u6797\u6DF1\u8655\u2026\u2026[VAR 0114(000B)]"
  }
]
