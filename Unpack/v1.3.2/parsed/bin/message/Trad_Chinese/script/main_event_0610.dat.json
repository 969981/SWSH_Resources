    "flags": 0,
    "text": "\u8B1D\u8B1D\u4F60\u5594\u3002\u4F86\u96FB\u6C6A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u80D6\u6C6A\u6C6A\u6C6A\u6C6A\u6C6A\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u60F3\u807D\u807D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u60F3\u6CD5\uFF0C\\n\u6240\u4EE5\u624D\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C08\u7A0B\u904E\u4F86\u4E00\u8D9F\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u90A3\u5E45\u5DE8\u5927\u7684\u5730\u756B\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u89BA\u5F97\u5B83\u756B\u7684\u7A76\u7ADF\u662F\u4EC0\u9EBC\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u95C7\u591C\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6975\u5DE8\u5316\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u53B2\u5BB3\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u597D\u773C\u529B\u3002\\c\\n\u756B\u6709\u9ED1\u8272\u6F29\u6E26\u7684\u90E8\u5206\\n\u5E7E\u4E4E\u90FD\u8981\u6D88\u5931\u4E86\u5462\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u7684\u78BA\uFF0C\u90A3\u770B\u8D77\u4F86\\n\u4E5F\u50CF\u662F\u8B8A\u5927\u7684\u5BF6\u53EF\u5922\u3002\\c\\n\u4F46\u662F\uFF0C\u5C31\u7B97\uFF13\uFF10\uFF10\uFF10\u5E74\u524D\u7684\u4EBA\\n\u60F3\u50CF\u529B\u518D\u600E\u9EBC\u8C50\u5BCC\uFF0C\\r\\n\u4E5F\u5F88\u96E3\u6191\u7A7A\u756B\u51FA\\r\\n\u5F9E\u6C92\u898B\u904E\u7684\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5F88\u4E45\u4EE5\u524D\u2026\u2026\\n\u9ED1\u8272\u7684\u6F29\u6E26\u7C60\u7F69\u4E86\u4F3D\u52D2\u723E\u5730\u5340\uFF0C\\r\\n\u5DE8\u5927\u7684\u5BF6\u53EF\u5922\u5728\u5404\u8655\u5927\u9B27\u2026\u2026\\c\\n\u88AB\u7A31\u70BA\u95C7\u591C\u7684\u9ED1\u8272\u6F29\u6E26\u7A76\u7ADF\u662F\u4EC0\u9EBC\uFF1F\\n\u5B83\u548C\u6975\u5DE8\u5316\u53C8\u6709\u4EC0\u9EBC\u95DC\u9023\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u9019\u90FD\u662F\u6211\u5FC5\u9808\u53BB\u8ABF\u67E5\u7684\u2026\u2026\\n\u5509\uFF0C\u5976\u5976\u7D66\u7684\u9019\u4EFD\u529F\u8AB2\u771F\u8271\u9245\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u591A\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u8CB4\u610F\u898B\uFF01\\n\u9019\u5F35\u806F\u76DF\u5361\u5C31\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7576\u8B1D\u79AE\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4E9E\u6D1B\u662F\u8349\u5C6C\u6027\u7684\u9053\u9928\u9928\u4E3B\u3002\\c\\n\u4F7F\u7528\u706B\u5C6C\u6027\u3001\u87F2\u5C6C\u6027\uFF0C\\n\u6216\u662F\u98DB\u884C\u5C6C\u6027\u7684\u62DB\u5F0F\u653B\u64CA\uFF0C\\r\\n\u90FD\u6703\u6709\u6548\u5594\uFF01\\c\\n\u9084\u6709\uFF0C\u9019\u500B\u4E5F\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\\n\u5BF6\u53EF\u5922\u8981\u6709\u6D3B\u529B\u624D\u884C\u561B\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u5FEB\u53BB\u8349\u8DEF\u7AF6\u6280\u5834\\n\u653E\u624B\u4E00\u640F\u5427\uFF01[VAR 0114(000B)]"
  }
]
