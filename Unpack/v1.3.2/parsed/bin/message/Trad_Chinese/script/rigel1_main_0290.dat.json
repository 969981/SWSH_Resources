  {
    "index": 3,
    "flags": 0,
    "text": "\u662F\u4F60\u554A\uFF0C\u8D6B\u666E\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u563F\u563F\u563F\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u53CD\u61C9\u771F\u597D\uFF01\\n\u771F\u4E0D\u6127\u662F[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5582\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u5230\u6211\\n\u96E3\u9053\u4E00\u9EDE\u90FD\u4E0D\u9A5A\u8A1D\u55CE\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u6B63\u5728\u505A\u6975\u5DE8\u5316\u7684\u8ABF\u67E5\uFF0C\\n\u6253\u7B97\u66AB\u6642\u5F85\u5728\u93A7\u5CF6\u5594\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9846\u79D1\u79D1\uFF0C\u807D\u8AAA\u4F60\u5011\u5169\u500B\u662F\u597D\u670B\u53CB\u5440\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8D6B\u666E\u4ED4\u4ED6\u7279\u5730\u5230\u6B66\u9928\u4F86\u53D6\u5F97\\n\u5728\u93A7\u5CF6\u9732\u71DF\u7684\u8A31\u53EF\u5462\u3002\\c\\n\u4E0D\u904E\uFF0C\u9732\u71DF\u4E5F\u633A\u9EBB\u7169\u7684\uFF0C\\n\u6240\u4EE5\u8001\u982D\u5152\u6211\u6B63\u5728\u9080\u4ED6\u4F4F\u5728\u6B66\u9928\u5566\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8981\u662F\u80FD\u501F\u4F4F\u7684\u8A71\u7576\u7136\u6703\u8F15\u9B06\u5F88\u591A\u3002\\n\u53EF\u662F\uFF0C\u4E0D\u6703\u7D66\u5927\u5BB6\u6DFB\u9EBB\u7169\u55CE\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u99AC\u5E2B\u5085\u6B66\u9928\u96A8\u6642\u90FD\u662F\\n\u655E\u958B\u5927\u9580\u6B61\u8FCE\u6240\u6709\u4EBA\u7684\u5537\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u800C\u4E14\u65E2\u7136\u4F60\u662F\u4E39\u5E1D\u4ED4\u7684\u5F1F\u5F1F\uFF0C\\n\u5C0D\u6B66\u9928\u7684\u5927\u5925\u5152\u4F86\u8AAA\u4F60\u4E5F\u662F\u5BB6\u4EBA\u5566\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5C0D\u5594\u2026\u2026\u5C0F\u6642\u5019\\n\u5927\u54E5\u4E5F\u66FE\u5728\u9019\u9593\u6B66\u9928\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u99AC\u58EB\u5FB7\u5E2B\u5085\uFF01\\n\u6211\u9084\u662F\u2026\u2026\\r\\n\u6C7A\u5B9A\u8981\u66AB\u6642\u4F86\u6253\u64FE\u4F60\u5011\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54E6\u8036\uFF5E\uFF01\u7576\u7136\u662F\uFF2F\uFF2B\u5566\uFF01\\n\u770B\u4F86\u6703\u8B8A\u5F97\u53C8\u71B1\u9B27\u53C8\u6709\u8DA3\u5695\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8001\u982D\u5152\u6211\u5F97\u544A\u8A34[VAR 1100(00FF,0101)]\u4F60\u59B3\u95DC\u65BC\u718A\u5F92\u5F1F\\n\u9032\u5316\u8B8A\u6210\u6B66\u9053\u718A\u5E2B\u4E4B\u5F8C\u7684\u4E8B\u5462\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6B66\u9053\u718A\u5E2B\u860A\u85CF\u8457\u8D85\u6975\u5DE8\u5316\u7684\u53EF\u80FD\u6027\uFF0C\\n\u53EA\u53EF\u60DC\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u7260\u4E0D\u559C\u6B61\u6975\u5DE8\u83C7\u83C7\u7684\u98A8\u5473\uFF0C\\n\u6240\u4EE5\u6C92\u8FA6\u6CD5\u559D\u6975\u5DE8\u6E6F\u5537\u3002[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u5982\u679C\u628A\u93A7\u5CF6\u4E0A\u63A1\u5F97\u5230\u7684\\n[VAR FF00(0006)]\u67D0\u6A23\u6771\u897F[VAR FF00(0000)]\u52A0\u9032\u6E6F\u88E1\uFF0C\\r\\n\u7260\u5C31\u6703\u9858\u610F\u559D\u6E6F\u4E86\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u9019[VAR FF00(0006)]\u67D0\u6A23\u6771\u897F[VAR FF00(0000)]\u5C31\u662F\u2026\u2026[VAR 0114(0073)]"
