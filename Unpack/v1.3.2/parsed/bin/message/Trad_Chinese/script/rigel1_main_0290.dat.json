  {
    "index": 21,
    "flags": 0,
    "text": "\u67D0\u6A23\u6771\u897F\u5C31\u662F\u2026\u2026\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u67D0\u6A23\u6771\u897F\u5C31\u662F\u2026\u2026[VAR 0114(0073)]"
