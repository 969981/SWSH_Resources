  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u807D\u8AAA[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u6B66\u9928\u7684\u4FEE\u884C\\n\u8868\u73FE\u5F97\u5F88\u68D2\u5594\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
