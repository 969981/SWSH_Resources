[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8981\u62D4\u863F\u8514\u55CE\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u563F\u5466\u563F\u5466\u2026\u2026\u563F\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4EBA\u985E\u7684\u5C0F\u5B69\u5152\u554A\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u505A\u5F97\u592A\u68D2\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F7F\u7528\u90A3\u6839\u863F\u8514\uFF0C\\n\u5C31\u80FD\u8A98\u51FA\u6715\u7684\u611B\u99AC\u4E86\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u63A5\u4E0B\u4F86\u53EA\u9700\u8981\u6709\\n\u80FD\u5E6B\u6715\u589E\u5E45\u529B\u91CF\u7684\u727D\u7D46\u97C1\u7E69\uFF0C\\r\\n\u6715\u5C31\u80FD\u8F15\u9B06\u5730\u99D5\u99AD\u611B\u99AC\u4E86\u3002\u4E0D\u904E\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u770B\u4F86\uFF0C\u4EBA\u985E\u5927\u6982\u518D\u4E5F\u4E0D\u6703\\n\u5C07\u90A3\u6771\u897F\u737B\u7D66\u6715\u4E86\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5504\u568E\uFF5E\u5636\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u55DA\u568E\uFF5E\u5636\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u90A3\u50A2\u4F19\u662F\u6715\u7684\u611B\u99AC\\n\u2026\u2026\u96EA\u66B4\u99AC\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u90A3\u50A2\u4F19\u662F\u6715\u7684\u611B\u99AC\\n\u2026\u2026\u9748\u5E7D\u99AC\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u4E00\u8EAB\u6F54\u767D\u8000\u773C\u7684\u6BDB\u76AE\uFF01\\n\u72C2\u91CE\u5954\u9A30\u7684\u8EAB\u5F71\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u90A3\u4E00\u8EAB\u70CF\u9ED1\u4EAE\u9E97\u7684\u6BDB\u76AE\uFF01\\n\u72C2\u91CE\u5954\u9A30\u7684\u8EAB\u5F71\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6B63\u5982\u7260\u7576\u5E74\u8207\u6715\u521D\u6B21\u76F8\u9047\u6642\uFF01\\n\u54CE\uFF0C\u597D\u61F7\u5FF5\u554A\uFF0C\u597D\u61F7\u5FF5\u554A\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5504\u5594\uFF5E\u5636\u2026\u2026"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u55DA\u5594\uFF5E\u5636\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6715\u731C\u90A3\u50A2\u4F19\u662F\\n\u611F\u53D7\u5230\u4E86\u863F\u8514\u7684\u9999\u6C23\uFF0C\\r\\n\u4F46\u9084\u6C92\u638C\u63E1\u5230\u78BA\u5207\u7684\u4F4D\u7F6E\u3002[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5F9E\u7260\u8DD1\u53BB\u7684\u65B9\u5411\u770B\u4F86\uFF0C\\n\u8AAA\u4E0D\u5B9A\u662F\u5F80\u6751\u5B50\u53BB\u6436\u863F\u8514\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u82E5\u771F\u662F\u9019\u6A23\uFF0C\u4EBA\u985E\u7684\u5C0F\u5B69\u5152\u554A\uFF0C\\n\u51CD\u51DD\u6751\u6709\u5371\u96AA\u4E86\uFF01\\r\\n\u8D95\u7DCA\u5F80\u6751\u5B50\u53BB\u5427\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u2026\u2026\u6211\u4E0D\u6703\u8B93\u90A3\u50A2\u4F19\\n\u6417\u4E82\u6211\u7684\u7530\u7684\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u7CDF\u5566\uFF01\u4E0D\u597D\u5566\uFF01\\n\u6709\u96BB\u5BF6\u53EF\u5922\u5728\u6751\u88E1\u5927\u9B27\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u90A3\u96BB\u5BF6\u53EF\u5922\u2026\u2026\\n\u96E3\u9053\u5C31\u662F\u7AE5\u8A71\u6545\u4E8B\u7684\u2026\u2026\uFF01\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u90A3\u9EBC\u5927\u4E00\u96BB\u5BF6\u53EF\u5922\\n\u5728\u6751\u5B50\u88E1\u5927\u9B27\u9084\u5F97\u4E86\u554A\uFF01\\c\\n\u8AB0\u4F86\u5E6B\u5E6B\u5FD9\uFF01\\n\u5B89\u64AB\u90A3\u96BB\u66B4\u8E81\u7684\u50A2\u4F19\u5427\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u600E\u9EBC\u9019\u9EBC\u71B1\u9B27\u3002\\n\u73FE\u5728\u662F\u6176\u5178\u7684\u5B63\u7BC0\u55CE\uFF1F"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6715\u7684\u611B\u99AC\u2026\u2026\u842C\u4E00\u7260\u628A\u4EBA\u985E\u2026\u2026\\n\u4F46\u73FE\u5728\u7684\u6715\u5BE6\u5728\u7121\u6CD5\u2026\u2026\\c\\n\u62DC\u8A17\u4E86\uFF01\u4EBA\u985E\u7684\u5C0F\u5B69\u5152\u554A\uFF01\\n\u6715\u76FC[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u6551\u6551\u6751\u5B50\uFF01[VAR 0114(0079)]"
