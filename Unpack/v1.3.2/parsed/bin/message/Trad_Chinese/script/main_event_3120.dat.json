[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F60\u5011\u5E7E\u500B\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5F7C\u7279\uFF01\uFF1F\\n\u6975\u5DE8\u5316\u7684\u5BF6\u53EF\u5922\u5462\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u5011\u4EE5\u70BA\u6211\u7121\u6CD5\u61C9\u4ED8\u55CE\uFF1F\\c\\n\u6211\u662F\u8AB0\uFF1F\u6211\u4E0D\u50C5\u662F\u500B\u7CBE\u82F1\uFF0C\\n\u9084\u662F\u5996\u7CBE\u5C6C\u6027\u7684\u9053\u9928\u9928\u4E3B\u5462\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C0D\u5594\uFF0C\u6211\u90FD\u5FD8\u4E86\u4F60\u662F\u9053\u9928\u9928\u4E3B\u5462\uFF01\\n\u2026\u2026\u662F\u4E0D\u662F\u7CBE\u82F1\uFF0C\u6211\u5C31\u4E0D\u77E5\u9053\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u96E3\u9053\u8AAA\u2026\u2026\u90FD\u9019\u6642\u5019\u4E86\u2026\u2026\\n\u4F60\u5011\u8A72\u4E0D\u6703\u662F\u4F86\u5E6B\u5FD9\u7684\u5427\uFF1F\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u6211\u9019\u500B\u7CBE\u82F1\uFF0C\\n\u4F55\u5FC5\u8981\u4F60\u5011\u7684\u5E6B\u5FD9\u5462\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u9084\u662F\u9019\u9EBC\u5634\u786C\u554A\u2026\u2026\\n\u8667\u6211\u5011\u9084\u64D4\u5FC3\u5F97\u4E00\u8DEF\u8D95\u4F86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u771F\u662F\u500B\u9EBB\u7169\u7684\u9053\u9928\u9928\u4E3B\u3002\\c\\n\u770B\u6A23\u5B50\uFF0C\u4E0B\u4E00\u5C46\u7684\u9053\u9928\u6311\u6230\\n\u53C8\u6709\u5F97\u6298\u9A30\u56C9\u2026\u2026[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u4E4B\u524D\u662F\u88AB\u5967\u5229\u8587\u79D8\u66F8\u9A19\u4E86\uFF0C\\n\u624D\u6703\u88AB\u727D\u8457\u9F3B\u5B50\u8D70\u2026\u2026\\c\\n\u73FE\u5728\uFF0C\u6211\u8981\u81EA\u5DF1\u638C\u63E1\u81EA\u5DF1\u7684\u4EBA\u751F\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9996\u5148\u662F[VAR 0100(0000)]\u3002\\n\u6211\u8981\u548C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5E6B\u5E6B\u5FD9\u2026\u2026\\n\u73FE\u5728\u600E\u9EBC\u6703\u662F\u5C0D\u6230\u7684\u6642\u5019\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5728\u9053\u9928\u6311\u6230\u7B54\u51FA\u5927\u6EFF\u8CAB\u7684\u5C0F\u5F1F\u554A\uFF0C\\n\u4EBA\u751F\u53EF\u5225\u6025\u8457\u8D95\u8DEF\u3002[VAR 0114(0013)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5F7C\u7279\u7368\u81EA\u5236\u4F0F\u4E86\\n\uFF13\u96BB\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u5462\u2026\u2026\\c\\n\u5C31\u7576\u4ED6\u662F\u5E6B\u4F60\u5011\u7701\u4E86\u9EDE\u6642\u9593\u5427\u3002[VAR 0114(0013)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8AAA\u5230\u5E95\uFF0C\u9019\u662F\u5F7C\u7279\u7684\u4EBA\u751F\uFF0C\\n\u65C1\u4EBA\u6C92\u4EC0\u9EBC\u597D\u63D2\u5634\u7684\u3002\\c\\n\u4E0D\u904E\u8A71\u8AAA\u56DE\u4F86\uFF0C\u6211\u5012\u662F\\n\u628A\u4ED6\u7684\u4EBA\u751F\u7D66\u8F49\u4E86\u4E00\u500B\u5927\u5F4E\u554A\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u2026\u2026\u59B3\u7684\u78BA\u662F\u3002[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u597D\u4E86\u597D\u4E86\uFF0C\u4E0D\u6127\u662F\uFF18\uFF18\u6B72\u7684\u5927\u524D\u8F29\u3002\\n\u9019\u5C31\u662F\u6240\u8B02\u7684\u300C\u8591\u9084\u662F\u8001\u7684\u8FA3\u300D\u55CE\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u9019\u548C\u6CE2\u666E\u83C8\u6C92\u6709\u95DC\u4FC2\u3002\\n\u9019\u5834\u5C0D\u6230\uFF0C\u662F\u70BA\u4E86\u6211\u81EA\u5DF1\uFF01\uFF01\\c\\n\u4F86\u5427\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EA\u6709\u4E00\u500B\u9078\u9805\uFF0C\\n\u90A3\u5C31\u662F\u2026\u2026\u8207\u6211\u5C0D\u6230\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u5011\u5C0D\u6230\u5427"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6211\u63A5\u53D7\u4F60\u7684\u6311\u6230\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u8B93\u6211\u9732\u5E7E\u624B\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u77A7\u77A7\uFF0C\\n\u91CD\u751F\u5F8C\u7684\u6211\u8207\u6211\u7684\u5BF6\u53EF\u5922\u5011\u2026\u2026\\r\\n\u7A76\u7ADF\u6709\u591A\u51FA\u8272\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u8207\u6211\u5C0D\u6230\u3002\\c\\n\u6211\u73FE\u5728\u7D42\u65BC\u80FD\u5920\\n\u5FC3\u670D\u53E3\u670D\u5730\u627F\u8A8D[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u51A0\u8ECD\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u96D6\u7136\u5F88\u4E0D\u7518\u5FC3\uFF0C\\n\u4F46\u662F\u6211\u770B\u6E05\u81EA\u5DF1\u7684\u4E0D\u8DB3\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u6703\u5C07\u5996\u7CBE\u5C6C\u6027\u947D\u7814\u5230\u6975\u81F4\uFF0C\\n\u8B8A\u5F97\u6BD4\u73FE\u5728\u66F4\u5F37\u7684\u3002[VAR 0114(000C)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u73FE\u5728\uFF0C\u6211\u5C31\u76E1\u6211\u9053\u9928\u9928\u4E3B\u7684\u8077\u8CAC\uFF0C\\n\u628A\u9053\u9928\u7AF6\u6280\u5834\u6E05\u7406\u4E7E\u6DE8\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u525B\u624D\u7684\u5BF6\u53EF\u5922\u5C0D\u6230\u2026\u2026\\n\u771F\u662F\u7C89\u7D05\u6EFF\u5929\u98DB\u7684\u5B8C\u7F8E\u5C0D\u6230\u5462\u3002[VAR 0114(0013)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5C31\u7B97\u88AB\u525D\u596A\u4E86\u53C3\u52A0\u9053\u9928\u6311\u6230\u7684\u6B0A\u5229\uFF0C\\n\u4ED6\u9084\u662F\u95D6\u5165\u4E86\u51A0\u8ECD\u76C3\u7684\u5C0D\u6230\u5834\u2026\u2026\\c\\n\u90A3\u50A2\u4F19\u2026\u2026\u771F\u662F\u6709\u9AA8\u6C23\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u4F3C\u4E4E\u53EF\u4EE5\u4E86\u89E3\\n\u4ED6\u70BA\u4EC0\u9EBC\u80FD\u7576\u4E0A\u9053\u9928\u9928\u4E3B\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5F7C\u7279\u9019\u50A2\u4F19\u2026\u2026\\n\u8001\u5BE6\u8AAA\uFF0C\u6211\u771F\u662F\u770B\u4E0D\u6163\u4ED6\u3002\\r\\n\u4F46\u4ED6\u7684\u78BA\u662F\u500B\u4E86\u4E0D\u8D77\u7684\u8A13\u7DF4\u5BB6\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u4ED6\u5F88\u62FC"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u4ED6\u771F\u7684\u5F88\u5F37"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u55EF\uFF0C\u5F9E\u4F60\u5011\u7684\u5C0D\u6230\u53EF\u4EE5\u770B\u5F97\u51FA\u4F86\u3002\\n\u4ED6\u4E00\u5B9A\u662F\u4ED8\u51FA\u4E86\u5F88\u591A\u52AA\u529B\u3002[VAR 0114(0005)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u9023\u8EAB\u70BA\u51A0\u8ECD\u7684[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\n\u90FD\u627F\u8A8D\u4ED6\u5F88\u5F37\u554A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u4F60\u5011\u5006\u804A\u6210\u9019\u6A23\u2026\u2026\\n\u8981\u6211\u53BB\u5E6B\u4F60\u5011\u6CE1\u676F\u8336\u55CE\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u6211\u6C7A\u5B9A\u4E86\uFF01\u6211\u4E5F\u4E0D\u80FD\u8F38\u7D66\u4ED6\uFF01\\n\u8D70\uFF01\u6211\u5011\u5FEB\u5230\u4E0B\u4E00\u7AD9\uFF01[VAR 0114(0005)]"
