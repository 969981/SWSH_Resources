  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u51CD\u51DD\u6751\u96EA\u4E2D\u821E"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8C50\u9952\u4E4B\u738B\uFF34\u6064"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u4E0D\u77E5\u9053"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54E6\u2026\u2026\\n\u727D\u7D46\u97C1\u7E69\u662F\u55CE\uFF1F\\c\\n\u6709\u90A3\u500B\u6771\u897F\uFF0C\u7684\u78BA\u5C31\u80FD\\n\u8F15\u6613\u5730\u7E6B\u4F4F\u6715\u7684\u611B\u99AC\u2026\u2026\\c\\n\u4F46\u4EBA\u985E\u5DF2\u7D93\u4E0D\u518D\u737B\u4E0A\\n\u727D\u7D46\u97C1\u7E69\u7D66\u6715\u4E86\u3002\\c\\n\u4E8B\u5230\u5982\u4ECA\uFF0C\u5927\u6982\u7121\u6CD5\u5230\u624B\u4E86\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u54E6\u2026\u2026\\n\u51CD\u51DD\u6751\u96EA\u4E2D\u821E\u662F\u55CE\uFF1F\\c\\n\u5E7E\u5E74\u524D\u6715\u66FE\u898B\u904E\u6751\u5B50\u7684\u4EBA\u985E\\n\u8DF3\u8457\u5947\u7279\u7684\u821E\u8E48\u2026\u2026\\c\\n\u8981\u662F\u898B\u5230\u4E86\u90A3\u6A23\u7684\u666F\u8C61\uFF0C\\n\u53EA\u6015\u9023\uFF11\u96BB\u85CF\u98FD\u6817\u9F20\u4E5F\u90FD\u4E0D\u6703\u9760\u8FD1\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u54E6\u2026\u2026\\n\u756B\u6709\u6715\u7684\u5BB9\u8C8C\u7684\u8863\u88F3\u662F\u55CE\uFF1F\\c\\n\u96D6\u8AAA\u662F\u4EFF\u88FD\u54C1\uFF0C\\n\u4F46\u611B\u99AC\u90A3\u50A2\u4F19\u82E5\u662F\u77A7\u898B\u4E86\u6715\u7684\u5BB9\u8C8C\uFF0C\\r\\n\u5927\u6982\u5C31\u6703\u7ACB\u523B\u62D4\u817F\u9003\u8DD1\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u54E6\uFF01\u662F\u863F\u8514\u554A\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6C92\u932F\uFF0C\u6715\u8A18\u5F97\u90A3\u50A2\u4F19\\n\u4E00\u898B\u5230\u67D0\u7A2E\u8FB2\u4F5C\u7269\u5C31\u6703\u64B2\u4E0A\u53BB\uFF0C\\r\\n\u8B93\u6715\u7E3D\u662F\u5F97\u8CBB\u4E00\u756A\u529F\u592B\u53BB\u5B89\u64AB\u7260\u3002[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u73FE\u5728\u56DE\u60F3\u8D77\u4F86\uFF0C\\n\u539F\u4F86\u90A3\u6771\u897F\u5C31\u662F\u863F\u8514\u554A\uFF01\\r\\n\u4EBA\u985E\u7684\u5C0F\u5B69\u5152\u554A\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u679C\u7136\u4E0D\u7C21\u55AE\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u63A5\u4E0B\u4F86\u53EA\u8981\u6709\u863F\u8514\uFF0C\\n\u5C31\u80FD\u6210\u529F\u8A98\u51FA\u884C\u8E64\u4E0D\u660E\u7684\\r\\n\u6715\u7684\u611B\u99AC\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6751\u88E1\u7684\u4EBA\u985E\u662F\u5426\u6709\u5728\u7A2E\u863F\u8514\u5462\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\uFF11\u7C92\u7A2E\u5B50\uFF0C\\n\u90A3\u9EBC\u6715\u5C31\u80FD\u5920\u4F86\u57F9\u80B2\u863F\u8514\u4E86\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6751\u88E1\u7684\u4EBA\u985E\u662F\u5426\u6709\u5728\u7A2E\u863F\u8514\u5462\uFF1F\\c\\n\u53EA\u8981\u6709\uFF11\u7C92\u7A2E\u5B50\uFF0C\\n\u90A3\u9EBC\u6715\u5C31\u80FD\u5920\u4F86\u57F9\u80B2\u863F\u8514\u4E86\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u771F\u62B1\u6B49\u554A\uFF0C\\n\u73FE\u5728\u6751\u5B50\u88E1\u6C92\u6709\u5728\u7A2E\u863F\u8514\u3002"
