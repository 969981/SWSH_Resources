  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4EBA\u985E\u7684\u5C0F\u5B69\u5152\u554A\uFF0C\\n\u95DC\u65BC\u6715\u7684\u611B\u99AC\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u627E\u5230\u4EFB\u4F55\u6D88\u606F\u4E86\u55CE\uFF1F[VAR 0114(0079)]"
  },
