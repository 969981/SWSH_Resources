  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u611B\u99AC\u7260\\n\u559C\u6B61\u4EC0\u9EBC\u6771\u897F\u4E86\u554A\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8207\u7260\u76F8\u8655\u7684\u6642\u4EE3\u8DDD\u4ECA\u5BE6\u5728\u592A\u9059\u9060\uFF0C\\n\u6715\u5DF2\u4E0D\u5FA9\u8A18\u61B6\u4E86\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u82E5\u6709\u611B\u99AC\u7260\u559C\u6B61\u7684\u6771\u897F\uFF0C\\n\u8AAA\u4E0D\u5B9A\u5C31\u80FD\u8A98\u7260\u73FE\u8EAB\u4E86\uFF01\\r\\n\u8A71\u8AAA\uFF0C\u90A3\u6771\u897F\u7A76\u7ADF\u662F\u4EC0\u9EBC\u5462\uFF1F[VAR 0114(0079)]"
