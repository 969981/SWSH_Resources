  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u3001\u6211\u6C92\u4E8B\u2026\u2026\\n\u597D\u50CF\u6709\u4EC0\u9EBC\u6771\u897F\u6551\u4E86\u6211\u2026\u2026"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u9019\u4F4D\u89C0\u5149\u5BA2\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u62EF\u6551\u4E86\u6751\u88E1\u7684\u4EBA\uFF0C\\r\\n\u6211\u771F\u4E0D\u77E5\u9053\u8A72\u600E\u9EBC\u7B54\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u9019\u7247\u96EA\u539F\u4E0A\\n\u7ADF\u7136\u6709\u90A3\u9EBC\u51F6\u66B4\u7684\u5BF6\u53EF\u5922\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u7C21\u76F4\u5C31\u50CF\u662F\u7AE5\u8A71\u6545\u4E8B\u88E1\\n\u570B\u738B\u7684\u90A3\u96BB\u66B4\u8E81\u611B\u99AC\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u2026\u2026\u6211\u662F\u4E0D\u662F\u60F3\u592A\u591A\u4E86\uFF1F[VAR 0114(007A)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u54CE\u5440\uFF1F\u90A3\u662F\u2026\u2026\\n\u767D\u8272\u9B03\u6BDB\uFF1F[VAR 0114(007A)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u54CE\u5440\uFF1F\u90A3\u662F\u2026\u2026\\n\u9ED1\u8272\u9B03\u6BDB\uFF1F[VAR 0114(007A)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u7AE5\u8A71\u6545\u4E8B\u88E1\u8AAA\u5230\uFF0C\u53EA\u8981\u5C07\\n\u6C90\u6D74\u570B\u738B\u7684\u529B\u91CF\u800C\u7DBB\u653E\u7684[VAR FF00(0006)]\u5149\u8F1D\u4E4B\u82B1[VAR FF00(0000)]\uFF0C\\r\\n\u8207\u570B\u738B\u611B\u99AC\u7684\u9B03\u6BDB\u7E2B\u5408\u5728\u4E00\u8D77\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5C31\u80FD\u88FD\u6210\u9023\u7D50\u570B\u738B\u8207\u611B\u99AC\\n\u7684\u727D\u7D46\u97C1\u7E69\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u64DA\u8AAA\u6211\u7684\u7956\u5148\u5F9E\u524D\u4E5F\u66FE\u7D93\\n\u9075\u5FAA\u8457\u9019\u500B\u50B3\u8AAA\uFF0C\\r\\n\u88FD\u4F5C\u904E\u97C1\u7E69\u5462\u3002[VAR 0114(007A)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4E0D\u904E\u554A\uFF0C\u6211\u5F9E\u4F86\u6C92\u898B\u904E\u90A3\u7A2E\u82B1\u5152\uFF0C\\n\u88FD\u4F5C\u97C1\u7E69\u7684\u50B3\u7D71\u4E5F\u5DF2\u7D93\u6C92\u843D\u4E86\u3002[VAR 0114(007A)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u2026\u2026\u597D\u4E86\uFF01\u6211\u4E0D\u80FD\\n\u4E00\u76F4\u5728\u9019\u88E1\u804A\u8457\u7AE5\u8A71\u6545\u4E8B\uFF01[VAR 0114(007A)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6211\u5F97\u53BB\u60F3\u60F3\u5C0D\u7B56\uFF0C\\n\u4EE5\u514D\u90A3\u96BB\u5BF6\u53EF\u5922\u53C8\u5230\u6751\u88E1\u4F86\u6417\u4E82\u3002[VAR 0114(007A)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u6211\u5C31\u5148\u544A\u8FAD\u4E86\u3002\\n\u9019\u6B21\u771F\u7684\u662F\u592A\u611F\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u5566\u3002[VAR 0114(007A)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u5E74\u8F15\u4EBA\u2026\u2026\\n\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u6551\u4E86\u6751\u5B50\u54EA\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u90A3\u662F\u7AE5\u8A71\u6545\u4E8B\u88E1\u7684\u5BF6\u53EF\u5922\u55CE\uFF1F\\n\u770B\u8D77\u4F86\u5012\u662F\u633A\u50CF\u7684\u2026\u2026\uFF1F"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u78B0\u5DE7\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u5230\u6751\u5B50\u88E1\uFF0C\\n\u771F\u662F\u6551\u4E86\u5927\u5BB6\u4E00\u547D\u54EA\uFF01"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u7576\u90A3\u96BB\u66B4\u8E81\u7684\u5BF6\u53EF\u5922\u5FEB\u649E\u4E0A\u6211\u6642\uFF0C\\n\u597D\u50CF\u6709\u96BB\u6234\u738B\u51A0\u7684\u5BF6\u53EF\u5922\u6551\u4E86\u6211\u3002\\r\\n\u2026\u2026\u96E3\u9053\u9019\u662F\u932F\u89BA\u55CE\uFF1F"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u8B8A\u5B89\u975C\u4E86\u5462\u3002\\n\u6176\u5178\u5DF2\u7D93\u7D50\u675F\u4E86\u55CE\uFF1F"
