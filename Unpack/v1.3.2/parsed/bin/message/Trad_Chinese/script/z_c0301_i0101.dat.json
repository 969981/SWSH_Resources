[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6B61\u8FCE\u4F86\u5230\u502B\u5EA6\u7F85\u745F\u3002\\c\\n\u6211\u5011\u662F\u4E00\u9593\uFF15\u661F\u7D1A\u65C5\u9928\uFF0C\\n\u6DF1\u53D7\u4E16\u754C\u5404\u5730\u7684\u65C5\u5BA2\u559C\u611B\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u53EF\u662F\u5C08\u696D\u7684\u6AC3\u53F0\u4EBA\u54E1\uFF01\\n\u6240\u4EE5\u5373\u4F7F\u662F\u8A9E\u8A00\u4E0D\u901A\u7684\u5BF6\u53EF\u5922\u5011\uFF0C\\r\\n\u6211\u4E5F\u80FD\u5354\u52A9\u89E3\u6C7A\u7260\u5011\u7684\u9700\u6C42\u5537\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5C31\u7B97\u96D9\u817F\u5DF2\u7D93\u7AD9\u5230\u50F5\u4E86\u2026\u2026\\n\u4F46\u6211\u4E00\u6A23\u5168\u5929\u5019\u63D0\u4F9B\u5FAE\u7B11\u670D\u52D9\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9019\u6B21\u4E0D\u642D\u79C1\u4EBA\u5674\u5C04\u6A5F\uFF0C\\n\u6539\u6210\u8B93\u52C7\u58EB\u96C4\u9DF9\u8F09\u6211\u4F86\u4F3D\u52D2\u723E\uFF0C\\r\\n\u8AAA\u5BE6\u8A71\u771F\u662F\u7D2F\u58DE\u6211\u4E86\u2026\u2026\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u96D6\u7136\u6211\u592A\u592A\u5634\u5DF4\u4E0A\u8001\u662F\u5600\u5600\u5495\u5495\u7684\uFF0C\\n\u4F46\u6211\u77E5\u9053\u5979\u9084\u662F\u559C\u6B61\u548C\u5BF6\u53EF\u5922\u540C\u884C\u7684\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u662F\u53D7\u5230\u99AC\u6D1B\u79D1\u8499\u7684\u9080\u8ACB\uFF0C\\n\u4F86\u9019\u88E1\u770B\u6BD4\u8CFD\u7684\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9023\u540D\u6D41\u4E5F\u5728\u89C0\u8CDE\u7684\u6BD4\u8CFD\uFF0C\\n\u7D55\u5C0D\u6703\u5F15\u8D77\u66F4\u591A\u4EBA\u7684\u8208\u8DA3\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9580\u50EE\u7684\u5DE5\u4F5C\u53EF\u4E0D\u8F15\u9B06\uFF01\\c\\n\u5C31\u7B97\u6709\u518D\u591A\u7684\u4EBA\u9032\u9032\u51FA\u51FA\uFF0C\\n\u4E5F\u4E0D\u80FD\u51FA\u534A\u9EDE\u5DEE\u932F\uFF01\\r\\n\u9084\u597D\u5BF6\u53EF\u5922\u4E5F\u5E6B\u4E86\u6211\u5011\u5F88\u591A\u5FD9\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7FFB\uFF5E\u8FCE\uFF5E"
  }
]
