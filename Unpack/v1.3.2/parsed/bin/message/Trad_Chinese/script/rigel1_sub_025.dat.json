[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54CE\u554A\uFF0C[VAR 0100(0000)]\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u6B63\u5728\u76E1\u60C5\u4EAB\u53D7\\n\u93A7\u5CF6\u7684\u5927\u81EA\u7136\u55CE\uFF1F[VAR 0114(000E)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u5076\u723E\u4E5F\u6703\u5230\u9019\u88E1\u4F86\u3002\\n\u9019\u771F\u662F\u500B\u80FD\u8212\u5C55\u8EAB\u5FC3\u7684\u597D\u5730\u65B9\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u9019\u88E1\u5230\u8655\u90FD\u662F\u6C92\u7D93\u4EBA\u624B\u7684\u5927\u81EA\u7136\uFF0C\\n\u771F\u662F\u4E00\u5EA7\u597D\u68D2\u7684\u5CF6\u554A\u3002\\r\\n\u9023\u6211\u7684\u751C\u51B7\u7F8E\u540E\u90FD\u9AD8\u8208\u5F97\u4E0D\u5F97\u4E86\u5462\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9019\u7DA0\u6CB9\u6CB9\u3001\u6FC3\u5BC6\u5BC6\u7684\u6A39\u6797\uFF0C\\n\u592A\u9069\u5408\u4F5C\u68EE\u6797\u6D74\u4E86\uFF5E\\r\\n\u65E9\u77E5\u9053\u6211\u5C31\u5E36\u4FBF\u7576\u4F86\u56C9\u3002[VAR 0114(000E)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6BDB\u8FAE\u7F8A\u7260\u5168\u8EAB\\n\u90FD\u88AB\u84EC\u9B06\u7684\u9AD4\u6BDB\u5305\u8457\u2026\u2026\\c\\n\u5C31\u7B97\u662F\u5F9E\u9019\u6A23\u7684\u61F8\u5D16\u6454\u4E86\u4E0B\u53BB\uFF0C\\n\u4E5F\u4E00\u9EDE\u90FD\u4E0D\u6703\u53D7\u50B7\u5594\u3002[VAR 0114(000E)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u54C7\u554A\u554A\uFF01\u554A\u554A\uFF01\u554A\uFF01\u2026\u2026\uFF01\\c\\n\u5728\u6D1E\u7A9F\u88E1\u8072\u97F3\u6703\u4E00\u76F4\u8FF4\u97FF\uFF0C\\n\u8B93\u6211\u5FCD\u4E0D\u4F4F\u5C31\u60F3\u8981\u5927\u53EB\u4E00\u8072\u5462\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u597D\u5927\u3001\u597D\u85CD\u7684\u6D77\u554A\uFF01\\n\u8981\u662F\u9732\u7483\u5A1C\u5728\u9019\u88E1\uFF0C\\r\\n\u4E00\u5B9A\u6703\u5077\u5077\u5728\u5FC3\u88E1\u5927\u8072\u6B61\u547C\u5427\u3002[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u96D6\u7136\u5C0D\u8349\u5C6C\u6027\u5BF6\u53EF\u5922\u4F86\u8AAA\\n\u9019\u88E1\u662F\u5F88\u56B4\u82DB\u7684\u74B0\u5883\u2026\u2026\\c\\n\u4F46\u662F\uFF0C\u5728\u9019\u6A23\u7684\u5730\u65B9\\n\u9084\u662F\u6703\u6709\u690D\u7269\u767C\u82BD\u7684\u5594\u3002[VAR 0114(000E)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u65E5\u7167\u5F88\u5F37\u6642\uFF0C\u6709\u4E9B\u8349\u5C6C\u6027\u5BF6\u53EF\u5922\\n\u5C31\u6703\u8B8A\u5F97\u5E79\u52C1\u5341\u8DB3\u5462\uFF01\\c\\n\u50B7\u8166\u7B4B\u7684\u662F\uFF0C\u9023\u6B63\u597D\u662F\u8349\u5C6C\u6027\u5F31\u9EDE\u7684\\n\u706B\u5C6C\u6027\u5BF6\u53EF\u5922\u4E5F\u6703\u4E00\u8D77\u8B8A\u5F37\u2026\u2026[VAR 0114(000E)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5CF6\u4E0A\u7684\u5929\u6C23\u7E3D\u662F\u8AAA\u8B8A\u5C31\u8B8A\uFF01\\n\u9019\u7C21\u76F4\u5C31\u50CF\u662F\u5947\u5DF4\u7D0D\u7684\u6230\u8853\uFF0C\\r\\n\u8B93\u4EBA\u6709\u9EDE\u5FC3\u9A5A\u81BD\u8DF3\u5462\u3002[VAR 0114(000E)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5929\u964D\u7518\u9716\u54EA\uFF5E\uFF01\\n\u5927\u81EA\u7136\u5C31\u662F\u9019\u6A23\u5B50\\r\\n\u5E6B\u9019\u5EA7\u5CF6\u7684\u690D\u7269\u5011\u6F86\u6C34\u7684\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9019\u9802\u5E3D\u5B50\u96D6\u7136\u662F\u52D9\u8FB2\u7528\u7684\uFF0C\\n\u4F46\u662F\u5728\u9019\u7A2E\u5929\u6C23\u7684\u65E5\u5B50\uFF0C\\r\\n\u6216\u662F\u5728\u5C0D\u6230\u6642\u90FD\u975E\u5E38\u597D\u7528\u5594\u3002[VAR 0114(000E)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u54CE\u5440\uFF01[VAR 0100(0000)]\uFF0C\\n\u8981\u662F\u5728\u9727\u6FDB\u6FDB\u88E1\u5230\u8655\u4E82\u8DD1\uFF0C\\r\\n\u662F\u6703\u649E\u5230\u6211\uFF0C\u7136\u5F8C\u88AB\u5F48\u98DB\u7684\u5594\u3002[VAR 0114(000E)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u7F8E\u540E\u540E\u540E\uFF5E"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54CE\u5440\uFF0C\u51A0\u8ECD\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7279\u5730\u4F86\u898B\u6211\u55CE\uFF1F[VAR 0114(000F)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5225\u5728\u610F\uFF0C\u6211\u958B\u73A9\u7B11\u7684\u3002\\c\\n\u73FE\u5728\u9053\u9928\u548C\u6A21\u7279\u5152\u7684\u5DE5\u4F5C\u90FD\u5728\u653E\u5047\uFF0C\\n\u6240\u4EE5\u6211\u6B63\u5728\u7422\u78E8\u62DB\u5F0F\u5462\u3002[VAR 0114(000F)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9019\u4E00\u671B\u7121\u969B\u7684\u5927\u81EA\u7136\uFF0C\\n\u60F3\u5FC5\u6703\u8B93\u4E9E\u6D1B\u5F88\u958B\u5FC3\u5427\u3002[VAR 0114(000F)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u9019\u5EA7\u68EE\u6797\uFF0C\u5728\u4E0B\u8D77\u96E8\u4F86\u6642\\n\u6703\u6709\u4EE4\u4EBA\u5F88\u8212\u670D\u7684\u6C34\u8072\u5594\u3002\\c\\n\u6BD4\u5982\u5728\u8F38\u4E86\u5C0D\u6230\u7684\u6642\u5019\uFF0C\\n\u90A3\u8072\u97F3\u771F\u662F\u80FD\u8B93\u4EBA\u8F49\u63DB\u5FC3\u60C5\u5462\u3002[VAR 0114(000F)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u9019\u88E1\u5439\u8457\u597D\u68D2\u7684\u98A8\uFF0C\\n\u8B93\u4EBA\u5FC3\u90FD\u8F15\u4E86\u8D77\u4F86\u3002\\c\\n\u5728\u9019\u6A23\u7684\u65E5\u5B50\uFF0C\\n\u8AAA\u4E0D\u5B9A\u9577\u7FC5\u9DD7\u6703\u9001\u4FE1\u4F86\u5594\u3002[VAR 0114(000F)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u7E7C\u7E8C\u5411\u524D\u53BB\uFF0C\\n\u5C31\u53EF\u4EE5\u901A\u5230\u5927\u6D77\u5594\u3002\\c\\n\u90A3\u88E1\u9084\u53EF\u4EE5\u770B\u5230\u5C0F\u5C0F\u7684\u5CF6\uFF0C\\n\u662F\u6211\u5F88\u559C\u6B61\u7684\u666F\u9EDE\u5462\u3002[VAR 0114(000F)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u9019\u6D77\u770B\u8D77\u4F86\u771F\u8212\u670D\u2026\u2026\\n\u5982\u679C\u6E38\u5230\u90A3\u908A\u7684\u5CF6\u2026\u2026\\r\\n\u4E0D\u77E5\u9053\u6703\u9700\u8981\u5E7E\u79D2\u5462\uFF1F[VAR 0114(000F)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u6B63\u5728\u548C\u66B4\u566C\u9F9C\u7279\u8A13\u5462\u3002\\n\u5373\u4F7F\u662F\u4E7E\u71E5\u900F\u9802\u7684\u6C99\u6F20\uFF0C\\r\\n\u6211\u5011\u4E5F\u8981\u7528\u62DB\u5F0F\u8B93\u5B83\u6FD5\u6F64\u8D77\u4F86\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u9019\u7A2E\u597D\u5929\u6C23\uFF0C\u5C31\u662F\u8981\u6E38\u6CF3\u554A\uFF01\\c\\n\u6C34\u821F\u7AF6\u6280\u5834\u7684\u7AF6\u6280\u670D\\n\u53EF\u4EE5\u7576\u4F5C\u6CF3\u8863\u7A7F\uFF0C\\r\\n\u6240\u4EE5\u6211\u53EF\u4EE5\u76F4\u63A5\u8DF3\u9032\u6C34\u88E1\u6E38\u6CF3\u5594\u3002[VAR 0114(000F)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5929\u6C23\u662F\u6674\u5929\u6216\u662F\u9670\u5929\uFF0C\\n\u90FD\u662F\u4F9D\u7167\u96F2\u5728\u5929\u7A7A\u4E0A\\r\\n\u6240\u5360\u7684\u6BD4\u4F8B\u4F86\u6C7A\u5B9A\u7684\u5594\u3002\\c\\n\u4ECA\u5929\u6709\uFF19\u6210\u4EE5\u4E0A\u7684\u5929\u7A7A\\n\u88AB\u96F2\u6735\u906E\u4F4F\u4E86\uFF0C\u6240\u4EE5\u662F\u9670\u5929\u3002[VAR 0114(000F)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u96D6\u7136\u4E0B\u96E8\u5929\u5E38\u5E38\u88AB\u4EBA\u5ACC\uFF0C\\n\u4F46\u662F\u6C34\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\u53EF\u9AD8\u8208\u4E86\u5462\u3002\\c\\n\u300C\u597D\u5929\u6C23\u300D\u7684\u5B9A\u7FA9\u4E0D\u53EA\u662F\u56E0\u4EBA\u800C\u7570\uFF0C\\n\u5C0D\u5BF6\u53EF\u5922\u4E5F\u662F\u5404\u6709\u4E0D\u540C\u7684\u5594\u3002[VAR 0114(000F)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u66B4\u566C\u9F9C\u517C\u5177\u5CA9\u77F3\u5C6C\u6027\u5462\u3002\\c\\n\u6240\u4EE5\u7576\u98B3\u8D77\u6C99\u66B4\u6642\uFF0C\\n\u7260\u5C0D\u7279\u6B8A\u62DB\u5F0F\u7684\u9632\u79A6\u529B\u6703\u8B8A\u5F37\u5594\u3002[VAR 0114(000F)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u71C8\u5854\u7684\u5149\uFF0C\\n\u7167\u5728\u6F06\u9ED1\u7684\u6D77\u4E0A\u2026\u2026\\c\\n\u9019\u90FD\u662F\u70BA\u4E86\u4FDD\u8B77\u8239\u96BB\\n\u4E0D\u8981\u5728\u6FC3\u6FC3\u7684\u9727\u88E1\u8FF7\u5931\u65B9\u5411\u5594\u3002\\r\\n\u6C34\u821F\u93AE\u4E5F\u6709\u4E00\u5EA7\u71C8\u5854\uFF0C\u4E0D\u662F\u55CE\uFF1F[VAR 0114(000F)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u66B4\u566C\u66B4\u566C\u66B4\u566C\u2026\u2026"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u51A0\u8ECD[VAR 0100(0000)]\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u5230\u93A7\u5CF6\u4E5F\u9084\u5728\u8A13\u7DF4\uFF0C\\n\u9019\u9B25\u5FD7\u771F\u662F\u706B\u71B1\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u70BA\u4E86\u4E0D\u8981\u88AB[VAR 1100(00FF,0101)]\u4F60\u59B3\u7529\u5728\u5F8C\u982D\uFF0C\\n\u6211\u4E5F\u6703\u7E7C\u7E8C\u5411\u524D\u5954\u8DD1\u7684\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u711A\u7130\u86A3\u71D2\u71D9\u7684\u8EAB\u9AD4\uFF0C\\n\u6709\u6642\u5019\u6703\u8B93\u8349\u53E2\u8D77\u706B\uFF01\\c\\n\u9019\u7A2E\u6642\u5019\u6211\u5C31\u6703\u62FF\u51FA\\n\u6E96\u5099\u597D\u7684\u6C34\u58FA\uFF0C\u8D95\u7DCA\u6F86\u6C34\u7184\u706B\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u4E00\u822C\u4F86\u8AAA\uFF0C\\n\u68EE\u6797\u88E1\u4F4F\u7684\u5927\u591A\u662F\\r\\n\u8349\u5C6C\u6027\u6216\u87F2\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\uFF01\\c\\n\u9019\u6642\u8EAB\u908A\u6709\u96BB\u706B\u5C6C\u6027\u7684\u711A\u7130\u86A3\uFF0C\\n\u5C31\u6703\u89BA\u5F97\u5F88\u53EF\u9760\u5462\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u9577\u9577\u7684\u6A13\u68AF\\n\u6B63\u9069\u5408\u4F86\u8DD1\u6B65\u7DF4\u8173\u529B\uFF01\\c\\n\u6211\u4E00\u6642\u8208\u8D77\u5C31\u4F86\u56DE\u8DD1\u4E86\uFF11\uFF10\uFF10\u8D9F\uFF0C\\n\u73FE\u5728\u4E0D\u5F97\u4E0D\u5598\u53E3\u6C23\u4F11\u606F\u4E00\u4E0B\u56C9\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u9019\u88E1\u548C\u7B2C\u4E8C\u7926\u5C71\u4E00\u6A23\\n\u6709\u5F88\u591A\u6C34\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\uFF01\\r\\n\u5C0D\u6211\u4F86\u8AAA\u6703\u662F\u5F88\u597D\u7684\u8A13\u7DF4\u5462\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u5728\u6D77\u908A\u7684\u8A13\u7DF4\\n\u5C0D\u6211\u5BB6\u7684\u5B69\u5B50\u5011\u4F86\u8AAA\u662F\u592A\u56B4\u82DB\u4E86\uFF01\\c\\n\u6211\u6703\u4EE3\u66FF\u711A\u7130\u86A3\u591A\u6E38\u4E9B\u6CF3\uFF0C\\n\u597D\u597D\u935B\u934A\u4E00\u756A\u7684\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u6211\u662F\u5728\u934B\u5E95\u6C99\u6F20\\n\u548C\u6211\u7684\u7164\u70AD\u9F9C\u76F8\u9047\u7684\uFF01\\c\\n\u56E0\u70BA\u7260\u7684\u7279\u6027\u53EF\u4EE5\u6539\u8B8A\u5929\u6C23\uFF0C\\n\u6211\u5C31\u628A\u7260\u4ECB\u7D39\u7D66\u4E86\u5947\u5DF4\u7D0D\u3002\u5F8C\u4F86\u2026\u2026\\r\\n\u5225\u4EBA\u662F\u649E\u886B\uFF0C\u6211\u5006\u537B\u662F\u649E\u5BF6\u53EF\u5922\u56C9\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u9019\u9EBC\u548C\u7166\u7684\u5929\u6C23\uFF0C\\n\u8A13\u7DF4\u8D77\u4F86\u7279\u5225\u9806\u5229\u5462\uFF01\\r\\n\u4E00\uFF01\u4E8C\uFF01\u4E00\uFF01\u4E8C\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u96D6\u8AAA\u662F\u9670\u5929\uFF0C\\n\u9084\u662F\u6703\u6709\u7D2B\u5916\u7DDA\u7684\uFF01\\c\\n\u5225\u5FD8\u4E86\u6234\u4E0A\u5E3D\u5B50\u3001\u505A\u597D\u9632\u66EC\uFF0C\\n\u9084\u8981\u52E4\u88DC\u6C34\u5206\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u4E00\u4E0B\u8D77\u96E8\uFF0C\\n\u548C\u706B\u7130\u6709\u95DC\u7684\u62DB\u5F0F\u5C31\u6703\u8B8A\u5F31\u4E86\u3002\\c\\n\u9019\u6642\u5019\u5C31\u8981\u7528\u5927\u6674\u5929\u6216\u6975\u5DE8\u706B\u7206\\n\u628A\u5929\u4E0A\u7684\u96E8\u96F2\u5168\u90FD\u6D88\u6563\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 39,
    "flags": 0,
