[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5BAE\u9580\u5E02\u771F\u7684\u5F88\u5927\uFF5E\\n\u6240\u4EE5\u642D\u55AE\u8ECC\u5217\u8ECA\u6216\u662F\\r\\n\u642D\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u6BD4\u8F03\u65B9\u4FBF\u5594\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "[~ 1]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "[~ 2]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6709\u5F88\u591A\u65C5\u5BA2\u6703\u4F86\u5BAE\u9580\u5E02\u73A9\uFF0C\\n\u6240\u4EE5\u6599\u7406\u53E3\u5473\u4E5F\u6703\u914D\u5408\u505A\u8ABF\u6574\u7684\uFF5E"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5728\u7AF6\u6280\u5834\u6703\u770B\u6BD4\u8CFD\u770B\u5230\u5165\u8FF7\uFF0C\\n\u751A\u81F3\u5FD8\u4E86\u8981\u5403\u98EF\u7684\uFF5E"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u60F3\u597D\u597D\u773A\u671B\u4E00\u4E0B\u6574\u500B\u4F3D\u52D2\u723E\u5730\u5340\uFF01\\n\u6469\u5929\u8F2A\u61C9\u8A72\u662F\u6700\u597D\u7684\u9078\u64C7\u5427\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6469\u5929\u8F2A\u2026\u2026\\n\u9AD8\u7684\u5730\u65B9\u6211\u6703\u5687\u5F97\u817F\u8EDF\u554A\uFF5E"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u539F\u4F86\u5982\u6B64\uFF5E\u4E0D\u642D\u55AE\u8ECC\u5217\u8ECA\u7684\u8A71\uFF0C\\n\u5C31\u53BB\u4E0D\u4E86\u6D1B\u8332\u5927\u5EC8\u4E86\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6709\u4E9B\u5BF6\u53EF\u5922\u7279\u5225\u559C\u6B61\u9435\u8ECC\uFF0C\\n\u6240\u4EE5\u6709\u6642\u5019\u4E5F\u6703\u767C\u751F\u4E00\u4E9B\u6709\u610F\u601D\u7684\u9EBB\u7169\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5BAE\u9580\u5E02\u77E5\u540D\u7279\u8272\u2015\u2015\\n\u55AE\u8ECC\u5217\u8ECA\u7684\u6708\u53F0\u5728\u9019\u88E1\uFF01\\c\\n\u9019\u689D\u55AE\u8ECC\u53EF\u662F\u6703\u74B0\u7E5E\u8457\\n\u6574\u500B\u5BAE\u9580\u5E02\u8DD1\u5594\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u55F6\u5440\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u7684\u5BF6\u53EF\u5922\u5011\\n\u6C92\u6709\u97F3\u6A02\u5C31\u6D3B\u4E0D\u4E0B\u53BB\uFF01\\c\\n\u7260\u5011\u807D\u5230\u9177\u70AB\u7684\u65CB\u5F8B\uFF0C\\n\u5C31\u6703\u8208\u596E\u5F97\u4E00\u6E9C\u7159\u5730\u885D\u904E\u53BB\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5431\u5630\uFF01"
  },
  {
    "index": 13,
