  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8981\u5982\u4F55\u5B8C\u6210\u4EFB\u52D9\uFF1F"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u60F3\u9000\u51FA"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6C92\u4EC0\u9EBC"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8ACB\u4E00\u908A\u56DE\u7B54\u8B0E\u984C\uFF0C\\n\u4E00\u908A\u6253\u8D0F\u9053\u9928\u8A13\u7DF4\u5BB6\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4E00\u65E6\u4E2D\u9014\u9000\u51FA\u5F8C\uFF0C\\n\u4E0B\u6B21\u5C31\u5FC5\u9808\u91CD\u65B0\u958B\u59CB\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u78BA\u5B9A\u8981\u9000\u51FA\u55CE\uFF1F"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6B61\u8FCE\u96A8\u6642\u518D\u4F86\u6311\u6230\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u653E\u624B\u53BB\u6311\u6230\u5427\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u9053\u9928\u4EFB\u52D9\\n\u6311\u6230\u5F97\u9084\u958B\u5FC3\u55CE\uFF1F"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6F02\u4EAE\u5730\u5B8C\u6210\u4E86\u9053\u9928\u4EFB\u52D9\uFF01\\c\\n\u771F\u597D\u5947\u9053\u9928\u9928\u4E3B\u6703\\n\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0B\u4EC0\u9EBC\u6A23\u7684\u8A55\u8AD6\u5462\uFF01\\c\\n[VAR 0100(0000)]\u9078\u624B\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u76F4\u63A5\u6311\u6230\u9053\u9928\u9928\u4E3B\u55CE\uFF1F"
  },
