  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u8ACB\u7B49\u4E00\u4E0B"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u597D\u7684\uFF01\u8ACB\u524D\u9032\u5427\uFF01\\n\u4E5F\u5E6B\u6211\u5411\u9053\u9928\u9928\u4E3B\u554F\u5019\u4E00\u8072\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4E5F\u662F\uFF0C\u7E3D\u662F\u9700\u8981\u5BEB\u500B\u7D00\u9304\uFF0C\\n\u597D\u597D\u6E96\u5099\u4E00\u756A\u7684\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7A76\u7ADF\u9069\u4E0D\u9069\u5408\u7576\u4E0A\\n\u5996\u7CBE\u5C6C\u6027\u9053\u9928\u7684\u9928\u4E3B\u5462\uFF1F\\r\\n\u4F86\u5427\uFF0C\u8B93\u6211\u8003\u8003[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u539F\u4F86\u5982\u6B64\u2026\u2026\\n\u96D6\u7136\u6211\u4E0D\u77E5\u9053\u6CE2\u666E\u83C8\u6703\u600E\u9EBC\u60F3\uFF0C\\r\\n\u4F46\u6211\u500B\u4EBA\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u9084\u7B97\u6EFF\u610F\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6211\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u7B2C\uFF12\u500B\u5C0D\u624B\u3002\\c\\n\u5225\u592A\u5728\u610F\u525B\u624D\u7684\u7B54\u984C\u6210\u7E3E\uFF0C\\n\u4F86\u4F86\u4F86\uFF0C\u6211\u5011\u8D95\u7DCA\u5C0D\u6230\u5427\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u7B54\u5C0D\uFF0C\u7B54\u932F\uFF0C\u90FD\u5225\u5728\u610F\u3002\\n\u5FEB\u5FEB\u5FEB\uFF0C\u8D95\u7DCA\u7E7C\u7E8C\u5427\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u63A5\u4E0B\u4F86\u5C31\u662F\u6211\u56C9\u3002\\c\\n\u4E5F\u8A31[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u7684\u80FD\u7576\u4E0A\\n\u5996\u7CBE\u5C6C\u6027\u7684\u9053\u9928\u9928\u4E3B\u5462\u3002"
