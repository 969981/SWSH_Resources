  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u9053\u9928\u4EFB\u52D9\u8981\u958B\u59CB\u4E86\uFF01\\n\u76E1\u60C5\u5C55\u73FE[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BE6\u529B\u5427\uFF01"
  },
