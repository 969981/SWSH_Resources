  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5176\u5BE6\uFF0C\u91CD\u9EDE\u5C31\u5728\u65BC\\n\u5982\u4F55\u4F7F\u7528[VAR 1100(00FF,0101)]\u4F60\u59B3\u624B\u4E2D\u7684\u9677\u9631\u63A2\u6E2C\u6A5F\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9019\u5EA7\u9053\u9928\u5230\u8655\u90FD\u6709\u9677\u9631\uFF0C\\n\u4E5F\u5C31\u662F\u770B\u4E0D\u898B\u7684\u5751\u6D1E\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6389\u9032\u4E86\u5751\u88E1\uFF0C\\n\u5C31\u5FC5\u9808\u5F9E\u73FE\u5728\u9019\u500B\u4F4D\u7F6E\u91CD\u65B0\u6311\u6230\u3002\\c\\n\u7576[VAR 1100(00FF,0101)]\u4F60\u59B3\u9762\u5411\u5751\u6D1E\u6642\uFF0C\u63A2\u6E2C\u6A5F\u5C31\u6703\u9707\u52D5\u3002\\n\u800C\u4E14\u7576[VAR 1100(00FF,0101)]\u4F60\u59B3\u8D8A\u9760\u8FD1\u5751\u6D1E\uFF0C\\r\\n\u5B83\u5C31\u6703\u9707\u52D5\u5F97\u8D8A\u53B2\u5BB3\u5594\u3002"
