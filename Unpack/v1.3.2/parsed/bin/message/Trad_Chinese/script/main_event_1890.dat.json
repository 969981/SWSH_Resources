    "text": "\u4EC0\u9EBC\u554A\u2026\u2026\u600E\u9EBC\u6703\u9019\u6A23\uFF01\\n\u9019\u4E0B\u8981\u600E\u9EBC\u53BB\u5E6B\u5927\u54E5\u2026\u2026\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9019\u4F4D\u9053\u9928\u6311\u6230\u8005\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u505A\u4EC0\u9EBC\u5462\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u8981\u963B\u6B62\u95C7\u591C\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u8981\u5E6B\u51A0\u8ECD\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54C7\u54E6\uFF5E\uFF01\u771F\u662F\u9A5A\u4EBA\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u5728\u8AAA\u5922\u8A71\u55CE\uFF1F\\c\\n\u5DF2\u7D93\u4E0D\u52DE[VAR 1100(00FF,0101)]\u4F60\u59B3\u51FA\u529B\u963B\u6B62\u4E86\u3002\\c\\n\u95C7\u591C\u2026\u2026\u4E0D\uFF0C\\n\u6700\u5F37\u7684\u5BF6\u53EF\u5922\u2026\u2026\\r\\n\u7121\u6975\u6C70\u90A3\u5DF2\u7D93\u89BA\u9192\u4E86\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u9019\u53EF\u4E0D\u884C\u54EA\uFF01\\c\\n\u6211\u9700\u8981\u51A0\u8ECD\u4F86\u99D5\u99AD\u7121\u6975\u6C70\u90A3\u5462\u3002[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5148\u807D\u6211\u8AAA\u5427\u3002\\c\\n\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u773C\u88E1\u770B\u4F86\uFF0C\\n\u4E5F\u8A31\u6211\u6B63\u5728\u505A\u4E00\u4E9B\u5F88\u8352\u5510\u7684\u4E8B\u3002\\r\\n\u6211\u731C[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u4E00\u9EDE\u90FD\u7121\u6CD5\u4E86\u89E3\u6211\u5427\u3002\\c\\n\u4F46\u662F\uFF0C\u70BA\u4E86\u8B93\u4EBA\u5011\u5B89\u5C45\u6A02\u696D\uFF0C\\n\u70BA\u4E86\u8B93\u4F3D\u52D2\u723E\u5730\u5340\u9577\u76DB\u4E0D\u8870\uFF0C\\r\\n\u6211\u6709\u4F7F\u547D\u548C\u4FE1\u5FF5\uFF0C\\r\\n\u8981\u70BA\u9019\u584A\u571F\u5730\u5E36\u4F86\u7121\u76E1\u7684\u80FD\u6E90\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4E5F\u6B63\u56E0\u6B64\uFF0C\u6211\u624D\u6703\u4E00\u76F4\u628A\\n\u8A31\u9858\u661F\u4F9B\u61C9\u7D66\u7121\u6975\u6C70\u90A3\u554A\uFF01\\c\\n\u5C0D\u4E86\uFF0C\u5728\u62F3\u95DC\u5E02\u767C\u751F\u7684\u90A3\u5834\u7D05\u5149\u9A37\u52D5\u2026\u2026\\c\\n\u90A3\u4E5F\u662F\u70BA\u4E86\u559A\u9192\u7121\u6975\u6C70\u90A3\u7684\u5C0F\u5BE6\u9A57\uFF01\\c\\n\u807D\u597D\u56C9\uFF01\u9019\u4E00\u5207\uFF0C\\n\u90FD\u662F\u70BA\u4E86\u4FDD\u8B77\u4F3D\u52D2\u723E\u7684\u672A\u4F86\uFF01\\r\\n\u6211\u4E0D\u6703\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u58DE\u4E86\u6211\u7684\u8A08\u756B\u7684\uFF01[VAR 0114(0006)]"
  }
]
