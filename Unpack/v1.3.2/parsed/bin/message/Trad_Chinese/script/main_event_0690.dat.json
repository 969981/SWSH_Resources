    "text": "[VAR 0100(0000)]\uFF01\\n\u6211\u5011\u4F86\u6176\u795D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u52DD\u5229\u5427\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54CE\u5440\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u88AB\u9080\u8ACB\u4E86\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u5011\u5F7C\u6B64\u8A8D\u8B58\uFF1F\u592A\u597D\u4E86\uFF01\\n\u4F86\u4F86\uFF0C\u5FEB\u5750\u4E0B\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6C34\u821F\u93AE\u4EE5\u6D77\u7522\u805E\u540D\u3002\\c\\n\u6D77\u9BAE\u5C31\u662F\u8981\u5403\u7576\u5730\u73FE\u6488\u7684\uFF0C\\n\u624D\u6700\u5C0D\u5473\u5440\uFF01\\r\\n\u9019\u9910\u5EF3\u7684\u6BCF\u9053\u83DC\u90FD\u975E\u5E38\u7F8E\u5473\u5537\u3002[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF0C\u6728\u862D\u535A\u58EB\u6700\u8FD1\u90FD\u597D\u55CE\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u771F\u662F\u8981\u611F\u8B1D\u535A\u58EB\u7684\u5354\u52A9\u5462\uFF01\\c\\n\u591A\u8667\u6709\u5979\u7684\u7814\u7A76\uFF0C\\n\u6211\u5011\u624D\u80FD\u5229\u7528\u8A31\u9858\u661F\u860A\u85CF\u7684\u80FD\u91CF\uFF0C\\r\\n\u88FD\u9020\u51FA\u80FD\u4F7F\u5BF6\u53EF\u5922\u8B8A\u5DE8\u5927\u7684\u6975\u5DE8\u8155\u5E36\u3002[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u554A\u2026\u2026\u4F46\u535A\u58EB\u8AAA\u904E\uFF0C\\n\u6975\u5DE8\u5316\u9084\u6709\u8A31\u591A\u4E8B\u6709\u5F85\u91D0\u6E05\uFF0C\\r\\n\u56E0\u6B64\u5979\u5C0D\u6975\u5DE8\u5316\u6709\u4E9B\u7591\u616E\u4E0D\u5B89\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u9019\u8D9F\u8981\u51FA\u767C\u6642\uFF0C\u5979\u751A\u81F3\\n\u8981\u6211\u5E36\u4E0A\u80FD\u91CF\u9EDE\u5075\u6E2C\u5668\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u80FD\u91CF\u9EDE\u5075\u6E2C\u5668\uFF01\\c\\n\u591A\u8667\u6709\u9019\u6771\u897F\uFF0C\\n\u6211\u5011\u624D\u80FD\u767C\u73FE\u80FD\u91CF\u9EDE\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u6709\u4F3D\u52D2\u723E\u7C92\u5B50\u51FA\u73FE\uFF0C\\r\\n\u4E26\u4E14\u80FD\u5920\u4F7F\u7528\u6975\u5DE8\u5316\u7684\u5730\u65B9\u5537\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u6211\u4E0D\u5E0C\u671B\\n\u8B93\u6728\u862D\u535A\u58EB\u611F\u5230\u4E0D\u5B89\u3002\\c\\n\u6211\u80FD\u51FA\u9EDE\u4EC0\u9EBC\u529B\u5462\u2026\u2026\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9E\uFF0C\u59B3\u53BB\u4E00\u8D9F\u62F3\u95DC\u5E02\uFF0C\\n\u5230\u5BF6\u7269\u5EAB\u77A7\u77A7\u5427\u3002\\c\\n\u6211\u8A8D\u70BA\uFF0C\\n\u89E3\u958B\u6975\u5DE8\u5316\u4E4B\u8B0E\u7684\u9470\u5319\u2026\u2026\\r\\n\u5C31\u85CF\u5728\u6B77\u53F2\u4E4B\u4E2D\u3002[VAR 0114(0006)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\u7684\uFF0C\u6211\u6703\u5B89\u6392\u597D\u4E00\u5207\uFF0C\\n\u8B93\u7D22\u59AE\u4E9E\u5C0F\u59D0\u9806\u5229\u53C3\u89C0\u5BF6\u7269\u5EAB\u7684\u3002[VAR 0114(0007)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\u904E\uFF0C\u6703\u9577\uFF0C\\n\u60A8\u8A72\u524D\u5F80\u4E0B\u4E00\u500B\u884C\u7A0B\u4E86\u3002[VAR 0114(0007)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4EC0\u9EBC\uFF5E\uFF1F\u6211\u90FD\u9084\u6C92\\n\u548C[VAR 0100(0000)]\u804A\u5230\u5929\u5462\u2026\u2026\\c\\n\u5509\uFF0C\u96D6\u7136\u4E0D\u6368\uFF0C\u4F46\u9019\u4E5F\u6C92\u8FA6\u6CD5\u3002\\n\u7562\u7ADF\u6709\u4E9B\u4E8B\u60C5\u662F\u5FC5\u9808\u7ACB\u523B\u8655\u7406\u7684\uFF01\\r\\n\u5404\u4F4D\uFF0C\u5F8C\u6703\u6709\u671F\u5537\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5509\u2026\u2026\\n\u9019\u662F\u5728\u8CE3\u6211\u4EBA\u60C5\u55CE\uFF1F\\c\\n\u4E0D\u904E\uFF0C\u5BF6\u7269\u5EAB\u7684\u78BA\u662F\u500B\\n\u8ABF\u67E5\u50B3\u8AAA\u7684\u597D\u5730\u65B9\u3002[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u5230\u6C34\u4E4B\u5FBD\u7AE0\u4E86\u3002\\n\u80FD\u6253\u8D0F\u9732\u7483\u5A1C\uFF0C\u771F\u7684\u4E0D\u7C21\u55AE\u5462\uFF01\\r\\n\u6211\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u500B\u62DB\u5F0F\u5B78\u7FD2\u5668\u7576\u4F5C\u734E\u52F5\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9732\u7483\u5A1C\u662F\u6211\u7684\u670B\u53CB\u3002\\n\u6211\u9084\u662F\u53BB\u8DDF\u5979\u6253\u8072\u62DB\u547C\u5427\u3002\\c\\n\u518D\u898B\u56C9\uFF0C\u9053\u9928\u6311\u6230\u8005\uFF01[VAR 0114(000B)]"
  }
]
