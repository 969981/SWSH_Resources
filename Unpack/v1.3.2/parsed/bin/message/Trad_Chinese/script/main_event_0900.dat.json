  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5BF6\u7269\u5EAB\u5BE6\u5728\u662F\u592A\u68D2\u4E86\uFF01\\c\\n\u9019\u88E1\u7ADF\u7136\u4FDD\u7559\u8457\\n\u63CF\u8FF0\u4F3D\u52D2\u723E\u6B77\u53F2\u7684\u58C1\u6BEF\u5462\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u770B\u898B\u8A31\u9858\u661F\u7684\u5169\u500B\u5E74\u8F15\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u707D\u5384\u964D\u81E8\u2026\u2026\\n\u898B\u72C0\u800C\u4E0D\u77E5\u6240\u63AA\u7684\u5E74\u8F15\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u770B\u8457\u528D\u8207\u76FE\u5728\u9A45\u6563\u707D\u5384\u7684\u5E74\u8F15\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u982D\u6234\u738B\u51A0\u7684\u5E74\u8F15\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9019\u58C1\u6BEF\u4E0A\u63CF\u7E6A\u7684\u662F\\n\u4F3D\u52D2\u723E\u7684\u738B\u570B\u8A95\u751F\u6642\u7684\u6545\u4E8B\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u8AAA\uFF0C\u5E74\u8F15\u7684\u9053\u9928\u6311\u6230\u8005\u5440\uFF0C\\n\u770B\u4E86\u9019\u4E9B\u58C1\u6BEF\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u4EC0\u9EBC\u5728\u610F\u7684\u5730\u65B9\u55CE\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u82F1\u96C4\u662F\u5169\u500B\u4EBA\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u95C7\u591C\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u679C\u7136\u4E0D\u7C21\u55AE\uFF01\\c\\n\u6C92\u932F\uFF0C\u6A5F\u64CE\u5E02\u7684\u65C5\u5E97\u88E1\\n\u600E\u9EBC\u770B\u90FD\u53EA\u6709\u4E00\u5C0A\u82F1\u96C4\u96D5\u50CF\u3002\\c\\n\u4F46\u662F\uFF0C\u9019\u58C1\u6BEF\u4E0A\u537B\u6709\u5169\u500B\u5E74\u8F15\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6C92\u932F\uFF01\u6211\u4E5F\u9019\u9EBC\u89BA\u5F97\uFF01\\c\\n\u90A3\u7C60\u7F69\u5929\u7A7A\u7684\u9ED1\u8272\u6F29\u6E26\\n\u5728\u9019\u88E1\u88AB\u7A31\u70BA\u707D\u5384\u2026\u2026\\r\\n\u6C92\u932F\uFF0C\u9019\u5C31\u662F\u95C7\u591C\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u82F1\u96C4\u7A76\u7ADF\u662F\u4E00\u500B\u4EBA\uFF0C\\n\u9084\u662F\u5169\u500B\u4EBA\u2026\u2026\uFF1F\\r\\n\u6240\u8B02\u7684\u95C7\u591C\uFF0C\u53C8\u662F\u4EC0\u9EBC\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u966A\u6211\u8AAA\u8A71\u3002\\n\u6211\u7406\u6E05\u601D\u8DEF\u4E86\u3002\\c\\n\u6211\u9084\u8981\u5728\u9019\u88E1\u7814\u7A76\u4E00\u4E0B\u58C1\u6BEF\uFF0C\\n\u4F46\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A72\u53BB\u6311\u6230\u9053\u9928\u4E86\u5427\uFF1F\\c\\n\u9019\u662F\u6211\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u52A0\u6CB9\u7684\u5FC3\u610F\u3002\\n\u6211\u5F88\u671F\u5F85[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u8DEF\u6230\u52DD\u5230\u5E95\u5594\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u9A45\u6563\u4E86\u707D\u5384\u7684\u528D\u8207\u76FE\\n\u73FE\u5728\u662F\u5728\u54EA\u88E1\u5462\uFF1F[VAR 0114(000B)]"
  }
