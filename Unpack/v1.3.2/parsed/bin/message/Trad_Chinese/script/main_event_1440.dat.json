    "text": "\u55E8\uFF0C[VAR 0100(0000)]\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6F02\u4EAE\u5730\u6253\u8D0F\u4E86\u5947\u5DF4\u7D0D\uFF0C\\r\\n\u5B8C\u6210\u9053\u9928\u6311\u6230\u4E86\uFF01\\r\\n\u6211\u5F9E\u5FC3\u5E95\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u96D6\u7136\u5F88\u60F3\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u597D\u6176\u795D\u4E00\u756A\uFF0C\\n\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u9084\u662F\u5148\u807D\u4E00\u4E0B\u9019\u4EF6\u6B63\u4E8B\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u51FA\u73FE\u5728\u62F3\u95DC\u5E02\u7684\u5149\u2026\u2026\\c\\n\u9019\u5C31\u548C\u5F9E\u524D\\n\u5DE8\u5927\u5BF6\u53EF\u5922\u5927\u9B27\u5404\u5730\uFF0C\\r\\n\u5DEE\u9EDE\u6BC0\u6EC5\u4F3D\u52D2\u723E\u5730\u5340\u7684\\r\\n\u95C7\u591C\u662F\u4E00\u6A23\u7684\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F3C\u4E4E\u662F\u7684\u3002\\c\\n\u6211\u5011\u5229\u7528\u6389\u843D\u5230\u5730\u9762\u7684\u8A31\u9858\u661F\\n\u6240\u91CB\u653E\u51FA\u4F86\u7684\u80FD\u91CF\uFF0C\\r\\n\u4F86\u8B93\u5BF6\u53EF\u5922\u6975\u5DE8\u5316\u3002[VAR 0114(000A)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u53EF\u60DC\u7684\u662F\uFF0C\u6211\u5011\u76EE\u524D\u4E0D\u77E5\u9053\\n\u8A72\u5982\u4F55\u63A7\u5236\u9019\u4E9B\u80FD\u91CF\u3002\\c\\n\u8FFD\u6839\u7A76\u5E95\u4F86\u8AAA\uFF0C\u9019\u662F\u56E0\u70BA\\n\u6211\u5011\u9084\u6C92\u63ED\u958B\u5169\u4F4D\u82F1\u96C4\u7684\u771F\u9762\u76EE\u3002[VAR 0114(000A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u50B3\u8AAA\u4E2D\u7684\u528D\u8207\u76FE\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9E\uFF0C\u6211\u89AA\u611B\u7684\u5B6B\u5973\uFF0C\\n\u6211\u5148\u5C07\u9019\u4EF6\u767D\u888D\u4EA4\u7D66\u59B3\u4E86\u3002[VAR 0114(000A)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54A6\uFF1F\u5976\u5976\uFF0C\u771F\u7684\u55CE\uFF1F\\n\u6211\u9084\u6C92\u5B8C\u6210\u60A8\u4EA4\u4EE3\u7684\u529F\u8AB2\u5462\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4E0D\u5982\u8AAA\uFF0C\\n\u9019\u662F\u70BA\u4E86\u8B93\u59B3\u5B8C\u6210\u529F\u8AB2\u554A\u3002[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9E\u535A\u58EB\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u597D\u5E25\u554A\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8B1D\u3001\u8B1D\u5566\u2026\u2026\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u76F8\u50B3\u5728\u95C7\u591C\u964D\u81E8\u6642\\n\u62EF\u6551\u4E86\u4F3D\u52D2\u723E\u5730\u5340\u7684\u5169\u4F4D\u82F1\u96C4\u2026\u2026\\r\\n\u525B\u624D\u59B3\u63D0\u5230\u7684\u50B3\u8AAA\u4E2D\u7684\u528D\u8207\u76FE\u2026\u2026\\c\\n\u9019\u4E00\u5207\u7684\u771F\u76F8\uFF0C\u5C31\u9760\u59B3\u53BB\u63ED\u958B\u4E86\u5594\u3002[VAR 0114(000A)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u662F\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u8FEB\u4E0D\u53CA\u5F85\u60F3\u898B\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u6216\u8D6B\u666E\\n\u5728\u5834\u4E0A\u8207\u4E39\u5E1D\u5C0D\u6230\u5462\uFF01\\c\\n\u5269\u4E0B\u7684\u5C31\u5305\u5728\u59D0\u59D0\u6211\u8EAB\u4E0A\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5118\u7BA1\u5F80\u5BAE\u9580\u5E02\u53BB\u5427\uFF01\\r\\n\u558F\uFF0C\u5FEB\u53BB\u8ECA\u7AD9\u642D\u5217\u8ECA\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8ECA\u7AD9\u4E0D\u662F\u5728\u5FEB\u5230\uFF17\u865F\u9053\u8DEF\u90A3\u908A\u55CE\uFF1F\\n\u5FEB\u53BB\u5427\uFF01\u9053\u9928\u6311\u6230\u8005\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6709\u4E9B\u4E8B\uFF0C\u9700\u8981\u7531\u4F60\u5011\u5E74\u8F15\u4EBA\u53BB\u5B8C\u6210\uFF0C\\n\u6709\u4E9B\u4E8B\uFF0C\u5247\u61C9\u7531\u6211\u5011\u5927\u4EBA\u4F86\u64D4\u8CA0\u3002\\r\\n\u6BCF\u500B\u4EBA\u90FD\u6709\u8A72\u626E\u6F14\u7684\u89D2\u8272\u5594\u3002[VAR 0114(000A)]"
  }
