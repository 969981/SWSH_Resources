  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u62DC\u8A17\u54E5\u54E5\u5E6B\u6211\u5831\u4EC7\uFF0C\\n\u7D50\u679C\uFF0C\u4ED6\u7ADF\u7136\u88AB\u5947\u5DF4\u7D0D\u7D66\u6253\u7206\u4E86\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90FD\u602A\u54E5\u54E5\u4F60\u4E0D\u722D\u6C23\u5566\uFF01\\c\\n\u9019\u4E0B\u4EBA\u5BB6\u6703\u4EE5\u70BA\\n\u6211\u5011\u5144\u59B9\u5006\u90FD\u662F\u597D\u6B3A\u8CA0\u7684\u4E86\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E0D\u4E0D\u4E0D\uFF0C\u59B9\u59B9\u554A\u3002\\n\u5947\u5DF4\u7D0D\u7684\u5BE6\u529B\u771F\u7684\u5F88\u5F37\u3002\\c\\n\u4F46\u6211\u9084\u662F\u8CAB\u5FB9\u4E86\\n\u4E0D\u4F7F\u7528\u6975\u5DE8\u5316\u7684\u521D\u8877\uFF0C\\c\\n\u800C\u4E14\u5802\u5802\u6B63\u6B63\u5730\uFF0C\u6253\u4E86\u4E00\u5834\\n\u4EE4\u89C0\u773E\u5927\u958B\u773C\u754C\u7684\u5C0D\u6230\u5462\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u9019\u6211\u4E5F\u77E5\u9053\uFF01\u6240\u4EE5\uFF0C\\n\u6211\u624D\u66F4\u5E0C\u671B\u4F60\u6253\u8D0F\u5436\uFF01\\c\\n\u2026\u2026\u525B\u624D\u5F9E\u6211\u770B\u4F86\uFF0C\\n\u4E5F\u89BA\u5F97\u4F60\u52DD\u7B97\u5F88\u5927\u7684\u8AAA\u2026\u2026[VAR 0114(000D)]"
  },
  {
