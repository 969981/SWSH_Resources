    "text": "\u82B1\u82B1\u82B1\u706B\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u55E8\uFF01\u9019\u88E1\u662F\u98FD\u4F2F\u7684\u9910\u5EF3\u3002\\n\u6211\u6703\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u54C1\u5617\u7F8E\u5473\u4F73\u991A\u5594\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u9019\u5F35\u58C1\u6BEF\u5F88\u68D2\u5427\u3002\\n\u6211\u5728\u53E4\u8463\u5E02\u96C6\u8CB7\u7684\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0D\u5148\u5403\u500B\u98FD\\n\u53EF\u6C92\u6CD5\u4E0A\u5834\u5C0D\u6230\u554A\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9019\u88E1\u7684\u9910\u9EDE\u7F8E\u5473\u5230\u4E86\u6975\u9EDE\uFF0C\\n\u5C31\u7B97\u9060\u9053\u800C\u4F86\u4E5F\u503C\u5F97\u5462\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5728\u5403\u98EF\u7684\u6642\u5019\u8AC7\u5DE5\u4F5C\uFF1F\\n\u4E0D\u5C31\u7B49\u65BC\u81EA\u5DF1\u8B93\u98EF\u8B8A\u96E3\u5403\u55CE\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u770B\u770B\uFF01\u70E4\u5F97\u6070\u5230\u597D\u8655\uFF01\\n\u591A\u6C41\u9BAE\u7F8E\u537B\u53C8\u53E3\u611F\u7D2E\u5BE6\uFF01\\r\\n\u5F97\u597D\u597D\u8B9A\u7F8E\u5EDA\u5E2B\u4E00\u756A\u624D\u884C\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5B69\u5B50\u5403\u5F97\u4E00\u81C9\u5E78\u798F\u7684\u6A23\u5B50\uFF0C\\n\u8B93\u4EBA\u5FCD\u4E0D\u4F4F\u770B\u5F97\u76EE\u4E0D\u8F49\u775B\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u771F\u7684\u5F88\u597D\u5403\u5462\u3002\\c\\n\u597D\u60F3\u91CD\u73FE\u9019\u500B\u5473\u9053\uFF0C\\n\u8B93\u5BF6\u53EF\u5922\u4E5F\u5403\u5403\u770B\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E00\u5F35\u58C1\u6BEF\u3002\\n\u4E0A\u982D\u756B\u8457\u7684\u662F\u2026\u2026\\c\\n\u5931\u53BB\u4E86\u528D\u548C\u76FE\u7684\\n\u5169\u4F4D\u82F1\u96C4\u2026\u2026"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u639B\u5728\u9019\u88E1\u7684\u662F\u58C1\u6BEF\uFF1F\\n\u597D\u50CF\u5728\u54EA\u88E1\u770B\u904E\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8001\u95C6\u98FD\u4F2F\u7684\u8096\u50CF\u756B\uFF01\\n\u770B\u8D77\u4F86\u662F\u500B\u8B1B\u7A76\u706B\u5019\u7684\u7537\u4EBA\u3002"
  }
]
