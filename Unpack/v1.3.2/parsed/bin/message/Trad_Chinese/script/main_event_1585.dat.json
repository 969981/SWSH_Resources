[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5967\u5229\u8587\u79D8\u66F8\u624B\u4E0B\u7684\u806F\u76DF\u8077\u54E1\u55CE\u2026\u2026\\c\\n\u4F86\uFF0C\u6211\u5011\u5206\u982D\u53BB\u627E\uFF0C\\n\u628A\u90A3\u500B\u58DE\u806F\u76DF\u8077\u54E1\u63EA\u51FA\u4F86\u5427\uFF01\\c\\n\u6211\u8A18\u5F97\u90A3\u50A2\u4F19\u6709\u6234\u4E00\u526F\\n\u5BE6\u5728\u4E0D\u600E\u9EBC\u6A23\u7684\u592A\u967D\u773C\u93E1\u3002[VAR 0114(0016)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u8A18\u5F97\u90A3\u50A2\u4F19\u6709\u6234\u4E00\u526F\\n\u5BE6\u5728\u4E0D\u600E\u9EBC\u6A23\u7684\u592A\u967D\u773C\u93E1\u3002\\c\\n\u5C0D\u4E86\uFF0C\u627E\u4EBA\u7684\u7AC5\u9580\u5C31\u662F\u898B\u4EBA\u5C31\u6253\u2026\u2026\u807D\u3002\\n\u5343\u842C\u5225\u6015\u751F\u5594\u3002[VAR 0114(0016)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5176\u4ED6\u5730\u65B9\u90FD\u6C92\u627E\u5230\\n\u90A3\u500B\u58DE\u806F\u76DF\u8077\u54E1\u3002\\c\\n\u4ED6\u4E00\u5B9A\u5C31\u8EB2\u5728\u9019\u9644\u8FD1\u3002[VAR 0114(0016)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4EBA\u8981\u662F\u8D70\u6295\u7121\u8DEF\u4E86\uFF0C\\n\u5F88\u5BB9\u6613\u4E0B\u610F\u8B58\u5730\u8EB2\u9032\u72F9\u7A84\u7684\u5730\u65B9\u3002\\r\\n\u9019\u9644\u8FD1\u6709\u53EF\u4EE5\u8EB2\u4EBA\u7684\u7BB1\u5B50\u55CE\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5967\u5229\u8587\u79D8\u66F8\u641E\u7684\u9B27\u5287\u5C31\u5230\u6B64\u70BA\u6B62\u56C9\u3002\\c\\n\u4E0D\u904E\uFF0C\u5436\u558A\u968A\u963B\u64FE\u9053\u9928\u6311\u6230\u6642\\n\u7528\u7684\u90A3\u4E9B\u4F0E\u5006\u4E5F\u662F\u534A\u65A4\u516B\u5169\u3002\\r\\n\u8AAA\u8D77\u4F86\u771F\u662F\u4E94\u5341\u6B65\u7B11\u767E\u6B65\u554A\u3002\\c\\n\u8D70\u5427\uFF0C\u6211\u5011\u5F80\u8ECA\u7AD9\u53BB\u3002[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u2026\u2026\u2026\u2026\u2026\u2026"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u5566\uFF01\\n\u9019\u53EF\u7591\u7684\u50A2\u4F19\uFF0C\u5C31\u662F\u4E0D\u80AF\u56DE\u904E\u982D\u4F86\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u8AAA\u53E5\u4EC0\u9EBC\uFF0C\\n\u8B93\u4ED6\u9A5A\u8A1D\u5F97\u5FCD\u4E0D\u4F4F\u56DE\u982D\u5504\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5967\u5229\u8587\u79D8\u66F8\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9470\u5319\u5728\u6211\u624B\u4E0A\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4EC0\u9EBC\uFF01\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7CDF\u7CD5\uFF01\\n\u6211\u600E\u9EBC\u56DE\u982D\u4E86\uFF01\\c\\n\u7121\u8DEF\u53EF\u9003\uFF01\uFF1F\\n\u90A3\u5C31\u7528\u5BF6\u53EF\u5922\u5C0D\u6230\u8DDF[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FC\u5566\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\uFF01\u8D95\u7DCA\u8EB2\u8D77\u4F86\uFF0C\\n\u5C31\u4E0D\u7528\u4EA4\u51FA\u9470\u5319\u4E86\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u9019\u50A2\u4F19\u6E9C\u5F97\u771F\u5FEB\u2026\u2026\\n\u6211\u6C92\u770B\u898B\u4ED6\u5F80\u54EA\u5152\u8EB2\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u600E\u9EBC\u6703\u88AB[VAR 1100(00FF,0101)]\u4F60\u59B3\u8B58\u7834\u2026\u2026\uFF1F\\n\u4E0D\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u53EA\u662F\u80E1\u4E82\u642D\u8A71\u5427\uFF1F\\r\\n\u9867\u4E0D\u5F97\u4E86\uFF01\u4F86\u5C0D\u6230\u5427\uFF01\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8207\u5176\u6771\u8EB2\u897F\u85CF\uFF0C\\n\u4E0D\u5982\u8EB2\u5230\u4EBA\u7FA4\u88E1\u6349\u8FF7\u85CF\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u771F\u662F\u89C0\u5BDF\u5165\u5FAE\uFF01\\n\u9019\u6B21\u6211\u4E00\u5B9A\u8981\u6253\u8D0F[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\r\\n\u7136\u5F8C\u9003\u4E4B\u592D\u592D\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9019\u4E0B\u771F\u7684\u662F\u8D70\u6295\u7121\u8DEF\u4E86\u2026\u2026\\c\\n\u4F46\u662F\uFF0C\u6211\u4E0D\u6703\u6B7B\u5FC3\u7684\uFF01\\n\u56E0\u70BA\u6211\u4E0D\u60F3\u88AB\u5967\u5229\u8587\u5C0F\u59D0\u7F75\u554A\uFF01\\c\\n\u53EA\u8981\u642D\u4E0A\u55AE\u8ECC\u5217\u8ECA\uFF0C\\n\u4F60\u5011\u5C31\u8FFD\u4E0D\u4E0A\u4F86\u4E86\u5427\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5436\u558A\u968A\uFF0C\u5FEB\u53BB\u53EB\u8D6B\u666E\u904E\u4F86\uFF01\\n\u6211\u5011\u4E00\u8D77\u5230\u8ECA\u7AD9\u570D\u5835\u4ED6\u3002[VAR 0114(0016)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\\n\u7ADF\u7136\u80FD\u628A\u58DE\u806F\u76DF\u8077\u54E1\u903C\u5230\u9019\u4E00\u6B65\uFF0C\\r\\n\u771F\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u554A\uFF01\\c\\n\u6211\u4F86\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u9996\u58D3\u7BB1\u597D\u6B4C\uFF0C\\n\u8868\u9054\u6211\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8B9A\u8CDE\u5427\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5340\u5340\u7684\u5C0F\u6B4C\u624B\uFF0C\u4E0D\u8D77\u773C\u4E5F\u4E0D\u8DB3\u9053\u3002\\n\u65CB\u5F8B\u4E00\u97FF\u6211\u77E5\u9053\uFF0C\u5531\u6B4C\u7684\u6642\u9593\u5230\u2026\u2026[VAR 0114(0016)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u64DA\u8AAA\u5436\u558A\u7684\u6B4C\u80FD\u7D66\u4EBA\u52C7\u6C23\u266A\\n\u90A3\u6839\u672C\u662F\u80E1\u8AAA\u516B\u9053\u266A[VAR 0114(0016)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u64DA\u8AAA\u4E00\u9996\u597D\u6B4C\u5C31\u80FD\u7D66\u4EBA\u5E78\u798F\u266A\\n\u9019\u5728\u6211\u770B\u4F86\uFF0C\u771F\u662F\u7121\u7A3D\u4E4B\u8AC7\u266A[VAR 0114(0016)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5340\u5340\u7684\u4E00\u9996\u6B4C\uFF0C\u4E0D\u8D77\u773C\u4E5F\u4E0D\u8DB3\u9053\u266A\\n\u65CB\u5F8B\u4E00\u97FF\u6211\u77E5\u9053\uFF0C\u5531\u6B4C\u7684\u6642\u9593\u5230\u266A[VAR 0114(0016)]"
