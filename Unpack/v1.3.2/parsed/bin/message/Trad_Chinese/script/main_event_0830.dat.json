    "text": "[VAR 0100(0000)]\uFF0C\\n\u62F3\u95DC\u5E02\u5C31\u5728\u90A3\u908A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7576\u7136\uFF0C\u6211\u5011\u53EF\u4EE5\\n\u76F4\u76F4\u95D6\u904E\u66E0\u91CE\u5730\u5E36\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u73FE\u5728\u6211\u5011\u6709\u4E86\u9019\u4E9B\u9053\u9928\u5FBD\u7AE0\uFF0C\\n\u53EF\u4EE5\u6355\u6349\u6BD4\u4E4B\u524D\u66F4\u5F37\u7684\u5BF6\u53EF\u5922\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u6C7A\u5B9A\u56C9\uFF01\\c\\n\u6211\u8981\u53BB\u6349\u5230\u53B2\u5BB3\u7684\u5BF6\u53EF\u5922\u7576\u5925\u4F34\uFF0C\\n\u70BA\u6211\u7684\u50B3\u8AAA\u518D\u6DFB\u4E00\u9801\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E0D\u7528\u767D\u8CBB\u529F\u592B\u4E86\u2026\u2026\\c\\n\u53CD\u6B63\u4F60\u5011\u662F\u9023\u9053\u9928\u6311\u6230\\n\u90FD\u7121\u6CD5\u5B8C\u6210\u7684\u3002[VAR 0114(000C)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u51A0\u8ECD\u63A8\u85A6\u7684\u4EBA\u9078\u7ADF\u7136\u662F\u4F60\u5011\uFF0C\\n\u770B\u4F86\u4ED6\u4F3C\u4E4E\u662F\u7CCA\u5857\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5C24\u5176\u662F\u4F60\uFF0C\u8D6B\u666E\uFF0C\\n\u4F60\u9023\u7CBE\u9748\u7403\u90FD\u6254\u4E0D\u597D\u5462\u3002[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u61C2\u4E0D\u61C2\u554A\uFF01\\c\\n\u6211\u6295\u7403\u7684\u59FF\u52E2\u662F\u6700\u5F37\u7684\uFF0C\u800C\u4E14\\n\u6211\u5927\u54E5\u662F\u4E16\u754C\u7B2C\u4E00\u7684\u51A0\u8ECD\uFF01\\r\\n\u4F60\u5225\u77A7\u4E0D\u8D77\u4EBA\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u771F\u62FF\u4F60\u6C92\u8FA6\u6CD5\u3002\\n\u4F86\u5427\uFF0C\u6211\u966A\u4F60\u5C0D\u6230\u3002\\c\\n\u9019\u6A23\uFF0C\u4F60\u5C31\u6703\u6E05\u6E05\u695A\u695A\u5730\u660E\u767D\\n\u81EA\u5DF1\u7A76\u7ADF\u6709\u591A\u5F31\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8667\u4F60\u8AAA\u5F97\u51FA\u53E3\u3002\\c\\n\u4F60\u660E\u660E\u5C31\u5728\u7B2C\u4E8C\u7926\u5C71\\n\u8F38\u7D66\u4E86[VAR 0100(0000)]\u3002\\c\\n\u65E2\u7136\u9019\u6A23\uFF0C\u4F60\u4E5F\u7576\u7136\u6253\u4E0D\u904E\\n[VAR 0100(0000)]\u7684\u52C1\u6575\uFF0C\u4E5F\u5C31\u662F\u6211\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u53E3\u53E3\u8072\u8072\u4E0D\u662F[VAR 0100(0000)]\uFF0C\\n\u5C31\u662F\u51A0\u8ECD\u2026\u2026\\r\\n\u5012\u662F\u7D66\u6211\u770B\u770B\u4F60\u7684\u5BE6\u529B\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u628A\u773C\u775B\u5F35\u5927\u9EDE\uFF01\\n\u6211\u73FE\u5728\u7528\u5C0D\u6230\u8B93\u4F60\u898B\u8B58\u4E00\u756A\uFF01\\c\\n\u62DC\u62DC\u56C9\uFF0C[VAR 0100(0000)]\uFF01\\n\u6211\u5011\u62F3\u95DC\u5E02\u898B\uFF01[VAR 0114(0005)]"
