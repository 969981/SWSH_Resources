  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u73FE\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u5DF2\u7D93\u5E6B\u6211\u627E\u5230\\n[VAR 0202(0001)]\u96BB\u5730\u9F20\u4E86\u3002\\r\\n\u6240\u4EE5\u9084\u5269\u4E0B[VAR 0202(0002)]\u96BB\u3002"
