[
  {
    "index": 0,
    "flags": 0,
    "text": "\u547C\u560E\uFF01\u547C\u560E\u560E\u560E\uFF01\\c\\n\u6211\u662F\u5BF6\u53EF\u5922\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FEB\u8DDF\u6211\u4E00\u6C7A\u52DD\u8CA0\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54CE\u5440\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5148\u807D\u6211\u8AAA\u3002\\c\\n\u708E\u5154\u5152\u548C\u71D2\u706B\u86A3\\n\u662F\u540C\u4E00\u500B\u7A2E\u65CF\u55CE\uFF1F\\c\\n\u4E0D\u662F\u5427\uFF1F\\n\u4F46\u662F\u6211\u5011\u90FD\u53EB\u7260\u5011\u5BF6\u53EF\u5922\u3002\\c\\n\u708E\u5154\u5152\u548C\u6211\u662F\u4E0D\u4E00\u6A23\u7684\u7A2E\u65CF\uFF0C\\n\u6211\u548C\u71D2\u706B\u86A3\u4E5F\u662F\u4E0D\u4E00\u6A23\u7684\u7A2E\u65CF\u3002\\c\\n\u9019\u6A23\u7684\u8A71\uFF0C\u8AAA\u6211\u662F\u5BF6\u53EF\u5922\u4E5F\u5F88\u5408\u7406\u4E0D\u662F\u55CE\uFF1F"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u7528\u52C9\u5F37\u914D\u5408\u6211\u3002\\r\\n\u6211\u81EA\u5DF1\u4E5F\u77E5\u9053\u90A3\u5F88\u727D\u5F37\u3002\\c\\n\u6211\u2026\u2026\\n\u6211\u53EA\u662F\u5F88\u60F3\u8B8A\u6210\u5BF6\u53EF\u5922\u554A\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u53EF\u4EE5\u7684"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u2026\u2026\u52A0\u6CB9"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u6709\u597D\u9EDE\u5B50\u4E86\uFF01\u6539\u8B8A\u670D\u88DD\u6253\u626E\u7684\u8A71\uFF0C\\n\u5FC3\u60C5\u4E5F\u6703\u622A\u7136\u4E0D\u540C\u5427\u3002\\c\\n\u4E5F\u5C31\u662F\u8AAA\uFF0C\u5982\u679C\u8B93\u5FC3\u60C5\u548C\u5BF6\u53EF\u5922\u4E00\u6A23\uFF0C\\n\u5C31\u67D0\u7A2E\u610F\u7FA9\u4F86\u8AAA\uFF0C\\r\\n\u4E5F\u5C31\u662F\u8B8A\u6210\u4E86\u5BF6\u53EF\u5922\u4E0D\u662F\u55CE\uFF01\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\u7A7F\u4E0A\u80FD\u5C55\u73FE\u51FA\u6211\u9019\\n\u706B\u71B1\u6FC0\u6602\u5FC3\u60C5\u7684\u670D\u88DD\u5427\uFF01\\c\\n\u8A2D\u8A08\u5C31\u50CF\u706B\u7130\u4E00\u822C\u7684\u670D\u88DD\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u7A7F\u4F86\u7D66\u6211\u770B\u770B\u55CE\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u2026\u2026\u54CE\u5440\uFF0C\\n\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u597D\u610F\uFF0C\\r\\n\u4F46\u9019\u6A23\u7684\u6253\u626E\u662F\u6C92\u8FA6\u6CD5\u6210\u70BA\u5BF6\u53EF\u5922\u7684\u3002\\c\\n\u6211\u60F3\u8981\u7684\u662F\u50CF\u706B\u7130\u4E00\u6A23\u7684\u670D\u88DD\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u7A7F\u4F86\u7D66\u6211\u770B\u770B\u55CE\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9019\u2026\u2026\uFF01\u9019\u4EF6\u8863\u670D\u2026\u2026\uFF01\\n\u8B93\u6211\u597D\u50CF\u8B8A\u6210\u4E86\u5BF6\u53EF\u5922\u4E00\u6A23\uFF01\\c\\n\u7A7F\u4E0A\u50CF\u706B\u7130\u4E00\u6A23\u7684\u6642\u5C1A\u706B\u71B1\u670D\u88DD\uFF0C\\n\u5FC3\u60C5\u4E5F\u8DDF\u8457\u7165\u7136\u4E00\u65B0\uFF0C\\r\\n\u80FD\u8B93\u6211\u8B8A\u6210\u706B\u5BF6\u53EF\u5922\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u7528\u5FC3\uFF01\\n\u96D6\u7136\u53EA\u662F\u500B\u5C0F\u6771\u897F\uFF0C\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u6536\u4E0B\u5427\u3002\\c\\n\u96DC\u6280\u9019\u500B\u62DB\u5F0F\u5728\u6C92\u6709\\n\u651C\u5E36\u9053\u5177\u7684\u6642\u5019\u4F7F\u7528\uFF0C\\r\\n\u5E36\u7D66\u5C0D\u65B9\u7684\u50B7\u5BB3\u53EF\u662F\u6703\u589E\u52A0\u7684\u5462\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u6709\u500B\u60F3\u6CD5\u2026\u2026\\n\u5982\u679C\u53E4\u6708\u9CE5\u628A\u6211\u541E\u4E86\u9032\u53BB\uFF0C\\r\\n\u7136\u5F8C\u88AB\u5176\u4ED6\u8A13\u7DF4\u5BB6\u6349\u8D77\u4F86\u7684\u8A71\uFF0C\\c\\n\u6211\u4E5F\u6703\u8DDF\u8457\u8DD1\u5230\u7CBE\u9748\u7403\u88E1\u9762\u5C0D\u5427\uFF1F\\c\\n\u90A3\u6211\u662F\u4E0D\u662F\u5C31\u6703\u6210\u70BA\u4EBA\u985E\u53F2\u4E0A\\n\u7B2C\u4E00\u500B\u88AB\u7CBE\u9748\u7403\u6355\u7372\u7684\u7537\u4EBA\u554A\uFF01\uFF1F\\c\\n\u63DB\u53E5\u8A71\u8AAA\uFF0C\\n\u6211\u5C31\u7B49\u65BC\u662F\u5BF6\u53EF\u5922\u4E0D\u662F\u55CE\uFF1F\\r\\n\u4E0D\u884C\u55CE\uFF1F\u597D\u5427\uFF0C\u597D\u50CF\u8AAA\u4E0D\u901A\uFF01"
  },
