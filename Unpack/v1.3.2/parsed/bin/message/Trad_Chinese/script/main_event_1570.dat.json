[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5E7E\u500B\u5C0F\u6642\u5F8C\u2026\u2026"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u592A\u6162\u4E86\uFF01\\n\u9019\u4E00\u5B9A\u6709\u554F\u984C\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5927\u54E5\u5F9E\u4E0D\u98DF\u8A00\u7684\uFF01\\c\\n\u4ED6\u751A\u81F3\u5BE6\u73FE\u4E86\u548C\u6211\u7684\u7D04\u5B9A\uFF0C\\n\u7576\u4E0A\u4E86\u51A0\u8ECD\u8036\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6E96\u6642\u53BB\u5403\u98EF\u9019\u7A2E\u5C0F\u4E8B\uFF0C\\n\u5C0D\u4ED6\u61C9\u8A72\u4E0D\u6210\u554F\u984C\u5427\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u771F\u662F\u500B\u8052\u566A\u7684\u5C0F\u5B50\u3002\\c\\n\u65E2\u7136\u4F60\u9084\u5269\u9019\u9EBC\u591A\u529B\u6C23\uFF0C\\n\u600E\u9EBC\u4E0D\u5728\u6BD4\u8CFD\u6642\u591A\u4F7F\u4E00\u4E9B\u51FA\u4F86\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u5F9E\u982D\u5230\u8173\u5C31\u662F\u500B\u9F90\u514B\u6A23\uFF0C\\n\u8AAA\u8A71\u4E0D\u8981\u9019\u9EBC\u4E2D\u80AF\u597D\u4E0D\u597D\u2026\u2026\\r\\n\u8076\u6893\uFF01\u6211\u662F\u771F\u7684\u5728\u64D4\u5FC3\u8036\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u9019\u662F\u4EE5\u8C8C\u53D6\u4EBA\u5462\u3002\\n\u4E5F\u96E3\u602A\u4F60\u7121\u6CD5\u53D6\u52DD\u3002[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u800C\u4E14\uFF0C\u60F3\u627E\u51A0\u8ECD\u7684\u8A71\uFF0C\\n\u6211\u525B\u624D\u770B\u898B\u4ED6\u5F80\u6D1B\u8332\u5927\u5EC8\u53BB\u56C9\u3002[VAR 0114(0016)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4ED6\u70BA\u4EC0\u9EBC\u8981\u53BB\u90A3\u88E1\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6D1B\u8332\u5927\u5EC8\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u4E5F\u4E0D\u592A\u6E05\u695A\u600E\u9EBC\u56DE\u4E8B\uFF0C\\n\u4F46\u6211\u525B\u624D\u5728\u642D\u55AE\u8ECC\u5217\u8ECA\u7684\u5730\u65B9\u78B0\u5230\u4ED6\u3002\\c\\n\u4ED6\u8AAA\u6709\u4E8B\u8981\u53BB\u6D1B\u8332\u5927\u5EC8\uFF0C\\n\u8981\u6211\u8F49\u544A\u4F60\u5011\uFF0C\\r\\n\u4ED6\u6703\u665A\u9EDE\u624D\u5230\u3002[VAR 0114(0016)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u8332\u5927\u5EC8\uFF1F\\n\u90FD\u9019\u9EBC\u665A\u4E86\uFF0C\u9084\u6703\u6709\u4E8B\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8076\u6893\uFF0C\u4F60\u5C31\u5E6B\u4EBA\u5E6B\u5230\u5E95\uFF0C\\n\u5E36\u6211\u5011\u53BB\u6D1B\u8332\u5927\u5EC8\u5427\uFF01\\c\\n\u6211\u548C[VAR 0100(0000)]\\n\u90FD\u4E0D\u77E5\u9053\u90A3\u5728\u54EA\u88E1\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5509\u2026\u2026\u7E3D\u6B78\u4E00\u53E5\u8A71\uFF0C\\n\u4F60\u548C\u51A0\u8ECD\u9019\u5C0D\u5144\u5F1F\uFF0C\u771F\u6703\u4F7F\u559A\u4EBA\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4E0D\u904E\u2026\u2026\\c\\n\u8981\u662F\u6C7A\u8CFD\u7121\u6CD5\u958B\u6253\uFF0C\\n\u5C0D\u6211\u4E5F\u4E0D\u662F\u4E00\u4EF6\u597D\u4E8B\u3002\\c\\n\u800C\u4E14\u8001\u5BE6\u8AAA\uFF0C\u6211\u9084\u771F\u662F\u4E0D\u8A0E\u53AD\\n\u4F60\u5011\u9019\u5169\u500B\u6253\u8D0F\u6211\u7684\u5B69\u5B50\u3002[VAR 0114(0016)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\u6211\u5011\u5436\u558A\u968A\u7684\u5927\u5925\u5152\\n\u5C31\u966A\u4F60\u5011\u4E00\u8D77\u53BB\u73A9\u73A9\u5427\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u54C7\u547C\uFF01\u8076\u6893\uFF0C\u4F60\u592A\u5E25\u4E86\uFF01\\n\u6211\u5011\u6253\u8D77\u7CBE\u795E\u51FA\u767C\u5427\uFF01[VAR 0114(0005)]"
  }
]
