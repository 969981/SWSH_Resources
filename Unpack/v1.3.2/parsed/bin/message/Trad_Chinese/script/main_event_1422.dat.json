[
  {
    "index": 0,
    "flags": 0,
    "text": "\u76EE\u524D\u5269\u4E0B\u7684\u9053\u9928\u6311\u6230\u8005\u2026\u2026\\n\u9023\uFF11\uFF10\u500B\u4EBA\u90FD\u4E0D\u5230\u554A\u3002[VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C[VAR 0100(0000)]\uFF01\\c\\n\u8B93\u5947\u5DF4\u7D0D\u5927\u723A\u6211\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u660E\\n\u9019\u5152\u7684\u9053\u9928\u4EFB\u52D9\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u898F\u5247\u5F88\u7C21\u55AE\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EA\u9700\u8981\u5728\u96D9\u6253\u5C0D\u6230\u4E2D\uFF0C\\n\u6230\u52DD\uFF13\u500B\u6211\u8A13\u7DF4\u7684\u9053\u9928\u8A13\u7DF4\u5BB6\u5C31\u597D\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u77E5\u9053\uFF0C\u9053\u9928\u6311\u6230\u771F\u662F\\n\u56B4\u82DB\u5F97\u4E0D\u5F97\u4E86\u5C0D\u5427\uFF1F\\c\\n\u7576\u7136\uFF0C\u5728\u9053\u9928\u6311\u6230\u8005\u88E1\\n\u80FD\u6230\u52DD\u5230\u6700\u5F8C\u7684\u4EBA\u4E5F\u662F\u5C11\u5F97\u5F88\u3002[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6240\u4EE5\u554A\uFF01\u6211\u5C31\u60F3\u5927\u98FD\u773C\u798F\u4E00\u4E0B\uFF01\\n\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u500B\u6230\u52DD\u5230\u6B64\u7684\u8A13\u7DF4\u5BB6\uFF0C\\c\\n\u6703\u8B93\u5BF6\u53EF\u5922\u5011\u5C55\u73FE\u51FA\\n\u591A\u9EBC\u7CBE\u5F69\u7684\u9ED8\u5951\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5EE2\u8A71\u5C31\u4E0D\u591A\u8AAA\u3002\\n\u4F86\uFF01\u9996\u5148\u662F\u7B2C\uFF11\u500B\u8A13\u7DF4\u5BB6\uFF01\\c\\n\u907C\u592A\uFF01\u4E0A\u5834\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\uFF0C\u6211\u5C31\u662F\u907C\u592A\u3002\\c\\n\u5947\u5DF4\u7D0D\u5148\u751F\u6559\u4E86\u6211\uFF12\u4EF6\u4E8B\uFF01\\n\u4E00\u662F\u9F8D\u5C6C\u6027\u7684\u5F37\u5927\uFF01\\c\\n\u4E8C\u662F\u8981\u88FD\u9020\u51FA\u80FD\u4F54\u512A\u52E2\u7684\u5834\u5730\uFF0C\\n\u597D\u8B93\u9F8D\u5C6C\u6027\u7684\u5BE6\u529B\u5145\u5206\u767C\u63EE\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u771F\u4E0D\u6127\u662F\u4E00\u8DEF\u6230\u52DD\u5230\u6B64\u7684\\n\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u770B\u6E05\u5C0D\u65B9\u7684\u5BF6\u53EF\u5922\u5728\u5C0D\u6230\u4E2D\\n\u626E\u6F14\u8457\u4EC0\u9EBC\u6A23\u7684\u89D2\u8272\u3002\\r\\n\u9019\u662F\u96D9\u6253\u5C0D\u6230\u7684\u91CD\u8981\u8A23\u7AC5\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u770B\u6A23\u5B50\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u76EE\u524D\u4E26\u6C92\u6709\\n\uFF12\u96BB\u80FD\u5920\u5C0D\u6230\u7684\u5BF6\u53EF\u5922\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u592A\u53B2\u5BB3\u4E86\uFF01\u771F\u4E0D\u6127\u662F\\n\u64C1\u6709\uFF17\u500B\u9053\u9928\u5FBD\u7AE0\u7684\u8A13\u7DF4\u5BB6\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u96D9\u6253\u5C0D\u6230\u2026\u2026\\c\\n\u8981\u7528\uFF12\u96BB\u5BF6\u53EF\u5922\u7684\u529B\u91CF\u58D3\u5012\u5C0D\u65B9\u5462\uFF1F\\n\u9084\u662F\u8981\u8B93\u5176\u4E2D\uFF11\u96BB\u5BF6\u53EF\u5922\u64D4\u4EFB\u652F\u63F4\u2026\u2026\uFF1F\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u89BA\u5F97\u5462\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u9019\u88E1\u7684\u9053\u9928\u4EFB\u52D9\u662F\u96D9\u6253\u5C0D\u6230\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FC5\u9808\u5E36\u8457\u81F3\u5C11\uFF12\u96BB\\n\u80FD\u5920\u6230\u9B25\u7684\u5BF6\u53EF\u5922\u2026\u2026"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u592A\u6F02\u4EAE\u4E86\u2026\u2026\uFF01\\c\\n\u6211\u5F88\u69AE\u5E78\u80FD\u5920\u8207[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u6A23\\n\u5F37\u5927\u7684\u8A13\u7DF4\u5BB6\u5C0D\u6230\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u8D0F\u4E86\u9694\u58C1\u7684\u8A13\u7DF4\u5BB6\uFF0C\\n\u5C31\u6703\u8F2A\u5230\u6211\u8207[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\u4E86\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u600E\u9EBC\u4E86\uFF1F[VAR 0100(0000)]\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u9053\u9928\u4EFB\u52D9\u9084\u6C92\u7D50\u675F\u5462\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6C92\u4EC0\u9EBC"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6211\u60F3\u9000\u51FA"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5475\u5475\uFF01\u9084\u4E0D\u5FEB\u53BB\u5B8C\u6210\u4EFB\u52D9\uFF01\\n\u6211\u7B49\u4E0D\u53CA\u8981\u8207[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
