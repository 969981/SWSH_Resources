    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u7684\u8981\u9000\u51FA\u554A\uFF1F[VAR 0114(0017)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\\c\\n\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u6703\u4E0D\u6B7B\u5FC3\u5730\u518D\u4F86\u6311\u6230\u5427\uFF1F\\n\u6211\u6703\u5728\u9019\u88E1\u7B49\u8457[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u3002[VAR 0114(0017)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u679C\u7136\u53B2\u5BB3\uFF01[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u901A\u904E\u9053\u9928\u4EFB\u52D9\u4E86\uFF01\\c\\n\u8D70\uFF0C\u6211\u5011\u5230\u9053\u9928\u7AF6\u6280\u5834\u53BB\u5427\u3002\\n\u672C\u5927\u723A\u8981\u89AA\u81EA\u8207[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\u56C9\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u7B2C\uFF12\u500B\u8A13\u7DF4\u5BB6\u8981\u4E0A\u56C9\uFF01\\n\u4F86\u5427\uFF01\u73B2\u5A1C\uFF01[VAR 0114(0017)]"
  },
