    "text": "\u8981\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8ACB\u9032\u5834\u5427\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u548C\u5225\u7684\u9078\u624B\u804A\u804A\u5929\u55CE\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8EAB\u70BA\u4E00\u500B\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\uFF0C\\n\u70BA\u4E86\u8B93\u81EA\u5DF1\u5728\u5C0D\u6230\u4E2D\u751F\u5B58\u5230\u5E95\uFF0C\\r\\n\u6211\u8981\u4E0D\u505C\u5730\u6311\u6230\uFF01\\c\\n\u6211\u76F8\u4FE1\uFF0C\u53EA\u8981\u6301\u7E8C\u6311\u6230\uFF0C\\n\u5C31\u80FD\u5920\u4E0D\u65B7\u7DBB\u653E\u5149\u8292\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7B2C\u4E00\u56DE\u5408\u7ADF\u7136\u5C31\u5C0D\u4E0A\u4E86\u5947\u5DF4\u7D0D\uFF0C\\n\u6211\u7684\u904B\u6C23\u600E\u9EBC\u9019\u9EBC\u7CDF\u554A\uFF5E\\c\\n\u4F46\u662F\u4E0D\u7BA1\u4ED6\u600E\u9EBC\u8B8A\u63DB\u5929\u6C23\uFF0C\\n\u6211\u90FD\u4E00\u5B9A\u8981\u6709\u6BC5\u529B\u5805\u6301\u4E0B\u53BB\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u597D\u4E45\u4E0D\u898B\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u77E5\u9053\uFF0C\\n\u9053\u9928\u6311\u6230\u53EA\u662F\u70BA\u4E86\u6E2C\u8A66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BE6\u529B\u3002\\r\\n\u4ECA\u975E\u6614\u6BD4\uFF0C\u6211\u662F\u4E0D\u6703\u653E\u6C34\u7684\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u771F\u4E0D\u53EF\u601D\u8B70\u2026\u2026\\n\u6211\u7684\u5167\u5FC3\u7684\u78BA\u662F\u6709\u4E00\u7D72\u9A37\u52D5\uFF0C\u4F46\u2026\u2026\\r\\n\u90A3\u7D14\u7CB9\u662F\u56E0\u70BA\u6211\u8FEB\u4E0D\u53CA\u5F85\u8981\u5C0D\u6230\uFF01[VAR 0114(0011)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u6703\u901F\u6230\u901F\u6C7A\u7684\u3002\\c\\n\u6211\u5011\u6703\u7528\u5F37\u5927\u7684\u5BE6\u529B\uFF0C\\n\u5728\u89C0\u773E\u7684\u8166\u6D77\u4E2D\u7559\u4E0B\u5F37\u70C8\u7684\u5370\u8C61\u3002[VAR 0114(0014)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4E00\u8DEF\u52DD\u51FA\uFF0C\u4E26\u4E14\u6311\u6230\u4E39\u5E1D\uFF01\\n\u9019\u5C31\u662F\u672C\u5927\u723A\u552F\u4E00\u7684\u76EE\u6A19\uFF01\\c\\n\u4E0D\u7136\uFF0C\u6211\u5C31\u6C92\u81C9\u898B\u92C1\u92FC\u9F8D\u7260\u5011\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u7684\u76EE\u6A19\u5C31\u662F\u62FF\u4E0B\u512A\u52DD\u56C9\u3002\\c\\n\u6211\u8981\u5805\u6301\u4E0D\u7528\u6975\u5DE8\u5316\u4F86\u8D0F\u5F97\u52DD\u5229\uFF0C\\n\u70BA\u5C16\u91D8\u93AE\u7684\u5927\u5BB6\u627E\u56DE\u81EA\u5C0A\u548C\u7B11\u5BB9\u3002[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u958B\u5E55\u5178\u79AE\u5C31\u8981\u958B\u59CB\u4E86\u3002\\n\u8ACB\u524D\u5F80\u5C0D\u6230\u5834\u3002"
  }
]
