[
  {
    "index": 0,
    "flags": 0,
    "text": "\u563F\uFF01\u6211\u5011\u5728\u9019\u908A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u554A\uFF0C\u9019\u4E0D\u662F[VAR 0100(0000)]\u55CE\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E39\u5E1D\u548C\u5674\u706B\u9F8D\\n\u4E0D\u6127\u662F\u6700\u4F73\u642D\u6A94\uFF01\\c\\n\u807D\u8AAA\u4F60\u5011\u4E00\u77AC\u9593\\n\u5C31\u6253\u5012\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u4E86\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u662F\u7121\u6575\u7684\u51A0\u8ECD\u554A\uFF01\\n\u5012\u662F\u6211\u60F3\u554F\u59B3\uFF0C\u9019\u662F\u600E\u9EBC\u56DE\u4E8B\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5FFD\u7136\u51FA\u73FE\u4E86\u7D05\u5149\u2026\u2026\\n\u4E0D\u5728\u80FD\u91CF\u9EDE\u4E0A\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u7ADF\u7136\u5C31\u6975\u5DE8\u5316\u4E86\u2026\u2026\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u600E\u9EBC\u6703\u9019\u6A23\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u4E0D\u77E5\u9053\u2026\u2026\\n\u9019\u7A76\u7ADF\u662F\u600E\u9EBC\u56DE\u4E8B\u2026\u2026\\c\\n\u800C\u4E14\uFF0C\u90A3\u7D05\u5149\u53EF\u80FD\u9084\u6703\u518D\u51FA\u73FE\u3002\\n\u9019\u90FD\u662F\u8AAA\u4E0D\u5B9A\u7684\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9810\u6E2C\u5B83\u51FA\u73FE\u7684\u6642\u9593\u9EDE\uFF0C\\n\u4E5F\u662F\u512A\u79C0\u7684\u5B78\u8005\u61C9\u6709\u7684\u80FD\u529B\u5594\u3002[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5976\u5976\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u662F\u6703\u9577\u627E\u6211\u4F86\u7684\u3002\\c\\n\u91DD\u5C0D\u6975\u5DE8\u5316\u8207\u7D05\u5149\u7684\u95DC\u4FC2\uFF0C\\n\u4ED6\u554F\u4E86\u6211\u4E0D\u5C11\u4E8B\u60C5\u3002[VAR 0114(000A)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8ACB\u554F\uFF0C\u6709\u4EC0\u9EBC\u767C\u73FE\u55CE\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u600E\u9EBC\u8AAA\u5462\uFF1F\\n\u6703\u9577\u5C0D\u80FD\u6E90\u5F88\u91CD\u8996\uFF0C\\r\\n\u76F8\u95DC\u7684\u4E8B\u5C31\u53EA\u4EA4\u7D66\u4ED6\u7684\u79D8\u66F8\u8655\u7406\u3002\\r\\n\u56E0\u70BA\u9019\u6A23\uFF0C\u6211\u5011\u4E5F\u6C92\u6709\u8DB3\u5920\u7684\u8CC7\u6599\u3002[VAR 0114(000A)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6240\u4EE5\uFF0C\u7D22\u59AE\u4E9E\uFF0C\\n\u59B3\u4E5F\u53BB\u8ABF\u67E5\u770B\u770B\u5427\u3002\\c\\n\u6211\u76F8\u4FE1\uFF0C\u76EE\u524D\u6C92\u6709\u4EBA\u6BD4\u59B3\\n\u66F4\u6DF1\u5165\u5728\u8ABF\u67E5\u95C7\u591C\u4E86\uFF0C\u662F\u5427\uFF1F[VAR 0114(000A)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u60A8\u662F\u8AAA\uFF0C\\n\u90A3\u7D05\u8272\u7684\u5149\u53EF\u80FD\u662F\u707D\u5384\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u563F\uFF0C\u6211\u5011\u662F\u4E0D\u662F\u4E5F\u80FD\u5E6B\u4E0A\u4EC0\u9EBC\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u7576\u7136\u4E86\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u5011\u5E6B\u5FD9\u5427\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u8B1D\u8B1D\uFF01\\n\u4F60\u5011\u7684\u9019\u4EFD\u5FC3\u610F\u6211\u6536\u4E0B\u4E86\uFF01\\c\\n\u4F46\u662F\u6211\u5C0D\u4F60\u5011\u671F\u5F85\u7684\u662F\\n\u524D\u6240\u672A\u6709\u7684\u7CBE\u5F69\u6C7A\u8CFD\uFF01\\c\\n\u4F60\u5011\u76E1\u5168\u529B\u53BB\u5B8C\u6210\u9053\u9928\u6311\u6230\u5427\uFF01\\n\u6211\u4E00\u5B9A\u6703\u5B88\u4F4F\u672A\u4F86\u7684\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u4E86\uFF01\u7562\u7ADF\uFF0C\\n\u5927\u54E5\u662F\u6240\u5411\u7121\u6575\u7684\u51A0\u8ECD\u561B\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5976\u5976\uFF0C\\n\u6709\u4E9B\u4E8B\u60C5\u6211\u60F3\u66F4\u6DF1\u5165\u8ABF\u67E5\u3002\\r\\n\u60A8\u53EF\u4EE5\u5E6B\u6211\u55CE\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u7576\u7136\u56C9\u3002[VAR 0114(000A)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u4E5F\u8A72\u8D70\u4E86\u3002\\n\u4F60\u5011\u4E00\u5B9A\u8981\u5B8C\u6210\u9053\u9928\u6311\u6230\uFF0C\\r\\n\u6649\u7D1A\u5230\u51A0\u8ECD\u76C3\u5594\uFF01\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6211\u8981\u5C08\u5FC3\u505A\u8A72\u505A\u7684\u4E8B\uFF01\\n\u9996\u5148\u5C31\u662F\u6253\u8D0F\u8076\u6893\uFF01\\c\\n[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A72\u53BB\u62F3\u95DC\u7AF6\u6280\u5834\u4E86\u5427\uFF01\\r\\n\u5947\u5DF4\u7D0D\u7684\u5BE6\u529B\u53EF\u4E0D\u662F\u84CB\u7684\u5594\uFF01[VAR 0114(0005)]"
  }
]
