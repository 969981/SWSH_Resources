    "index": 0,
    "flags": 0,
    "text": "\u6B61\u8FCE\uFF01\u6211\u5C31\u662F\u706B\u5C6C\u6027\u7684\\n\u9053\u9928\u9928\u4E3B\u5361\u856A\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u80FD\u6253\u6557\u8349\u5C6C\u6027\u9053\u9928\u7684\u4E9E\u6D1B\uFF0C\\n\u548C\u6C34\u5C6C\u6027\u9053\u9928\u7684\u9732\u7483\u5A1C\uFF0C\\r\\n\u4E00\u8DEF\u95D6\u5230\u6211\u9019\u88E1\u4F86\uFF0C\u771F\u662F\u4E0D\u7C21\u55AE\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6BCF\u4E00\u500B\u8A13\u7DF4\u5BB6\uFF0C\u6BCF\u4E00\u96BB\u5BF6\u53EF\u5922\uFF0C\\n\u90FD\u6703\u70BA\u4E86\u52DD\u5229\u800C\u4E0D\u505C\u935B\u934A\uFF01\\c\\n\u4E0D\u904E\uFF0C\u5C0D\u624B\u4E5F\u662F\u540C\u6A23\u5728\u52AA\u529B\uFF01\\c\\n\u52DD\u8CA0\u7684\u95DC\u9375\u5C31\u770B\u8A13\u7DF4\u5BB6\u5728\u5C0D\u6230\u6642\uFF0C\\n\u7A76\u7ADF\u80FD\u767C\u63EE\u591A\u5C11\u5BE6\u529B\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u9019\u88E1\u88AB\u516C\u8A8D\u662F\u9053\u9928\u6311\u6230\u7684\u9996\u9053\u96E3\u95DC\uFF0C\\n\u4E0D\u6599[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u8D0F\u904E\u6211\u4E86\uFF01\\c\\n\u770B\u4F86\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5929\u5206\u9AD8\u904E\u4E86\\n\u6211\u591A\u5E74\u7684\u6230\u9B25\u7D93\u9A57\uFF01\\r\\n\u6211\u5FC5\u9808\u518D\u52A0\u7DCA\u5B78\u7FD2\u4E86\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u5011\u80AF\u5B9A\u6703\u6210\u70BA\u6700\u5F37\u7684\u968A\u4F0D\uFF01\\n\u6211\u5F88\u9AD8\u8208\u4ECA\u5929\u6709\u5E78\u8207[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6536\u4E0B\u9019\u706B\u4E4B\u5FBD\u7AE0\uFF0C\\n\u4F5C\u70BA\u6230\u52DD\u6211\u7684\u8B49\u660E\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u80FD\u6355\u6349\u7B49\u7D1A\uFF13\uFF15\u4EE5\u4E0B\u7684\u5BF6\u53EF\u5922\u4E86\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u56E0\u70BA\u80FD\u5920\u904B\u7528\u6975\u5DE8\u5316\uFF0C\\n\u6211\u5011\u7684\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\r\\n\u5DF2\u7D93\u6210\u70BA\u4F3D\u52D2\u723E\u5730\u5340\u7684\u6587\u5316\u4E86\u3002[VAR 0114(0010)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5225\u5FD8\u8A18\uFF0C\u50B3\u627F\u6587\u5316\\n\u662F\u5E74\u8F15\u8A13\u7DF4\u5BB6\u7684\u8077\u8CAC\u554A\u3002\\c\\n\u7576\u7136\uFF0C\u9019\u4E0D\u662F\u8981\u4F60\u5011\u5B88\u820A\uFF0C\\n\u800C\u662F\u8981\u4F60\u5011\u8B93\u5B83\u8B8A\u5F97\u66F4\u597D\u3002\\r\\n\u6211\u5011\u5927\u4EBA\u6703\u652F\u6301\u4F60\u5011\u7684\uFF01[VAR 0114(0010)]"
  },
  {
