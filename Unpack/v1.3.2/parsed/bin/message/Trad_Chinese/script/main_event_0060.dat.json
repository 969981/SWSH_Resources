    "text": "\u6728\u687F\u93AE\u7684\u5927\u5BB6\uFF01\\n\u6211\u662F\u51A0\u8ECD\uFF0C\u4E39\u5E1D\uFF01\\c\\n\u6211\u4ECA\u5F8C\u4E5F\u6703\u5728\u6BD4\u8CFD\u5834\u4E0A\u79C0\u51FA\u6700\u5F37\u7684\u8868\u73FE\uFF0C\\n\u4E0D\u6703\u8F9C\u8CA0\u4F60\u5011\u7684\u671F\u671B\u7684\uFF01\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u679C\u771F\u662F\u7121\u6575\u7684\u51A0\u8ECD\uFF01\\n\u4F60\u548C\u5674\u706B\u9F8D\u7684\u62CD\u6A94\u771F\u662F\u592A\u68D2\u5566\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8B1D\u8B1D\uFF01\\c\\n\u6B61\u8FCE\u5927\u5BB6\u4E5F\u57F9\u80B2\u81EA\u5DF1\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u5F7C\u6B64\u591A\u591A\u5C0D\u6230\uFF01\\c\\n\u6211\u671F\u5F85\u6709\u4EBA\u4F86\u6311\u6230\u6211\u7684\u51A0\u8ECD\u982D\u929C\u5462\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6C92\u554F\u984C\uFF5E\uFF01\\n\u6211\u5011\u5C31\u662F\u56E0\u70BA\u592A\u5D07\u62DC\u4F60\u4E86\uFF0C\\r\\n\u6240\u4EE5\u958B\u59CB\u5BF6\u53EF\u5922\u5C0D\u6230\u7684\u5537\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u53EF\u662F\uFF0C\u51A0\u8ECD\u7684\u5674\u706B\u9F8D\\n\u5BE6\u5728\u662F\u592A\u5F37\u4E86\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7684\u78BA\uFF0C\u5674\u706B\u9F8D\u5F88\u5F37\uFF01\\n\u4F46\u5176\u4ED6\u7684\u5BF6\u53EF\u5922\u4E5F\u5F88\u5F37\u7684\uFF01\\c\\n\u6240\u4EE5\u6211\u624D\u6703\u671F\u5F85\u548C\\n\u6700\u5F37\u7684\u6311\u6230\u8005\u5C0D\u6230\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u7684\u5922\u60F3\u662F\\n\u4F3D\u52D2\u723E\u5730\u5340\u7684\u6BCF\u500B\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\\r\\n\u90FD\u80FD\u8B8A\u5F97\u66F4\u5F37\u5594\uFF01[VAR 0114(0004)]"
