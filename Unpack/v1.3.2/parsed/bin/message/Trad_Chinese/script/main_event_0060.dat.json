    "text": "\u8D6B\u666E\uFF01\u4F60\u9577\u9AD8\u4E86\uFF01\\n\u6211\u770B\u770B\u2026\u2026\u6B63\u597D\uFF13\u516C\u5206\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7B54\u5C0D\u4E86\uFF01\u4E0D\u6127\u662F\u5927\u54E5\uFF0C\\n\u89C0\u5BDF\u529B\u4E5F\u662F\u6240\u5411\u7121\u6575\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u9019\u773C\u775B\u7684\u984F\u8272\u2026\u2026\\n\u6211\u77E5\u9053\u4E86\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u662F[VAR 0100(0000)]\u5427\uFF1F\\n\u8D6B\u666E\u5E38\u63D0\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u5594\u3002[VAR 0114(0004)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u662F\u8D85\u611B\u5674\u706B\u9F8D\u7684\u8A13\u7DF4\u5BB6\uFF0C\\n\u4E5F\u662F\u4F3D\u52D2\u723E\u5730\u5340\u6700\u5F37\u7684\u5BF6\u53EF\u5922\u51A0\u8ECD\u3002\\r\\n\u4EBA\u7A31\u6211\u7121\u6575\u4E39\u5E1D\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5927\u54E5\uFF01[VAR 0100(0000)]\uFF01\\n\u6211\u5011\u8CFD\u8DD1\u56DE\u5BB6\u5427\uFF01[VAR 0114(0005)]"
