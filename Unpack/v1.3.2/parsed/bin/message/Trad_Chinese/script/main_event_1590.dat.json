    "text": "\u9019\u5C31\u662F\u6D1B\u8332\u5927\u5EC8\uFF01\\c\\n\u9802\u6A13\u7A76\u7ADF\u84CB\u5230\u54EA\u5152\u53BB\u5566\uFF1F\\n\u90FD\u85CF\u5728\u96F2\u88E1\uFF0C\u770B\u4E0D\u898B\u4E86\uFF01[VAR 0114(0005)]"
  },
