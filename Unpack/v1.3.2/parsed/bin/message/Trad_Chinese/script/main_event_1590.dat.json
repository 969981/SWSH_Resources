  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u65E2\u7136[VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u5DF2\u7D93\u958B\u4E86\u9019\u689D\u901A\u5411\u6D1B\u8332\u5927\u5EC8\u7684\u8DEF\uFF0C\\r\\n\u5C31\u7E7C\u7E8C\u5411\u524D\u885D\u5504\uFF01[VAR 0114(000D)]"
