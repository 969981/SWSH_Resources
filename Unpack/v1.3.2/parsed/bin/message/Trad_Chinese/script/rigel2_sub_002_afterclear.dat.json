  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u55EF\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u60F3\u7D66\u6211\u770B\u50B3\u8AAA\u4E86\uFF1F\\r\\n\u5427\u54C8\u54C8\uFF01\u6C92\u95DC\u4FC2\uFF0C\u96E3\u514D\u6703\u6709\u9019\u7A2E\u6642\u5019\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u88AB\u4EBA\u985E\u64CD\u4F5C\u57FA\u56E0\u88FD\u9020\u51FA\u4F86\u7684\\n\u51F6\u66B4\u5BF6\u53EF\u5922\uFF0C\u8D85\u5922\uFF1F\\c\\n\u81C9\u8272\u662F\u6709\uFF5E\u9EDE\u5152\u767D\u84BC\u84BC\u7684\uFF0C\\n\u4E0D\u904E\u9019\u50A2\u4F19\u770B\u8D77\u4F86\u5F88\u6EAB\u9806\u561B\uFF01\\c\\n\u96D6\u7136\u9019\u5F35\u81C9\u770B\u8D77\u4F86\u5F88\u96E3\u4F3A\u5019\uFF0C\\n\u4F46\u6211\u731C\u7260\u4E00\u5B9A\u662F\u500B\u597D\u50A2\u4F19\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u51FA\u4F86\u5566\uFF01\\n\u9019\u96BB\u50CF\u662F\u5728\u552C\u4EBA\u7684\u6025\u51CD\u9CE5\uFF01\\c\\n\u9084\u662F\u90A3\u526F\u6234\u8457\u5947\u602A\u9762\u5177\u7684\u8001\u6A23\u5B50\uFF0C\\n\u771F\u641E\u4E0D\u6E05\u695A\u7260\u7A76\u7ADF\u662F\u5728\u60F3\u4EC0\u9EBC\u2026\u2026\\c\\n\u7E3D\uFF5E\u89BA\u5F97\u6211\u597D\u50CF\u88AB\u7260\u770B\u5F97\u6241\u6241\u7684\uFF0C\\n\u662F\u6211\u60F3\u592A\u591A\u4E86\u55CE\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u54E6\u54E6\uFF01\uFF1F\u50CF\u662F\u5728\u552C\u4EBA\u7684\u6025\u51CD\u9CE5\uFF0C\\n\u4F60\u62FF\u4E0B\u90A3\u500B\u5947\u602A\u7684\u9762\u5177\u5566\uFF01\\c\\n\u9019\u6A23\u5B50\u5C31\u80FD\u770B\u5230\u4F60\u90A3\u96D9\u6709\u529B\u7684\u773C\u775B\uFF0C\\n\u61C9\u8A72\u6703\u6BD4\u8F03\u6709\u7570\u6027\u7DE3\u5594\uFF01\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u7A81\u7136\u8B8A\u51B7\u4E86\u5462\u3002\\n\u2026\u2026\u5916\u9762\u662F\u5728\u4E0B\u96EA\u55CE\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F60\u51FA\u4F86\u5566\uFF01\\n\u9019\u96BB\u50CF\u662F\u5728\u552C\u4EBA\u7684\u9583\u96FB\u9CE5\uFF01\\c\\n\u770B\u4F60\u4E00\u4E0B\u628A\u8EAB\u9AD4\u5F04\u5F97\u523A\u523A\u7684\uFF0C\\n\u4E00\u4E0B\u628A\u9CE5\u5634\u561F\u5F97\u5C16\u5C16\u7684\u3002\\c\\n\u597D\u5427\uFF01\u6211\u627F\u8A8D\u4F60\u5F88\u52AA\u529B\u60F3\\n\u7576\u4E00\u96BB\u5927\u5BB6\u516C\u8A8D\u7684\u9583\u96FB\u9CE5\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u54E6\u54E6\uFF01\uFF1F\u9019\u50A2\u4F19\uFF0C\\n\u4E00\u6478\u5230\u7260\u5C31\u6703\u523A\u523A\u9EBB\u9EBB\u7684\u54A7\uFF01\\c\\n\u50CF\u662F\u5728\u552C\u4EBA\u7684\u9583\u96FB\u9CE5\u8EAB\u4E0A\\n\u96E3\u9053\u662F\u6709\u5E36\u8457\u975C\u96FB\u55CE\uFF01\uFF1F\\c\\n\u5728\u53C8\u51B7\u53C8\u4E7E\u71E5\u7684\u5929\u6C23\uFF0C\\n\u975C\u96FB\u771F\u7684\u6703\u4EE4\u4EBA\u5F88\u96E3\u53D7\u554A\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4F60\u51FA\u4F86\u5566\uFF01\\n\u9019\u96BB\u50CF\u662F\u5728\u552C\u4EBA\u7684\u706B\u7130\u9CE5\uFF01\\c\\n\u770B\u4F60\u90A3\u5168\u8EAB\u718A\u718A\u71D2\u8457\u7684\u6A23\u5B50\uFF0C\\n\u7D50\u679C\u662F\u4E00\u9EDE\u5152\u90FD\u4E0D\u71D9\u4EBA\u54A7\uFF01\\c\\n\u90A3\u96D9\u7206\u51F6\u60E1\u7684\u773C\u795E\u8B93\u6211\u89BA\u5F97\u7279\u5225\u89AA\u5207\uFF0C\\n\u6C92\u8FA6\u6CD5\u8A0E\u53AD\u4F60\u5462\u3002[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u54E6\u54E6\uFF01\uFF1F\u9019\u50A2\u4F19\u7684\u8EAB\u9AD4\\n\u71C3\u71D2\u5F97\u4E5F\u592A\u904E\u5206\u4E86\u5427\uFF01\uFF1F\\c\\n\u50CF\u662F\u5728\u552C\u4EBA\u7684\u706B\u7130\u9CE5\u2026\u2026\\n\u96E3\u4E0D\u6210\u4F60\u662F\u767C\u71D2\u4E86\u55CE\uFF1F\\c\\n\u6CE8\u610F\u4FDD\u6696\uFF0C\u597D\u597D\u7761\u4E00\u89BA\u5427\uFF01\\n\u2026\u2026\u8981\u65E9\u65E5\u5EB7\u5FA9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u64C1\u6709\u4E03\u5F69\u7FC5\u8180\u7684\\n\u50B3\u8AAA\u7684\u5BF6\u53EF\u5922\uFF0C\u9CF3\u738B\uFF1F\\r\\n\u7D05\u8272\u3001\u767D\u8272\u3001\u9EC3\u8272\u2026\u2026\\c\\n\u8981\u8AAA\u662F\u4E03\u5F69\uFF0C\\n\u4F3C\u4E4E\u9084\u7F3A\u4E86\u4E0D\u5C11\u984F\u8272\u8036\u2026\u2026\\c\\n\u4F46\u662F\u6211\u7E3D\u4E0D\u80FD\u7838\u4E86\u968A\u9577[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u7F8E\u5922\uFF0C\\n\u6240\u4EE5\u6211\u59D1\u4E14\u5C31\u76F8\u4FE1[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u88AB\u7A31\u70BA\u6D77\u795E\u7684\u50B3\u8AAA\u7684\u5BF6\u53EF\u5922\uFF0C\u6D1B\u5947\u4E9E\uFF1F\\c\\n\u9019\u6D77\u795E\u7260\u9084\u662F\u98DB\u884C\u5C6C\u6027\u7684\u54A7\u3002\\n\u53C8\u6703\u5728\u6C34\u88E1\u6E38\uFF0C\u53C8\u6703\u5728\u5929\u4E0A\u98DB\uFF0C\\r\\n\u4EC0\u9EBC\u90FD\u6703\uFF0C\u771F\u662F\u592A\u53B2\u5BB3\u5566\uFF01\\c\\n\u5728\u9060\u65B9\u7684\u5730\u5340\u6709\u500B\u8209\u8FA6\\n\u5BF6\u53EF\u5168\u80FD\u7AF6\u6280\u8CFD\u7684\u904B\u52D5\u8A2D\u65BD\uFF0C\\r\\n\u9019\u50A2\u4F19\u4E00\u5B9A\u80FD\u5728\u90A3\u88E1\u5927\u986F\u8EAB\u624B\u5594\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u64DA\u8AAA\u662F\u5F9E\u5929\u4E0A\u548C\u96F7\u96FB\u4E00\u8D77\\n\u6389\u4E0B\u4F86\u7684\u5BF6\u53EF\u5922\u2026\u2026\u96F7\u516C\uFF1F\\c\\n\u4F60\u771F\u662F\u5403\u4E86\u4E0D\u5F97\u4E86\u7684\u82E6\u982D\u554A\uFF5E\\c\\n\u4E5F\u96E3\u602A\u4F60\u80CC\u4E0A\u7684\u6BDB\u6703\u6372\uFF5E\u8D77\u4F86\u56C9\u3002[VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u88AB\u8A8D\u70BA\u662F\u5F9E\u706B\u5C71\u7684\u7206\u767C\u4E2D\\n\u8A95\u751F\u7684\u5BF6\u53EF\u5922\u2026\u2026\u708E\u5E1D\uFF1F\\c\\n\u4E0D\u4E0D\u4E0D\uFF0C\u5929\u5E95\u4E0B\u54EA\u6709\u9019\u56DE\u4E8B\uFF01\\n\u9019\u6211\u5BE6\u5728\u662F\u7121\u6CD5\u76F8\u4FE1\uFF01\\c\\n\u9019\u9EBC\u8AAA\u4F86\uFF0C\u662F\u90A3\u500B\u55CE\uFF1F\\n\u7260\u7684\u7238\u7238\u662F\u5EA7\u706B\u5C71\uFF1F\\c\\n\u9084\u662F\u8AAA\uFF0C\u5ABD\u5ABD\u662F\u5EA7\u706B\u5C71\uFF1F\\n\u662F\u9019\u6A23\u55CE\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u54E6\uFF01\u771F\u6F02\u4EAE\u7684\u5BF6\u53EF\u5922\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u9019\u50A2\u4F19\u5C31\u662F\u6C34\u541B\uFF1F\\c\\n\u982D\u9802\u7684\u89D2\u9084\u662F\u500B\u5708\u5708\uFF0C\\n\u771F\u662F\u592A\u5E25\u5566\uFF01\\c\\n\u2026\u2026\u8A71\u8AAA\u56DE\u4F86\uFF0C\u7260\u90A3\u9846\u982D\uFF0C\\n\u8981\u600E\u9EBC\u5728\u7761\u5922\u88E1\u7FFB\u8EAB\u54EA\uFF1F\\c\\n\u7761\u89BA\u6642\u5927\u6982\u6703\u5F88\u8F9B\u82E6\u5427\uFF1F\\n\u6C34\u541B\u7260\u80FD\u597D\u597D\u7761\u98FD\u55CE\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u7260\u5C31\u662F\u88AB\u7A31\u70BA\\n\u5927\u5730\u5316\u8EAB\u7684\u5BF6\u53EF\u5922\uFF0C\u56FA\u62C9\u591A\uFF01\uFF1F\\c\\n\u8981\u662F\u7260\u771F\u7684\u50CF\u50B3\u805E\u6240\u8AAA\u7684\u90A3\u6A23\\n\u662F\u7761\u5728\u7194\u5CA9\u88E1\uFF0C\u90A3\u53EF\u5C31\u592A\u9177\u5566\uFF01\\c\\n\u6211\u4E5F\u5E38\u5E38\u53BB\u4E09\u6EAB\u6696\uFF0C\\n\u6240\u4EE5\u5B8C\u5168\u80FD\u61C2\u7260\u7684\u5FC3\u60C5\uFF01\\c\\n\u5F9E\u7194\u5CA9\u88E1\u982D\u51FA\u4F86\u7684\u6642\u5019\uFF0C\\n\u4E00\u5B9A\u662F\u8D85\uFF5E\u8212\u670D\u7684\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u7260\u5C31\u662F\u50B3\u8AAA\u4E2D\u90A3\u96BB\\n\u5275\u9020\u4E86\u5927\u6D77\u7684\u5BF6\u53EF\u5922\uFF0C\u84CB\u6B50\u5361\uFF01\uFF1F\\c\\n\u5927\u6D77\u662F\u842C\u7269\u4E4B\u6BCD\u2026\u2026\\n\u7260\u662F\u842C\u7269\u4E4B\u6BCD\u4E4B\u6BCD\u3002\u9019\u662F\u600E\u9EBC\u56DE\u4E8B\uFF01\uFF1F\\c\\n\u9019\u6A23\u8AAA\u4F86\uFF0C\u7260\u4E0D\u5C31\u662F\\n\u54B1\u5011\u7684\u5976\u5976\u2026\u2026\uFF1F\\c\\n\u5582\u5582\u2026\u2026\u968A\u9577\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u8981\u5C0D\u84CB\u6B50\u5361\u6EAB\u67D4\u9EDE\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u5565\uFF1F\u70C8\u7A7A\u5750\uFF1F\\n\u68F2\u606F\u5728\u9059\u9060\u9AD8\u7A7A\u7684\u81ED\u6C27\u5C64\u7684\u5BF6\u53EF\u5922\uFF1F\\c\\n\u4F4F\u5230\u7A7A\u6C23\u90A3\u9EBC\u7A00\u8584\u7684\u5730\u65B9\u53BB\uFF0C\\n\u6839\u672C\u5C31\u662F\u904B\u52D5\u9078\u624B\u561B\uFF01\\c\\n\u54CE\uFF0C\u5F9E\u9577\u76F8\u770B\u4F86\u4E5F\u78BA\u5BE6\u662F\\n\u4E00\u526F\u5C0D\u81EA\u5DF1\u5F88\u56B4\u683C\u7684\u6A23\u5B50\uFF01\\c\\n\u96D6\u7136\u6211\u4E0D\u77E5\u9053\u4F60\u5728\u62FC\u4EC0\u9EBC\u904B\u52D5\uFF0C\\n\u4E0D\u904E\u4F60\u597D\u597D\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u80FD\u900F\u904E\u5FC3\u9748\u611F\u61C9\\n\u611F\u77E5\u4EBA\u5FC3\u7684\u5BF6\u53EF\u5922\uFF0C\u62C9\u5E1D\u4E9E\u65AF\u554A\u2026\u2026\\c\\n\u4E00\u5F35\u81C9\u9577\u5F97\u53EF\u53EF\u611B\u611B\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u7ADF\u7136\u662F\u90A3\uFF5E\u9EBC\u53B2\u5BB3\u7684\u50A2\u4F19\uFF01\\c\\n\u597D\uFF01\u59B3\u731C\u731C\u6211\u73FE\u5728\u6B63\u5728\u60F3\u4E9B\u4EC0\u9EBC\u5427\uFF01\\c\\n\u2026\u2026\u7B49\u7B49\uFF0C\u8981\u662F\u771F\u7684\u88AB\u731C\u4E2D\u7684\u8A71\uFF0C\\n\u90A3\u4E5F\u592A\u6050\u6016\u5566\uFF01\u7576\u6211\u6C92\u8AAA\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u64C1\u6709\u5F88\u9AD8\u7684\u667A\u6167\uFF0C\\n\u80FD\u7406\u89E3\u4EBA\u985E\u8A9E\u8A00\u7684\u5BF6\u53EF\u5922\uFF0C\u62C9\u5E1D\u6B50\u65AF\u2026\u2026\uFF1F\\c\\n\u9019\u8981\u662F\u771F\u7684\uFF0C\u90A3\u53EF\u5C31\u53B2\u5BB3\u56C9\u3002\\n\u4F46\u662F\u6211\u6C92\u8FA6\u6CD5\u4E00\u4E0B\u5B50\u5C31\u76F8\u4FE1\u8036\u3002\\c\\n\u5927\u5BB6\u90FD\u8AAA\u4F60\u59B9\u59B9\u662F\u90A3\u500B\\n\u53EB\u505A\u62C9\u5E1D\u4E9E\u65AF\u7684\u5BF6\u53EF\u5922\u662F\u5427\uFF1F\\c\\n\u9019\u6A23\u554A\u2026\u2026\u4F60\u662F\u54E5\u54E5\u554A\u2026\u2026\\n\u5C0D\u59B9\u59B9\u8981\u597D\u4E00\u9EDE\u5594\uFF0C\u54E5\u54E5\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u4F60\u51FA\u4F86\u5566\uFF01\\n\u77EE\u77EE\u7684\u5CA9\u77F3\u5DE8\u4EBA\uFF01\\c\\n\u2026\u2026\u5427\u54C8\u54C8\uFF01\\n\u6211\u662F\u5728\u958B\u4F60\u73A9\u7B11\uFF0C\u5C0D\u4E0D\u8D77\u5566\uFF01\\c\\n\u6211\u5C0D\u4F60\u90A3\u5BEC\u539A\u7684\u80A9\u8180\\n\u662F\u6253\uFF5E\u5F9E\u5FC3\u5E95\u656C\u4F69\u5462\uFF01\\c\\n\u4EE5\u5F8C\u4E5F\u8981\u51F9\u51F8\u51F8\u5730\u597D\u597D\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u4F60\u51FA\u4F86\u5566\uFF01\\n\u77EE\u77EE\u7684\u51B0\u4E4B\u5DE8\u4EBA\uFF01\\c\\n\u2026\u2026\u5427\u54C8\u54C8\uFF01\\n\u6211\u662F\u5728\u958B\u4F60\u73A9\u7B11\uFF0C\u5C0D\u4E0D\u8D77\u5566\uFF01\\c\\n\u6211\u5C0D\u4F60\u90A3\u7C97\u58EF\u7684\u624B\u81C2\uFF0C\\n\u662F\u6253\uFF5E\u5F9E\u5FC3\u5E95\u8B9A\u8CDE\u5462\uFF01\\c\\n\u4EE5\u5F8C\u4E5F\u8981\u51B0\u51CC\u51CC\u5730\u597D\u597D\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u4F60\u51FA\u4F86\u5566\uFF01\\n\u77EE\u77EE\u7684\u92FC\u4E4B\u5DE8\u4EBA\uFF01\\c\\n\u2026\u2026\u5427\u54C8\u54C8\uFF01\\n\u6211\u662F\u5728\u958B\u4F60\u73A9\u7B11\uFF0C\u5C0D\u4E0D\u8D77\u5566\uFF01\\c\\n\u4F60\u90A3\u50CF\u662F\u9846\u4FDD\u9F61\u7403\u4F3C\u7684\u9AD4\u578B\\n\u5F88\uFF5E\u5E25\u7684\uFF0C\u653E\u5FC3\u5427\uFF01\\c\\n\u4EE5\u5F8C\u4E5F\u8981\u6ED1\u6E9C\u6E9C\u5730\u597D\u597D\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u7260\u662F\u80FD\u5920\u64CD\u7E31\u6642\u9593\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u5E1D\u7259\u76E7\u5361\uFF5E\uFF1F\\c\\n\u8981\u662F\u771F\u7684\u6709\u90A3\u7A2E\u80FD\u529B\uFF0C\\n\u90A3\u6211\u60F9\u5C0F\u590F\u590F\u751F\u6C23\u7684\u6642\u5019\uFF0C\\r\\n\u53EF\u4E0D\u53EF\u4EE5\u8ACB\u7260\u5E6B\u6211\u628A\u6642\u9593\u5012\u8F49\u4E00\u4E0B\uFF1F\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u9019\u50A2\u4F19\u7684\u53EB\u8072\\n\u672A\u514D\u4E5F\u592A\u6709\u500B\u6027\u3001\u592A\u5E25\u4E86\u5427\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u7260\u662F\u80FD\u5920\u64CD\u7E31\u7A7A\u9593\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u5E15\u8DEF\u5947\u4E9E\uFF5E\uFF1F\\c\\n\u8981\u662F\u771F\u7684\u6709\u90A3\u7A2E\u80FD\u529B\uFF0C\\n\u5373\u4F7F\u5C0F\u590F\u590F\u8DD1\u8D70\u4E86\uFF0C\\r\\n\u4E5F\u80FD\u4E00\u77AC\u9593\u5C31\u8FFD\u4E0A\u5979\u3002\u597D\u65B9\u4FBF\u54EA\uFF01\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u9019\u50A2\u4F19\u7684\u53EB\u8072\\n\u672A\u514D\u4E5F\u592A\u6709\u500B\u6027\u3001\u592A\u5E25\u4E86\u5427\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u68F2\u606F\u5728\u9019\u500B\u4E16\u754C\u7684\u80CC\u9762\u4E16\u754C\u7684\\n\u5BF6\u53EF\u5922\uFF0C\u9A0E\u62C9\u5E1D\u7D0D\uFF5E\uFF1F\\c\\n\u80CC\u9762\u662F\u6307\u9019\u500B\u661F\u7403\u7684\u53E6\u4E00\u5074\u5C0D\u5427\uFF01\uFF1F\\c\\n\u4F60\u4F86\u81EA\u90A3\u9EBC\u9059\u9060\u7684\u5730\u65B9\u554A\uFF01\\n\u9019\u9EBC\u9060\u7684\u4E00\u8D9F\u8DEF\uFF0C\u771F\u662F\u8F9B\u82E6\u56C9\uFF01\\c\\n\u4E0D\u904E\uFF0C\u4F60\u597D\u50CF\u80FD\u54BB\uFF5E\u5730\u98DB\u4F86\u98DB\u53BB\uFF0C\\n\u5230\u9019\u88E1\u4F86\u8AAA\u4E0D\u5B9A\u662F\u5C0F\u4E8B\u4E00\u6A01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u638C\u7BA1\u667A\u6167\u7684\u5BF6\u53EF\u5922\uFF0C\u7531\u514B\u5E0C\uFF1F\\c\\n\u771F\u597D\uFF01\u6211\u554A\uFF5E\\n\u5728\u67D0\u4E9B\u65B9\u9762\u7E3D\u662F\u5C11\u6839\u7B4B\uFF0C\\r\\n\u4E0D\u5982\u8B93\u6211\u6CBE\u6CBE\u5149\u5427\uFF01\\c\\n\u7531\u514B\u5E0C\u554A\uFF5E\u7531\u514B\u5E0C\uFF5E\\n\u8ACB\u591A\u591A\u7167\u9867\u6211\u554A\uFF5E\uFF01\\c\\n\u54E6\uFF01\u6211\u597D\uFF5E\u50CF\u6709\u8B8A\u6210\\n\u77E5\u8B58\u5206\uFF5E\u5B50\u7684\u611F\u89BA\u56C9\uFF01\u5427\u54C8\u54C8\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u7D66\u4EBA\u985E\u5E36\u4F86\u611F\u60C5\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u827E\u59C6\u5229\u591A\uFF1F\\c\\n\u6211\u554A\uFF5E\u6709\u6642\u5019\\n\u5C31\u662F\u6703\u71B1\u60C5\u904E\u982D\u4E00\u9EDE\u9EDE\u3002\\c\\n\u662F\u4E0D\u662F\u90FD\u8981\u602A\u90A3\u50A2\u4F19\\n\u7D66\u4E86\u6211\u592A\u591A\u611F\u60C5\u5440\uFF01\uFF1F\\r\\n\u2026\u2026\u6211\u53EA\u662F\u958B\u73A9\u7B11\u7684\u5566\uFF01\\c\\n\u54CE\uFF01\u6211\u80FD\u6BD4\u5176\u4ED6\u4EBA\u9084\u8981\\n\u66F4\uFF5E\u9AD8\u8208\u3001\u66F4\uFF5E\u50B7\u5FC3\u2026\u2026\\r\\n\u9019\u7A2E\u4EBA\u751F\u4E5F\u7B97\u662F\u8CFA\u5230\u4E86\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u80FD\u5E36\u4F86\u5C0D\u6297\u56F0\u96E3\u7684\u5805\u5F37\u610F\u5FD7\u7684\\n\u5BF6\u53EF\u5922\uFF0C\u4E9E\u514B\u8AFE\u59C6\uFF5E\uFF1F\\c\\n\u50CF\u662F\u4E0D\u60F3\u8D77\u5E8A\uFF0C\\n\u6216\u662F\u61F6\u5F97\u6383\u5730\u7684\u6642\u5019\uFF0C\\c\\n\u53EA\u8981\u9019\u50A2\u4F19\u5728\uFF0C\\n\u5C31\u80FD\u7ACB\u523B\u632F\u4F5C\uFF0C\u4FD0\u843D\u884C\u52D5\u55CE\uFF01\uFF1F\\c\\n\u7C21\u76F4\u662F\u6BCF\u5BB6\u5FC5\u5099\u4E00\u96BB\u4E9E\u514B\u8AFE\u59C6\uFF01\\n\u6211\u4E5F\u60F3\u53BB\u6349\u4E00\u96BB\u56C9\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u706B\u5C71\u53E3\u5BF6\u53EF\u5922\uFF0C\u5E2D\u591A\u85CD\u6069\u2026\u2026\uFF1F\\c\\n\u9019\u77EE\u77EE\u80D6\u80D6\u7684\u8EAB\u6750\u2026\u2026\uFF01\\n\u4E00\u526F\u53DB\u9006\u7684\u8868\u60C5\u2026\u2026\uFF01\\c\\n\u4E16\u4E0A\u600E\u9EBC\u6703\u6709\u9019\u9EBC\\n\u7206\u53EF\u611B\u7684\u5BF6\u53EF\u5922\u554A\uFF01\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5230\u5E95\u662F\u5728\u54EA\u88E1\u6349\u5230\u7260\u7684\uFF1F\\n\u4E0D\u7BA1\u7260\u662F\u4E0D\u662F\u50B3\u8AAA\uFF0C\\r\\n\u6211\u90FD\u60F3\u628A\u7260\u52A0\u5165\u6211\u7684\u540C\u884C\u968A\u4F0D\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u54C7\u5594\uFF01\uFF1F\u90A3\u50A2\u4F19\u8A72\u4E0D\u6703\u5C31\u662F\\n\u5DE8\u4EBA\u50B3\u8AAA\u7684\u5927\u982D\u76EE\u5427\uFF1F\\c\\n\u500B\u982D\u9AD8\u5927\u6210\u9019\u6A23\uFF0C\\n\u679C\u7136\u5C31\u8D85\u6709\u5DE8\u4EBA\u7684\u611F\u89BA\u5566\uFF01\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u7260\u8EAB\u4E0A\u9019\u9EBC\u591A\u9EDE\u9EDE\uFF0C\\n\u6211\u90FD\u641E\u4E0D\u6E05\u695A\u54EA\u500B\u624D\u662F\u773C\u775B\u4E86\u3002\\c\\n\u548C\u9019\u50A2\u4F19\u8B1B\u8A71\u7684\u6642\u5019\uFF0C\\n\u662F\u8A72\u770B\u54EA\u88E1\u5440\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u65B0\u6708\u7684\u5316\u8EAB\uFF0C\u514B\u96F7\u8272\u5229\u4E9E\uFF01\\n\u771F\u662F\u6F02\u4EAE\u7684\u5BF6\u53EF\u5922\u554A\uFF5E\uFF01\\c\\n\u4E0D\u904E\uFF0C\u90A3\u50A2\u4F19\u80CC\u4E0A\u7684\u5708\u5708\uFF0C\\n\u770B\u8D77\u4F86\u633A\u786C\u7684\u5462\u3002\\c\\n\u7260\u80FD\u597D\u597D\u8EBA\u4E0B\u4F86\u7761\u89BA\u55CE\uFF1F\\n\u9019\u6A23\u80FD\u5728\u7761\u5922\u88E1\u7FFB\u8EAB\u55CE\uFF1F\\r\\n\u55EF\u2026\u2026\u6211\u958B\u59CB\u70BA\u7260\u64D4\u5FC3\u4E86\u8036\u3002[VAR 0114(0076)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u5443\u554A\uFF01\uFF1F\u90A3\u96BB\u5BF6\u53EF\u5922\uFF0C\\n\u5C3E\u5DF4\u662F\u4E0D\u662F\u71D2\u8D77\u4F86\u5566\uFF01\uFF1F\\c\\n\u4EC0\u9EBC\uFF1F[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u7260\u662F\u80FD\u7528\u706B\u7130\\n\u628A\u4E16\u754C\u71C3\u71D2\u6B86\u76E1\u7684\u5BF6\u53EF\u5922\uFF5E\uFF1F\\c\\n\u96A8\u8EAB\u5E36\u8457\u90A3\u9EBC\u5371\u96AA\u7684\u50A2\u4F19\uFF0C\\n\u9084\u4E00\u81C9\u82E5\u7121\u5176\u4E8B\u7684\u6A23\u5B50\uFF0C\\r\\n\u968A\u9577[VAR 1100(00FF,0101)]\u4F60\u59B3\u672A\u514D\u4E5F\u592A\u81BD\u5927\u5305\u5929\u4E86\u5427\uFF01\\c\\n\u8981\u7576\u5FC3\u5225\u71D9\u50B7\u5594\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u5443\u554A\uFF01\uFF1F\u90A3\u96BB\u5BF6\u53EF\u5922\uFF0C\\n\u5288\u54E9\u556A\u5566\u5730\u731B\u5728\u653E\u96FB\u8036\uFF01\uFF1F\\c\\n\u4EC0\u9EBC\uFF1F[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u7260\u662F\u80FD\u7528\u9583\u96FB\\n\u628A\u4E16\u754C\u71C3\u71D2\u6B86\u76E1\u7684\u5BF6\u53EF\u5922\uFF5E\uFF1F\\c\\n\u96A8\u8EAB\u5E36\u8457\u90A3\u9EBC\u5371\u96AA\u7684\u50A2\u4F19\uFF0C\\n\u9084\u4E00\u81C9\u82E5\u7121\u5176\u4E8B\u7684\u6A23\u5B50\uFF0C\\r\\n\u968A\u9577[VAR 1100(00FF,0101)]\u4F60\u59B3\u672A\u514D\u4E5F\u592A\u81BD\u5927\u5305\u5929\u4E86\u5427\uFF01\\c\\n\u8981\u7576\u5FC3\u5225\u88AB\u96FB\u7126\u5594\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u547C\uFF5E\u51CD\u6B7B\u4EBA\u5566\uFF01\\n\u6211\u6B63\u89BA\u5F97\u600E\u9EBC\u9019\u9EBC\u51B7\uFF0C\\r\\n\u539F\u4F86\u662F\u90A3\u96BB\u53EB\u914B\u96F7\u59C6\u7684\u50A2\u4F19\u5728\u641E\u9B3C\u554A\uFF01\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u7ADF\u7136\u6703\u88AB\u81EA\u5DF1\u7684\u5BD2\u6C23\u7D66\u51CD\u4F4F\uFF0C\\n\u771F\u662F\u500B\u5C0F\u6DD8\u6C23\uFF01\\c\\n\u770B\u8457\u7260\u90A3\u8EAB\u9AD4\u7E3D\uFF5E\u89BA\u5F97\u597D\u50CF\\n\u53EF\u4EE5\u5206\u958B\u4F86\u53C8\u9ECF\u8D77\u4F86\u4F3C\u7684\uFF0C\u771F\u795E\u5947\u554A\u2026\u2026\uFF1F\\c\\n\u5509\u5440\uFF0C\u6211\u8AAA\u4E86\u6C92\u79AE\u8C8C\u7684\u8A71\u5462\u3002\\n\u771F\u662F\u5C0D\u4E0D\u8D77\u5566\uFF0C\u914B\u96F7\u59C6\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "[~ 47]"
  },
