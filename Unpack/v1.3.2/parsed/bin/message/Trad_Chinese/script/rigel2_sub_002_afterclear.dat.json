    "text": "[~ 49]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\u3001\u7B49\u4E00\u4E0B\uFF0C\\n\u90A3\u50A2\u4F19\u4E5F\u662F\u50B3\u8AAA\u7684\u5BF6\u53EF\u5922\u55CE\uFF01\uFF1F\\c\\n\u600E\u9EBC\u9577\u5F97\u548C\u6211\u7684\u9130\u5C45\\n\u7C21\u76F4\u662F\u4E00\u500B\u6A21\u5B50\u58D3\u51FA\u4F86\u7684\uFF01\uFF1F\\c\\n\u65CB\u98A8\u5BF6\u53EF\u5922\uFF0C\\n\u9F8D\u6372\u96F2\u554A\u2026\u2026\\c\\n\u5F15\u8D77\u7684\u66B4\u98A8\u96E8\uFF0C\\n\u5A01\u529B\u8DB3\u4EE5\u5C07\u6574\u68DF\u623F\u5C4B\u5439\u8D70\uFF0C\\r\\n\u7260\u9019\u4E00\u9EDE\u5C31\u548C\u6211\u7684\u9130\u5C45\u4E0D\u540C\u4E86\u3002[VAR 0114(0076)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\u3001\u7B49\u4E00\u4E0B\uFF0C\\n\u90A3\u50A2\u4F19\u4E5F\u662F\u50B3\u8AAA\u7684\u5BF6\u53EF\u5922\u55CE\uFF01\uFF1F\\c\\n\u600E\u9EBC\u9577\u5F97\u548C\u6211\u7684\u9130\u5C45\\n\u7C21\u76F4\u662F\u4E00\u500B\u6A21\u5B50\u58D3\u51FA\u4F86\u7684\uFF01\uFF1F\\c\\n\u96F7\u64CA\u5BF6\u53EF\u5922\uFF0C\\n\u96F7\u96FB\u96F2\u554A\u2026\u2026\\c\\n\u6703\u5728\u7A7A\u4E2D\u98DB\u4F86\u98DB\u53BB\uFF0C\\n\u88FD\u9020\u843D\u96F7\uFF0C\\r\\n\u7260\u9019\u4E00\u9EDE\u5C31\u548C\u6211\u7684\u9130\u5C45\u4E0D\u540C\u4E86\u3002[VAR 0114(0076)]"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\u3001\u7B49\u4E00\u4E0B\uFF0C\\n\u90A3\u50A2\u4F19\u4E5F\u662F\u50B3\u8AAA\u7684\u5BF6\u53EF\u5922\u55CE\uFF01\uFF1F\\c\\n\u600E\u9EBC\u9577\u5F97\u548C\u6211\u7684\u9130\u5C45\\n\u7C21\u76F4\u662F\u4E00\u500B\u6A21\u5B50\u58D3\u51FA\u4F86\u7684\uFF01\uFF1F\\c\\n\u8C50\u9952\u5BF6\u53EF\u5922\uFF0C\u571F\u5730\u96F2\uFF01\\n\u9019\u4E0D\u662F\u548C\u8C50\u9952\u4E4B\u738B\u649E\u540D\u4E86\u55CE\uFF1F\\c\\n\u50B3\u8AAA\u7260\u6703\u53BB\u61F2\u7F70\\n\u70BA\u975E\u4F5C\u6B79\u7684\u50A2\u4F19\u5440\u3002\\r\\n\u9023\u9019\u4E00\u9EDE\u90FD\u548C\u6211\u7684\u9130\u5C45\u4E00\u6A23\u8036\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u6703\u5206\u4EAB\u6C38\u6046\u751F\u547D\u7684\\n\u751F\u547D\u5BF6\u53EF\u5922\uFF0C\u54F2\u723E\u5C3C\u4E9E\u65AF\uFF01\uFF1F\\c\\n\u9019\u8981\u662F\u771F\u7684\uFF0C\u90A3\u5C31\u592A\u70AB\u4E86\uFF0C\\n\u4E0D\u904E\u7260\u982D\u4E0A\u7684\u89D2\uFF0C\u624D\u662F\u70AB\u7206\u5566\uFF01\\c\\n\u8A71\u8AAA\uFF0C\u7260\u6C23\u6D3E\u6210\u9019\u500B\u6A23\u5B50\uFF0C\\n\u7761\u89BA\u6642\u61C9\u8A72\u662F\u5F88\u96E3\u7FFB\u8EAB\u2026\u2026\\c\\n\u53CD\u6B63\u7260\u80FD\u6C38\u9060\u6D3B\u4E0B\u53BB\uFF0C\\n\u6240\u4EE5\u7761\u7720\u54C1\u8CEA\u4E0D\u597D\u4E5F\u6C92\u95DC\u4FC2\u662F\u55CE\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\u6703\u5438\u5149\u751F\u7269\u751F\u547D\u7684\u7834\u58DE\u5BF6\u53EF\u5922\uFF0C\\n\u4F0A\u88F4\u723E\u5854\u723E\uFF01\uFF1F\\c\\n\u660E\u660E\u770B\u8D77\u4F86\u662F\u4E00\u526F\u55B2\u547C\uFF5E\u7684\u6A23\u5B50\uFF0C\\n\u7D50\u679C\u4E00\u9EDE\u90FD\u4E0D\u55B2\u547C\uFF5E\u554A\uFF01\\c\\n\u4F60\u597D\u6B79\u4E5F\u4ED4\u7D30\u60F3\u4E00\u4E0B\uFF0C\\n\u90A3\u4E9B\u88AB\u5438\u5149\u751F\u547D\u7684\u50A2\u4F19\u6703\u662F\u4EC0\u9EBC\u5FC3\u60C5\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u7531\u5C0F\u5C0F\u7684\u7D30\u80DE\u805A\u96C6\u69CB\u6210\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u57FA\u683C\u723E\u5FB7\u2026\u2026\\c\\n\u6210\u8A9E\u8AAA\uFF0C\u7A4D\u6C99\u6210\u90A3\u500B\u4EC0\u9EBC\uFF01\\n\u7C21\u76F4\u5C31\u662F\u9019\u50A2\u4F19\u561B\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u6211\u7B97\u662F\u4E0A\u4E86\u5E74\u7D00\uFF0C\\n\u4F46\u662F\u809A\u5B50\u4E00\u9EDE\u90FD\u4E0D\u5927\u3002\\c\\n\u9019\u4E5F\u662F\u56E0\u70BA\\n\u6211\u6BCF\u5929\u90FD\u5728\u935B\u934A\u8EAB\u9AD4\uFF01\\r\\n\u63DB\u53E5\u8A71\u8AAA\u5C31\u662F\u6536\u96C6\u6C99\u5B50\uFF01\\c\\n\u57FA\u683C\u723E\u5FB7\u61C2\u5F97\u9019\u4E00\u9EDE\uFF0C\\n\u771F\u662F\u4E86\u4E0D\u8D77\u554A\uFF5E\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\u65E5\u8F2A\u5BF6\u53EF\u5922\uFF0C\u7D22\u723E\u8FE6\u96F7\u6B50\uFF01\\n\u597D\u6709\u592A\uFF5E\u967D\uFF5E\u7684\u611F\u89BA\uFF01\\c\\n\u8981\u662F\u7260\u771F\u7684\u80FD\u628A\u665A\u4E0A\u7167\u5F97\\n\u50CF\u767D\u5929\u4E00\u6A23\u4EAE\uFF0C\u90A3\u5C31\u592A\u5F37\u5566\uFF01\\c\\n\u9084\u4E0D\u60F3\u56DE\u5BB6\u7684\u6642\u5019\uFF0C\\n\u9019\u50A2\u4F19\u5C31\u592A\u597D\u7528\u4E86\uFF01\\c\\n\u55EF\uFF1F\u800C\u4E14\u7260\u9084\u662F\u5176\u4ED6\u4E16\u754C\u7684\u5BF6\u53EF\u5922\uFF01\uFF1F\\n\u771F\u662F\u9A5A\u5947\u6EFF\u8F09\u8036\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\u6708\u8F2A\u5BF6\u53EF\u5922\uFF0C\u9732\u5948\u96C5\u62C9\uFF01\\n\u597D\u6709\u6708\uFF5E\u4EAE\uFF5E\u7684\u611F\u89BA\uFF01\\c\\n\u8981\u662F\u7260\u771F\u7684\u80FD\u8B93\u767D\u5929\\n\u660F\u6697\u5F97\u50CF\u662F\u534A\u591C\uFF0C\u90A3\u5C31\u592A\u5F37\u5566\uFF01\\c\\n\u65E9\u4E0A\u9084\u60F3\u7E7C\u7E8C\u7761\u7684\u6642\u5019\uFF0C\\n\u9019\u50A2\u4F19\u5C31\u592A\u597D\u7528\u4E86\uFF01\\c\\n\u55EF\uFF1F\u800C\u4E14\u7260\u9084\u662F\u5176\u4ED6\u4E16\u754C\u7684\u5BF6\u53EF\u5922\uFF01\uFF1F\\n\u771F\u662F\u9A5A\u5947\u6EFF\u8F09\u8036\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\u7A1C\u93E1\u5BF6\u53EF\u5922\uFF0C\u5948\u514B\u6D1B\u8332\u746A\uFF1F\\n\u770B\u7260\u5012\u662F\u5168\u8EAB\u9ED1\u6FDB\u6FDB\u7684\uFF0C\\r\\n\u4E00\u9EDE\u7A1C\u93E1\u611F\u90FD\u6C92\u6709\u5440\uFF1F\\c\\n\u4EC0\u9EBC\uFF01\uFF1F\u7260\u662F\u5F9E\u5176\u4ED6\u4E16\u754C\\n\u8DD1\u4F86\u9019\u88E1\u5C0B\u627E\u5149\u7684\uFF1F\\c\\n\u90A3\u5982\u679C\u7260\u66F4\u5E38\u5F85\u5728\u5916\u9762\uFF0C\\n\u6709\u7CBE\u795E\u5730\u66EC\u8457\u967D\u5149\u7684\u8A71\uFF0C\\c\\n\u61C9\u8A72\u5C31\u6703\u6210\u70BA\u4E00\u500B\u9583\u9583\u767C\u5149\u7684\\n\u5065\u5EB7\u5BF6\u5BF6\u4E86\u5427\uFF01\u8981\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\u5BC4\u751F\u5BF6\u53EF\u5922\uFF0C\u865B\u543E\u4F0A\u5FB7\uFF01\\n\u54E6\u5594\uFF5E\u8EDF\u8EDF\u7DBF\u7DBF\u7684\uFF01\\c\\n\u8981\u662F\u628A\u7260\u6234\u5728\u982D\u4E0A\u4EE3\u66FF\u6795\u982D\uFF0C\\n\u597D\u50CF\u6703\u5F88\uFF5E\u8212\u670D\u554A\uFF01\\c\\n\u6211\u90A3\u500B\u4E00\u7D1A\u68D2\u7684\u6795\u982D\\n\u88AB\u968A\u9577[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u53BB\u7528\u4E86\uFF0C\\c\\n\u4E0D\u5982\u8B93\u6211\u6234\u4E0A\u865B\u543E\u4F0A\u5FB7\\n\u7576\u4F5C\u6795\u982D\u5427\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u597D\u4E0D\u597D\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\u81A8\u8139\u5BF6\u53EF\u5922\uFF0C\u7206\u808C\u868A\uFF01\\n\u5427\u54C8\u54C8\uFF01\u597D\u9A5A\u4EBA\u7684\u808C\u8089\u554A\uFF01\\c\\n\u6211\u81EA\u8A8D\u70BA\u662F\u4E0D\u6703\u8F38\u7D66\\n\u5927\u90E8\u5206\u7684\u50A2\u4F19\uFF0C\\c\\n\u4E0D\u904E\u5C0D\u4F60\u9019\u8EAB\u808C\u8089\uFF0C\\n\u6211\u771F\u7684\u662F\u8209\u8D77\u96D9\u624B\u6295\u964D\u56C9\uFF01\\c\\n\u597D\uFF01\u54B1\u5011\u4E0B\u6B21\u4E00\u8D77\u53BB\u5065\u8EAB\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\u7F8E\u8277\u5BF6\u53EF\u5922\uFF0C\u8CBB\u6D1B\u7F8E\u8782\uFF01\\n\u9019\u5BF6\u53EF\u5922\u7206\u6F02\u4EAE\u5F97\u50CF\u662F\u5929\u4ED9\u54EA\u3002\\c\\n\u5E78\u6703\u5E78\u6703\uFF0C\\n\u54B1\u5011\u63E1\u500B\u624B\u5427\uFF1F\\c\\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\c\\n\u6211\u8AAA\uFF0C\u7260\u4E00\u76F4\u4E0D\u7406\u6211\uFF0C\\n\u662F\u56E0\u70BA\u6211\u505A\u932F\u4E86\u4EC0\u9EBC\u4E8B\u55CE\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\u71C8\u98FE\u5BF6\u53EF\u5922\uFF0C\u96FB\u675F\u6728\uFF01\\n\u4F60\u9019\u6A23\u523A\u523A\u7684\uFF0C\u662F\u60F3\u5E79\u4EC0\u9EBC\u554A\uFF01\uFF1F\\c\\n\u90A3\u96D9\u624B\u8173\u770B\u8D77\u4F86\u50CF\u662F\u63D2\u982D\uFF0C\\n\u8981\u662F\u63D2\u9032\u63D2\u5EA7\u88E1\uFF0C\\r\\n\u662F\u4E0D\u662F\u6703\u767C\u5149\u5440\uFF01\\c\\n\u5230\u6642\u5019\u7A76\u7ADF\u6703\u662F\u600E\u9EBC\u6A23\u7684\u767C\u5149\u6CD5\uFF0C\\n\u5BE6\u5728\u662F\u592A\u4EE4\u6211\u597D\u5947\u4E86\uFF01\\c\\n\u2026\u2026\u4F46\u662F\uFF0C\u4E00\u60F3\u5230\u96FB\u8CBB\u5E33\u55AE\u6211\u5C31\u6015\u6015\uFF0C\\n\u9084\u662F\u7B97\u4E86\u5427\u3002[VAR 0114(0076)]"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\u62D4\u5200\u5BF6\u53EF\u5922\uFF0C\u7D19\u5FA1\u528D\uFF5E\uFF1F\\n\u968A\u9577\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5225\u958B\u6211\u73A9\u7B11\u4E86\u2026\u2026\\c\\n\u9019\u600E\u9EBC\u770B\u90FD\u662F\\n\u5225\u4EBA\u647A\u597D\u7684\u647A\u7D19\u554A\uFF01\\c\\n\u4E0D\u904E\u4ED4\u7D30\u4E00\u77A7\uFF0C\u9019\u624B\u5DE5\u771F\u7D30\uFF0C\\n\u8B93\u6211\u90FD\u8981\u770B\u5F97\u51FA\u795E\u5566\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u7576\u5FC3\u5225\u8B93\u98A8\u628A\u9019\u6771\u897F\u5439\u8D70\u4E86\uFF0C\\n\u6216\u662F\u4E0D\u5C0F\u5FC3\u4E1F\u9032\u6C34\u88E1\u53BB\u6D17\u5594\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\u9019\u2026\u2026\u9019\u8EAB\u9AD4\u597D\u9AD8\uFF5E\uFF5E\u5927\u554A\uFF01\uFF01\\c\\n\u5509\u5440\u2026\u2026\u6211\u592A\u9A5A\u8A1D\u4E86\uFF0C\\n\u5FCD\u4E0D\u4F4F\u5C31\u53EB\u51FA\u8072\u4F86\u5566\u2026\u2026\\c\\n\u767C\u5C04\u5BF6\u53EF\u5922\uFF0C\u9435\u706B\u8F1D\u591C\u662F\u55CE\u3002\\n\u80FD\u5920\u9AD8\u901F\u5728\u7A7A\u4E2D\u98DB\u884C\uFF0C\\r\\n\u5F9E\u624B\u81C2\u5674\u51FA\u6C23\u9AD4\u71D2\u6389\u5468\u570D\u7684\u6771\u897F\uFF1F\\c\\n\u8001\u5BE6\u8AAA\uFF0C\u9664\u4E86\u592A\u52C1\u7206\u4E86\u4E4B\u5916\uFF0C\\n\u6211\u64E0\u4E0D\u51FA\u5176\u4ED6\u611F\u60F3\u4F86\u5566\uFF01\\c\\n\u4E0D\u904E\uFF0C\u7260\u8DDF\u968A\u9577[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u89AA\u5BC6\u5462\u3002\\n\u2026\u2026[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u50CF\u8001\u662F\u6703\u88AB\u5947\u602A\u7684\u50A2\u4F19\u559C\u6B61\u4E0A\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\u7570\u98DF\u5BF6\u53EF\u5922\uFF0C\u60E1\u98DF\u5927\u738B\uFF1F\\c\\n\u7684\u78BA\u554A\uFF0C\u7260\u73FE\u5728\u4E5F\u662F\\n\u5C08\u5FC3\u5730\u5728\u5403\u8457\u9019\u9644\u8FD1\u7684\u5783\u573E\uFF0C\\r\\n\u7784\u90FD\u4E0D\u7784\u54B1\u5011\u4E00\u773C\u5462\u3002\\c\\n\u563F\uFF0C\u6211\u8AAA\u554A\uFF01\u4E0D\u6311\u98DF\uFF0C\\n\u662F\u4E00\u4EF6\u597D\u4E8B\u5594\uFF01\u8CAA\u5403\u9B3C\uFF01\\c\\n\u8981\u662F\u6211\u6709\u4EC0\u9EBC\u4E0D\u597D\u8655\u7406\u7684\u5783\u573E\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u628A\u9019\u50A2\u4F19\u501F\u7D66\u6211\u5427\uFF01\u968A\u9577\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\u4F86\u81EA\u7570\u4E16\u754C\u7684\u6BD2\u91DD\u5BF6\u53EF\u5922\uFF0C\\n\u6BD2\u8C9D\u6BD4\uFF1F\\c\\n\u9019\u9577\u76F8\u78BA\u5BE6\u662F\u4E0D\u5E38\u898B\uFF0C\\n\u4E0D\u904E\u53EA\u8981\u536F\u8D77\u52C1\u4F86\uFF0C\\r\\n\u597D\u50CF\u5C31\u80FD\u5728\u8DEF\u908A\u7684\u8349\u53E2\u88E1\u627E\u5230\u2026\u2026\\c\\n\u563F\uFF0C\u5ABD\u554A\uFF01\uFF1F\\n\u7260\u5F9E\u982D\u4E0A\u7684\u91DD\u5674\u51FA\u6DB2\u9AD4\u4F86\u5566\uFF01\uFF1F\\r\\n\u7570\u4E16\u754C\u592A\u5687\u4EBA\u5566\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\u4F86\u81EA\u7570\u4E16\u754C\u7684\u6BD2\u91DD\u5BF6\u53EF\u5922\uFF0C\\n\u56DB\u984E\u91DD\u9F8D\uFF1F\\c\\n\u90A3\u652F\u8D85\u5927\u7684\u91DD\u53C8\u9577\u53C8\u5C16\uFF0C\\n\u770B\u8D77\u4F86\u7206\u5F37\u5927\u7684\uFF01\\c\\n\u4E0D\u904E\u7260\u7ADF\u7136\u5728\u5C41\u80A1\u4E0A\\n\u9577\u51FA\u4E86\uFF13\u6839\u91DD\u2026\u2026\\r\\n\u9019\u8981\u7528\u4EC0\u9EBC\u59FF\u52E2\u7761\u89BA\u554A\uFF1F\\c\\n\u56DB\u984E\u91DD\u9F8D\u7260\u80FD\u597D\u597D\u7761\u98FD\u55CE\uFF1F\\n\u968A\u9577\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u54A7\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 68,
    "flags": 0,
