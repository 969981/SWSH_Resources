[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5443\uFF01\u7ADF\u7136\u7B2C\u4E00\u8F2A\u5C31\u88AB\u6DD8\u6C70\u4E86\u2026\u2026\\n\u83AB\u975E[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u50AC\u7720\u8853\u7684\u9AD8\u624B\u2026\u2026\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6C92\u6709\u6211\u4E0A\u5834\u7684\u6C7A\u8CFD\uFF0C\\n\u5C31\u7336\u5982\u6C92\u653E\u98DF\u6750\u7684\u5496\u54E9\u3002[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7ADF\u7136\u5C31\u9019\u6A23\u8D85\u8D8A\u6211\u5011\uFF0C\u596A\u5F97\u512A\u52DD\u4E86\u3002\\n\u96D6\u7136\u6211\u5FC3\u6709\u4E0D\u7518\uFF0C\u4F46\u7B97\u4F60\u5011\u4E86\u4E0D\u8D77\u3002[VAR 0114(0072)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u5011\u7684\u4EAE\u9EDE\u90FD\u88AB\u6436\u53BB\u4E86\uFF01\\n\u54CE\u5537\uFF5E\u9019\u771F\u662F\u7CDF\u7CD5\u900F\u9802\u2026\u2026[VAR 0114(0071)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6C7A\u8CFD\u8036\uFF0C\u597D\u597D\u5594\u2026\u2026\\c\\n\u8B93\u6211\u4E5F\u9806\u4FBF\u4E00\u8D77\u6649\u7D1A\u2026\u2026\\n\u771F\u7684\u4E0D\u884C\u55CE\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7B2C\uFF12\u540D\u4E5F\u5920\u53B2\u5BB3\u4E86\u3002\\n\u6211\u5F88\u6EFF\u610F\u5566\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8001\u982D\u5152\u6211\u8EAB\u70BA\u6B66\u9928\u7684\u5E2B\u5085\uFF0C\\n\u9019\u7D50\u679C\u4E5F\u5BE6\u5728\u662F\u592A\u6C92\u51FA\u606F\u5695\u3002[VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u5011\u7684\u5BE6\u529B\u771F\u4E0D\u662F\u84CB\u7684\u5462\uFF5E\\n\u6C7A\u8CFD\u4E5F\u8981\u52A0\u6CB9\u5537\u3002[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9846\u79D1\u79D1\uFF01\u597D\u68D2\u7684\u4E00\u5834\u5C0D\u6230\u5440\uFF5E\uFF01\\n\u4F60\u5011\u5006\uFF01\u771F\u662F\u606D\u559C\u5537\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u968A\u9577\u554A\uFF0C\u982D\u4E00\u5834\u5C31\u9047\u4E0A\u4E86\u4F60\u5011\uFF0C\\n\u53EA\u80FD\u8AAA\u662F\u6211\u7684\u904B\u6C23\u592A\u5DEE\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5427\u54C8\uFF01\u786C\u78B0\u786C\uFF0C\u6211\u6253\u5F97\u53EF\u958B\u5FC3\u5566\uFF01\\n\u4F60\u5011\u5728\u6C7A\u8CFD\u4E5F\u8981\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9019\u5834\u6C7A\u8CFD\u771F\u662F\u7206\u706B\u71B1\u7684\u5566\uFF01\\n\u606D\u559C\u4F60\u5011\u512A\u52DD\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u6211\u6703\u5728\u7B2C\u4E00\u5834\u5C31\u51FA\u5C40\uFF01\\c\\n\u6211\u5011\u9AD8\u6C34\u6E96\u7684\u5C0D\u6230\uFF0C\\n\u8B93\u89C0\u773E\u5011\u90FD\u8208\u596E\u5230\u6700\u9AD8\u9EDE\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u5011\u4F7F\u51FA\u4E86\u5168\u529B\uFF0C\\n\u4F46\u4F60\u5011\u66F4\u52DD\u4E00\u7C4C\uFF01\\c\\n\u53BB\u5427\uFF01\u524D\u9032\u5230\u6C7A\u8CFD\uFF0C\\n\u5C55\u73FE\u66F4\u7CBE\u5F69\u7684\u5C0D\u6230\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u9019\u771F\u662F\u5AB2\u7F8E\u51A0\u8ECD\u76C3\u7684\\n\u7CBE\u5F69\u5C0D\u6230\uFF01\\c\\n\u6211\u8209\u8FA6\u9019\u4F3D\u52D2\u723E\u660E\u661F\u8CFD\uFF0C\\n\u679C\u7136\u6C92\u6709\u932F\uFF01\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u5011\u7ADF\u7136\u9023\uFF11\u5834\u90FD\u6253\u4E0D\u8D0F\u2026\u2026\\c\\n\u7206\u51FA\u4E86\u9019\u9EBC\u9A5A\u4EBA\u7684\u51B7\u9580\uFF0C\\n\u9023\u89C0\u773E\u90FD\u6EFF\u81C9\u56F0\u60D1\u5462\u3002[VAR 0114(000C)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u65E2\u7136[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u8D0F\u4E86\u6211\u5011\uFF0C\\n\u8981\u662F\u5728\u6C7A\u8CFD\u8F38\u4E86\uFF0C\u6211\u53EF\u4E0D\u9952[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002[VAR 0114(000C)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u7562\u7ADF\u662F\u51A0\u8ECD\u7684\u968A\u4F0D\uFF0C\\n\u6211\u9019\u662F\u7D66\u4F60\u5011\u4E00\u9EDE\u9762\u5B50\u3002[VAR 0114(000C)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6211\u9084\u60F3\u7E7C\u7E8C\u5C0D\u6230\u5436\u2026\u2026\\n\u4E0D\u904E\uFF0C[VAR 0100(0000)]\uFF0C\\r\\n\u9019\u6B21\u6211\u5C31\u628A\u52DD\u5229\u8B93\u7D66\u4F60\u5011\u5504\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u9023\u6211\u5011\u7684\u4EFD\u4E5F\u4E00\u8D77\u596E\u9B25\uFF0C\\n\u4E00\u5B9A\u8981\u62FF\u4E0B\u512A\u52DD\u5594\u3002[VAR 0114(000D)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4F7F\u76E1\u5168\u529B\uFF0C\u7136\u5F8C\u88AB\u6253\u6557\uFF01\\n\u6211\u7684\u5FC3\u60C5\u53CD\u800C\u5F88\u8212\u66A2\u5436\u3002\\r\\n\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\u512A\u52DD\u5594\u3002[VAR 0114(000D)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BE6\u529B\u679C\u7136\u4E0D\u662F\u84CB\u7684\u3002\\n\u7B2C\uFF12\u56DE\u5408\u4E5F\u8ACB\u52A0\u6CB9\u554A\u3002[VAR 0114(000E)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u6211\u6703\u5728\u89C0\u773E\u5E2D\\n\u70BA\u4F60\u5011\u7684\u6C7A\u8CFD\u52A0\u6CB9\u7684\u3002[VAR 0114(000E)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u8F38\u5F97\u5FC3\u670D\u53E3\u670D\uFF01\\n\u606D\u559C\u4F60\u5011\u62FF\u4E0B\u4E86\u512A\u52DD\u3002[VAR 0114(000E)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u7ADF\u7136\u5728\u5316\u70BA\u6FC0\u6D41\u524D\uFF0C\u5C31\u88AB\u5835\u585E\u4E86\u3002\\n\u9019\u5C31\u662F\u51A0\u8ECD\u7684\u5BE6\u529B\u554A\u2026\u2026[VAR 0114(000F)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4F60\u5011\u914D\u5408\u8D77\u4F86\uFF0C\\n\u771F\u662F\u9ED8\u5951\u5341\u8DB3\u554A\u3002\\c\\n\u9023\u6211\u90FD\u6709\u9EDE\u5AC9\u5992\u4F60\u5011\u4E86\u5462\u3002[VAR 0114(000F)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u9019\u5834\u6C7A\u8CFD\u771F\u662F\u7CBE\u5F69\u900F\u4E86\u3002\\n\u4F86\u5427\uFF0C\u4F60\u5011\u5169\u500B\uFF0C\\r\\n\u5FEB\u9EDE\u56DE\u61C9\u89C0\u773E\u7D66\u4F60\u5011\u7684\u8072\u63F4\u5427\u3002[VAR 0114(000F)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u9019\u6B21\u7684\u4E0D\u7518\u5FC3\uFF0C\u5C31\u662F\u4E0B\u6B21\u7372\u52DD\u7684\u52D5\u529B\uFF01\\n\u5E0C\u671B\u6211\u5011\u6709\u6A5F\u6703\u518D\u6230\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6211\u5011\u7684\u706B\u71B1\u9B25\u5FD7\\n\u5168\u90FD\u8A17\u4ED8\u7D66\u4F60\u5011\u4E86\uFF01\\r\\n\u628A\u5B83\u4E00\u8D77\u5E36\u5230\u6C7A\u8CFD\u53BB\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u525B\u624D\u771F\u662F\u4E00\u5834\\n\u4E0D\u8F9C\u8CA0\u6C7A\u8CFD\u4E4B\u540D\u7684\u71BE\u71B1\u5C0D\u6230\u554A\u3002\\r\\n[VAR 0100(0000)]\uFF0C\u606D\u559C\u4F60\u5011\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u8F38\u5F97\u592A\u5FEB\u4E86\uFF0C\\n\u5F85\u6703\u8981\u88AB\u746A\u4FD0\u5538\u4E00\u9813\u56C9\u3002[VAR 0114(0016)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u6211\u4E0D\u6703\u628A\u6975\u5DE8\u5316\u7576\u4F5C\u85C9\u53E3\u7684\u3002\\n\u4F60\u5011\u6BD4\u8F03\u5F37\u3002\\r\\n\u4E8B\u60C5\u5C31\u662F\u9019\u9EBC\u55AE\u7D14\u3002[VAR 0114(0016)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u9019\u4E0B\u6211\u771F\u662F\u898B\u8B58\u5230\\n\u51A0\u8ECD\u7684\u6C23\u9B44\u4E86\u3002\\c\\n\u2026\u2026\u89C0\u773E\u6B63\u5728\u7B49\u8457\u4F60\u5011\u5594\u3002[VAR 0114(0016)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u96D6\u7136\u6211\u8F38\u4E5F\u80FD\u8F38\u5F97\u5E25\u6C23\uFF0C\\n\u4F46\u662F\u5728\u7B2C\uFF11\u56DE\u5408\u5C31\u88AB\u6DD8\u6C70\u4E5F\u592A\u905C\u4E86\u3002\\r\\n\u6211\u7684\u81EA\u62CD\u6A94\u6848\u6703\u6709\u96E3\u5F97\u7684\u7167\u7247\u56C9\u3002[VAR 0114(0017)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u65E2\u7136\u9023\u672C\u5927\u723A\u7684\u968A\u4F0D\u90FD\u6253\u5012\u4E86\uFF0C\\c\\n\u4F60\u5011\u5006\u9019\u4E0B\u5B50\\n\u53EF\u5F97\u8981\u62FF\u4E0B\u512A\u52DD\u624D\u884C\u56C9\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u771F\u662F\u4E00\u5834\u7CBE\u5F69\u7684\u5C0D\u6230\uFF01\\n\u4E0B\u4E0D\u70BA\u4F8B\uFF0C\u4F46\u9019\u6B21\u6211\u5C31\u628A\\r\\n\u6700\u5F37\u7684\u5BF6\u5EA7\u8B93\u7D66\u4F60\u5011\u5427\u3002[VAR 0114(0017)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u96D6\u7136\u5F88\u907A\u61BE\uFF0C\\n\u4F46\u6211\u8981\u5207\u63DB\u5FC3\u60C5\u2026\u2026\\c\\n\u795D\u4F60\u5011\u4E00\u8DEF\u5E38\u52DD\u3002[VAR 0114(0011)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u8ACB\u9023\u6211\u5011\u7684\u4EFD\\n\u4E5F\u4E00\u8D77\u5728\u6C7A\u8CFD\u52A0\u6CB9\u3002[VAR 0114(0011)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u4F60\u5011\u5169\u4F4D\u7684\u914D\u5408\\n\u5BE6\u5728\u662F\u5929\u8863\u7121\u7E2B\u3002\\r\\n\u606D\u559C\u4F60\u5011\u512A\u52DD\u3002[VAR 0114(0011)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u4EFB\u4F55\u4E8B\u60C5\u90FD\u6709\u53EF\u80FD\u767C\u751F\u3002\\n\u9019\u500B\u65B0\u7684\u5927\u8CFD\uFF0C\\r\\n\u76F8\u7576\u4E0D\u597D\u61C9\u4ED8\u554A\u3002[VAR 0114(0014)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u6211\u539F\u672C\u6253\u7B97\u662F\u81F3\u5C11\u4E5F\u8981\\n\u6649\u7D1A\u6C7A\u8CFD\u7684\u5462\u3002\\c\\n\u9019\u6B21\u771F\u662F\u8F38\u7D66\u4E86\\n\u4F60\u5011\u7684\u9ED8\u5951\u3002[VAR 0114(0014)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u6211\u4EE5\u70BA\u52DD\u5229\u5DF2\u7D93\u5230\u624B\u4E86\u5462\u3002\\c\\n\u6253\u5012\u6211\u746A\u74DC\u7684\u968A\u4F0D\u800C\u62FF\u4E0B\u7684\u512A\u52DD\uFF0C\\n\u4F60\u5011\u5927\u53EF\u4EE5\u81EA\u8C6A\u4E00\u4E0B\u3002[VAR 0114(0014)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u4F60\u3001\u4F60\u5011\u592A\u5F37\u4E86\u2026\u2026\\n\u4E0B\u3001\u4E0B\u4E00\u5834\u4E5F\u4E00\u5B9A\u80FD\u8D0F\u7684\u2026\u2026\uFF01[VAR 0114(0012)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u5982\u679C\u662F\u4F60\u5011\u2026\u2026\\n\u6C7A\u3001\u6C7A\u8CFD\u4E5F\u6C92\u4EC0\u9EBC\u597D\u6015\u7684\u2026\u2026\uFF01[VAR 0114(0012)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u6211\u5F88\u9AD8\u8208\u80FD\u548C\u4F60\u5011\\n\u5728\u3001\u5728\u6C7A\u8CFD\u5C0D\u6230\u2026\u2026\uFF01\\r\\n\u606D\u3001\u606D\u559C\u512A\u52DD\uFF0C\u592A\u53B2\u5BB3\u4E86\u2026\u2026[VAR 0114(0012)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u4F60\u5011\u633A\u53B2\u5BB3\u7684\u561B\uFF01\\n\u771F\u662F\u4E00\u5C0D\u597D\u642D\u6A94\uFF01[VAR 0114(0015)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u4F60\u5011\u7684\u5718\u968A\u5408\u4F5C\u771F\u68D2\uFF01\\n\u518D\u63A5\u518D\u53B2\uFF0C\\r\\n\u53BB\u62FF\u4E0B\u512A\u52DD\u5427\uFF01[VAR 0114(0015)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u6211\u539F\u672C\u662F\u60F3\u7D66\u5152\u5B50\u770B\u5230\\n\u6211\u512A\u52DD\u7684\u6A23\u5B50\u5462\u3002\\c\\n\u4E0D\u904E\uFF0C\u65E2\u7136\u5C0D\u624B\u662F\u4F60\u5011\uFF0C\\n\u9019\u512A\u52DD\u6211\u662F\u8B93\u5F97\u5FC3\u7518\u60C5\u9858\u5566\u3002[VAR 0114(0015)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u54CE\uFF5E\u5537\uFF01\u54CE\u5537\u54CE\uFF5E\u5537\uFF01\\n\u771F\u4E0D\u6127\u662F[VAR 0100(0000)]\u5927\u4EBA\uFF01\\c\\n\u8ACB\u7528[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u4EFD\u738B\u8005\u98A8\u7BC4\\n\u767B\u4E0A\u5DD4\u5CF0\u5427\uFF01[VAR 0114(0068)]"
  },
  {
