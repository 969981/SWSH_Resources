[
  {
    "index": 0,
    "flags": 0,
    "text": "\u82F1\u96C4\u4E4B\u6CC9\u2026\u2026\\c\\n\u9060\u53E4\u6642\u4EE3\u7684\u5169\u4F4D\u82F1\u96C4\\n\u5728\u5E73\u606F\u707D\u5384\u4E4B\u5F8C\u7642\u50B7\u7684\u5730\u65B9\u3002[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F46\u662F\u73FE\u5728\uFF0C\\n\u9019\u6EAB\u6CC9\u53EA\u9069\u5408\u5BF6\u53EF\u5922\u6D78\u6CE1\u2026\u2026\\c\\n\u602A\u4E86\u2026\u2026\u50B3\u8AAA\u4E2D\u82F1\u96C4\u5728\u9019\u88E1\u6CE1\u6E6F\u7642\u50B7\uFF0C\\n\u90A3\u53C8\u662F\u600E\u9EBC\u4E00\u56DE\u4E8B\uFF1F\\c\\n\u2026\u2026\u6211\u5F97\u8A18\u5F97\u53BB\u8ABF\u67E5\u4E00\u4E0B\u3002[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u5011\u5169\u500B\u5728\u5FAE\u5BD0\u68EE\u6797\\n\u9047\u898B\u904E\u795E\u79D8\u7684\u5BF6\u53EF\u5922\u2026\u2026\\c\\n\u8AAA\u4E0D\u5B9A\uFF0C\\n\u4F60\u5011\u4E5F\u80FD\u6210\u70BA\u5169\u500B\u82F1\u96C4\u5594\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u528D\u8207\u76FE\u7684\u82F1\u96C4\u55CE\u2026\u2026\uFF1F\\n\u90A3\u6211\u8981\u7576\u62FF\u76FE\u7684\u82F1\u96C4\u3002[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u528D\u8207\u76FE\u7684\u82F1\u96C4\u55CE\u2026\u2026\uFF1F\\n\u90A3\u6211\u8981\u7576\u6301\u528D\u7684\u82F1\u96C4\u3002[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u771F\u597D\u5947\uFF0C\u9060\u53E4\u6642\u4EE3\u7684\u82F1\u96C4\\n\u7A76\u7ADF\u7D93\u6B77\u4E86\u4EC0\u9EBC\u6A23\u7684\u6230\u9B25\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u563F\uFF0C[VAR 0100(0000)]\uFF0C\\n\u6211\u5011\u4F86\u5834\u5BF6\u53EF\u5922\u5C0D\u6230\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6C92\u554F\u984C\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u8981\u5FC3\u7121\u65C1\u9A16\u5730\u8B8A\u5F37\uFF01\\c\\n\u6211\u4E0D\u53EA\u8981\u52DD\u904E\u51A0\u8ECD\uFF0C\u8D85\u8D8A\u82F1\u96C4\uFF0C\\n[VAR 0100(0000)]\uFF01\u6211\u9084\u8981\u6253\u8D0F\u4F60\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u2026\u2026\u6211\u5C31\u77E5\u9053\u3002\\n\u597D\u5427\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u5148\u53BB\u597D\u597D\u6E96\u5099\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5403\u4E86\u7D22\u59AE\u4E9E\u8ACB\u6211\u5011\u7684\\n\u8D85\u8B9A\u5496\u54E9\u98EF\u4E4B\u5F8C\uFF0C\\r\\n\u6709\u4E00\u80A1\u5E79\u52C1\u6EFE\u6EFE\u800C\u4F86\u56C9\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u96D6\u7136\u6211\u5B8C\u5168\u4E0D\u61C2\u4F60\u5728\u8AAA\u4EC0\u9EBC\uFF0C\\n\u4F46\u662F\u6A5F\u6703\u96E3\u5F97\uFF0C\u5C31\u8B93\u6211\u898B\u8B58\u4E00\u4E0B\u5427\u3002\\c\\n[VAR 0100(0000)]\uFF0C\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u56C9\uFF01\\n\u6211\u6703\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u6062\u5FA9\u6D3B\u529B\u7684\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u9019\u53EF\u662F\u5834\u672A\u4F86\u51A0\u8ECD\u7684\u8868\u6F14\u8CFD\u5462\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8B1D\u8B1D\u4F60\u5011\uFF01\\n\u771F\u662F\u5F88\u68D2\u7684\u5C0D\u6230\uFF01\u4F60\u5011\u5006\u2026\u2026\\r\\n\u5C31\u7528\u9019\u80A1\u6C23\u52E2\uFF0C\u6253\u6557\u7121\u6575\u7684\u4E39\u5E1D\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4F60\u5011\u518D\u4F86\u8981\u600E\u9EBC\u8FA6\uFF1F\\c\\n\u6211\u6253\u7B97\u9023\u5FAE\u5BD0\u68EE\u6797\u4E5F\\n\u4E00\u4F75\u8ABF\u67E5\u770B\u770B\u3002[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4E0D\u7BA1\u88AB\u6253\u6557\u5E7E\u6B21\uFF0C\\n\u6211\u90FD\u6703\u518D\u53BB\u6311\u6230\u9053\u9928\u7684\uFF01\\c\\n\u7B49\u6211\u62FF\u5230\u9053\u9928\u5FBD\u7AE0\u5F8C\uFF0C\\n\u63A5\u4E0B\u4F86\u5C31\u662F\u7A7F\u904E\uFF19\u865F\u9053\u8DEF\uFF0C\\r\\n\u5F80\u5C16\u91D8\u93AE\u53BB\u56C9\uFF01\u518D\u898B\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4ED6\u4F3C\u4E4E\u7D42\u65BC\u60F3\u901A\u4E86\u3002\\c\\n\u8981\u662F\u8D6B\u666E\u7121\u7CBE\u6253\u91C7\uFF0C\\n\u4E39\u5E1D\u4E5F\u6703\u64D4\u5FC3\u5462\u3002\\c\\n\u800C\u4E14[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F5C\u70BA\u4ED6\u7684\u52C1\u6575\uFF0C\\n\u4E5F\u6703\u89BA\u5F97\u63D0\u4E0D\u8D77\u52C1\u4F86\u5427\uFF01\u6211\u8D70\u56C9\uFF01[VAR 0114(000B)]"
  }
]
