[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54A6\uFF1F[VAR 0100(0000)]\u3001\u8D6B\u666E\uFF1F\\c\\n\u54CE\u5440\uFF0C\u6211\u5DEE\u9EDE\u5FD8\u4E86\uFF01\\n\u4E0D\u662F\u6709\u51A0\u8ECD\u8CFD\u55CE\uFF01\uFF1F\\r\\n\u4F60\u5011\u600E\u9EBC\u6703\u5728\u9019\u88E1\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9E\uFF0C\u6211\u771F\u662F\u670D\u4E86\u59B3\u4E86\uFF01\\n\u59B3\u771F\u7684\u4EC0\u9EBC\u90FD\u4E0D\u77E5\u9053\u55CE\uFF1F\\c\\n\u6D1B\u8332\u6703\u9577\u628A\u51A0\u8ECD\u76C3\u641E\u7838\u4E86\u5462\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u55EF\uFF1F\\c\\n\u4EC0\u9EBC\uFF5E\uFF01\uFF1F\\c\\n\u5728\u6211\u8ABF\u67E5\u5FAE\u5BD0\u68EE\u6797\u7684\u6642\u5019\uFF0C\\n\u7A76\u7ADF\u767C\u751F\u4E86\u4EC0\u9EBC\u4E8B\u60C5\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u662F\u9019\u6A23\u7684\u3002\u6574\u500B\u62F3\u95DC\u7AF6\u6280\u5834\\n\u90FD\u88AB\u9ED1\u8272\u7684\u6F29\u6E26\u7D66\u7C60\u7F69\u4E86\uFF01\\c\\n\u53EB\u4EC0\u9EBC\u540D\u5B57\u4F86\u8457\uFF1F\u95C7\u591C\u55CE\uFF1F\\n\u53CD\u6B63\uFF0C\u5C31\u662F\u6574\u500B\u4E00\u5718\u7CDF\u5462\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F46\u662F\uFF0C\u61C9\u8A72\u4E0D\u7528\u64D4\u5FC3\u5427\uFF01\\c\\n\u7121\u6575\u7684\u51A0\u8ECD\u4E39\u5E1D\\n\u6703\u5E6B\u6211\u5011\u60F3\u8FA6\u6CD5\u7684\uFF0C\u4E0D\u662F\u55CE\uFF1F[VAR 0114(0008)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4EC0\u9EBC\uFF1F\u7B49\u4E00\u4E0B\uFF01\\n\u963F\u59E8\uFF0C\u59B3\u525B\u624D\u63D0\u5230\u95C7\u591C\u55CE\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5F88\u4E45\u4EE5\u524D\u5DEE\u9EDE\u6BC0\u6EC5\\n\u4F3D\u52D2\u723E\u5730\u5340\u7684\u9ED1\u8272\u6F29\u6E26\uFF0C\\r\\n\u5B83\u7684\u540D\u5B57\u5C31\u662F\u95C7\u591C\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54A6\uFF1F\u90A3\u9EBC[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u9019\u5152\u505A\u4EC0\u9EBC\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u8981\u963B\u6B62\u95C7\u591C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u8981\u627E\u51FA\u90A3\u88AB\u7A31\u70BA\u528D\u7684\u5BF6\u53EF\u5922"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u8981\u627E\u51FA\u90A3\u88AB\u7A31\u70BA\u76FE\u7684\u5BF6\u53EF\u5922"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u963B\u6B62\u95C7\u591C\u2026\u2026\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u6253\u7B97\u627E\u51FA\u90A3\uFF12\u96BB\\n\u88AB\u7A31\u70BA\u528D\u548C\u76FE\u7684\u5BF6\u53EF\u5922\u55CE\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8AAA\u7684\u4E5F\u662F\u3002\\n\u5982\u679C\u50B3\u8AAA\u662F\u4E8B\u5BE6\uFF0C\\r\\n\u528D\u548C\u76FE\u5C31\u662F\u80FD\u5920\u5E73\u606F\u95C7\u591C\u7684\u5BF6\u53EF\u5922\u2026\u2026\\r\\n\u7260\u5011\u80FD\u5920\u5E6B\u6211\u5011\u9A45\u6563\u90A3\u6F29\u6E26\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u4E86\uFF01\u9019\u500B[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u8457\uFF0C\\n\u7136\u5F8C\u5230\u5FAE\u5BD0\u68EE\u6797\u53BB\u5427\uFF01\\c\\n\u6211\u5F97\u5148\u53BB\u8ABF\u67E5\u4E00\u4E9B\u4E8B\u3002\\n\u7D50\u675F\u5F8C\u5C31\u6703\u7ACB\u523B\u8FFD\u4E0A\u7684\u3002[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u528D\u8207\u76FE\u9019\uFF12\u96BB\u5BF6\u53EF\u5922\uFF0C\\n\u662F\u5F9E\u54EA\u88E1\u4F86\u7684\u5462\uFF1F\u6211\u5F97\u53BB\u8ABF\u67E5\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5B69\u5B50\uFF0C\u76E1\u529B\u800C\u70BA\u5427\uFF01\\c\\n\u56E0\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u5DF2\u7D93\u662F\u500B\\n\u51FA\u8272\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u4E86\u554A\uFF01[VAR 0114(0008)]"
  }
]
