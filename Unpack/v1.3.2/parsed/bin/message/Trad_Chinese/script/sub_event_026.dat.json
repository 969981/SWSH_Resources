  {
    "index": 0,
    "flags": 0,
    "text": "\u93D8\u93D8\uFF5E\uFF01\\c\\n\u6211\u6709\u500B\u6771\u897F\u8981\u9001\u7D66\\n\u5411\u7CBE\u9748\u7403\u642D\u8A71\u7684[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\u554A\u7403\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9806\u5E36\u4E00\u63D0\uFF0C\\n\u6211\u4E0D\u662F\u7CBE\u9748\u7403\u5594\uFF01\\c\\n\u731C\u731C\u6211\u662F\u8AB0\uFF1F\\n\u7B54\u6848\u662F\u2026\u2026\u963F\u7403\uFF0C\u554A\u7403\uFF5E\uFF01\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u5728\u5404\u5730\u7684\u9053\u9928\u7AF6\u6280\u5834\\n\u70BA\u5927\u5BB6\u52A0\u6CB9\u8072\u63F4\uFF01\\r\\n\u770B\u5230\u6211\u7684\u6642\u5019\u9084\u8ACB\u591A\u591A\u95DC\u7167\uFF0C\u554A\u7403\uFF5E\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u54E6\u54E6\uFF0C\u51A0\u8ECD\uFF01\\n\u6211\u60F3\u898B[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u4E45\u4E86\uFF0C\u554A\u7403\uFF5E\uFF01\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5982\u679C\u6211\u80FD\u548C\u51A0\u8ECD\u6210\u70BA\u597D\u670B\u53CB\uFF0C\\n\u6216\u8A31\u5C31\u80FD\u7576\u4E0A\u5B98\u65B9\u5409\u7965\u7269\u2026\u2026"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5C0D\u4E86\u5C0D\u4E86\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u56E0\u70BA\u6211\u7684\u8072\u63F4\\n\u6240\u4EE5\u624D\u80FD\u7372\u52DD\u5427\uFF0C\u554A\u7403\uFF01\\c\\n\u6240\u4EE5\u70BA\u4E86\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u6703\u5FD8\u8A18\u6211\uFF0C\\n\u8ACB\u6536\u4E0B\u9019\u500B\u7D00\u5FF5\u54C1\uFF0C\u554A\u7403\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8D85\u7D1A\u7A00\u6709\u7684\u806F\u76DF\u5361\uFF01\\n\u9019\u500B\u6703\u8B93\u72C2\u71B1\u7C89\u7D72\u611F\u52D5\u5230\\r\\n\u75DB\u54ED\u6D41\u6D95\u7684\u5BF6\u7269\u5C31\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF0C\u554A\u7403\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u56E0\u70BA\u5927\u5BB6\u90FD\u6436\u8457\u60F3\u8981\uFF0C\\n\u6240\u4EE5\u9019\u5F35\u806F\u76DF\u5361\u6709\u9EDE\u76BA\u5DF4\u5DF4\u7684\uFF0C\u554A\u7403\uFF01\\c\\n\u96D6\u7136\u9019\u53EA\u662F\u5F35\u4E00\u822C\u7684\u806F\u76DF\u5361\uFF0C\\n\u4F46\u5C31\u610F\u7FA9\u4E0A\u4F86\u8AAA\u53EF\u662F\u7A00\u4E16\u73CD\u5BF6\uFF0C\u554A\u7403\uFF5E\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\uFF01\\n\u6211\u662F\u4EBA\u4EBA\u719F\u6089\u4EBA\u4EBA\u611B\u7684\u963F\u7403\uFF0C\u554A\u7403\uFF5E\uFF01\\c\\n\u5F80\u5F8C\u4E5F\u6703\u4EE5\u5409\u7965\u7269\u7684\u8EAB\u5206\u4E3B\u52D5\u70BA\\n\u6311\u6230\u9053\u9928\u7684\u5927\u5BB6\u52A0\u6CB9\uFF0C\u554A\u7403\uFF5E\uFF01"
  }
]
