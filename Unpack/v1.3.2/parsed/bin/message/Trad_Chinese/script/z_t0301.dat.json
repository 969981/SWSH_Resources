[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4E9E\u6D1B\u9664\u4E86\u7A2E\u7530\u4EE5\u5916\uFF0C\\n\u9084\u683D\u57F9\u7F8E\u9E97\u7684\u82B1\u5594\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u68C9\u68C9\u2026\u2026"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u624B\u4E0A\u62FF\u8457\u82B1\u7684\u8A71\uFF5E\\n\u5BF6\u53EF\u5922\u5C31\u6703\u9760\u904E\u4F86\u5594\uFF5E"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9053\u9928\u9928\u4E3B\u7684\u806F\u76DF\u5361\u4E0A\u9762\uFF0C\\n\u5BEB\u8457\u5F88\u591A\u5C0F\u6545\u4E8B\u5594\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9053\u9928\u6C92\u6709\u9650\u5236\u6311\u6230\u7684\u6B21\u6578\uFF0C\\n\u90A3\u662F\u5728\u8003\u9A57[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u6C92\u6709\u4E00\u9846\u6C38\u4E0D\u653E\u68C4\u7684\u5FC3\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6C92\u6709\u770B\u904E\u5C71\u4E18\u53E6\u4E00\u908A\u7684\u666F\u81F4\uFF0C\\n\u90A3\u9EBC[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u8981\u53BB\u770B\u770B\uFF0C\\r\\n\u5C31\u7B97\u6709\u770B\u904E\u4E5F\u8A72\u518D\u53BB\u91CD\u65B0\u611F\u52D5\u4E00\u6B21\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8A71\u8AAA\u90A3\u500B\u5730\u756B\u5440\uFF0C\\n\u807D\u8AAA\u4E26\u6C92\u6709\u500B\u6B63\u5F0F\u540D\u7A31\u2026\u2026\\r\\n\u662F\u4E0D\u662F\u6709\u7981\u5FCC\uFF0C\u4E0D\u80FD\u63D0\u5230\u5B83\u7684\u540D\u5B57\u5462\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u62CD\u4E86\u5730\u756B\u7684\u7167\u7247\uFF0C\\n\u8DDF\u5BE6\u7269\u6BD4\u8D77\u4F86\u9084\u662F\u5DEE\u5F97\u9060\u4E86\u3002\\c\\n\u4E0D\u904E\u6BCF\u6B21\u770B\u5230\u7167\u7247\uFF0C\\n\u5C31\u6703\u559A\u9192\u89AA\u773C\u770B\u5230\u5730\u756B\u6642\u7684\u90A3\u4EFD\u611F\u52D5\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u70BA\u4EC0\u9EBC\u53E4\u4EBA\u7559\u4E0B\u7684\u5730\u756B\u6C92\u6709\u6D88\u5931\uFF0C\\n\u4E00\u76F4\u7559\u5230\u73FE\u5728\u5462\uFF1F\\c\\n\u771F\u662F\u592A\u4E0D\u53EF\u601D\u8B70\u4E86\uFF5E\\n\u4E00\u76F4\u601D\u8003\u4E0B\u53BB\u7684\u8A71\uFF0C\u6211\u90FD\u8981\u7761\u4E0D\u8457\u4E86\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u731C\u61C9\u8A72\u662F\u9019\u6A23\u2026\u2026\\c\\n\u56E0\u70BA\u6709\u5BF6\u53EF\u5922\u5E6B\u5FD9\uFF0C\\n\u624D\u80FD\u5B8C\u6210\u9019\u9EBC\u5927\u7684\u5730\u756B\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u8981\u8D95\u5FEB\u9577\u9AD8\uFF0C\\n\u624D\u80FD\u7528\u9019\u584A\u7ACB\u724C\u4F86\u7167\u76F8\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9019\u795E\u79D8\u7684\u77F3\u96D5\u2026\u2026\\c\\n\u7A76\u7ADF\u51FA\u81EA\u4EBA\u985E\u4E4B\u624B\uFF0C\\n\u9084\u662F\u5BF6\u53EF\u5922\u4E4B\u624B\u5462\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E0D\u7BA1\u662F\u4EC0\u9EBC\uFF0C\u5E73\u5E38\u5982\u679C\u4E0D\u597D\u597D\u7167\u9867\uFF0C\\n\u7A81\u7136\u8981\u7528\u5230\u7684\u6642\u5019\u5C31\u982D\u75DB\u4E86\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uFF15\u865F\u9053\u8DEF\u5F88\uFF5E\uFF5E\u9577\u2026\u2026\\n\u4E00\u8DEF\u98DB\u5954\u7A7F\u8D8A\u7684\u8A71\u5F88\u66A2\u5FEB\u5594\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4F86\u770B\u5730\u756B\u7684\u4EBA\\n\u8D8A\u4F86\u8D8A\u591A\u4E86\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u53EF\u4EE5\u8AAA\u5927\u5BB6\u5C31\u50CF\u662F\\n\u8B93\u4E9E\u6D1B\u7D66\u5E36\u5927\u7684\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u65B0\u51A0\u8ECD\u53EF\u771F\u53B2\u5BB3\u554A\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u771F\u662F\\n\u8B93\u4EBA\u7DCA\u5F35\u53C8\u8208\u596E\u554A\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4E9E\u6D1B\u8F38\u4E86\u5440\u2026\u2026"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u54A6\uFF1F\u90A3\u500B\u4EBA\u662F\u2026\u2026\u51A0\u8ECD\uFF1F"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u600E\u9EBC\u9084\u8981\u6392\u968A\u554A\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u80D6\u6C6A\u6C6A\u6C6A\u6C6A\uFF01"
  }
]
