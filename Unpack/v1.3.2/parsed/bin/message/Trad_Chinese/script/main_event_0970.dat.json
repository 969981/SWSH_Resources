    "index": 0,
    "flags": 0,
    "text": "\u8B93\u6211\u4F86\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u660E\u4E00\u4E0B\\n\u6EAF\u50B3\u93AE\u5BF6\u53EF\u5922\u9053\u9928\u7684\u9053\u9928\u4EFB\u52D9\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9EBB\u7169\u4F60\u4E86"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u7528\u4E86"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u672C\u9053\u9928\u7684\u4EFB\u52D9\uFF0C\u5C31\u662F\u8981\u5750\u9032\u676F\u5B50\uFF0C\\n\u4E00\u908A\u9583\u907F\u969C\u7919\u7269\uFF0C\u4E00\u908A\u671D\u7D42\u9EDE\u524D\u9032\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u4F86\u8B80\u4E00\u4E0B\u8A2D\u65BD\u8AAA\u660E\u66F8\u5427\u3002\\c\\n\u300C\u9806\u6642\u91DD\u8F49\u52D5\u64CD\u63A7\u6416\u687F\uFF0C\\n\u676F\u5B50\u5C31\u6703\u5411\u53F3\u908A\u65CB\u8F49\u3002\\c\\n\u9006\u6642\u91DD\u8F49\u52D5\u64CD\u63A7\u6416\u687F\uFF0C\\n\u676F\u5B50\u5C31\u6703\u5411\u5DE6\u908A\u65CB\u8F49\u3002\u300D"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u300C\u649E\u4E0A\u7246\u58C1\u6642\uFF0C\\n\u53EA\u8981\u5FEB\u901F\u5730\u5C07\u64CD\u63A7\u6416\u687F\u8F49\u8F49\u8F49\u8F49\u8F49\uFF0C\\r\\n\u5373\u53EF\u8ABF\u6574\u65B9\u5411\u3002\u300D\\c\\n\u7E3D\u4E4B\uFF0C\u5C31\u662F\u8981\u8B93\u676F\u5B50\u9069\u5EA6\u5730\u8F49\u8F49\u8F49\uFF0C\\n\u4E00\u8DEF\u8F49\u5411\u7D42\u9EDE\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u53BB\u5427\uFF01\u795D[VAR 1100(00FF,0101)]\u4F60\u59B3\u8F49\u5F97\u9806\u5229\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6709\u4EC0\u9EBC\u7591\u554F\u55CE\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8981\u5982\u4F55\u5B8C\u6210\u4EFB\u52D9\uFF1F"
