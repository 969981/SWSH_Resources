    "index": 0,
    "flags": 0,
    "text": "\u6B38\u6B38\uFF0C[VAR 0101(0001)]\\n\u6C92\u4EC0\u9EBC\u7CBE\u795E\u8036\uFF1F\\r\\n\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u5427\u3002[VAR 0114(0008)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u5BF6\u53EF\u5922\u966A\u5728\u8EAB\u908A\uFF0C\\n\u4E00\u8D77\u6D3B\u529B\u5341\u8DB3\u5730\u8D70\u904D\u56DB\u65B9\uFF0C\\r\\n\u4EBA\u81EA\u7136\u5C31\u6703\u9732\u51FA\u7B11\u5BB9\u4E86\u5462\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u771F\u662F\u51FA\u4E86\u5927\u4E8B\u4E86\u5462\u2026\u2026\\c\\n\u4E0D\u904E\u6709\u4E39\u5E1D\u5728\u2026\u2026\\n\u800C\u4E14[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u6703\u6709\u6240\u884C\u52D5\uFF0C\u5C0D\u5427\uFF1F\\r\\n\u5ABD\u5ABD\u6703\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u52A0\u6CB9\u7684\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u51A0\u8ECD\u4E5F\u662F\\n\u6709\u5F88\u591A\u82E6\u8877\u5427\uFF1F\\c\\n\u4F46\u6700\u91CD\u8981\u7684\\n\u9084\u662F\u505A\u81EA\u5DF1\u5427\uFF1F[VAR 0114(0008)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5927\u5E2B\u7403\u80FD\u5920\u6349\u5230\u4EFB\u4F55\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u662F\u5F88\u53B2\u5BB3\u7684\u7403\u5C0D\u5427\uFF01\uFF1F\\c\\n\u6709\u4E00\u5929[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u6703\u9047\u5230\\n\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u7528\u90A3\u7A2E\u7403\u7684\u5BF6\u53EF\u5922\u5427\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6728\u862D\u535A\u58EB\u8AAA\u4E86\\n\u5F88\u9A5A\u4EBA\u7684\u4E8B\u60C5\u5462\u3002\\c\\n\u539F\u4F86\u6975\u5DE8\u5316\u7684\u6642\u5019\uFF0C\\n\u5BF6\u53EF\u5922\u672C\u8EAB\u4E26\u6C92\u6709\u8B8A\u5927\uFF01\uFF1F\\c\\n\u9019\u6A23\u9084\u80FD\u89F8\u78B0\u5230\u5C0D\u624B\uFF0C\\n\u80AF\u5B9A\u662F\u6709\u5F88\u5F37\u5927\u7684\u529B\u91CF\u5427\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8A71\u8AAA\u56DE\u4F86\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u904E\\n\u5BAE\u9580\u5E02\u7684\u5C0D\u6230\u5854\u4E86\u55CE\uFF1F\\c\\n\u9130\u5C45\u7684\u5ABD\u5ABD\u8AAA\uFF0C\\n\u4E39\u5E1D\u770B\u8D77\u4F86\u5F88\u6A02\u5728\u5176\u4E2D\u3002[VAR 0114(0008)]"
  },
