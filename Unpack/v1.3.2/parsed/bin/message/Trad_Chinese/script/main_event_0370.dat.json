  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u8981\u67E5\u904D\u6709\u7D05\u5149\u7684\u5DE2\u7A74\uFF01\\c\\n\u9084\u8981\u6253\u904D\u6975\u5DE8\u5316\u7684\u5BF6\u53EF\u5922\uFF01\\n\u7DE0\u9020\u8D6B\u666E\u50B3\u8AAA\u7684\u9583\u4EAE\u4E00\u9801\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u62DC\u8A17\uFF01\u5225\u5C0F\u770B\u6975\u5DE8\u5316\u7684\u5BF6\u53EF\u5922\u3002\\n\u7260\u5011\u771F\u7684\u662F\u975E\u5E38\u5F37\u5927\u5462\uFF01\\c\\n\u5C0D\u6230\u6642\uFF0C\u5225\u5FD8\u8A18\u8981\u8B93\u81EA\u5DF1\u7684\\n\u642D\u6A94\u5BF6\u53EF\u5922\u4E5F\u6975\u5DE8\u5316\u5594\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5230\u66E0\u91CE\u5730\u5E36\u5F8C\uFF0C\\n\u6703\u767C\u73FE\u5728\u5404\u8655\u6709\u7D05\u8272\u7684\u5149\u67F1\u3002\\c\\n\u5C0D\u5BE6\u529B\u6709\u4FE1\u5FC3\u7684\u8A71\uFF0C\u53EF\u4EE5\u53BB\u67E5\u4E00\u67E5\u3002\\n\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u5C31\u5728\u90A3\u88E1\u5594\u3002\\c\\n\u4F86\uFF01\u6211\u9019\u500B\u5192\u96AA\u7684\u524D\u8F29\\n\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u500B\u597D\u6771\u897F\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F7F\u7528\u5BF6\u53EF\u5922\u76D2\uFF0C\\n\u5C31\u53EF\u4EE5\u628A\u5BF6\u53EF\u5922\u5BC4\u653E\u5728\u76D2\u5B50\u88E1\uFF0C\\r\\n\u6216\u662F\u628A\u7260\u5F9E\u76D2\u5B50\u88E1\u9818\u51FA\u4F86\u540C\u884C\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u76E1\u60C5\u6355\u6349\u5BF6\u53EF\u5922\uFF0C\\n\u9806\u4FBF\u5E6B\u5BF6\u53EF\u5922\u5716\u9451\u88DC\u4E0A\u8CC7\u8A0A\u5427\uFF01[VAR 0114(000B)]"
  },
  {
