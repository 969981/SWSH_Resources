[
  {
    "index": 0,
    "flags": 0,
    "text": "\u51A0\u8ECD\u76C3\u6C7A\u8CFD\u9032\u5230\u4E86\u7B2C\uFF12\u56DE\u5408\u56C9\uFF01\\c\\n\u76EE\u524D\u6240\u5269\u7684\uFF14\u4F4D\u9078\u624B\u4E2D\uFF0C\\n\u7A76\u7ADF\u662F\u8AB0\u80FD\u5920\u7E7C\u7E8C\u6649\u7D1A\u5462\uFF01\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6C7A\u8CFD\u7B2C\uFF12\u56DE\u5408\u7684\u9996\u6230\uFF01\\c\\n\u767B\u5834\u7684\u662F\u5728\u8207\u5F7C\u7279\u9078\u624B\u7684\\n\u610F\u5916\u8CFD\u4E8B\u4E2D\u7372\u52DD\uFF0C\\r\\n\u4E26\u4E14\u5728\u7B2C\uFF11\u56DE\u5408\u6642\uFF0C\\r\\n\u64CA\u6557\u4E86\u9732\u7483\u5A1C\u9078\u624B\u7684\u6700\u5F37\u6311\u6230\u8005\u2026\u2026\\r\\n[VAR 0100(0000)]\u9078\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7DCA\u63A5\u8457\u662F\u2026\u2026\\c\\n\u4F3D\u52D2\u723E\u7A7A\u624B\u9053\u7684\u5929\u624D\uFF01\\n\u5F69\u8C46\u9078\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u5411[VAR 1100(00FF,0101)]\u4F60\u59B3\u4FDD\u8B49\uFF0C\\n\u9019\u6B21\u6211\u4F7F\u51FA\u7684\u653B\u64CA\uFF0C\\r\\n\u4E00\u5B9A\u80FD\u9707\u64BC\u4F60\u5011\u7684\u5FC3\u9748\u3002[VAR 0114(0011)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8ACB\u591A\u6307\u6559\u4E86\uFF01[VAR 0114(0011)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5F69\u8C46\u88AB\u6253\u6557\u4E86\uFF01\\n\u52DD\u51FA\u7684\u662F[VAR 0100(0000)]\uFF01\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u591A\u8B1D\u6307\u6559\u3002[VAR 0114(0011)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8207\u4F60\u5011\u5C0D\u6230\uFF0C\\n\u7E3D\u662F\u6703\u8B93\u6211\u5FCD\u4E0D\u4F4F\u5C31\u6A02\u5728\u5176\u4E2D\u2026\u2026\\c\\n\u5F88\u907A\u61BE\u6211\u9084\u662F\u8F38\u4E86\uFF0C\\n\u4F46\u6211\u7684\u5FC3\u60C5\u662F\u8212\u723D\u7684\u3002[VAR 0114(0011)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u56E0\u6B64\uFF0C\u6211\u8A8D\u70BA\u9019\u582A\u7A31\u662F\\n\u4E00\u5834\u7406\u60F3\u7684\u5C0D\u6230\u3002[VAR 0114(0011)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u76F8\u4FE1\u4ECA\u5F8C\u4F60\u5011\u4ECD\u6703\u548C\\n\u5404\u5F0F\u5404\u6A23\u7684\u8A13\u7DF4\u5BB6\u76F8\u9047\u3001\u5C0D\u6230\u3002\\c\\n\u9858\u9019\u4E00\u5207\u7684\u7D93\u6B77\\n\u90FD\u80FD\u6210\u70BA\u4F60\u5011\u7684\u5FC3\u9748\u98DF\u7CE7\u3002[VAR 0114(0011)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u73FE\u5728\uFF0C\u8B93\u6211\u5011\u5598\u4E00\u53E3\u6C23\uFF0C\\n\u975C\u5F85\u4E0B\u4E00\u5834\u6BD4\u8CFD\u958B\u59CB\u5427\uFF01[VAR 0114(0018)]"
  }
