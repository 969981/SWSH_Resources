  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u54E6\uFF0C\u770B\u4F86\u6715\u6B20\u4E86\u9019\u500B\u50A2\u4F19\u5F88\u591A\u6069\u60C5\u5462\u3002[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8A71\u8AAA\uFF0C\u771F\u662F\u597D\u4E8B\u9023\u9023\uFF01\\n\u6715\u525B\u624D\u7D42\u65BC\u767C\u73FE\u611B\u99AC\u5728\u54EA\u88E1\u4E86\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u539F\u4F86\u96EA\u66B4\u99AC\u662F\u628A\u738B\u51A0\u795E\u6BBF\\n\u7576\u4F5C\u7260\u7684\u64DA\u9EDE\uFF01\\c\\n\u90A3\u88E1\u66FE\u7D93\u662F\\n\u6715\u8207\u7260\u5171\u5EA6\u6642\u5149\u7684\u5730\u65B9\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u539F\u4F86\u9748\u5E7D\u99AC\u662F\u628A\u738B\u51A0\u795E\u6BBF\\n\u7576\u4F5C\u7260\u7684\u64DA\u9EDE\uFF01\\c\\n\u90A3\u88E1\u66FE\u7D93\u662F\\n\u6715\u8207\u7260\u5171\u5EA6\u6642\u5149\u7684\u5730\u65B9\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6715\u6015\u89F8\u666F\u50B7\u60C5\uFF0C\\n\u56E0\u6B64\u4E00\u76F4\u6C92\u6709\u9760\u8FD1\u90A3\u88E1\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F46\u96E3\u9053\u90A3\u50A2\u4F19\u662F\\n\u60F3\u6C89\u6D78\u5728\u8207\u6715\u7684\u56DE\u61B6\u88E1\u2026\u2026\uFF1F\\r\\n\u4E0D\uFF0C\u9019\u600E\u9EBC\u53EF\u80FD\u3002[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u738B\u51A0\u795E\u6BBF\u5C31\u77D7\u7ACB\u5728\\n\u5317\u65B9\u4E4B\u5C71\u7684\u5C71\u9802\u3002[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6715\u76FC[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E36\u8457\u727D\u7D46\u97C1\u7E69\u8207\u863F\u8514\uFF0C\\n\u767B\u4E0A\u90A3\u5EA7\u5C71\u3002[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u6715\u5BE6\u5728\u662F\u5FC3\u6025\u96E3\u8010\u4E86\u3002\\n\u6055\u6715\u5148\u8D70\u4E00\u6B65\u3002[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4E00\u5207\u5C31\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u96D6\u7136\u6C92\u4EC0\u9EBC\u6771\u897F\u80FD\u62FF\u4F86\u62DB\u5F85\uFF0C\\n\u4F46\u5982\u679C\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8A71\uFF0C\\r\\n\u60F3\u5728\u9019\u6751\u5B50\u88E1\u5F85\u591A\u4E45\u90FD\u6C92\u554F\u984C\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u738B\u51A0\u96EA\u539F\u4E0A\u6709\u5E7E\u500B\u795E\u5947\u7684\u907A\u8DE1\u3002\\c\\n\u4E0D\u904E\u554A\uFF01\u90A3\u5152\u7684\u9580\u4E0D\u7BA1\u662F\\n\u600E\u9EBC\u63A8\uFF0C\u600E\u9EBC\u62C9\uFF0C\u90FD\u4E0D\u6703\u52D5\u5462\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u81EA\u5DE8\u4EBA\u7761\u69BB\u5411\u6771\u908A\u8D70\uFF0C\\n\u518D\u722C\u4E0A\u5317\u908A\u7684\u5C71\uFF0C\\r\\n\u5C31\u6709\u5EA7\u8001\u820A\u7684\u795E\u6BBF\u5594\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u7B97\u53BB\u722C\u5C71\uFF0C\\n\u5343\u842C\u5343\u842C\u8981\u5C0F\u5FC3\u554A\u3002\\c\\n\u901A\u5F80\u5C71\u9802\u7684\u8DEF\u662F\u5F88\uFF5E\u9060\u7684\u5462\u3002"
