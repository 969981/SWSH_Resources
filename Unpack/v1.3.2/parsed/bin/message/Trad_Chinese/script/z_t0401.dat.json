    "text": "[~ 0]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6240\u8B02\u7684\u8CFC\u7269\uFF0C\\n\u672C\u8CEA\u5C31\u662F\u7336\u8C6B\u548C\u7169\u60F1\u7684\u904E\u7A0B\u554A\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u73FE\u5728\u7ACB\u523B\u958B\u59CB\u52E4\u596E\u935B\u934A\u7684\u8A71\uFF0C\\n\u76F8\u4FE1\u9053\u9928\u6311\u6230\u6703\u5F88\u8F15\u9B06\u7684\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u55B5\u55B5\u5657\uFF5E"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9732\u7483\u5A1C\u2026\u2026\\n\u5979\u70BA\u4EC0\u9EBC\u6703\u559C\u6B61\u71C8\u5854\u5462\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u56E0\u70BA\u4F3D\u52D2\u723E\u662F\u4E00\u5EA7\u5DE8\u5927\u7684\u5CF6\u5DBC\u3002\\c\\n\u4E0D\u8AD6\u4EE5\u524D\u9084\u662F\u73FE\u5728\uFF0C\\n\u6307\u5F15\u8239\u96BB\u65B9\u5411\u7684\u71C8\u5854\u90FD\u626E\u6F14\u8457\u91CD\u8981\u7684\u89D2\u8272\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5728\u66E0\u91CE\u5730\u5E36\u91E3\u9B5A\u7684\u6642\u5019\uFF0C\\n\u5982\u679C\u9047\u5230\u5DE8\u5927\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u611F\u89BA\u5C31\u662F\u8981\u561B\u6349\u4F4F\u7260\uFF0C\u8981\u561B\u88AB\u7260\u6349\u8D70\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9732\u7483\u5A1C\u662F\u500B\u56B4\u4EE5\u5F8B\u5DF1\u7684\u4EBA\uFF0C\\n\u6240\u4EE5\u9053\u9928\u4EFB\u52D9\u7684\u8981\u6C42\u4E5F\u5F88\u56B4\u683C\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u554A\u2026\u2026\u9019\u8B93\u6211\u60F3\u8D77\uFF0C\\n\u6211\u6C92\u80FD\u62FF\u5230\u6C34\u4E4B\u5FBD\u7AE0\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u5F88\u671F\u5F85[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8868\u73FE\u5594\uFF01\\c\\n\u7576\u7136\u6211\u5C0D\u6BCF\u500B\u4EBA\u90FD\u9019\u9EBC\u8AAA\u5C31\u662F\u4E86\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u73FE\u6458\u7684\u852C\u83DC\uFF01\u770B\u8D77\u4F86\u5F88\u65B0\u9BAE\u5427\uFF1F\\n\u73FE\u6458\u7684\u6A39\u679C\uFF01\u770B\u8D77\u4F86\u4E5F\u5F88\u597D\u5403\u5427\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5927\u5BB6\u4E00\u8D77\u505A\u7684\u6599\u7406\uFF0C\\n\u5C31\u7B97\u5931\u6557\u4E5F\u6703\u6210\u70BA\u6709\u8DA3\u7684\u7B11\u6599\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7B2C\u4E8C\u7926\u5C71\u662F\u500B\u597D\u5730\u65B9\uFF01\\n\u6709\u5F88\u591A\u786C\u90A6\u90A6\u7684\u5BF6\u53EF\u5922\u5594\u3002"
