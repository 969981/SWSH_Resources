  {
    "index": 20,
    "flags": 0,
    "text": "\u6211\u7B49\u5230\u82B1\u5152\u90FD\u8981\u8B1D\u4E86\uFF01\\n\u5947\u5DF4\u7D0D\u7684\u6BD4\u8CFD\u7D42\u65BC\u4F86\u4E86\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u5728\u87A2\u5E55\u4E0A\u770B\u4E86\u5594\uFF01\\n\u771F\u7684\u662F\u68D2\u5446\u4E86\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u96D6\u7136\u6709\u5947\u5DF4\u7D0D\u5728\uFF0C\\n\u4F46\u7A76\u7ADF\u6703\u8B8A\u600E\u9EBC\u6A23\u5462\u2026\u2026"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u54E6\uFF5E\u6211\u5011\u7684\u51A0\u8ECD\uFF0C\\n[VAR 0100(0000)]\uFF01"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u9078\u624B\uFF0C\\c\\n\u51A0\u8ECD\u548C\u95C7\u591C\u5728\u4E0A\u9762\u5C0D\u6230\u2026\u2026\\c\\n\u662F\u7684\uFF0C\u642D\u4E58\u96FB\u68AF\u7684\u8A71\\n\u53EF\u4EE5\u524D\u5F80\u5730\u4E0B\u5DE5\u5EE0\u2026\u2026"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4E0D\u662F\u76F8\u95DC\u4EBA\u54E1\u7684\u8A71\uFF0C\\n\u662F\u4E0D\u80FD\u642D\u4E58\u524D\u5F80\u5730\u4E0B\u5DE5\u5EE0\u7684\u96FB\u68AF\u7684\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u524D\u5F80\u5730\u4E0B\u5DE5\u5EE0\u7684\u96FB\u68AF\u5F88\u5371\u96AA\u2026\u2026\\n\u6240\u4EE5\u4E0D\u80FD\u642D\u5594\u2026\u2026"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u958B\u59CB\u5927\u9B27\uFF0C\\n\u5967\u5229\u8587\u9677\u5165\u9A5A\u614C\u2026\u2026\\c\\n\u9019\u5BE6\u5728\u8B93\u4EBA\u592A\u7D55\u671B\u4E86\u3002\\n\u6D1B\u8332\u5148\u751F\u5C31\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u8981\u6311\u6230\u64C5\u9577\u4F7F\u7528\u9F8D\u5C6C\u6027\\n\u5BF6\u53EF\u5922\u7684\u5947\u5DF4\u7D0D\uFF0C\\r\\n\u9700\u8981\uFF17\u500B\u9053\u9928\u5FBD\u7AE0\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u8981\u627E\u5947\u5DF4\u7D0D\u7684\u8A71\uFF0C\\n\u4ED6\u70BA\u4E86\u5236\u670D\u6975\u5DE8\u5316\u7684\u91CE\u751F\u5BF6\u53EF\u5922\uFF0C\\r\\n\u5F80\u96A7\u9053\u90A3\u88E1\u53BB\u4E86\u3002\\c\\n\u96A7\u9053\u5C31\u5728\uFF17\u865F\u9053\u8DEF\u7684\u76E1\u982D\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6D1B\u8332\u6703\u9577\u2026\u2026\\c\\n\u4ED6\u751A\u81F3\u963B\u7919\u4E86\u51A0\u8ECD\u8CFD\u7684\u9032\u884C\uFF0C\\n\u7A76\u7ADF\u76EE\u7684\u662F\u4EC0\u9EBC\u5462\uFF01\uFF1F"
