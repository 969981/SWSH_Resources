  {
    "index": 18,
    "flags": 0,
    "text": "\u6211\u5011\u7684\u51A0\u8ECD\uFF01\\n[VAR 0100(0000)]\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5967\u5229\u8587\u771F\u7684\\n\u5F88\u53EF\u6015\u5C0D\u5427\u3002"
