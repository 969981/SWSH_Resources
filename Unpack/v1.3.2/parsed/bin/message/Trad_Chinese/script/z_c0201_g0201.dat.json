  {
    "index": 2,
    "flags": 0,
    "text": "\u8349\u5C6C\u6027\u5BF6\u53EF\u5922\u5BE6\u5728\u6EFF\u5BB9\u6613\\n\u53D7\u5230\u5929\u6C23\u6539\u8B8A\u5F71\u97FF\u7684\u2026\u2026"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8B93\u5929\u6C23\u6548\u679C\u7DAD\u6301\\n\u66F4\u9577\u6642\u9593\u7684\u9053\u5177\u554A\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u64C5\u9577\u4F7F\u7528\u92FC\u5C6C\u6027\u5BF6\u53EF\u5922\uFF01\\c\\n\u96D6\u7136\u9023\u6C99\u66B4\u4E5F\u4E0D\u6015\uFF0C\\n\u4F46\u9084\u662F\u8D0F\u4E0D\u4E86\u5947\u5DF4\u7D0D\u2026\u2026"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5947\u5DF4\u7D0D\u7684\u92C1\u92FC\u9F8D\u4E5F\u662F\u92FC\u5C6C\u6027\u554A\u2026\u2026\\n\u6211\u5230\u5E95\u54EA\u88E1\u505A\u5F97\u4E0D\u5C0D\uFF01\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7D42\u65BC\u5230\u6700\u5F8C\u7684\u9053\u9928\u4E86\uFF01\\n[VAR 0100(0000)]\u9078\u624B\u52A0\u6CB9\u5594\uFF01"
