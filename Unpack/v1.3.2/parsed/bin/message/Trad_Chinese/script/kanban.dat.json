  {
    "index": 17,
    "flags": 0,
    "text": "\u8349\u8DEF\u7AF6\u6280\u5834"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uFF15\u865F\u9053\u8DEF"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u60F3\u767C\u73FE\u5BF6\u53EF\u5922\u7684\u86CB\u55CE\uFF1F\\n\u5343\u842C\u5225\u932F\u904E\u2015\u2015\u5BC4\u653E\u5C4B\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[~ 20]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u544A\u793A\u677F\uFF01\\c\\n\u5E36\u6709\u6C23\u5834\u7684\u5BF6\u53EF\u5922\\n\u6703\u6BD4\u4E00\u822C\u7684\u5BF6\u53EF\u5922\u66F4\u5F37\u4E00\u4E9B\u3002\\c\\n\u6253\u5012\u7260\u5F8C\uFF0C\u9084\u53EF\u4EE5\u7372\u5F97\uFF37\u2026\u2026\\n\u4E5F\u5C31\u662F\u74E6\u7279\uFF01\\r\\n\u9019\u4E9B\u5BF6\u53EF\u5922\u88AB\u7A31\u70BA\u6C23\u5834\u5BF6\u53EF\u5922\uFF01\\c\\n\u64DA\u8AAA\uFF0C\u6355\u6349\u8D8A\u591A\u5BF6\u53EF\u5922\u7684\u8A13\u7DF4\u5BB6\uFF0C\\n\u8D8A\u5BB9\u6613\u9047\u898B\u6C23\u5834\u5BF6\u53EF\u5922\u5594\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6B61\u8FCE\u4F86\u5230\u6C34\u821F\u93AE\\c\\n\u5E02\u5834\u548C\u9910\u5EF3\u5438\u5F15\u773E\u591A\u4EBA\u6F6E\uFF0C\\n\u71B1\u9B27\u975E\u51E1\u7684\u6E2F\u93AE\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6C34\u821F\u7AF6\u6280\u5834"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6A5F\u64CE\u5E02\u90CA\u5916"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u2192\u3000\u7B2C\u4E8C\u7926\u5C71\\n\u2190\u3000\u6A5F\u64CE\u5E02"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6B61\u8FCE\u4F86\u5230\u62F3\u95DC\u5E02\\c\\n\u9019\u88E1\u7684\u5EFA\u7BC9\u878D\u5408\u4E86\u4E2D\u4E16\u7D00\u7684\u57CE\u7246\u907A\u8DE1\uFF0C\\n\u5145\u6EFF\u6FC3\u90C1\u7684\u6B77\u53F2\u6C23\u606F\uFF01"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uFF16\u865F\u9053\u8DEF"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u544A\u793A\u677F\uFF01\\c\\n\u62DB\u5F0F\u5B78\u7FD2\u5668\u53EF\u4EE5\u91CD\u8907\u4F7F\u7528\u3002\\c\\n\u8B93\u5BF6\u53EF\u5922\u5B78\u7FD2\u5404\u7A2E\u5C6C\u6027\u7684\u62DB\u5F0F\uFF0C\\n\u5C31\u80FD\u5C0D\u5404\u7A2E\u5BF6\u53EF\u5922\u4F7F\u51FA\u6709\u6548\u7684\u653B\u64CA\uFF01\\c\\n\u800C\u62DB\u5F0F\u7D00\u9304\u53EA\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\\n\u7528\u904E\u4E4B\u5F8C\uFF0C\u5C31\u6703\u58DE\u6389\u5594\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6EAF\u50B3\u93AE\\c\\n\u74B0\u7E5E\u8457\u53E4\u4EE3\u7684\u85DD\u8853\u907A\u8DE1\\n\u800C\u8208\u8D77\u7684\u5C71\u9593\u5C0F\u93AE\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u2191\u3000\u821E\u59FF\u93AE\\n\u2193\u3000\u6EAF\u50B3\u93AE"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u6EAF\u50B3\u93AE\u540D\u52DD\uFF01\\n\u4F3D\u52D2\u723E\u7684\u6B77\u53F2\u5927\u767C\u73FE\uFF01"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "[~ 32]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6EAF\u50B3\u7AF6\u6280\u5834"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u6B61\u8FCE\u4F86\u5230\u821E\u59FF\u93AE\\c\\n\u5728\u638F\u7A7A\u7684\u5DE8\u6A39\u4E2D\\n\u5EFA\u9020\u4E86\u4F4F\u5B85\u5340\u7684\u8FF7\u4EBA\u5C0F\u93AE\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u821E\u59FF\u7AF6\u6280\u5834"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uFF17\u865F\u9053\u8DEF"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u544A\u793A\u677F\uFF01\\c\\n\u7576\u5BF6\u53EF\u5922\u6B63\u5728\u9032\u5316\u6642\u6309\u4E0B\uFF22\u9375\uFF0C\\n\u53D7\u9A5A\u7684\u5BF6\u53EF\u5922\u5C31\u6703\u505C\u6B62\u9032\u5316\u3002\\c\\n\u9019\u5C31\u662F\u300C\u9032\u5316\u53D6\u6D88\u300D\u3002"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6B61\u8FCE\u4F86\u5230\u6230\u7AF6\u93AE\\c\\n\u53E4\u8001\u5EFA\u7BC9\u6ADB\u6BD4\u9C57\u6B21\u7684\\n\u6EAB\u6CC9\u5C0F\u93AE\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u544A\u793A\u677F\uFF01\\c\\n\u5BF6\u53EF\u5922\u5716\u9451\u6703\u986F\u793A\u63A8\u85A6\u7684\u5BF6\u53EF\u5922\u3002\\c\\n\u5C07\u7260\u5011\u5168\u90E8\u6349\u9F4A\uFF0C\u6216\u7D93\u904E\u4E00\u5929\u4E4B\u5F8C\uFF0C\\n\u63A8\u85A6\u7684\u5BF6\u53EF\u5922\u5C31\u6703\u66F4\u65B0\u3002"
