[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5149\u662F\u4F86\u5230\u9019\u88E1\u6211\u5C31\u5DF2\u7D93\u5FC3\u6EFF\u610F\u8DB3\u4E86\uFF0C\\n\u8981\u662F\u518D\u89AA\u773C\u770B\u5230\u907A\u8DE1\uFF0C\u90A3\u6703\u591A\u8B93\u4EBA\u6FC0\u52D5\u554A\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u770B\u907A\u8DE1\u770B\u5230\u5FD8\u6211\u4E86\u2026\u2026\\n\u90A3\u9B45\u529B\u771F\u662F\u7121\u6CD5\u7528\u8A00\u8A9E\u5F62\u5BB9\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5229\u7528\u907A\u8DE1\u7684\u58C1\u756B\u5E36\u52D5\u57CE\u5E02\u767C\u5C55\uFF01\\n\u5F9E\u4EE5\u524D\u5230\u73FE\u5728\u4E00\u5411\u5982\u6B64\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5580\u5566\u5580\u5566\u554A\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u563F\u4F0A\u563F\u6B38\u4F0A\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53D4\u53D4\u7684\u5BF6\u53EF\u5922\u5F88\u61F6\u6563\uFF0C\\n\u5BF6\u53EF\u5E6B\u5E6B\u5FD9\u62DB\u52DF\u5230\u7684\u5BF6\u53EF\u5922\u6BD4\u8F03\u6709\u5E79\u52C1\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F86\uFF0C\u548C\u9752\u9285\u9418\u73A9\u5427\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5431\u5660\u5660\u5660\u5660\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6B38\u6B38\uFF0C\\n\u7260\u7684\u5634\u5DF4\u5728\u54EA\u88E1\u554A\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u60F3\u6234\u4E0A\u9752\u9285\u9418\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9752\u9285\u9418\u6703\u8B93\u5929\u7A7A\u4E0B\u96E8\u55CE\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u54C6\u54E9\u54C6\u54E9\u54C6\u54E9\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8CB7\u500B\u907A\u8DE1\u5546\u54C1\u7576\u7D00\u5FF5\u5427\u3002\\n\u9019\u53EF\u662F\u5225\u8655\u8CB7\u4E0D\u5230\u7684\u73CD\u54C1\u5594\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u9019\u6A23\u6211\u7684\u884C\u674E\u4E0D\u5C31\u589E\u52A0\u4E86\u55CE\uFF1F\\n\u2026\u2026\u4E0D\u904E\uFF0C\u78BA\u5BE6\u883B\u597D\u770B\u7684\u5462\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u547C\u62C9\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4E39\u4E39\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u54C6\u54C6\u54C6\u54C6\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6211\u5440\uFF0C\u8981\u8B93\u5730\u9F20\\n\u770B\u770B\u6EAF\u50B3\u93AE\u7684\u907A\u8DE1\u3002\\c\\n\u641E\u4E0D\u597D\u80FD\u6FC0\u767C\\n\u7260\u7684\u85DD\u8853\u6F5B\u529B\u5462\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u600E\u9EBC\u4E86\u600E\u9EBC\u4E86\uFF01\uFF1F\\n\u5F9E\u907A\u8DE1\u90A3\u88E1\u50B3\u4F86\u5DE8\u97FF\u5566\u3002\\c\\n\u662F\u70BA\u89C0\u5149\u5BA2\\n\u6E96\u5099\u4E86\u4EC0\u9EBC\u9A5A\u559C\u55CE\uFF1F"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u907A\u8DE1\u7684\u4E8B\u2026\u2026\u4E5F\u5F97\u544A\u8A34\\n\u821E\u59FF\u93AE\u7684\u90A3\u4E9B\u50A2\u4F19\u624D\u884C\u3002\\c\\n\u6211\u60F3\u60F3\uFF0C\u8981\u53BB\u821E\u59FF\u93AE\uFF0C\\n\u5F97\u7A7F\u904E\u8611\u83C7\u68EE\u6797\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u5361\u5657\u5361\u5657\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u80FD\u5920\u6975\u5DE8\u5316\u7684\u5834\u6240\\n\u5C31\u53EB\u505A\u80FD\u91CF\u9EDE\u3002\\c\\n\u4F3D\u52D2\u723E\u5730\u5340\u7684\u9053\u9928\u7AF6\u6280\u5834\\n\u5C31\u5EFA\u5728\u80FD\u91CF\u9EDE\u4E0A\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5436\u5436\u5436\uFF1F\u600E\u9EBC\u5566\uFF1F\\n\u907A\u8DE1\u90A3\u908A\u767C\u751F\u4E86\u4EC0\u9EBC\u4E8B\u554A\uFF1F"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5436\u5436\u5436\uFF1F\u82F1\u96C4\u6307\u7684\u539F\u4F86\u662F\\n\u4EBA\u985E\u548C\u5BF6\u53EF\u5922\u55CE\uFF1F"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u771F\u662F\u9593\u96C4\u5049\u7684\u9053\u9928\u7AF6\u6280\u5834\u5462\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u7A81\u7136\u807D\u5230\u5DE8\u97FF\uFF0C\\n\u771F\u8B93\u4EBA\u611F\u5230\u4E0D\u5B89\u5462\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u9084\u662F\u88AB\u6BC0\u4E4B\u524D\\n\u66F4\u6709\u85DD\u8853\u6C23\u606F\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6D77\u55CE\u2026\u2026\\n\u4E0D\u662F\u5728\u5C71\u4E0A\u554A\u2026\u2026"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u7E3D\u89BA\u5F97\u5728\u54EA\u88E1\u770B\u904E\u2026\u2026\\n\u96E3\u9053\u662F\u9053\u9928\u6311\u6230\u8005\u2026\u2026"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6B63\u5728\u8ABF\u67E5\u907A\u8DE1\u771F\u76F8\u7684\u7D22\u59AE\u4E9E\u2026\u2026\\c\\n\u539F\u4F86\u662F\u6728\u862D\u535A\u58EB\u7684\u5B6B\u5973\u55CE\u2026\u2026\uFF1F"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u7684\u7A2E\u985E\u5F88\u591A\uFF0C\\n\u6709\u7684\u751F\u6D3B\u5728\u5C71\u4E0A\uFF0C\\r\\n\u6709\u7684\u68F2\u606F\u5728\u68EE\u6797\u4E2D\u3002"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u54A6\uFF1F\u525B\u525B\u7684\u8072\u97F3\u2026\u2026\\n\u662F\u96F7\u8072\uFF1F\u4E0D\u6703\u5427\uFF1F"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u8981\u53BB\u821E\u59FF\u93AE\uFF0C\\n\u5FC5\u9808\u7A7F\u904E\u8FF7\u5149\u68EE\u6797\u3002\\c\\n\u5728\u8FF7\u5149\u68EE\u6797\u88E1\u2026\u2026\\n\u8A18\u5F97\u6478\u4E00\u6478\u8611\u83C7\u5594\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u662F\u89C0\u5149\u5BA2\u55CE\uFF1F\\n\u9084\u662F\u6311\u6230\u8005\uFF1F"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u771F\u662F\u7CBE\u5F69\u7684\u6BD4\u8CFD\u3002\\n\u6253\u5F97\u5F88\u68D2\uFF01"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u662F\u627E\u5230\u907A\u8DE1\u7684\u51A0\u8ECD\uFF01"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u807D\u8AAA\u9053\u9928\u4EFB\u52D9\\n\u6703\u8B93\u4EBA\u6688\u982D\u8F49\u5411\uFF01"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u5927\u5BB6\u62FF\u4E86\u5FBD\u7AE0\u5F8C\uFF0C\\n\u8D70\u8DEF\u90FD\u6416\u6416\u6643\u6643\u7684\u2026\u2026"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u51A0\u8ECD\u597D\u5E25\uFF01\uFF01"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u8981\u9760\u6316\u5230\u7684\u5BF6\u7269\\n\u5927\u8CFA\u4E00\u7B46\u56C9\uFF01"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u8981\u9760\u6316\u5230\u7684\u5BF6\u7269\\n\u8CFA\u5927\u9322\u56C9\uFF01"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u6700\u8FD1\u90FD\u6C92\u6316\u5230\\n\u4EC0\u9EBC\u597D\u6771\u897F\u2026\u2026"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u6211\u89BA\u5F97\u58C1\u756B\u2026\u2026\\n\u756B\u5F97\u4E0D\u597D\u3002"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u597D\u60F3\u5FEB\u4E00\u9EDE\\n\u6349\u5230\u5BF6\u53EF\u5922\u554A\uFF01"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u90A3\u9762\u5D29\u584C\u7684\u58C1\u756B\u2026\u2026\\n\u6B63\u662F\u56E0\u70BA\u756B\u5DE5\u7C97\u7CD9\u624D\u597D\u5462\u3002"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u907A\u8DE1\u662F\u6EAF\u50B3\u93AE\u7684\u77E5\u540D\u666F\u9EDE\uFF0C\\n\u88AB\u8A8D\u70BA\u662F\u9AD8\u96C5\u7684\u85DD\u8853\u4F5C\u54C1\u3002"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u907A\u8DE1\u662F\u6EAF\u50B3\u93AE\u7684\u77E5\u540D\u666F\u9EDE\uFF0C\\n\u88E1\u9762\u85CF\u8457\u82F1\u96C4\u7684\u96D5\u50CF\u3002\\c\\n\u5169\u4F4D\u82F1\u96C4\u548C\\n\u5169\u96BB\u5BF6\u53EF\u5922\u4E26\u80A9\u5C79\u7ACB\u3002"
