[
  {
    "index": 0,
    "flags": 0,
    "text": "\u600E\u9EBC\u9019\u9EBC\u4E45\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54A6\uFF1F\u9084\u6C92\u5230\u5427\uFF1F\\n\u600E\u9EBC\u505C\u4E86\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u5011\u662F\u9053\u9928\u6311\u6230\u8005\u5427\uFF1F\\n\u611F\u8B1D\u4F60\u5011\u53C3\u52A0\u9053\u9928\u6311\u6230\uFF01\\c\\n\u4F46\u662F\uFF0C\u4E00\u4F86\u70BA\u4E86\u4E0D\u8B93\u4F60\u5011\\n\u6253\u64FE\u6703\u9577\uFF01\\c\\n\u4E8C\u4F86\uFF0C\u70BA\u4E86\u4FDD\u8B77\u6D1B\u8332\u5927\u5EC8\u88E1\u7684\\n\u591A\u5BB6\u95DC\u4FC2\u4F01\u696D\uFF0C\\r\\n\u6211\u8981\u628A\u4F60\u5011\u8D95\u56DE\u53BB\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8DB3\u4EE5\u9032\u884C\u5BF6\u53EF\u5922\u5C0D\u6230\u7684\u96FB\u68AF\uFF0C\\n\u662F\u6D1B\u8332\u5927\u5EC8\u81EA\u8C6A\u7684\u8A2D\u5099\u4E4B\u4E00\uFF01\\c\\n\u8CA0\u8CAC\u5EFA\u9020\u7684\u662F\u6211\u5011\u7684\u95DC\u4FC2\u4F01\u696D\uFF0C\\n\u99AC\u6D1B\u79D1\u8499\u5EFA\u8A2D\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u65E2\u7136\u8F38\u4E86\uFF0C\\n\u6211\u5C31\u4E56\u4E56\u9000\u5834\u5427\u3002\\c\\n\u4F46\u662F\uFF0C\\n\u4F60\u5011\u53EF\u5225\u53BB\u6253\u64FE\u6703\u9577\u554A\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6D1B\u8332\u5927\u5EC8\u7684\u96FB\u68AF\u53EA\u6709\u5730\u677F\u6703\u4E0A\u5347\u3002\\c\\n\u70BA\u4E86\u4FDD\u8B77\u4E58\u5BA2\u5B89\u5168\uFF0C\\n\u96FB\u68AF\u7684\u56DB\u5468\u9084\u6703\u6709\u5149\u7246\u5462\uFF01\\c\\n\u8ACB\u591A\u591A\u652F\u6301\u99AC\u6D1B\u79D1\u8499\u5EFA\u8A2D\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u539F\u4F86\u5728\u5927\u5EC8\u88E1\u5DE5\u4F5C\u7684\u4EBA\\n\u6703\u5F9E\u5916\u9762\u64CB\u4E0B\u96FB\u68AF\uFF01\\r\\n\u6211\u5011\u6025\u8457\u8981\u5230\u9802\u6A13\u8036\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u4F86\u5E6B\u8CE3\u529B\u5C0D\u6230\u7684\u5BF6\u53EF\u5922\u5011\\n\u6062\u5FA9\u6D3B\u529B\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6D1B\u8332\u5927\u5EC8\u9AD8\u9054\uFF13\uFF10\uFF10\u516C\u5C3A\uFF0C\\n\u76EE\u524D\u7684\u9AD8\u5EA6\u662F\uFF11\uFF15\uFF10\u516C\u5C3A\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u5011\u662F\uFF2D\uFF23\u4EBA\u58FD\u7684\u696D\u52D9\u54E1\uFF01\\n\u4F60\u5011\u6709\u8CB7\u4FDD\u96AA\u55CE\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5176\u5BE6\u6211\u6709\u61FC\u9AD8\u75C7\u2026\u2026"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8F38\u4E86\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\n\u4E5F\u6C92\u6709\u4FDD\u96AA\u91D1\u53EF\u9818\u554A\u2026\u2026"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u5011\u5FEB\u5230\u9802\u6A13\u4E86\uFF01\\n\u4F46\u662F\uFF0C\u6211\u4E0D\u6703\u8B93\u4F60\u5011\u898B\u5230\u6703\u9577\u7684\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u4E00\u9EDE\u5152\u90FD\u4E0D\u6015\u9AD8\uFF01\\c\\n\u56E0\u70BA\u6211\u5728\u99AC\u6D1B\u79D1\u8499\u822A\u7A7A\u5DE5\u4F5C\uFF0C\\n\u5929\u7A7A\u5C31\u662F\u6211\u7684\u8077\u5834\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4F60\u5011\u4F11\u60F3\u898B\u5230\u6703\u9577\u3002\\n\u5F8C\u9762\u9084\u6709\u500B\u7D55\u5C0D\u6703\u64CB\u4E0B\u4F60\u5011\u7684\u4EBA\u2026\u2026\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5728\u9019\u7A2E\u9AD8\u6A13\u5927\u5EC8\uFF0C\u4E00\u822C\u662F\u6A13\u5C64\u8D8A\u9AD8\uFF0C\\n\u5728\u90A3\u88E1\u7684\u4EBA\uFF0C\u5730\u4F4D\u4E5F\u5C31\u8D8A\u9AD8\u3002\\c\\n\u5C31\u50CF\u5728\u9802\u6A13\u8FA6\u516C\u7684\u6D1B\u8332\u6703\u9577\u3002\\n\u4ED6\u662F\u540D\u526F\u5176\u5BE6\u7684\u2026\u2026\\r\\n\u9AD8\u9AD8\u5728\u4E0A\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u770B\u4F86\u6211\u5011\u5FEB\u5230\u56C9\u3002\\n\u5225\u9B06\u61C8\u554A\uFF01[VAR 0114(0005)]"
  }
]
