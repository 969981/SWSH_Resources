  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9019\u5BF6\u53EF\u5922\u5C31\u662F\\n\u99AC\u5E2B\u5085\u6B66\u9928\u7684\u79D8\u50B3\u93A7\u7532\uFF01\\r\\n\u540D\u70BA\u2026\u2026\u718A\u5F92\u5F1F\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u96D6\u7136\u500B\u982D\u5152\u5C0F\uFF0C\\n\u4F46\u662F\u53EA\u8981\u7AEF\u7AEF\u6B63\u6B63\u5730\u57F9\u80B2\u7260\uFF0C\\c\\n\u7260\u5C31\u6703\u6210\u70BA\u5805\u56FA\u7684\u93A7\u7532\uFF0C\\n\u80FD\u5920\u963B\u64CB\u4EFB\u4F55\u6575\u4EBA\u7684\u653B\u64CA\u5537\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C24\u5176\u9019\u5B69\u5B50\uFF0C\\n\u7260\u85CF\u8457\u5F88\uFF5E\u53B2\u5BB3\u7684\u624D\u80FD\uFF01\\r\\n\u53EA\u662F\u500B\u6027\u6709\u4E00\u9EDE\u5167\u5411\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7260\u597D\u50CF\u5C31\u662F\u6C92\u8FA6\u6CD5\\n\u5C0D\u81EA\u5DF1\u6709\u4FE1\u5FC3\u54EA\u3002[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8001\u982D\u5152\u6211\u60F3\u8AAA\uFF0C\\n\u8981\u662F\u7260\u548C[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u8D77\u5192\u96AA\uFF0C\\c\\n\u8AAA\u4E0D\u5B9A\u5C31\u80FD\u7834\u6BBC\u800C\u51FA\uFF0C\\n\u5C55\u73FE\u81EA\u6211\u5566\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5C31\u662F\u9019\u9EBC\u4E00\u56DE\u4E8B\uFF01\\n\u4EE5\u5F8C\uFF0C\u718A\u5F92\u5F1F\u5C31\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u5695\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5504\u3001\u5504\uFF5E\u554A\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u718A\u5F92\u5F1F\u6210\u70BA\u4E86\\n[VAR 0100(0000)]\u7684\u5BF6\u53EF\u5922\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9996\u5148\u5462\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u5011\u5006\u5F97\u8B8A\u6210\u597D\u670B\u53CB\uFF0C\\n\u5F7C\u6B64\u4E92\u76F8\u4FE1\u4EFB\u624D\u884C\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u90A3\u5B69\u5B50\u9084\u6C92\u4EC0\u9EBC\u6A5F\u6703\\n\u5230\u6B66\u9928\u5916\u9762\u53BB\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6240\u4EE5\u4F60\u5011\u53EA\u8981\u5230\u93A7\u5CF6[VAR FF00(0006)]\u98A8\u666F\u597D\u7684\u5730\u65B9[VAR FF00(0000)]\\n\u4E00\u8D77\u770B\u770B\u98A8\u666F\uFF0C\\r\\n\u61C9\u8A72\u5F88\u5FEB\u5C31\u80FD\u8B93\u7260\u653E\u4E0B\u6212\u5FC3\u4E86\u5537\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u6703\u8B93\u5F92\u5F1F\u5011\u7AD9\u5728\u6F02\u4EAE\u7684\u666F\u9EDE\u9644\u8FD1\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u7576\u4ED6\u5011\u662F\u8DEF\u6A19\u5427\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u7576\u7136\u900F\u904E\u5C0D\u6230\u6216\u662F\u53BB\u9732\u71DF\uFF0C\\n\u4E5F\u662F\u53EF\u4EE5\u52A0\u6DF1\u4F60\u5011\u5006\u7684\u727D\u7D46\u5566\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u662F[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8A71\uFF0C\u9084\u53EF\u4EE5\u628A\\n\u6392\u5728\u6700\u524D\u9762\u7684\u5BF6\u53EF\u5922\u5F9E\u7403\u88E1\u653E\u51FA\u4F86\uFF0C\\r\\n\u5728\u93A7\u5CF6[VAR FF00(0006)]\u5E36\u8457\u4E00\u8D77\u8D70[VAR FF00(0000)]\u5537\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4E00\u8D77\u8D70\uFF0C\u611F\u60C5\u5F88\u5FEB\u5C31\u6703\u8B8A\u597D\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5118\u7BA1\u548C\u718A\u5F92\u5F1F\u5230\u8655\u53BB\u8D70\u8D70\u5427\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u7B49\u4F60\u5011\u7684\u611F\u60C5\u597D\u5F97\u4E0D\u5F97\u4E86\u6642\uFF0C\\n\u5C31\u53EF\u4EE5\u5E6B\u718A\u5F92\u5F1F\u958B\u59CB\u4FEE\u884C\u4E86\u3002\\r\\n\u5230\u6642\u5019\u4F86\u544A\u8A34\u8001\u982D\u5152\u6211\u4E00\u8072\u5537\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u79D8\u50B3\u93A7\u7532\u7ADF\u7136\u662F\u5BF6\u53EF\u5922\uFF01\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\\n\u7260\u7684\u52D5\u4F5C\u5BE6\u5728\u662F\u592A\u9A5A\u4EBA\u5566\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u514B\u62C9\u62C9\u597D\u6D88\u6C89\u54EA\u3002\\c\\n\u6211\u80FD\u5E6B\u5979\u505A\u4E9B\u4EC0\u9EBC\u54A7\uFF5E\uFF1F"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u8CFD\u5BF6\u5229\u597D\u6D88\u6C89\u54EA\u3002\\c\\n\u6211\u80FD\u5E6B\u4ED6\u505A\u4E9B\u4EC0\u9EBC\u54A7\uFF5E\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u70BA\u4E86\u4E0B\u6B21\u7A81\u7136\u5F97\u958B\u59CB\u4FEE\u884C\u6642\\n\u4E0D\u8B93\u81EA\u5DF1\u5F8C\u6094\uFF0C\\c\\n\u6211\u5F9E\u73FE\u5728\u8D77\u5C31\u8981\u4ED4\u7D30\u6E96\u5099\u5566\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u4E0D\u8AD6\u4EC0\u9EBC\u4E8B\u60C5\uFF0C\u53EA\u8981\u4E00\u908A\u505A\uFF0C\\n\u4E00\u908A\u601D\u8003\u5B83\u7684\u610F\u7FA9\uFF0C\\r\\n\u5C31\u80FD\u8B93\u81EA\u5DF1\u66F4\u8A8D\u771F\u53BB\u5B8C\u6210\u5B83\u5537\u3002"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u93A7\u5CF6\u5468\u570D\u6709\u5F88\u591A\u5C0F\u5CF6\uFF01\\c\\n\u9A0E\u8457\u80FD\u5728\u6C34\u4E0A\u79FB\u52D5\u7684\u81EA\u884C\u8ECA\\n\u53BB\u770B\u770B\u5404\u500B\u5CF6\uFF0C\u4E5F\u633A\u68D2\u7684\u5537\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u65E2\u7136\u4FEE\u884C\u5DF2\u7D93\u544A\u4E00\u6BB5\u843D\u4E86\uFF0C\\n\u6211\u662F\u4E0D\u662F\u8A72\u53BB\u6536\u96C6\u4E9B\u93A7\u7532\u7926\u77F3\uFF0C\\r\\n\u597D\u597D\u8CFA\u4E00\u7B46\u54A7\uFF1F"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u4E5F\u5DEE\u4E0D\u591A\u662F\u6642\u5019\\n\u8A72\u505A\u4E9B\u5C0F\u865F\u7684\u4FEE\u884C\u5957\u88DD\u4E86\u5427\uFF5E"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u64DA\u8AAA\u718A\u5F92\u5F1F\u662F\u99AC\u58EB\u5FB7\u5E2B\u5085\\n\u5728\u74B0\u904A\u4E16\u754C\u7684\u6642\u5019\uFF0C\\c\\n\u5728\u6D77\u5916\u9047\u898B\uFF0C\u7136\u5F8C\u5E36\u56DE\u9019\u88E1\u7684\u5537\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u770B\u90A3\u79D8\u50B3\u93A7\u7532\u7684\u8EAB\u624B\uFF01\\n\u563F\u563F\uFF01\u597D\u671F\u5F85\u7260\u7684\u5C07\u4F86\u554A\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u718A\u5F92\u5F1F\u597D\u53EF\u611B\u5537\uFF01\\n\u65E9\u77E5\u9053\u6211\u5C31\u66F4\u52AA\u529B\u4E00\u9EDE\u4E86\uFF01"
  },
