[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u8005\uFF0C\u6B61\u8FCE[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u5C31\u662F\u9732\u7483\u5A1C\uFF0C\u6211\u5011\u898B\u904E\u9762\u4E86\u3002\\n\u525B\u624D\u9084\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u7279\u5730\u4F86\u627E\u6211\uFF0C\u771F\u662F\u62B1\u6B49\u3002[VAR 0114(000F)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u662F\u6211\u8981\u81EA\u8A87\u2026\u2026\\n\u4F46\u6211\u7684\u4EFB\u52D9\u53EF\u4E0D\u662F\u666E\u901A\u7684\u96E3\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u5C31\u9019\u6A23\u5B8C\u6210\u4E86\u3002\\c\\n\u770B\u6A23\u5B50\u2026\u2026[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u500B\\n\u601D\u8DEF\u6E05\u6670\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u5462\u3002[VAR 0114(000F)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F46\u4E0D\u8AD6[VAR 1100(00FF,0101)]\u4F60\u59B3\u7528\u90A3\u8070\u660E\u8166\u888B\\n\u4F7F\u51FA\u4EC0\u9EBC\u6A23\u7684\u6230\u8853\uFF0C\\c\\n\u6211\u548C\u6211\u50B2\u4EBA\u7684\u5925\u4F34\u5011\uFF0C\\n\u90FD\u6703\u5C07\u5B83\u6C96\u57AE\u7684\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9019\u2026\u2026\uFF01\\n\u600E\u9EBC\u6703\u9019\u6A23\uFF01\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u547C\u2026\u2026\\n\u8207\u4F60\u5011\u5C0D\u6230\u5F8C\uFF0C\u6211\u660E\u767D\u4E86\u3002[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u5011\u7684\u968A\u4F0D\u6709\u5F88\u68D2\u7684\u5C0D\u6230\u7CBE\u795E\u3002\\n\u8DB3\u4EE5\u5728\u9053\u9928\u6311\u6230\u4E2D\u812B\u7A4E\u800C\u51FA\uFF0C\\r\\n\u7372\u5F97\u6311\u6230\u51A0\u8ECD\u7684\u6A5F\u6703\u3002[VAR 0114(000F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6536\u4E0B\u5427\u2026\u2026\\n\u4F60\u5011\u6709\u8CC7\u683C\u62FF\u5230\u9019\u500B\u5FBD\u7AE0\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u80FD\u6355\u6349\u7B49\u7D1A\uFF13\uFF10\u4EE5\u4E0B\u7684\u5BF6\u53EF\u5922\u4E86\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u63A5\u4E0B\u4F86\u4F60\u5011\u8981\u6311\u6230\u7684\\n\u5C31\u662F\u706B\u5C6C\u6027\u7684\u9053\u9928\u9928\u4E3B\u4E86\u3002\\c\\n\u4EE5\u4F60\u5011\u73FE\u5728\u7684\u5BE6\u529B\uFF0C\\n\u4ED6\u4E5F\u6703\u9858\u610F\u8207\u4F60\u5011\u5C0D\u6230\u7684\u3002[VAR 0114(000F)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u9078\u624B\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6230\u52DD\u9053\u9928\u9928\u4E3B\u9732\u7483\u5A1C\u5C0F\u59D0\u4E86\uFF01\\r\\n\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\\c\\n\u8ACB\u6536\u4E0B\u9019\u500B\u62DB\u5F0F\u5B78\u7FD2\u5668\\n\u7576\u4F5C\u7D00\u5FF5\u5427\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9019\u5957\u8207\u9732\u7483\u5A1C\u5C0F\u59D0\u540C\u6B3E\u7684\u7AF6\u6280\u670D\\n\u4E5F\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7CBE\u5F69\u8D0F\u5F97\u6C34\u4E4B\u5FBD\u7AE0\u7684\u4F60\u5011\uFF0C\\n\u7A76\u7ADF\u6703\u5728\u9053\u9928\u6311\u6230\u4E2D\u8D70\u591A\u9060\u5462\uFF1F\\r\\n\u6211\u6703\u62ED\u76EE\u4EE5\u5F85\u7684\uFF01"
  },
  {
