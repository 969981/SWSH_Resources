[
  {
    "index": 0,
    "flags": 0,
    "text": "\u662F\u95DC\u65BC\u738B\u51A0\u96EA\u539F\u7684\u66F8\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8981\u8B80\u54EA\u672C\u66F8\u5462\uFF1F"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8981\u63A5\u8457\u8B80\u8B80\u5225\u7684\u66F8\u55CE\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8C50\u9952\u4E4B\u738B"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u570B\u738B\u7684\u611B\u99AC"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u727D\u7D46\u97C1\u7E69"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u96EA\u539F\u7684\u852C\u83DC"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u51CD\u51DD\u6751\u96EA\u4E2D\u821E"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u540D\u7522\u7684\u9748\u611F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u9084\u662F\u7B97\u4E86"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8C50\u9952\u4E4B\u738B\u4E43\u662F\u70BA\u6B64\u5730\\n\u5E36\u4F86\u8C50\u9952\u7684\u5BF6\u53EF\u5922\u3002\\c\\n\u7576\u7260\u8209\u8D77\u53F3\u624B\uFF0C\\n\u5373\u53EF\u4F7F\u767E\u82B1\u7DBB\u653E\uFF0C\u7DA0\u8349\u5982\u8335\u3002\\c\\n\u7576\u7260\u8209\u8D77\u5DE6\u624B\uFF0C\\n\u5373\u53EF\u4F7F\u7530\u5730\u80A5\u6C83\uFF0C\u4F5C\u7269\u8C50\u6536\u3002\\c\\n\u7576\u7260\u9802\u8457\u9583\u8000\u7684\u5DE8\u5927\u9752\u7DA0\u738B\u51A0\uFF0C\\n\u8207\u611B\u99AC\u5BF6\u53EF\u5922\u4E00\u540C\u5954\u99B3\u5728\u5927\u5730\u4E4B\u969B\uFF0C\\c\\n\u751F\u547D\u5C07\u7531\u7260\u7684\u8DB3\u8DE1\u4E2D\u840C\u82BD\uFF0C\\n\u571F\u5730\u5C07\u56E0\u7260\u7684\u9020\u8A2A\u800C\u8C50\u9952\u3002\\c\\n\u6545\u6211\u7B49\u5949\u7260\u70BA\u738B\uFF0C\\n\u4FE1\u4EF0\u5D07\u62DC\u7260\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7260\u662F\u570B\u738B\u7684\u6EAB\u9806\u5750\u9A0E\uFF0C\\n\u4E14\u80FD\u5920\u6FC0\u767C\u570B\u738B\u7684\u529B\u91CF\u3002\\c\\n\u7576\u5169\u8005\u5408\u800C\u70BA\u4E00\u6642\uFF0C\\n\u751A\u81F3\u80FD\u5920\u5728\u4E00\u591C\u4E4B\u9593\u5B55\u80B2\u51FA\u68EE\u6797\u3002\\c\\n\u7260\u539F\u672C\u6027\u60C5\u975E\u5E38\u66B4\u8E81\uFF0C\\n\u751A\u81F3\u6703\u6436\u98DF\u6751\u5B50\u7684\u8FB2\u4F5C\u7269\uFF0C\\r\\n\u4F7F\u5F97\u4EBA\u985E\u975E\u5E38\u982D\u75DB\u3002\\c\\n\u6240\u5E78\u570B\u738B\u52F8\u8AEB\u4E86\u7260\uFF0C\\n\u4E26\u5C07\u7260\u6536\u670D\u70BA\u81EA\u5DF1\u7684\u4E0B\u5C6C\u3002\\c\\n\u6709\u4EBA\u8AAA\u7260\u7684\u6BDB\u8272\u96EA\u767D\\n\u7336\u5982\u51CD\u5FB9\u5FC3\u9AA8\u7684[VAR FF00(0006)]\u51B0[VAR FF00(0000)]\uFF0C\\c\\n\u4E5F\u6709\u4EBA\u8AAA\u7260\u7684\u6BDB\u8272\u6F06\u9ED1\\n\u5982\u540C\u878D\u5165\u9ED1\u591C\u7684[VAR FF00(0006)]\u5E7D\u9748[VAR FF00(0000)]\u3002\\c\\n\u4F46\u6C92\u6709\u4EBA\u77E5\u9053\u7A76\u7ADF\\n\u54EA\u4E00\u7A2E\u8AAA\u8A5E\u624D\u662F\u6B63\u78BA\u7684\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6B64\u4E43\u8C50\u9952\u4E4B\u738B\u99B4\u670D\u611B\u99AC\u4E4B\u969B\\n\u704C\u6CE8\u4E86\u81EA\u8EAB\u529B\u91CF\u7684\u97C1\u7E69\uFF0C\\c\\n\u5E74\u5E74\u7531\u6211\u7B49\u4EBA\u985E\u737B\u7D66\\n\u8CDC\u5927\u5730\u8C50\u6536\u7684\u570B\u738B\u3002\\c\\n\u6B64\u7269\u4E0D\u50C5\u662F\u570B\u738B\u8207\u611B\u99AC\u7684\u727D\u7D46\uFF0C\\n\u4EA6\u662F\u570B\u738B\u8207\u4EBA\u985E\u7684\u9023\u7D50\u3002\\c\\n\u5F8C\u4E16\u5207\u4E0D\u53EF\u5FD8\u5728\u4E00\u5E74\u4E4B\u59CB\uFF0C\\n\u5C07\u6B64\u97C1\u7E69\u737B\u7D66\u570B\u738B\u3002\\c\\n\u97C1\u7E69\u9700\u4EE5\u5149\u8F1D\u4E4B\u82B1\u8207\u99AC\u5BF6\u53EF\u5922\u7684\\n\u9B03\u6BDB\u5C64\u5C64\u76F8\u758A\uFF0C\u7DE8\u7E54\u800C\u6210\u3002\\c\\n\u50B3\u627F\u8005\u52D9\u5FC5\u7262\u8A18\u88FD\u6CD5\u53E3\u8A23\uFF0C\\n\u5B50\u5B50\u5B6B\u5B6B\u4E16\u4EE3\u76F8\u50B3\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u738B\u51A0\u96EA\u539F\u7684\u863F\u8514\u6709\u8457\\n\u5947\u7279\u7684\u751F\u9577\u65B9\u5F0F\u3002\\c\\n\u5728\u7A4D\u96EA\u6DF1\u539A\u7684\u571F\u5730\u7684\u7530\u88E1\uFF0C\\n\u5B83\u6703\u9577\u6210\u51B0\u863F\u8514\u3002\\c\\n\u5728\u58B3\u5893\u65C1\u7684\u7530\u5730\u88E1\uFF0C\\n\u5B83\u5247\u6703\u9577\u6210\u9ED1\u863F\u8514\u3002\\c\\n[VAR FF00(0006)]\u51B0\u5C6C\u6027[VAR FF00(0000)]\u7684\u5BF6\u53EF\u5922\\n\u559C\u611B\u51B0\u863F\u8514\u3002\\c\\n[VAR FF00(0006)]\u5E7D\u9748\u5C6C\u6027[VAR FF00(0000)]\u7684\u5BF6\u53EF\u5922\\n\u559C\u611B\u9ED1\u863F\u8514\u3002\\c\\n\u7AE5\u8A71\u6545\u4E8B\u88E1\u767B\u5834\u7684\\n\u8C50\u9952\u4E4B\u738B\u7684\u611B\u99AC\\r\\n\u4E5F\u975E\u5E38\u559C\u6B61\u5403\u863F\u8514\u3002\\c\\n\u4F46\u662F\u5728\u4E00\u4E9B\u66F8\u88E1\u9762\u662F\u5BEB\u8457\\n\u767D\u8272\u7684\u611B\u99AC\u5728\u5403\u51B0\u863F\u8514\uFF0C\\c\\n\u5728\u5176\u4ED6\u4E00\u4E9B\u66F8\u88E1\u53C8\u662F\u5BEB\u8457\\n\u9ED1\u8272\u7684\u611B\u99AC\u5728\u5403\u9ED1\u863F\u8514\u3002\\c\\n\u76EE\u524D\u4E0D\u77E5\u9053\u70BA\u4EC0\u9EBC\\n\u6703\u6709\u9019\u5169\u7A2E\u4E0D\u540C\u7684\u63CF\u8FF0\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u96EA\u539F\u7684\u6C23\u6EAB\u4E00\u5E74\u6BD4\u4E00\u5E74\u5BD2\u51B7\uFF0C\\n\u60A8\u662F\u5426\u89BA\u5F97\u5FEB\u8981\u53D7\u4E0D\u4E86\u4E86\u5462\uFF1F\\c\\n\u5982\u679C\u7E3D\u662F\u7AA9\u5728\u6696\u547C\u547C\u7684\u5BB6\u88E1\uFF0C\\n\u4E00\u4E0D\u6CE8\u610F\u5C31\u6703\u7F3A\u4E4F\u904B\u52D5\u7684\u3002\\c\\n\u8B93\u6211\u5011\u4E00\u8D77\u4F86\u8DF3\u300C\u51CD\u51DD\u6751\u96EA\u4E2D\u821E\u300D\uFF0C\\n\u9069\u7576\u5730\u6D3B\u52D5\u7B4B\u9AA8\uFF0C\u63D0\u9AD8\u9AD4\u6EAB\u5427\uFF01\\c\\n\u8209\u8D77\u96D9\u624B\uFF0C\u563F\u5440\u563F\u5440\u563F\uFF01\\n\u6DF1\u6DF1\u5F4E\u8170\uFF0C\u626D\u5440\u626D\u5440\u626D\uFF01\\c\\n\u4F86\uFF01\u4E00\u8D77\u570D\u6210\u5708\uFF0C\u8DF3\u8DF3\u51CD\u51DD\u6751\u96EA\u4E2D\u821E\u3002\\n\u4FDD\u8B49\u8B93\u60A8\u7684\u9280\u9AEE\u751F\u6D3B\u5065\u5EB7\u4E0D\u843D\u4F0D\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u51CD\u51DD\u6751\u89C0\u5149\u63A8\u5EE3\u8AB2\\n\u300C\u540D\u7522\u9748\u611F\u5FB5\u9078\u6D3B\u52D5\u300D\u2026\u2026\\c\\n\u7D93\u904E\u5BE9\u67E5\u5F8C\uFF0C\u6211\u5011\u6C7A\u5B9A\\n\u672C\u6B21\u88FD\u4F5C\u7684\u5546\u54C1\u662F\\r\\n\u8C50\u9952\u4E4B\u738B\u7684\uFF34\u6064\uFF01\\c\\n\u6211\u5011\u6703\u5584\u7528\u73FE\u6709\u7684\u820A\u8CC7\u6599\\n\u7BC0\u7701\u8A2D\u8A08\u8CBB\u7684\u958B\u92B7\uFF01\\c\\n\u51CD\u51DD\u6751\u89C0\u5149\u63A8\u5EE3\u8AB2\\n\u611F\u8B1D\u5927\u5BB6\u8E34\u8E8D\u53C3\u52A0\u672C\u6B21\u6D3B\u52D5\u3002"
  }
]
