    "text": "[VAR 0100(0000)]\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\uFF0C\\n\u662F\u8A31\u9858\u661F\uFF01\uFF01\\c\\n\u800C\u4E14\u6709\uFF12\u500B\u8036\uFF01\\n\u4F86\uFF0C\uFF11\u500B\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u8A31\u9858\u661F\uFF0C\\n\u6211\u7684\u5BF6\u53EF\u5922\u5C31\u53EF\u4EE5\u6975\u5DE8\u5316\u56C9\uFF01\\r\\n\u7260\u5011\u4E00\u5B9A\u6703\u8B8A\u5F97\u8D85\u7D1A\u7121\u6575\u5927\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u771F\u662F\u592A\u96E3\u5F97\u4E86\uFF01\\c\\n\u64DA\u8AAA\u8A31\u9858\u661F\u6703\u843D\u5728\\n\u8A8D\u771F\u5730\u5E0C\u671B\u5BE6\u73FE\u5922\u60F3\u7684\u4EBA\u8EAB\u65C1\u5462\u3002[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u8981\u6210\u70BA\u6700\u5F37\u7684\u8A13\u7DF4\u5BB6\uFF01\\c\\n\u6211\u8981\u6210\u70BA\u6700\u5F37\u7684\u8A13\u7DF4\u5BB6\uFF01\uFF01\\c\\n\u6211\u8981\u6210\u70BA\u6700\u5F37\u7684\u8A13\u7DF4\u5BB6\uFF01\uFF01\uFF01\\c\\n\u597D\uFF01\u5538\u5B8C\uFF13\u6B21\u4E86\uFF0C\\n\u6211\u7684\u5FC3\u9858\u4E00\u5B9A\u6703\u5BE6\u73FE\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8D6B\u666E\u3002\\c\\n\u8A31\u9858\u661F\u662F\u85CF\u6709\\n\u672A\u77E5\u529B\u91CF\u7684\u795E\u79D8\u77F3\u982D\u2026\u2026\\r\\n\u53EF\u8AAA\u662F\u4F3D\u52D2\u723E\u5730\u5340\u7684\u73CD\u5BF6\u3002\\c\\n\u4F46\u662F\uFF0C\u5149\u6709\u539F\u77F3\u662F\u6C92\u6709\u7528\u7684\u3002\\n\u4F60\u5011\u628A\u5B83\u66AB\u6642\u4EA4\u7D66\u6211\u5427\u3002[VAR 0114(000A)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5C0D\u5594\uFF01\u535A\u58EB\u662F\u6975\u5DE8\u5316\u7684\u5C08\u5BB6\uFF01\\c\\n\u62DC\u8A17\u4E86\uFF0C\u8B93\u6211\u548C[VAR 0100(0000)]\\n\u4E5F\u80FD\u6709\u904B\u7528\u6975\u5DE8\u5316\u7684\u529B\u91CF\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u60F3\u5230\u4E4B\u524D\u6211\u5011\u9084\u5728\u5FAE\u5BD0\u68EE\u6797\uFF0C\\n\u548C\u795E\u79D8\u7684\u5BF6\u53EF\u5922\u5C0D\u6230\u904E\u2026\u2026\\r\\n\u597D\u50CF\u5C31\u8981\u6709\u9A5A\u4EBA\u7684\u4E8B\u60C5\u767C\u751F\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u80FD\u7406\u89E3\u4F60\u8208\u596E\u7684\u5FC3\u60C5\uFF0C\\n\u4F46\u662F\u70BA\u4E86\u660E\u5929\u8D77\u7684\u5192\u96AA\uFF0C\\r\\n\u73FE\u5728\u9084\u662F\u4FDD\u7559\u4E00\u4E9B\u9AD4\u529B\u5427\u3002[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u4E00\u56DE\u4F86\u600E\u9EBC\u5C31\u9019\u9EBC\u71B1\u9B27\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF0C\u4F60\u5011\u6703\u7559\u4E0B\u4F86\u5403\u665A\u98EF\u5427\uFF1F\\c\\n\u6211\u8FF7\u4E0A\u4E86\u6700\u8FD1\u6B63\u6D41\u884C\u7684\u5496\u54E9\uFF0C\\n\u6B63\u5728\u5617\u8A66\u5404\u7A2E\u98DF\u8B5C\u5594\uFF01[VAR 0114(000B)]"
