    "text": "\u54C7\uFF01\\n[VAR 0100(0000)]\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u554A\u2026\u2026\u62B1\u6B49\u5436\uFF01\\c\\n\u5C16\u91D8\u93AE\u7684\u5927\u5BB6\u7ADF\u7136\u8AAA\uFF0C\\n\u4ED6\u5011\u628A\u9435\u6372\u9580\u7D66\u95DC\u4E0A\uFF0C\\r\\n\u90FD\u662F\u70BA\u6211\u597D\u2026\u2026[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C16\u91D8\u93AE\u6700\u8FD1\u662F\u8D8A\u4F86\u8D8A\u6C92\u843D\u3002\\c\\n\u4F46\u9053\u9928\u9928\u4E3B\u8076\u6893\u7E3D\u662F\u8AAA\\n\u300C\u6C92\u554F\u984C\u7684\u5566\uFF01\u300D\u3002[VAR 0114(0043)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6240\u4EE5\u2026\u2026\uFF01\\n\u6211\u5011\u624D\u6703\u8B8A\u88DD\u6210\u5436\u558A\u968A\uFF0C\\r\\n\u5230\u8655\u59A8\u7919\u9053\u9928\u6311\u6230\u8005\u5436\u3002[VAR 0114(0044)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53EA\u8981\u8B93\u90A3\uFF5E\u4E9B\u5176\u4ED6\u7684\u6311\u6230\u8005\\n\u5168\u90FD\u5230\u4E0D\u4E86\u9019\u500B\u9053\u9928\uFF0C\\c\\n\u6700\u5F8C\u5C31\u6703\u53EA\u5269\u4E0B\u5927\u5C0F\u59D0\\n\u9806\u5229\u6649\u7D1A\u51A0\u8ECD\u76C3\u4E86\u5504\uFF5E\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9019\u9EBC\u4E00\u4F86\uFF0C\\n\u6211\u5011\u7684\u5927\u5C0F\u59D0\u5C31\u6709\u66F4\u5927\u7684\u6A5F\u6703\u2026\u2026\\r\\n\u767B\u4E0A\u65B0\u51A0\u8ECD\u7684\u5BF6\u5EA7\u4E86\u5436\uFF01[VAR 0114(0044)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u50BB\u554A\u2026\u2026\u62DC\u8A17\uFF01\\n\u9019\u6839\u672C\u4E0D\u662F\u5728\u5E6B\u6211\u52A0\u6CB9\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u5225\u7BA1\u4EC0\u9EBC\\n\u9053\u9928\u6311\u6230\u7684\u6B63\u5F0F\u624B\u7E8C\u4E86\uFF0C\\r\\n\u76F4\u63A5\u53BB\u6311\u6230\u9053\u9928\u9928\u4E3B\u5504\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5927\u5C0F\u59D0\u4E00\u65E6\u958B\u59CB\u6559\u8A13\u4EBA\u2026\u2026\\n\u662F\u6C92\u5B8C\u6C92\u4E86\u7684\u2026\u2026\\c\\n\u4E4B\u524D\u6417\u86CB\u6328\u7F75\u7684\u83AB\u9B6F\u8C9D\u53EF\\n\u9084\u807D\u5230\u660F\u660F\u6B32\u7761\u2026\u2026[VAR 0114(0043)]"
  },
  {
    "index": 10,
