  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u525B\u624D\u90A3\u500B\u2026\u2026\u8981\u662F\u6211\u592A\u5F31\uFF0C\\n\u6703\u8B93\u5927\u54E5\u88AB\u770B\u6241\u7684\u4E8B\u2026\u2026\\r\\n\u6211\u5BE6\u5728\u662F\u4E0D\u77E5\u9053\u8A72\u600E\u9EBC\u8FA6\u554A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u96D6\u7136\u9084\u6C92\u6709\u7B54\u6848\u2026\u2026\\n\u4F46\u6211\u4E5F\u53EA\u80FD\u8B93\u81EA\u5DF1\u8B8A\u5F97\u66F4\u5F37\uFF01\\c\\n\u6240\u4EE5\uFF0C\u6211\u8981\u5617\u8A66\u5404\u7A2E\u65B9\u6CD5\uFF01\\n\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u966A\u6211\u8A66\u8A66\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
