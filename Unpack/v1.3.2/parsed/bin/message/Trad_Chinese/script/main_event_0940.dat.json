  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u6211\u7684\u52C1\u6575\u3002\\n\u548C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\uFF0C\u8AAA\u4E0D\u5B9A\u5C31\u80FD\u6709\u65B0\u767C\u73FE\u2026\u2026\\c\\n\u597D\u8036\uFF01\u65E2\u7136\u9019\u662F\u5C0D\u6230\uFF01\\n\u6211\u8981\u9F13\u8D77\u5E79\u52C1\u56C9\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u9019\u52C1\u6575\u7684\u5FC3\u60C5\u90FD\u76EA\u5230\u8C37\u5E95\u4E86\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u9084\u4E0D\u9858\u610F\u62C9\u6211\u4E00\u628A\u5440\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u50B7\u8166\u7B4B\u2026\u2026\\c\\n\u6211\u751A\u81F3\u66FF\u63DB\u4E86\u968A\u4F0D\u7684\u6210\u54E1\uFF0C\\n\u60F3\u8981\u627E\u51FA\u81EA\u5DF1\u7684\u53EF\u80FD\u6027\u2026\u2026\\c\\n\u4F46\u9084\u662F\u89BA\u5F97\u54EA\u88E1\u602A\u602A\u7684\u2026\u2026\\n\u6240\u4EE5\u6211\u624D\u6703\u9019\u9EBC\u5F31\u55CE\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5927\u54E5\u662F\u6211\u7684\u5076\u50CF\uFF01\\n\u4ED6\u771F\u7684\u662F\u500B\u8D85\u9177\u7684\u8A13\u7DF4\u5BB6\uFF01\\c\\n\u6211\u624D\u4E0D\u8981\u56E0\u70BA\u6211\u592A\u5F31\uFF0C\\n\u5BB3\u4ED6\u4E5F\u88AB\u5225\u4EBA\u770B\u6241\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u8981\u66F4\u3001\u66F4\u3001\u66F4\u52AA\u529B\uFF01\\n\u6211\u9084\u8981\u505A\u66F4\u591A\u7684\u5617\u8A66\uFF01\\c\\n\u6211\u8981\u627E\u51FA\u80FD\u5920\u8207\u6211\u4E00\u8D77\\n\u767C\u63EE\u529B\u91CF\u7684\u5BF6\u53EF\u5922\u5011\u2026\u2026\uFF01[VAR 0114(0005)]"
