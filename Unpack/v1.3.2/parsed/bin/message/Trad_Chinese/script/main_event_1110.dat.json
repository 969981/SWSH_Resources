[
  {
    "index": 0,
    "flags": 0,
    "text": "\u610F\u5916\u7684\u767C\u751F\uFF0C\\n\u7ADF\u7136\u8B93\u907A\u8DE1\u5167\u90E8\u91CD\u898B\u5929\u65E5\u4E86\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9019\u5EA7\u907A\u8DE1\u5448\u73FE\u7684\u662F\\n\u4EC0\u9EBC\u6A23\u7684\u4F3D\u52D2\u723E\u50B3\u8AAA\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u528D\u8207\u76FE\uFF1F"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6C92\u932F\uFF01\u90A3\uFF12\u5C0A\u5F88\u50CF\u662F\u5BF6\u53EF\u5922\u7684\u96D5\u50CF\\n\u6BD4\u82F1\u96C4\u90FD\u9084\u8981\u986F\u773C\uFF01\\c\\n\u800C\u4E14\u9084\u5E36\u8457\u528D\u8207\u76FE\u2026\u2026\\c\\n\u5C31\u50CF\u662F\u9019\uFF12\u96BB\u5BF6\u53EF\u5922\\n\u624D\u662F\u4F7F\u7528\u5B83\u5011\u7684\u4E3B\u4EBA\u4F3C\u7684\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u9084\u6709\u4EC0\u9EBC\u4EE4[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u610F\u7684\u5730\u65B9\u55CE\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u82F1\u96C4\u6709\u2026\u2026\u5169\u500B\u4EBA\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u548C\u58C1\u6BEF\u4E0A\u63CF\u7E6A\u7684\u4E00\u6A23\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6C92\u932F\uFF01\\n\u770B\u4F86\u662F\u6709\u5169\u500B\u82F1\u96C4\u3002\\c\\n\u4F46\u9019\u9EBC\u4E00\u4F86\uFF0C\u542B\u7F9E\u82DE\u65C5\u5E97\u7684\u82F1\u96C4\u96D5\u50CF\\n\u53C8\u70BA\u4EC0\u9EBC\u53EA\u6709\u4E00\u500B\u4EBA\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6BD4\u8D77\u82F1\u96C4\u96D5\u50CF\u6216\u53E4\u8001\u7684\u58C1\u6BEF\uFF0C\\n\u9019\u5EA7\u907A\u8DE1\u64C1\u6709\u66F4\u4E45\u9060\u7684\u6B77\u53F2\u3002\\r\\n\u5B83\u5448\u73FE\u7684\u61C9\u8A72\u662F\u66F4\u771F\u5BE6\u7684\u5167\u5BB9\u3002[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4E5F\u5C31\u662F\u8AAA\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u528D\u662F\u5BF6\u53EF\u5922\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u76FE\u4E5F\u662F\u5BF6\u53EF\u5922\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E00\u5B9A\u662F\u9019\u6A23\uFF01\\c\\n\u96A8\u8457\u6642\u5149\u6D41\u901D\uFF0C\u50B3\u8AAA\u4E2D\u63D0\u5230\u7684\u528D\u8207\u76FE\uFF0C\\n\u8207\u88AB\u7A31\u70BA\u528D\u8207\u76FE\u7684\u5BF6\u53EF\u5922\u2026\u2026\\c\\n\u6F38\u6F38\u88AB\u4EBA\u5011\u6DF7\u6DC6\u2026\u2026\\n\u7136\u5F8C\u5728\u6B77\u53F2\u4E2D\u92B7\u8072\u533F\u8DE1\u4E86\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5176\u5BE6\u82F1\u96C4\u662F\u5169\u500B\u5E74\u8F15\u4EBA\u3002\\c\\n\u528D\u8207\u76FE\u5206\u5225\u662F\u4E0D\u540C\u7684\u5BF6\u53EF\u5922\u3002\\c\\n\u4F46\u662F\uFF0C\u50B3\u627F\u771F\u76F8\u7684\u907A\u8DE1\\n\u537B\u88AB\u96B1\u85CF\u5728\u6EFF\u662F\u85DD\u8853\u6C23\u606F\u7684\u58C1\u756B\u4E0B\u3002\\r\\n\u9019\u7A76\u7ADF\u662F\u600E\u9EBC\u4E00\u56DE\u4E8B\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8B1D\u56C9\uFF01\u591A\u8667\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\n\u8AAA\u4E0D\u5B9A\u6211\u6709\u4E86\u5927\u767C\u73FE\u5462\uFF01\\c\\n\u4F86\uFF0C\u6211\u628A\u9019\u5206\u4E9B\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\\n\u63A5\u4E0B\u4F86\u7684\u9053\u9928\u6311\u6230\u5C31\u5728\u821E\u59FF\u93AE\u5427\uFF1F\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u8981\u597D\u597D\u52A0\u6CB9\u5594\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u7ADF\u7136\u6709\u6BB5\u6B77\u53F2\u88AB\u85CF\u5728\\n\u85DD\u8853\u5F97\u904E\u65BC\u8A87\u5F35\u7684\u58C1\u756B\u80CC\u5F8C\u2026\u2026\\r\\n\u6211\u5F97\u518D\u6DF1\u5165\u8ABF\u67E5\u624D\u884C\u3002[VAR 0114(000B)]"
  }
]
