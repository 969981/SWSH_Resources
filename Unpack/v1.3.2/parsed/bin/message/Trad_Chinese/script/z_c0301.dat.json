    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9B54\u7246\u9B54\u7246\uFF5E"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u770B\u4E39\u5E1D\u81C9\u4E0A\u7684\u7B11\u5BB9\u5C31\u77E5\u9053\uFF0C\\n\u4ED6\u6253\u5F9E\u5FC3\u5E95\u71B1\u611B\u5C0D\u6230\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u597D\u53B2\u5BB3\uFF01\\n\u80FD\u5728\u4E16\u754C\u821E\u53F0\u4E0A\u5F81\u6230\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6D1B\u8332\u5148\u751F\u4FDD\u7559\u4E86\u4EE5\u5F80\u7684\u57CE\u93AE\u98A8\u8C8C\uFF0C\\n\u4E26\u4E14\u7528\u4ED6\u516C\u53F8\u7684\u529B\u91CF\uFF0C\\r\\n\u628A\u9019\u500B\u5730\u65B9\u6539\u9020\u6210\u4E86\u89C0\u5149\u90FD\u5E02\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u8332\u5148\u751F\u64C1\u6709\u5E7E\u9593\u516C\u53F8\u4F86\u8457\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u9B54\u7246\u4EBA\u5076\u5C0F\u5091\\n\u771F\u662F\u8D85\u53B2\u5BB3\u7684\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6240\u8B02\u7684\u652F\u6301\u8005\uFF0C\u4E00\u5B9A\u662F\u5F88\u68D2\u7684\u4EBA\uFF5E\\n\u8981\u5C0D\u4ED6\u4EBA\u6295\u6CE8\u90A3\u9EBC\u591A\u7684\u71B1\u60C5\u53EF\u4E0D\u7C21\u55AE\u554A\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5982\u679C\u81EA\u5DF1\u652F\u6301\u7684\\n\u8A13\u7DF4\u5BB6\u541E\u4E86\u6557\u4ED7\uFF0C\\r\\n\u6703\u89BA\u5F97\u50CF\u81EA\u5DF1\u8F38\u4E86\u4E00\u6A23\u5145\u6EFF\u6094\u6068\u2026\u2026\\c\\n\u9019\u6B63\u662F\u6240\u8B02\u7684\u652F\u6301\u8005\u554A\u3002\\n\u660E\u660E\u548C\u81EA\u5DF1\u7121\u95DC\uFF0C\u4E5F\u9084\u662F\u611F\u540C\u8EAB\u53D7\u554A\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5982\u679C\u5F9E\u5C0F\u706B\u9F8D\u7684\u6642\u5019\u5C31\u958B\u59CB\u57F9\u80B2\uFF0C\\n\u76F8\u4FE1\u5F7C\u6B64\u4E4B\u9593\u6703\u5EFA\u7ACB\u8D77\u6DF1\u539A\u7684\u611F\u60C5\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6211\u8981\u5E36\u8457\u5674\u706B\u9F8D\uFF0C\\n\u53BB\u53C3\u52A0\u9053\u9928\u6311\u6230\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5582\uFF5E\u6211\u8CB7\u5230\u7AF6\u6280\u5834\u7684\u9580\u7968\u4E86\uFF01\\n\u5FEB\u4F86\u5FEB\u4F86\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u88AB\u5169\u500B\u5B69\u5B50\u800D\u5F97\u5718\u5718\u8F49\u7684\u6211\uFF0C\\n\u9084\u8981\u540C\u6642\u57F9\u80B2\uFF16\u96BB\u5BF6\u53EF\u5922\uFF0C\\r\\n\u6211\u60F3\u6211\u5927\u6982\u61C9\u4ED8\u4E0D\u4F86\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u8981\u4F86\u6A21\u4EFF\u5217\u9663\u5175\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u90A3\u6211\u4E5F\u8981\u6A21\u4EFF\u5217\u9663\u5175\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u554A\uFF0C\u6211\u5F9E\u4E39\u5E1D\u5831\u540D\u53C3\u52A0\\n\u9053\u9928\u6311\u6230\u7684\u90A3\u6642\u5019\u958B\u59CB\uFF0C\\r\\n\u5C31\u4E00\u76F4\u662F\u4ED6\u7684\u7C89\u7D72\u4E86\uFF01"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u300C\u6211\u559C\u6B61\u4F60\u5F88\u4E45\u4E86\uFF01\u300D\u6216\u662F\\n\u300C\u6211\u4E00\u76F4\u90FD\u5F88\u95DC\u6CE8\u4F60\uFF01\u300D\u9019\u4E00\u985E\u7684\u8A71\u554A\uFF0C\\r\\n\u5BE6\u5728\u8B49\u660E\u4E0D\u4E86\u662F\u771F\u7C89\u7D72\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u525B\u525B\u62FF\u5230\u4E86\u746A\u4FD0\u7684\u7C3D\u540D\u5594\uFF01\\n\u90A3\u5F35\u7C3D\u540D\u662F\u6211\u6700\u5FC3\u611B\u7684\u5BF6\u8C9D\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u90A3\u5EA7\u6469\u5929\u8F2A\u5F88\u5927\u5427\u3002\\n\u5B83\u53C8\u53EB\u505A\u4F3D\u52D2\u723E\u7684\u5730\u7344\u7FFB\u6EFE\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u6211\u59D0\u59D0\u8AAA\u7684\u8A71\u6C92\u534A\u53E5\u53EF\u4EE5\u4FE1\u5594\uFF5E"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6240\u8B02\u7684\u6A4B\u6881\uFF0C\u662F\u7528\u4F86\u5C07\\n\u5169\u500B\u5206\u958B\u7684\u6771\u897F\u9023\u63A5\u8D77\u4F86\u7684\uFF0C\\r\\n\u6240\u4EE5\u4E5F\u662F\u4E00\u7A2E\u53CB\u597D\u7684\u8C61\u5FB5\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u770B\u4E86\u7CBE\u5F69\u7684\u6BD4\u8CFD\uFF0C\\n\u5C31\u6703\u611F\u89BA\u8EAB\u9AD4\u88E1\u6E67\u51FA\u7121\u6BD4\u7684\u529B\u91CF\uFF01\\c\\n\u6211\u6253\u5F9E\u5FC3\u5E95\u5C0A\u656C\u53EF\u4EE5\u6253\u51FA\\n\u5982\u6B64\u9AD8\u6C34\u6E96\u6BD4\u8CFD\u7684\u8A13\u7DF4\u5BB6\uFF01"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u4E0D\u8AD6\u662F\u5728\u98EF\u5E97\u5DE5\u4F5C\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u9084\u662F\u5728\u6BD4\u8CFD\u4E2D\u6230\u9B25\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u770B\u8D77\u4F86\u90FD\u5F88\u5E25\u6C23\u4FD0\u843D\u5462\u2026\u2026"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "[~ 31]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u99AC\u54BF\uFF5E\uFF01"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6211\u5011\u8ACB\u5BF6\u53EF\u5922\u628A\u6211\u5011\\n\u9001\u5230\u98EF\u5E97\u4F86\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u771F\u4E0D\u6127\u662F\u91CD\u6CE5\u633D\u99AC\uFF0C\\n\u4E0D\u7BA1\u8F09\u5E7E\u500B\u4EBA\u90FD\u6C92\u554F\u984C\uFF01"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u5DE5\u4F5C\u53EF\u4EE5\u63DB\uFF0C\u623F\u5B50\u53EF\u4EE5\u63DB\uFF0C\\n\u5C31\u662F\u559C\u6B61\u7684\u9078\u624B\u548C\u5BF6\u53EF\u5922\u4E0D\u80FD\u63DB\u554A\u3002"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u5361\u8482\u72D7\uFF01\\n\u6211\u5011\u6BD4\u6BD4\u770B\u8AB0\u5148\u8DD1\u5230\u7AF6\u6280\u5834\u5427\uFF1F"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u5982\u679C\u662F\u5947\u5DF4\u7D0D\uFF0C\\n\u9996\u5148\u6703\u4F7F\u51FA\u6C99\u66B4\uFF01"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u8981\u5C0D\u4ED8\u53EF\u4EE5\u6539\u8B8A\u5929\u6C23\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u5C31\u8981\u6D3E\u901F\u5EA6\u5FEB\u7684\u5BF6\u53EF\u5922\uFF01"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u6C6A\u55DA\uFF01"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "[~ 40]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u8AAA\u771F\u7684\uFF5E\u6211\u7684\u5361\u8482\u72D7\\n\u7626\u4E86\u4E00\u5927\u5708\u554A\uFF01"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u5BAE\u9580\u5E02\u7684\u74B0\u57CE\u99AC\u62C9\u677E\\n\u53EF\u6703\u6D88\u8017\u4E0D\u5C11\u7684\u5361\u8DEF\u91CC\uFF5E"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u6211\u6703\u6253\u6383\u74B0\u5883\uFF0C\u90FD\u662F\u70BA\u4E86\\n\u611F\u53D7\u82B1\u6735\u771F\u6B63\u7684\u7F8E\u9E97\u3002"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u6211\u8981\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u53BB\u91CE\u9910\uFF01"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u53BB\u7A0B\u6642\u6211\u6EFF\u61F7\u671F\u5F85\uFF0C\u4E00\u908A\u904E\u6A4B\\n\u4E00\u908A\u60F3\u50CF\u6703\u662F\u5834\u4EC0\u9EBC\u6A23\u7684\u6BD4\u8CFD\u3002\\c\\n\u56DE\u7A0B\u6642\u6211\u5167\u5FC3\u6F8E\u6E43\uFF0C\u4E00\u908A\u904E\u6A4B\\n\u4E00\u908A\u56DE\u5473\u8457\u6BD4\u8CFD\u7684\u7CBE\u91C7\u77AC\u9593\u3002"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u6211\u5011\u7528\u8D70\u8DEF\u7684\\n\u5C31\u80FD\u5230\u7AF6\u6280\u5834\u53BB\u2026\u2026\\c\\n\u4F46\u9078\u624B\u5011\u662F\u4E00\u8DEF\\n\u904E\u95DC\u65AC\u5C07\u624D\u62B5\u9054\u7AF6\u6280\u5834\u7684\u3002"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u5BAE\u9580\u7AF6\u6280\u5834\u7A76\u7ADF\u662F\\n\u6211\u5BB6\u7684\u5E7E\u500D\u5927\u554A\uFF01\uFF1F"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u5728\u8D77\u5E8A\u4E4B\u524D\u4E0D\u6703\u77E5\u9053\u4ECA\u5929\u7684\u5929\u6C23\u5982\u4F55\uFF0C\\n\u5728\u6BD4\u8CFD\u7D50\u675F\u4E4B\u524D\u4E5F\u4E0D\u6703\u77E5\u9053\u52DD\u8CA0\u7684\u53BB\u5411\u3002"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u5168\u4E16\u754C\u7684\u4EBA\\n\u90FD\u6703\u89C0\u8CDE\u540C\u4E00\u5834\u6BD4\u8CFD\u3002\\c\\n\u4E5F\u5C31\u662F\u8AAA\u80FD\u548C\u4E16\u754C\u4E0A\u7684\\n\u4EFB\u4F55\u4EBA\u8A0E\u8AD6\u90A3\u5834\u6BD4\u8CFD\u3002"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u7CBE\u5F69\u7684\u7D93\u5178\u52DD\u8CA0\uFF0C\\n\u76F8\u4FE1\u6703\u6DF1\u523B\u5730\u7559\u5728\u4EBA\u5011\u7684\u8A18\u61B6\u4E2D\uFF01"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u95DC\u90FD\u7684\u4EBA\u548C\u4F3D\u52D2\u723E\u7684\u4EBA\\n\u90FD\u597D\u611B\u6392\u968A\u554A\u2026\u2026"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u8D70\u904E\u8DEF\u904E\u4E0D\u8981\u932F\u904E\uFF01\\n\u5B98\u65B9\u5468\u908A\u548C\u806F\u76DF\u5361\u901A\u901A\u6709\u5594\uFF01"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u6211\u5F88\u60F3\u8981\u7684\u7A00\u6709\u806F\u76DF\u5361\u2026\u2026\\n\u7ADF\u7136\u8CE3\u5149\u4E86\uFF01"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\u4ECA\u5929\u662F\u9069\u5408\\n\u6BD4\u8CFD\u7684\u7D55\u4F73\u5929\u6C23\uFF01\\c\\n\u96D6\u7136\u4E0D\u8AD6\u662F\u4EC0\u9EBC\u5929\u6C23\uFF0C\\n\u6211\u90FD\u6703\u9019\u9EBC\u8AAA\u2026\u2026\\r\\n\u800C\u4E14\u8A71\u8AAA\u56DE\u4F86\uFF0C\u7AF6\u6280\u5834\u6709\u5C4B\u9802\u554A\u3002"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u9019\u88E1\u6709\u5BF6\u53EF\u5922\u7684\u9EDE\u5FC3\uFF5E\\n\u9084\u6709\u5BF6\u53EF\u5922\u7684\u98F2\u6599\uFF5E\u4F86\u4E00\u4EFD\u5982\u4F55\u5462\uFF1F"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\u525B\u525B\u6211\u9084\u4E0D\u89BA\u5F97\u6E34\uFF0C\\n\u4F46\u770B\u5230\u679C\u6C41\u4E4B\u5F8C\u5C31\u7A81\u7136\u60F3\u559D\u4E86\u3002"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\u9078\u624B\u771F\u7684\u592A\u4E86\u4E0D\u8D77\u4E86\uFF5E\\c\\n\u4ED6\u5011\u5728\u6578\u842C\u4EBA\u7684\u7C89\u7D72\u9762\u524D\uFF0C\\n\u5373\u4F7F\u51FA\u4E86\u932F\u4E5F\u80FD\u4E0D\u53D7\u5F71\u97FF\u7E7C\u7E8C\u5C0D\u6230\u2026\u2026\\r\\n\u9019\u9700\u8981\u5F88\u5F37\u5927\u5805\u5B9A\u7684\u5FC3\u554A\uFF01"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\u5927\u4EBA\u5011\u8AAA\u8981\u7576\u500B\\n\u77E5\u8DB3\u5E38\u6A02\u7684\u4EBA\uFF5E"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\u5728\u9910\u5EF3\u8CB7\u7684\u98DF\u7269\\n\u7E3D\u662F\u8B93\u4EBA\u89BA\u5F97\u7279\u5225\u597D\u5403\u3002\\c\\n\u6211\u60F3\u90A3\u662F\u56E0\u70BA\u88E1\u982D\u52A0\u4E86\u53EB\u505A\\n\u300C\u65B0\u9BAE\u611F\u300D\u7684\u7279\u5225\u9999\u6599\u3002"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\u5C31\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u898B\u8B58\u4E00\u4E0B\\n\u5436\u558A\u968A\u7684\u96C6\u5927\u6210\u4E4B\u4F5C\uFF01"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\u6211\u5011\u4E5F\u60F3\u770B\u6BD4\u8CFD\uFF0C\\n\u6240\u4EE5\u624D\u4E0D\u6703\u4F86\u6417\u4E82\uFF01"
  },
  {
    "index": 62,
