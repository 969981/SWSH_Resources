  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5750\u4E0B\u4E4B\u5F8C\u53EF\u4EE5\u7AD9\u8D77\u4F86\u3002\\n\u73FE\u5728\u8F38\u4E86\uFF0C\u6709\u4E00\u5929\u4E5F\u80FD\u91CD\u65B0\u632F\u4F5C\u8D77\u4F86\u3002"
