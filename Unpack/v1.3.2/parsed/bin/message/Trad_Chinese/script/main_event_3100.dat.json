    "text": "\u4F60\u5011\u4F86\u5F97\u6B63\u597D\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9053\u9928\u7AF6\u6280\u5834\u5FEB\u8981\u6490\u4E0D\u4F4F\u4E86\uFF01\\c\\n\u6709\u597D\u591A\u96BB\u6975\u5DE8\u5316\u7684\u5BF6\u53EF\u5922\\n\u6B63\u5728\u5927\u9B27\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u662F\u6709\u4EBA\u6B63\u5728\u60E1\u7528\u8A31\u9858\u661F\u7684\u529B\u91CF\u3002[VAR 0114(0016)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u539F\u4F86\u5982\u6B64\u2026\u2026\\n\u90A3\u771F\u662F\u500B\u5927\u554F\u984C\u3002\\c\\n\u4E0D\u904E\uFF0C\u5C0D\u4ED8\u773C\u524D\u7684\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\\n\u624D\u662F\u7576\u52D9\u4E4B\u6025\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8A71\u8AAA\u56DE\u4F86\uFF0C\u65E2\u7136\u6709\u4F60\u5011\u4F86\u52A9\u9663\u4E86\uFF0C\\n\u5BF6\u53EF\u5922\u5C31\u5DF2\u7D93\u4E0D\u662F\u554F\u984C\u56C9\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u5011\u5C31\u662F\u70BA\u6B64\u800C\u4F86\u7684\uFF01\\n\u662F\u5427\uFF1F[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
