    "text": "\u4EA4\u7D66\u6211\u5011\u5427"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u5011\u6703\u89E3\u6C7A\u7684"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5C24\u5176\u662F\u8076\u6893\uFF01\\n\u90A3\u5834\u5728\u6C7A\u8CFD\u548C\u4F60\u7684\u5C0D\u6230\u2026\u2026\\c\\n\u771F\u662F\u6709\u4F60\u7684\uFF01\u6211\u7684\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\\n\u90FD\u5DEE\u9EDE\u8981\u675F\u624B\u7121\u7B56\u4E86\u5462\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u5011\u9019\u6B21\u662F\u7AD9\u5728\u540C\u4E00\u9663\u7DDA\u56C9\u3002\\n\u90A3\u9EBC\u5927\u5BB6\u5206\u982D\u61C9\u6230\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u592A\u8B9A\u4E86\uFF01\u6211\u5011\u9019\u5925\u4EBA\u2026\u2026\\n\u7C21\u76F4\u5C31\u662F\u6700\u5F37\u7684\u5718\u968A\u561B\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 11,
    "flags": 0,
