  {
    "index": 61,
    "flags": 0,
    "text": "\u554A\uFF0C[VAR 0100(0000)]\uFF01\\n\u6C92\u4E8B\u5566\uFF0C\u662F\u8001\u982D\u5152\u6211\u5728\u81EA\u8A00\u81EA\u8A9E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\u96D9\u62F3\u5854\u7684\u523A\u5BA2\u5011\\n\u90FD\u662F\u6211\u5011\u7684\u5927\u524D\u8F29\u5566\uFF01\\c\\n\u807D\u8AAA\u4ED6\u5011\u4E00\u65E6\u53D7\u5230\u5FB5\u53EC\uFF0C\\n\u5C31\u6703\u4E00\u76F4\u5F85\u5728\u5854\u88E1\u7B49\u4EBA\u5537\uFF01"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\u6700\u8FD1\u7684\u514B\u62C9\u62C9\\n\u7E3D\u662F\u5F88\u8A8D\u771F\u5728\u935B\u934A\u8036\uFF01\\r\\n\u5979\u662F\u4E0D\u662F\u5403\u4E86\u4EC0\u9EBC\u5947\u602A\u7684\u6771\u897F\u5440\uFF1F"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\u6700\u8FD1\u7684\u8CFD\u5BF6\u5229\\n\u7E3D\u662F\u5F88\u8A8D\u771F\u5728\u935B\u934A\u8036\uFF01\\r\\n\u4ED6\u662F\u4E0D\u662F\u5403\u4E86\u4EC0\u9EBC\u5947\u602A\u7684\u6771\u897F\u5440\uFF1F"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\u807D\u8AAA\u51A0\u8ECD\u4E39\u5E1D\u4EE5\u524D\u66FE\u5728\\n\u524D\u5F80\u96D9\u62F3\u5854\u7684\u8DEF\u4E0A\u8FF7\u4E86\u8DEF\uFF0C\\c\\n\u7136\u5F8C\u4E0D\u77E5\u4E0D\u89BA\u5C31\u56DE\u5230\u4E86\u5316\u6717\u93AE\u5462\uFF01"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\u662F\u8981\u8B93\u718A\u5F92\u5F1F\u9032\u5316\u6210\u6C34\u5C6C\u6027\u5462\uFF1F\\n\u9084\u662F\u60E1\u5C6C\u6027\u5462\uFF1F\\r\\n\u7DAD\u6301\u718A\u5F92\u5F1F\u7684\u6A23\u5B50\u4E5F\u5F88\u53EF\u611B\u2026\u2026\\r\\n\u8981\u662F\u6211\u7684\u8A71\uFF0C\u6703\u600E\u9EBC\u8FA6\u5462\uFF1F"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\u6C34\u4E4B\u5854\u7684\u9644\u8FD1\u662F\\n\u98A8\u666F\u7F8E\u5F97\u5192\u6CE1\u7684\u6F02\u4EAE\u666F\u9EDE\uFF01\\c\\n\u64DA\u8AAA\u5E2B\u5085\u548C\u5E2B\u6BCD\\n\u5E38\u5E38\u6703\u53BB\u90A3\u908A\u6563\u6B65\u7D04\u6703\u5537\uFF01"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\u54EA\u88E1\u53EF\u4EE5\u627E\u5230\\n\u767C\u5927\u8CA1\u7684\u597D\u6A5F\u6703\u54A7\uFF5E\uFF1F"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\u7B49\u6211\u8B8A\u5F37\u4E86\u4EE5\u5F8C\uFF0C\\n\u6211\u4E5F\u8981\u53C3\u52A0\u4E0B\u4E00\u5C46\u7684\u9053\u9928\u6311\u6230\uFF01"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\u6709\u6642\u5019\u6211\u6703\u89BA\u5F97\u5BC2\u5BDE\uFF0C\\n\u7136\u5F8C\u597D\u60F3\u56DE\u5BB6\u3002\\c\\n\u53EF\u662F\u53EA\u8981\u5E2B\u6BCD\u7DCA\u7DCA\u62B1\u6211\u4E00\u4E0B\uFF0C\\n\u6211\u5C31\u6703\u89BA\u5F97\u5B89\u5FC3\u4E86\u5594\u3002"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\u5475\u5475\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u9023\u96D9\u62F3\u5854\u90FD\u7A31\u9738\u4E86\uFF0C\\n\u679C\u7136\u4E0D\u5BB9\u5C0F\u89B7\u554A\u3002\\c\\n\u96D6\u7136\u6211\u81EA\u5DF1\u662F\u6C92\u6709\u4E0A\u53BB\u904E\uFF0C\\n\u4E0D\u904E\u60F3\u5FC5\u5F88\u9A5A\u4EBA\u5427\u2026\u2026"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\u6211\u539F\u672C\u662F\u6253\u7B97\\n\u4FEE\u884C\u7D50\u675F\u5F8C\u5C31\u8981\u51FA\u767C\u7684\u2026\u2026\\c\\n\u7D50\u679C\u4E00\u4E0D\u5C0F\u5FC3\u5C31\u5F85\u4E45\u4E86\u3002\\n\u8AB0\u53EB\u99AC\u5E2B\u5085\u6B66\u9928\u592A\u8212\u670D\u4E86\u561B\u3002"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\u65E2\u7136\u60F3\u8981\u8B8A\u5F97\u6BD4\u5225\u4EBA\u66F4\u5F37\uFF0C\\n\u5C31\u8981\u4ED8\u51FA\u6BD4\u5225\u4EBA\u66F4\u591A\u7684\u52AA\u529B\u56C9\uFF5E\\r\\n\u2026\u2026\u4E0D\u904E\u9019\u771F\u662F\u8F9B\u82E6\u5230\u7206\u54EA\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\u539F\u4F86\uFF0C\u7121\u6CD5\u6230\u52DD\u81EA\u5DF1\u7684\u4EBA\uFF0C\\n\u662F\u4E0D\u53EF\u80FD\u8D0F\u904E\u5225\u4EBA\u7684\u554A\u3002\\r\\n\u2026\u2026\u7406\u8AD6\u4E0A\u6211\u90FD\u660E\u767D\u3002[VAR 0114(0072)]"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\u55EF\uFF1F\u65E2\u7136[VAR 1100(00FF,0101)]\u4F60\u59B3\u8B93\u7260\u651C\u5E36\u4E86\u4E0D\u8B8A\u4E4B\u77F3\uFF0C\\n\u9019\u5C31\u8868\u793A\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\u5982\u679C\u718A\u5F92\u5F1F\u651C\u5E36\u8457\u4E0D\u8B8A\u4E4B\u77F3\uFF0C\\n\u5C31\u4E0D\u80FD\u7D66\u7260\u770B\u639B\u8EF8\uFF01"
  }
