[
  {
    "index": 0,
    "flags": 0,
    "text": "\u563F\u5537\u563F\uFF01\\c\\n\u672C\u5927\u723A\u8981\u904E\u9019\u5EA7\u9577\u9577\u7684\u6A4B\uFF0C\\n\u4F60\u5FEB\u628A\u81EA\u884C\u8ECA\u4EA4\u51FA\u4F86\u5436\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u8981\u7528\u6436\u4F86\u7684\u81EA\u884C\u8ECA\\n\u59A8\u7919\u90A3\uFF5E\u4E9B\u9053\u9928\u6311\u6230\u8005\uFF0C\\r\\n\u8B93\u4ED6\u5011\u88AB\u81EA\u884C\u8ECA\u8FFD\u5F97\u56DB\u8655\u8DD1\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u90A3\u662F\u4EC0\u9EBC\u6B6A\u908F\u8F2F\uFF01\uFF1F\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\\n\u4F60\u5011\u9023\u96BB\u6D1B\u6258\u59C6\u4E5F\u6C92\u6709\u554A\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9019\u4F4D\u8DEF\u904E\u7684\u9053\u9928\u6311\u6230\u8005\uFF01\\n\u4ED6\u5011\u8981\u6436\u6211\u7684\u81EA\u884C\u8ECA\uFF01\\c\\n\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u5012\u4ED6\u5011\u3002\\n\u5C31\u7576\u4F5C\u662F\u5E6B\u6211\u500B\u5FD9\u554A\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u5011\u624D\u4E0D\u662F\u8981\u6436\u5436\uFF01\\c\\n\u53EA\u4E0D\u904E\u662F\u8981\u501F\u8F1B\u81EA\u884C\u8ECA\\n\u4F86\u8FFD\u8FFD\u90A3\uFF5E\u4E9B\u6311\u6230\u8005\uFF0C\\r\\n\u597D\u8B93\u4ED6\u5011\u7CBE\u75B2\u529B\u76E1\u7F77\u5566\uFF01\\c\\n\u4E0D\u904E\uFF0C\u6211\u5C31\u5148\u5728\u5BF6\u53EF\u5922\u5C0D\u6230\u4E2D\\n\u628A[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u5F97\u7D2F\u8DB4\u8DB4\uFF0C\u59A8\u7919[VAR 1100(00FF,0101)]\u4F60\u59B3\u524D\u9032\u5427\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u55DA\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u59A8\u7919\u4E86\u6211\u59A8\u7919[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002[VAR 0114(006F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u53EF\u60E1\uFF5E\uFF01\u6211\u5C31\u662F\u60F3\u8981\u4E00\u8F1B\u81EA\u884C\u8ECA\u5436\uFF01\\n\u4E0D\u8981\u59A8\u7919\u6211\uFF5E\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8981\u662F\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u7A2E\u592A\u5F37\u7684\u9053\u9928\u6311\u6230\u8005\uFF0C\\n\u6211\u5011\u652F\u6301\u7684\u90A3\uFF5E\u4F4D\u5C31\u7121\u6CD5\u52DD\u51FA\u4E86\uFF01\\c\\n\u6211\u5011\u4E00\u5B9A\u8981\\n\u66F4\u3001\u66F4\u3001\u66F4\uFF5E\u7528\u529B\u59A8\u7919[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u592A\u512A\u79C0\u4E86\uFF01\\c\\n\u65E2\u7136[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u5BF6\u53EF\u5922\u5716\u9451\uFF0C\\n\u5C31\u8868\u793A[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u6709\u6D1B\u6258\u59C6\u56C9\uFF1F\\c\\n\u592A\u597D\u4E86\uFF01\u8207\u5176\u88AB\u5436\u558A\u968A\u6436\u8D70\uFF0C\\n\u6211\u4E0D\u5982\u73FE\u5728\u5C31\u628A\u9019\u81EA\u884C\u8ECA\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u807D\u597D\u56C9\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u77E5\u9053\uFF0C\\n\u6D1B\u6258\u59C6\u975E\u5E38\u975E\u5E38\u559C\u611B\u99AC\u9054\u5427\u3002\\c\\n\u7260\u5C0D\u99AC\u9054\u662F\u611B\u5F97\u4E0D\u53EF\u81EA\u62D4\uFF0C\\n\u751A\u81F3\u9858\u610F\u9032\u5230\u6709\u99AC\u9054\u7684\u6A5F\u68B0\u88E1\u9762\u3002\\c\\n\u6240\u4EE5\u6211\u9748\u6A5F\u4E00\u52D5\uFF01\\n\u60F3\u5230\u5982\u679C\u628A\u99AC\u9054\u88DD\u5728\u81EA\u884C\u8ECA\u4E0A\uFF0C\\r\\n\u4E5F\u8A31\u6D1B\u6258\u59C6\u6703\u9858\u610F\u9032\u5230\u90A3\u88E1\u9762\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u54E6\u2026\u2026"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u539F\u4F86\u5982\u6B64\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8A66\u8A66\u770B\u5C31\u77E5\u9053\u4E86\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u4F86\u4EAB\u53D7\\n\u548C\u6D1B\u6258\u59C6\u9A0E\u81EA\u884C\u8ECA\u515C\u98A8\u7684\u6A02\u8DA3\u5427\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F86\u4F86\u4F86\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u4F86\u548C\u6D1B\u6258\u59C6\\n\u4E00\u8D77\u9A0E\u81EA\u884C\u8ECA\u5427\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u8981\u5538\u8AAA\u660E\u66F8\u56C9\u3002\\c\\n\u300C\u6309\u4E0B\uFF0B\u9375\u6216\uFF0D\u9375\uFF0C\\n\u5373\u53EF\u548C\u6D1B\u6258\u59C6\u9A0E\u81EA\u884C\u8ECA\u3002\u300D\\r\\n\u4F86\uFF0C\u9A0E\u4E0A\u8ECA\uFF0C\u8FCE\u98A8\u5954\u99B3\u5427\uFF01"
  }
