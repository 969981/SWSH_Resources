    "text": "\u6B61\u8FCE\u4F86\u5230\u96E2\u5730\uFF13\uFF10\uFF10\u516C\u5C3A\u9AD8\u7684\\n\u6D1B\u8332\u6703\u9577\u79C1\u4EBA\u7A7A\u9593\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u5011\u8F15\u8F15\u9B06\u9B06\u5730\u6253\u6557\u4E86\\n\u6A13\u4E0B\u90A3\u4E9B\u807D\u547D\u65BC\u6211\u7684\u7279\u5225\u8077\u54E1\uFF0C\\r\\n\u5C31\u9019\u6A23\u95D6\u5230\u9019\u88E1\u4F86\u3002\\c\\n\u51A0\u8ECD\u4E39\u5E1D\u63A8\u85A6\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\\n\u679C\u771F\u662F\u4E0D\u5BB9\u5C0F\u89B7\u5462\u3002[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u4E5F\u5C31\u5230\u6B64\u70BA\u6B62\u4E86\u3002\\n\u6211\u8981\u8ACB\u4F60\u5011\u6253\u9053\u56DE\u5E9C\uFF01[VAR 0114(0007)]"
