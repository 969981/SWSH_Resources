[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9060\u8655\u53EF\u4EE5\u770B\u5230\u7684\\n\u7D2B\u8272\u5C4B\u9802\u623F\u5C4B\uFF0C\\r\\n\u90A3\u5C31\u662F\u5BF6\u53EF\u5922\u535A\u58EB\u7684\u5BB6\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u5403\u98EF\uFF0C\\n\u6703\u66F4\u52A0\u53EF\u53E3\u7F8E\u5473\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u807D\u8AAA\u4E39\u5E1D\u6709\u500B\u5F1F\u5F1F\u2026\u2026\\c\\n\u76F8\u4FE1\u4ED6\u5F1F\u5F1F\u4E00\u5B9A\u50CF\u4ED6\u4E00\u6A23\uFF0C\\n\u4E5F\u662F\u500B\u512A\u79C0\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9019\u88E1\u662F\u500B\u5BE7\u975C\u7684\u9109\u6751\u5C0F\u93AE\uFF0C\\n\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u53BB\u57CE\u88E1\u770B\u770B\uFF0C\u4FDD\u8B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6703\u5687\u4E00\u8DF3\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8B93\u5BF6\u53EF\u5922\u53BB\u6230\u9B25\uFF0C\u7260\u5011\u6703\u8D8A\u4F86\u8D8A\u5F37\u3002\\c\\n\u4F46\u6703\u57F9\u80B2\u6210\u4EC0\u9EBC\u6A23\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u5C31\u7AEF\u770B\u8A13\u7DF4\u5BB6\u7684\u624B\u8155\u4E86\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7121\u6575\u7684\u51A0\u8ECD\u4E39\u5E1D\\n\u662F\u5927\u5BB6\u7684\u8D85\u7D1A\u5DE8\u661F\u554A\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u770B\u6211\u7684\u5674\u706B\u9F8D\u59FF\u52E2\uFF01\\c\\n\u7E3D\u89BA\u5F97\u5149\u53EA\u662F\u4E00\u8D77\u64FA\u59FF\u52E2\uFF0C\\n\u81EA\u5DF1\u5C31\u8B8A\u5F97\u66F4\u5F37\u4E86\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6BCF\u5929\u65E9\u4E0A\u5BF6\u53EF\u5922\u53EB\u6211\u8D77\u5E8A\uFF0C\\n\u6BCF\u5929\u665A\u4E0A\u6211\u54C4\u5BF6\u53EF\u5922\u5165\u7761\u2026\u2026\\c\\n\u6211\u6839\u672C\u7121\u6CD5\u60F3\u50CF\u6C92\u6709\\n\u5BF6\u53EF\u5922\u7684\u751F\u6D3B\u6703\u662F\u4EC0\u9EBC\u6A23\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u7D42\u65BC\u60F3\u8D77\u4F86\uFF0C\\n\u539F\u672C\u5728\u9019\u88E1\u7684\u770B\u677F\u5BEB\u4E86\u4E9B\u4EC0\u9EBC\u4E86\u3002\\c\\n\u90A3\u4E0A\u9762\u5BEB\u8457\u53F3\u908A\u662F\u5BF6\u53EF\u5922\u7814\u7A76\u6240\uFF0C\\n\u53E6\u4E00\u908A\u662F\u8ECA\u7AD9\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u4E5F\u66FE\u7D93\u601D\u8003\u904E\u8981\u4E0D\u8981\u5F80\\n\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u7684\u65B9\u5411\u767C\u5C55\u3002\\c\\n\u4F46\u6211\u6C92\u8FA6\u6CD5\u50CF\u4E39\u5E1D\u4E00\u6A23\uFF0C\\n\u96A8\u6642\u96A8\u5730\u5FC3\u90FD\u639B\u5728\u5BF6\u53EF\u5922\u8EAB\u4E0A\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u8981\u53BB\u6642\u88DD\u5E97\u8CB7\u6771\u897F\uFF01\\n\u53EA\u8981\u63DB\u9802\u5E3D\u5B50\uFF0C\u5FC3\u60C5\u4E5F\u6703\u7165\u7136\u4E00\u65B0\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u4F4D\u5BF6\u53EF\u5922\u535A\u58EB\u554A\uFF5E\\n\u5979\u5E73\u6642\u90FD\u5F85\u5728\u6E56\u7554\u7684\u5C4B\u5B50\u88E1\uFF0C\\r\\n\u60A0\u9592\u5730\u904E\u8457\u65E5\u5B50\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\\n\u57FA\u672C\u5E38\u8B58\u4E4B\uFF11\uFF01\\c\\n\u5C0D\u6230\u6642\u6700\u5148\u4E0A\u5834\u7684\u662F\uFF0C\\n\u540C\u884C\u968A\u4F0D\u4E2D\u6392\u5728\u6700\u524D\u9762\u7684\u5BF6\u53EF\u5922\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u8FF7\u8DEF\u4E86\uFF0C\\n\u5225\u5FD8\u4E86\u770B\u770B\u57CE\u93AE\u5730\u5716\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u5728\u8ECA\u7AD9\u770B\u5230\u51A0\u8ECD\u4E86\uFF01\\c\\n\u5C31\u7B97\u96E2\u5F97\u9060\u9060\u7684\u6211\u4E5F\u80FD\\n\u611F\u53D7\u5230\u4ED6\u7684\u5F37\u5927\u6C23\u5834\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[~ 15]"
