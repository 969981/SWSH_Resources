[
  {
    "index": 0,
    "flags": 0,
    "text": "\u55E8\uFF01\u5E74\u8F15\u4EBA\uFF0C\\n\u770B\u6A23\u5B50\u4F60\u5011\u9806\u5229\u5B8C\u6210\u5831\u5230\u4E86\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9E\uFF1F\\n\u59B3\u600E\u9EBC\u6703\u5728\u98EF\u5E97\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u5728\u8ABF\u67E5\u64DA\u8AAA\u662F\u68F2\u606F\u5728\\n\u5FAE\u5BD0\u68EE\u6797\u88E1\u7684\u795E\u79D8\u5BF6\u53EF\u5922\u3002\\c\\n\u6211\u60F3\uFF0C\u8AAA\u4E0D\u5B9A\u7DDA\u7D22\u5C31\u5728\\n\u4F3D\u52D2\u723E\u5730\u5340\u7684\u50B3\u8AAA\u88E1\u3002\\c\\n\u4F60\u5011\u4F86\u5F97\u6B63\u5DE7\uFF0C\u8981\u4E0D\u8981\u4E00\u8D77\u770B\u770B\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9019\u662F\u4EC0\u9EBC\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9019\u5C31\u662F\u50B3\u8AAA\u4E2D\u90A3\u4F4D\\n\u62EF\u6551\u4E86\u4F3D\u52D2\u723E\u5730\u5340\u7684\u82F1\u96C4\u3002\\r\\n\u597D\u5947\u7684\u8A71\uFF0C\u6211\u53EF\u4EE5\u8AAA\u660E\u7D66\u4F60\u5011\u807D\u3002[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7C21\u77ED\u544A\u8A34\u6211\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8AAA\u8A73\u7D30\u4E00\u9EDE"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5F88\u4E45\u4EE5\u524D\u2026\u2026\u4F3D\u52D2\u723E\u5730\u5340\u7684\u4E0A\u7A7A\\n\u51FA\u73FE\u4E86\u9ED1\u8272\u7684\u6F29\u6E26\u2026\u2026\\r\\n\u4EBA\u7A31\u4E4B\u70BA\u95C7\u591C\u3002\\c\\n\u5404\u5730\u66F4\u662F\u6709\u5DE8\u5927\u7684\u5BF6\u53EF\u5922\u5927\u9B27\uFF0C\\n\u4EE4\u4EBA\u5011\u9677\u5165\u6050\u614C\u3002\\c\\n\u90A3\u6642\uFF0C\u6709\u500B\u624B\u6301\u528D\u8207\u76FE\u7684\u5E74\u8F15\u4EBA\uFF0C\\n\u5E73\u606F\u4E86\u9019\u5834\u707D\u96E3\u2026\u2026\\c\\n\u9019\u5C0A\u96D5\u50CF\u5C31\u662F\u4EE5\u90A3\u500B\u50B3\u8AAA\u4E2D\u7684\u5E74\u8F15\u4EBA\uFF0C\\n\u4E5F\u5C31\u662F\u82F1\u96C4\u70BA\u539F\u578B\u6240\u9020\u7684\u5594\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u82F1\u96C4\u624B\u6301\u7684\\n\u7A76\u7ADF\u662F\u4EC0\u9EBC\u6A23\u7684\u528D\u548C\u76FE\uFF0C\\r\\n\u5728\u4ECA\u5929\u5DF2\u7D93\u6C92\u6709\u8CC7\u6599\u53EF\u8003\u4E86\u3002\\c\\n\u66F4\u4E0D\u7528\u8AAA\uFF0C\u9ED1\u8272\u6F29\u6E26\u5230\u5E95\u662F\u4EC0\u9EBC\uFF0C\\n\u81F3\u4ECA\u4E5F\u4ECD\u662F\u500B\u8B0E\u2026\u2026\\c\\n\u4F46\u56E0\u70BA\u5B83\u7C60\u7F69\u4E86\u4F3D\u52D2\u723E\u7684\u5929\u7A7A\uFF0C\\n\u6240\u4EE5\u4E5F\u88AB\u7A31\u70BA\u95C7\u591C\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u9019\u6A23\u554A\u2026\u2026\\n\u539F\u4F86\u82F1\u96C4\u5C31\u50CF\u5927\u54E5\u90A3\u6A23\u5F37\uFF01\\c\\n\u4F46\u662F\uFF0C\u53C8\u662F\u9ED1\u8272\u6F29\u6E26\uFF0C\\n\u53C8\u662F\u528D\u548C\u76FE\u7684\u2026\u2026\\r\\n\u7ADF\u7136\u6709\u9019\u9EBC\u591A\u8981\u8ABF\u67E5\u7684\u4E8B\u60C5\uFF0C\\r\\n\u7D22\u59AE\u4E9E\u59B3\u771F\u662F\u6709\u5F97\u5FD9\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u59B3\u53EF\u4EE5\u7684\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u59B3\u53EF\u4EE5\u55CE\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8B1D\u8B1D\uFF01\\n\u6211\u60F3\uFF0C\u7E3D\u6703\u6709\u8FA6\u6CD5\u7684\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u55EF\uFF0C\u7E3D\u8981\u60F3\u51FA\u500B\u8FA6\u6CD5\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4F60\u5011\u5982\u679C\u8981\u4F4F\u5728\u9019\u88E1\uFF0C\\n\u90A3\u5C31\u5148\u53BB\u8FA6\u5165\u4F4F\u5427\uFF1F\\c\\n\u96D6\u7136\u6AC3\u53F0\u90A3\u908A\u4F3C\u4E4E\u6709\u9EDE\u5435\u9B27\u3002[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\uFF01\u8981\u662F\u6709\u4EC0\u9EBC\u65B0\u767C\u73FE\uFF0C\\n\u6211\u5011\u4E5F\u6703\u544A\u8A34\u59B3\u7684\u3002[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u53EA\u8981\u5411\u6AC3\u53F0\u88E1\u7684\u4EBA\u8AAA\u4E00\u8072\uFF0C\\n\u4ED6\u5C31\u6703\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u8FA6\u5165\u4F4F\u624B\u7E8C\u56C9\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u8D6B\u666E\u5C31\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\u3002\\c\\n\u4E39\u5E1D\u4ED6\u662F\u5144\u4EE3\u7236\u8077\uFF0C\\n\u7E3D\u662F\u639B\u5FC3\u8457\u9019\u500B\u5F1F\u5F1F\u5462\u3002[VAR 0114(000B)]"
  }
]
