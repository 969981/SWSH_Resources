[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9019\u51F9\u51F9\u51F8\u51F8\u7684\u6A23\u5B50\u771F\u8FF7\u4EBA\u3002\\n\u5927\u70AD\u8ECA\u4F60\u4ECA\u5929\u5FC3\u60C5\u5F88\u597D\u5436\uFF5E[VAR 0114(0043)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5514\uFF1F"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u6B63\u548C\u5FC3\u611B\u7684\u5927\u70AD\u8ECA\u73A9\u5F97\u8D77\u52C1\u5436\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u95D6\u5165\u4E86\u6211\u5011\u7684\u4E16\u754C\uFF01\\n\u4E0D\u7BA1\u600E\u6A23\uFF0C\u6211\u90FD\u8981\u628A[VAR 1100(00FF,0101)]\u4F60\u59B3\u8D95\u51FA\u53BB\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u66FE\u662F\u7B2C\u4E8C\u7926\u5C71\u6700\u5F37\u7684\u8A13\u7DF4\u5BB6\u2026\u2026\\n\u73FE\u5728\uFF0C\u6C92\u6709\u6211\u7684\u5BB9\u8EAB\u4E4B\u5730\u4E86\u2026\u2026\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u5E79\u561B\uFF01\\n\u96E3\u5F97\u6211\u60F3\u5230\u4E86\u4E00\u500B\u597D\u4E3B\u610F\uFF0C\\r\\n\u65E2\u53EF\u4EE5\u75BC\u611B\u5927\u70AD\u8ECA\uFF0C\u53C8\u53EF\u4EE5\u64CB\u8DEF\u5436\uFF01[VAR 0114(0044)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u64A4\u9000\u5436\uFF01\\n\u7559\u4E0B\u5BF6\u53EF\u5922\uFF0C\u6E9C\u4E4B\u5927\u5409\u5566\uFF01[VAR 0114(005E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u771F\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u90A3\u4E9B\u50A2\u4F19\u2026\u2026\\c\\n\u56E0\u70BA\u4ED6\u5011\u5728\u8DDF\u5927\u70AD\u8ECA\u73A9\uFF0C\\n\u6240\u4EE5\u624D\u5728\u9019\u88E1\u64CB\u8DEF\u55CE\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u54FC\uFF01\\c\\n\u9047\u4E0A\u4E86\u7121\u804A\u7684\u5C0F\u560D\u56C9\uFF0C\\n\u5C31\u4EA4\u7D66\u6C92\u5BE6\u529B\u7684\u8A13\u7DF4\u5BB6\u61C9\u4ED8\u3002\\r\\n\u770B\u4F86\u9019\u662F\u500B\u660E\u667A\u7684\u5224\u65B7\u3002[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8F9B\u82E6\u4F60\u4E86\uFF0C\u5927\u70AD\u8ECA\u3002\\n\u4F60\u6B63\u5728\u5BF6\u53EF\u5E6B\u5E6B\u5FD9\u55CE\uFF1F\\c\\n\u4F86\uFF0C\u628A\u5CA9\u77F3\u64CA\u788E\uFF0C\\n\u56DE\u5230\u4F60\u7684\u8A13\u7DF4\u5BB6\u8EAB\u908A\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5514\u5594\uFF5E\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7260\u7ADF\u7136\u5E6B\u5FD9\u958B\u8DEF\u4E86\u2026\u2026\\n\u5BF6\u53EF\u5922\u90FD\u6BD4\u4F60\u5011\u6709\u7528\u5462\u3002\\c\\n\u4E0D\u904E\uFF0C\u597D\u6B79\u4F60\u5011\u4E5F\u89E3\u6C7A\u4E86\u5436\u558A\u968A\u3002\\n\u9019\u5C31\u9001\u4F60\u5011\u7576\u734E\u8CDE\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4ED6\u5728\u8DE9\u4EC0\u9EBC\u554A\u2026\u2026\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u525B\u624D\u7684\u5927\u70AD\u8ECA\u2026\u2026\\n\u4E0D\u77E5\u9053\u6709\u6C92\u6709\u627E\u5230\u7260\u7684\u8A13\u7DF4\u5BB6\u3002[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u627E\u4E86\u9019\u9EBC\u4E45\u2026\u2026\\n\u5361\u856A\u7A76\u7ADF\u5728\u54EA\u88E1\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5436\u558A\u968A\uFF01\u611F\u8B1D\u4F60\u5011\u966A\u6211\u935B\u934A\uFF01\\n\u4E0D\u904E\u2026\u2026\\c\\n\u963B\u64FE\u6B63\u5728\u5DE5\u4F5C\u7684\u5927\u70AD\u8ECA\uFF0C\\n\u9019\u662F\u842C\u842C\u4E0D\u53EF\u7684\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4E0D\u4E0D\u4E0D\uFF0C\u6211\u5011\u6C92\u6709\u963B\u64FE\u7260\u5436\uFF01\\n\u6211\u5011\u53EA\u662F\u5728\u5E6B\u5927\u70AD\u8ECA\u5436\u558A\u6253\u6C23\u2026\u2026[VAR 0114(0043)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4F46\u662F\uFF0C\u65E2\u7136\u5728\u5BF6\u53EF\u5922\u5C0D\u6230\u88E1\\n\u8F38\u5F97\u4E03\u96F6\u516B\u843D\uFF0C\\r\\n\u90A3\uFF5E\u6211\u5011\u5436\u558A\u968A\u9084\u662F\u5FEB\u5FEB\u9000\u5834\u5504\u2026\u2026[VAR 0114(0044)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5514\u5594\uFF5E\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u8A18\u4F4F\uFF01\u4F60\u5011\u53EF\u4EE5\u5E6B\u7260\u52A0\u6CB9\uFF0C\\n\u4F46\u662F\u5343\u842C\u5225\u963B\u64FE\u7260\u5DE5\u4F5C\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5361\u856A\u2026\u2026\u5E25\u7206\u4E86\uFF01\\n\u771F\u4E0D\u6127\u662F\u706B\u5C6C\u6027\u7684\u9053\u9928\u9928\u4E3B\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4F60\u5011\u662F\u4E39\u5E1D\u63A8\u85A6\u7684\u6311\u6230\u8005\uFF0C\\n\u8D6B\u666E\u548C[VAR 0100(0000)]\uFF0C\u5C0D\u5427\uFF01\\c\\n\u70BA\u4E86\u80FD\u5920\u8207\u4F60\u5011\u9019\u4E9B\u9053\u9928\u6311\u6230\u8005\\n\u9032\u884C\u6700\u7CBE\u5F69\u7684\u5C0D\u6230\uFF0C\\r\\n\u6211\u7E3D\u662F\u50CF\u9019\u6A23\u935B\u934A\u81EA\u5DF1\u5230\u6700\u5F8C\u4E00\u523B\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5C0D\u65BC\u4F7F\u7528\u706B\u5C6C\u6027\u5BF6\u53EF\u5922\\n\u5C0D\u6230\u7684\u6211\u800C\u8A00\uFF0C\\c\\n\u9019\u5EA7\u6C34\u5C6C\u6027\u5BF6\u53EF\u5922\u68F2\u606F\u7684\u7B2C\u4E8C\u7926\u5C71\uFF0C\\n\u662F\u6700\u9069\u5408\u7528\u4F86\u935B\u934A\u4E86\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5373\u4FBF\u5982\u6B64\uFF0C\u591C\u8272\u4E5F\u6DF1\u4E86\u3002\\c\\n\u7A7F\u904E\u7B2C\u4E8C\u7926\u5C71\u5F8C\uFF0C\\n\u76F4\u8D70\u5C31\u53EF\u4EE5\u62B5\u9054\u6A5F\u64CE\u5E02\u3002\\c\\n\u4F60\u5011\u56DE\u98EF\u5E97\u597D\u597D\u4F11\u606F\uFF0C\\n\u990A\u7CBE\u84C4\u92B3\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4F86\uFF0C\u5927\u70AD\u8ECA\uFF0C\u4F60\u4E5F\u8A72\u4F11\u606F\u4E86\u3002\\n\u6211\u9001\u4F60\u56DE\u5BB6\u53BB\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u5514\u5594\uFF5E\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u660E\u5929\u6703\u662F\u500B\u706B\u71B1\u7684\u4E00\u5929\u5594\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u5927\u54E5\u66FE\u7D93\u8AAA\u904E\u2026\u2026\\c\\n\u6709\u5F88\u591A\u6311\u6230\u8005\u6703\u56E0\u70BA\u6253\u4E0D\u8D0F\u5361\u856A\uFF0C\\n\u6700\u5F8C\u5C31\u653E\u68C4\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u597D\u8036\uFF01\u6211\u7684\u9B25\u5FD7\u4E5F\u88AB\u9EDE\u71C3\u56C9\uFF01[VAR 0114(0005)]"
  }
