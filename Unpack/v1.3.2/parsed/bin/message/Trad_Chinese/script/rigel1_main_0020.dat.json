[
  {
    "index": 0,
    "flags": 0,
    "text": "\u554A\u54C8\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u9019\u88E1\u5440\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\u90A3\u4F4D\u7531\u6211\u5F15\u8DEF\u7684\u65C5\u4EBA\\n\u5C31\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\u3002[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u525B\u597D\u5C31\u662F\u7D04\u5B9A\u7684\u6642\u9593\uFF01\\n\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E74\u7D00\u8F15\u8F15\u7684\uFF0C\u9084\u771F\u662F\u61C2\u4E8B\u5462\uFF5E\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u548C\u7D04\u5B9A\u7684\u6642\u9593\u5206\u79D2\u4E0D\u5DEE\u2026\u2026\\n\u771F\u662F\u5FC3\u614B\u53EF\u5609\u5462\u3002[VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u602A\u4E86\uFF5E\uFF1F\\n\u6211\u548C[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u4E0D\u662F\u5728\u54EA\u88E1\u898B\u904E\u9762\uFF1F\\r\\n\u2026\u2026\u54CE\uFF0C\u7B97\u4E86\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u55EF\uFF1F\\n\u6211\u5011\u66FE\u7D93\u5728\u54EA\u88E1\u76F8\u9047\u904E\u55CE\uFF1F\\c\\n\u2026\u2026\u54CE\u554A\uFF0C\u7ADF\u7136\u77AC\u9593\u5931\u61B6\u4E86\u3002\\n\u73FE\u5728\u7684\u6211\u7C21\u76F4\u662F\u96BB\u5446\u5446\u7378\u554A\u3002[VAR 0114(0042)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u53EB\u514B\u62C9\u62C9\uFF01\\n\u6211\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u524D\u8F29\u5537\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u662F\u8CFD\u5BF6\u5229\u3002\\n\u7B97\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u524D\u8F29\u3002[VAR 0114(0072)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u524D\u8F29\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u662F\u4E0D\u662F\u8A8D\u932F\u4EBA\u4E86\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u771F\u662F\u7684\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F9E\u4ECA\u5929\u8D77\u4E0D\u662F\\n\u8981\u5728\u99AC\u5E2B\u5085\u6B66\u9928\u62DC\u5E2B\u5B78\u85DD\u55CE\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u662F\u8AAA[VAR 1100(00FF,0101)]\u4F60\u59B3\u63A5\u4E0B\u4F86\u5230\u99AC\u5E2B\u5085\u6B66\u9928\\n\u62DC\u5E2B\u5B78\u85DD\u4E4B\u5F8C\u7684\u4E8B\u3002[VAR 0114(0072)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u54CE\u5440\u2026\u2026\uFF1F\u96E3\u4E0D\u6210\\n\u6211\u88AB\u9019\u500B\u5C0F[VAR 1100(00FF,0202)]\u5F1F\u5F1F\u59B9\u59B9\u7D66\u6349\u5F04\u4E86\uFF1F\\c\\n\u4EBA\u5BB6\u6211\u53EF\u662F\u8D85\u7D1A\u5B8C\u7F8E\u3001\u7121\u6575\u53EF\u611B\u7684\\n\u514B\u62C9\u62C9\u8036\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u7ADF\u7136\u9019\u9EBC\u6C92\u6709\u7406\u89E3\u529B\uFF0C\\n\u5F77\u5F7F\u5C31\u662F\u96BB\u767C\u6296\u8FF7\u8DEF\u7684\u6BDB\u8FAE\u7F8A\u3002\\c\\n\u770B\u4F86\u5F97\u7531\u512A\u96C5\u7684\u6211\\n\u7528\u5927\u4EBA\u7684\u98A8\u7BC4\u9818[VAR 1100(00FF,0101)]\u4ED6\u5979\u9032\u9580\u4E86\u3002[VAR 0114(0072)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u60F3\u60F3\u5594\u2026\u2026\u9996\u5148\u9084\u662F\u900F\u904E\u5C0D\u6230\\n\u4F86\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u6211\u7684\u5BE6\u529B\u597D\u4E86\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u2026\u2026\u6211\u5011\u4F55\u4E0D\u5148\u4E92\u76F8\u5C55\u73FE\u4E00\u4E0B\u5BE6\u529B\uFF0C\\n\u85C9\u6B64\u4F86\u52A0\u6DF1\u611F\u60C5\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u5C31\u5728\u5916\u9762\u7B49\u8457[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002\\n\u6E96\u5099\u597D\u4E4B\u5F8C\u5C31\u904E\u4F86\u5427\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6211\u6703\u5728\u5916\u9762\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u3002\\n\u6E96\u5099\u5C31\u7DD2\u5F8C\u5C31\u51FA\u4F86\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u770B\u6211\u600E\u9EBC\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0B\u99AC\u5A01\u2026\u2026\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u6703\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u6E05\u695A\u660E\u767D\u4E00\u4EF6\u4E8B\u5BE6\uFF0C\\n\u90A3\u5C31\u662F\u6211\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E4B\u4E0A\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6211\u5F9E\u4ECA\u5929\u8D77\u8981\u5728\u9019\u500B\u5CF6\u4E0A\u7684\u6B66\u9928\\n\u62DC\u5E2B\u5B78\u85DD\u2026\u2026\\c\\n\u53EF\u662F\u9A5B\u7AD9\u524D\u6709\u500B\u5947\u602A\u7684\u4EBA\uFF0C\\n\u8B93\u6211\u597D\u6399\u624E\u8981\u4E0D\u8981\u51FA\u7AD9\u2026\u2026"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u525B\u624D\u90A3\u662F\u6B66\u9928\u7684\u4EBA\u55CE\uFF1F\\n\u2026\u2026\u6211\u9084\u662F\u6253\u6D88\u53BB\u4FEE\u884C\u7684\u5FF5\u982D\u5427\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u4E0D\u8981\u4EE3\u66FF\u6211\u53BB\u62DC\u5E2B\uFF1F"
  }
