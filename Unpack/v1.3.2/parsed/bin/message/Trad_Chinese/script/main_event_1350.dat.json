[
  {
    "index": 0,
    "flags": 0,
    "text": "\u547C\u2026\u2026\\n\u7D42\u65BC\u6709\u4EBA\u4F86\u4E86\u3002[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u554A\u2026\u2026\\n\u771F\u7684\u662F\u500B\u6C92\u7528\u7684\u50A2\u4F19\u3002\\c\\n\u6240\u4EE5\uFF0C\u90FD\u6C92\u6709\u4EBA\u80AF\u4F86\u6311\u6230\u3002\\n\u6211\u4E00\u76F4\u662F\u9019\u9EBC\u60F3\u7684\u3002[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u6211\u7684\u8033\u6735\u9084\u7B97\u4E0D\u932F\u5594\u3002\\n\u9435\u6372\u9580\u7684\u4E8B\u60C5\u6211\u4E5F\u90FD\u6709\u807D\u898B\u3002\\c\\n\u4F46\u662F\u4E00\u500B\u4EBA\u5F85\u5728\u9019\u88E1\u6642\uFF0C\\n\u6211\u7684\u5FC3\u90FD\u5FEB\u8981\u6DDA\u5D29\u4E86\u3002[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9019\u662F\u500B\u4E0D\u80FD\u7528\u6975\u5DE8\u5316\u7684\u9053\u9928\u7AF6\u6280\u5834\u3002\\c\\n\u96D6\u7136\u5C0D\u6230\u6703\u6BD4\u8F03\u55AE\u7D14\u4E9B\uFF0C\\n\u5E0C\u671B[VAR 1100(00FF,0101)]\u4F60\u59B3\u9084\u662F\u80FD\u7A0D\u5FAE\u611F\u5230\u6A02\u8DA3\u3002[VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u547C\u2026\u2026[VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u662F\u5C16\u91D8\u93AE\u7684\u9053\u9928\u9928\u4E3B\uFF0C\\n\u4F7F\u7528\u60E1\u5C6C\u6027\u5BF6\u53EF\u5922\u7684\u5929\u624D\uFF01\\c\\n\u4EBA\u7A31\u6211\u591A\u6101\u5584\u611F\u7684\u8076\u6893\uFF01\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u70BA\u4E86[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u500B\u660E\u77E5\u5FC5\u6557\\n\u537B\u4F86\u6311\u6230\u7684\u611A\u6627\u4E4B\u5F92\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u548C\u9019\u6279\u6109\u5FEB\u7684\u5925\u4F34\u5011\u8981\u4E0A\u56C9\uFF01\\n\u770B\u6211\u7684\uFF5E\uFF01\u5C16\u91D8\u93AE\uFF01\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5F88\u9AD8\u8208\u80FD\u548C[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u6230\u3002\\c\\n\u6211\u7684\u5BF6\u53EF\u5922\u5011\\n\u597D\u50CF\u90FD\u9019\u9EBC\u89BA\u5F97\u5462\u3002[VAR 0114(0016)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u9019\u5C31\u662F\u60E1\u5C6C\u6027\u9053\u9928\u7684\u5FBD\u7AE0\uFF0C\\n\u60E1\u4E4B\u5FBD\u7AE0\u3002[VAR 0114(0016)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u80FD\u6355\u6349\u7B49\u7D1A\uFF15\uFF15\u4EE5\u4E0B\u7684\u5BF6\u53EF\u5922\u4E86\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9084\u6709\u9019\u7AF6\u6280\u670D\u2026\u2026\\c\\n\u8981\u662F\u6211\u6709\u8FA6\u6F14\u5531\u6703\u7684\u8A71\uFF0C\\n\u771F\u60F3\u628A\u5B83\u62FF\u4F86\u7576\u5546\u54C1\u8CE3\u5462\u3002[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E0B\u4E00\u500B\u6311\u6230\u8005\uFF0C\\n\u60F3\u5FC5\u5C31\u662F\u6211\u59B9\u59B9\u746A\u4FD0\u4E86\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8981\u56DE\u5230\u5831\u5230\u8655\u55CE\uFF1F"
  }
