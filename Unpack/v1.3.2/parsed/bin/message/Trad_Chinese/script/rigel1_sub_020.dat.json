    "text": "\u771F\uFF5E\u6C92\u8DA3\u3002[VAR 0114(0075)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u9846\u79D1\u79D1\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u6709\u773C\u5149\u5594\u3002[VAR 0114(0075)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u90A3\u5B69\u5B50\u5C31\u662F\u865B\u64EC\u5BF6\u53EF\u5922\uFF0C\\n\u591A\u908A\u7378\u3002[VAR 0114(0075)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7260\u662F\u900F\u904E\u6700\u5C16\u7AEF\u7684\u79D1\u6280\\n\u7D93\u7531\u4EBA\u624B\u5275\u9020\u8A95\u751F\u7684\u5B58\u5728\u3002[VAR 0114(0075)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u63DB\u53E5\u8A71\u8AAA\uFF0C\u7260\u662F\u79D1\u5B78\u6280\u8853\u7684\u7D50\u6676\u3002\\n\u4E0D\u904E\u90A3\u4E5F\u662F\u591A\u5E74\u4EE5\u524D\u7684\u4E8B\u4E86\u3002[VAR 0114(0075)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u7260\u7684\u9020\u578B\u5916\u89C0\u53CD\u6620\u4E86\u7576\u5E74\u6D41\u884C\uFF0C\\n\u4EE5\u76F4\u7DDA\u70BA\u4E3B\uFF0C\u63A1\u65B9\u5F62\u7684\u591A\u908A\u9AD4\u8A2D\u8A08\uFF0C[VAR 0114(0075)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7531\u65BC\u591A\u908A\u7378\u7684\u9020\u578B\u6563\u767C\u8457\u61F7\u820A\u98A8\u60C5\uFF0C\\n\u5C0D\u65BC\u5BF6\u53EF\u5922\u8FF7\u6709\u96E3\u4EE5\u6297\u62D2\u7684\u5438\u5F15\u529B\u3002[VAR 0114(0075)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8B93\u7260\u5E36\u8457\u5347\u7D1A\u8CC7\u6599\u9032\u884C\u9023\u7DDA\u4EA4\u63DB\uFF0C\\n\u5C31\u80FD\u8B93\u7260\u9032\u5316\u6210\u591A\u908A\u7378\u2161\u3002[VAR 0114(0075)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u591A\u908A\u7378\u2161\u7684\u9020\u578B\u4EE5\u6D41\u7DDA\u578B\u70BA\u4E3B\uFF0C\\n\u5149\u6ED1\u5713\u6F64\u7684\u5916\u89C0\u8A2D\u8A08\u4E5F\u662F\u68D2\u900F\u4E86\u3002[VAR 0114(0075)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u54CE\u554A\uFF01\u7260\u751A\u81F3\u53EF\u4EE5\u4F7F\u4EBA\u9059\u60F3\u5230\\n\u4EBA\u985E\u7684\u9032\u5316\uFF0C\u771F\u662F\u592A\u5B8C\u7F8E\u7121\u7455\u4E86\uFF01\uFF01[VAR 0114(0075)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u2026\u2026\u80FD\u6253\u8D0F\u706B\u529B\u5168\u958B\u7684\u7239\u5730\uFF0C\\n\u50CF[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u6A23\u7684\u4EBA\u592A\u7F55\u898B\u4E86\u3002\\r\\n\u6211\u628A\u7260\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7576\u4F5C\u8CC0\u79AE\u5427\u3002[VAR 0114(0075)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u900F\u904E\u6B23\u8CDE\u591A\u908A\u7378\uFF0C\\n\u7D30\u7D30\u54C1\u5473\u4EBA\u985E\u7684\u82F1\u660E\u777F\u667A\u5594\u3002[VAR 0114(0075)]"
  }
