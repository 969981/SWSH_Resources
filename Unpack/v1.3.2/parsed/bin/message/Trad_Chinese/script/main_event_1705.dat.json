[
  {
    "index": 0,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u90A3\u662F\u8AB0\u5440\uFF1F[VAR 0114(006B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5728\u5834\u7684\u5404\u4F4D\uFF0C\u4F60\u5011\u8A18\u5F97\u6211\u55CE\uFF1F\\n\u8ACB\u7D66\u6211\u4E00\u9EDE\u6642\u9593\u3002\\c\\n\u6211\u662F\u5F7C\u7279\uFF01\u88AB\u8FEB\u4E2D\u9014\u9000\u51FA\\n\u9053\u9928\u6311\u6230\u7684\u8A13\u7DF4\u5BB6\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90A3\u662F\u5F7C\u7279\uFF01\\n\u662F\u6D1B\u8332\u6703\u9577\u63A8\u85A6\u7684\u9053\u9928\u6311\u6230\u8005\uFF01[VAR 0114(006B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u548C[VAR 0100(0000)]\u9078\u624B\\n\u6709\u4E00\u6BB5\u4E0D\u6DFA\u7684\u6069\u6028\u3002\\c\\n\u6211\u77E5\u9053\u9019\u662F\u4E0D\u5408\u898F\u5247\u7684\u3002\\n\u4F46\u662F\uFF0C\u62DC\u8A17\u4E86\uFF01\\c\\n\u6211\u9858\u610F\u8CED\u4E0A\u6211\u7684\u9078\u624B\u751F\u6DAF\uFF0C\\n\u8ACB\u8B93\u6211\u8207[VAR 0100(0000)]\u9078\u624B\u5C0D\u6230\uFF01\\r\\n\u8981\u662F\u8F38\u4E86\uFF0C\u6211\u5C31\u5F9E\u6B64\u4E0D\u518D\u7576\u8A13\u7DF4\u5BB6\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u9019\u662F\u600E\u9EBC\u56DE\u4E8B\u5462\uFF01\uFF1F\\c\\n\u5931\u53BB\u8CC7\u683C\u7684\u9053\u9928\u6311\u6230\u8005\uFF0C\\n\u5F7C\u7279\u9078\u624B\u95D6\u4E0A\u5834\u5566\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u5011\u6B63\u5728\u8A0E\u8AD6\\n\u5F7C\u7279\u9078\u624B\u63D0\u51FA\u7684\u8981\u6C42\u3002\\c\\n\u7AF6\u6280\u5834\u4EE5\u53CA\\n\u96FB\u8996\u6A5F\u524D\u7684\u5404\u4F4D\u89C0\u773E\uFF0C\\r\\n\u8ACB\u8010\u5FC3\u7A0D\u5019\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u4E5F\u77E5\u9053\u9019\u662F\u500B\\n\u65E2\u760B\u72C2\u53C8\u7121\u7406\u7684\u8981\u6C42\u3002\\c\\n\u4F46\u662F\uFF0C\u6211\u4E0D\u80FD\u4E0D\u722D\u53D6\u2026\u2026\\n\u6211\u7121\u6CD5\u975C\u975C\u5730\u7576\u500B\u65C1\u89C0\u8005\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4E00\u5207\u90FD\u662F\u88AB[VAR 1100(00FF,0101)]\u4F60\u59B3\u641E\u7838\u7684\uFF01\\c\\n\u6211\u53EA\u662F\u53D7\u5967\u5229\u8587\u79D8\u66F8\u4E4B\u8A17\uFF0C\\n\u5E6B\u6703\u9577\u6536\u96C6\u8A31\u9858\u661F\u3002\\r\\n\u7D50\u679C\uFF0C\u7ADF\u7136\u88AB\u6703\u9577\u62CB\u68C4\u4E86\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u800C\u4E14\uFF0C\u5F8C\u4F86\u9084\u798D\u4E0D\u55AE\u884C\uFF0C\\n\u88AB\u500B\u83AB\u540D\u5176\u5999\u7684\u8001\u592A\u5A46\u7E8F\u4E0A\uFF0C\\r\\n\u6574\u5929\u88AB\u903C\u8457\u5B78\u4E9B\u5996\u7CBE\u5C6C\u6027\u7684\u6771\u897F\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u61C2\u6211\u7684\u8655\u5883\u55CE\uFF1F\\n\u653E\u773C\u76E1\u662F\u7C89\u7D05\u8272\u2026\u2026\\c\\n\u65E5\u5FA9\u4E00\u65E5\u5730\u7528\u5996\u7CBE\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\\n\u4F86\u5C0D\u6230\u3001\u731C\u8B0E\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u554A\u554A\uFF01\u6211\u7ADF\u7136\u9019\u6A23\u4E00\u80A1\u8166\u5152\u5730\\n\u628A\u81EA\u5DF1\u7684\u5167\u5FC3\u7D66\u8AAA\u4E86\u51FA\u4F86\uFF01\\r\\n\u9019\u4E0D\u662F\u6211\u7684\u4F5C\u98A8\u554A\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u554A\uFF01\u51A0\u8ECD\u8A8D\u53EF\u4E86\\n\u5F7C\u7279\u9078\u624B\u7684\u8ACB\u6C42\uFF01\\c\\n\u9019\u662F\u51FA\u65BC\u51A0\u8ECD\u60F3\u63D0\u5347\u4F3D\u52D2\u723E\\n\u6240\u6709\u8A13\u7DF4\u5BB6\u5BE6\u529B\u7684\u5FC3\u9858\u55CE\uFF1F\\c\\n\u53C8\u6216\u8005\u662F\u51A0\u8ECD\\n\u7D66[VAR 0100(0000)]\u9078\u624B\u7684\u8003\u9A57\u5462\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u624D\u4E0D\u662F\u73BB\u7483\u5FC3\uFF01\\n\u6211\u4E0D\u6703\u8F15\u6613\u653E\u68C4\u7684\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u8F38\u4E86\u2026\u2026[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54CE\u5440\uFF01[VAR 0100(0000)]\u9078\u624B\u8207\\n[VAR 1100(00FF,0101)]\u4ED6\u5979\u7CBE\u5FC3\u57F9\u80B2\u7684\u5BF6\u53EF\u5922\u5011\uFF0C\\c\\n\u6F02\u4EAE\u5730\u6230\u52DD\u4E86\u5F7C\u7279\u9078\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u563F\uFF01\u5F7C\u7279\u9078\u624B\uFF01\\n\u4F60\u6253\u5F97\u4E5F\u4E0D\u8CF4\u554A\uFF01[VAR 0114(006B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5C31\u7B97\u9000\u4F11\u4E5F\u6C92\u95DC\u4FC2\uFF01\\n\u518D\u5F9E\u9019\u5152\u5FA9\u51FA\u5C31\u597D\u4E86\uFF01[VAR 0114(006B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u600E\u9EBC\u6703\u662F\u9019\u6A23\u2026\u2026\\c\\n\u6211\u672C\u4F86\u90FD\u7B97\u597D\u4E86\uFF0C\\n\u8D0F\u4E86[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u7B97\u662F\u5831\u4E86\u4E00\u7BAD\u4E4B\u4EC7\uFF01\\c\\n\u8F38\u4E86\u9000\u4F11\u4E5F\u80FD\u64FA\u812B\u90A3\u8001\u592A\u5A46\uFF0C\\n\u5F9E\u6B64\u4E00\u4E86\u767E\u4E86\u2026\u2026[VAR 0114(000C)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u679C\u7136\u662F\u500B\u6383\u628A\u661F\uFF01\\c\\n\u9019\u4E0B\u5B50\u5927\u5BB6\u9019\u9EBC\u652F\u6301\u6211\uFF0C\\n\u6211\u5C31\u53EA\u597D\u7E7C\u7E8C\u7576\\r\\n\u5996\u7CBE\u5C6C\u6027\u9053\u9928\u9928\u4E3B\u4E86\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4E0D\u904E\uFF0C\u6191\u6211\u9019\u51FA\u773E\u7684\u624D\u83EF\uFF0C\\n\u8F49\u773C\u9593\u6211\u5C31\u6703\u8D85\u8D8A\u6CE2\u666E\u83C8\u7684\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6574\u5EA7\u7AF6\u6280\u5834\u662F\u638C\u8072\u5982\u96F7\uFF01\\n\u5927\u5BB6\u90FD\u5728\u70BA\u9019\uFF12\u4F4D\u5E74\u8F15\u4EBA\u559D\u91C7\uFF01\\c\\n\u7D93\u6B77\u4E86\u9019\u5834\u610F\u5916\u7684\u5C0D\u6230\u5F8C\uFF0C\\n[VAR 0100(0000)]\u9078\u624B\u4F3C\u4E4E\u9700\u8981\u6062\u5FA9\u4E00\u4E0B\u3002\\r\\n\u73FE\u5728\uFF0C[VAR 1100(00FF,0101)]\u4ED6\u5979\u8981\u56DE\u4F11\u606F\u5BA4\u4E86\u2026\u2026[VAR 0114(0018)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u525B\u624D\u8207\u5F7C\u7279\u9078\u624B\u7684\u610F\u5916\u4E4B\u6230\uFF0C\\n\u771F\u662F\u8F9B\u82E6[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\u3002\\c\\n\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6E96\u5099\u597D\u4E4B\u5F8C\uFF0C\\n\u8ACB\u524D\u5F80\u5C0D\u6230\u5834\u3002\\r\\n\u6C7A\u8CFD\u5C31\u8981\u958B\u59CB\u4E86\u5594\u3002"
  }
]
