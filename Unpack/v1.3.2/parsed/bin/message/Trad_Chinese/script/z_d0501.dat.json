[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5C16\u91D8\u93AE\u2026\u2026\\n\u70BA\u4EC0\u9EBC\u9435\u6372\u9580\u662F\u62C9\u4E0B\u4F86\u7684\uFF1F\\r\\n\u96E3\u4E0D\u6210\u88E1\u9762\u5728\u958B\u6D3E\u5C0D\u55CE\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u554A\u554A\u554A\uFF01\u662F\u5730\u9707\u55CE\uFF01\uFF1F\\c\\n\u5982\u679C\u6211\u8DDF\u8457\u5730\u9707\\n\u4E00\u8D77\u6416\u64FA\u2026\u2026\\r\\n\u4E0D\u5C0D\u4E0D\u5C0D\uFF0C\u6416\u4E86\u4E5F\u6C92\u7528\u554A\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "[~ 2]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C16\u91D8\u93AE\u7684\u9053\u9928\u9928\u4E3B\u8076\u6893\\n\u96D6\u7136\u64C5\u9577\u4F7F\u7528\u7684\u662F\u60E1\u5C6C\u6027\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4F46\u4ED6\u7D55\u4E0D\u662F\u4EC0\u9EBC\u58DE\u50A2\u4F19\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u90A3\u500B\u4E0A\u982D\u6709\u4E00\u5806\u5546\u6A19\u7684\u62AB\u98A8\u2026\u2026\\n\u525B\u525B\u8DD1\u904E\u53BB\u7684\u4EBA\u662F\u51A0\u8ECD\uFF01\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u9435\u6372\u9580\u62C9\u4E0B\u4F86\u7684\u8A71\uFF0C\\n\u8AB0\u90FD\u4E0D\u80FD\u53C3\u52A0\u9053\u9928\u6311\u6230\u4E86\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u62F3\u95DC\u5E02\u2026\u2026\\n\u61C9\u8A72\u4E0D\u6703\u6709\u4E8B\u5427\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6709\u7D05\u8272\u7684\u5149\uFF01\\n\u90A3\u662F\u6975\u5DE8\u5316\u7684\u5149\u55CE\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9019\u600E\u9EBC\u53EF\u80FD\uFF1F\\n\u9019\u88E1\u660E\u660E\u4E0D\u662F\u80FD\u91CF\u9EDE\uFF0C\\r\\n\u91CE\u751F\u7684\u5BF6\u53EF\u5922\u537B\u6703\u6975\u5DE8\u5316\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u51A0\u8ECD\u548C\u5674\u706B\u9F8D\uFF01\\n\u4ED6\u5011\u662F\u8D85\u7D1A\u82F1\u96C4\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5C31\u662F\u90A3\u500B\u554A\uFF01\u5730\u756B\uFF01\\n\u9019\u91CD\u73FE\u4E86\u5C71\u4E18\u4E0A\u5730\u756B\u7684\u6A23\u5B50\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6643\u3001\u6643\u5F97\u2026\u2026\\n\u597D\u3001\u597D\u53B2\u5BB3\u2026\u2026"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E39\u5E1D\uFF01\uFF1F"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u9019\u88E1\u600E\u9EBC\u6703\u51FA\u73FE\\n\u91CE\u751F\u7684\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\uFF1F"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6709\u7D05\u8272\u7684\u5149\u2026\u2026\\n\u5230\u5E95\u600E\u9EBC\u56DE\u4E8B\uFF1F"
  }
]
