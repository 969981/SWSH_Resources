    "text": "\u90A3\u662F\u4EE5\u524D\u6709\u500B\u670B\u53CB\u9001\u6211\u7684\uFF0C\\n\u4F46\u6211\u5C31\u662F\u4E0D\u600E\u9EBC\u60F3\u7528\u5B83\u2026\u2026[VAR 0114(0076)]"
  },
