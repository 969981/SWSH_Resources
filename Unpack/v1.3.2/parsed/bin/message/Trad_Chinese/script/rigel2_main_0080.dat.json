  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u5427\u54C8\u54C8\uFF01\\n\u633A\u9069\u5408[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u561B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 32,
