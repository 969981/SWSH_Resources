    "text": "\u5C31\u7528\u88E1\u9762\u7684\u9019\u500B\u623F\u9593\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u6211\u9084\u5E6B\u9019\u4EF6\u5916\u5957\u6E96\u5099\u4E86\\n\u5404\u7A2E\u984F\u8272\u7684\u81C2\u5DFE\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u770B\u5FC3\u60C5\u63DB\u984F\u8272\uFF0C\u6642\u9AE6\u4E00\u4E0B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u9084\u6709\uFF0C\u9019\u6771\u897F\u4E5F\u4EA4\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u9019\u662F\u6211\u4E00\u908A\u5F9E\u96FB\u8996\u4E0A\u6536\u96C6\u8CC7\u8A0A\uFF0C\\n\u4E00\u908A\u89AA\u624B\u88FD\u4F5C\u7684\u50B3\u8AAA\u7B46\u8A18\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6211\u60F3\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u5148\u53BB\u8ABF\u67E5\u8ABF\u67E5\\n\u90A3\u500B\u53EB\u300C\u8C50\u9952\u4E4B\u738B\u300D\u7684\u50A2\u4F19\u5427\uFF1F\\r\\n\u6211\u7684\u7B46\u8A18\u4E0A\u4E5F\u6709\u5BEB\u5230\u7260\u3002[VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u8A72\u600E\u9EBC\u8AAA\u54A7\uFF1F\u807D\u8AAA\u9019\u50B3\u8AAA\u8DDF\\n\u570B\u738B\u548C\u611B\u99AC\u7684\u727D\u7D46\u6709\u5F88\u6DF1\u7684\u95DC\u4FC2\uFF01\\r\\n\u9019\u500B\u63A2\u96AA\u5C31\u53EB\u505A\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u5728\u6751\u5B50\u7684\u4E2D\u592E\u9084\u6709\u7260\u7684\u96D5\u50CF\u5462\uFF01\\n\u4E0D\u904E\u548C\u6211\u7684\u7B46\u8A18\u4E0D\u4E00\u6A23\uFF0C\\r\\n\u90A3\u5C0A\u96D5\u50CF\u7684\u982D\u4E00\u9EDE\u90FD\u4E0D\u5927\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u8981\u63DB\u56DE\u539F\u672C\u7684\u670D\u88DD\u55CE\uFF1F"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u63DB\u597D\u8863\u670D\u4E86\u2026\u2026\uFF01\\c\\n\u53BB\u8ABF\u67E5\u738B\u51A0\u96EA\u539F\u7684\u50B3\u8AAA\u5427\uFF01"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u5C31\u7A7F\u9019\u6A23\u5B50\u4E5F\u6C92\u554F\u984C\uFF01\\c\\n\u53BB\u8ABF\u67E5\u738B\u51A0\u96EA\u539F\u7684\u50B3\u8AAA\u5427\uFF01"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u2026\u2026\u5C0D\u4E86\uFF01\u6211\u6709\u500B\u597D\u6771\u897F\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u4E0D\u8981\u5E36\u8D70\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u628A\u5B83\u7528\u5728\u54EA\u96BB\u5BF6\u53EF\u5922\u90FD\u597D\uFF0C\\n\u4E0D\u904E\u6211\u807D\u8AAA\u9019\u662F\u500B\u7206\u53B2\u5BB3\u7684\u7403\u5594\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 46,
