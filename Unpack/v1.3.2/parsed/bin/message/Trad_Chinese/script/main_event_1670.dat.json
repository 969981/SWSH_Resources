    "text": "\u7D42\u65BC\u8981\u958B\u59CB\u4E86\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u7761\u98FD\u55CE\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u660E\u660E\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u4E0A\u5834\u5C0D\u6230\uFF0C\\n\u600E\u9EBC\u9023\u6211\u90FD\u9019\u9EBC\u7DCA\u5F35\u554A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u9078\u624B\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u3002\\c\\n\u6C7A\u8CFD\u5C31\u8981\u958B\u59CB\u4E86\u3002\\n\u6211\u662F\u4F86\u63A5[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u7AF6\u6280\u5834\u7684\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u59B3\u60F3\u5E79\u4EC0\u9EBC\uFF01\\n\u96E3\u9053\u59B3\u5FD8\u8A18\u6628\u5929\u7684\u4E8B\u4E86\u55CE\uFF1F\\c\\n\u7576\u5FC3\u6211\u8D6B\u666E\u548C\u6211\u7684\u642D\u6A94[VAR 0101(0001)]\\n\u628A\u59B3\u75DB\u6253\u4E00\u756A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8ACB\u4F4F\u624B\uFF01\\c\\n\u6211\u662F\u5584\u826F\u7684\u806F\u76DF\u8077\u54E1\u554A\u3002\\n\u96D6\u7136\u9019\u6A23\u8AAA\u6709\u9EDE\u81EA\u5439\u81EA\u64C2\u2026\u2026"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6628\u5929\u7684\u4E8B\u60C5\u6211\u90FD\u807D\u8AAA\u4E86\u3002\\c\\n\u70BA\u4E86\u5E6B\u52A9\u6703\u9577\uFF0C\\n\u5967\u5229\u8587\u79D8\u66F8\u5979\u2026\u2026\\r\\n\u6709\u6642\u5019\u4EC0\u9EBC\u4E8B\u90FD\u505A\u5F97\u51FA\u4F86\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u64DA\u8AAA\uFF0C\u5979\u9084\u70BA\u6B64\u5077\u5077\u5730\u57F9\u990A\u4E86\u4E00\u6279\\n\u807D\u547D\u65BC\u81EA\u5DF1\u7684\u806F\u76DF\u8077\u54E1\u2026\u2026"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F46\u662F\u4ECA\u5929\u8ACB\u5118\u7BA1\u653E\u5FC3\uFF01\\n\u5728\u5834\u7684\u8077\u54E1\uFF0C\u90FD\u662F\u503C\u5F97\u4FE1\u4EFB\u7684\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u90A3\u770B\u4F86\u6211\u5011\u80FD\u653E\u5FC3\u4E86\u3002\\c\\n\u8D70\u5427\uFF01[VAR 0100(0000)]\uFF01\\n\u6211\u8FEB\u4E0D\u53CA\u5F85\u8981\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\u5566\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8981\u6211\u5E36[VAR 1100(00FF,0101)]\u4F60\u59B3\u524D\u5F80\\n\u5BAE\u9580\u7AF6\u6280\u5834\u55CE\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u9EBC\uFF0C\u6211\u5011\u51FA\u767C\u5427\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u597D\u7684\u3002\u8ACB\u96A8\u610F\u5427\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u5F9E\u98EF\u5E97\u524D\\n\u642D\u4E58\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u53BB\u7AF6\u6280\u5834\uFF0C\\r\\n\u7576\u7136\u4E5F\u53EF\u4EE5\u6539\u8B8A\u4E3B\u610F\uFF0C\u56DE\u982D\u627E\u6211\u3002"
  }
]
