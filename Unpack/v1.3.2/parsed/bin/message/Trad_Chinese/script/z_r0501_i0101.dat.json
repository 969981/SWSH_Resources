[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54CE\u5440\uFF5E\u6B61\u8FCE\u5149\u81E8\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u77E5\u9053\u4EC0\u9EBC\u5462\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9084\u6709\u5176\u4ED6\u60F3\u4E86\u89E3\u7684\u55CE\uFF1F"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u5011\u5BC4\u653E\u5C4B\u7684\u5DE5\u4F5C\uFF0C\\n\u5C31\u662F\u770B\u7BA1\u7167\u6599\u5927\u5BB6\u5BC4\u653E\u7684\u5BF6\u53EF\u5922\u3002\\c\\n\u628A\u5BF6\u53EF\u5922\u5BC4\u653E\u5728\u9019\u88E1\uFF0C\\n\u96D6\u7136\u4E0D\u6703\u56E0\u6B64\u8B8A\u5F37\uFF0C\\c\\n\u4F46\u540C\u6642\u4E00\u8D77\u5BC4\u653E\uFF12\u96BB\u7684\u8A71\uFF0C\\n\u6709\u6642\u5019\u53EF\u4EE5\u767C\u73FE\u5BF6\u53EF\u5922\u7684\u86CB\u3002\\c\\n\u6211\u5B6B\u5973\u5C31\u5728\u5916\u982D\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u5BC4\u653E\u5BF6\u53EF\u5922\u7684\u8A71\uFF0C\\r\\n\u8DDF\u5979\u8AAA\u4E00\u8072\u5C31\u884C\u4E86\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5982\u679C\u628A\u5BF6\u53EF\u5922\u7684\u86CB\\n\u52A0\u5230\u540C\u884C\u968A\u4F0D\u4E2D\u5E36\u8457\u8D70\uFF0C\\r\\n\u5C31\u6703\u5B75\u51FA\u5BF6\u53EF\u5922\u4F86\u3002\\c\\n\u795E\u5947\u7684\u5BF6\u53EF\u5922\u86CB\uFF0C\\n\u4E0D\u77E5\u9053\u5F9E\u54EA\u88E1\u5192\u51FA\u4F86\u7684\u2026\u2026\\r\\n\u751F\u547D\u5BE6\u5728\u662F\u5F88\u5967\u5999\u554A\uFF5E"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u8981\u5BF6\u53EF\u5922\u7684\u86CB\uFF0C\\n\u90A3\u5C31\u8A66\u8457\u60F3\u60F3\u770B\u5982\u4F55\\r\\n\u642D\u914D\u8981\u5BC4\u653E\u7684\u5BF6\u53EF\u5922\u3002\\c\\n\u6BD4\u5982\u8AAA[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u5BC4\u653E\u7A2E\u985E\u76F8\u540C\uFF0C\\n\u5206\u5225\u662F\u2642\u548C\u2640\u7684\u5BF6\u53EF\u5922\u3002\\c\\n\u5373\u4F7F\u662F\uFF12\u7A2E\u4E0D\u540C\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u53EA\u8981\u7A2E\u985E\u63A5\u8FD1\u7684\u8A71\uFF0C\\r\\n\u4E5F\u6709\u6A5F\u6703\u767C\u73FE\u86CB\u5594\u3002\\c\\n\u4E0D\u904E\u4F3C\u4E4E\u6709\u4E00\u4E9B\u5BF6\u53EF\u5922\\n\u4E0D\u6703\u51FA\u73FE\u86CB\u5C31\u662F\u4E86\u2026\u2026"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6B61\u8FCE\u518D\u4F86\u554A\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4EC0\u9EBC\u662F\u5BC4\u653E\u5C4B\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u7684\u86CB"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5BC4\u653E\u7684\u5BF6\u53EF\u5922"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u53D6\u6D88"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  }
]
