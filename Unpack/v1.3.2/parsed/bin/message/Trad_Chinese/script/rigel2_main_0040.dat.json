    "text": "\u60A8\u8981\u807D\u6975\u5DE8\u5927\u5192\u96AA\u7684\u8AAA\u660E\u55CE\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5225\u9019\u6A23\u50B7\u6211\u7684\u5FC3\u554A\uFF01\\n\u62DC\u8A17\u5566\uFF0C\u6211\u7684\u597D\u642D\u6A94\uFF5E\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8ACB\u5225\u5728\u610F\u90A3\u4F4D\u5148\u751F\u3002\\n\u7B49\u60A8\u78BA\u5BE6\u6E96\u5099\u597D\u4E4B\u5F8C\uFF0C\\r\\n\u518D\u544A\u8A34\u6211\u4E00\u8072\u5427\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u554A\uFF01\u9019\u624D\u662F\u6211\u7684\u597D\u642D\u6A94\uFF01\\n\u611F\u6069\u5566\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u2026\u2026\u90A3\u9EBC\uFF0C\u6211\u8981\u958B\u59CB\u8AAA\u660E\u4E86\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6975\u5DE8\u5DE2\u7A74\u662F\u4E00\u5EA7\u5730\u4E0B\u8FF7\u5BAE\uFF0C\\n\u5728\u4F3D\u52D2\u723E\u5730\u5340\u7121\u6CD5\u898B\u5230\u7684\\r\\n\u7A00\u6709\u5BF6\u53EF\u5922\uFF0C\u4E5F\u6703\u68F2\u606F\u5728\u9019\u88E1\u2026\u2026"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7531\u65BC\u5927\u5BB6\u7684\u540C\u884C\u5BF6\u53EF\u5922\\n\u53EF\u80FD\u6703\u5C0D\u4F3D\u52D2\u723E\u7C92\u5B50\u8D77\u53CD\u61C9\uFF0C\\r\\n\u9032\u800C\u5931\u63A7\u2026\u2026"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u56E0\u6B64\u6211\u5011\u6E96\u5099\u4E86\\n\u5C0D\u4F3D\u52D2\u723E\u7C92\u5B50\u6709\u6297\u6027\u7684\u5BF6\u53EF\u5922\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u55EF\uFF1F\u6211\u61C2\u56C9\uFF01\\c\\n\u4E5F\u5C31\u662F\u8AAA\uFF0C\u8981\u662F\uFF14\u500B\u6211\u90FD\u5931\u63A7\uFF0C\\n\u5C31\u6703\u5B89\u5168\u5730\u88AB\u79DF\u7528\uFF0C\\r\\n\u7136\u5F8C\u5927\u5BB6\u7684\u7A00\u6709\u6F5B\u529B\u6703\u88AB\u6FC0\u767C\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u60A8\u6C92\u6709\u4E00\u53E5\u662F\u5C0D\u7684\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u9019\u662F\u500B\u5F88\u5371\u96AA\u7684\u5730\u65B9\u3002\\n\u8ACB\u60A8\u597D\u597D\u5730\u8A18\u4F4F\u898F\u5247\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u96D6\u7136\u6211\u641E\u4E0D\u592A\u6E05\u695A\uFF0C\\n\u4F46\u7E3D\u4E4B\u5C31\u662F\u90A3\u6A23\u7684\u5730\u65B9\u662F\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u597D\uFF01\\n\u770B\u4F86\u9019\u5C0D\u6211\u662F\u592A\u96E3\u61C2\u4E86\u3002\\r\\n\u6211\u9084\u662F\u76F4\u63A5\u53BB\u95D6\u95D6\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5C0F\u590F\u590F\u554A\u554A\uFF01\uFF01\\n\u7238\u62D4\u6211\u9019\u5C31\u4F86\u5566\u554A\u554A\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u554A\uFF01\u7B49\u7B49\uFF01\uFF01\\n\u6211\u624D\u525B\u8AAA\u90A3\u6A23\u5F88\u5371\u96AA\uFF01\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u90A3\u4F4D\u5148\u751F\u7A76\u7ADF\u662F\u600E\u9EBC\u56DE\u4E8B\uFF1F\\c\\n\u9577\u5F97\u660E\u660E\u548C\u6D1B\u8332\u6703\u9577\u5F88\u50CF\uFF0C\\n\u600E\u9EBC\u537B\u2026\u2026"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5982\u679C\u60A8\u8981\u53BB\u8FFD\u90A3\u4F4D\u5148\u751F\u2026\u2026\\n\u5509\uFF0C\u7576\u7136\u4E5F\u672A\u5FC5\u662F\u70BA\u4E86\u9019\u500B\u7406\u7531\u3002\\c\\n\u7E3D\u4E4B\uFF0C\u5982\u679C\u60A8\u60F3\u53C3\u52A0\u6975\u5DE8\u5927\u5192\u96AA\uFF0C\\n\u5C31\u8ACB\u544A\u8A34\u6211\u4E00\u8072\u5427\u3002"
  }
]
