    "text": "\u54CE\u5440\uFF0C\u8D6B\u666E\uFF0C\\n\u4F60\u7684\u6BDB\u8FAE\u7F8A\u591A\u4E86\u65B0\u670B\u53CB\u4E86\u3002[VAR 0114(000A)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u662F[VAR 0100(0000)]\u5427\u3002\\c\\n\u6211\u5F88\u671F\u5F85[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u89AA\u624B\u5B8C\u6210\\n\u7D22\u59AE\u4E9E\u4EA4\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u5716\u9451\u5594\u3002[VAR 0114(000A)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF0C[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u4EC0\u9EBC\u662F\u300C\u6975\u5DE8\u5316\u300D\u5427\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6728\u862D\u535A\u58EB\u9577\u5E74\u90FD\u5728\u7814\u7A76\u6975\u5DE8\u5316\u3002\\c\\n\u7562\u7ADF\uFF0C\u8981\u719F\u7DF4\u904B\u7528\u6975\u5DE8\u5316\uFF0C\\n\u9084\u662F\u9700\u8981\u76F8\u95DC\u77E5\u8B58\u7684\u3002[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E39\u5E1D\uFF0C\u4F60\u771F\u662F\u982D\u8166\u88E1\u96A8\u6642\u90FD\\n\u53EA\u60F3\u8457\u5BF6\u53EF\u5922\u7684\u4E8B\u3002\\c\\n\u4E16\u754C\u4E0A\u9084\u6709\u5F88\u591A\u4E8B\u60C5\\n\u503C\u5F97\u4F60\u53BB\u63A2\u7D22\u5462\u3002\u5C31\u50CF\u2026\u2026\\r\\n\u7D05\u8336\u4E5F\u6709\u6578\u4E0D\u6E05\u7684\u7A2E\u985E\u5594\u3002[VAR 0114(000A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u535A\u58EB\uFF0C\u535A\u58EB\uFF0C\\n\u59B3\u5E6B\u6211\u52F8\u52F8\u5927\u54E5\uFF0C\\r\\n\u8B93\u4ED6\u63A8\u85A6\u6211\u5011\u53C3\u52A0\u9053\u9928\u6311\u6230\u5566\u3002[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u662F\u554A\uFF0C\u4E39\u5E1D\uFF0C\\n\u4F60\u70BA\u4EC0\u9EBC\u4E0D\u80AF\u63A8\u85A6\u4ED6\u5011\u5462\uFF1F[VAR 0114(000A)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u7562\u7ADF\u8D6B\u666E\u548C[VAR 0100(0000)]\\n\u90FD\u662F\u65B0\u624B\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\uFF0C\\r\\n\u9084\u7A31\u4E0D\u4E0A\u662F\u6210\u719F\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u54CE\u5440\u54CE\u5440\u2026\u2026\u4F60\u7684\u5FC3\u9858\\n\u4E0D\u662F\u8981\u8B93\u4F3D\u52D2\u723E\u5730\u5340\u7684\u6BCF\u500B\u4EBA\uFF0C\\r\\n\u90FD\u6210\u70BA\u5F37\u5927\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u55CE\uFF1F[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u554A\u2026\u2026\uFF01\u60A8\u8AAA\u7684\u6C92\u932F\u3002\\c\\n\u6211\u600E\u9EBC\u6703\u5FD8\u8A18\u9019\u9EBC\u91CD\u8981\u7684\u4E8B\u3002\\n\u9019\u4E5F\u662F\u6211\u628A\u5BF6\u53EF\u5922\u4EA4\u7D66\u4ED6\u5011\u7684\u7528\u610F\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\u90A3\u9EBC\u4F60\u5011\u5006\\n\u73FE\u5728\u5C31\u53BB\u6253\u4E00\u5834\u7CBE\u5F69\u7684\u5C0D\u6230\uFF0C\\r\\n\u597D\u8B93\u6211\u5FC3\u670D\u53E3\u670D\u5730\u63A8\u85A6\u4F60\u5011\u5427\uFF01\\c\\n\u7576\u7136\uFF0C\u6211\u6703\u5148\u5E6B\u4F60\u5011\u7684\u5BF6\u53EF\u5922\\n\u6062\u5FA9\u6D3B\u529B\u7684\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\u8036\uFF01[VAR 0100(0000)]\uFF0C\\n\u6211\u5728\u5916\u9762\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u5594\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u76E1\u60C5\u5730\u5C0D\u6230\uFF0C\\n\u4E0D\u50C5\u5C0D\u5BF6\u53EF\u5922\u6709\u5E6B\u52A9\uFF0C\\r\\n\u5C0D\u81EA\u5DF1\u4E5F\u662F\u5F88\u6709\u610F\u7FA9\u7684\u5594\u3002[VAR 0114(000A)]"
  }
