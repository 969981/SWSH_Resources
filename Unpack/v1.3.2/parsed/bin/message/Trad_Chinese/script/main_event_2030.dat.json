  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53EA\u8981\u662F\u6211\u7684\u6BD4\u8CFD\uFF0C\\n\u4E00\u5411\u5C31\u662F\u5EA7\u7121\u865B\u5E2D\u3002\\c\\n\u4F46\u662F\uFF0C\u9019\u9084\u662F\u6211\u982D\u4E00\u906D\\n\u898B\u5230\u7AF6\u6280\u5834\u7684\u89C0\u773E\u9019\u9EBC\u72C2\u71B1\u3002[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5927\u5BB6\u90FD\u5DF2\u7D93\u77E5\u9053[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\uFF13\u5929\u524D\u7684\u7CBE\u5F69\u8868\u73FE\u2026\u2026\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6355\u6349\u4E86\u7121\u6975\u6C70\u90A3\uFF0C\u9019\u5C31\u7B49\u65BC\u662F\\n\u62EF\u6551\u4E86\u4F3D\u52D2\u723E\u5730\u5340\u7684\u672A\u4F86\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8207\u50B3\u8AAA\u4E2D\u7684\u5BF6\u53EF\u5922\u84BC\u97FF\u3001\u85CF\u746A\u7136\u7279\\n\u4E26\u80A9\u6230\u9B25\u7684\u82F1\u96C4\u2026\u2026\\c\\n\u4F5C\u70BA\u66F4\u65B0\u6211\u7121\u6575\u7D00\u9304\u7684\u6311\u6230\u8005\uFF0C\\n\u771F\u662F\u518D\u5408\u9069\u4E0D\u904E\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u628A\u7121\u6975\u6C70\u90A3\u52A0\u5165\u968A\u4F0D\u4E86\u554A\u3002\\c\\n\u6700\u5F37\u6311\u6230\u8005\u548C\\n\u6700\u5F37\u5BF6\u53EF\u5922\u7684\u7D44\u5408\u2026\u2026\\r\\n\u9019\u5BE6\u5728\u662F\u592A\u4EE4\u4EBA\u8208\u596E\u4E86\u2026\u2026\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u6703\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u500B\u6700\u5F37\u7684\u6311\u6230\u8005\\n\u5C07\u5BE6\u529B\u767C\u63EE\u5230\u6975\u81F4\uFF01\\c\\n\u7136\u5F8C\u4EE5\u58D3\u5012\u6027\u7684\u529B\u91CF\u64CA\u57AE[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\n\u85C9\u6B64\u5F70\u986F\u51A0\u8ECD\u7684\u5F37\u5927\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u51FA\u62DB\u5427\uFF01[VAR 0100(0000)]\uFF01\\c\\n\u6211\u5011\u4F86\u7DE0\u9020\u4E00\u5834\\n\u8DB3\u4EE5\u5728\u4F3D\u52D2\u723E\u5730\u5340\u6D41\u50B3\u5343\u53E4\u2026\u2026\u4E0D\uFF0C\\r\\n\u662F\u8DB3\u4EE5\u6539\u8B8A\u4F3D\u52D2\u723E\u672A\u4F86\u7684\u51A0\u8ECD\u8CFD\uFF01[VAR 0114(0004)]"
