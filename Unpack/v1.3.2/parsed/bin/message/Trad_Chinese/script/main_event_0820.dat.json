    "text": "[VAR 0100(0000)]\uFF0C\u8D70\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54A6\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u662F\u9053\u9928\u9928\u4E3B\u8036\uFF0C\\n\u600E\u9EBC\u7279\u5730\u4F86\u9001\u884C\u4E86\uFF1F\\c\\n\u5361\u856A\u4F60\u662F\u770B\u51FA\u4E86\\n\u6211\u6709\u51A0\u8ECD\u76F8\uFF0C\u662F\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6709\u591A\u4E0D\u52DD\u6578\u7684\u8A13\u7DF4\u5BB6\\n\u662F\u9023\uFF13\u500B\u9053\u9928\u5FBD\u7AE0\u90FD\u7121\u6CD5\u6536\u9F4A\uFF0C\\r\\n\u5C31\u653E\u68C4\u4E86\u9053\u9928\u6311\u6230\u2026\u2026\\c\\n\u6240\u4EE5\uFF0C\u53EA\u8981\u662F\u6253\u8D0F\u6211\u7684\u6311\u6230\u8005\uFF0C\\n\u6211\u90FD\u6703\u89AA\u81EA\u4F86\u9001\u884C\u3002[VAR 0114(0010)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u547C\uFF5E\u8D95\u4E0A\u4E86\u2026\u2026\\n\u771F\u8981\u611F\u8B1D\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u3001\u8D6B\u666E\uFF0C\u606D\u559C\u4F60\u5011\uFF01\\n\u7ADF\u7136\u80FD\u6253\u8D0F\u5361\u856A\uFF0C\u592A\u53B2\u5BB3\u4E86\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u80FD\u5920\u5F9E\u5361\u856A\u624B\u4E2D\u62FF\u5230\u9053\u9928\u5FBD\u7AE0\u7684\\n\u6311\u6230\u8005\uFF0C\u771F\u7684\u4E0D\u591A\u5462\uFF5E\\c\\n\u6240\u4EE5\u6211\u5011\u90FD\u6703\u4E00\u8D77\u4F86\u9001\u884C\uFF0C\\n\u8868\u9054\u5C0D\u6311\u6230\u8005\u7684\u9F13\u52F5\u5594\u3002[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8A71\u4E0D\u591A\u8AAA\uFF0C\\n\u5C31\u8B93\u6211\u70BA\u4F60\u5011\u6253\u6253\u6C23\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u885D\u554A\u885D\u554A\uFF01\u8D6B\uFF5E\u666E\uFF01\uFF01\\n\u52A0\u6CB9\u52A0\u6CB9\uFF01[VAR 0100(0000)]\uFF01\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5728\u524D\u982D\u7B49\u8457\u4F60\u5011\u7684\u9053\u9928\u9928\u4E3B\\n\u5404\u500B\u90FD\u662F\u5F37\u8005\u3002\\c\\n\u4F46\u4F60\u5011\u4E00\u5B9A\u53EF\u4EE5\u6230\u52DD\u7684\uFF01\\n\u76F8\u4FE1\u5BF6\u53EF\u5922\uFF0C\u596E\u529B\u5411\u524D\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5361\u856A\uFF0C\u5927\u5BB6\uFF0C\u8B1D\u8B1D\u4F60\u5011\uFF01\\c\\n\u6211\u5011\u5006\u6703\u5288\u54E9\u556A\u5566\u6253\u8D0F\u5230\u5E95\uFF0C\\n\u7136\u5F8C\u5728\u6C7A\u6230\u4E2D\u4E00\u6C7A\u52DD\u8CA0\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4E0B\u4E00\u7AD9\u5C31\u5728\u62F3\u95DC\u5E02\u3002\\n\u6211\u5011\u52A0\u6CB9\u5427\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u627E\u51FA\u81EA\u5DF1\u4E0D\u8DB3\u4E4B\u8655\u5427\uFF01\\c\\n\u552F\u6709\u4E86\u89E3\u81EA\u5DF1\u7F3A\u9EDE\u7684\u4EBA\uFF0C\\n\u624D\u6703\u596E\u529B\u5B78\u7FD2\u4E26\u4E14\u6210\u9577\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8FB2\u5BB6\u5DE5\u4F5C\u7E3D\u6703\u9047\u4E0A\u4E0D\u6E2C\u98A8\u96F2\u3002\\n\u5BF6\u53EF\u5922\u5C0D\u6230\u4E5F\u662F\u4E00\u6A23\u3002\\c\\n\u53EA\u8981\u5805\u6301\u4E0D\u653E\u68C4\uFF0C\\n\u7E3D\u6703\u6709\u8FA6\u6CD5\u7684\u5594\u3002[VAR 0114(000E)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u56B4\u4EE5\u5F8B\u5DF1\u662F\u597D\u4E8B\uFF0C\\n\u4F46\u662F\u903C\u5F97\u592A\u7DCA\u662F\u6703\u7206\u70B8\u7684\u5594\u3002\\c\\n\u60F3\u653E\u9B06\u4E00\u4E0B\u6642\uFF0C\\n\u5C31\u5230\u6D77\u9BAE\u9910\u5EF3\u4F86\u5427\u3002[VAR 0114(000F)]"
  }
]
