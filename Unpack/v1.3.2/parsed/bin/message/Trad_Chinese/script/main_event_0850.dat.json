  {
    "index": 2,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u8DB3\u5920\u591A\u7684\u8A31\u9858\u661F\uFF0C\\n\u5C31\u80FD\u89E3\u6C7A\u6703\u9577\u7684\u7169\u60F1\u4E86\uFF01\\r\\n\u5C0D\u4E0D\u5C0D\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0D\uFF0C\u9019\u4E0D\u662F\u6211\u500B\u4EBA\u7684\u554F\u984C\u3002\\n\u800C\u662F\u70BA\u4E86\u4F3D\u52D2\u723E\u5730\u5340\u7684\u672A\u4F86\u554A\u3002[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u800C\u4E14\u6211\u4E0D\u53EA\u662F\u9700\u8981\u8A31\u9858\u661F\uFF0C\\n\u9084\u9700\u8981\u6709\u500B\u5F37\u5927\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u3002\\r\\n\u5C31\u50CF\u51A0\u8ECD\u90A3\u6A23\u3002[VAR 0114(0006)]"
