[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4EBA\u5011\u90FD\u53EB\u6211\u6316\u6316\u5AC2\u2026\u2026\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u898B\u5230\u6316\u6316\u4F2F\u4E86\u55CE\uFF1F\\n\u4ED6\u662F\u6211\u7684\u5925\u4F34\u5462\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u6B63\u5728\u7528\u6211\u7684\u597D\u93DF\u5B50\u2026\u2026\\n\u4E5F\u5C31\u662F\u9019\u652F\u300C\u6211\u5FC3\u611B\u7684\u6E6F\u5319\u300D\uFF0C\\r\\n\u4EAB\u53D7\u6316\u6D1E\uFF0C\u4E5F\u9AD4\u9A57\u523A\u6FC0\u5594\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u70BA\u4E86\u7D00\u5FF5\u6211\u5011\u7684\u76F8\u9047\uFF0C\\n\u6211\u89BA\u5F97\u8A72\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF11\u500B\u93A7\u7532\u7926\u77F3\u2026\u2026"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\uFF01\u7B49\u7B49\uFF01\uFF01\\c\\n\u96D6\u7136[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u76F4\u63A5\u6536\u4E0B\\n\u9019\u500B\u93A7\u7532\u7926\u77F3\u2026\u2026\\c\\n\u4F46\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u53EF\u4EE5\u628A\u5B83\u6295\u8CC7\u5728\u6316\u6D1E\u4E0A\uFF0C\\n\u8B93\u6211\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u6316\u51FA\u66F4\u591A\u7684\u93A7\u7532\u7926\u77F3\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u689D\u4EF6\u662F\uFF01\u5982\u679C\u6316\u5230\u4E00\u534A\\n\u6211\u5FC3\u611B\u7684\u6E6F\u5319\u58DE\u6389\u4E86\uFF0C\\r\\n\u90A3\u6316\u51FA\u4F86\u7684\u6771\u897F\u5C31\u5168\u90FD\u6B78\u6211\u2026\u2026"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u500B\u8FFD\u6C42\u523A\u6FC0\u7684\u4EBA\uFF0C\\n\u8981\u4E0D\u8981\u8A66\u8A66\u628A\u4EBA\u751F\u8A17\u4ED8\u7D66\u6211\u5440\uFF1F\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F97\u5148\u5BEB\u500B\u7D00\u9304\u5C31\u662F\u4E86\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[~ 7]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6316\u5BF6\u8C48\u6703\u7A69\u8CFA\u4E0D\u8CE0\u3002\\n\u65E2\u7136\u662F\u689D\u8EB2\u4E0D\u4E86\u98A8\u96AA\u7684\u8DEF\uFF0C\\r\\n\u5C31\u8CED\u4E0A[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u4EBA\u751F\u4F86\u6311\u6230\u5427\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9019\u662F\u5343\u8F09\u96E3\u9022\u7684\u5927\u597D\u6A5F\u6703\uFF0C\\n\u6211\u671F\u5F85[VAR 1100(00FF,0101)]\u4F60\u59B3\u653E\u624B\u4E00\u640F\uFF01\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u5537\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\uFF0C\u6211\u8981\u958B\u6316\u56C9\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5509\u554A\u2026\u2026\u5C0D\u4E0D\u8D77\uFF01\\n\u649E\u4E0A\u4E86\u8D85\u5805\u786C\u7684\u5CA9\u77F3\uFF0C\\r\\n\u8B93\u6211\u5FC3\u611B\u7684\u6E6F\u5319\u58DE\u6389\u4E86\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u9019\u4E0B\u5B50[VAR 1100(00FF,0101)]\u4F60\u59B3\u539F\u672C\u80FD\u5F97\u5230\u7684\\n\u93A7\u7532\u7926\u77F3\u5168\u90FD\u6C92\u4E86\u2026\u2026"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54CE\uFF0C\u4EBA\u751F\u5C31\u662F\u9019\u9EBC\u4E00\u56DE\u4E8B\u5566\u3002\\n\u90A3\u9EBC\u2026\u2026\u6211\u5011\u6709\u7DE3\u5C31\u518D\u76F8\u6703\u5427\uFF01"
  },
