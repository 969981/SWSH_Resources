[
  {
    "index": 0,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\uFF0C\u6211\u7D42\u65BC\u7B49\u5230\u7684\\n\u9053\u9928\u6311\u6230\u8005\u7ADF\u7136\u6703\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E39\u5E1D\u679C\u771F\u6C92\u770B\u8D70\u773C\uFF0C\\n\u9078\u4E86\u500B\u512A\u79C0\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6230\u52DD\u4E39\u5E1D\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u77E5\u9053\u90A3\u6709\u591A\u56F0\u96E3\u55CE\uFF1F\\c\\n\u5C31\u8B93\u6211\u9019\u500B\u4E39\u5E1D\u7684\u52C1\u6575\u5947\u5DF4\u7D0D\\n\u597D\u597D\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u9AD4\u6703\u7B87\u4E2D\u6ECB\u5473\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u5947\u5DF4\u7D0D\u8EAB\u70BA\u4E00\u500B\u9053\u9928\u9928\u4E3B\uFF0C\\n\u4E0D\u50C5\u6703\u63A7\u5236\u5C0D\u6230\u4E2D\u7684\u5929\u6C23\uFF0C\\r\\n\u9084\u6703\u8981\u6C42\uFF12\u5C0D\uFF12\u7684\u96D9\u6253\u5C0D\u6230\uFF01\\c\\n\u6C92\u932F\uFF01\u6211\u5C31\u662F\u8981\u6E2C\u8A66\\n\u6311\u6230\u8005\u80FD\u5426\u61C9\u4ED8\u6240\u6709\u7684\u72C0\u6CC1\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7D93\u904E\u9019\u5834\u6FC0\u70C8\u7684\u5C0D\u6230\u5F8C\u2026\u2026\\c\\n\u6211\u73FE\u5728\u7684\u5FC3\u60C5\\n\u5C31\u50CF\u842C\u91CC\u6674\u7A7A\u90A3\u6A23\u6E05\u6F88\u8212\u723D\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u624D\u602A\u5462\uFF01\u6211\u5FEB\u8981\u5192\u7159\u4E86\uFF01\\c\\n\u4E39\u5E1D\u7684\u52C1\u6575\uFF1F\\n\u660E\u660E\u5C31\u4E0D\u662F\u51A0\u8ECD\uFF0C\\r\\n\u6211\u548C\u6211\u7684\u5BF6\u53EF\u5922\u6709\u4EC0\u9EBC\u597D\u56C2\u5F35\u7684\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9019\u5C31\u8CDE\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\uFF01\\n\u6230\u52DD\u6211\u7684\u8B49\u64DA\u2015\u2015\u9F8D\u4E4B\u5FBD\u7AE0\uFF01\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u80FD\u6355\u6349\u6240\u6709\u7B49\u7D1A\u7684\u5BF6\u53EF\u5922\u4E86\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9019\u4E0B\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u62FF\u5230\\n\u4F3D\u52D2\u723E\u5730\u5340\u6240\u6709\u7684\u9053\u9928\u5FBD\u7AE0\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u60F3\u6311\u6230\u51A0\u8ECD\u4E39\u5E1D\u7684\u8A71\uFF0C\\n\u5C31\u5728\u6DD8\u6C70\u8CFD\u88E1\u812B\u7A4E\u800C\u51FA\u5427\uFF01\\c\\n\u4E0D\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u975E\u8D0F\u4E0D\u53EF\uFF01\\c\\n\u6C92\u932F\uFF01\u9019\u6A23\u6211\u5011\u624D\u6709\u6A5F\u6703\u96EA\u6065\u554A\uFF01\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u6536\u9F4A\u4E86\u6240\u6709\u7684\u9053\u9928\u5FBD\u7AE0\u2026\u2026\\n\u7D42\u65BC\u80FD\u6311\u6230\u51A0\u8ECD\u76C3\u4E86\u5462\uFF01\\r\\n\u6211\u671F\u5F85\u4F60\u5011\u80FD\u5927\u5C55\u8EAB\u624B\u5594\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210\u4E86\u9053\u9928\u6311\u6230\uFF01\\n\u6211\u771F\u5FC3\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u795D\u8CC0\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8981\u56DE\u5230\u5831\u5230\u8655\u55CE\uFF1F"
  }
]
