[
  {
    "index": 0,
    "flags": 0,
    "text": "\u70BA\u4E86\u5E6B\u9053\u9928\u6311\u6230\u8005\u52A0\u6CB9\u6253\u6C23\uFF0C\\n\u6211\u5011\u7279\u5730\u4F86\u5230\u4E86\u9019\u500B\u5927\u90FD\u5E02\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u662F\u60F3\u59A8\u7919\\n\u6211\u5011\u9019\u7FA4\u8A8D\u771F\u8001\u5BE6\u7684\u5436\u558A\u968A\uFF0C\\r\\n\u6211\u5011\u5C31\u8981\u8DDF[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u5834\u5BF6\u53EF\u5922\u5C0D\u6230\u4E86\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F86\u5C0D\u6230\u5427\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u4E0D\u5435\u4F60\u5011\u4E86"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4EC0\u9EBC\uFF5E\uFF01\u6211\u4E0D\u662F\u8AAA\u904E\uFF0C\\n\u8981\u59A8\u7919\u6211\u5011\uFF0C\u5C31\u4F86\u5834\u5BF6\u53EF\u5922\u5C0D\u6230\u55CE\uFF1F\\c\\n\u70BA\u4E86\u8B93\u67D0\u4F4D\u8A13\u7DF4\u5BB6\u7372\u52DD\u2026\u2026\\n\u5436\u558A\u968A\u6703\u4E0D\u60DC\u4E00\u5207\u5728\u65C1\u52A0\u6CB9\u5436\uFF5E\u558A\uFF01\\c\\n\u4F86\u5427\uFF01\u6211\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u597D\u898B\uFF5E\u8B58\u4E00\u4E0B\uFF0C\\n\u6211\u5011\u5436\u558A\u968A\u7684\u53B2\u5BB3\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5582\uFF5E\uFF01\u5436\u558A\u968A\u7684\u5925\u4F34\u5011\uFF0C\\n\u4F86\u5E6B\u6211\u5831\u4EC7\u5436\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F86\u56C9\u4F86\u56C9\uFF5E\uFF01\\n\u5728\u98EF\u5E97\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\u8B9A\u5436\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9019\u7A2E\u9AD8\u6A94\u6B21\u7684\u5730\u65B9\u2026\u2026\\n\u6703\u8B93\u6211\u7DCA\u5F35\u5F97\u4F7F\u4E0D\u51FA\u5BE6\u529B\u5436\u2026\u2026[VAR 0114(006F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8FA6\u500B\u5165\u4F4F\u600E\u9EBC\u9019\u9EBC\u71B1\u9B27\u2026\u2026\\c\\n\u9019\u662F\u600E\u9EBC\u56DE\u4E8B\uFF1F\\n\u600E\u9EBC\u6253\u8D77\u5BF6\u53EF\u5922\u5C0D\u6230\u4E86\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u597D\u8036\uFF01\\n\u6211\u4E5F\u8981\u4F86\u8A13\u7DF4\u4E00\u756A\uFF01\\c\\n[VAR 0100(0000)]\uFF0C\\n\u6211\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u6062\u5FA9\u6D3B\u529B\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u662F\u9053\u9928\u6311\u6230\u8005\u8D6B\u666E\uFF01\\n\u4E0B\u4EFB\u51A0\u8ECD\u5C31\u662F\u6211\uFF01\\r\\n\u6211\u5011\u4F86\u5834\u96D9\u6253\u5C0D\u6230\u5427\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u770B\uFF5E\u5427\uFF01\u770B\uFF5E\u5427\uFF01\u6211\u5011\u52DD\u5229\u5728\u671B\uFF01\\n\u807D\uFF5E\u5427\uFF01\u807D\uFF5E\u5427\uFF01\u4F60\u5011\u54ED\u8072\u97FF\u4EAE\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u770B\uFF5E\u5427\uFF01\u770B\uFF5E\u5427\uFF01\u6211\u5011\u4E00\u6557\u5857\u5730\u2026\u2026\\n\u807D\uFF5E\u5427\uFF01\u807D\uFF5E\u5427\uFF01\u6211\u5011\u54C0\u568E\u904D\u91CE\u2026\u2026[VAR 0114(006F)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5927\u5BB6\u5728\u9019\u88E1\u505A\u4EC0\u9EBC\u5440\uFF1F[VAR 0114(0042)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u746A\u4FD0\uFF01\uFF1F[VAR 0114(006F)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4E0D\uFF0C\u9019\u2026\u2026\\n\u6211\u5011\u2026\u2026[VAR 0114(006F)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u4F60\u5011\u5F88\u5728\u4E4E\\n\u5176\u4ED6\u7684\u9053\u9928\u6311\u6230\u8005\u3002\\r\\n\u4F46\u662F\uFF0C\u9019\u4E5F\u9B27\u5F97\u592A\u904E\u706B\u4E86\u3002[VAR 0114(000D)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5C0D\u4E0D\u8D77\u5594\uFF01\\n\u5436\u558A\u968A\u662F\u4F86\u5E6B\u6211\u52A0\u6CB9\u7684\u3002\\r\\n\u4F46\u5927\u5BB6\u597D\u50CF\u90FD\u6709\u9EDE\u6D6E\u8E81\u2026\u2026[VAR 0114(000D)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u5225\u9B27\u4E86\uFF01\\n\u5927\u5BB6\u89E3\u6563\u5427\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5436\u558A\u968A\u592A\u71B1\u5FC3\u5728\u5E6B\u6211\u52A0\u6CB9\u4E86\uFF0C\\n\u7D50\u679C\u5728\u9047\u4E0A\u5176\u4ED6\u7684\u9053\u9928\u6311\u6230\u8005\u6642\uFF0C\\r\\n\u614B\u5EA6\u5C31\u7279\u5225\u6709\u6575\u610F\u3002\\c\\n\u4ED6\u5011\u662F\u4E0D\u662F\u5F97\u7F6A\u4F60\u5011\u4E86\uFF1F\\n\u771F\u662F\u5C0D\u4E0D\u8D77\u5594\u3002[VAR 0114(000D)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u59B3\u4E5F\u662F\u9053\u9928\u6311\u6230\u8005\u554A\uFF01\\n\u4ED6\u5011\u53EB\u5436\u558A\u968A\uFF0C\u662F\u55CE\uFF1F\\r\\n\u59B3\u5DF2\u7D93\u6709\u7C89\u7D72\u5718\u4E86\u8036\u3002\u597D\u53B2\u5BB3\u554A\uFF01[VAR 0114(0005)]"
  }
