    "text": "\u59B3\u6709\u52A9\u624B\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5979\u662F\u6211\u7684\u52A9\u624B\u5594\uFF01\\c\\n\u6211\u7684\u7814\u7A76\u8D8A\u4F86\u8D8A\u5FD9\uFF0C\\n\u5FC5\u9808\u8ACB\u4EBA\u4F86\u5E6B\u5FD9\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u597D\u773C\u529B\uFF01\\c\\n\u6211\u7684\u7814\u7A76\u8D8A\u4F86\u8D8A\u5FD9\uFF0C\\n\u5FC5\u9808\u8ACB\u4EBA\u4F86\u5E6B\u5FD9\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6D1B\u8332\u6703\u9577\u4E4B\u524D\u5927\u91CF\u6536\u96C6\u7684\u8A31\u9858\u661F\uFF0C\\n\u73FE\u5728\u5168\u90FD\u4FDD\u7BA1\u5728\u9019\u500B\u7814\u7A76\u6240\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5E78\u8667\u6709\u5979\u4E7E\u6DE8\u4FD0\u843D\u5730\u5E6B\u6211\u6574\u7406\u597D\u4E86\u3002\\c\\n\u6709\u500B\u9019\u9EBC\u80FD\u5E79\u7684\u4EBA\u7576\u52A9\u624B\uFF0C\\n\u6211\u771F\u662F\u8F15\u9B06\u4E0D\u5C11\u5462\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u60A8\u904E\u734E\u4E86\u2026\u2026"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u662F\u65B0\u51A0\u8ECD\\n[VAR 0100(0000)]\uFF0C\u5C0D\u4E0D\u5C0D\uFF1F\\c\\n\u771F\u9AD8\u8208\u80FD\u5920\u898B\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002\\n\u8ACB\u591A\u591A\u6307\u6559\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u904E\u4F86\u4E00\u4E0B\u5427\uFF01\\n\u6211\u6709\u6771\u897F\u60F3\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u3002[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u9084\u8A18\u5F97\u80FD\u91CF\u9EDE\u5075\u6E2C\u5668\u55CE\uFF1F\\c\\n\u5728\u80FD\u5920\u6975\u5DE8\u5316\u7684\u5730\u65B9\u2026\u2026\\n\u4E5F\u5C31\u662F\u4F3D\u52D2\u723E\u7C92\u5B50\u805A\u96C6\u7684\u5730\u65B9\uFF0C\\r\\n\u5075\u6E2C\u5668\u5C31\u6703\u6709\u53CD\u61C9\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u731C\u5F97\u6C92\u932F\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u90A3\u5169\u500B\u50A2\u4F19\u5728\u9644\u8FD1\u6642\uFF0C\\n\u5075\u6E2C\u5668\u83AB\u540D\u5176\u5999\u5730\u6709\u4E86\u53CD\u61C9\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u96E3\u9053\u8AAA\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6240\u4EE5\u2026\u2026\uFF1F"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6C92\u932F\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4E5F\u5C31\u662F\u8AAA\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u53EA\u8981\u5229\u7528\u80FD\u91CF\u9EDE\u5075\u6E2C\u5668\u7684\u53CD\u61C9\uFF0C\\n\u8AAA\u4E0D\u5B9A\u5C31\u53EF\u4EE5\u8FFD\u8E64\u5230\u897F\u7D22\u96D9\u4EBA\u7D44\u4E86\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u897F\u723E\u8FEA\u8207\u7D22\u5FB7\uFF0C\\n\u7C21\u7A31\u897F\u7D22\u96D9\u4EBA\u7D44\u3002\\r\\n\u2026\u2026\u4E0D\u662F\u6BD4\u8F03\u9806\u53E3\u55CE\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u7E3D\u800C\u8A00\u4E4B\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6211\u73FE\u5728\u5C31\u548C\u8A2D\u7F6E\u5728\u4F3D\u52D2\u723E\u5730\u5340\\n\u5404\u5730\u7684\u80FD\u91CF\u9EDE\u5075\u6E2C\u5668\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u540C\u6B65\u9023\u7DDA\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u54C7\uFF01\u9019\u53CD\u61C9\u771F\u662F\u8D85\u4E4E\u9810\u6599\uFF01\\n\u5730\u9EDE\u5728\u2026\u2026\u8349\u8DEF\u7AF6\u6280\u5834\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u7AF6\u6280\u5834\u672C\u4F86\u5C31\u662F\u53EF\u4EE5\u6975\u5DE8\u5316\u7684\u5730\u65B9\uFF0C\\n\u6703\u7522\u751F\u53CD\u61C9\u4E5F\u662F\u7406\u6240\u7576\u7136\uFF0C\u4F46\u2026\u2026\\r\\n\u9019\u9EBC\u9AD8\u7684\u6578\u503C\u5C31\u592A\u7570\u5E38\u4E86\u2026\u2026\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u662F\u7121\u6975\u6C70\u90A3\u55CE\u2026\u2026\uFF1F\u4E0D\uFF0C\u4E0D\u53EF\u80FD\u3002\\n\u7260\u5DF2\u7D93\u88AB[VAR 1100(00FF,0101)]\u4F60\u59B3\u6349\u4F4F\u4E86\u3002\\c\\n\u96E3\u9053\u8AAA\uFF0C\u9019\u7570\u5E38\u6578\u503C\\n\u4E5F\u548C\u897F\u7D22\u96D9\u4EBA\u7D44\u6709\u95DC\u2026\u2026\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\u9019\u4EF6\u4E8B\u2026\u2026\\n\u8EAB\u70BA\u51A0\u8ECD\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u80FD\u4E0D\u9867\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6211\u628A[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u57CE\u93AE\u5730\u5716\u8ABF\u6574\u597D\u4E86\u3002\\n\u73FE\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u53EF\u4EE5\u770B\u5230\u54EA\u88E1\u6709\u7C92\u5B50\u53CD\u61C9\u4E86\u3002\\r\\n\u4E0D\u77E5\u9053\u8A72\u53BB\u54EA\u88E1\u6642\uFF0C\u5C31\u770B\u4E00\u4E0B\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u53EA\u80FD\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u8349\u8DEF\u7AF6\u6280\u5834\u8ABF\u67E5\u4E86\u3002\\c\\n\u81F3\u65BC\u90A3\u96D9\u4EBA\u7D44\u5230\u5E95\u662F\u4EC0\u9EBC\u4F86\u8DEF\uFF0C\\n\u5C31\u4EA4\u7D66\u6211\u4F86\u8ABF\u67E5\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6211\u80FD\u5920\u5728\u7D22\u59AE\u4E9E\u535A\u58EB\u9019\u88E1\u5DE5\u4F5C\uFF0C\\n\u5BE6\u5728\u662F\u592A\u69AE\u5E78\u4E86\u3002\\c\\n\u5979\u771F\u7684\u5F88\u4E86\u4E0D\u8D77\uFF0C\\n\u5E74\u7D00\u8F15\u8F15\u5C31\u62FF\u5230\u4E86\u535A\u58EB\u7684\u982D\u929C\u5462\uFF01"
  }
