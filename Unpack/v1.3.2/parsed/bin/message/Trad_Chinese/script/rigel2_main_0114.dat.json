    "index": 0,
    "flags": 0,
    "text": "\u4EBA\u985E\u7684\u5C0F\u5B69\u5152\u554A\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u554F\u904E\u6751\u88E1\u7684\u4EBA\u985E\u4E86\u5427\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u2026\u2026\u7D50\u679C\u5982\u4F55\uFF1F\\n\u95DC\u65BC\u6715\uFF0C\u4ED6\u5011\u6709\u8AAA\u4E86\u4E9B\u4EC0\u9EBC\u55CE\uFF1F[VAR 0114(0079)]"
