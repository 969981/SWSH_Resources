  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6709\u4EBA\u8AAA\u662F\u7AE5\u8A71\u6545\u4E8B\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5463\u2026\u2026\u6715\u60F3\u5F97\u6C92\u932F\u3002\\n\u679C\u7136\u6C92\u6709\u4EBA\u76F8\u4FE1\\r\\n\u6715\u771F\u7684\u5B58\u5728\u554A\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u770B\u6A23\u5B50\u4EBA\u985E\u662F\u65E9\u5DF2\u5FD8\u8A18\\n\u8207\u6715\u4E4B\u9593\u7684\u727D\u7D46\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\uFF0C\u6C92\u4E8B\u3002\\n\u6715\u624D\u4E0D\u89BA\u5F97\u50B7\u5FC3\u5462\u3002[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6715\u4E43\u8C50\u9952\u4E4B\u738B\uFF01\\n\u6715\u4E0D\u6703\u611A\u6627\u5230\\r\\n\u53BB\u5C0D\u4EBA\u985E\u6709\u6240\u671F\u5F85\u3002[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4E8B\u5230\u5982\u4ECA\uFF0C\u6715\u5DF2\u7D93\u4E0D\u5962\u671B\\n\u80FD\u9760\u4EBA\u985E\u5C0D\u6715\u7684\u4FE1\u4EF0\\r\\n\u4F86\u6062\u5FA9\u5DF1\u8EAB\u7684\u529B\u91CF\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F46\u8981\u662F\u6715\u7684\u611B\u99AC\u56DE\u4F86\u7684\u8A71\uFF0C\\n\u4E5F\u8A31\u80FD\u6062\u5FA9\u4E9B\u529B\u91CF\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u8AAA\u7684\u611B\u99AC\u662F\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u662F\u4EC0\u9EBC\u6A23\u7684\u5BF6\u53EF\u5922\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7260\u662F\u96BB\uFF14\u8173\u5BF6\u53EF\u5922\uFF0C\\n\u6715\u66FE\u7D93\u9A0E\u8457\u7260\u99B3\u9A01\u56DB\u65B9\u2026\u2026\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6751\u5B50\u7684\u96D5\u50CF\u4E5F\u662F\\n\u6715\u9A0E\u8457\u7260\u7684\u6A21\u6A23\u3002[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5728\u9059\u9060\u7684\u904E\u53BB\uFF0C\u7260\u66FE\u662F\u4F34\u8457\u6715\\n\u7E31\u6A6B\u5C71\u91CE\u7684\u597D\u5925\u4F34\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4F46\u81EA\u5F9E\u6715\u7684\u529B\u91CF\u6F38\u5F31\uFF0C\\n\u8B93\u7260\u8207\u6715\u5206\u9053\u63DA\u9463\u5F8C\uFF0C\\r\\n\u6715\u4FBF\u4E0D\u77E5\u7260\u7684\u53BB\u5411\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5373\u4F7F\u771F\u7684\u627E\u5230\u4E86\u6715\u7684\u611B\u99AC\uFF0C\\c\\n\u6715\u73FE\u5728\u5982\u6B64\u7121\u529B\uFF0C\\n\u5927\u6982\u4E5F\u7121\u6CD5\u99D5\u99AD\u7260\u5427\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6751\u5B50\u88E1\u8AAA\u4E0D\u5B9A\u4E5F\u6709\u6D41\u50B3\u8457\\n\u95DC\u65BC\u611B\u99AC\u7684\u6D88\u606F\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u82E5\u80FD\u4EE3\u6715\u554F\u554F\u6751\u9577\uFF0C\\n\u6715\u5C31\u611F\u6FC0\u4E0D\u76E1\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6715\u76FC[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u6709\u4E86\u4EC0\u9EBC\u65B0\u6D88\u606F\u6642\uFF0C\\n\u8A18\u5F97\u4F86\u544A\u8A34\u6715\u3002[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u2026\u2026\u5443\u560E\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u54CE\u55B2\uFF1F\u968A\u9577\uFF01\uFF1F\\n\u597D\u5927\u7684\u8166\u888B\u74DC\u2026\u2026\u4E0D\u898B\u5566\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u2026\u2026\u5509\u5440\uFF0C\u5C0D\u4E0D\u8D77\uFF01\\n\u6211\u597D\u50CF\u662F\u7AD9\u8457\u7761\u8457\u4E86\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u55EF\uFF1F\u600E\uFF5E\u89BA\u5F97\\n\u8EAB\u9AD4\u597D\u50CF\u602A\uFF5E\u602A\u7684\u2026\u2026\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u5148\u56DE\u57FA\u5730\u4F11\u606F\u53BB\u56C9\uFF01\\n\u5509\u55B2\uFF5E\u51CD\u6B7B\u6211\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u8C50\u9952\u4E4B\u738B\u7684\u611B\u99AC\uFF1F\\n\u5C31\u662F\u5728\u6C11\u9593\u6545\u4E8B\u88E1\u6703\u8DD1\u5230\u7530\u5730\u4F86\\r\\n\u6417\u4E82\u5077\u5403\u7684\u66B4\u8E81\u50A2\u4F19\u5427\uFF1F\\r\\n\u63DB\u53E5\u8A71\u8AAA\uFF0C\u5C31\u662F\u6211\u7684\u6B7B\u5C0D\u982D\u56C9\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u570B\u738B\u7684\u611B\u99AC\uFF1F\u6211\u60F3\u60F3\u554A\u2026\u2026\\c\\n\u90A3\u500B\u53BB\u4E86\u6A5F\u64CE\u5E02\u7684\u611B\u746A\uFF0C\\n\u4E0D\u77E5\u9053\u904E\u5F97\u597D\u4E0D\u597D\u554A\uFF1F"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u807D\u8AAA\u570B\u738B\u7684\u611B\u99AC\u6709\u8457\u4E00\u8EAB\\n\u7F8E\u9E97\u7121\u6BD4\u7684\u70CF\u4EAE\u6BDB\u76AE\u5594\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u570B\u738B\u7684\u611B\u99AC\uFF1F\\c\\n\u4EE5\u524D\u6709\u4EBA\u544A\u8A34\u6211\u8AAA\uFF0C\\n\u7260\u7684\u8EAB\u9AD4\u5C31\u50CF\u96EA\u90A3\u6A23\u6F54\u767D\u5594\u3002"
