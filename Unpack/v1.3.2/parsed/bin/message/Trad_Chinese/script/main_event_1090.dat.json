[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6211\u69AE\u7372\u4E86\u6703\u9577\u63A8\u85A6\uFF0C\\n\u662F\u9072\u65E9\u6703\u6230\u52DD\u51A0\u8ECD\u7684\u8A13\u7DF4\u5BB6\u2026\u2026\\c\\n\u6211\u9019\u500B\u80A9\u8CA0\u4F3D\u52D2\u723E\u5730\u5340\u672A\u4F86\u7684\u7CBE\u82F1\uFF0C\\n\u600E\u9EBC\u53EF\u80FD\u6703\u2026\u2026\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5F7C\u7279\u9078\u624B\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u8AAA\u60F3\u8981\u501F\u7528\\n\u6D1B\u8332\u6703\u9577\u7684\u5927\u738B\u9285\u8C61\u6642\uFF0C\\r\\n\u6211\u9084\u89BA\u5F97\u7D0D\u60B6\u5462\u2026\u2026\\c\\n\u60F3\u4E0D\u5230\uFF0C\u4F60\u7ADF\u7136\u662F\u70BA\u4E86\u7834\u58DE\u907A\u8DE1\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6BD4\u8D77\uFF11\uFF10\uFF10\uFF10\u5E74\u5F8C\u7684\u672A\u4F86\uFF0C\\n\u5340\u5340\u4E00\u500B\u907A\u8DE1\uFF0C\u7B97\u4EC0\u9EBC\u5462\uFF01\uFF1F\\c\\n\u6191\u59B3\u9019\u6BD4\u751C\u751C\u9999\u6C23\u9084\u8981\u751C\u5AE9\u7684\u60F3\u6CD5\uFF0C\\n\u771F\u7684\u80FD\u8F14\u52A9\u6703\u9577\u55CE\uFF1F\\r\\n\u59B3\u5920\u8CC7\u683C\u7576\u4ED6\u7684\u79D8\u66F8\u55CE\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5F7C\u7279\u2026\u2026[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u9019\u8A71\u5BE6\u5728\u662F\u96E3\u4EE5\u555F\u9F52\uFF0C\\n\u4F46\u2026\u2026\u6211\u771F\u7684\u5F88\u907A\u61BE\u3002\\c\\n\u6C92\u932F\uFF0C\u6211\u662F\u5728\u4F60\u9084\u5E74\u5E7C\u7684\u6642\u5019\uFF0C\\n\u770B\u4E0A\u4E86\u4F60\u9019\u500B\u5B64\u7368\u7684\u5B69\u5B50\u3002[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u70BA\u4E86\u8B93\u4F60\u767C\u5C55\u5929\u8CC7\uFF0C\\n\u6211\u4E5F\u66FE\u8CC7\u52A9\u4F60\u4E0A\u8A13\u7DF4\u5BB6\u5B78\u6821\u3002\\c\\n\u5C31\u662F\u56E0\u70BA\u4F60\u8B93\u6211\u60F3\u8D77\u5F9E\u524D\u7684\u81EA\u5DF1\uFF0C\\n\u6240\u4EE5\u6211\u624D\u6703\u7D66\u4F60\u6A5F\u6703\u3002[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F46\u662F\u50CF\u7834\u58DE\u907A\u8DE1\u9019\u7A2E\u884C\u70BA\uFF0C\\n\u8868\u793A\u4F60\u5C0D\u4F3D\u52D2\u723E\u6C92\u6709\u611B\u2026\u2026\\c\\n\u50CF\u4F60\u9019\u6A23\u7684\u9078\u624B\uFF0C\\n\u4E0D\u914D\u53C3\u52A0\u9053\u9928\u6311\u6230\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u5011\u6703\u6C7A\u5B9A\u8A72\u5982\u4F55\u8655\u5206\u4F60\u7684\u3002\\n\u4F60\u5148\u56DE\u62F3\u95DC\u5E02\u53BB\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u60A8\u9019\u2026\u2026\u662F\u5728\u958B\u73A9\u7B11\u5427\uFF1F\\c\\n\u8981\u662F\u6211\u55AA\u5931\u4E86\u6311\u6230\u8CC7\u683C\uFF0C\\n\u5C31\u4EE3\u8868\u60A8\u6311\u4EBA\u6642\u770B\u8D70\u773C\u4E86\u554A\uFF01\\c\\n\u82E5\u8AAA\u9019\u88E1\u6709\uFF11\uFF10\uFF10\u7A2E\u9078\u9805\uFF0C\\n\u60A8\u9019\u662F\u505A\u4E86\u6700\u7CDF\u7CD5\u7684\u6C7A\u5B9A\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5F7C\u7279\u9078\u624B\uFF0C\\n\u4F60\u6536\u96C6\u5230\u7684\u8A31\u9858\u661F\uFF0C\\r\\n\u5C31\u4EA4\u7D66\u6211\u4FDD\u7BA1\u5427\u3002[VAR 0114(0007)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9E\uFF0C[VAR 0100(0000)]\uFF0C\\n\u62B1\u6B49\u8B93\u4F60\u5011\u7121\u7AEF\u88AB\u6372\u5165\u9B27\u5287\u4E86\u3002\\c\\n\u96D6\u7136\u4EE5\u9019\u6A23\u7684\u7406\u7531\u5931\u53BB\u4E00\u500B\u6311\u6230\u8005\uFF0C\\n\u5BE6\u5728\u662F\u4EE4\u4EBA\u611F\u5230\u907A\u61BE\uFF0C\\r\\n\u4F46\u662F\u6BD4\u8CFD\u5C31\u662F\u8981\u516C\u5E73\u554A\u3002[VAR 0114(0006)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5728\u5F7C\u7279\u9078\u624B\u7684\u5C0D\u6230\u6642\uFF0C\\n\u6211\u66FE\u807D\u5BE6\u6CC1\u89E3\u8AAA\u63D0\u5230\u904E\u2026\u2026\\c\\n\u56E0\u70BA\u7576\u5E74\u6703\u9577\u6536\u7559\u4E86\u7121\u4F9D\u7121\u9760\u7684\u4ED6\uFF0C\\n\u6240\u4EE5\u4ED6\u7ACB\u5FD7\u8981\u70BA\u6703\u9577\u596E\u6230\u3002[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5509\u2026\u2026\\n\u907A\u8DE1\u6C92\u4E8B\u5427\uFF1F[VAR 0114(000B)]"
  }
]
