  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4ED6\u559A\u9192\u4E86\u7121\u6975\u6C70\u90A3\uFF0C\\n\u9084\u641E\u5F97\u4F3D\u52D2\u723E\u5730\u5340\u4EBA\u5FC3\u60F6\u60F6\u3002\\r\\n\u4E5F\u96E3\u602A\u8981\u81EA\u9996\u554A\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u4E0D\u77E5\u9053[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u5E7E\u5929\u904E\u5F97\u600E\u6A23\uFF0C\\n\u4F46\u6211\u9019\u5E7E\u5929\u7761\u5F97\u50CF\u7058\u721B\u6CE5\u4E00\u6A23\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5916\u982D\u5230\u73FE\u5728\u90FD\u9084\u6CB8\u6CB8\u63DA\u63DA\uFF01\\n\u5E78\u597D\u4E8B\u60C5\u90FD\u5DF2\u7D93\u89E3\u6C7A\u4E86\uFF01\\c\\n\u591A\u8667\u4E86\u6709\u85CF\u746A\u7136\u7279\u548C\u84BC\u97FF\u5728\uFF0C\\n\u6211\u5011\u624D\u80FD\u6253\u6557\u7121\u6975\u6C70\u90A3\u5462\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF0C\u5927\u54E5\u7ADF\u7136\u8208\u81F4\u52C3\u52C3\u5730\\n\u8AAA\u4EC0\u9EBC\u8981\u8209\u8FA6\u51A0\u8ECD\u8CFD\u54E9\uFF01\\c\\n\u4ED6\u660E\u660E\u53D7\u4E86\u91CD\u50B7\uFF0C\\n\u9084\u660F\u4E86\u904E\u53BB\uFF0C\\r\\n\u9019\u7C21\u76F4\u662F\u80E1\u4F86\u561B\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8A71\u8AAA\u56DE\u4F86\uFF0C\\n\u6211\u4E5F\u80FD\u4E86\u89E3\u4ED6\u7684\u5FC3\u60C5\u5566\u3002\\c\\n\u7562\u7ADF\uFF0C\u80FD\u548C[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u4E00\u5834\\n\u8A8D\u771F\u7684\u5C0D\u6230\uFF0C\u600E\u9EBC\u53EF\u80FD\u4E0D\u671F\u5F85\u5462\uFF1F[VAR 0114(0005)]"
