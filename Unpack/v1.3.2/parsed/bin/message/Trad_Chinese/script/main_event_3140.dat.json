  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u63A5\u4E0B\u4F86\u6050\u6015\u6703\u8D8A\u4F86\u8D8A\u7CDF\u3002\\c\\n\u9084\u6709\uFF13\u500B\u5BF6\u53EF\u5922\u7AF6\u6280\u5834\\n\u6709\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u6B63\u5728\u5927\u9B27\u3002\\r\\n\u6211\u5011\u52A0\u5FEB\u7BC0\u594F\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u61C9\u8A72\u9084\u5269\u4E0B\uFF12\u500B\u5BF6\u53EF\u5922\u7AF6\u6280\u5834\u3002[VAR 0114(0016)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u53EA\u5269\u4E0B\uFF11\u500B\u5BF6\u53EF\u5922\u7AF6\u6280\u5834\\n\u6709\u6975\u5DE8\u5316\u5BF6\u53EF\u5922\u4E86\u3002\\r\\n\u6211\u5011\u8D95\u7DCA\u53BB\u5E6B\u5FD9\u5283\u4E0B\u4F11\u6B62\u7B26\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u518D\u4F86\uFF0C\u53EA\u8981\u6349\u4F4F\u897F\u7D22\u96D9\u4EBA\u7D44\uFF0C\\n\u5C31\u7B97\u544A\u4E00\u6BB5\u843D\u56C9\u3002[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u5011\u5F97\u60F3\u8FA6\u6CD5\u641E\u5B9A\u4ED6\u5011\uFF0C\\n\u4E0D\u7136\u53EF\u80FD\u9084\u6703\u767C\u751F\u540C\u6A23\u7684\u4E8B\u60C5\u54EA\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9E\u535A\u58EB\u61C9\u8A72\u6B63\u5728\u70BA\u6211\u5011\u958B\u8DEF\uFF0C\\n\u597D\u6349\u4F4F\u90A3\u5169\u500B\u4EBA\uFF0C\u662F\u5427\uFF1F[VAR 0114(0016)]"
