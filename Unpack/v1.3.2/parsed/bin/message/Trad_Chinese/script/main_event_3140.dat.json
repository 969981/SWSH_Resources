  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u897F\u7D22\u96D9\u4EBA\u7D44\u8DD1\u9032\u53BB\u7684\u5730\u65B9\uFF01\\c\\n\u62F3\u95DC\u7AF6\u6280\u5834\u88E1\\n\u901A\u5F80\u80FD\u6E90\u5DE5\u5EE0\u7684\u90A3\u9053\u9580\uFF01[VAR 0114(000B)]"
