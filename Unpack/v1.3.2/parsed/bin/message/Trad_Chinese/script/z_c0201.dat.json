  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8A13\u7DF4\u5BB6\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u7DE8\u8F2F\u806F\u76DF\u5361\u55CE\uFF1F\\c\\n\u96D6\u7136\u7D20\u6750\u8B8A\u591A\u8B93\u4EBA\u773C\u82B1\u64A9\u4E82\uFF0C\\n\u4F46\u6311\u9078\u4E5F\u662F\u4E00\u7A2E\u6A02\u8DA3\u5462\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u6709\u500B\u670B\u53CB\u554A\uFF5E\\c\\n\u807D\u8AAA\u4ED6\u6253\u626E\u6210\u5BF6\u53EF\u5922\uFF0C\\n\u5728\u5BF6\u53EF\u5E6B\u5E6B\u5FD9\u5DE5\u4F5C\u3002\\c\\n\u4E0D\u662F\u6211\u5594\uFF0C\u6211\u662F\u8AAA\u6211\u670B\u53CB\u3002"
