    "text": "\u5927\u54E5\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u525B\u624D\u90A3\u662F\u2026\u2026\\n\u62F3\u95DC\u5E02\u7684\u7AF6\u6280\u5834\u5427\uFF1F\\r\\n\u6D1B\u8332\u5148\u751F\u641E\u51FA\u4E86\u4EC0\u9EBC\u4E8B\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u4E5F\u4E00\u982D\u9727\u6C34\uFF01\\c\\n\u4F46\u4ED6\u6628\u5929\u7684\u90A3\u756A\u8A71\u2026\u2026\\n\u96E3\u4E0D\u6210\u4ED6\u771F\u7684\u884C\u52D5\u4E86\uFF1F\\r\\n\u5C31\u70BA\u4E86\u89E3\u6C7A\uFF11\uFF10\uFF10\uFF10\u5E74\u5F8C\u7684\u554F\u984C\uFF01\uFF1F\\c\\n\u7E3D\u4E4B\uFF0C\u6211\u2026\u2026\\n\u6211\u662F\u51A0\u8ECD\uFF0C\u6211\u8981\u99AC\u4E0A\u53BB\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90FD\u602A\u6211\u6C92\u6709\u8A8D\u771F\u53BB\u4E86\u89E3\\n\u806F\u76DF\u6703\u9577\u5C0D\u6211\u8AAA\u7684\u8A71\u3002\\r\\n\u9019\u4EF6\u4E8B\u6211\u6709\u8CAC\u4EFB\u2026\u2026\\r\\n\u6240\u4EE5\uFF0C\u6211\u6703\u8CA0\u8CAC\u7684\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4EA4\u7D66\u6211\u5427\u3002\\n\u5F9E\u73FE\u5728\u8D77\uFF0C\u5C31\u662F\u51A0\u8ECD\u6642\u523B\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5927\u54E5\uFF01\u4F60\u662F\u500B\u8DEF\u75F4\u554A\uFF01\\n\u771F\u7684\u5230\u5F97\u4E86\u62F3\u95DC\u5E02\u55CE\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u60F3\u52A9\u5927\u54E5\u4E00\u81C2\u4E4B\u529B\uFF01\\c\\n\u53EF\u662F\uFF0C\u6211\u9023[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u90FD\u8D0F\u4E0D\u4E86\uFF0C\\n\u9084\u80FD\u5E6B\u4E0A\u4EC0\u9EBC\u5FD9\u5462\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u53EF\u4EE5\u7684\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u5011\u53BB\u5E6B\u5FD9\u5427\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u5F97\u5012\u662F\u7C21\u55AE\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F46\u662F\u2026\u2026\\n\u8981\u600E\u9EBC\u5E6B\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u8332\u6703\u9577\u8AAA\u7684\u300C\u95C7\u591C\u300D\uFF0C\\n\u5C31\u662F\u6307\u5F88\u4E45\u4EE5\u524D\u767C\u751F\u7684\\r\\n\u5929\u7A7A\u8B8A\u6697\u7684\u73FE\u8C61\u5427\uFF1F\\c\\n\u91CD\u73FE\u662F\u4EC0\u9EBC\u610F\u601D\uFF1F\\n\u518D\u8AAA\uFF0C\u6211\u5011\u662F\u5728\u54EA\u88E1\u807D\u5230\u95C7\u591C\u7684\u4E8B\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6A5F\u64CE\u5E02"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u82F1\u96C4\u96D5\u50CF"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6A5F\u64CE\u5E02\u7684\u82F1\u96C4\u96D5\u50CF\uFF01\\n\u7D22\u59AE\u4E9E\u597D\u50CF\u6709\u8AAA\u904E\u9019\u9EBC\u4E00\u56DE\u4E8B\u3002\\c\\n\u5176\u5BE6\u82F1\u96C4\u662F\u6709\u5169\u500B\u4EBA\uFF0C\\n\u4ED6\u5011\u548C\u88AB\u7A31\u70BA\u528D\u8207\u76FE\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E00\u8D77\u5E73\u606F\u4E86\u95C7\u591C\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u5011\u53BB\u627E\u90A3\uFF12\u96BB\\n\u61C9\u8A72\u6B63\u5728\u6C89\u7761\u7684\u5BF6\u53EF\u5922\u5427\uFF01\\c\\n[VAR 0100(0000)]\uFF0C\\n\u6211\u5011\u8A72\u53BB\u54EA\u5152\u5462\uFF1F[VAR 0114(0005)]"
  },
  {
