    "text": "\u82B1\u5152\u2026\u2026\u82B1\u5152\u2026\u2026\\n\u539F\u4F86\u554A\u2026\u2026\u539F\u4F86\u5982\u6B64\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6715\u4EE5\u70BA\u4EBA\u985E\u4E4B\u6240\u4EE5\\n\u4E0D\u518D\u737B\u727D\u7D46\u97C1\u7E69\u7D66\u6715\uFF0C\\c\\n\u662F\u56E0\u70BA\u4ED6\u5011\u5FD8\u8A18\u4E86\u5C0D\u6715\u7684\u4FE1\u4EF0\u3002\\n\u60F3\u4E0D\u5230\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u539F\u4F86\u662F\u56E0\u70BA\u6715\\n\u7121\u6CD5\u4F9B\u61C9\u88FD\u4F5C\u97C1\u7E69\u7684\u6750\u6599\u554A\u3002[VAR 0114(0079)]"
