  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4EC0\u9EBC\uFF1F\u88FD\u4F5C\u727D\u7D46\u97C1\u7E69\u9700\u8981\u6709\\n\u6C90\u6D74\u4E86\u6715\u7684\u529B\u91CF\u800C\u7DBB\u653E\u7684\u5149\u8F1D\u4E4B\u82B1\uFF0C\\r\\n\u4EE5\u53CA\u6715\u7684\u611B\u99AC\u7684\u9B03\u6BDB\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 7,
