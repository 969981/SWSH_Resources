  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u2026\u2026\\n\u6240\u4EE5\uFF0C\u53EA\u8981\u8B93\u6D1B\u6258\u59C6\u81EA\u884C\u8ECA\\r\\n\u80FD\u9A0E\u5728\u6C34\u4E0A\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9019\u4F4D\u9053\u9928\u6311\u6230\u8005\uFF01\\n\u9019\u6B21[VAR 1100(00FF,0101)]\u4F60\u59B3\u53C8\u4F86\u5F97\u6B63\u662F\u6642\u5019\u4E86\uFF01\\c\\n\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u5012\u4ED6\u5011\u3002\\n\u5C31\u7576\u4F5C\u662F\u56DE\u5831\u6211\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u81EA\u884C\u8ECA\u5427\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u5011\u8981\u4FDD\u8B77\u66B4\u566C\u9F9C\uFF01\\n\u6240\u4EE5\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u653E\u68C4\u9053\u9928\u6311\u6230\u5504\uFF01\\c\\n\u4E0D\u7136\u600E\u6A23\uFF1F\\n\u8981\u548C\u6211\u5011\u4F86\u5834\u5BF6\u53EF\u5922\u5C0D\u6230\u55CE\uFF1F[VAR 0114(0043)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u90A3\uFF5E\u5C31\u6EFE\u4E00\u908A\u53BB\u5427\u3002\\n\u6211\u5011\u8981\u7E7C\u7E8C\u5E6B\u66B4\u566C\u9F9C\u52A0\u6CB9\u5436\u558A\u3002[VAR 0114(0043)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u70BA\u4E86\u5E6B\u66B4\u566C\u9F9C\u52A0\u6CB9\u5436\u558A\uFF0C\\n\u6211\u5011\u8981\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u8F38\u5F97\u843D\u8352\u800C\u9003\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u53CD\u6B63\u5230\u4E86\u5C16\u91D8\u93AE\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u6C92\u8FA6\u6CD5\u9032\u884C\u9053\u9928\u6311\u6230\u5436\u3002\\r\\n\u4E7E\u8106\u5C31\u653E\u68C4\u4E86\u5504\uFF1F[VAR 0114(0044)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5443\uFF01\u518D\u9019\u6A23\u4E0B\u53BB\u2026\u2026\uFF01\\n\u6703\u88AB[VAR 1100(00FF,0101)]\u4ED6\u5979\u9A0E\u4E0A\u66B4\u566C\u9F9C\u5436\u2026\u2026[VAR 0114(0043)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u6709\u500B\u597D\u4E3B\u610F\uFF01\\n\u6211\u5011\u6436\u5148\u9A0E\u4E0A\u66B4\u566C\u9F9C\u5504\uFF01[VAR 0114(0044)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\u8036\uFF01\u52A0\u6CB9\u554A\uFF01\u66B4\u566C\u9F9C\uFF01\\n\u518D\u898B\u5436\uFF01\u9053\u9928\u6311\u6230\u8005\uFF01[VAR 0114(0043)]"
