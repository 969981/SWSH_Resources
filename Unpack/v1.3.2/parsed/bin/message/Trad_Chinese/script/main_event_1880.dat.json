[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9053\u3001\u9053\u9928\u6311\u6230\u8005\uFF01\\n\u5FEB\u3001\u5FEB\u5E6B\u6211\uFF01\\r\\n\u4E0D\uFF0C\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E6B\u5E6B\u6211\u5427\uFF01\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u7684\u5BF6\u53EF\u5922\\n\u83AB\u540D\u5176\u5999\u5C31\u6975\u5DE8\u5316\u4E86\uFF01\\r\\n\u800C\u4E14\u9084\u5927\u9B27\u7AF6\u6280\u5834\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6975\u5DE8\u5316\u4E4B\u5F8C\u5728\u7AF6\u6280\u5834\\n\u5927\u9B27\u7684\u5BF6\u53EF\u5922\u2026\u2026\\c\\n\u5DF2\u7D93\u88AB\u5947\u5DF4\u7D0D\u2026\u2026\u4E0D\uFF0C\\n\u5947\u5DF4\u7D0D\u9928\u4E3B\u5DF2\u7D93\u5E6B\u5FD9\u5236\u4F0F\u4E86\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F46\uFF0C\u8981\u662F\u9023\u5176\u4ED6\u7684\u5BF6\u53EF\u5922\\n\u4E5F\u90FD\u6975\u5DE8\u5316\uFF0C\u4E26\u4E14\u5927\u9B27\u7684\u8A71\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6D1B\u8332\u5148\u751F\u6240\u5728\u7684\\n\u5730\u4E0B\u5DE5\u5EE0\u5C31\u6703\u57AE\u6389\u7684\uFF01\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u9019\u662F\u500B\u4EFB\u6027\u7684\u8981\u6C42\uFF0C\\n\u4F46\u8ACB\u8B93\u6211\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\\c\\n\u6C42[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FEB\u5230\u5730\u4E0B\u5DE5\u5EE0\\n\u53BB\u963B\u6B62\u6D1B\u8332\u5148\u751F\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u88AB\u6D1B\u8332\u5148\u751F\u559A\u9192\u7684\\n\u5BF6\u53EF\u5922\uFF0C\u7260\u53EB\u7121\u6975\u6C70\u90A3\u2026\u2026\\c\\n\u4F3C\u4E4E\u5C31\u662F\u7260\u8EAB\u4E0A\u91CB\u653E\u7684\u80FD\u91CF\\n\u6703\u4FC3\u4F7F\u5BF6\u53EF\u5922\u6975\u5DE8\u5316\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u518D\u9019\u6A23\u4E0B\u53BB\uFF0C\u4F3D\u52D2\u723E\u5730\u5340\u7684\\n\u6240\u6709\u5BF6\u53EF\u5922\u90FD\u6703\u6975\u5DE8\u5316\uFF0C\\r\\n\u800C\u4E14\u56DB\u8655\u5927\u9B27\u7684\uFF01\\r\\n\u8981\u662F\u771F\u7684\u767C\u751F\u9019\u7A2E\u4E8B\u2026\u2026\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u6C42[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF01\\n\u5FEB\u642D\u90A3\u908A\u7684\u96FB\u68AF\u5230\u5730\u4E0B\u53BB\uFF0C\\r\\n\u6551\u51FA\u6D1B\u8332\u5148\u751F\uFF01\\c\\n\u6211\u525B\u624D\u4E5F\u62DC\u8A17\u4E86\u51A0\u8ECD\u7684\u5F1F\u5F1F\uFF0C\\n\u4F46\u4E0D\u77E5\u9053\u7A76\u7ADF\u5982\u4F55\u4E86\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5929\u54EA\u2026\u2026\u7121\u6975\u6C70\u90A3\u7ADF\u7136\u2026\u2026\\n\u554A\u554A\uFF0C\u6D1B\u8332\u5148\u751F\u2026\u2026[VAR 0114(0007)]"
  }
]
