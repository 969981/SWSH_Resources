    "text": "[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u60F3\u8981\u8B8A\u5F37\uFF0C\u5C31\u8981\u505A\u5404\u7A2E\u5617\u8A66\uFF01\\n\u4E0D\u7136\uFF0C\u600E\u9EBC\u80FD\u8FFD\u4E0A\u5927\u54E5\u2026\u2026\\r\\n\u4E0D\uFF0C\u662F\u8D85\u8D8A\u5927\u54E5\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7E3D\u800C\u8A00\u4E4B\uFF0C\u6211\u5C31\u76F4\u8AAA\u4E86\uFF01\\n\u966A\u6211\u6253\u4E00\u5834\u5BF6\u53EF\u5922\u5C0D\u6230\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5728\u6211\u51FA\u767C\u5192\u96AA\u4E4B\u524D\u2026\u2026\\n\u770B\u8457\u96FB\u8996\u88E1\u7684\u5927\u54E5\uFF0C\\r\\n\u6211\u53EA\u662F\u89BA\u5F97\u4ED6\u597D\u5F37\u5927\uFF0C\u597D\u8000\u773C\u3002[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u73FE\u5728\uFF0C\u6211\u77E5\u9053\u4ED6\u7A76\u7ADF\u591A\u9EBC\u5F37\u5927\u2026\u2026\\n\u4E5F\u77E5\u9053\u81EA\u5DF1\u7F3A\u5C11\u7684\u662F\u4EC0\u9EBC\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F46\u662F\uFF0C\u6211\u4E5F\u662F\u6709\u5728\u8B8A\u5F37\uFF01\\n\u53EA\u662F\u901F\u5EA6\u6C92\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u90A3\u9EBC\u5FEB\u7F77\u4E86\u3002\\c\\n\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u966A\u6211\u5C0D\u6230\uFF01\\n\u6211\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u6062\u5FA9\u6D3B\u529B\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u6F38\u6F38\u77E5\u9053\u81EA\u5DF1\u7684\u5FC3\u9858\u662F\u4EC0\u9EBC\u4E86\u2026\u2026\\n\u6211\u60F3\u548C\u5927\u54E5\u5C0D\u6230\u2026\u2026\uFF01\\c\\n\u4E0D\uFF0C\u6211\u662F\u60F3\u8981\u6253\u8D0F\u7121\u6575\u7684\u51A0\u8ECD\uFF01\\n\u6211\u4E00\u5B9A\u8981\u52DD\u904E\u4ED6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u6C7A\u5B9A\u4E86\uFF01\\n\u5728\u6230\u7AF6\u93AE\u8D0F\u5F97\u9053\u9928\u5FBD\u7AE0\u5F8C\uFF0C\\r\\n\u6211\u8981\u62FC\u8DB3\u5168\u529B\uFF0C\u518D\u6B21\u5411[VAR 1100(00FF,0101)]\u4F60\u59B3\u6311\u6230\uFF01[VAR 0114(0005)]"
  }
]
