[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5C31\u7B97\u5C0D\u624B\u662F\u5E2B\u5085\uFF01\u4E5F\u6703\u88AB\\n\u6211\u5011\u7684\u5718\u968A\u5408\u4F5C\u7D66\u300C\u795E\u79D8\u5931\u8E64\u300D\u7684\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9846\u79D1\u79D1\uFF01\u8CFD\u5BF6\u5BF6\uFF0C\u4E0D\u932F\u5537\uFF5E\uFF01\\n\u8001\u982D\u5152\u6211\u8981\u706B\u529B\u5168\u958B\u5F37\u6EFE\u6EFE\u5730\u51FA\u62DB\u5695\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6368\u68C4\u8D85\u80FD\u529B\u5C6C\u6027\u7684\u611A\u8822\u4E4B\u5F92\u3002\\n\u6211\u5011\u662F\u4E0D\u6703\u8F38\u7D66\u9019\u7A2E\u968A\u4F0D\u7684\u3002[VAR 0114(0072)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u606D\u559C\u4F60\u554A\u3002\u8981\u4E0D\u662F\u6211\u96E2\u958B\uFF0C\\n\u4F60\u8C48\u80FD\u7576\u4E0A\u8D85\u80FD\u529B\u7684\u9053\u9928\u9928\u4E3B\u5462\u3002[VAR 0114(000C)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u540C\u662F\u65B0\u4E0A\u4EFB\u7684\u9053\u9928\u9928\u4E3B\uFF0C\\n\u6211\u7D55\u4E0D\u80FD\u8F38\u7D66\u4F60\u5011\u7684\u968A\u4F0D\u5436\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u540C\u6642\u9084\u662F\u5F15\u9818\u6642\u5C1A\u7684\u512A\u96C5\u6559\u4E3B\uFF0C\\n\u56E0\u6B64\u6211\u5011\u6703\u5F97\u5230\u58D3\u5012\u6027\u7684\u52DD\u5229\u3002[VAR 0114(0072)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u80FD\u5F9E\u4F60\u8EAB\u4E0A\u611F\u53D7\u5230\\n\u8207\u543E\u7B49\u76F8\u4F3C\u7684\u540D\u6D41\u6C23\u606F\u5462\u3002[VAR 0114(0069)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u4E5F\u76F8\u7576\u512A\u96C5\u5462\u3002\\n\u83AB\u975E\u662F\u4F7F\u7528\u6642\u5C1A\u540D\u4EBA\u5361\u7684\u9AD8\u624B\u2026\u2026\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5E2B\u5085\uFF01\u8981\u662F\u6211\u5011\u8AA4\u6253\u8AA4\u649E\\n\u5C31\u9019\u9EBC\u6253\u8D0F\u4E86\uFF0C\u4F60\u4E5F\u5225\u751F\u6C23\u5537\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u904B\u6C23\u4E5F\u662F\u4E00\u7A2E\u5BE6\u529B\u5537\uFF01\\n\u5118\u7BA1\u60F3\u8FA6\u6CD5\u4F86\u649E\u5012\u8001\u982D\u5152\u6211\u5427\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u554A\u54C8\uFF01\u5F7C\u7279\u5152\uFF5E\\n\u4F60\u53EF\u8981\u624B\u4E0B\u7559\u60C5\u5537\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u59B3\u7684\u6BD2\u6027\u592A\u96E3\u7E8F\u4E86\u3002\\n\u6211\u8981\u8ACB\u4F60\u5011\u65E9\u65E9\u9000\u5834\u3002[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u746A\u4FD0\u524D\u8F29\uFF5E\uFF01\\n\u6211\u4F86\u5411\u59B3\u8A0E\u6559\u8A0E\u6559\u56C9\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5C0D\u6230\u5834\u4E0A\u4E0D\u7528\u5728\u610F\u8F29\u5206\u9AD8\u4F4E\uFF01\\n\u6211\u5011\u4F7F\u51FA\u5168\u529B\u4F86\u5C0D\u6230\u5504\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u770B\u59B3\u9019\u8EAB\u82B1\u679D\u62DB\u5C55\u7684\u8863\u88F3\uFF01\\n\u9996\u5148\u5728\u6253\u626E\u4E0A\uFF0C\u6211\u5C31\u5148\u5F97\u4E00\u52DD\u4E86\u3002[VAR 0114(0068)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4F60\u8A72\u4E0D\u6703\u662F\u5728\u8AAA\u6211\u5427\uFF5E\uFF1F\\n\u7576\u5FC3\u6211\u628A\u4F60\u90A3\u982D\u9AEE\u2026\u2026\u6298\u6210\u5169\u6BB5\u5594\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9846\u79D1\u79D1\uFF01\u65E2\u7136\u5C0D\u624B\u662F\u6B50\u76AE\u76AE\uFF0C\\n\u8001\u982D\u5152\u6211\u51FA\u624B\u5C31\u4E0D\u5BA2\u6C23\u5695\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5443\u554A\uFF5E\uFF01\u5C31\u8AAA\u5225\u53EB\u6211\u6B50\u76AE\u76AE\uFF01\\n\u8001\u982D\u5B50\u4F60\u5225\u7528\u529B\u904E\u982D\u5C31\u76F4\u63A5\u6B78\u5929\u4E86\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u54E6\u8036\uFF5E\uFF01\u4E39\u5E1D\u4ED4\uFF01\\n\u5118\u7BA1\u653E\u99AC\u904E\u4F86\u5427\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u6B63\u6709\u9019\u6253\u7B97\uFF01[VAR 0100(0000)]\uFF0C\\n\u6211\u5011\u6253\u4E00\u5834\u6BEB\u4E0D\u905C\u8272\u7684\u51A0\u8ECD\u6642\u523B\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u50B3\u8AAA\u7684\u683C\u9B25\u9053\u9928\u9928\u4E3B\uFF0C\\n\u800C\u4E14\u9084\u66FE\u662F\u51A0\u8ECD\u2026\u2026\u5411\u60A8\u8A0E\u6559\u4E86\uFF01[VAR 0114(0011)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u5225\u5566\u3001\u5225\u5566\uFF0C\u5225\u9019\u9EBC\u4E00\u672C\u6B63\u7D93\uFF0C\\n\u958B\u958B\u5FC3\u5FC3\u5730\u653E\u99AC\u904E\u4F86\u5427\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u88AB\u6372\u5165\u6211\u5011\u5169\u500B\u8001\u4EBA\u5BB6\u7684\u5C0D\u6230\uFF0C\\n\u51A0\u8ECD\u4E5F\u771F\u662F\u5012\u9709\u5440\u3002[VAR 0114(0013)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u54B1\u5011\u5006\u90FD\u9084\u5E74\u8F15\u5537\uFF01\\n\u597D\u5695\uFF0C\u4F86\u5C55\u73FE\u4E00\u4E0B\u9752\u6625\u5427\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u563F\uFF0C\u6211\u554A\uFF5E\u73FE\u5728\u5DF2\u7D93\u9000\u4F11\u4E86\uFF01\\n\u4F60\u53EF\u8981\u624B\u4E0B\u7559\u60C5\u554A\uFF01\u963F\u4E39\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u7684\u72C0\u6CC1\u4E5F\u4E00\u6A23\u554A\uFF01\\n\u800C\u4E14\u653E\u6C34\u600E\u9EBC\u80FD\u6253\u8D0F\u4F60\u5462\u3002[VAR 0114(0004)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u76AE\u6B50\u5C3C\uFF01\u7576\u5FC3\u4F60\u7684\u92FC\u5C6C\u6027\u5BF6\u53EF\u5922\uFF01\\n\u6211\u5011\u6703\u7528\u71B1\u60C5\u7684\u70C8\u706B\u7194\u5316\u7260\u5011\u7684\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u5361\u856A\uFF0C\u4F60\u9084\u662F\u90A3\u9EBC\u706B\u71B1\u554A\uFF01\\n\u6211\u7684\u597D\u642D\u6A94\uFF0C\u7F69\u6211\u4E00\u4E0B\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u96D6\u8AAA\u9019\u662F\uFF12\u5C0D\uFF12\u7684\u5C0D\u6230\u2026\u2026\u4E39\u5E1D\uFF01\\n\u6211\u8981\u8B93\u4F60\u5C31\u6B64\u88AB\u6DD8\u6C70\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u4E0D\u8AD6\u662F\u4EC0\u9EBC\u5C0D\u6230\uFF0C\u6211\u90FD\u4E0D\u6703\u8F38\u7684\uFF01\\n\u5947\u5DF4\u7D0D\uFF01\u7528\u4F60\u7684\u5168\u529B\u51FA\u62DB\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF01\u60F3\u4E0D\u5230\u7ADF\u7136\u80FD\u5728\\n\u9019\u9EBC\u5927\u7684\u821E\u53F0\u4E0A\u548C\u4F60\u5C0D\u6230\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u5C31\u7B97\u5C0D\u624B\u662F\u5927\u54E5\uFF0C\u6211\u4E5F\u4E0D\u6703\u8F38\u7684\uFF01\\n[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u8457\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u4F60\u7684\u5BE6\u529B\u6709\u4E00\u9EDE\u9577\u9032\u4E86\u55CE\uFF1F\\n\u9084\u6C92\u7576\u4E0A\u535A\u58EB\u7684\u5BE6\u7FD2\u751F\uFF0C\u8D6B\u666E\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u4F60\u9084\u662F\u90A3\u9EBC\u5F46\u626D\u554A\uFF01\\n\u6211\u4F86\u6559\u4F60\u4E00\u4E9B\u65B0\u5B78\u5230\u7684\u77E5\u8B58\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u898B\u8B58\u4E00\u4E0B\u6211\u4FEE\u884C\u7684\u6210\u679C\u5427\u3002\\n\u8001\u592A\u2026\u2026\u6CE2\u666E\u83C8\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u4F60\u53C8\u812B\u53E3\u8981\u53EB\u6211\u8001\u592A\u5A46\u4E86\u662F\u5427\u3002\\n\u4F60\u90A3\u5FC3\u614B\u2026\u2026\u932F\u5F97\u96E2\u8B5C\u554A\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u4F60\u5225\u56E0\u70BA\u6211\u5011\u662F\u81EA\u5BB6\u4EBA\uFF0C\\n\u5C31\u9B06\u61C8\u4E86\u5594\uFF01\u54E5\u54E5\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6211\u7576\u7136\u4E0D\u6703\u90A3\u6A23\u3002\\n\u4F46\u9019\u771F\u662F\u6709\u9EDE\u7D81\u624B\u7D81\u8173\u7684\u5462\u3002[VAR 0114(0016)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u9047\u4E0A\u4E9E\u6D1B\u4F60\uFF0C\u6211\u771F\u662F\u5403\u5927\u8667\u4E86\u3002\\n\u4F46\u662F\u6211\u4E0D\u6253\u7B97\u8F38\u7D66\u4F60\u5011\u5594\u3002[VAR 0114(000F)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u55EF\uFF01\u5C6C\u6027\u4E0A\u5403\u8667\u7B97\u4E0D\u4E86\u4EC0\u9EBC\uFF0C\\n\u6211\u77E5\u9053\u9732\u7483\u5A1C\u59B3\u4E0D\u6703\u56E0\u6B64\u5C31\u6D29\u6C23\u7684\u3002[VAR 0114(000E)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u6211\u5F97\u52A0\u628A\u52C1\uFF0C\\n\u4EE5\u514D\u88AB\u5361\u856A\u4F60\u7D66\u71D2\u5F97\u7CBE\u5149\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u4F60\u7167\u9867\u7684\u82B1\u82B1\u8349\u8349\\n\u6C92\u6709\u90A3\u9EBC\u5F31\u4E0D\u7981\u706B\u5427\uFF0C\u4E9E\u6D1B\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u8076\u6893\uFF0C\u6211\u6703\u6BEB\u4E0D\u5BA2\u6C23\u5730\\n\u4F7F\u7528\u6975\u5DE8\u5316\u7684\u5594\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u500B\u982D\u5927\u4E5F\u4E0D\u4E00\u5B9A\u5C31\u80FD\u8D0F\u3002\\n\u4F60\u5225\u5728\u610F\uFF0C\u5118\u7BA1\u4F7F\u51FA\u4F86\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u6211\u4F86\u5831\u51A0\u8ECD\u76C3\u7684\u4EC7\u56C9\uFF01\\n\u4F60\u7B49\u8457\u77A7\u5427\uFF0C\u5947\u5DF4\u7D0D\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u4F86\u5427\uFF01\u770B\u672C\u5927\u723A\u9019\u6B21\\n\u600E\u9EBC\u518D\u7528\u5929\u6C23\u8B93\u4F60\u624B\u5FD9\u8173\u4E82\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u5373\u4F7F\u5C6C\u6027\u4E0A\u8655\u65BC\u52A3\u52E2\uFF0C\\n\u5361\u856A\u4F60\u4E5F\u6703\u8B93\u60C5\u52E2\u5927\u9006\u8F49\u7684\u5427\uFF1F[VAR 0114(000F)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u5E0C\u671B\u6211\u4E0D\u6703\u8F9C\u8CA0\u9732\u7483\u5A1C\u59B3\u7684\u671F\u5F85\u3002\\n\u597D\uFF0C\u6211\u8981\u706B\u529B\u5168\u958B\u4E86\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u4E0D\u8AD6\u662F\u8F38\u662F\u8D0F\u2026\u2026[VAR 0114(000F)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u6211\u5011\u8AB0\u4E5F\u4E0D\u6028\u8AB0\uFF01[VAR 0114(0011)]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u548C\u9732\u7483\u5A1C\u59B3\u5C0D\u6230\u2026\u2026\\n\u6211\u8981\u89BA\u609F\u6703\u6709\u4E00\u5834\u6F2B\u9577\u7684\u786C\u6230\u56C9\uFF01[VAR 0114(0015)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u6211\u5011\u6253\u5F97\u8D8A\u662F\u96E3\u5206\u96E3\u89E3\uFF0C\\n\u5C31\u8D8A\u662F\u80FD\u8B93\u89C0\u773E\u5011\u770B\u5F97\u76E1\u8208\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u58D3\u5236\u9F8D\u5C6C\u6027\u7684\u5947\u7B56\u2026\u2026\\n\u9019\u5C31\u8B93\u6211\u4F86\u8A66\u8A66\u5427\uFF01\u5947\u5DF4\u7D0D\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u624D\u6C92\u6709\u90A3\u9EBC\u5BB9\u6613\u5462\uFF0C\u5361\u856A\uFF01\\n\u6211\u6703\u7528\u72C2\u66B4\u7684\u6230\u8853\u8B93\u4F60\u4E00\u7C4C\u83AB\u5C55\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\u8076\u6893\uFF01\u7528\u4F60\u7684\u60E1\u5C6C\u6027\u62DB\u5F0F\\n\u4F86\u5C01\u4F4F\u672C\u5927\u723A\u770B\u770B\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u65E2\u7136\u4F60\u9EDE\u4E86\u9019\u9996\u6557\u6230\u4E4B\u6B4C\uFF0C\\n\u4E8B\u5F8C\u53EF\u5C31\u5225\u5F8C\u6094\u5594\u3002[VAR 0114(0016)]"
  },
  {
    "index": 56,
