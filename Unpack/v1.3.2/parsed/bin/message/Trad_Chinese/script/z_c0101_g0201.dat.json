[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u8005\uFF01\\c\\n\u60F3\u6311\u6230\u5361\u856A\u7684\u8A71\uFF0C\\n\u5F97\u5148\u62FF\u5230\u8349\u8DEF\u93AE\u7684\u8349\u4E4B\u5FBD\u7AE0\uFF0C\\r\\n\u4EE5\u53CA\u6C34\u821F\u93AE\u7684\u6C34\u4E4B\u5FBD\u7AE0\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54E6\uFF01\u9053\u9928\u6311\u6230\u8005\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\uFF12\u500B\u9053\u9928\u5FBD\u7AE0\u554A\uFF0C\u771F\u662F\u512A\u79C0\uFF01\\c\\n\u5361\u856A\u4ED6\u4F3C\u4E4E\u6B63\u5728\u7B2C\u4E8C\u7926\u5C71\u7279\u8A13\u5594\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u54CE\u5440\u2026\u2026\u4ECA\u5929\u6642\u9593\u5DF2\u7D93\u665A\u4E86\uFF0C\\n\u8ACB\u660E\u5929\u518D\u4F86\u5427\u3002\\c\\n\u53EA\u8981\u662F\u9053\u9928\u6311\u6230\u8005\uFF0C\\n\u90FD\u53EF\u4EE5\u4F4F\u5728\u542B\u7F9E\u82DE\u65C5\u5E97\u5594\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u5011\u540C\u70BA\u9053\u9928\u6311\u6230\u8005\uFF0C\\n\u5C31\u4F7F\u51FA\u5168\u529B\u597D\u597D\u8868\u73FE\u5427\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9996\u5148\u662F\u8349\u8DEF\u93AE\uFF01\\n\u5F80\uFF13\u865F\u9053\u8DEF\u524D\u9032\u5427\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u4E0D\u5BB9\u6613\u52AA\u529B\u5230\u9019\u88E1\u2026\u2026\\n\u6211\u537B\u7A81\u7136\u6C92\u6709\u81EA\u4FE1\u80FD\u8D0F\u4E86\u3002\\r\\n\u5509\u2026\u2026\u8A72\u600E\u9EBC\u8FA6\u624D\u597D\u5462\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u80FD\u90A3\u9EBC\u62FC\u547D\uFF0C\\n\u771F\u7684\u5F88\u4E86\u4E0D\u8D77\u5462\u2026\u2026\\c\\n\u770B\u4E86[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u6BD4\u8CFD\u4EE5\u5F8C\uFF0C\\n\u7E3D\u89BA\u5F97\u6211\u4E5F\u53D7\u5230\u4E86\u9F13\u52F5\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u7684\u5BB6\u4EBA\u90FD\u6703\u5B88\u5728\u96FB\u8996\u524D\u2026\u2026\\n\u770B\u9053\u9928\u6311\u6230\u7684\u958B\u5E55\u5178\u79AE\u2026\u2026\\c\\n\u6211\u9084\u662F\u518D\u7167\u4E00\u6B21\u93E1\u5B50\uFF0C\\n\u770B\u770B\u9AEE\u578B\u5920\u4E0D\u5920\u5E25\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u807D\u4E86\u6D1B\u8332\u6703\u9577\u7684\u81F4\u8A5E\u2026\u2026\\n\u6211\u7A81\u7136\u89BA\u5F97\u5145\u6EFF\u5E79\u52C1\u4E86\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8349\u4E4B\u5FBD\u7AE0\u2026\u2026\u6C34\u4E4B\u5FBD\u7AE0\u2026\u2026\\n\u63A5\u4E0B\u4F86\u6211\u9084\u80FD\u62FF\u5230\u706B\u4E4B\u5FBD\u7AE0\u55CE\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u6557\u4E86\u5361\u856A\uFF01\uFF1F\\n\u9084\u771F\u662F\u500B\u53B2\u5BB3\u7684\u8A13\u7DF4\u5BB6\u554A\u3002\\c\\n\u8AAA\u4E0D\u5B9A\u6703\u6709\u5176\u4ED6\u7684\u9053\u9928\u6311\u6230\u8005\\n\u4F86\u627E[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u8F03\u9AD8\u4E0B\u5462\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u807D\u8AAA\u9019\u6B21\u5927\u8CFD\u7684\u9053\u9928\u6311\u6230\u8005\uFF0C\\n\u6709\u4E9B\u4EBA\u662F\u53D7\u5230\u6703\u9577\\r\\n\u6216\u662F\u51A0\u8ECD\u7684\u63A8\u85A6\u800C\u4F86\u7684\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u96C6\u6EFF\uFF18\u500B\u9053\u9928\u5FBD\u7AE0\u2026\u2026\\n\u611F\u89BA\u5C31\u50CF\u6536\u96C6\u5BF6\u7269\u4E00\u6A23\u5462\uFF01\\c\\n\u4E0D\u66C9\u5F97\u548C\u9053\u9928\u9928\u4E3B\u7684\u6BD4\u8CFD\uFF0C\\n\u6703\u662F\u4EC0\u9EBC\u6A23\u7684\u611F\u89BA\uFF1F"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E39\u5E1D\u63A8\u85A6\u7684\u9053\u9928\u6311\u6230\u8005\\n\u5C31\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\u3002\\r\\n\u7ADF\u7136\u6709\u52C7\u6C23\u6311\u6230\u5361\u856A\uFF0C\u679C\u7136\u6709\u81BD\u8B58\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F\u4E39\u5E1D\u3002\\c\\n\u771F\u662F\u6167\u773C\u8B58\u82F1\u96C4\uFF0C\\n\u63A8\u85A6\u4E86[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u9EBC\u512A\u79C0\u7684\u8A13\u7DF4\u5BB6\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u7CBE\u9748\u7403\u88E1\u7684\u5BF6\u53EF\u5922\u5011\uFF0C\\n\u500B\u500B\u90FD\u5E79\u52C1\u5341\u8DB3\u7684\uFF01\\c\\n\u4F46\u5728\u958B\u5E55\u5178\u79AE\u4E4B\u524D\u6211\u5C31\u7DCA\u5F35\u6210\\n\u9019\u526F\u5FB7\u884C\uFF0C\u771F\u662F\u592A\u6C92\u7528\u4E86\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u7D42\u65BC\u8E0F\u9032\u4E86\u4E00\u76F4\u4EE5\u4F86\u61A7\u61AC\u7684\u7AF6\u6280\u5834\u2026\u2026\\n\u63A5\u4E0B\u4F86\u6211\u8981\u7AD9\u4E0A\u5C0D\u6230\u5834\uFF01\\c\\n\u4E0D\uFF0C\u6211\u8981\u62FF\u4E0B\u52DD\u5229\uFF0C\\n\u8B93\u89C0\u773E\u5011\u90FD\u70BA\u6211\u6B61\u547C\u6CB8\u9A30\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u96D6\u7136\u6709\u9019\u9EBC\u591A\u53C3\u8CFD\u8005\uFF0C\\n\u4F46\u80FD\u7372\u52DD\u7559\u5230\u6700\u5F8C\u7684\u537B\u662F\u5C11\u4E4B\u53C8\u5C11\u2026\u2026"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u898B\u5230\u51A0\u8ECD\u672C\u4EBA\u5C31\u6EFF\u8DB3\u4E86\u2026\u2026\\n\u4E0D\uFF0C\u6253\u5012\u51A0\u8ECD\u624D\u662F\u6211\u771F\u6B63\u7684\u76EE\u6A19\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u7D42\u65BC\u8981\\n\u6B63\u5F0F\u958B\u5E55\u4E86\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u597D\uFF01\u53BB\uFF13\u865F\u9053\u8DEF\\n\u597D\u597D\u935B\u934A\u4E00\u4E0B\u5BF6\u53EF\u5922\u5427\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u8981\u6E96\u5099\u53BB\u6311\u6230\\n\u706B\u5C6C\u6027\u7684\u9053\u9928\u9928\u4E3B\u5361\u856A\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u9084\u6C92\u6709\u7D50\u675F\u5462\uFF0C\\n\u7E7C\u7E8C\u52A0\u6CB9\u5427\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5927\u5BB6\u7DCA\u5F35\u6210\u9019\u6A23\u2026\u2026\\n\u80FD\u4E00\u8DEF\u8D0F\u5230\u6700\u5F8C\u55CE\uFF1F"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u80FD\u62FF\u4E0B\u6700\u5F8C\u52DD\u5229\u7684\\n\u76F8\u4FE1\u4E00\u5B9A\u662F\u6211\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6709\u597D\u5E7E\u500B\u6311\u6230\u8005\\n\u5BE6\u5728\u5F88\u96E3\u7E8F\u554A\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u771F\u662F\u8B93\u4EBA\u51FA\u4E4E\u610F\u6599\u7684\\n\u9053\u9928\u6311\u6230\u8005\u554A\uFF5E"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u54FC\uFF5E\u9019\u4E9B\u90FD\u662F\u6311\u6230\u8005\u554A\uFF5E"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6BCF\u500B\u4EBA\u90FD\u662F\u9019\u5834\\n\u751F\u5B58\u6230\u7684\u5C0D\u624B\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u55DA\u5566\u5566\u266A"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u975E\u5E38\u62B1\u6B49\u3002\\c\\n\u5F9E\u9019\u88E1\u958B\u59CB\u7684\u5340\u57DF\u53EA\u6709\u6311\u6230\\n\u9053\u9928\u4EFB\u52D9\u7684\u9078\u624B\u53EF\u4EE5\u9032\u5165\u3002"
