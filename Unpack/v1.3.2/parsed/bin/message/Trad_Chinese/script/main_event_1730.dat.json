    "index": 0,
    "flags": 0,
    "text": "\u6C7A\u8CFD\u7D42\u65BC\u9032\u5165\u6700\u5F8C\u56DE\u5408\u5566\uFF01\\c\\n\u7121\u6575\u7684\u51A0\u8ECD\uFF0C\u4E39\u5E1D\uFF0C\\n\u4ED6\u5C07\u9762\u5C0D\u7684\u6311\u6230\u8005\u7A76\u7ADF\u6703\u662F\u2026\u2026[VAR 0114(0018)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9583\u8000\u7684\u8D85\u7D1A\u65B0\u661F\\n[VAR 0100(0000)]\u9078\u624B\u5462\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u9084\u662F\u51A0\u8ECD\u4E39\u5E1D\u516C\u8A8D\u7684\u52C1\u6575\u2026\u2026\\n\u99AD\u9F8D\u81F3\u5C0A\u2015\u2015\u5947\u5DF4\u7D0D\u5462\uFF01\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u80FD\u5920\u4E00\u8DEF\u6649\u7D1A\u5230\u9019\u88E1\u4F86\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u4E86\u4E0D\u8D77\uFF01\\c\\n\u4E0D\u6127\u662F\u51A0\u8ECD\u4E39\u5E1D\u63A8\u85A6\u7684\\n\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u70BA\u4E86\u8D85\u8D8A\u6211\u7684\u52C1\u6575\u4E39\u5E1D\uFF0C\\n\u6211\u8981\u6230\u52DD\u4ED6\u6311\u9078\u7684\u8A13\u7DF4\u5BB6\uFF01\\c\\n\u6211\u5DF2\u7D93\u91DD\u5C0D\uFF11\uFF56\uFF53\uFF11\u7684\u5C0D\u6230\uFF0C\\n\u7279\u5225\u8A13\u7DF4\u4E86\u6211\u7684\u968A\u4F0D\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u624B\u4E0B\u6557\u5C07\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5927\u6982\u6703\u89BA\u5F97\u6211\u5728\u778E\u63B0\u3002\\c\\n\u4F46\u9053\u9928\u6311\u6230\u6642\u7684\u6211\u53EF\u6C92\u6709\u51FA\u76E1\u5BE6\u529B\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u5225\u5C0F\u770B\u672C\u5927\u723A\u554A\u3002[VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7372\u52DD\u7684\u662F[VAR 0100(0000)]\u9078\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u672C\u5927\u723A\u2026\u2026\uFF01\\n\u9084\u6709\u672C\u5927\u723A\u5FC3\u611B\u7684\u5BF6\u53EF\u5922\u5011\u2026\u2026\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u9032\u6B65\u5F97\u6BD4\u6211\u5011\u9084\u8981\u795E\u901F\uFF0C\\r\\n\u7DF4\u51FA\u9019\u9EBC\u96E3\u4EE5\u7F6E\u4FE1\u7684\u5BE6\u529B\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u96D6\u8AAA\u672C\u5927\u723A\u4E5F\u9084\u5E74\u8F15\uFF0C\\n\u4F46\u5C0D\u65BC\u4F60\u5011\u9019\u6279\u5C0F\u9B3C\u982D\u7684\u6210\u9577\uFF0C\\r\\n\u771F\u662F\u53EA\u6709\u9A5A\u8A1D\u7684\u4EFD\u554A\uFF01\u672A\u4F86\u6709\u5F97\u77A7\u56C9\u3002[VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4FDD\u6301\u9019\u500B\u885D\u52C1\uFF0C\\n\u628A\u4E39\u5E1D\u6253\u500B\u843D\u82B1\u6D41\u6C34\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8000\u773C\u7684\u80CC\u865F[VAR 01C4(0001)]\uFF01\\n\u6649\u7D1A\u7684\u662F[VAR 0100(0000)]\u9078\u624B\uFF01\\c\\n\u5F97\u5230\u51A0\u8ECD\u63A8\u85A6\u7684\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\u2026\u2026\\c\\n\u5373\u5C07\u6311\u6230\u63A8\u85A6\u4E86\u81EA\u5DF1\u7684\u51A0\u8ECD\uFF01\uFF01[VAR 0114(0018)]"
  }
