  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u9019\u88E1\u771F\u662F\u500B\u5927\u57CE\u5E02\uFF01\\c\\n\u6211\u5F97\u5E38\u5E38\u770B\u57CE\u93AE\u5730\u5716\u624D\u884C\uFF0C\\n\u4E0D\u7136\u4E00\u5B9A\u6703\u8FF7\u8DEF\u554A\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u5728\u4F3D\u52D2\u723E\u9019\u500B\u5730\u65B9\uFF0C\\n\u51A0\u8ECD\u5C31\u50CF\u662F\u82F1\u96C4\u4E00\u822C\u7684\u5B58\u5728\u3002\\r\\n\u6240\u6709\u4EBA\u90FD\u6CE8\u76EE\u8457\u4ED6\u7684\u4E00\u8209\u4E00\u52D5\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6295\u51FA\u7CBE\u9748\u7403\uFF01\\c\\n\u4E0D\u65B7\u53CD\u8986\u7DF4\u7FD2\uFF0C\\n\u78BA\u7ACB\u8D77\u81EA\u5DF1\u7684\u6295\u6CD5\u5427\uFF01"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u4E39\u5E1D\u6295\u51FA\u7CBE\u9748\u7403\u7684\u6642\u5019\\n\u6C23\u52E2\u975E\u5E38\u9A5A\u4EBA\uFF0C\\r\\n\u611F\u89BA\u88E1\u982D\u7684\u5BF6\u53EF\u5922\u90FD\u8981\u982D\u660F\u773C\u82B1\u4E86\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u557E\u5695\u557E\u5695\uFF5E"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "[~ 31]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u6709\u80FD\u8B93\u751C\u821E\u59AE\u81EA\u5728\u653E\u9B06\u7684\\n\u7A7A\u9593\u771F\u662F\u592A\u68D2\u4E86\u3002\\c\\n\u9023\u6211\u81EA\u5DF1\u90FD\u5FCD\u4E0D\u4F4F\\n\u60F3\u6F64\u6F64\u5589\u56A8\u4E86\u5462\u3002"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6211\u90FD\u7528\u5BF6\u53EF\u5922\u7684\u62DB\u5F0F\u300C\u751F\u9577\u300D\u4F86\u990A\u82B1\uFF0C\\n\u6240\u4EE5\u6BCF\u6735\u82B1\u90FD\u662F\u91CD\u91CF\u7D1A\u7684\u5462\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u4E0D\u8AD6\u662F\u4E0D\u662F\u7279\u5225\u7684\u65E5\u5B50\uFF0C\\n\u6211\u6BCF\u5929\u90FD\u6703\u8CB7\u82B1\u56DE\u5BB6\u3002\\c\\n\u56E0\u70BA\u6211\u5BB6\u7684\u5BF6\u53EF\u5922\u5F88\u559C\u6B61\u82B1\u9999\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u6211\u6700\u559C\u6B61\u82B1\u5BF6\u53EF\u5922\u4E86\u3002"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u771F\u662F\u4E0D\u8F15\u9B06\uFF01\\c\\n\u4E00\u4E0B\u5B50\u8B8A\u5C0F\u8DD1\u9032\u7CBE\u9748\u7403\u88E1\uFF0C\\n\u4E00\u4E0B\u5B50\u53C8\u6975\u5DE8\u5316\u8B8A\u6210\u5DE8\u7121\u9738\u3002"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u2026\u2026\u5495\u547C\u5495\u547C\u5495\u547C\uFF01"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6CE1\u6CAB\u6817\u9F20\u5F88\u611B\u4E7E\u6DE8\uFF0C\\n\u6703\u7528\u5C3E\u5DF4\u628A\u7070\u5875\u90FD\u6383\u5149\u5149\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "[VAR 1100(00FF,0101)]\u4F60\u59B3\u6B63\u5728\u52AA\u529B\u586B\u6EFF\u5BF6\u53EF\u5922\u5716\u9451\u55CE\uFF1F\\c\\n\u53BB\u66E0\u91CE\u5730\u5E36\u7684\u8A71\uFF0C\\n\u5C31\u80FD\u9047\u5230\u8A31\u591A\u4E0D\u540C\u7684\u5BF6\u53EF\u5922\u5594\u3002"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u6211\u9084\u662F\u89BA\u5F97\u5BE6\u969B\u78BA\u8A8D\u5546\u54C1\u5F8C\u518D\u8CB7\uFF0C\\n\u6BD4\u8F03\u8B93\u4EBA\u653E\u5FC3\u3002\\c\\n\u4E0D\u904E\u6211\u4E5F\u559C\u6B61\u7531\u5BF6\u53EF\u5922\u5E6B\u5FD9\u9001\u8CA8\\n\u904E\u4F86\u7684\u7DB2\u8DEF\u8CFC\u7269\u3002"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u5F9E\u8CB7\u6771\u897F\u53EF\u4EE5\u770B\u51FA\u4E00\u500B\u4EBA\u7684\u6027\u683C\u3002\\c\\n\u6211\u5148\u751F\u5C31\u662F\u500B\\n\u4E0D\u591A\u60F3\u5C31\u8CB7\u7684\u885D\u52D5\u985E\u578B\u3002"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u5495\u5495\u54BF\u54C7\uFF01"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u5DE8\u5927\u7684\u5927\u5CA9\u86C7\u7D93\u904E\\n\u6975\u5DE8\u5316\u4E4B\u5F8C\u53C8\u8B8A\u5F97\u66F4\u9F90\u5927\u4E86\uFF01"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u6211\u5343\u91CC\u8FE2\u8FE2\u5730\u5F9E\u963F\u7F85\u62C9\u4F86\u5230\u9019\u88E1\uFF0C\\n\u5C31\u662F\u70BA\u4E86\u89C0\u8CDE\u9053\u9928\u6311\u6230\uFF01"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u5982\u679C\u8981\u9078\u81EA\u5DF1\u7684\u80CC\u865F\uFF0C\\n\u8A72\u9078\u5E7E\u865F\u597D\u5462\uFF1F\u771F\u82E6\u60F1\u554A\u3002"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u5982\u679C\u80FD\u548C\u559C\u6B61\u7684\u9053\u9928\u9928\u4E3B\u7A7F\u4E0A\\n\u4E00\u6A23\u7684\u7AF6\u6280\u670D\uFF0C\u4E00\u5B9A\u6703\u5F88\u8208\u596E\u3002"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u6709\u4E9B\u6B4C\u66F2\u96D6\u7136\u5DF2\u7D93\\n\u6C92\u8FA6\u6CD5\u807D\u5230\u6B4C\u624B\u89AA\u81EA\u6F14\u5531\u2026\u2026\\r\\n\u4F46\u9084\u662F\u80FD\u7528\u5531\u7247\u4F86\u56DE\u5473\u3002"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u6D1B\u8332\u5148\u751F\u6DF1\u611B\u8457\u4F3D\u52D2\u723E\u3002\\n\u4ED6\u9664\u4E86\u52AA\u529B\u767C\u5C55\u80FD\u6E90\u4E8B\u696D\uFF0C\\r\\n\u9084\u63A8\u52D5\u9053\u9928\u6311\u6230\u8B93\u9019\u500B\u5730\u65B9\u66F4\u71B1\u9B27\u3002"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u84B8\u6C7D\u771F\u7684\u597D\uFF5E\u53B2\u5BB3\uFF01\\n\u80FD\u8B93\u5DE8\u5927\u7684\u5347\u964D\u6A5F\u52D5\u8D77\u4F86\uFF01"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u50CF\u98DB\u6A5F\u90A3\u6A23\u7684\u5927\u9435\u584A\\n\u52D5\u8D77\u4F86\u771F\u662F\u592A\u53EF\u6015\u4E86\u3002\\r\\n\u4F46\u5982\u679C\u662F\u5BF6\u53EF\u5922\u5C31\u9084\u597D\u3002"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u6211\u4E00\u76F4\u76EF\u8457\u9019\u4E9B\u7528\u84B8\u6C7D\u529B\u91CF\\n\u5728\u8F49\u52D5\u7684\u9F52\u8F2A\u770B\uFF01"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u6211\u7684\u6BD2\u96FB\u5B30\\n\u5BE6\u5728\u662F\u592A\u611B\u7F50\u982D\u4E86\u3002"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u4E5F\u6709\u4E9B\u5BF6\u53EF\u5922\u559C\u6B61\\n\u4E00\u6C7A\u52DD\u8CA0\uFF0C\u6BD4\u500B\u9AD8\u4E0B\u3002\\r\\n\u548C\u7260\u5011\u7684\u76F8\u8655\u4E4B\u9053\u4E5F\u662F\u5404\u6709\u4E0D\u540C\u3002"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\u548C\u79BF\u9DF9\u5A1C\u4E00\u8D77\u73A9\u662F\u5F88\u68D2\uFF0C\\n\u4F46\u5176\u5BE6\u6211\u60F3\u548C\u7260\u4E00\u8D77\u98DB\u554A\u3002"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u5657\u554A\u82B1\uFF01"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\u5575\u6B38\u5575"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\u5713\u874C\u86AA\u554A\uFF5E\\n\u6211\u5011\u8A72\u56DE\u5BB6\u5566\uFF5E"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\u4E92\u76F8\u5E6B\u52A9\u5728\u4F3D\u52D2\u723E\u662F\u5929\u7D93\u5730\u7FA9\u7684\u4E8B\uFF0C\\n\u50CF\u6253\u6383\u4E5F\u662F\u5927\u5BB6\u81EA\u9858\u5E6B\u5FD9\u7684\u5594\u3002"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\u5C31\u7B97\u53EA\u662F\u96A8\u610F\u5730\u9592\u804A\uFF0C\\n\u80FD\u807D\u5230\u5FC3\u4E0A\u4EBA\u7684\u8072\u97F3\uFF0C\\r\\n\u5C31\u662F\u81F3\u9AD8\u7121\u4E0A\u7684\u5E78\u798F\u4E86\uFF01"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\u4EBA\u53EA\u8981\u6709\u5FC3\uFF0C\\n\u4E0D\u8AD6\u4F55\u6642\u90FD\u80FD\u6539\u8B8A\u7684\u2026\u2026\\r\\n\u8001\u723A\u723A\u8AAA\u4E0D\u5B9A\u4E5F\u6703\u6709\u9A5A\u4EBA\u7684\u8868\u73FE\u3002"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\u5BF6\u53EF\u5922\u8981\u4F7F\u51FA\u62DB\u5F0F\uFF0C\\n\u9700\u8981\u6D88\u8017\uFF30\uFF30\u5594\u3002"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\u5982\u679C\u8981\u5728\u8857\u4E0A\u5C0D\u6230\uFF0C\\n\u8981\u6CE8\u610F\u4E0D\u80FD\u7D66\u5468\u570D\u9020\u6210\u9EBB\u7169\u3002"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\u6211\u3001\u5C0F\u679C\u7136\u548C\u6211\u59B9\u59B9\u6B63\u5728\u73A9\u8DF3\u683C\u5B50\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u8DF3\u683C\u5B50\u55CE\uFF1F\\r\\n\u5C31\u662F\u90A3\u500B\u7528\u8173\u8DF3\u8457\u73A9\u7684\u904A\u6232\u3002"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\u9019\u88E1\u662F\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u73A9\u7684\u5730\u65B9\uFF01"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\u679C\u3001\u679C\u679C\uFF5E"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\u5982\u679C\u63DB\u4E86\u65B0\u9AEE\u578B\uFF0C\\n\u53EA\u8981\u53BB\u5BF6\u53EF\u5922\u4E2D\u5FC3\u627E\u6D1B\u6258\u7C73\uFF0C\\r\\n\u5C31\u53EF\u4EE5\u66F4\u65B0\u806F\u76DF\u5361\u7684\u7167\u7247\u4E86\uFF01"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\u4E00\u6574\u5929\u7528\u76E1\u5168\u529B\u2026\u2026\\c\\n\u70BA\u81EA\u5DF1\u559C\u6B61\u7684\\n\u9053\u9928\u9928\u4E3B\u52A0\u6CB9\u52A9\u9663\u2026\u2026\\r\\n\u505A\u81EA\u5DF1\u559C\u6B61\u7684\u4E8B\u679C\u771F\u4E0D\u6703\u53AD\u5026\u3002"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\u5982\u679C\u8AAA\u5F37\u5927\u7684\u529B\u91CF\u662F\u5BF6\u53EF\u5922\u7684\u9B45\u529B\uFF0C\\n\u90A3\u53EF\u611B\u4E5F\u662F\u7260\u5011\u8FF7\u4EBA\u7684\u5730\u65B9\u4E4B\u4E00\u3002"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\u9053\u9928\u6311\u6230\u5C31\u662F\u4E00\u8D9F\u5192\u96AA\u4E4B\u65C5\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u9020\u8A2A\u5404\u5730\u554A\u3002\\c\\n\u807D\u597D\u4E86\uFF0C\u53EA\u8981[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u8E0F\u51FA\u7B2C\u4E00\u6B65\uFF0C\\n\u4E0B\u4E00\u6B65\u5C31\u4E0D\u6703\u6709\u4EC0\u9EBC\u56F0\u96E3\u7684\u3002"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\u8001\u4E00\u8F29\u7684\u7E3D\u611B\u8AAA\u4E9B\u6559\u8A13\u4EBA\u7684\u8A71\uFF0C\\n\u4F46\u5E74\u8F15\u4EBA\u5C31\u8A72\u6D3B\u5F97\u81EA\u7531\u81EA\u5728\u3002"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\u5657\u7D66\uFF5E\uFF01\uFF01"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\u6211\u5011\u7684\u79D8\u5BC6\u57FA\u5730\u600E\u9EBC\u6A23\u554A\uFF1F\\n\u597D\u60F3\u6253\u9020\u4E00\u5EA7\u65B0\u7684\u9053\u9928\u554A\u3002"
  },
  {
