    "text": "[VAR 0100(0000)]\uFF01\u770B\u6A23\u5B50\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u9053\u9928\u5FBD\u7AE0\u6536\u96C6\u5F97\u5F88\u9806\u5229\u5462\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5012\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u52C1\u6575\uFF0C\u8D6B\u666E\u2026\u2026\\n\u4ED6\u5230\u5E95\u662F\u600E\u9EBC\u4E86\uFF1F\\c\\n\u525B\u624D\u4ED6\u898B\u5230\u6211\uFF0C\u5288\u982D\u5C31\u8AAA\\n\u300C\u5927\u54E5\uFF0C\u5C0D\u4E0D\u8D77\uFF01\u300D\\r\\n\u8B93\u6211\u5687\u4E86\u4E00\u5927\u8DF3\u5462\u2026\u2026[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u90A3\u5C0F\u5B50\uFF0C\u8A72\u4E0D\u6703\u662F\u2026\u2026\\n\u6253\u8F38\u4E86\u5C0D\u6230\u6240\u4EE5\u5F88\u6CAE\u55AA\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4ED6\u8F38\u7D66\u4E86\u5F7C\u7279"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u597D\u50CF\u662F\u9019\u6A23"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8F38\u4E86\u5C31\u76E1\u60C5\u6CAE\u55AA\u5427\uFF01\\c\\n\u7136\u5F8C\u518D\u91CD\u65B0\u7AD9\u8D77\u4F86\uFF01\\n\u4ED4\u7D30\u601D\u8003\u81EA\u5DF1\u8F38\u5728\u54EA\u88E1\uFF01\\c\\n\u539F\u4F86\u5982\u6B64\uFF0C\u60F3\u4E0D\u5230\u90A3\u5C0F\u5B50\u2026\u2026\\n\u8AAA\u4E0D\u5B9A\u6703\u6210\u70BA\u4E00\u500B\u512A\u79C0\u7684\u8A13\u7DF4\u5BB6\u5462\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7E3D\u4E4B\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u4ED6\u7684\u52C1\u6575\u3002\\n\u5C31\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u591A\u7167\u9867\u90A3\u5C0F\u5B50\u56C9\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54CE\u5440\uFF0C\u6642\u9593\u5230\u4E86\uFF01\\c\\n\u8207\u6703\u9577\u898B\u9762\u53EF\u4E0D\u80FD\u9072\u5230\uFF0C\\n\u4E0D\u7136\u6703\u88AB\u90A3\u4F4D\u79D8\u66F8\u7D66\u5538\u4E00\u9813\u554A\u3002\\c\\n\u2026\u2026\u662F\u7D04\u5728\u54EA\u88E1\u898B\u9762\u5440\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5C0D\u4E86\uFF01[VAR 0100(0000)]\uFF0C\\n\u6211\u5EFA\u8B70[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u898B\u898B\u5947\u5DF4\u7D0D\u3002\\c\\n\u4ED6\u662F\u6211\u6700\u68D2\u7684\u52C1\u6575\uFF0C\\n\u540C\u6642\u4E5F\u662F\u9053\u9928\u6311\u6230\u7684\u6700\u7D42\u95DC\u5361\u3002\\c\\n\u4ED6\u73FE\u5728\u516B\u6210\u662F\u5728\\n\u5FEB\u5230\uFF16\u865F\u9053\u8DEF\u524D\u7684\u5BF6\u7269\u5EAB\u5594\uFF01[VAR 0114(0004)]"
  }
]
