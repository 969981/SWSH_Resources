  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8B9A\u5537\u8B9A\u5537\uFF01\u4F60\u5011\u7684\u611F\u60C5\u8B8A\u5F97\\n\u597D\uFF5E\u5F97\u4E0D\u5F97\u4E86\u5566\uFF01[VAR 0114(0073)]"
