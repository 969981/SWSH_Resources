    "text": "\u5834\u4E0A\u9019\u7DCA\u7E43\u7684\u7A7A\u6C23\u2026\u2026\\c\\n\u548C\u89C0\u773E\u72C2\u71B1\u7684\u6B61\u547C\u8072\uFF0C\\n\u771F\u662F\u5F37\u70C8\u7684\u5C0D\u6BD4\u554A\u2026\u2026\\r\\n\u4F46\u5169\u7A2E\u6C23\u6C1B\u90FD\u68D2\u900F\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u807D\u597D\u56C9\uFF01\u89C0\u773E\u5728\u52A0\u6CB9\u7684\u540C\u6642\uFF0C\\n\u4E5F\u6B63\u671F\u5F85\u8457\u6211\u5011\u6709\u4EBA\u88AB\u5C0D\u65B9\u6253\u6557\u3002\\r\\n\u5176\u5BE6\u4ED6\u5011\u4E5F\u662F\u4E00\u7FA4\u6B98\u9177\u7684\u4EBA\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F46\u662F\uFF0C\u7121\u61FC\u65BC\u9019\u6050\u6016\u7684\u58D3\u529B\uFF0C\\n\u5FB9\u5E95\u767C\u63EE\u51FA\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\\r\\n\u8207\u968A\u4F0D\u7684\u6240\u6709\u529B\u91CF\uFF0C\\c\\n\u6700\u5F8C\u596A\u4E0B\u52DD\u5229\u3002\\n\u9019\u611F\u89BA\u6211\u53EF\u662F\u611B\u5F97\u7121\u53EF\u81EA\u62D4\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u6700\u68D2\u7684\u5925\u4F34\u5011\u4E5F\u90FD\u5728\\n\u7CBE\u9748\u7403\u88E1\u9762\u6469\u62F3\u64E6\u638C\u4E86\uFF01\\c\\n\u8B93\u6211\u5011\u958B\u59CB\u5427\uFF01\u51A0\u8ECD\u6642\u523B\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u9019\u4F3D\u52D2\u723E\u5730\u5340\u7684\u51A0\u8ECD\u4E39\u5E1D\uFF0C\\n\u4EE5\u53CA\u6211\u7684\u5925\u4F34\u5674\u706B\u9F8D\u7260\u5011\uFF0C\\r\\n\u5C07\u6703\u767C\u63EE\u6211\u5011\u6240\u6709\u7684\u7D93\u9A57\u77E5\u8B58\u2026\u2026\\c\\n\u5FB9\u5E95\u5C07\u4F60\u5011\u6253\u6557\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 5,
