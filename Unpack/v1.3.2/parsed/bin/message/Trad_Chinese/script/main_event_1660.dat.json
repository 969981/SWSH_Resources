[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4E39\u5E1D\uFF0C\\n\u6211\u5DF2\u7D93\u8AAA\u904E\u4E0D\u4E0B\uFF11\uFF10\uFF10\u6B21\u4E86\u3002\\c\\n\u4F60\u9084\u662F\u4E0D\u4E86\u89E3\u55CE\u2026\u2026\\n\u96E3\u9053\uFF0C\u4F60\u9019\u51A0\u8ECD\u662F\u7576\u5047\u7684\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u4E0D\u662F\u4E0D\u4E86\u89E3\u60A8\u7684\u610F\u601D\u3002[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F46\u60A8\u70BA\u4E86\u8981\u99AC\u4E0A\u89E3\u6C7A\\n\uFF11\uFF10\uFF10\uFF10\u5E74\u4E4B\u5F8C\u7684\u554F\u984C\uFF0C\\r\\n\u6240\u4EE5\u5E0C\u671B\u53D6\u6D88\u660E\u5929\u7684\u6C7A\u8CFD\uFF1F\\c\\n\u9019\u6211\u5C31\u5BE6\u5728\u662F\u4E0D\u61C2\u4E86\uFF01\\n\u771F\u7684\u9700\u8981\u6025\u5728\u9019\u4E00\u5929\u55CE\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8EAB\u70BA\u51A0\u8ECD\uFF0C\\n\u6211\u6709\u8CAC\u4EFB\u8B93\u6C7A\u8CFD\u9806\u5229\u8209\u884C\uFF01\\c\\n\u4F3D\u52D2\u723E\u7684\u4EBA\u5011\u5DF2\u7D93\u671F\u5F85\u5F88\u4E45\u4E86\uFF01\\n\u6211\u81EA\u5DF1\u4E5F\u662F\u8FEB\u4E0D\u53CA\u5F85\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u4E0D\u61C2\u2026\u2026\\n\u4F60\u6839\u672C\u5C31\u4E0D\u61C2\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E39\u5E1D\uFF0C\u4F60\u770B\u770B\u773C\u524D\u9019\u7247\\n\u5BEC\u5EE3\u7684\u4F3D\u52D2\u723E\u5730\u5340\u3002\\c\\n\u518D\u904E\uFF11\uFF10\uFF10\uFF10\u5E74\uFF0C\\n\u6211\u5011\u7684\u80FD\u6E90\u5C31\u6703\u67AF\u7AED\uFF0C\\r\\n\u7121\u6CD5\u7DAD\u6301\u9019\u7247\u8000\u773C\u7684\u5149\u8F1D\u4E86\uFF01\\c\\n\u73FE\u5728\u751F\u6D3B\u5728\u4F3D\u52D2\u723E\u7684\u5927\u5BB6\uFF0C\\n\u6839\u672C\u4E0D\u6703\u6D3B\u5230\u90A3\u6642\u5019\u554A\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9019\u554F\u984C\u662F\u523B\u4E0D\u5BB9\u7DE9\uFF0C\\n\u4E00\u5929\u4E5F\u803D\u8AA4\u4E0D\u8D77\uFF01\\r\\n\u6211\u5011\u5F97\u7ACB\u5373\u884C\u52D5\uFF01\\r\\n\u9019\u662F\u70BA\u4E86\u66F4\u7F8E\u597D\u7684\u672A\u4F86\u554A\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uFF11\uFF10\uFF10\uFF10\u5E74\u4E4B\u5F8C\u2026\u2026\uFF01\uFF1F\\c\\n\u539F\u4F86\u5982\u6B64\uFF0C\u6211\u597D\u50CF\u80FD\u4E86\u89E3\\n\u6703\u9577\u60A8\u7684\u64D4\u6182\u4E86\u3002\\c\\n\u7B49\u660E\u5929\u7684\u51A0\u8ECD\u8CFD\u7D50\u675F\u4E4B\u5F8C\uFF0C\\n\u6211\u5C31\u6703\u5168\u529B\u5E6B\u52A9\u60A8\u7684\u3002[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u2026\u2026\u5927\u54E5\uFF01\\c\\n\u7B49\u4E86\u534A\u5929\u90FD\u7B49\u4E0D\u5230\u4F60\uFF0C\\n\u8B93\u6211\u64D4\u5FC3\u6B7B\u4E86\u2026\u2026\\c\\n\u5E78\u8667\u6709\u8076\u6893\u3001\u746A\u4FD0\u548C\u5436\u558A\u968A\u7684\u5E6B\u5FD9\uFF0C\\n\u6211\u5011\u624D\u80FD\u5230\u9019\u88E1\u7684\u3002[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF0C\u771F\u62B1\u6B49\u8B93\u4F60\u64D4\u5FC3\u4E86\u3002\\c\\n\u6709\u6642\u5019\uFF0C\u5927\u4EBA\u5C31\u662F\u6703\u7919\u65BC\u9762\u5B50\uFF0C\\n\u6C92\u8FA6\u6CD5\u5766\u8AA0\u5730\u8A0E\u8AD6\u4E8B\u60C5\u5537\u3002[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF0C[VAR 0100(0000)]\uFF0C\\n\u6211\u5011\u56DE\u98EF\u5E97\u53BB\u5403\u500B\u75DB\u5FEB\u5427\uFF01\\r\\n\u6709\u6211\u8CB7\u55AE\uFF01\u4F60\u5011\u76E1\u91CF\u5403\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u8332\u6703\u9577\uFF0C\\n\u8ACB\u5225\u932F\u904E\u660E\u5929\u7684\u6BD4\u8CFD\uFF01\\r\\n\u90A3\u80AF\u5B9A\u6703\u662F\u6D41\u50B3\u5343\u53E4\u7684\u5C0D\u6230\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6D41\u50B3\u5343\u53E4\u2026\u2026\\c\\n\u51A0\u8ECD\u554A\uFF0C\u4F60\u592A\u5929\u771F\u4E86\u3002\\n\u4F3D\u52D2\u723E\u7684\u6B77\u53F2\u9700\u8981\u7684\u662F\u6539\u8B8A\uFF01\\r\\n\u800C\u6539\u8B8A\u5B83\u7684\u4EBA\u5C31\u662F\u6211\uFF01[VAR 0114(0006)]"
  }
]
