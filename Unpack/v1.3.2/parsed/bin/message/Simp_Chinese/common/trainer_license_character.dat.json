    "text": "[~ 41]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u4F3D\u52D2\u5C14\u5730\u533A\\n\u5E74\u7EAA\u6700\u5927\u7684\u9053\u9986\u9986\u4E3B\u3002\\n\u7EE7\u627F\u6BCD\u4E1A\u540E\uFF0C\\n\u575A\u5B88\u9053\u9986\u9986\u4E3B\u4E4B\u4F4D\uFF17\uFF10\u5E74\u3002\\n\u4F46\u987E\u8651\u5230\u5982\u4ECA\u5E74\u4E8B\u5DF2\u9AD8\uFF0C\\n\u81EA\u5DF1\u7684\u4EF7\u503C\u89C2\u6709\u5C40\u9650\u6027\uFF0C\\n\u56E0\u6B64\u6B63\u5728\u5BFB\u89C5\u7EE7\u627F\u4EBA\u3002\\n\u867D\u7136\u5979\u89E3\u91CA\u8FC7\\n\u7528\u5927\u91CF\u5201\u94BB\u8C1C\u9898\u96BE\u4E3A\u5BF9\u624B\\n\u662F\u51FA\u4E8E\u4FE1\u5949\u201C\u65F6\u7A77\u8282\u4E43\u73B0\u201D\uFF0C\\n\u4F46\u4E5F\u6709\u4EBA\u6307\u8D23\u8BF4\\n\u5176\u5B9E\u5979\u6027\u683C\u626D\u66F2\u3002"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u867D\u5DF2\u5C06\u9053\u9986\u9986\u4E3B\u4E4B\u4F4D\\n\u5F3A\u884C\u63A8\u7ED9\u88AB\u5265\u593A\\n\u9053\u9986\u6311\u6218\u8005\u8D44\u683C\u7684\u5F7C\u7279\u9009\u624B\uFF0C\\n\u5979\u4F9D\u7136\u6BCF\u5929\u51FA\u73B0\u5728\u9053\u9986\u7ADE\u6280\u573A\uFF0C\\n\u5230\u5904\u6307\u6307\u70B9\u70B9\uFF0C\\n\u629B\u51FA\u8C1C\u9898\uFF0C\u7EC3\u4E60\u6F14\u6280\u3002\\n\u5979\u5728\u4ED6\u4EBA\u8EAB\u4E0A\u5BFB\u627E\u7684\u7C89\u8272\uFF0C\\n\u7A76\u7ADF\u662F\u6307\u4EC0\u4E48\uFF1F\\n\u5979\u66FE\u5728\u8BBF\u8C08\u4E2D\u8BF4\u9053\\n\u201C\u552F\u6709\u4E0A\u4E0B\u6C42\u7D22\uFF0C\\n\u7B54\u6848\u81EA\u7531\u5FC3\u751F\u3002\u201D\\n\u6216\u8BB8\u53EF\u4EE5\u4ECE\u4E2D\u5F97\u5230\u89E3\u7B54\u3002"
  },
