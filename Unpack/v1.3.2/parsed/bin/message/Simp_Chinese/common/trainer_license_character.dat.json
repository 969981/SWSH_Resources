    "text": "[~ 47]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u76EE\u6807\u76F4\u6307\u672A\u6765\u51A0\u519B\uFF0C\\n\u662F\u4E00\u9897\u65B0\u5347\u7684\u5E0C\u671B\u4E4B\u661F\u3002\\n\u60F3\u901A\u8FC7\u6F47\u6D12\u7684\u80DC\u5229\\n\u6539\u53D8\u4E16\u95F4\u5C06\u5CA9\u77F3\u5C5E\u6027\\n\u4E0E\u7C97\u91CE\u6302\u94A9\u7684\u504F\u89C1\u3002\\n\u4E0E\u7C89\u4E1D\u79EF\u6781\u4E92\u52A8\uFF0C\\n\u4E5F\u9887\u5F97\u89C2\u4F17\u6B22\u5FC3\u3002\\n\u4F46\u6BCF\u5F53\u8D25\u9635\uFF0C\u5C31\u4F1A\\n\u4E00\u8A00\u4E0D\u53D1\u5730\u8EB2\u8FDB\u4F11\u606F\u5BA4\uFF0C\\n\u8BA9\u91C7\u8BBF\u7684\u8BB0\u8005\u6B32\u54ED\u65E0\u6CEA\u3002\\n\u8FD9\u867D\u662F\u4ED6\u4EE4\u4EBA\u610F\u5916\u7684\u4E00\u9762\uFF0C\\n\u4F46\u5728\u5973\u6027\u7C89\u4E1D\u770B\u6765\u9887\u5177\u9B45\u529B\u3002"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u65E0\u8BBA\u4EBA\u6C14\u8FD8\u662F\u5B9E\u529B\\n\u5728\u4F3D\u52D2\u5C14\u5730\u533A\u90FD\u9996\u5C48\u4E00\u6307\u3002\\n\u5728\u739B\u74DC\u4E25\u683C\u65BD\u6559\u4E4B\u4E0B\uFF0C\\n\u9EBE\u4E0B\u8BAD\u7EC3\u5BB6\u4E3A\u6570\u4E0D\u591A\uFF0C\\n\u5973\u6027\u7C89\u4E1D\u5374\u6570\u91CF\u4E0D\u5C11\u3002\\n\u739B\u74DC\u4E5F\u4E0D\u65F6\u4E3E\u529E\\n\u7B7E\u540D\u4F1A\u53CA\u6073\u8C08\u4F1A\u7B49\u6D3B\u52A8\\n\u4EE5\u56DE\u62A5\u7C89\u4E1D\u70ED\u60C5\u3002\\n\u5728\u7C89\u4E1D\u8D5E\u52A9\u4E0B\uFF0C\\n\u5DF2\u7ECF\u63A8\u51FA\uFF13\u672C\u5199\u771F\u96C6\uFF0C\\n\u5C31\u8FDE\u5B9D\u53EF\u68A6\u8054\u76DF\u5361\u4E0A\u7684\\n\u7167\u7247\u90FD\u662F\u7ECF\u6444\u5F71\u68DA\\n\u4E13\u4E1A\u6444\u5236\u7684\u4F5C\u54C1\u3002"
  },
