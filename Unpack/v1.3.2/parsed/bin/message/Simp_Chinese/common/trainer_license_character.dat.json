    "index": 97,
    "flags": 0,
    "text": "\u8D38\u6613\u516C\u53F8\u7684\u539F\u793E\u957F\u3002\\n\u4E8E\u5F80\u6765\u4E16\u754C\u5404\u5730\u7684\u65C5\u9014\u4E2D\uFF0C\\n\u5728\u4F3D\u52D2\u5C14\u5730\u533A\u9082\u9005\u4E86\u9A6C\u58EB\u5FB7\\n\u5E76\u5BF9\u4ED6\u4E00\u89C1\u949F\u60C5\u3002\u4E4B\u540E\u95EA\u7535\u7ED3\u5A5A\u3002\\n\u5728\u6B66\u9986\u91CC\uFF0C\u4F5C\u4E3A\u5927\u5BB6\u7684\u5E08\u6BCD\uFF0C\\n\u4E0D\u4EC5\u8D1F\u8D23\u6253\u626B\u3001\u505A\u996D\u3001\u7ECF\u8425\u3001\u5BA3\u4F20\uFF0C\\n\u8FD8\u4F1A\u5475\u62A4\u5F92\u5F1F\u4EEC\u7684\u5FC3\u7406\u5065\u5EB7\u3002\\n\u6700\u65E9\u5236\u4F5C\u51FA\u6781\u5DE8\u6C64\u7684\u4EBA\u4E5F\u6B63\u662F\u5979\u3002\\n\u5F53\u521D\uFF0C\u5979\u51FA\u4E8E\u7701\u94B1\u7684\u76EE\u7684\uFF0C\\n\u62FF\u68EE\u6797\u91CC\u7684\u8611\u83C7\u4F5C\u4E3A\u716E\u6C64\u7684\u6750\u6599\uFF0C\\n\u7ED3\u679C\u5B9D\u53EF\u68A6\u559D\u4E0B\u540E\u7ADF\u53D1\u751F\u4E86\u8D85\u6781\u5DE8\u5316\u3002\\n\u5979\u6709\u4E2A\u91CE\u5FC3\uFF0C\u5C31\u662F\u5C06\u6765\\n\u628A\u6781\u5DE8\u6C64\u505A\u6210\u5373\u98DF\u98DF\u54C1\uFF0C\u8D29\u5356\u5230\u5168\u4E16\u754C\u3002\\n\u201C\u9F50\u5FC3\u534F\u529B\u201D\u662F\u5979\u7684\u5EA7\u53F3\u94ED\u3002"
  },
  {
    "index": 98,
    "flags": 0,
    "text": "\u539F\u672C\u5E76\u975E\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF0C\\n\u4F46\u5728\u4E08\u592B\u7684\u9080\u8BF7\u4E0B\\n\u5F00\u59CB\u5B9D\u53EF\u68A6\u5BF9\u6218\u540E\uFF0C\\n\u6C89\u7761\u7684\u624D\u80FD\u8FC5\u901F\u88AB\u5524\u9192\u3002\\n\u5F92\u5F1F\u4EEC\u79C1\u4E0B\u91CC\u90FD\u8BF4\uFF0C\\n\u5979\u7684\u5B9E\u529B\u5F88\u6709\u53EF\u80FD\u5DF2\u7ECF\\n\u4E0E\u73B0\u5728\u7684\u9A6C\u58EB\u5FB7\u4E0D\u76F8\u4E0A\u4E0B\u3002\\n\u7531\u4E8E\u7ECF\u5E38\u8981\u7167\u987E\u4E00\u4E9B\\n\u529B\u5927\u65E0\u7A77\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u871C\u53F6\u672C\u4EBA\u4E5F\u6210\u4E86\u4E2A\u5927\u529B\u58EB\u3002\\n\u867D\u7136\u6700\u521D\u5979\u5F88\u62B5\u89E6\\n\u81EA\u5DF1\u8EAB\u4E0A\u9010\u6E10\u589E\u957F\u7684\u808C\u8089\uFF0C\\n\u4F46\u7531\u4E8E\u589E\u808C\u80FD\u591F\u5E2E\u52A9\u4FDD\u6301\u4F53\u5F62\uFF0C\\n\u73B0\u5728\u5979\u4F3C\u4E4E\u89C9\u5F97\u8FD9\u6837\u4E5F\u633A\u4E0D\u9519\u3002"
  },
  {
    "index": 99,
    "flags": 0,
    "text": "\u51FA\u8EAB\u4E8E\u8D85\u80FD\u529B\u8005\u4E00\u65CF\u7684\u540D\u95E8\u3002\\n\u5386\u4EE3\u8D85\u80FD\u529B\u9053\u9986\u9986\u4E3B\\n\u90FD\u662F\u8D5B\u5B9D\u5229\u7684\u8840\u4EB2\u3002\\n\u4F5C\u4E3A\u8FD9\u4E9B\u4EBA\u7684\u540E\u88D4\uFF0C\\n\u8D5B\u5B9D\u5229\u4ECE\u51FA\u751F\u524D\u5C31\u6CE8\u5B9A\u4E86\\n\u8981\u8D1F\u8D23\u6311\u8D77\u8D85\u80FD\u529B\u9053\u9986\u7684\u91CD\u62C5\u3002\\n\u4ECE\u4ED6\u61C2\u4E8B\u7684\u65F6\u5019\u8D77\uFF0C\\n\u4FBF\u62E5\u6709\u4E86\u81EA\u5982\u632A\u52A8\u7269\u4F53\u7684\u80FD\u529B\uFF0C\\n\u4F46\u662F\u5374\u5E76\u6CA1\u80FD\u62E5\u6709\\n\u77AC\u95F4\u79FB\u52A8\u6216\u8BFB\u5FC3\u672F\u7B49\u5176\u4ED6\u80FD\u529B\uFF0C\\n\u56E0\u6B64\u88AB\u4EB2\u621A\u4EEC\u8D34\u4E0A\u4E86\u540E\u8FDB\u7684\u6807\u7B7E\u3002\\n\u5BF9\u4E8E\u4E0D\u7BA1\u522B\u4EBA\u600E\u4E48\u8BC4\u4EF7\\n\u90FD\u6C38\u8FDC\u6211\u884C\u6211\u7D20\u7684\u5446\u5446\u517D\uFF0C\\n\u8D5B\u5B9D\u5229\u6253\u4ECE\u5FC3\u5E95\u91CC\u611F\u5230\u5C0A\u656C\u3002"
  },
  {
    "index": 100,
    "flags": 0,
    "text": "\u81EA\u5C0A\u5FC3\u5F88\u5F3A\uFF0C\u6BCF\u5F53\u5728\u5BF9\u6218\u4E2D\u843D\u8D25\u65F6\uFF0C\\n\u90FD\u4F1A\u7528\u8D85\u80FD\u529B\u4F7F\u5BF9\u624B\u6D6E\u8D77\u6765\uFF0C\\n\u56E0\u6B64\u88AB\u514D\u53BB\u4E86\u5F53\u9053\u9986\u8BAD\u7EC3\u5BB6\u7684\u8D44\u683C\u3002\\n\u6B63\u5F53\u4ED6\u81EA\u66B4\u81EA\u5F03\u4E4B\u65F6\uFF0C\u521A\u597D\u770B\u5230\\n\u5446\u5446\u517D\u6361\u56DE\u7684\u9A6C\u5E08\u5085\u6B66\u9986\u4F20\u5355\uFF0C\\n\u4E8E\u662F\u624D\u6709\u4E86\u4F5C\u4E3A\u6B66\u9986\u5F92\u5F1F\u7684\u4ECA\u5929\u3002\\n\u6700\u5F00\u59CB\uFF0C\u5E38\u548C\u6B66\u9986\u4E2D\\n\u5176\u4ED6\u5F92\u5F1F\u8D77\u4E89\u6267\uFF0C\\n\u4F46\u5728\u5E08\u5085\u548C\u5E08\u6BCD\u7684\u6E29\u67D4\u76F8\u5F85\u4E0B\uFF0C\\n\u4E00\u70B9\u70B9\u653E\u4E0B\u6212\u5907\uFF0C\\n\u6027\u683C\u4E5F\u7A0D\u5FAE\u53D8\u5F97\u67D4\u548C\u4E86\u4E9B\u3002\\n\u6700\u8FD1\uFF0C\u4E3A\u4E86\u4E89\u53E3\u6C14\u7ED9\u67D0\u4F4D\u540E\u8F88\u770B\u770B\uFF0C\\n\u6B63\u4E0E\u5446\u58F3\u517D\u4E00\u8D77\\n\u52AA\u529B\u8FDB\u884C\u7740\u79D8\u5BC6\u7279\u8BAD\u3002"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "\u539F\u672C\u662F\u4E00\u540D\u72EC\u7ACB\u5076\u50CF\u3002\\n\u4EE5\u201C\u8D85\u53EF\u7231\u4E5F\u8D85\u6BD2\u8FA3\u201D\u4E3A\u4EBA\u8BBE\\n\u8FDB\u884C\u81EA\u6211\u5305\u88C5\u3002\\n\u5979\u5C1D\u8BD5\u8FC7\u5F00\u6F14\u5531\u4F1A\uFF0C\u529E\u6D3B\u52A8\uFF0C\\n\u8D29\u5356\u81EA\u5DF1\u5236\u4F5C\u7684\u5468\u8FB9\uFF0C\\n\u4F46\u51FA\u9053\u66F2\u300A\u88AB\u514B\u62C9\u62C9\u8FF7\u5F97\u50CF\u50BB\u74DC\u300B\\n\u53EA\u5356\u51FA\u4E86\uFF18\u5F20\uFF23\uFF24\u3002\\n\u56E0\u4E3A\u89C9\u5F97\u6210\u4E3A\u9053\u9986\u9986\u4E3B\u4EE5\u540E\\n\u81EA\u5DF1\u4F1A\u53D8\u5F97\u66F4\u53D7\u6B22\u8FCE\uFF0C\\n\u6240\u4EE5\u51B3\u5B9A\u8981\u5F53\u4E00\u540D\u9053\u9986\u8BAD\u7EC3\u5BB6\u3002\\n\u4E4B\u6240\u4EE5\u4F1A\u9009\u62E9\u6BD2\u5C5E\u6027\uFF0C\\n\u662F\u56E0\u4E3A\u611F\u89C9\u5B83\u5951\u5408\u4E86\u81EA\u5DF1\u7684\u5F62\u8C61\uFF0C\\n\u800C\u4E14\u4F3C\u4E4E\u52B2\u654C\u4F1A\u6BD4\u8F83\u5C11\uFF0C\\n\u5F53\u7B2C\u4E00\u6BD4\u8F83\u5BB9\u6613\u3002"
  },
  {
    "index": 102,
    "flags": 0,
    "text": "\u7531\u4E8E\u6BD2\u4E4B\u9053\u9986\u7684\u8BAD\u7EC3\\n\u6BD4\u9884\u60F3\u4E2D\u4E25\u9177\u592A\u591A\uFF0C\\n\u6240\u4EE5\u624D\u8FC7\uFF12\u5929\u5979\u4FBF\u53EB\u82E6\u4E0D\u8FED\u3002\\n\u6070\u5DE7\u6B64\u65F6\uFF0C\u5979\u901A\u8FC7\u6DF1\u591C\u6863\u8282\u76EE\u7684\u5E7F\u544A\\n\u5F97\u77E5\u4E86\u9A6C\u5E08\u5085\u6B66\u9986\u7684\u5B58\u5728\u3002\\n\u56E0\u4E3A\u89C9\u5F97\u5E08\u5085\u770B\u8D77\u6765\u90A3\u4E48\u6E29\u67D4\uFF0C\\n\u5728\u4ED6\u90A3\u513F\u4FEE\u884C\u80AF\u5B9A\u4E5F\u4F1A\u8212\uFF5E\u8212\u670D\u670D\u7684\uFF0C\\n\u6240\u4EE5\u7ACB\u523B\u5C31\u6253\u4E86\u7535\u8BDD\u7533\u8BF7\u5165\u95E8\u3002\\n\u5E73\u65F6\u5979\u53EA\u5728\u4E4E\u5982\u4F55\u8BA9\u4EBA\u559C\u6B22\u81EA\u5DF1\uFF0C\\n\u5BF9\u5176\u4ED6\u4E8B\u60C5\u5168\u90FD\u6BEB\u4E0D\u4E0A\u5FC3\uFF0C\\n\u56E0\u6B64\u4FEE\u884C\u4E5F\u8FDB\u884C\u5F97\u5341\u5206\u6577\u884D\u3002\\n\u4F46\u662F\u6700\u8FD1\uFF0C\u4E3A\u4E86\u4E89\u53E3\u6C14\\n\u7ED9\u67D0\u4F4D\u540E\u8F88\u770B\u770B\uFF0C\u6B63\u4E0E\u5446\u58F3\u517D\u4E00\u8D77\\n\u52AA\u529B\u8FDB\u884C\u7740\u79D8\u5BC6\u7279\u8BAD\u3002"
  },
  {
    "index": 103,
    "flags": 0,
    "text": "\u66FE\u7ECF\u662F\u94A2\u5C5E\u6027\u9053\u9986\u7684\u9053\u9986\u9986\u4E3B\u3002\\n\u7531\u4E8E\u4ED6\u7684\u5BF9\u6218\u65B9\u5F0F\u5F3A\u52B2\u6709\u529B\uFF0C\\n\u56E0\u6B64\u6BD4\u8D5B\u7ED3\u675F\u540E\u9700\u8981\u82B1\u8D39\\n\u5F88\u5927\u7684\u529B\u6C14\u6765\u7EF4\u62A4\u5BF9\u6218\u573A\u3002\\n\u6709\u201C\u94A2\u94C1\u5927\u54E5\u201D\u7231\u79F0\u7684\u4ED6\\n\u975E\u5E38\u4EB2\u6C11\uFF0C\u73B0\u5728\u4ECD\u7136\u6709\\n\u5F88\u591A\u75AF\u72C2\u7684\u7537\u6027\u7C89\u4E1D\u3002\\n\u7167\u7247\u662F\u5728\u4ED6\u53BB\u738B\u51A0\u96EA\u539F\\n\u4E4B\u524D\u52A0\u5DE5\u5408\u6210\u7684\u3002\\n\u8FD9\u5F20\u8096\u50CF\u7167\u539F\u672C\u5939\u5728\\n\u4ED6\u4EB2\u624B\u5236\u4F5C\u7684\u65C5\u884C\u6307\u5357\u4E2D\uFF0C\\n\u4F46\u662F\u7ACB\u523B\u5C31\u88AB\u5973\u513F\u6254\u6389\u4E86\u3002\\n\u7531\u4E8E\u7167\u5F97\u786E\u5B9E\u4E0D\u9519\uFF0C\\n\u56E0\u6B64\u4E5F\u7528\u5728\u4E86\u8054\u76DF\u5361\u4E0A\u3002"
  },
  {
    "index": 104,
    "flags": 0,
    "text": "\u867D\u7136\u5F88\u5C11\u5728\u6B63\u5F0F\u573A\u5408\u660E\u786E\u63D0\u53CA\uFF0C\\n\u4F46\u4ED6\u5176\u5B9E\u662F\u6D1B\u5179\u7684\u5F1F\u5F1F\u3002\\n\u7531\u4E8E\u5728\u6210\u957F\u7684\u8FC7\u7A0B\u4E2D\u4E00\u76F4\\n\u88AB\u62FF\u6765\u548C\u4F18\u79C0\u7684\u54E5\u54E5\u505A\u6BD4\u8F83\uFF0C\\n\u56E0\u6B64\u8BA9\u4ED6\u9010\u6E10\u53D8\u5F97\u6840\u9A9C\u4E0D\u9A6F\u3002\\n\u79BB\u5BB6\u51FA\u8D70\u540E\uFF0C\u4ED6\u5F97\u5230\u8D4F\u8BC6\uFF0C\\n\u5E76\u4E14\u6210\u4E3A\u4E86\u9053\u9986\u9986\u4E3B\u3002\\n\u5728\u90A3\u4E4B\u540E\u751A\u81F3\u8FD8\u5F53\u8FC7\u51A0\u519B\uFF0C\\n\u4F46\u7D27\u63A5\u7740\u6D1B\u5179\u4FBF\u5C31\u4EFB\u4F1A\u957F\u4E4B\u804C\uFF0C\\n\u800C\u8FD9\u4E5F\u4FC3\u4F7F\u4ED6\u79BB\u5F00\u4E86\u8054\u76DF\u3002\\n\u540C\u884C\u7684\u5927\u738B\u94DC\u8C61\u662F\u7531\\n\u5C0F\u65F6\u5019\u548C\u54E5\u54E5\u4E00\u8D77\u7B2C\u4E00\u6B21\\n\u6349\u5230\u7684\u94DC\u8C61\u8FDB\u5316\u800C\u6765\u3002"
  }
]
