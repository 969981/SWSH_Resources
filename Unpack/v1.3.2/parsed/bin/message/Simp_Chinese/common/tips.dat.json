  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5728\uFF39\uFF39\u901A\u8BAF\u4E2D\uFF0C\\n\u53EF\u4EE5\u4E00\u8FB9\u5192\u9669\uFF0C\\n\u4E00\u8FB9\u548C\u5176\u4ED6\u73A9\u5BB6\u8FDB\u884C\\n\u5B9D\u53EF\u68A6\u4EA4\u6362\u6216\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\\n\u4F53\u9A8C\u8FDE\u63A5\u5E26\u6765\u7684\u65E0\u7A77\u4E50\u8DA3\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8FD9\u4E00\u7269\u54C1\u53EB\u505A\u5B9E\u51B5\u8D34\u3002\\n\u5728\uFF39\uFF39\u901A\u8BAF\u4E2D\\n\u9009\u62E9\u201C\u8FDE\u63A5\u201D\u9009\u9879\uFF0C\\n\u5F00\u59CB\u8FDE\u63A5\u540E\uFF0C\u5C31\u53EF\u4EE5\\n\u5C06\u5B9E\u51B5\u8D34\u53D1\u9001\u7ED9\u5176\u4ED6\u4EBA\uFF01\\n\u5B9E\u51B5\u8D34\u8FD8\u53EF\u4EE5\u7528\u6765\u4F20\u8FBE\u6D88\u606F\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5E73\u65F6\u5728\uFF39\uFF39\u901A\u8BAF\u4E2D\uFF0C\\n\u53EF\u4EE5\u548C\u9644\u8FD1\u7684\u4EBA\u8FDB\u884C\u8FDE\u63A5\u3002\\n\u5982\u679C\u6309\u4E0B\uFF0B\u952E\u8FDE\u63A5\u5230\u4E92\u8054\u7F51\uFF0C\\n\u8FD8\u53EF\u4EE5\u548C\u5168\u4E16\u754C\u7684\u4EBA\\n\u4E00\u8D77\u4F53\u9A8C\u8FDE\u63A5\u7684\u4E50\u8DA3\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5192\u9669\u65F6\uFF0C\u5982\u679C\u4F60\u6536\u5230\u4E86\u5B9E\u51B5\u8D34\uFF0C\\n\u5C31\u8868\u793A\u6709\u53EF\u4EE5\u901A\u8FC7\u8FDE\u63A5\\n\u4E00\u8D77\u73A9\u7684\u4EBA\uFF01\\n\\n\u6309\uFF39\u952E\u5BFB\u627E\u8FDE\u63A5\u5BF9\u8C61\u5427\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u53EA\u8981\u9009\u62E9\u5370\u6709\\n\u5B9D\u53EF\u68A6\u526A\u5F71\u7684\u5B9E\u51B5\u8D34\uFF0C\\n\u5C31\u53EF\u4EE5\u548C\u670B\u53CB\u4E00\u8D77\\n\u4E0E\u5B9D\u53EF\u68A6\u8FDB\u884C\u6218\u6597\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u8054\u76DF\u5361"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u901A\u8FC7\u8054\u76DF\u5361\u6765\u5C55\u793A\\n\u81EA\u5DF1\u7684\u4E2A\u4EBA\u7B80\u4ECB\u5427\uFF01\\n\u53EA\u8981\u4F7F\u7528\u5404\u5730\u5B9D\u53EF\u68A6\u4E2D\u5FC3\u7684\\n\u5236\u5361\u5DE5\u5177\u6765\u5B9A\u5236\uFF0C\\n\u5C31\u80FD\u5C06\u4FE1\u606F\u66F4\u65B0\u5230\u6700\u65B0\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6BCF\u4E2A\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\\n\u90FD\u62E5\u6709\u81EA\u5DF1\u7684\u8054\u76DF\u5361\uFF0C\\n\u53EF\u4EE5\u901A\u8FC7\u8FDE\u63A5\u8FDB\u884C\u4EA4\u6362\u3002\\n\u5728\uFF38\u952E\u83DC\u5355\u7684\u8054\u76DF\u5361\u4E2D\\n\u9009\u62E9\u8054\u76DF\u5361\u518C\uFF0C\\n\u5C31\u80FD\u67E5\u770B\u6536\u96C6\u5230\u7684\u8054\u76DF\u5361\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5728\uFF38\u952E\u83DC\u5355\u7684\u8054\u76DF\u5361\u4E2D\\n\u9009\u62E9\u8054\u76DF\u5361\u518C\uFF0C\\n\u5C31\u80FD\u67E5\u770B\u6536\u96C6\u5230\u7684\u8054\u76DF\u5361\u3002\\n\\n\u8FD8\u80FD\u67E5\u770B\u901A\u8FC7\u8FDE\u63A5\\n\u83B7\u5F97\u7684\u8054\u76DF\u5361\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5BF9\u6218\u7ADE\u6280\u573A"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5728\u5BF9\u6218\u7ADE\u6280\u573A\uFF0C\\n\u4F60\u53EF\u4EE5\u548C\u5168\u4E16\u754C\u7684\u73A9\u5BB6\\n\u8FDB\u884C\u8FDE\u63A5\u5BF9\u6218\uFF0C\\n\u4E5F\u53EF\u4EE5\u53C2\u52A0\u5404\u79CD\u5927\u8D5B\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u81EA\u7531\u5BF9\u6218\u662F\u4E00\u79CD\\n\u53EF\u4EE5\u548C\u5176\u4ED6\u73A9\u5BB6\\n\u8F7B\u677E\u5BF9\u6218\u7684\u6A21\u5F0F\u3002\\n\u8BF4\u4E0D\u5B9A\u8FD8\u80FD\u770B\u5230\\n\u51FA\u4EBA\u610F\u6599\u7684\u5B9D\u53EF\u68A6\u6216\u62DB\u5F0F\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u7EA7\u522B\u5BF9\u6218\u662F\u4E00\u79CD\\n\u901A\u8FC7\u6FC0\u70C8\u7684\u5BF9\u6218\\n\u4E89\u593A\u66F4\u9AD8\u7EA7\u522B\u7684\u6A21\u5F0F\u3002\\n\u8C61\u5F81\u5B9E\u529B\u7684\u7EA7\u522B\\n\u4F1A\u56E0\u5BF9\u6218\u7ED3\u679C\u800C\u4E0A\u4E0B\u6D6E\u52A8\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4E92\u8054\u7F51\u5927\u8D5B\u662F\u4E00\u79CD\\n\u4EE5\u79EF\u5206\u6570\u503C\u8861\u91CF\u5B9E\u529B\uFF0C\\n\u5728\u89C4\u5B9A\u671F\u95F4\u5185\u8FDB\u884C\u5BF9\u6218\uFF0C\\n\u4E89\u53D6\u66F4\u9AD8\u79EF\u5206\u7684\u6A21\u5F0F\u3002\\n\u4E0E\u5176\u4ED6\u6A21\u5F0F\u4E0D\u540C\uFF0C\\n\u9700\u8981\u81EA\u5DF1\u5BFB\u627E\u5927\u8D5B\u6765\u53C2\u52A0\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6781\u5DE8\u5316"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u5B9D\u53EF\u68A6\\n\u53EF\u4EE5\u5728\u7279\u5B9A\u7684\u533A\u57DF\u5185\u5DE8\u5927\u5316\u3002\\n\u8FD9\u5C31\u662F\u6240\u8C13\u7684\u6781\u5DE8\u5316\u3002\\n\u5F53\u6781\u5DE8\u8155\u5E26\u53D1\u51FA\u5149\u8292\u65F6\uFF0C\\n\u6309\u4E0B[VAR FF00(0006)]\u6781\u5DE8\u5316\u6309\u952E[VAR FF00(0000)]\uFF0C\\n\u5B9D\u53EF\u68A6\u5C31\u4F1A\u6781\u5DE8\u5316\u4E86\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6781\u5DE8\u5316\u7684\u6301\u7EED\u65F6\u95F4\u662F[VAR FF00(0006)]\u4E09\u56DE\u5408[VAR FF00(0000)]\uFF01\\n\\n\u5728\u6B64\u671F\u95F4\u5185\uFF0C\u6781\u5DE8\u5316\u7684\u5B9D\u53EF\u68A6\\n\u53EF\u4EE5\u4F7F\u51FA\u5A01\u529B\u5F3A\u5927\u7684\\n[VAR FF00(0006)]\u6781\u5DE8\u62DB\u5F0F[VAR FF00(0000)]\u3002\\n\u6781\u5DE8\u62DB\u5F0F\u8FD8\u80FD\u89E6\u53D1\\n\u7279\u6B8A\u7684\u6548\u679C\u3002\\n\u6548\u679C\u4F1A\u6839\u636E\u5C5E\u6027\u7684\u4E0D\u540C\u4EA7\u751F\u53D8\u5316\u3002\\n\\n\u628A\u63E1\u597D\u6781\u5DE8\u5316\u7684\u65F6\u673A\uFF0C\\n\u4E00\u4E3E\u83B7\u80DC\u5427\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u9732\u8425"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u5728\u5B9D\u53EF\u68A6\u9732\u8425\u4E2D\uFF0C\\n\u53EF\u4EE5\u548C\u5B9D\u53EF\u68A6\u4EEC\u4E00\u8D77\u73A9\u800D\u3001\\n\u54C1\u5C1D\u6599\u7406\uFF0C\u4ECE\u800C\u589E\u8FDB\u4EB2\u5BC6\u5EA6\uFF01\\n\u8981\u662F\u548C\u5B83\u4EEC\u591A\u73A9\u73A9\uFF0C\\n\u8BF4\u4E0D\u5B9A\u5BF9\u6218\u8D77\u6765\u4E5F\u4F1A\u5F88\u52AA\u529B\u54E6\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u7528Joy-Con\u624B\u67C4\u4E5F\u53EF\u4EE5\u73A9\u54E6\uFF01\\n\u5C06Joy-Con\u624B\u67C4\u53D6\u4E0B\u6447\u6643\uFF0C\\n\u53EF\u4EE5\u6295\u63B7\u7CBE\u7075\u7403\uFF0C\\n\u6216\u8005\u6325\u821E\u5B9D\u53EF\u5C3E\u8349\u54E6\uFF01\\n\u5982\u679C\u5B9D\u53EF\u5C3E\u8349\u6325\u821E\u5F97\u6070\u5F53\uFF0C\\n\u5C31\u80FD\u987A\u5229\u5730\u5438\u5F15\u5B9D\u53EF\u68A6\u7684\u6CE8\u610F\u529B\uFF01"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u5728\u65F7\u91CE\u5730\u5E26\u9732\u8425\u65F6\uFF0C\u6700\u591A\\n\u53EF\u4EE5\u4E0E\uFF14\u4F4D\u73A9\u5BB6\u4E00\u8D77\u73A9\u3002\\n\u5728\u9732\u8425\u4E2D\uFF0C\u8FD8\u53EF\u80FD\u4E0E\\n\u65B0\u7684\u73A9\u5BB6\u548C\u5B9D\u53EF\u68A6\u9082\u9005\u3002\\n\u5927\u5BB6\u4E00\u8D77\u4EB2\u5BC6\u5730\u73A9\u800D\u5427\uFF01"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6599\u7406"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u9009\u62E9\u559C\u6B22\u7684\u98DF\u6750\u548C\u6811\u679C\uFF0C\\n\u6765\u5236\u4F5C\u7F8E\u5473\u7684\u6599\u7406\u5427\uFF01\\n\\n\u5982\u679C\u9009\u62E9\u73CD\u8D35\u98DF\u6750\uFF0C\\n\u6216\u653E\u5165\u5927\u91CF\u6811\u679C\uFF0C\\n\u505A\u51FA\u7684\u6599\u7406\u4F1A\u66F4\u52A0\u7F8E\u5473\u3002"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u6599\u7406\u5F00\u59CB\u4E4B\u540E\uFF0C\\n\u7528\u56E2\u6247\u8C03\u8282\u706B\u5019\uFF0C\\n\u7528\u9505\u52FA\u4EE5\u9002\u5F53\u7684\u529B\u5EA6\\n\u5747\u5300\u6405\u62CC\u98DF\u6750\u5427\uFF01\\n\u503E\u6CE8\u771F\u7231\uFF0C\u6700\u540E\u9002\u65F6\u51FA\u9505\uFF0C\\n\u4E3A\u5B9D\u53EF\u68A6\u70F9\u5236\u7684\u6599\u7406\u5927\u529F\u544A\u6210\uFF01"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6599\u7406\u5236\u4F5C\u5B8C\u6210\u540E\uFF0C\\n\u7AEF\u4E0A\u684C\u6765\u548C\u5927\u5BB6\u4E00\u8D77\u5206\u4EAB\u5427\uFF01\\n\u53C2\u52A0\u9732\u8425\u7684\u5B9D\u53EF\u68A6\u4EEC\\n\u5403\u8FC7\u6599\u7406\u4E4B\u540E\u53EF\u4EE5\u6062\u590D\u4F53\u529B\uFF0C\\n\u8FD8\u4F1A\u548C\u4F60\u53D8\u5F97\u66F4\u4EB2\u5BC6\uFF0C\u597D\u5904\u591A\u591A\u3002"
  },
  {
    "index": 34,
