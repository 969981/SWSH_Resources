[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F3D\u52D2\u5C14\u9A6C\u8428\u62C9\u9999\u6599\u7684\u9999\u5473\\n\u6311\u9017\u7740\u55C5\u89C9\u3002\u662F\u4E00\u9053\\n\u6700\u6700\u6734\u5B9E\u7684\u57FA\u672C\u53E3\u5473\u5496\u55B1\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F3D\u52D2\u5C14\u9A6C\u8428\u62C9\u9999\u6599\u7684\u9999\u5473\\n\u5C06\u7EAF\u7CB9\u7684\u8F9B\u8FA3\u886C\u6258\u65E0\u4F59\u3002\\n\u662F\u4E00\u9053\u5FE0\u4E8E\u57FA\u672C\u53E3\u5473\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F3D\u52D2\u5C14\u9A6C\u8428\u62C9\u9999\u6599\u7684\u9999\u5473\\n\u5C06\u539A\u91CD\u7684\u6DA9\u5473\u51F8\u663E\u65E0\u4F59\u3002\\n\u662F\u4E00\u9053\u57FA\u672C\u53E3\u5473\u7684\u5496\u55B1\uFF0C\u5BB9\u6613\u5165\u53E3\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6D53\u90C1\u7684\u7518\u751C\u4ECE\u4F3D\u52D2\u5C14\u9A6C\u8428\u62C9\\n\u9999\u6599\u7684\u9999\u5473\u4E2D\u8131\u9896\u800C\u51FA\u3002\\n\u662F\u4E00\u9053\u53D7\u4E07\u4F17\u559C\u7231\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F3D\u52D2\u5C14\u9A6C\u8428\u62C9\u9999\u6599\u7684\u9999\u5473\\n\u5F3A\u70C8\u51F8\u663E\u51FA\u4E86\u5176\u4E2D\u7684\u82E6\u5473\u3002\\n\u662F\u4E00\u9053\u6734\u5B9E\u7684\u57FA\u672C\u53E3\u5473\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F3D\u52D2\u5C14\u9A6C\u8428\u62C9\u9999\u6599\u7684\u9999\u5473\\n\u5B8C\u7F8E\u4E2D\u548C\u4E86\u5496\u55B1\u72EC\u7279\u7684\u9178\u5473\u3002\\n\u7740\u5B9E\u662F\u4E00\u9053\u7B80\u5355\u7F8E\u5473\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5496\u55B1\u7B80\u5355\u6734\u5B9E\u7684\u8C03\u5473\uFF0C\\n\u66F4\u52A0\u886C\u51FA\u4E86\u6C34\u716E\u9999\u80A0\\n\u72EC\u6709\u7684\u7F8E\u5473\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8FA3\u8FA3\u7684\u5496\u55B1\u6C41\\n\u5C06\u9999\u80A0\u7684\u9C9C\u7F8E\\n\u5C55\u73B0\u5F97\u6DCB\u6F13\u5C3D\u81F4\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u82E6\u6DA9\u7684\u5496\u55B1\u6C41\\n\u7F13\u548C\u4E86\u9999\u80A0\u7684\u6CB9\u817B\u3002\\n\u662F\u4E00\u9053\u975E\u5E38\u5BB9\u6613\u5165\u53E3\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u9999\u80A0\u7684\u9C9C\u7F8E\u4E0E\\n\u5496\u55B1\u6C41\u7684\u751C\u5473\u5B8C\u7F8E\u8C03\u548C\u3002\\n\u662F\u4E00\u9053\u975E\u5E38\u7CBE\u81F4\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9999\u80A0\u7684\u53E3\u611F\u4E0E\\n\u5496\u55B1\u6C41\u7684\u82E6\u5473\u5B8C\u7F8E\u8C03\u548C\u3002\\n\u662F\u4E00\u9053\u9002\u5408\u6210\u5E74\u4EBA\u53E3\u5473\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u523A\u6FC0\u5473\u857E\u7684\u9178\u5473\u5496\u55B1\u6C41\u548C\\n\u6ECB\u5473\u6D53\u90C1\u7684\u9999\u80A0\u5DE7\u5999\u7ED3\u5408\u3002\\n\u662F\u4E00\u9053\u4EE4\u4EBA\u98DF\u6B32\u5927\u589E\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7CBE\u9009\u9971\u4F2F\u7684\u79D8\u4F20\u98DF\u6750\u5236\u6210\uFF0C\\n\u5206\u91CF\u60CA\u4EBA\u3002\u662F\u4E00\u9053\u4EE4\u4EBA\\n\u56DE\u5473\u65E0\u7A77\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5F53\u5BCC\u6709\u5C42\u6B21\u7684\u9999\u8FA3\u5496\u55B1\u6C41\uFF0C\\n\u9047\u4E0A\u53E3\u611F\u51B2\u51FB\u6027\u5341\u8DB3\u7684\u914D\u6599\uFF0C\\n\u624D\u8BDE\u751F\u51FA\u773C\u524D\u7684\u8FD9\u4E00\u9053\u5947\u8FF9\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6D53\u9187\u6DA9\u5473\u4E0E\u6CB9\u6DA6\u53E3\u611F\u7684\u5929\u4F5C\u4E4B\u5408\u3002\\n\u662F\u4E00\u9053\u8001\u5C11\u7686\u5B9C\uFF0C\\n\u4ECE\u4E0D\u8F9C\u8D1F\u671F\u5F85\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u524D\u65E0\u53E4\u4EBA\u7684\u7EDD\u5999\u7EC4\u5408\uFF0C\\n\u5E26\u6765\u65E0\u4E0E\u4F26\u6BD4\u7684\u5473\u89C9\u4F53\u9A8C\u3002\\n\u6D53\u800C\u4E0D\u817B\uFF0C\u8BA9\u4EBA\u56DE\u5473\u65E0\u7A77\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9C9C\u5AE9\u591A\u6C41\u7684\u8089\u5757\\n\u642D\u914D\u5FAE\u82E6\u5496\u55B1\u6C41\uFF0C\\n\u4E1D\u4E1D\u82E6\u5473\u5374\u4E0D\u5BB9\u5FFD\u89C6\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5496\u55B1\u6C41\u7684\u9178\u5473\\n\u4E0E\u914D\u6599\u7EDD\u5999\u5730\u878D\u5408\uFF0C\\n\u6210\u529F\u6FC0\u53D1\u51FA\u98DF\u6750\u672C\u8EAB\u7684\u9C9C\u7F8E\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F7F\u7528\u5DF4\u54C8\u7684\\n\u72EC\u95E8\u79D8\u5236\u98DF\u6750\\n\u5236\u6210\u7684\u9AD8\u7EA7\u5496\u55B1\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u9C9C\u7F8E\u65E0\u654C\u7684\u98DF\u6750\u642D\u914D\u4E0A\\n\u8FA3\u8FA3\u7684\u5496\u55B1\u6C41\uFF0C\u53EF\u4EE5\u8BF4\u662F\\n\u5F53\u4E4B\u65E0\u6127\u7684\u9EC4\u91D1\u7EC4\u5408\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4EE5\u5496\u55B1\u6C41\u6E05\u723D\u7684\u6DA9\u5473\\n\u8C03\u548C\u5473\u9053\u6D53\u539A\u7684\u914D\u6599\uFF0C\\n\u4EE4\u5496\u55B1\u7684\u98CE\u5473\u66F4\u80DC\u4E00\u7B79\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u7518\u9187\u9999\u6D53\uFF0C\u53E3\u5473\u7EDD\u4F73\u3002\\n\u5496\u55B1\u8FBE\u4EBA\u7EDD\u5BF9\u4E0D\u80FD\\n\u9519\u8FC7\u8FD9\u9053\u5496\u55B1\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5496\u55B1\u7684\u9C9C\u5473\u8DB3\u4EE5\u8BA9\u820C\u5C16\u53D1\u9EBB\u3002\\n\u504F\u82E6\u7684\u8C03\u5473\u886C\u6258\u51FA\\n\u98DF\u6750\u539F\u6709\u7684\u6ECB\u5473\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6ECB\u5473\u9178\u723D\u7684\u5496\u55B1\u6C41\u548C\\n\u98DF\u6750\u4EA4\u878D\uFF0C\u62E5\u6709\u8BA9\u4EBA\\n\u6B32\u7F62\u4E0D\u80FD\u7684\u9B54\u529B\u3002"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6B63\u7EDF\u7684\u5496\u55B1\u6C41\u642D\u914D\u4E0A\\n\u716E\u5F97\u6070\u5230\u597D\u5904\u7684\u8C46\u5B50\uFF0C\\n\u5448\u73B0\u51FA\u5730\u9053\u8D28\u6734\u7684\u98CE\u5473\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u9999\u8FA3\u6D53\u90C1\u7684\u5496\u55B1\u6C41\u9047\u4E0A\\n\u8C46\u5B50\u4E0E\u751F\u4FF1\u6765\u7684\u7518\u751C\uFF0C\\n\u5F3A\u70C8\u7684\u5BF9\u6BD4\u9020\u5C31\u72EC\u7279\u7684\u5473\u89C9\u4F53\u9A8C\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5496\u55B1\u6C41\u7684\u6DA9\u5473\\n\u7ED3\u5408\u8C46\u5B50\u7684\u8D28\u6734\u5473\u9053\uFF0C\\n\u8C8C\u4E0D\u60CA\u4EBA\u5374\u8BA9\u4EBA\u767E\u5403\u4E0D\u538C\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u7518\u751C\u7684\u8C03\u5473\u8BA9\\n\u539F\u672C\u5473\u9053\u6E05\u6DE1\u7684\u8C46\u5B50\\n\u4EA7\u751F\u4E86\u66F4\u52A0\u4E30\u5BCC\u7684\u53E3\u611F\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u7565\u5E26\u82E6\u5473\u7684\u5496\u55B1\u6C41\\n\u4E2D\u548C\u4E86\u8C46\u5B50\u7279\u6709\u7684\u8C46\u8165\u5473\u3002\\n\u5373\u4FBF\u662F\u8BA8\u538C\u5403\u8C46\u5B50\u7684\u4EBA\u4E5F\u5BF9\u5B83\u8D5E\u4E0D\u7EDD\u53E3\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u53E3\u611F\u9999\u8106\u7684\u8C46\u5B50\u548C\\n\u9178\u5473\u9002\u5B9C\u7684\u5496\u55B1\u6C41\\n\u4EA4\u7EC7\u51FA\u7EDD\u5999\u7684\u548C\u8C10\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u4E24\u79CD\u78B3\u6C34\u5316\u5408\u7269\u7684\u7EC4\u5408\\n\u7EDD\u5BF9\u8BA9\u4F60\u5403\u5230\u9971\u3002\\n\u662F\u4E00\u9053\u8D27\u771F\u4EF7\u5B9E\u7684\u5BB6\u5E38\u6599\u7406\u3002"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u54EA\u6015\u53EA\u662F\u80E1\u4E71\u6401\u4E0A\u7684\u70E4\u5410\u53F8\uFF0C\\n\u53EA\u8981\u8638\u4E0A\u8FA3\u8FA3\u7684\u5496\u55B1\u6C41\uFF0C\\n\u4E5F\u4F1A\u51FA\u4E4E\u610F\u6599\u5730\u4E00\u626B\u800C\u7A7A\u3002"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u628A\u70E4\u5410\u53F8\u6495\u6210\u7247\uFF0C\u4E0E\u5496\u55B1\u6C41\\n\u5747\u5300\u6DF7\u5408\uFF0C\u80FD\u591F\u7F13\u548C\u5496\u55B1\u7684\\n\u6DA9\u5473\uFF0C\u4F7F\u4E4B\u5BB9\u6613\u5165\u53E3\u3002"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u628A\u751C\u751C\u7684\u5496\u55B1\u6C41\u50CF\u679C\u9171\u4E00\u6837\\n\u6D82\u62B9\u5728\u9999\u55B7\u55B7\u7684\u70E4\u5410\u53F8\u4E0A\uFF0C\\n\u5947\u5999\u7684\u7F8E\u5473\u5C31\u6B64\u8BDE\u751F\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u70E4\u5F97\u6070\u5230\u597D\u5904\u7684\u5410\u53F8\uFF0C\\n\u4E0E\u7565\u5E26\u82E6\u5473\u7684\u5496\u55B1\u6C41\u5B8C\u7F8E\u8C03\u548C\uFF0C\\n\u5E26\u6765\u4E0D\u53EF\u601D\u8BAE\u7684\u4EAB\u53D7\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u70E4\u5410\u53F8\u7279\u6709\u7684\u84EC\u677E\u53E3\u611F\\n\u8F85\u4EE5\u5496\u55B1\u6C41\u7684\u5F3A\u70C8\u9178\u5473\uFF0C\\n\u5F00\u62D3\u51FA\u66F4\u6DF1\u5C42\u6B21\u7684\u7F8E\u5473\u3002"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u80FD\u540C\u65F6\u4EAB\u53D7\u5496\u55B1\u996D\\n\u548C\u5496\u55B1\u901A\u5FC3\u7C89\u3002\\n\u9965\u80A0\u8F98\u8F98\u65F6\u7684\u4E0D\u4E8C\u9009\u62E9\u3002"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u4E3A\u4E86\u8BA9\u8FA3\u5473\u5D2D\u9732\u5934\u89D2\uFF0C\\n\u5EFA\u8BAE\u5148\u628A\u98DF\u6750\u5168\u90E8\\n\u6405\u62CC\u5747\u5300\u518D\u98DF\u7528\u3002"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6DA9\u5473\u4E0E\u901A\u5FC3\u7C89\u4E5F\u662F\u7EDD\u597D\u642D\u914D\u3002\\n\u53EF\u4EE5\u8BA9\u4F60\u540C\u65F6\u4EAB\u53D7\u901A\u5FC3\u7C89\u548C\\n\u7C73\u996D\u4E24\u79CD\u78B3\u6C34\u5316\u5408\u7269\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u867D\u7136\u5176\u8C8C\u4E0D\u626C\uFF0C\u5473\u9053\u5374\u9C9C\u7F8E\u53EF\u53E3\u3002\\n\u7EAF\u6B63\u7684\u751C\u5496\u55B1\u642D\u914D\u901A\u5FC3\u7C89\\n\u6216\u7C73\u996D\u90FD\u5341\u5206\u7F8E\u5473\u3002"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u82E6\u5473\u5F3A\u70C8\u3001\\n\u8C03\u5473\u6D53\u9187\u7684\u5496\u55B1\u6C41\uFF0C\\n\u4E0E\u901A\u5FC3\u7C89\u642D\u914D\u5473\u9053\u4E5F\u6070\u5230\u597D\u5904\u3002"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u540C\u65F6\u6EE1\u8DB3\u4F60\u5BF9\u5496\u55B1\u548C\\n\u901A\u5FC3\u7C89\u7684\u6B32\u671B\u3002\u9178\u5473\u6D53\u70C8\u7684\\n\u5496\u55B1\u6C41\u7EDD\u5BF9\u80FD\u52FE\u8D77\u4F60\u7684\u98DF\u6B32\u3002"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u5496\u55B1\u6C41\u91CC\u6D53\u7F29\u4E86\\n\u591A\u79CD\u83CC\u83C7\u7684\u7CBE\u534E\uFF0C\\n\u662F\u4E00\u9053\u72EC\u5177\u5320\u5FC3\u7684\u5496\u55B1\u3002"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u8981\u60F3\u628A\u83CC\u83C7\u7684\u9C9C\u7F8E\u6ECB\u5473\\n\u53D1\u6325\u5230\u6781\u81F4\uFF0C\u8BC0\u7A8D\u5728\u4E8E\\n\u5C3D\u53EF\u80FD\u5730\u6D78\u900F\u8F9B\u8FA3\u7684\u5496\u55B1\u6C41\u3002"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u5C06\u591A\u79CD\u83CC\u83C7\u7684\u9C9C\u7F8E\\n\u5C42\u5C42\u53E0\u52A0\uFF0C\u4F7F\u5496\u55B1\u6C41\u7684\\n\u6DA9\u5473\u4E5F\u53D8\u5F97\u67D4\u548C\u4E86\u4E0D\u5C11\u3002"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u9C9C\u5AE9\u7684\u83CC\u83C7\u8638\u6EE1\u4E86\\n\u9999\u751C\u7684\u5496\u55B1\u6C41\uFF0C\u662F\u4E00\u9053\\n\u5F88\u6709\u56BC\u5934\u7684\u7F8E\u5473\u5496\u55B1\u3002"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u83CC\u83C7\u91CC\u542B\u6709\u7684\u6210\u5206\\n\u4F7F\u5496\u55B1\u6C41\u7684\u82E6\u5473\u5F97\u5230\u5347\u534E\u3002\\n\u662F\u4E00\u9053\u98CE\u683C\u9C9C\u660E\u7684\u5496\u55B1\u3002"
