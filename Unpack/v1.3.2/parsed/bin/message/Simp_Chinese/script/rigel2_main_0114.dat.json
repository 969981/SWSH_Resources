[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5B69\u5B50\u554A\uFF0C\u6C5D\u5DF2\u5411\u6751\u6C11\u4EEC\\n\u6253\u542C\u8FC7\u4E86\u5427\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u2026\u2026\u7ED3\u679C\u5982\u4F55\uFF1F\\n\u4ED6\u4EEC\u662F\u5426\u8BF4\u5230\u5B64\u7684\u4E8B\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8BF4\u662F\u8BF4\u4E86\u2026\u2026"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u53EA\u8BF4\u662F\u4E2A\u4F20\u8BF4\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\u679C\u7136\u5982\u6B64\uFF0C\\n\u770B\u6765\u4ED6\u4EEC\u5E76\u4E0D\u76F8\u4FE1\\r\\n\u5B64\u662F\u786E\u5B9E\u5B58\u5728\u7684\u554A\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4EBA\u7C7B\u65E9\u5DF2\u5FD8\u5374\\n\u4E0E\u5B64\u5EFA\u7ACB\u8D77\u7684\u7275\u7ECA\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u2026\u2026\u65E0\u59A8\uFF0C\\n\u5B64\u5C82\u4F1A\u4E3A\u6B64\u60B2\u53F9\u3002[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5B64\u4E43\u4E30\u9976\u4E4B\u738B\uFF01\\n\u4E0D\u4F1A\u80A4\u6D45\u5230\\r\\n\u6307\u671B\u4EBA\u7C7B\u7684\u5730\u6B65\u3002[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5B64\u5DF2\u4E0D\u80FD\u518D\u53BB\\n\u4F9D\u8D56\u4EBA\u7C7B\u7684\u4FE1\u4EF0\\r\\n\u6765\u6062\u590D\u529B\u91CF\u3002[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u82E5\u662F\u5B64\u7684\u7231\u9A6C\u80FD\u56DE\u5230\u5B64\u7684\u8EAB\u8FB9\uFF0C\\n\u60C5\u51B5\u5012\u662F\u4F1A\u597D\u4E9B\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7231\u9A6C\u662F\u6307\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u662F\u4EC0\u4E48\u6837\u7684\u5B9D\u53EF\u68A6\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5B64\u66FE\u7ECF\u9A7E\u9A6D\u81EA\u5982\u7684\u5750\u9A91\uFF0C\\n\u957F\u6709\uFF14\u6761\u817F\u7684\u5B9D\u53EF\u68A6\u2026\u2026\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6751\u5B50\u7684\u96D5\u50CF\u4E5F\u662F\\n\u5B64\u5C06\u5B83\u9A91\u5728\u80EF\u4E0B\u3002[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5F88\u4E45\u4EE5\u524D\uFF0C\u5B83\u66FE\u662F\u4E0E\u5B64\u5171\u540C\\n\u9A70\u9A8B\u4E8E\u5C71\u91CE\u4E2D\u7684\u4F19\u4F34\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4F46\u81EA\u4ECE\u5B64\u7684\u529B\u91CF\u8870\u5F31\uFF0C\\n\u5F7C\u6B64\u5206\u9053\u626C\u9573\u4E4B\u540E\uFF0C\\r\\n\u5B64\u8FDE\u5B83\u8EAB\u5728\u4F55\u65B9\u90FD\u65E0\u4ECE\u77E5\u6653\u3002[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u800C\u4E14\uFF0C\u7EB5\u4EE4\u5B64\u73B0\u5728\\n\u771F\u7684\u80FD\u591F\u627E\u5230\u7231\u9A6C\uFF0C\\c\\n\u5C31\u51ED\u5B64\u6B64\u65F6\u8FD9\u70B9\u5FAE\u8584\u4E4B\u529B\uFF0C\\n\u5927\u6982\u4E5F\u662F\u65E0\u6CD5\u9A7E\u9A6D\u5B83\u7684\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5173\u4E8E\u5B64\u7684\u7231\u9A6C\u7684\u4E8B\u8FF9\uFF0C\\n\u6216\u8BB8\u5728\u6751\u5B50\u5185\u4E5F\u6709\u6D41\u4F20\u3002\\c\\n\u6C5D\u82E5\u80FD\u53BB\u548C\u6751\u957F\u6253\u542C\u4E00\u4E0B\uFF0C\\n\u4FBF\u53EF\u5E2E\u4E0A\u5B64\u7684\u5927\u5FD9\u3002[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5982\u679C\u6C5D\u6709\u4E86\u65B0\u53D1\u73B0\uFF0C\\n\u5C31\u6765\u544A\u8BC9\u5B64\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u2026\u2026\u545C\u560E\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u54CE\u5440\uFF1F\u961F\u957F\uFF01\uFF1F\\n\u8111\u888B\u597D\u5927\u2026\u2026\u54CE\uFF1F\u597D\u50CF\u53C8\u4E0D\u5927\u4E86\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u2026\u2026\u54CE\u5440\u54CE\u5440\uFF0C\u4E0D\u597D\u610F\u601D\uFF01\\n\u6211\u521A\u624D\u597D\u50CF\u7AD9\u7740\u7761\u7740\u4E86\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u55EF\uFF1F\u597D\uFF5E\u50CF\u8EAB\u4F53\u6709\u79CD\\n\u602A\u602A\uFF5E\u7684\u611F\u89C9\u2026\u2026\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u5148\u56DE\u57FA\u5730\u4F11\u606F\u53BB\u4E86\uFF01\\n\u5443\u554A\uFF5E\u51BB\u6B7B\u4E86\u51BB\u6B7B\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4E30\u9976\u4E4B\u738B\u7684\u7231\u9A6C\uFF1F\\n\u6839\u636E\u4F20\u8BF4\uFF0C\u90A3\u53EF\u662F\u53EA\\r\\n\u7CDF\u8E4B\u519C\u4F5C\u7269\u7684\u70C8\u9A6C\u5594\uFF01\\r\\n\u8FD9\u6837\u8BF4\u6765\uFF0C\u5B83\u8FD8\u662F\u6211\u7684\u5BF9\u5934\u5462\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4E30\u9976\u4E4B\u738B\u7684\u7231\u9A6C\uFF1F\u7231\u9A6C\u554A\u2026\u2026\\c\\n\u201C\u7231\u739B\u201D\u5230\u673A\u64CE\u5E02\u53BB\u5566\u3002\\n\u4E5F\u4E0D\u77E5\u9053\u8FC7\u5F97\u597D\u4E0D\u597D\u554A\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6211\u542C\u8BF4\u554A\uFF0C\\n\u4E30\u9976\u4E4B\u738B\u7684\u7231\u9A6C\u957F\u7740\u4E00\u8EAB\\r\\n\u7F8E\u4E3D\u7EDD\u4F26\u7684\u9ED1\u8272\u76AE\u6BDB\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u4E30\u9976\u4E4B\u738B\u7684\u7231\u9A6C\uFF1F\\c\\n\u6709\u4EBA\u66FE\u7ECF\u544A\u8BC9\u6211\uFF0C\\n\u90A3\u5339\u9A6C\u770B\u8D77\u6765\u50CF\u96EA\u4E00\u6837\u6D01\u767D\u5462\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u4E30\u9976\u4E4B\u738B\u7684\u7231\u9A6C\\n\u7279\u522B\u559C\u6B22\u5403\u67D0\u6837\u4E1C\u897F\u5594\u3002\\c\\n\u55EF\u2026\u2026\u662F\u4EC0\u4E48\u4E1C\u897F\u6765\u7740\u2026\u2026\uFF1F\\n\u6751\u957F\u5927\u6982\u4F1A\u6BD4\u8F83\u6E05\u695A\u2026\u2026"
  }
]
