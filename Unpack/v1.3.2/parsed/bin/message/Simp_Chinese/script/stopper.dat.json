  {
    "index": 23,
    "flags": 0,
    "text": "\u5FAE\u5BD0\u68EE\u6797\u5728\u8FD9\u8FB9\u54E6\uFF01\\n\u53BB\u627E\u6BDB\u8FAB\u7F8A\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4F1A\u957F\u4E0D\u662F\u5DF2\u7ECF\u544A\u8BC9\u8FC7\u4F60\u4E86\u5417\uFF1F\\n\u5FEB\u53BB\u628A\u6C34\u4E4B\u5FBD\u7AE0\u62FF\u5230\u624B\u5427\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4F60\u662F\u9053\u9986\u6311\u6218\u8005\u5427\u3002\\c\\n\u9053\u9986\u9986\u4E3B\u9732\u7483\u5A1C\\n\u5DF2\u7ECF\u5728\u706F\u53F0\u90A3\u4E86\u3002\\c\\n\u53BB\u706F\u53F0\u7684\u8BDD\u2026\u2026\\n\u4ECE\u8FD9\u5F80\u6D77\u8FB9\u65B9\u5411\u8D70\u5C31\u5230\u4E86\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u4E3A\u4E86\u963B\u6B62\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u6240\u4EE5\u6211\u4EEC\u6B63\u5835\u5728\u8FD9\u91CC\uFF5E"
  },
  {
    "index": 27,
