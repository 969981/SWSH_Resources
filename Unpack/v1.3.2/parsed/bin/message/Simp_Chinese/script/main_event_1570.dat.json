[
  {
    "index": 0,
    "flags": 0,
    "text": "\u51E0\u4E2A\u5C0F\u65F6\u540E\u2026\u2026"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u600E\u4E48\u8FD8\u4E0D\u6765\uFF1F\\n\u7EDD\u5BF9\u6709\u95EE\u9898\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5927\u54E5\u53EF\u662F\u4E2A\u8BF4\u5230\u505A\u5230\u7684\u4EBA\u554A\uFF01\\c\\n\u4ED6\u4E4B\u6240\u4EE5\u80FD\u6210\u4E3A\u51A0\u519B\uFF0C\\n\u4E5F\u662F\u56E0\u4E3A\u5F53\u521D\u5411\u6211\u4FDD\u8BC1\u8FC7\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u51C6\u65F6\u6765\u5403\u996D\u8FD9\u79CD\u5C0F\u4E8B\uFF0C\\n\u5E94\u8BE5\u96BE\u4E0D\u5012\u4ED6\u5427\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u771F\u662F\u4E2A\u7231\u5435\u95F9\u7684\u5BB6\u4F19\u3002\\c\\n\u6709\u8FD9\u4E2A\u529B\u6C14\uFF0C\\n\u600E\u4E48\u4E0D\u7559\u5728\u6BD4\u8D5B\u65F6\u7528\u51FA\u6765\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8FD9\u79CD\u6B63\u7ECF\u8BDD\u8F6E\u4E0D\u5230\\n\u4F60\u8FD9\u6837\u770B\u8D77\u6765\u5C31\u5F88\u574F\u7684\u5BB6\u4F19\u8BF4\uFF01\\r\\n\u8042\u6893\uFF01\u6211\u662F\u8BA4\u771F\u5730\u5728\u62C5\u5FC3\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u8FD9\u662F\u5728\u4EE5\u8C8C\u53D6\u4EBA\uFF0C\\n\u4E5F\u96BE\u602A\u4F60\u6CA1\u6CD5\u53D6\u80DC\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u800C\u4E14\uFF0C\\n\u51A0\u519B\u4ED6\u5DF2\u7ECF\u53BB\u6D1B\u5179\u5927\u53A6\u4E86\u54E6\u3002[VAR 0114(0016)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4ED6\u4E3A\u4EC0\u4E48\u53BB\u90A3\u91CC\u4E86\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6D1B\u5179\u5927\u53A6\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8FD9\u6211\u5C31\u4E0D\u77E5\u9053\u4E86\uFF0C\\n\u4E0D\u8FC7\u6211\u5728\u5355\u8F68\u5217\u8F66\u7684\u8F66\u7AD9\u89C1\u5230\u4ED6\u4E86\u3002\\c\\n\u4ED6\u8BA9\u6211\u8F6C\u544A\u4F60\u4EEC\uFF0C\\n\u4ED6\u6709\u4E8B\u8981\u53BB\u4E00\u8D9F\u6D1B\u5179\u5927\u53A6\uFF0C\\r\\n\u6240\u4EE5\u4F1A\u665A\u4E9B\u624D\u5230\u3002[VAR 0114(0016)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u5179\u5927\u53A6\uFF1F\\n\u90FD\u8FD9\u4E2A\u65F6\u5019\u4E86\uFF0C\u8FD8\u53BB\u90A3\u91CC\u5E72\u4EC0\u4E48\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8042\u6893\uFF0C\u4F60\u5C31\u5E2E\u4EBA\u5E2E\u5230\u5E95\uFF0C\\n\u987A\u4FBF\u5E26\u6211\u4EEC\u53BB\u6D1B\u5179\u5927\u53A6\u5427\uFF01\\c\\n\u6211\u548C[VAR 0100(0000)]\u90FD\u4E0D\u77E5\u9053\\n\u6D1B\u5179\u5927\u53A6\u5728\u54EA\u91CC\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u54CE\u5440\u5440\u2026\u2026\u7528\u4E00\u53E5\u8BDD\u603B\u7ED3\uFF0C\\n\u4F60\u4EEC\u54E5\u4FE9\u53EF\u771F\u4F1A\u4F7F\u5524\u4EBA\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u2026\u2026\\c\\n\u51B3\u8D5B\u4E0D\u80FD\u7167\u5E38\u5F00\u6253\\n\u4E5F\u4E0D\u662F\u6211\u5E0C\u671B\u770B\u5230\u7684\u3002\\c\\n\u66F4\u91CD\u8981\u7684\u662F\uFF0C\u80FD\u6253\u8D62\u6211\uFF0C\\n\u8BA9\u6211\u8FD8\u662F\u86EE\u6B23\u8D4F\u4F60\u4EEC\u7684\u3002[VAR 0114(0016)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4E5F\u597D\uFF01\u6211\u5C31\u53EB\u4E0A\u5450\u558A\u961F\uFF0C\\n\u548C\u5927\u5BB6\u4E00\u8D77\u53BB\u627E\u627E\u4E50\u5B50\u5427\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8036\uFF5E\uFF01\u8042\u6893\uFF0C\u4F60\u592A\u68D2\u4E86\uFF01\\n\u5927\u5BB6\u4E00\u8D77\u536F\u8DB3\u7CBE\u795E\u51FA\u53D1\u5427\uFF01[VAR 0114(0005)]"
  }
