  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6781\u5DE8\u5316\u53EA\u6709\u5728\u4EBA\u548C\u5B9D\u53EF\u68A6\\n\u4E92\u76F8\u4FE1\u4EFB\u7684\u65F6\u5019\uFF0C\\r\\n\u624D\u80FD\u53D1\u6325\u51FA\u771F\u6B63\u7684\u529B\u91CF\u3002[VAR 0114(000A)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u90A3\u5E2E\u5BB6\u4F19\u6050\u6015\u662F\\n\u5C06\u8BB8\u613F\u661F\u7684\u4F3D\u52D2\u5C14\u7C92\u5B50\u5F3A\u884C\u6CE8\u5165\\r\\n\u5B9D\u53EF\u68A6\u7684\u4F53\u5185\u8BA9\u5B83\u4EEC\u6781\u5DE8\u5316\u7684\u5427\u3002[VAR 0114(000A)]"
