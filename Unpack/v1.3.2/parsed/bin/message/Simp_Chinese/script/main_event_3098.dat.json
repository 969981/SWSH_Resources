  {
    "index": 18,
    "flags": 0,
    "text": "\u4ED6\u4EEC\u5F3A\u884C\u8BA9\u5B9D\u53EF\u68A6\u6781\u5DE8\u5316\u7684\\n\u76EE\u7684\u7A76\u7ADF\u662F\u4EC0\u4E48\u5462\u2026\u2026\uFF1F[VAR 0114(000B)]"
