  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5443\u2026\u2026\u5475\u5475\u5475\u2026\u2026\\n\u4F60\u8FD8\u771F\u662F\u5757\u6599\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u770B\u6765\u4F60\u5728\u7ECF\u8FC7\u4E00\u756A\u9524\u70BC\u540E\\n\u80FD\u5904\u4E8B\u4E0D\u60CA\uFF0C\u771F\u662F\u5927\u6709\u957F\u8FDB\u554A\u3002[VAR 0114(000A)]"
