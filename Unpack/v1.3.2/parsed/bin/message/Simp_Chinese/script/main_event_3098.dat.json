    "text": "\u4ED6\u4EEC\u5B8C\u5168\u4E0D\u7406\u4F1A\u5B9D\u53EF\u68A6\u7684\u611F\u53D7\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u4F60\u4E0D\u6127\u662F\u51A0\u519B\uFF01\\n\u76F4\u89C9\u5F88\u654F\u9510\u554A\u3002[VAR 0114(000A)]"
