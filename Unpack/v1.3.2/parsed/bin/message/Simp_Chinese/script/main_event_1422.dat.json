[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8FD8\u5269\u4E0B\u591A\u5C11\u4E2A\u9053\u9986\u6311\u6218\u8005\u5462\uFF1F\\n\u54DF\u2026\u2026\u8FDE\uFF11\uFF10\u4E2A\u90FD\u4E0D\u5230\u554A\u3002[VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C[VAR 0100(0000)]\uFF01\\c\\n\u8BA9\u672C\u5927\u7237\u8BF4\u660E\u4E00\u4E0B\u8FD9\u91CC\u7684\u9053\u9986\u4EFB\u52A1\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u89C4\u5219\u5F88\u7B80\u5355\u3002\\c\\n\u4F60\u53EA\u8981\u901A\u8FC7\u53CC\u6253\u5BF9\u6218\u6253\u8D62\uFF13\u4E2A\\n\u6211\u57F9\u517B\u7684\u9053\u9986\u8BAD\u7EC3\u5BB6\u5C31\u53EF\u4EE5\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u60F3\u5FC5\u4F60\u4E5F\u77E5\u9053\uFF0C\\n\u9053\u9986\u6311\u6218\u7684\u96BE\u5EA6\u975E\u540C\u4E00\u822C\u3002\\c\\n\u6240\u4EE5\u80FD\u4E00\u76F4\u664B\u7EA7\u7684\\n\u9053\u9986\u6311\u6218\u8005\u6570\u91CF\u4E5F\u5F88\u5C11\u3002[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6B63\u56E0\u5982\u6B64\u554A\uFF01\\n\u6211\u624D\u60F3\u597D\u597D\u89C1\u8BC6\u4E00\u4E0B\uFF01\\r\\n\u4F60\u8FD9\u4E2A\u4E00\u8DEF\u664B\u7EA7\u5230\u6B64\u7684\u8BAD\u7EC3\u5BB6\uFF0C\\r\\n\u4F1A\u8BA9\u5B9D\u53EF\u68A6\u4EEC\u5C55\u73B0\u51FA\u591A\u4E48\u7CBE\u5F69\u7684\u914D\u5408\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u90A3\u6211\u4EEC\u5C31\u95F2\u8BDD\u5C11\u8BF4\u2026\u2026\\n\u6765\uFF01\u9996\u5148\u767B\u573A\u7684\u662F\u2026\u2026\\c\\n\u8FBD\u592A\uFF01\u4E0A\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u5C31\u662F\u8FBD\u592A\uFF01\\c\\n\u5947\u5DF4\u7EB3\u5148\u751F\u6559\u4E86\u6211\u4E24\u4EF6\u4E8B\uFF01\\n\u4E00\u4EF6\u662F\u9F99\u5C5E\u6027\u975E\u5E38\u5F3A\u5927\uFF01\\c\\n\u53E6\u4E00\u4EF6\u662F\u521B\u9020\u51FA\u5229\u4E8E\u81EA\u5DF1\u7684\u573A\u5730\uFF0C\\n\u624D\u80FD\u5145\u5206\u53D1\u6325\u9F99\u5C5E\u6027\u7684\u5B9E\u529B\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u771F\u4E0D\u6127\u662F\u4E00\u8DEF\u664B\u7EA7\u4E0B\u6765\u7684\u8BAD\u7EC3\u5BB6\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5728\u53CC\u6253\u5BF9\u6218\u65F6\uFF0C\u770B\u900F\u5BF9\u624B\u7684\u5B9D\u53EF\u68A6\\n\u626E\u6F14\u4EC0\u4E48\u6837\u7684\u89D2\u8272\u662F\u5F88\u91CD\u8981\u7684\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u597D\u50CF\u6CA1\u6709\uFF12\u53EA\\n\u53EF\u4EE5\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\u554A\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u592A\u5389\u5BB3\u4E86\uFF01\u771F\u4E0D\u6127\u662F\\n\u624B\u6301\uFF17\u679A\u9053\u9986\u5FBD\u7AE0\u7684\u8BAD\u7EC3\u5BB6\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u53CC\u6253\u5BF9\u6218\u2026\u2026\\c\\n\u662F\u9760\uFF12\u53EA\u5B9D\u53EF\u68A6\u7684\u5B9E\u529B\u786C\u5E72\uFF0C\\n\u8FD8\u662F\u8BA9\u5176\u4E2D\uFF11\u53EA\u4E13\u6CE8\u652F\u63F4\u2026\u2026\\r\\n\u4F60\u7684\u6218\u672F\u662F\u4EC0\u4E48\u5462\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8FD9\u91CC\u7684\u9053\u9986\u4EFB\u52A1\u91C7\u7528\u53CC\u6253\u5BF9\u6218\u3002\\c\\n\u4F60\u9700\u8981\u5E26\u4E0A\uFF12\u53EA\u4EE5\u4E0A\\n\u80FD\u591F\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\u624D\u884C\u2026\u2026"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u592A\u6F02\u4EAE\u4E86\u2026\u2026\uFF01\\c\\n\u6211\u5F88\u8363\u5E78\u80FD\u548C\u4F60\u8FD9\u6837\\n\u5F3A\u5927\u7684\u8BAD\u7EC3\u5BB6\u8F83\u91CF\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8981\u662F\u4F60\u6253\u8D62\u4E86\u65C1\u8FB9\u7684\u8BAD\u7EC3\u5BB6\uFF0C\\n\u5C31\u8BA9\u6211\u6765\u505A\u4F60\u7684\u5BF9\u624B\u5427\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u600E\u4E48\u4E86\uFF1F[VAR 0100(0000)]\uFF01\\n\u4F60\u7684\u9053\u9986\u4EFB\u52A1\u8FD8\u6CA1\u7ED3\u675F\u5462\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6CA1\u4EC0\u4E48"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6211\u8981\u9000\u51FA"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5475\u5475\uFF01\u5FEB\u70B9\u5B8C\u6210\u4EFB\u52A1\u554A\uFF01\\n\u6211\u5DF2\u7ECF\u7B49\u4E0D\u53CA\u8981\u548C\u4F60\u5BF9\u6218\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4F60\u786E\u5B9A\u8981\u9000\u51FA\u5417\uFF1F[VAR 0114(0017)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u4F60\u4E0D\u4F1A\u5C31\u6B64\u653E\u5F03\uFF0C\\n\u8FD8\u4F1A\u518D\u6765\u7684\u5427\uFF1F\u6211\u4F1A\u7B49\u4F60\u7684\u3002[VAR 0114(0017)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u679C\u7136\u5389\u5BB3\uFF01[VAR 0100(0000)]\uFF01\\n\u4F60\u5B8C\u6210\u9053\u9986\u4EFB\u52A1\u4E86\uFF01\\c\\n\u8D70\uFF0C\u6211\u4EEC\u53BB\u9053\u9986\u7ADE\u6280\u573A\u5427\uFF01\\n\u672C\u5927\u7237\u8981\u4EB2\u81EA\u63A5\u53D7\u4F60\u7684\u6311\u6218\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\u662F\u7B2C\uFF12\u4E2A\u8BAD\u7EC3\u5BB6\uFF01\\n\u73B2\u5A1C\uFF01\u4E0A\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\u662F\u7B2C\uFF13\u4E2A\uFF0C\\n\u4E5F\u662F\u6700\u540E\u4E00\u4E2A\u8BAD\u7EC3\u5BB6\uFF01\\r\\n\u77B3\u7F8E\uFF01\u4E0A\u5427\uFF01[VAR 0114(0017)]"
  }
]
