[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4E39\u5E1D\u554A\uFF0C\\n\u6211\u90FD\u8BF4\u4E86\u4E0D\u4E0B\uFF11\uFF10\uFF10\u6B21\u4E86\u3002\\c\\n\u4F60\u600E\u4E48\u5C31\u662F\u4E0D\u7406\u89E3\u5462\u2026\u2026\\n\u522B\u4EBA\u4E5F\u5C31\u7B97\u4E86\uFF0C\u4F60\u53EF\u662F\u51A0\u519B\u554A\u3002[VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u4E0D\u662F\u4E0D\u80FD\u7406\u89E3\u60A8\u7684\u8BDD\u3002[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u53EA\u662F\u6709\u4E00\u70B9\u6211\u5B9E\u5728\u4E0D\u660E\u767D\uFF01\\c\\n\u4E3A\u4EC0\u4E48\u4E0D\u60DC\u4E2D\u6B62\u660E\u5929\u7684\u6BD4\u8D5B\\n\u53BB\u6025\u7740\u89E3\u51B3\uFF11\uFF10\uFF10\uFF10\u5E74\u4EE5\u540E\u7684\u95EE\u9898\uFF1F\\r\\n\u4E0D\u5DEE\u8FD9\u4E00\u5929\u5427\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u800C\u4E14\u6211\u8EAB\u4E3A\u51A0\u519B\uFF0C\\n\u4E5F\u6709\u8D23\u4EFB\u4FDD\u8BC1\u51B3\u8D5B\u80FD\u987A\u5229\u8FDB\u884C\uFF01\\c\\n\u6211\u4E0D\u60F3\u8BA9\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u7C89\u4E1D\u4EEC\u5931\u671B\uFF0C\\n\u66F4\u4E0D\u60F3\u8BA9\u81EA\u5DF1\u9519\u8FC7\u671F\u5F85\u5DF2\u4E45\u7684\u5BF9\u51B3\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u4E0D\u61C2\u2026\u2026\\n\u4F60\u6839\u672C\u5C31\u4E0D\u61C2\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E39\u5E1D\u554A\uFF0C\u4F60\u597D\u597D\u770B\u4E00\u770B\\n\u773C\u524D\u8FD9\u7247\u4F3D\u52D2\u5C14\u7684\u5927\u5730\u5427\uFF01\\c\\n\u8BA9\u8FD9\u91CC\u7480\u74A8\u751F\u8F89\u7684\u80FD\u6E90\\n\u518D\u8FC7\uFF11\uFF10\uFF10\uFF10\u5E74\u5C31\u4E0D\u590D\u5B58\u5728\u4E86\uFF01\\c\\n\u5230\u90A3\u65F6\uFF0C\u4F3D\u52D2\u5C14\u5730\u533A\\n\u751A\u81F3\u4E5F\u65E9\u5DF2\u65E0\u4EBA\u5B58\u6D3B\u4E86\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u60F3\u5230\u8FD9\u4E00\u70B9\uFF0C\u5E94\u8BE5\u5C31\u80FD\u7406\u89E3\uFF0C\\n\u54EA\u6015\u662F\u4E00\u5929\u90FD\u803D\u8BEF\u4E0D\u8D77\uFF01\\r\\n\u4E3A\u4E86\u89E3\u51B3\u8FD9\u4E2A\u4E25\u91CD\u7684\u95EE\u9898\uFF01\\r\\n\u4E3A\u4E86\u521B\u9020\u7F8E\u597D\u7684\u672A\u6765\uFF01\\r\\n\u73B0\u5728\u5FC5\u987B\u5206\u79D2\u5FC5\u4E89\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uFF11\uFF10\uFF10\uFF10\u5E74\u4EE5\u540E\u2026\u2026\uFF01\uFF1F\\c\\n\u539F\u6765\u5982\u6B64\uFF0C\u6211\u597D\u50CF\u660E\u767D\\n\u4F1A\u957F\u60A8\u6240\u62C5\u5FC3\u7684\u4E8B\u60C5\u4E86\u3002\\c\\n\u7B49\u660E\u5929\u7684\u51B3\u8D5B\u7ED3\u675F\u4E4B\u540E\uFF0C\\n\u6211\u4F1A\u7ACB\u523B\u6765\u5E2E\u52A9\u60A8\u7684\u3002[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u2026\u2026\u5927\u54E5\u3002\\c\\n\u7B49\u4E86\u534A\u5929\u4F60\u90FD\u4E0D\u6765\uFF0C\\n\u6211\u90FD\u62C5\u5FC3\u6B7B\u4E86\u2026\u2026\\c\\n\u591A\u4E8F\u4E86\u8042\u6893\u3001\u739B\u4FD0\uFF0C\u8FD8\u6709\u5450\u558A\u961F\u7684\u5E2E\u52A9\uFF0C\\n\u6211\u4EEC\u624D\u5230\u4E86\u8FD9\u91CC\u3002[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF0C\u771F\u62B1\u6B49\u8BA9\u4F60\u62C5\u5FC3\u4E86\u3002\\c\\n\u4F60\u8981\u77E5\u9053\uFF0C\u5927\u4EBA\u5E38\u5E38\u788D\u4E8E\u9762\u5B50\uFF0C\\n\u6709\u65F6\u5019\u6CA1\u6709\u529E\u6CD5\u5766\u8BDA\u5730\u8C08\u4E8B\u3002[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4E0D\u8BF4\u8FD9\u4E9B\u4E86\u3002\\n\u8D6B\u666E\u3001[VAR 0100(0000)]\uFF0C\u6211\u8BF7\u5BA2\uFF01\\r\\n\u6211\u4EEC\u5230\u9152\u5E97\u5403\u4E2A\u75DB\u5FEB\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\uFF0C\\n\u8BF7\u60A8\u4E00\u5B9A\u8981\u89C2\u770B\u660E\u5929\u7684\u6BD4\u8D5B\uFF01\\r\\n\u56E0\u4E3A\u8FD9\u5C06\u662F\u8F7D\u5165\u4F3D\u52D2\u5C14\u53F2\u518C\u7684\u7ECF\u5178\u5BF9\u51B3\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8F7D\u5165\u4F3D\u52D2\u5C14\u7684\u53F2\u518C\u2026\u2026\\c\\n\u51A0\u519B\u554A\uFF0C\u4F60\u592A\u5929\u771F\u4E86\u3002\\n\u4F3D\u52D2\u5C14\u7684\u5386\u53F2\u9700\u8981\u7684\u662F\u6539\u53D8\uFF0C\\r\\n\u800C\u6539\u53D8\u5B83\u7684\u4EBA\u5C31\u662F\u6211\uFF01[VAR 0114(0006)]"
  }
]
