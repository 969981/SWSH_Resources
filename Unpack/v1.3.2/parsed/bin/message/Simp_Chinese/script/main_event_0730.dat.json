[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8FD9\u51F9\u51F8\u4E0D\u5E73\u7684\u6837\u5B50\u771F\u662F\u53EF\u7231\u554A\uFF5E\\n\u5927\u70AD\u8F66\uFF0C\u4F60\u5F88\u5F00\u5FC3\u54E6\uFF5E[VAR 0114(0043)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5514\uFF1F"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u548C\u6211\u5FC3\u7231\u7684\u5927\u70AD\u8F66\u73A9\u5F97\u6B63\u6B22\u5462\u3002\\c\\n\u4F60\u5374\u95EF\u8FDB\u4E86\u6211\u4EEC\u7684\u4E8C\u4EBA\u4E16\u754C\uFF01\\n\u6211\u8BF4\u4EC0\u4E48\u90FD\u8981\u628A\u4F60\u8D76\u51FA\u53BB\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u66FE\u662F\u7B2C\u4E8C\u77FF\u5C71\u4E2D\u6700\u5F3A\u7684\u8BAD\u7EC3\u5BB6\u2026\u2026\\n\u73B0\u5728\u5C45\u7136\u5931\u53BB\u4E86\u5BB9\u8EAB\u4E4B\u5904\u2026\u2026\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u641E\u4EC0\u4E48\u554A\uFF01\\n\u96BE\u5F97\u6211\u60F3\u51FA\u4E86\u4E00\u8FB9\u966A\u5927\u70AD\u8F66\u73A9\uFF0C\\r\\n\u4E00\u8FB9\u6321\u8DEF\u7684\u597D\u4E3B\u610F\uFF01[VAR 0114(0044)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u64A4\u9000\uFF01\u4E22\u4E0B\u5B9D\u53EF\u68A6\uFF0C\\n\u64A4\u9000\u8981\u7D27\uFF01[VAR 0114(005E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u597D\u6837\u7684\uFF01\\n[VAR 0100(0000)]\u3002[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u90A3\u4E9B\u5BB6\u4F19\u2026\u2026\\c\\n\u662F\u56E0\u4E3A\u5728\u548C\u5927\u70AD\u8F66\u73A9\uFF0C\\n\u6240\u4EE5\u624D\u5728\u8FD9\u91CC\u6321\u8DEF\u7684\u5417\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u54FC\uFF01\\c\\n\u770B\u6765\u6211\u505A\u51FA\u4E86\u660E\u667A\u7684\u5224\u65AD\u3002\\n\u65E0\u804A\u7684\u55BD\u5570\u5C31\u5E94\u8BE5\u4EA4\u7ED9\\r\\n\u65E0\u80FD\u7684\u8BAD\u7EC3\u5BB6\u89E3\u51B3\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8F9B\u82E6\u4F60\u4E86\uFF0C\u5927\u70AD\u8F66\u3002\\n\u4F60\u6B63\u5728\u505A\u5B9D\u53EF\u5E2E\u5E2E\u5FD9\u5417\uFF1F\\c\\n\u6765\uFF0C\u628A\u5CA9\u77F3\u51FB\u788E\uFF0C\\n\u56DE\u5230\u4F60\u7684\u8BAD\u7EC3\u5BB6\u8EAB\u8FB9\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5514\uFF5E\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5B83\u7ADF\u7136\u8FD8\u80FD\u4E3A\u6211\u5F00\u8DEF\u2026\u2026\\n\u6BD4\u4F60\u4EEC\u9876\u7528\u591A\u4E86\u5462\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u4F60\u4EEC\u597D\u6B79\u89E3\u51B3\u4E86\u5450\u558A\u961F\uFF0C\\n\u5C31\u628A\u8FD9\u4E2A\u9001\u7ED9\u4F60\u4EEC\u5F53\u5956\u8D4F\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4ED6\u72C2\u4E2A\u4EC0\u4E48\u52B2\u554A\u2026\u2026\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u521A\u624D\u90A3\u53EA\u5927\u70AD\u8F66\u2026\u2026\\n\u4E0D\u77E5\u5B83\u627E\u5230\u6CA1\u627E\u5230\u5B83\u7684\u8BAD\u7EC3\u5BB6\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8BDD\u8BF4\u56DE\u6765\u2026\u2026\\n\u5361\u829C\u5230\u5E95\u5728\u54EA\u91CC\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5450\u558A\u961F\uFF01\u611F\u8C22\u4F60\u4EEC\u966A\u6211\u7279\u8BAD\uFF01\\n\u4F46\u662F\u2026\u2026\\c\\n\u4F60\u4EEC\u53EF\u4E0D\u80FD\u59A8\u788D\u5927\u70AD\u8F66\u5DE5\u4F5C\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u4EEC\u53EF\u6CA1\u6709\u59A8\u788D\u5B83\uFF01\\n\u6211\u4EEC\u53EA\u662F\u5728\u4E3A\u5927\u70AD\u8F66\u52A0\u6CB9\u5450\u558A\u2026\u2026[VAR 0114(0043)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4F46\u662F\uFF0C\u65E2\u7136\u5728\u5BF9\u6218\u4E2D\\n\u88AB\u72E0\u72E0\u5730\u4FEE\u7406\u4E86\uFF0C\\r\\n\u90A3\uFF5E\u6211\u4EEC\u5450\u558A\u961F\u8FD8\u662F\u5FEB\u5FEB\u9000\u573A\u5427\u2026\u2026[VAR 0114(0044)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5514\u5594\u5594\uFF5E\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4E3A\u5B83\u52A0\u6CB9\u5012\u662F\u53EF\u4EE5\uFF0C\\n\u4F46\u59A8\u788D\u5B83\u5DE5\u4F5C\u53EF\u5C31\u4E0D\u884C\u4E86\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5361\u829C\u2026\u2026\u4F60\u592A\u5E05\u4E86\uFF01\\n\u771F\u4E0D\u6127\u662F\u706B\u5C5E\u6027\u9053\u9986\u9986\u4E3B\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4F60\u4EEC\u5C31\u662F\u4E39\u5E1D\u63A8\u8350\u7684\u6311\u6218\u8005\uFF0C\\n\u8D6B\u666E\u548C[VAR 0100(0000)]\u5427\uFF01\\c\\n\u6CA1\u9519\uFF0C\u4E3A\u4E86\u80FD\u548C\u4F60\u4EEC\u8FD9\u6837\u7684\\n\u9053\u9986\u6311\u6218\u8005\u5C55\u5F00\u5DC5\u5CF0\u5BF9\u51B3\uFF0C\\r\\n\u6211\u6B63\u5728\u7AED\u5C3D\u5168\u529B\u5730\u953B\u70BC\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5BF9\u4E8E\u4F7F\u7528\u706B\u5C5E\u6027\u5B9D\u53EF\u68A6\\n\u5BF9\u6218\u7684\u6211\u6765\u8BF4\u2026\u2026\\c\\n\u8FD9\u5EA7\u6709\u6C34\u5C5E\u6027\u5B9D\u53EF\u68A6\u51FA\u6CA1\u7684\u7B2C\u4E8C\u77FF\u5C71\uFF0C\\n\u662F\u6700\u9002\u5408\u953B\u70BC\u7684\u5730\u65B9\u4E86\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u65F6\u95F4\u4E5F\u4E0D\u65E9\u4E86\u3002\\c\\n\u7A7F\u8FC7\u7B2C\u4E8C\u77FF\u5C71\u540E\u4E00\u76F4\u5F80\u524D\u8D70\uFF0C\\n\u5C31\u80FD\u5230\u8FBE\u673A\u64CE\u5E02\u4E86\u3002\\c\\n\u4F60\u4EEC\u56DE\u9152\u5E97\u65E9\u70B9\u4F11\u606F\uFF0C\\n\u517B\u7CBE\u84C4\u9510\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5927\u70AD\u8F66\uFF0C\u4F60\u4E5F\u8BE5\u4F11\u606F\u4E86\uFF0C\\n\u8BA9\u6211\u6765\u9001\u4F60\u56DE\u53BB\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u5514\u5514\u5594\uFF5E\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u660E\u5929\u80AF\u5B9A\u4F1A\u662F\u706B\u70ED\u7684\u4E00\u5929\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u5927\u54E5\u4EE5\u524D\u8BF4\u8FC7\u2026\u2026\\c\\n\u6709\u5F88\u591A\u6311\u6218\u8005\u90FD\u56E0\u4E3A\\n\u6253\u4E0D\u8D62\u5361\u829C\u800C\u9009\u62E9\u653E\u5F03\u3002[VAR 0114(0005)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u7684\u6597\u5FD7\u4E5F\u88AB\u70B9\u71C3\u5566\uFF01[VAR 0114(0005)]"
  }
]
