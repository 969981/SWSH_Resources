[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F60\u6765\u4E86\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5B9D\u7269\u5E93\u5B9E\u5728\u662F\u592A\u68D2\u4E86\uFF01\\c\\n\u8FD9\u91CC\u7ADF\u7136\u8FD8\u7559\u7740\\n\u8BB0\u5F55\u4F3D\u52D2\u5C14\u5386\u53F2\u7684\u6302\u6BEF\u5462\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u770B\u7740\u8BB8\u613F\u661F\u7684\u4E24\u4E2A\u5E74\u8F7B\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u707E\u5384\u964D\u4E34\u2026\u2026\\n\u4E0D\u77E5\u6240\u63AA\u7684\u5E74\u8F7B\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6B63\u5728\u9A71\u6563\u707E\u5384\u7684\u5251\u4E0E\u76FE\u2026\u2026\\n\u4EE5\u53CA\u671B\u7740\u5B83\u4EEC\u7684\u5E74\u8F7B\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5934\u6234\u738B\u51A0\u7684\u5E74\u8F7B\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6302\u6BEF\u4E0A\u63CF\u7ED8\u7684\u662F\\n\u4F3D\u52D2\u5C14\u7684\u738B\u56FD\u8BDE\u751F\u65F6\u7684\u6545\u4E8B\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u8BF4\uFF0C\u5E74\u8F7B\u7684\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u8FD9\u5176\u4E2D\u6709\u6CA1\u6709\u8BA9\u4F60\u5728\u610F\u7684\u90E8\u5206\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u82F1\u96C4\u662F\u4E24\u4E2A\u4EBA\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u95C7\u591C\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u679C\u7136\u5389\u5BB3\uFF01\\c\\n\u673A\u64CE\u5E02\u65C5\u5E97\u91CC\u90A3\u5C0A\u82F1\u96C4\u96D5\u50CF\uFF0C\\n\u65E0\u8BBA\u600E\u4E48\u770B\u90FD\u53EA\u6709\u4E00\u4E2A\u4EBA\u3002\\c\\n\u4F46\u662F\u8FD9\u91CC\u7684\u6302\u6BEF\u4E0A\u5374\u6709\u4E24\u4E2A\u5E74\u8F7B\u4EBA\u3002[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5BF9\u554A\uFF01\u4F60\u8BF4\u5F97\u6CA1\u9519\uFF01\\c\\n\u6839\u636E\u8FD9\u91CC\u7684\u63CF\u7ED8\uFF0C\\n\u7B3C\u7F69\u5929\u7A7A\u7684\u9ED1\u8272\u65CB\u6DA1\\r\\n\u5C31\u662F\u6240\u8C13\u7684\u707E\u5384\u2026\u2026\\r\\n\u6CA1\u9519\uFF0C\u8FD9\u6B63\u662F\u95C7\u591C\u554A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u82F1\u96C4\u5230\u5E95\u662F\u4E00\u4E2A\u4EBA\uFF1F\\n\u8FD8\u662F\u4E24\u4E2A\u4EBA\u2026\u2026\uFF1F\\r\\n\u6240\u8C13\u7684\u95C7\u591C\uFF0C\u53C8\u662F\u4EC0\u4E48\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8C22\u8C22\u4F60\u966A\u6211\u8BF4\u8BDD\uFF0C\\n\u6211\u7406\u6E05\u601D\u8DEF\u4E86\u3002\\c\\n\u6211\u8FD8\u8981\u518D\u8C03\u67E5\u4E00\u4E0B\u6302\u6BEF\uFF0C\\n\u4F60\u8BE5\u53BB\u6311\u6218\u9053\u9986\u4E86\u5427\uFF1F\\c\\n\u52A0\u6CB9\u554A\uFF01\u8FD9\u4E2A\u7ED9\u4F60\u4E86\uFF01\\n\u6211\u671F\u5F85\u4F60\u80FD\u8D62\u5230\u6700\u540E\u54E6\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u9A71\u6563\u4E86\u707E\u5384\u7684\u5251\u4E0E\u76FE\uFF0C\\n\u73B0\u5728\u7A76\u7ADF\u5728\u54EA\u91CC\u5462\uFF1F[VAR 0114(000B)]"
  }
]
