    "index": 30,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u90A3\u4E48\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u5C31\u518D\u89C1\u5427\uFF01\\n\u6700\u597D\u6C38\u8FDC\u90FD\u4E0D\u518D\u89C1\u5566\uFF5E\uFF01\u554A\u54C8\uFF01[VAR 0114(0071)]"
  },
