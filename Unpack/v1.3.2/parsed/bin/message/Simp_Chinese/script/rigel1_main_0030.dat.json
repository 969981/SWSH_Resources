    "text": "\u554A\u54C8\uFF01\\n\u770B\u6837\u5B50\u4F60\u662F\u7B2C\u4E00\u6B21\u6765\u94E0\u5C9B\u54E6\u3002[VAR 0114(0071)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\\n\u4F60\u662F\u7B2C\u4E00\u6B21\u6765\u94E0\u5C9B\u5417\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F30\u8BA1\u4F60\u6B63\u60F3\u5230\u5904\u8D70\u8D70\u770B\u770B\uFF0C\\n\u5FC3\u91CC\u75D2\u75D2\u7684\u5427\u3002\\r\\n\u4E0D\u8FC7\uFF0C\u8FD8\u662F\u8981\u5148\u6765\u6BD4\u8BD5\u4E00\u4E0B\u5B9E\u529B\u54E6\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u60F3\u4F60\u73B0\u5728\u5E94\u8BE5\u5F88\u60F3\\n\u968F\u5FC3\u6240\u6B32\u5730\u5728\u8FD9\u9644\u8FD1\u8D70\u8D70\u2026\u2026\\r\\n\u4E0D\u8FC7\uFF0C\u9996\u5148\u8FD8\u662F\u6765\u6D4B\u8BD5\u4E00\u4E0B\u5B9E\u529B\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5C31\u8BA9\u6211\u8FD9\u4E2A\u9A6C\u5E08\u5085\u6B66\u9986\u7684\u524D\u8F88\u5462\u2026\u2026[VAR 0114(0071)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5C31\u8BA9\u6211\u8FD9\u4F4D\u9A6C\u5E08\u5085\u6B66\u9986\u7684\u524D\u8F88\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u597D\u597D\u786E\u8BA4\u4E00\u4E0B\u4F60\u7684\u5B9E\u529B\u5427\uFF01\\n\u4F60\u53EF\u8981\u624B\u4E0B\u7559\u60C5\u54E6\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u597D\u597D\u770B\u900F\u4F60\u6709\u51E0\u65A4\u51E0\u4E24\u5427\uFF01\\n\u6765\u5427\u6765\u5427\uFF01\u8FD8\u8BF7\u624B\u4E0B\u7559\u60C5\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4EC0\u4E48\uFF01\uFF1F\u4E0D\u5BF9\u4E0D\u5BF9\u4E0D\u5BF9\u4E0D\u5BF9\uFF01\\n\u8FD9\u3001\u8FD9\u600E\u4E48\u53EF\u80FD\u561B\uFF01\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u554A\u3001\u90A3\u4E2A\uFF0C\\n\u2026\u2026\u8BF7\u7A0D\u7B49\u4E00\u4E0B\u3002[VAR 0114(0072)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u54CE\u54DF\u6211\u53BB\u2026\u2026\\n\u592A\u5371\u9669\u4E86\u5427\uFF0C\u8FD9\u5BB6\u4F19\u2026\u2026\uFF01\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4E0D\u53EF\u80FD\u2026\u2026\u4E0D\uFF0C\u8FD9\u7EDD\uFF5E\u4E0D\u53EF\u80FD\uFF01\\n[VAR 1100(00FF,0101)]\u4ED6\u5979\u7A76\u7ADF\u7528\u7684\u662F\u4EC0\u4E48\u620F\u6CD5\u2026\u2026\uFF01\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6B66\u9986\u91CC\u8981\u662F\u6765\u4E86\\n\u8FD9\u4E48\u5389\u5BB3\u7684\u5BB6\u4F19\u2026\u2026\\r\\n\u4EBA\u5BB6\u7684\u5B9E\u529B\u53EF\u8BE5\u88AB\u6BD4\u4E0B\u53BB\u4E86\uFF01\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8FD9\u822C\u5F3A\u8005\u82E5\u662F\u9A7E\u4E34\u6B66\u9986\u2026\u2026\\c\\n\u6240\u6709\u4EBA\u90FD\u4F1A\u77AC\u95F4\u5931\u5FC6\uFF0C\\n\u628A\u6211\u7684\u5B58\u5728\u5F7B\u5E95\u5FD8\u6389\u5427\u2026\u2026\uFF01\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u597D\u60F3\u628A[VAR 1100(00FF,0101)]\u4ED6\u5979\u7ED9\u8D76\u56DE\u53BB\u554A\u2026\u2026\\n\u53EF\u662F\u6211\u90FD\u88AB\u53EB\u8FC7\u6765\u63A5\u4EBA\u4E86\u2026\u2026\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u867D\u7136\u5F88\u60F3\u628A[VAR 1100(00FF,0101)]\u4ED6\u5979\u8D76\u56DE\u53BB\u2026\u2026\\n\u4F46\u6BD5\u7ADF\u6211\u88AB\u5429\u5490\u6765\u9886[VAR 1100(00FF,0101)]\u4ED6\u5979\u5165\u95E8\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u2026\u2026\u54B3\u54B3\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u2026\u2026\u54B3\u54B3\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u867D\u7136\u6211\u521A\u624D\u662F\u5B8C\u5B8C\u5168\u5168\\n\u6CA1\u6709\u8BA4\u771F\u8DDF\u4F60\u6253\u5566\uFF5E\\r\\n\u4E0D\u8FC7\u4F60\u8FD8\u633A\u6709\u4E24\u4E0B\u5B50\u7684\u561B\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4F60\u5F88\u6709\u5929\u5206\u3002\\n\u6BD5\u7ADF\u4F60\u5C45\u7136\u8BA9\u6211\u62FF\u51FA\u4E86\uFF13\uFF05\u7684\u5B9E\u529B\u5462\u3002[VAR 0114(0072)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u5462\uFF5E\u6211\u4EEC\u8FD9\u4E2A\u6B66\u9986\u554A\uFF5E\\n\u771F\u7684\u662F\u8D85\uFF5E\u6709\u6765\u5386\u7684\u54E6\uFF0C\\r\\n\u5C31\u8FDE\u90A3\u4F4D\u51A0\u519B\u4E39\u5E1D\u90FD\u6765\u5B66\u8FC7\u827A\u5462\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u6211\u4EEC\u8FD9\u5EA7\u6B66\u9986\\n\u975E\u5E38\u6709\u6765\u5386\uFF0C\u5C31\u8FDE\u90A3\u4F4D\\r\\n\u51A0\u519B\u4E39\u5E1D\u90FD\u66FE\u7ECF\u524D\u6765\u5B66\u827A\u3002[VAR 0114(0072)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5C31\u51ED\u4F60\u8FD9\u70B9\u5B9E\u529B\u7684\u8BDD\\n\u5E94\u8BE5\u575A\u6301\u4E0D\u4E0B\u53BB\u7684\u5427\uFF5E\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5C31\u51ED\u4F60\u73B0\u5728\u7684\u5B9E\u529B\uFF0C\\n\u6211\u60F3\u5E94\u8BE5\u5F88\u96BE\u575A\u6301\u4E0B\u53BB\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6240\u4EE5\u5462\uFF5E\u4F60\u8FD8\u662F\u522B\u53BB\\n\u90A3\u8FB9\u7684\u9A6C\u5E08\u5085\u6B66\u9986\u4E86\uFF0C\\r\\n\u5728\u5C9B\u4E0A\u89C2\u5149\u4E00\u4E0B\u5C31\u56DE\u53BB\u5427\uFF5E\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6240\u3001\u4EE5\uFF01\u8BF7\u4F60\u76F4\u63A5\u5FFD\u7565\u4F2B\u7ACB\u4E8E\\n\u90A3\u8FB9\u7684\u9A6C\u5E08\u5085\u6B66\u9986\uFF01\\r\\n\u5728\u5C9B\u4E0A\u89C2\u5B8C\u5149\u5C31\u8BF7\u56DE\u5427\uFF01\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u9001\u4F60\uFF0C\u6240\u4EE5\u2026\u2026\u542C\u8BDD\u54E6\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u2026\u2026\u6211\u4F1A\u628A\u8FD9\u4E2A\u9001\u4F60\u7684\u3002[VAR 0114(0072)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u53BB\u670D\u88C5\u5E97\u6216\u8005\u7F8E\u53D1\u6C99\u9F99\\n\u7684\u65F6\u5019\u5411\u5E97\u5458\u51FA\u793A\u8FD9\u4E2A\uFF0C\\r\\n\u53EF\u9009\u7684\u9020\u578B\u5C31\u4F1A\u589E\u52A0\u5566\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u53BB\u670D\u88C5\u5E97\u6216\u7F8E\u53D1\u6C99\u9F99\u65F6\uFF0C\\n\u53EA\u8981\u51FA\u793A\u8FD9\u5F20\u5361\uFF0C\\r\\n\u8BF4\u4E0D\u5B9A\u5C31\u80FD\u6253\u626E\u5F97\u50CF\u6211\u4E00\u6837\u4F18\u96C5\u4E86\u5462\u3002[VAR 0114(0072)]"
  },
