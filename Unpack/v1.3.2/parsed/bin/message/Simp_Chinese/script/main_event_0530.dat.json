    "text": "\u4ED6\u5148\u8D70\u4E86"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u4EEC\u5206\u5F00\u884C\u52A8\u4E86"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u770B\u6765\u4ED6\u662F\u7B49\u4E0D\u53CA\u4E86\uFF0C\\n\u6068\u4E0D\u5F97\u9A6C\u4E0A\u5C31\u80FD\u8D76\u4E0A\u4ED6\u5927\u54E5\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E5F\u662F\uFF0C\u4F60\u4EEC\u6BD5\u7ADF\u662F\u52B2\u654C\uFF0C\\n\u5206\u5F00\u953B\u70BC\u4E5F\u5F88\u6B63\u5E38\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF01\u987A\u4FBF\u544A\u8BC9\u4F60\u4E00\u4EF6\u6709\u8DA3\u7684\u4E8B\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u770B\u5230\u90A3\u8FB9\u7684\u5EFA\u7B51\u4E86\u5417\uFF1F\\n\u5176\u5B9E\u90A3\u662F\u6D1B\u5179\u4F1A\u957F\u65D7\u4E0B\u7684\u516C\u53F8\u54E6\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4ED6\u7684\u516C\u53F8\u4F1A\u5728\uFF13\u53F7\u9053\u8DEF\u524D\u9762\u7684\\n\u77FF\u5C71\u6316\u6398\u51FA\u77FF\u77F3\uFF0C\\r\\n\u7136\u540E\u628A\u5B83\u8F6C\u6362\u6210\u80FD\u6E90\u54E6\u3002[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6362\u53E5\u8BDD\u8BF4\uFF0C\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u80FD\u6E90\\n\u4E5F\u662F\u4F1A\u957F\u4E00\u624B\u6491\u8D77\u6765\u7684\u3002[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\u867D\u7136\u6709\u70B9\u8BA9\u4EBA\u6349\u6478\u4E0D\u900F\uFF0C\\n\u4F46\u4ED6\u771F\u7684\u5F88\u4E86\u4E0D\u8D77\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9001\u4F60\u4E00\u6761\u79BB\u6D1E\u7EF3\u5427\u3002\\n\u5C31\u5F53\u662F\u4F60\u966A\u6211\u804A\u5929\u7684\u8C22\u793C\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u987A\u4FBF\u4E5F\u5E2E\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u6062\u590D\u6D3B\u529B\u597D\u4E86\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u867D\u7136\u8349\u8DEF\u9547\u79BB\u8FD9\u91CC\u4E5F\u5F88\u8FDC\uFF0C\\n\u4F46\u8FD9\u6BB5\u8DEF\u4E5F\u7B97\u662F\u4E00\u79CD\u6311\u6218\u561B\uFF01\\r\\n\u52A0\u6CB9\u5427\uFF0C\u9053\u9986\u6311\u6218\u8005\uFF01[VAR 0114(000B)]"
  }
]
