    "index": 0,
    "flags": 0,
    "text": "\u4F60\u8981\u524D\u5F80\u5BF9\u6218\u573A\u5417\uFF1F\\n\u5F00\u5E55\u5F0F\u5C31\u5FEB\u8981\u5F00\u59CB\u4E86\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8981\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u795D\u4F60\u597D\u8FD0\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u8FD8\u8981\u548C\u5176\u4ED6\u9009\u624B\u804A\u4E00\u804A\u5417\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8EAB\u4E3A\u4E00\u4E2A\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF0C\\n\u4E3A\u4E86\u8BA9\u81EA\u5DF1\u751F\u5B58\u5230\u5E95\uFF0C\\r\\n\u6211\u4F1A\u4E0D\u505C\u5730\u6311\u6218\uFF01\\c\\n\u53EA\u8981\u6301\u7EED\u6311\u6218\uFF0C\\n\u8BAD\u7EC3\u5BB6\u5C31\u80FD\u4E0D\u65AD\u7EFD\u653E\u5149\u8292\u3002[VAR 0114(0010)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7B2C\u4E00\u573A\u5C31\u9047\u4E0A\u5947\u5DF4\u7EB3\uFF0C\\n\u6211\u600E\u4E48\u8FD9\u4E48\u5012\u9709\u554A\uFF5E\\c\\n\u4E0D\u7BA1\u4ED6\u600E\u4E48\u53D8\u6362\u5929\u6C14\uFF0C\\n\u6211\u90FD\u8981\u6491\u4E0B\u53BB\u624D\u884C\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u597D\u4E45\u4E0D\u89C1\uFF01\u5982\u679C\u8BF4\u9053\u9986\u6311\u6218\u662F\\n\u6D4B\u8BD5\u5B9E\u529B\u7684\u6BD4\u8D5B\uFF0C\u90A3\u63A5\u4E0B\u6765\u8981\u9762\u5BF9\u7684\\r\\n\u5C31\u662F\u52A8\u771F\u683C\u7684\u8F83\u91CF\u4E86\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u771F\u662F\u4E0D\u53EF\u601D\u8BAE\u2026\u2026\\n\u6211\u73B0\u5728\u786E\u5B9E\u6709\u4E9B\u5FC3\u795E\u4E0D\u5B81\uFF0C\\r\\n\u4F46\u66F4\u591A\u7684\u8FD8\u662F\u5BF9\u6BD4\u8D5B\u7684\u8FEB\u4E0D\u53CA\u5F85\uFF01[VAR 0114(0011)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u4F1A\u901F\u6218\u901F\u51B3\u7684\u3002\\c\\n\u76EE\u6807\u53EA\u6709\u4E00\u4E2A\uFF01\\n\u628A\u6211\u4EEC\u7684\u7CBE\u5F69\u8868\u6F14\u6DF1\u6DF1\u5730\\r\\n\u523B\u5728\u89C2\u4F17\u7684\u8111\u6D77\u4E4B\u4E2D\u3002[VAR 0114(0014)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u8D62\u5230\u6700\u540E\uFF0C\u6311\u6218\u4E39\u5E1D\uFF01\\n\u8FD9\u5C31\u662F\u672C\u5927\u7237\u552F\u4E00\u7684\u76EE\u6807\uFF01\\c\\n\u4E0D\u7136\u7684\u8BDD\uFF0C\\n\u6211\u5C31\u6CA1\u8138\u53BB\u89C1\u94DD\u94A2\u9F99\u5B83\u4EEC\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8D62\u5230\u6700\u540E\u5C31\u662F\u6211\u7684\u76EE\u6807\u5427\u3002\\c\\n\u6211\u4F1A\u575A\u6301\u4E0D\u4F7F\u7528\u6781\u5DE8\u5316\u8D62\u5F97\u80DC\u5229\uFF0C\\n\u4E3A\u5C16\u9489\u9547\u7684\u5927\u5BB6\u627E\u56DE\u81EA\u5C0A\u548C\u7B11\u5BB9\u3002[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5F00\u5E55\u5F0F\u9A6C\u4E0A\u5C31\u8981\u5F00\u59CB\u4E86\u3002\\n\u8BF7\u524D\u5F80\u5BF9\u6218\u573A\u5427\u3002"
  }
]
