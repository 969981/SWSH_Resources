  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4ECE\u540C\u4E00\u4E2A\u9547\u4E0A\u51FA\u53D1\u5192\u9669\uFF0C\\n\u7EC4\u5EFA\u4E86\u5404\u81EA\u6700\u5F3A\u7684\u961F\u4F0D\uFF0C\\r\\n\u7528\u5C3D\u5F7C\u6B64\u7684\u5168\u529B\u5BF9\u6218\u2026\u2026[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5168\u529B\u4E89\u80DC\u7684\u5FC3\u60C5\u548C\u6C38\u4E0D\u8A00\u8D25\u7684\u6597\u5FD7\uFF0C\\n\u90FD\u4F53\u73B0\u5728\u4F60\u4EEC\u7684\u4E00\u62DB\u4E00\u5F0F\u4E4B\u4E2D\u3002\\c\\n\u65E0\u8BBA\u4ECE\u54EA\u4E2A\u89D2\u5EA6\u770B\uFF0C\\n\u4F60\u4EEC\u7684\u6BD4\u8D5B\u90FD\u662F\u7EAF\u7CB9\u7684\u8F83\u91CF\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5F53\u521D\u5C45\u7136\u8FD8\u6709\u4E2A\u8BAD\u7EC3\u5BB6\\n\u72B9\u8C6B\u8981\u4E0D\u8981\u7ED9\u4F60\u4EEC\u63A8\u8350\u51FD\u2026\u2026\\r\\n\u771F\u662F\u96BE\u4EE5\u7F6E\u4FE1\u2026\u2026[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5927\u54E5\uFF0C\u4F60\u8BF4\u7684\u4E0D\u662F\u4F60\u81EA\u5DF1\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 5,
