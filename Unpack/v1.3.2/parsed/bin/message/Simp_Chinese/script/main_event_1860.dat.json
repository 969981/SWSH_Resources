[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5582\u2026\u2026\uFF01\u522B\u8DD1\u554A\uFF01\\n\u6211\u4EEC\u9700\u8981\u4F60\u4EEC\u5E2E\u5FD9\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u4EEC\u2026\u2026\u5728\u505A\u4EC0\u4E48\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\uFF01\u4F60\u4E5F\u770B\u5230\u4E86\u5427\uFF1F\\n\u90A3\u4E24\u53EA\u5B9D\u53EF\u68A6\u5C31\u662F\u5251\u548C\u76FE\uFF01\\r\\n\u4E0D\u8FC7\uFF0C\u5B83\u4EEC\u6D88\u5931\u5728\u68EE\u6797\u91CC\u4E86\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u4E0D\u662F\u5728\u505A\u68A6\u5427\uFF1F\\n\u521A\u624D\u8FD9\u91CC\u53EA\u6709\u4F60\u4EEC\u4E24\u4E2A\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u554A\u2026\u2026\uFF1F\\n\u90A3\u6211\u4EEC\u770B\u5230\u7684\u662F\u5E7B\u5F71\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u6DF1\u5165\u7814\u7A76\u4E86\u5916\u56FD\u7684\u6587\u732E\uFF0C\\n\u7EC8\u4E8E\u67E5\u5230\u4E86\u5251\u548C\u76FE\u7684\u8BB0\u5F55\u3002\\c\\n\u5251\u7684\u5B9D\u53EF\u68A6\u53EB\u505A\u82CD\u54CD\uFF0C\\n\u76FE\u7684\u5B9D\u53EF\u68A6\u53EB\u505A\u85CF\u739B\u7136\u7279\u3002\\c\\n\u636E\u8BF4\u5B83\u4EEC\u662F\u751F\u4E8E\u9065\u8FDC\u7684\u5730\u65B9\u2026\u2026\\n\u6765\u81EA\u5FAE\u5BD0\u68EE\u6797\u53E6\u4E00\u7AEF\u7684\u5B9D\u53EF\u68A6\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u662F\u8FD9\u6837\u554A\u2026\u2026\\n\u8C22\u5566\uFF0C\u7D22\u59AE\u4E9A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u597D\u554A\uFF01\u867D\u7136\u53EA\u662F\u5E7B\u5F71\uFF0C\\n\u4F46\u6211\u4EEC\u603B\u7B97\u53C8\u9047\u5230\u5B83\u4EEC\u4E86\uFF01\\c\\n\u5B83\u4EEC\u7528\u8FC7\u7684\u5251\u548C\u76FE\u5E94\u8BE5\u4E5F\u4E00\u5B9A\u5B58\u5728\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u82CD\u54CD\u548C\u85CF\u739B\u7136\u7279\u2026\u2026\\c\\n\u8FD9\u4E24\u53EA\u88AB\u79F0\u4E3A\u5251\u548C\u76FE\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u53EF\u80FD\u5C31\u6C89\u7761\u5728\u79BB\u6545\u4E61\u66F4\u8FD1\u7684\u5FAE\u5BD0\u68EE\u6797\u3002\\c\\n\u800C\u4E14\uFF0C\u5E94\u8BE5\u662F\u5728\u5E7D\u9759\u5B89\u9038\uFF0C\\n\u6CA1\u4EBA\u4F1A\u9760\u8FD1\u7684\u68EE\u6797\u6DF1\u5904\u2026\u2026[VAR 0114(000B)]"
  }
]
