[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54DF\uFF0C[VAR 0100(0000)]\uFF01\\n\u4F60\u6253\u8D62\u4E86\u5947\u5DF4\u7EB3\uFF0C\u5B8C\u6210\u4E86\u9053\u9986\u6311\u6218\uFF01\\r\\n\u771F\u662F\u597D\u6837\u7684\uFF01\u606D\u559C\u4F60\u554A\uFF01\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u867D\u7136\u6211\u662F\u5F88\u60F3\u7ACB\u523B\u4E3A\u4F60\u5E86\u795D\uFF0C\\n\u4E0D\u8FC7\u6709\u4E2A\u4E8B\u4F60\u4E5F\u6765\u542C\u4E00\u4E0B\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u62F3\u5173\u5E02\u53D1\u51FA\u7684\u5149\u2026\u2026\\c\\n\u548C\u5F88\u4E45\u4EE5\u524D\\n\u5DE8\u5927\u5B9D\u53EF\u68A6\u56DB\u5904\u4F5C\u4E71\uFF0C\\r\\n\u5DEE\u70B9\u6BC1\u706D\u4E86\u4F3D\u52D2\u5C14\u5730\u533A\u7684\\r\\n\u95C7\u591C\u662F\u4E00\u6837\u7684\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u597D\u50CF\u662F\u8FD9\u6837\u3002\\c\\n\u8BB8\u613F\u661F\u843D\u5730\u4E4B\u540E\u4F1A\u91CA\u653E\u51FA\u5F88\u591A\u80FD\u91CF\u3002\\n\u8FD9\u4E9B\u80FD\u91CF\u4E5F\u88AB\u6211\u4EEC\u8FD0\u7528\u5728\\r\\n\u5B9D\u53EF\u68A6\u7684\u6781\u5DE8\u5316\u4E0A\u3002[VAR 0114(000A)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u53EF\u662F\uFF0C\\n\u6211\u4EEC\u4E0D\u77E5\u9053\u5982\u4F55\u63A7\u5236\u8FD9\u80A1\u80FD\u91CF\u3002\\c\\n\u6700\u76F4\u63A5\u7684\u539F\u56E0\u5C31\u662F\uFF0C\\n\u6211\u4EEC\u8FD8\u6CA1\u6709\u6478\u6E05\u4E24\u4F4D\u82F1\u96C4\u7684\u771F\u9762\u76EE\u3002[VAR 0114(000A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F20\u8BF4\u7684\u5251\u548C\u76FE\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\uFF0C\u6211\u4EB2\u7231\u7684\u5B59\u5973\u3002\\n\u6211\u5148\u628A\u8FD9\u8EAB\u767D\u8863\u4EA4\u7ED9\u4F60\u4E86\u3002[VAR 0114(000A)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54CE\uFF1F\u5976\u5976\uFF0C\u771F\u7684\u53EF\u4EE5\u5417\uFF1F\\n\u6211\u8FD8\u6CA1\u5B8C\u6210\u4F60\u4EA4\u4EE3\u7684\u4EFB\u52A1\u5462\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5012\u4E0D\u5982\u8BF4\uFF0C\\n\u8FD9\u662F\u4E3A\u4E86\u5E2E\u4F60\u5B8C\u6210\u4EFB\u52A1\u3002[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\u535A\u58EB\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u771F\u9177\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8C22\u3001\u8C22\u5566\u2026\u2026\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5728\u95C7\u591C\u964D\u4E34\u4E4B\u9645\\n\u4FDD\u536B\u4E86\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u4E24\u4F4D\u82F1\u96C4\u2026\u2026\\c\\n\u4F60\u521A\u521A\u63D0\u5230\u7684\u4F20\u8BF4\u4E2D\u7684\u5251\u548C\u76FE\\n\u8FD8\u9690\u85CF\u4E86\u4E0D\u4E3A\u4EBA\u77E5\u7684\u79D8\u5BC6\u2026\u2026\\r\\n\u53BB\u63ED\u5F00\u8C1C\u5E95\uFF0C\u8FD8\u539F\u771F\u76F8\u5427\uFF01[VAR 0114(000A)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u597D\u7684\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u5F88\u671F\u5F85\u80FD\u770B\u5230\\n\u4F60\u548C\u8D6B\u666E\u6311\u6218\u4E39\u5E1D\uFF01\\c\\n\u6240\u4EE5\uFF0C\u5269\u4E0B\u7684\u4E8B\u90FD\u4EA4\u7ED9\u59D0\u59D0\u6211\u4E86\uFF01\\n\u4F60\u5C31\u653E\u5FC3\u5730\u5230\u8F66\u7AD9\u4E58\u5750\u5217\u8F66\u53BB\u5BAB\u95E8\u5E02\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8F66\u7AD9\u4E0D\u662F\u5728\u5FEB\u5230\uFF17\u53F7\u9053\u8DEF\u90A3\u8FB9\u5417\uFF1F\\n\u5FEB\u53BB\u5427\uFF0C\u9053\u9986\u6311\u6218\u8005\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6709\u4E9B\u4E8B\u662F\u4F60\u8FD9\u6837\u7684\u5E74\u8F7B\u4EBA\u80FD\u505A\u7684\u2026\u2026\\n\u6709\u4E9B\u4E8B\u662F\u6211\u8FD9\u6837\u4E0A\u5C81\u6570\u7684\u8BE5\u505A\u7684\u2026\u2026\\r\\n\u6211\u4EEC\u90FD\u6709\u5404\u81EA\u7684\u804C\u8D23\u554A\u3002[VAR 0114(000A)]"
  }
]
