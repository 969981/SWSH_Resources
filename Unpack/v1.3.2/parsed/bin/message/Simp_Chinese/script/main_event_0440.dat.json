[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54DF\uFF01\u5E74\u8F7B\u4EBA\uFF0C\\n\u770B\u6765\u4F60\u4EEC\u529E\u7406\u597D\u62A5\u5230\u624B\u7EED\u4E86\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\uFF1F\\n\u4F60\u600E\u4E48\u4F1A\u5728\u65C5\u5E97\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u5728\u8C03\u67E5\u4F20\u95FB\u5728\u5FAE\u5BD0\u68EE\u6797\u4E2D\\n\u51FA\u73B0\u7684\u795E\u79D8\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u6211\u60F3\uFF0C\u4E5F\u8BB8\u53EF\u4EE5\u4ECE\u4F3D\u52D2\u5C14\u5730\u533A\u7684\\n\u4F20\u8BF4\u4E2D\u627E\u5230\u4E00\u4E9B\u7EBF\u7D22\u3002\\c\\n\u65E2\u7136\u4F60\u4EEC\u4E5F\u5728\uFF0C\\n\u8981\u4E0D\u8981\u501F\u8FD9\u4E2A\u673A\u4F1A\u4E00\u8D77\u770B\u770B\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u662F\u4EC0\u4E48\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD9\u662F\u4F20\u8BF4\u4E2D\u62EF\u6551\u4E86\\n\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u82F1\u96C4\u54E6\u3002\\r\\n\u9700\u8981\u6211\u8BF4\u660E\u4E00\u4E0B\u5417\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8BF4\u660E\u5F97\u7B80\u77ED\u4E00\u4E9B\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8BF4\u660E\u5F97\u8BE6\u7EC6\u4E00\u4E9B"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5F88\u4E45\u4EE5\u524D\u2026\u2026\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u4E0A\u7A7A\\n\u51FA\u73B0\u4E86\u9ED1\u8272\u7684\u65CB\u6DA1\u2026\u2026\\r\\n\u4EBA\u4EEC\u628A\u5B83\u79F0\u4E3A\u201C\u95C7\u591C\u201D\u3002\\c\\n\u5404\u5730\u51FA\u73B0\u4E86\u5DE8\u5927\u7684\u5B9D\u53EF\u68A6\\n\u641E\u5F97\u4EBA\u4EEC\u4E0D\u5F97\u5B89\u5B81\u2026\u2026\\c\\n\u6B64\u65F6\uFF0C\u4E00\u4F4D\u62FF\u7740\u5251\u548C\u76FE\u7684\u5E74\u8F7B\u4EBA\\n\u633A\u8EAB\u800C\u51FA\uFF0C\u5E73\u606F\u4E86\u8FD9\u573A\u9A9A\u4E71\u2026\u2026\\c\\n\u8FD9\u5C0A\u96D5\u50CF\u5C31\u662F\u4EE5\u8FD9\u4F4D\u4F20\u8BF4\u4E2D\u7684\u5E74\u8F7B\u4EBA\u2014\u2014\\n\u4EBA\u4EEC\u5FC3\u4E2D\u7684\u82F1\u96C4\u4E3A\u539F\u578B\u5851\u9020\u7684\u54E6\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u6CA1\u6709\u4EBA\u77E5\u9053\u82F1\u96C4\u5F53\u65F6\\n\u62FF\u7684\u5230\u5E95\u662F\u4EC0\u4E48\u6837\u7684\u5251\u548C\u76FE\u3002\\c\\n\u800C\u4E14\uFF0C\u9ED1\u8272\u65CB\u6DA1\u5230\u5E95\u662F\u4EC0\u4E48\uFF0C\\n\u4E5F\u8FD8\u662F\u672A\u89E3\u4E4B\u8C1C\u2026\u2026\\c\\n\u4F46\u56E0\u4E3A\u5B83\u7B3C\u7F69\u4E86\u4F3D\u52D2\u5C14\u7684\u5929\u7A7A\uFF0C\\n\u6240\u4EE5\u4E5F\u88AB\u79F0\u4E3A\u95C7\u591C\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD9\u6837\u554A\u2026\u2026\u4E5F\u5C31\u662F\u8BF4\uFF0C\\n\u8FD9\u4E2A\u82F1\u96C4\u5C31\u50CF\u6211\u5927\u54E5\u4E00\u6837\u5389\u5BB3\u54AF\uFF01\\c\\n\u4E0D\u8FC7\u7D22\u59AE\u4E9A\uFF0C\u6211\u5F88\u540C\u60C5\u4F60\u554A\u3002\\n\u53C8\u662F\u9ED1\u8272\u65CB\u6DA1\uFF0C\u53C8\u662F\u5251\u554A\u76FE\u554A\u4E4B\u7C7B\u7684\uFF0C\\r\\n\u4F60\u8981\u8C03\u67E5\u7684\u4E1C\u897F\u4E5F\u592A\u591A\u4E86\u5427\u3002[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u80FD\u884C\u7684\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6CA1\u95EE\u9898\u5417\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8C22\u8C22\uFF01\u6211\u60F3\u603B\u4F1A\u6709\u529E\u6CD5\u7684\u3002[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u55EF\uFF0C\u603B\u8981\u60F3\u51FA\u4E2A\u529E\u6CD5\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4ECA\u665A\u8981\u4F4F\u5728\u65C5\u5E97\u7684\u8BDD\uFF0C\\n\u5C31\u5148\u53BB\u529E\u7406\u5165\u4F4F\u5427\u3002\\c\\n\u867D\u7136\u67DC\u53F0\u90A3\u8FB9\u597D\u50CF\u6709\u70B9\u5435\u3002[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\u7684\uFF01\u8981\u662F\u6709\u4E86\u65B0\u53D1\u73B0\uFF0C\\n\u6211\u4E5F\u4F1A\u544A\u8BC9\u4F60\u7684\u3002[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u53EA\u8981\u548C\u67DC\u53F0\u90A3\u91CC\u7684\u4EBA\u8BF4\u4E00\u58F0\uFF0C\\n\u5C31\u80FD\u529E\u7406\u5165\u4F4F\u624B\u7EED\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u8D6B\u666E\u5C31\u62DC\u6258\u4F60\u7167\u987E\u4E86\u3002\\c\\n\u4E39\u5E1D\u4E5F\u662F\u5144\u4EE3\u7236\u804C\uFF0C\\n\u4E00\u76F4\u5BF9\u8D6B\u666E\u653E\u5FC3\u4E0D\u4E0B\u5462\u3002[VAR 0114(000B)]"
