[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9053\u3001\u9053\u9986\u6311\u6218\u8005\uFF01\\n\u5FEB\u3001\u5FEB\u6765\u5E2E\u5FD9\uFF01\\r\\n\u4E0D\uFF0C\u6C42\u6C42\u4F60\u5E2E\u6211\u8FD9\u4E2A\u5FD9\u5427\uFF01\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E0D\u77E5\u4E3A\u4EC0\u4E48\uFF0C\\n\u6211\u7684\u5B9D\u53EF\u68A6\u7A81\u7136\u5C31\u6781\u5DE8\u5316\u4E86\uFF0C\\r\\n\u800C\u4E14\u8FD8\u5728\u7ADE\u6280\u573A\u5927\u95F9\u4E86\u8D77\u6765\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u867D\u7136\u5947\u5DF4\u7EB3\u2026\u2026\u4E0D\uFF0C\\n\u867D\u7136\u5947\u5DF4\u7EB3\u9986\u4E3B\u5DF2\u7ECF\u628A\u5B83\u5236\u670D\u4E86\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5982\u679C\u5176\u4ED6\u7684\u5B9D\u53EF\u68A6\u4E5F\u90FD\u6781\u5DE8\u5316\uFF0C\\n\u518D\u5927\u95F9\u4E00\u901A\u7684\u8BDD\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\u6240\u5728\u7684\u5730\u4E0B\u5DE5\u5382\\n\u4E00\u5B9A\u4F1A\u574D\u584C\u7684\uFF01\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u6211\u4E0D\u914D\u63D0\u51FA\u8FD9\u4E2A\u8BF7\u6C42\uFF0C\\n\u4F46\u662F\u6211\u8FD8\u662F\u8BF7\u6C42\u4F60\u7B54\u5E94\u6211\uFF01\\c\\n\u6C42\u6C42\u4F60\u5FEB\u53BB\u5730\u4E0B\u5DE5\u5382\\n\u963B\u6B62\u6D1B\u5179\u4F1A\u957F\u5427\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u88AB\u6D1B\u5179\u4F1A\u957F\u5524\u9192\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u65E0\u6781\u6C70\u90A3\u2026\u2026\\r\\n\u5B83\u8EAB\u4E0A\u91CA\u653E\u51FA\u7684\u80FD\u91CF\uFF0C\\r\\n\u597D\u50CF\u4F1A\u5F15\u8D77\u5B9D\u53EF\u68A6\u7684\u6781\u5DE8\u5316\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8FD9\u6837\u4E0B\u53BB\uFF0C\u4F3D\u52D2\u5C14\u5730\u533A\\n\u6240\u6709\u7684\u5B9D\u53EF\u68A6\u90FD\u4F1A\u6781\u5DE8\u5316\uFF0C\\r\\n\u5E76\u4E14\u56DB\u5904\u5927\u95F9\u7684\uFF01\\r\\n\u5982\u679C\u4E8B\u60C5\u771F\u7684\u53D1\u5C55\u5230\u90A3\u4E2A\u5730\u6B65\u2026\u2026\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6C42\u6C42\u4F60\u4E86\uFF01\\n\u8BF7\u4F60\u5FEB\u5750\u90A3\u8FB9\u7684\u7535\u68AF\u4E0B\u53BB\\r\\n\u6551\u6551\u6D1B\u5179\u4F1A\u957F\u5427\uFF01\\c\\n\u6211\u4E5F\u62DC\u6258\u4E86\u51A0\u519B\u7684\u5F1F\u5F1F\uFF0C\\n\u4F46\u4E0D\u77E5\u9053\u73B0\u5728\u600E\u6837\u4E86\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u600E\u4E48\u4F1A\u8FD9\u6837\uFF1F\u65E0\u6781\u6C70\u90A3\u5B83\u2026\u2026\\n\u554A\u554A\uFF0C\u6D1B\u5179\u4F1A\u957F\u2026\u2026[VAR 0114(0007)]"
  }
]
