[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54CE\u5440\uFF0C\u8D6B\u666E\uFF0C\\n\u4F60\u7684\u6BDB\u8FAB\u7F8A\u6709\u65B0\u670B\u53CB\u4E86\u554A\u3002[VAR 0114(000A)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u5C31\u662F[VAR 0100(0000)]\u5427\u3002\\c\\n\u7D22\u59AE\u4E9A\u7ED9\u4F60\u7684\u5B9D\u53EF\u68A6\u56FE\u9274\uFF0C\\n\u5E0C\u671B\u4F60\u80FD\u4EB2\u624B\u5C06\u5B83\u5B8C\u6210\u554A\u3002[VAR 0114(000A)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8BDD\u8BF4[VAR 0100(0000)]\uFF0C\\n\u4F60\u77E5\u9053\u6781\u5DE8\u5316\u5427\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6728\u5170\u535A\u58EB\u4E00\u76F4\u5728\u7814\u7A76\u6781\u5DE8\u5316\u3002\\c\\n\u6BD5\u7ADF\uFF0C\u8981\u60F3\u719F\u7EC3\u8FD0\u7528\u6781\u5DE8\u5316\uFF0C\\n\u77E5\u8BC6\u4E5F\u662F\u5FC5\u4E0D\u53EF\u5C11\u7684\u3002[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E39\u5E1D\uFF0C\\n\u4F60\u771F\u662F\u6EE1\u8111\u5B50\u90FD\u662F\u5B9D\u53EF\u68A6\u554A\u3002\\c\\n\u4E16\u4E0A\u8FD8\u6709\u5F88\u591A\u4E8B\u60C5\u503C\u5F97\u4F60\u53BB\u63A2\u7D22\u3002\\n\u5C31\u50CF\u2026\u2026\\r\\n\u7EA2\u8336\u4E5F\u6709\u6570\u4E0D\u6E05\u7684\u79CD\u7C7B\u54E6\u3002[VAR 0114(000A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u535A\u58EB\uFF0C\u5E2E\u5E2E\u5FD9\u561B\uFF0C\\n\u4F60\u4E5F\u66FF\u6211\u529D\u529D\u5927\u54E5\uFF0C\\r\\n\u8BA9\u4ED6\u63A8\u8350\u6211\u4EEC\u53C2\u52A0\u9053\u9986\u6311\u6218\u5427\u3002[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u662F\u554A\uFF0C\u4E39\u5E1D\uFF0C\\n\u4F60\u4E3A\u4EC0\u4E48\u4E0D\u63A8\u8350\u4ED6\u4EEC\u5462\uFF1F[VAR 0114(000A)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5176\u5B9E\u8D6B\u666E\u548C[VAR 0100(0000)]\\n\u90FD\u624D\u521A\u521A\u63A5\u89E6\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u8FD8\u79F0\u4E0D\u4E0A\u662F\u8001\u7EC3\u7684\u8BAD\u7EC3\u5BB6\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u54CE\u5440\u5440\u2026\u2026\u4F60\u4E0D\u662F\u5E0C\u671B\\n\u4F3D\u52D2\u5C14\u5730\u533A\u6240\u6709\u7684\u8BAD\u7EC3\u5BB6\\r\\n\u90FD\u53D8\u5F97\u66F4\u5F3A\u5417\uFF1F[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u554A\u2026\u2026\uFF01\u60A8\u8BF4\u5F97\u6CA1\u9519\u554A\u3002\\c\\n\u6211\u600E\u4E48\u4F1A\u5FD8\u8BB0\u8FD9\u4E48\u91CD\u8981\u7684\u4E8B\u5462\uFF1F\\n\u8FD9\u4E5F\u662F\u6211\u628A\u5B9D\u53EF\u68A6\u4EA4\u7ED9\u4ED6\u4EEC\u7684\u521D\u8877\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\u90A3\u4F60\u4EEC\u4FE9\\n\u73B0\u5728\u5C31\u6765\u4E00\u573A\u7CBE\u5F69\u7684\u5BF9\u6218\uFF0C\\r\\n\u597D\u8BA9\u6211\u5FC3\u670D\u53E3\u670D\u5730\u63A8\u8350\u4F60\u4EEC\u5427\uFF01\\c\\n\u5F53\u7136\uFF0C\u6211\u4F1A\u5148\u5E2E\u4F60\u4EEC\u7684\u5B9D\u53EF\u68A6\\n\u6062\u590D\u6D3B\u529B\u7684\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\uFF01[VAR 0100(0000)]\uFF0C\\n\u6211\u5728\u5916\u9762\u7B49\u4F60\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5C3D\u60C5\u5730\u5BF9\u6218\uFF0C\\n\u4E0D\u4EC5\u53EF\u4EE5\u953B\u70BC\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u66F4\u662F\u81EA\u8EAB\u6210\u957F\u7684\u5FC5\u7ECF\u4E4B\u8DEF\u54E6\u3002[VAR 0114(000A)]"
  }
]
