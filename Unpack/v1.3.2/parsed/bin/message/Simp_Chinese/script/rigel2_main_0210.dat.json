  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u54DF\uFF5E\uFF1F\u4F60\u53EF\u771F\u61C2\u5F97\u8FCE\u5408\u4EBA\u3002[VAR 0114(0078)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u554A\u54C8\uFF01\u771F\u662F\u5BF9\u4E0D\u4F4F\u5566\uFF5E[VAR 0114(0078)]"
