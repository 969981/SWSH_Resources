  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u771F\u662F\u7684\uFF0C\u6211\u6539\u53D8\u4E3B\u610F\u4E86\uFF5E\uFF01\\n\u8FD9\u4E2A\u4F60\u66FF\u6211\u6536\u4E0B\u5427\uFF01[VAR 0114(0078)]"
