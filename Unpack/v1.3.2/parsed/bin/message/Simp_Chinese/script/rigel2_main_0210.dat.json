    "text": "\u603B\u3001\u603B\u4E4B\u90A3\u4EC0\u4E48\uFF01\\n\u6211\u4E3A\u4E86\u5C0F\u590F\u590F\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u7F1D\u5236\u4E86\u4E00\u5957\\n\u95EA\u95EA\u53D1\u5149\u7684\u63A2\u9669\u670D\uFF01\\r\\n\u4F60\u5FEB\u6362\u4E0A\u5B83\u7B49\u7740\u6211\u5427\u3002[VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u6211\u7684\u5929\uFF0C\u4F60\u662F\u60F3\u8981\u628A\u6211\u95EA\u778E\u5417\uFF01\uFF1F[VAR 0114(0078)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u5443\uFF5E\u641E\u4EC0\u4E48\uFF01\u600E\u4E48\u4F60\u7A7F\u5F97\u90A3\u4E48\u6B63\u5E38\uFF0C\\n\u4E00\u5230\u6211\u8FD9\u513F\u5C31\u53D8\u5F97\u8FD9\u4E48\u91D1\u95EA\u95EA\u4E86\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u54C7\uFF5E\u54C8\u54C8\uFF01\u90A3\u8FD8\u7528\u8BF4\uFF01\\n\u4F60\u53EF\u662F\u7238\u7238\u5F15\u4EE5\u4E3A\u50B2\u7684\u5973\u513F\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u2026\u2026\u5F53\u7136\u8981\u8BA9\u4F60\u7A7F\u5F97\u663E\u773C\u4E00\u70B9\uFF0C\\n\u53EB\u5468\u56F4\u7684\u4EBA\u90FD\u770B\u770B\u6211\u5973\u513F\u6709\u591A\u68D2\u5566\uFF01[VAR 0114(0076)]"
