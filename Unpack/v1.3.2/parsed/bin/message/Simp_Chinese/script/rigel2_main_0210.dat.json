  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u2026\u2026\u5443\uFF0C\u5E72\u561B\u5E72\u561B\uFF0C\\n\u4F60\u4FE9\u600E\u4E48\u663E\u5F97\u8FD9\u4E48\u5C34\u5C2C\uFF1F[VAR 0114(0078)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u5514\u5662\u5662\u5662\uFF01\u73B0\u3001\u73B0\u5728\u3001\u7ACB\u523B\u3001\u9A6C\u4E0A\uFF01\\n\u6211\u5C31\u53BB\u4E3A\u4F60\u6784\u601D\u65B0\u7684\u4F20\u8BF4\uFF01\\r\\n\u4F60\u7A0D\u5FAE\u7B49\u6211\u4E00\u5C0F\u4E0B\u5C31\u597D\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u4F60\u53EF\u4E00\u5B9A\u8981\u8DDF\u7238\u7238\u4E00\u8D77\u63A2\u9669\u54EA\uFF01\\n\u597D\u4E0D\u597D\uFF01\u597D\u4E0D\u597D\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u5443\uFF0C\u4E0D\u662F\uFF0C\u6211\u8BF4\uFF0C\\n\u4EC0\u4E48\u53EB\u201C\u6784\u601D\u201D\u4F20\u8BF4\u554A\uFF1F[VAR 0114(0078)]"
