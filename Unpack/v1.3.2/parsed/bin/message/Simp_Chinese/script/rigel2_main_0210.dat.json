  {
    "index": 7,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u561B\u2026\u2026"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u2026\u2026\u6CA1\u4E8B\uFF01\\n\u4F60\u4E0D\u7528\u4E00\u4E94\u4E00\u5341\u5168\u90FD\u544A\u8BC9\u6211\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u770B\u770B\u961F\u957F\u7684\u8138\\n\u6211\u5C31\u77E5\u9053\u4E86\u3002[VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u80AF\u5B9A\u7ECF\u5386\u4E86\u4E00\u573A\u8D85\u7EA7\u65E0\u654C\\n\u5B8C\u7F8E\u5F97\u8981\u547D\u7684\u63A2\u9669\u65C5\u7A0B\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7136\u540E\uFF0C\u90A3\u573A\u63A2\u9669\u65C5\u7A0B\u4E2D\u7684\u4E00\u5207\uFF0C\\n\u90FD\u662F\u53EA\u5C5E\u4E8E\u4F60\u81EA\u5DF1\u7684\u8D22\u5BCC\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u53EF\u4E0D\u4F1A\u5E72\u90A3\u79CD\u5728\u4E00\u8FB9\\n\u8BF4\u4E09\u9053\u56DB\u6CFC\u51B7\u6C34\u7684\u4E8B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u961F\u957F\uFF01\\n\u8C22\u8C22\u4F60\u8BA4\u771F\u5BF9\u5F85\u6211\u7684\u4F20\u8BF4\u4E4B\u65C5\uFF0C\\r\\n\u66F4\u8C22\u8C22\u4F60\u73A9\u5F97\u8FD9\u4E48\u5F00\u5FC3\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4E3A\u4E86\u8868\u793A\u6211\u7684\u611F\u8C22\uFF0C\\n\u4F60\u6536\u4E0B\u8FD9\u4E2A\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u55EF\uFF1F\u4E0D\u8FC7\uFF0C\u603B\uFF5E\u89C9\u5F97\\n\u6211\u597D\u50CF\u5FD8\u4E86\u70B9\u4EC0\u4E48\u2026\u2026\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u771F\u662F\u7684\uFF5E\u8001\u7239\u4F60\u7684\u58F0\u97F3\\n\u4ECE\u5916\u9762\u90FD\u80FD\u542C\u5F97\u4E00\u6E05\u4E8C\u695A\uFF5E[VAR 0114(0078)]"
