[
  {
    "index": 0,
    "flags": 0,
    "text": "\u2026\u2026\u54CE\u5440\uFF1F\\n\u6211\u8BF4\uFF0C\u961F\u957F\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5230\u6B64\u4E3A\u6B62\uFF0C\u76AE\u6B27\u5C3C\u51FA\u54C1\u7684\\n\u4F20\u8BF4\u63A2\u9669\u4E4B\u65C5\u2026\u2026\\r\\n\u4F60\u4E0D\u5C31\u5168\u90FD\u5B8C\u6210\u4E86\u5417\uFF1F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5514\u5662\u5662\u5662\u5662\uFF01\u53EF\u559C\u53EF\u8D3A\u554A\uFF01\\n\u8FD9\u53EF\u771F\u662F\u90A3\u5565\u5440\uFF01\u5389\u5BB3\u5F97\u8981\u547D\u554A\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\\n\u961F\u957F\u4F60\u70ED\u60C5\u53EF\u771F\u591F\u9AD8\u7684\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD9\u4E9B\u4F20\u8BF4\u4E4B\u65C5\u7684\u4FE1\u606F\u90FD\u662F\u6211\\n\u4E1C\u62FC\u897F\u51D1\u8D77\u6765\u7684\uFF0C\u771F\u5047\u6211\u90FD\u62FF\u4E0D\u51C6\uFF0C\\r\\n\u4F60\u5012\u662F\u73A9\u5F97\u76F8\u5F53\u8D77\u52B2\u513F\u5462\u3002[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u96BE\u9053\u8BF4\uFF0C\u4F60\u771F\u7684\\n\u9047\u89C1\u4E86\u90A3\u4E9B\\r\\n\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u5417\uFF1F[VAR 0114(0076)]"
