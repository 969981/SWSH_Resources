    "text": "\u6781\u5DE8\u5927\u5192\u9669\u6211\u5DF2\u7ECF\\n\u73A9\u5F97\u633A\u5C3D\u5174\u7684\u4E86\u2026\u2026[VAR 0114(0078)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6240\u4EE5\u5C31\u60F3\u7740\uFF0C\u8981\u4E0D\u8981\u8FC7\u6765\u8BD5\u8BD5\u770B\\n\u8001\u7239\u641E\u7684\u90A3\u4E2A\u4EC0\u4E48\u4EC0\u4E48\u4E4B\u65C5\u5462\uFF5E[VAR 0114(0078)]"
