    "index": 17,
    "flags": 0,
    "text": "\u5C0F\u590F\u590F\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u54DF\uFF5E\uFF01\u4F60\u4F4F\u7684\u8FD9\u5730\u65B9\\n\u8FD8\u771F\u633A\u4E0D\u9519\u5462\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u554A\uFF5E\u4E0A\u6B21\u5728\u6781\u5DE8\u5DE2\u7A74\u7684\u5916\u9762\u89C1\u8FC7\u9762\u7684\\n[VAR 0100(0000)]\uFF01\u771F\u662F\u597D\u4E45\u4E0D\u89C1\uFF5E[VAR 0114(0078)]"
