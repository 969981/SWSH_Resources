[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6728\u6746\u9547\u7684\u5404\u4F4D\uFF01\\n\u6211\u662F\u51A0\u519B\u4E39\u5E1D\uFF01\\c\\n\u6211\u4ECA\u540E\u4E5F\u4F1A\u7528\u6700\u5F3A\u7684\u8868\u73B0\\n\u56DE\u62A5\u5404\u4F4D\u4E00\u5982\u65E2\u5F80\u7684\u652F\u6301\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u662F\u6211\u4EEC\u65E0\u654C\u7684\u51A0\u519B\uFF01\\n\u4F60\u548C\u55B7\u706B\u9F99\u7684\u7EC4\u5408\u662F\u6700\u68D2\u7684\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8C22\u8C22\uFF01\\c\\n\u5927\u5BB6\u4E5F\u90FD\u6765\u57F9\u80B2\u5B9D\u53EF\u68A6\uFF0C\\n\u4E0D\u65AD\u5730\u5207\u78CB\u5BF9\u6218\u5427\uFF01\\c\\n\u6211\u671F\u5F85\u5404\u4F4D\u524D\u6765\\n\u6311\u6218\u6211\u7684\u51A0\u519B\u5934\u8854\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6CA1\u95EE\u9898\uFF01\\n\u6211\u4EEC\u90FD\u662F\u56E0\u4E3A\u5D07\u62DC\u4F60\uFF0C\\r\\n\u624D\u4F1A\u5F00\u59CB\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u51A0\u519B\u7684\u55B7\u706B\u9F99\u5B9E\u5728\u662F\u592A\u5F3A\u4E86\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u55B7\u706B\u9F99\u786E\u5B9E\u5F88\u5F3A\uFF01\\n\u4F46\u662F\u5176\u4ED6\u7684\u5B9D\u53EF\u68A6\u4E5F\u5F88\u5F3A\uFF01\\c\\n\u6240\u4EE5\u6211\u624D\u4F1A\u671F\u5F85\u548C\\n\u6700\u5F3A\u7684\u6311\u6218\u8005\u5BF9\u6218\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6BD5\u7ADF\u6211\u7684\u7406\u60F3\u662F\\n\u8BA9\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u6240\u6709\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\\r\\n\u90FD\u80FD\u53D8\u5F97\u66F4\u5F3A\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u53ED\u557E\uFF01\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5927\u54E5\uFF5E\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u7684\u4E16\u754C\u5934\u53F7\u7C89\u4E1D\\n\u7ADF\u7136\u7279\u5730\u8DD1\u6765\u63A5\u6211\u4E86\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF01\u4F60\u957F\u9AD8\u4E86\u5427\uFF01\\n\u51C6\u786E\u5730\u8BF4\u2026\u2026\u4F60\u957F\u9AD8\u4E86\uFF13\u516C\u5206\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6CA1\u9519\uFF01\u4E0D\u6127\u662F\u5927\u54E5\uFF0C\\n\u4F60\u7684\u773C\u529B\u771F\u662F\u65E0\u654C\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u773C\u775B\u7684\u989C\u8272\u2026\u2026\\n\u6211\u77E5\u9053\u4E86\uFF01\\c\\n\u4F60\u5C31\u662F[VAR 0100(0000)]\u5427\uFF1F\\n\u6211\u4ECE\u8D6B\u666E\u90A3\u91CC\u542C\u4E86\u4E0D\u5C11\u6709\u5173\u4F60\u7684\u4E8B\u3002[VAR 0114(0004)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u5F88\u559C\u6B22\u55B7\u706B\u9F99\uFF0C\\n\u662F\u4F3D\u52D2\u5C14\u5730\u533A\u5B9E\u529B\u6700\u5F3A\u7684\\r\\n\u5B9D\u53EF\u68A6\u51A0\u519B\u3002\\r\\n\u4EBA\u79F0\u65E0\u654C\u7684\u4E39\u5E1D\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5927\u54E5\uFF01[VAR 0100(0000)]\uFF01\\n\u6211\u4EEC\u8D5B\u8DD1\u56DE\u5BB6\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8D6B\u666E\u8FD9\u5C0F\u5B50\u2026\u2026\\n\u8FD8\u662F\u90A3\u4E48\u7231\u6BD4\u8D5B\u554A\uFF01\\c\\n\u8981\u662F\u6709\u4E2A\u597D\u7684\u7ADE\u4E89\u5BF9\u624B\uFF0C\\n\u4ED6\u4E00\u5B9A\u80FD\u53D8\u5F97\u66F4\u5F3A\u7684\u3002[VAR 0114(0004)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u518D\u4F1A\u4E86\uFF0C\u5404\u4F4D\uFF01\\n\u4ECA\u540E\u4E5F\u8BA9\u6211\u4EEC\u5171\u5EA6\u51A0\u519B\u65F6\u523B\u5427\uFF01[VAR 0114(0004)]"
  }
]
