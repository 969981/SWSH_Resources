  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u867D\u8BF4\u4ECE\u65F7\u91CE\u5730\u5E26\\n\u76F4\u7A7F\u8FC7\u53BB\u4E5F\u662F\u53EF\u884C\u7684\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F46\u6211\u4EEC\u5DF2\u7ECF\u62FF\u5230\u8FD9\u4E9B\u9053\u9986\u5FBD\u7AE0\u4E86\uFF0C\\n\u6240\u4EE5\u5C31\u7B97\u9047\u5230\u66F4\u5F3A\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u4E5F\u80FD\u6349\u5F97\u5230\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u597D\uFF01\u5C31\u8FD9\u4E48\u5B9A\u4E86\uFF01\\c\\n\u6211\u8981\u6349\u5230\u5389\u5BB3\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u4E3A\u6211\u7684\u4F20\u8BF4\u589E\u6DFB\u65B0\u7684\u4E00\u9875\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u522B\u767D\u8D39\u529B\u6C14\u4E86\u3002\\n\u53CD\u6B63\u4F60\u4EEC\u662F\u6253\u4E0D\u8FDB\u51B3\u8D5B\u7684\u3002[VAR 0114(000C)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u770B\u6765\u63A8\u8350\u4F60\u4EEC\u6765\u53C2\u8D5B\u7684\\n\u90A3\u4E2A\u51A0\u519B\u8111\u7B4B\u4E5F\u4E0D\u600E\u4E48\u6B63\u5E38\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u7279\u522B\u662F\u8D6B\u666E\uFF0C\\n\u4F60\u8FDE\u7CBE\u7075\u7403\u90FD\u6254\u5F97\u4E0D\u50CF\u6837\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u61C2\u4EC0\u4E48\uFF1F\\c\\n\u6211\u6254\u7403\u7684\u59FF\u52BF\u624D\u662F\u6700\u5F3A\u7684\u3002\\n\u800C\u4E14\u6211\u5927\u54E5\u662F\u4E16\u754C\u7B2C\u4E00\u7684\u51A0\u519B\uFF01\\r\\n\u8F6E\u5F97\u5230\u4F60\u6765\u8BF4\u4E09\u9053\u56DB\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u53EF\u771F\u662F\u6CA1\u6551\u4E86\u3002\\n\u6211\u5C31\u966A\u4F60\u5728\u90A3\u8FB9\u6765\u573A\u5BF9\u6218\u5427\u3002\\c\\n\u8FD9\u6837\u5C31\u80FD\u8BA9\u4F60\u6709\u70B9\u81EA\u77E5\u4E4B\u660E\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u5C31\u5634\u786C\u5427\uFF01\\c\\n\u4F60\u8FD9\u4E48\u5FEB\u5C31\u628A\u5728\u7B2C\u4E8C\u77FF\u5C71\\n\u8F93\u7ED9[VAR 0100(0000)]\u7684\u4E8B\u7ED9\u5FD8\u4E86\uFF1F\\c\\n\u8981\u77E5\u9053\u6211\u53EF\u662F[VAR 0100(0000)]\u7684\u52B2\u654C\uFF0C\\n\u4F60\u8D62\u4E0D\u4E86[VAR 1100(00FF,0101)]\u4ED6\u5979\uFF0C\u5C31\u4E0D\u53EF\u80FD\u8D62\u5F97\u4E86\u6211\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u53C8\u662F[VAR 0100(0000)]\uFF0C\u53C8\u662F\u51A0\u519B\u2026\u2026\\n\u4F60\u5C31\u4E0D\u80FD\u62FF\u81EA\u5DF1\u7684\u5B9E\u529B\u8BF4\u8BDD\u5417\uFF1F[VAR 0114(000C)]"
