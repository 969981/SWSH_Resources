[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54E6\u54DF\u54DF\uFF1F\\c\\n[VAR 0100(0000)]\u4F60\u548C\u718A\u5F92\u5F1F\\n\u76EE\u524D\u7684\u5173\u7CFB\u662F\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u4EEC\u8FD8\u4E00\u70B9\u90FD\u4E0D\u878D\u6D3D\u54EA\uFF5E\\c\\n\u603B\u4E4B\u5148\u548C\u5B83\u4E00\u8D77\u591A\u5171\u5EA6\u4E00\u4E9B\u65F6\u5149\uFF0C\\n\u52A0\u6DF1\u4F60\u4EEC\u4E4B\u95F4\u7684\u7275\u7ECA\u5427\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u597D\u4E5F\u4E0D\u574F\u7684\u611F\u89C9\u5427\uFF5E\uFF01\\c\\n\u8BA9\u5B83\u5728\u5BF9\u6218\u4E2D\u4E0D\u65AD\u53D8\u5F3A\uFF0C\\n\u4F60\u4EEC\u7684\u7275\u7ECA\u4E5F\u4F1A\u81EA\u7136\u800C\u7136\u5730\u52A0\u6DF1\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u4EEC\u597D\u50CF\u6E10\u6E10\u878D\u6D3D\u8D77\u6765\u4E86\u5462\uFF5E\uFF01\uFF1F\\c\\n\u8BA9\u5B83\u643A\u5E26\u5B89\u629A\u4E4B\u94C3\uFF0C\\n\u4F60\u4FE9\u7684\u5173\u7CFB\u8BF4\u4E0D\u5B9A\u5C31\u80FD\u7A81\u98DE\u731B\u8FDB\uFF0C\\r\\n\u4E00\u4E0B\u5B50\u53D8\u5F97\u8D85\u548C\u8C10\u7684\u5462\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u4EEC\u7684\u611F\u60C5\u53D8\u5F97\u76F8\u5F53\u4E0D\u9519\u4E86\u5462\uFF5E\uFF01\\c\\n\u522B\u5FD8\u4E86\uFF0C\u9732\u8425\u7684\u65F6\u5019\u966A\u5B83\u4E00\u8D77\u73A9\uFF0C\\n\u4E5F\u662F\u4FC3\u8FDB\u611F\u60C5\u7684\u597D\u65B9\u6CD5\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[~ 5]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u5728\u57CE\u9547\u5730\u56FE\u4E0A\u505A\u4E86\u8BB0\u53F7\uFF01\\n\u6807\u51FA\u4E86\u94E0\u5C9B\u4E0A\u7684\u6F02\u4EAE\u666F\u70B9\uFF01\\r\\n\u4F60\u4EEC\u5FEB\u4E00\u8D77\u8FC7\u53BB\u770B\u770B\u98CE\u666F\u5427\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u7B49\u4F60\u4EEC\u53D8\u6210\u597D\u670B\u53CB\u4EE5\u540E\uFF0C\\n\u54B1\u4EEC\u5C31\u53EF\u4EE5\u5F00\u59CB\u5E2E\u718A\u5F92\u5F1F\u4FEE\u884C\u54AF\u3002[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5457\u554A\uFF5E\u561B\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u55EF\u55EF\uFF01\\n\u4F60\u4EEC\u53D8\u5F97\u8D85\uFF5E\u7EA7\u8981\u597D\u4E86\u5462\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u718A\u5F92\u5F1F\u6210\u957F\u5F97\u6B63\u76F4\u800C\u53C8\u5F3A\u5927\uFF0C\\n\u5B9E\u5728\u662F\u592A\u68D2\u4E86\u8036\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5982\u679C\u662F\u73B0\u5728\u7684\u4F60\u4EEC\u2026\u2026\u55EF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u2026\u2026\u4F60\u4EEC\u4E24\u4E2A\u90FD\\n\u8DDF\u8001\u5934\u513F\u6211\u6765\u4E00\u4E0B\u3002[VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u54E6\u54DF\u54DF\uFF1F[VAR 0100(0000)]\u7684\\n\u540C\u884C\u961F\u4F0D\u548C\u76D2\u5B50\u91CC\uFF0C\\r\\n\u90FD\u6CA1\u6709\u718A\u5F92\u5F1F\u554A\u2026\u2026\uFF1F[VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6CA1\u6709\u718A\u5F92\u5F1F\u7684\u8BDD\uFF0C\\n\u4FEE\u884C\u5C31\u5931\u53BB\u610F\u4E49\u4E86\u3002\\r\\n\u4F60\u786E\u5B9A\u8981\u7EE7\u7EED\u5417\uFF5E\uFF1F[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4E0D\u5E26\u718A\u5F92\u5F1F\u5C31\u8FDB\u884C\u4FEE\u884C\uFF0C\\n\u4F60\u786E\u5B9A\u4F60\u4E0D\u4F1A\u540E\u6094\u5417\uFF1F[VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u2026\u2026\u90A3\uFF0C\u4F60\u8DDF\u6211\u6765\u5427\u3002[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u54E6\u8036\uFF5E\uFF01\\n\u7B49\u4F60\u628A\u718A\u5F92\u5F1F\u5E26\u56DE\u6765\uFF0C\\r\\n\u54B1\u4EEC\u518D\u91CD\u65B0\u5F00\u542F\u4FEE\u884C\u5427\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u54E6\u54DF\u54DF\uFF1F\\n\u4F60\u628A\u718A\u5F92\u5F1F\u5BC4\u653E\u5230\u5BC4\u653E\u5C4B\u4E86\u5440\u3002\\c\\n\u7B49\u718A\u5F92\u5F1F\u56DE\u6765\u4EE5\u540E\uFF0C\\n\u518D\u8BA9\u6211\u770B\u770B\u4F60\u4EEC\u4FE9\u6709\u6CA1\u6709\u53D8\u6210\u597D\u670B\u53CB\u5427\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u54E6\u54DF\u54DF\uFF1F\\n\u718A\u5F92\u5F1F\u6B63\u5728\u5B9D\u53EF\u5E2E\u5E2E\u5FD9\u5DE5\u4F5C\u5440\u3002\\c\\n\u7B49\u718A\u5F92\u5F1F\u56DE\u6765\u4EE5\u540E\uFF0C\\n\u518D\u8BA9\u6211\u770B\u770B\u4F60\u4EEC\u4FE9\u6709\u6CA1\u6709\u53D8\u6210\u597D\u670B\u53CB\u5427\uFF5E[VAR 0114(0073)]"
  }
