  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64\uFF0C\u4F60\u5012\u662F\u6709\u4E24\u4E0B\u5B50\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u4F60\u8FD8\u662F\u6CA1\u6709\u901A\u8FC7\u9009\u62D4\u3002\\n\u5728\u6211\u770B\u6765\uFF0C\u4F60\u8FD8\u4E0D\u591F\u683C\u554A\u3002\\c\\n\u554A\uFF0C\u4F60\u53EF\u522B\u5F80\u5FC3\u91CC\u53BB\u3002\\n\u8FD9\u53EA\u662F\u6211\u4E2A\u4EBA\u7684\u559C\u597D\u95EE\u9898\u7F62\u4E86\u3002[VAR 0114(0013)]"
  },
  {
    "index": 9,
