  {
    "index": 0,
    "flags": 0,
    "text": "\u554A\uFF01[VAR 0100(0000)]\uFF01\\n\u4F60\u56DE\u6765\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u770B\u6765\u4F60\u5728\u6B66\u9986\u8FD9\u8FB9\\n\u4FEE\u884C\u5F97\u5F88\u52AA\u529B\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8D6B\u666E\u600E\u4E48\u4F1A\u5728\u8FD9\u513F\uFF01\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u54E6\uFF0C\u8D6B\u666E\u4E5F\u6765\u4E86\u554A"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u563F\u563F\u563F\uFF0C\u6211\u5C31\u7B49\u7740\u770B\u4F60\u8FD9\u6837\u7684\u53CD\u5E94\u5462\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5582\uFF01\u770B\u89C1\u6211\u4F60\u5C31\u4E00\u70B9\u90FD\u4E0D\u60CA\u8BB6\u5417\uFF01\uFF1F\\n\u591A\u5C11\u7ED9\u70B9\u53CD\u5E94\u5440\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u554A\uFF0C\u4E3A\u4E86\u8C03\u67E5\u6781\u5DE8\u5316\uFF0C\\n\u8981\u5728\u94E0\u5C9B\u5F85\u4E0A\u4E00\u9635\u5B50\u3002[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5475\u5475\u5475\uFF0C\\n\u542C\u8BF4\u4F60\u4EEC\u4E24\u4E2A\u4EBA\u662F\u670B\u53CB\u5462\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5C0F\u666E\u666E\u4ED6\u60F3\u8981\u5728\u94E0\u5C9B\u9732\u8425\uFF0C\\n\u8DD1\u5230\u6B66\u9986\u6765\u5411\u6211\u7533\u8BF7\u9732\u8425\u7684\u8BB8\u53EF\u3002\\c\\n\u4E0D\u8FC7\u4E00\u76F4\u5728\u91CE\u5916\u9732\u8425\u4E5F\u592A\u8F9B\u82E6\u4E86\uFF01\\n\u6240\u4EE5\u8001\u5934\u513F\u6211\u8DDF\u4ED6\u8BF4\uFF0C\u4E0D\u5982\u4F4F\u5728\u6B66\u9986\u5457\uFF1F[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u80FD\u4F4F\u5728\u6B66\u9986\u5F53\u7136\u4F1A\u8F7B\u677E\u5F88\u591A\uFF0C\\n\u4F46\u6211\u5728\u8FD9\u513F\u4E0D\u4F1A\u7ED9\u5927\u5BB6\u6DFB\u9EBB\u70E6\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9A6C\u5E08\u5085\u6B66\u9986\u4E0D\u7BA1\u4EC0\u4E48\u65F6\u5019\\n\u90FD\u655E\u5F00\u5927\u95E8\u6B22\u8FCE\u6240\u6709\u4EBA\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u800C\u4E14\u4F60\u8FD8\u662F\u5C0F\u4E39\u4E39\u7684\u5F1F\u5F1F\uFF0C\\n\u5BF9\u4E8E\u6211\u4EEC\u6765\u8BF4\uFF0C\u66F4\u662F\u81EA\u5BB6\u4EBA\u4E86\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5BF9\u54E6\u2026\u2026\u5C0F\u7684\u65F6\u5019\uFF0C\\n\u5927\u54E5\u4E5F\u66FE\u5728\u8FD9\u5EA7\u6B66\u9986\u91CC\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u9A6C\u58EB\u5FB7\u5E08\u5085\uFF01\\n\u6211\u8FD8\u662F\u51B3\u5B9A\u2026\u2026\\r\\n\u8981\u5728\u8FD9\u91CC\u53E8\u6270\u4E00\u9635\u5B50\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8036\uFF5E\uFF01\u5F53\u7136\u6CA1\u95EE\u9898\uFF5E\uFF01\\n\u4F60\u6765\u4E86\u5C31\u66F4\u70ED\u95F9\u5566\uFF0C\u60F3\u60F3\u5C31\u6B22\u4E50\u5462\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u8BDD\u8BF4[VAR 0100(0000)]\u554A\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5173\u4E8E\u718A\u5F92\u5F1F\u8FDB\u5316\u540E\u53D8\u6210\u7684\u5B9D\u53EF\u68A6\u6B66\u9053\u718A\u5E08\uFF0C\\n\u6211\u8FD8\u6709\u4EF6\u4E8B\u60C5\u8981\u8DDF\u4F60\u8BB2\u5462\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6B66\u9053\u718A\u5E08\u867D\u7136\\n\u8574\u85CF\u7740\u8D85\u6781\u5DE8\u5316\u7684\u53EF\u80FD\u6027\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F46\u5B83\u4E0D\u559C\u6B22\u6781\u5DE8\u83C7\u83C7\u7684\u5473\u9053\uFF0C\\n\u559D\u4E0D\u4E86\u6781\u5DE8\u6C64\u54E9\u3002[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u5982\u679C\u5728\u716E\u6C64\u7684\u65F6\u5019\u653E\u8FDB\\n\u80FD\u591F\u5728\u94E0\u5C9B\u627E\u5230\u7684[VAR FF00(0006)]\u67D0\u6837\u4E1C\u897F[VAR FF00(0000)]\u7684\u8BDD\uFF0C\\r\\n\u6B66\u9053\u718A\u5E08\u4E5F\u4F1A\u4E56\u4E56\u559D\u4E0B\u6781\u5DE8\u6C64\u4E86\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u8FD9[VAR FF00(0006)]\u67D0\u6837\u4E1C\u897F[VAR FF00(0000)]\u5C31\u662F\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u67D0\u6837\u4E1C\u897F\u5C31\u662F\u2026\u2026\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u67D0\u6837\u4E1C\u897F\u5C31\u662F\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5230\u5E95\u662F\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u8001\u5934\u513F\u6211\u7ED9\u5FD8\u4E86\u565C\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4EC0\u4E48\u561B\uFF5E\uFF01\u600E\u4E48\u80FD\u8FD9\u6837\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5475\u5475\u5475\uFF0C\\n\u9017\u4F60\u6BD4\u9017\u5C0F\u4E39\u4E39\u8FD8\u597D\u73A9\u8036\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u80FD\u8BA9\u6B66\u9053\u718A\u5E08\u4E5F\u80AF\\n\u4E56\u4E56\u559D\u4E0B\u6781\u5DE8\u6C64\u7684[VAR FF00(0006)]\u67D0\u6837\u4E1C\u897F[VAR FF00(0000)]\u2026\u2026\\r\\n\u8DDF\u5B9D\u53EF\u68A6\u6709\u5173\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u673A\u4F1A\u96BE\u5F97\uFF0C\u4E0D\u5982\u4F60\u4EEC\u4FE9\u5C31\\n\u4E00\u8D77\u60F3\u60F3\u770B\u3001\u4E00\u8D77\u627E\u627E\u770B\u5427\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u90A3\uFF0C\u5DEE\u4E0D\u591A\u5C31\u662F\u8FD9\u4E48\u56DE\u4E8B\u5566\u3002\\n\u62DC\u6258\u4F60\u4EEC\u565C\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u4F60\u4EEC\u5E73\u65F6\u7684\u4FEE\u884C\u90FD\u662F\u8FD9\u6837\u7684\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u53EA\u6709\u4E00\u90E8\u5206\u4FE1\u606F\uFF0C\u592A\u540A\u4EBA\u80C3\u53E3\u4E86\u3002\\n\u6211\u4E5F\u5F00\u59CB\u597D\u5947[VAR FF00(0006)]\u67D0\u6837\u4E1C\u897F[VAR FF00(0000)]\u5230\u5E95\u662F\u4EC0\u4E48\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u8BDD\u8BF4\uFF0C\u6211\u597D\u50CF\u5728\u54EA\u672C\u4E66\u91CC\\n\u770B\u5230\u8FC7\u5173\u4E8E\u6B66\u9053\u718A\u5E08\u7684\u4ECB\u7ECD\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6211\u8BB0\u5F97\uFF0C\u5B83\u662F\u4E00\u79CD\u62F3\u6CD5\u5B9D\u53EF\u68A6\uFF0C\\n\u5C45\u4F4F\u5728\u9065\u8FDC\u5730\u533A\u7684\u5C71\u5CB3\u5730\u5E26\u3002[VAR 0114(0005)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u662F\u5417\uFF01\uFF1F"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u8D6B\u666E\u53EF\u771F\u5389\u5BB3\uFF01"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u54A6\uFF1F[VAR 0100(0000)]\uFF0C\\n\u4F60\u81EA\u5DF1\u4E0D\u5C31\u6709\u90A3\u53EA\u5B9D\u53EF\u68A6\u5417\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6CA1\u6709\u5566\uFF0C\u521A\u597D\u770B\u5230\u8FC7\u800C\u5DF2\uFF01\\n\u56E0\u4E3A\u6211\u6700\u8FD1\u4E00\u76F4\u5728\u8C03\u67E5\u5916\u56FD\u7684\u5B9D\u53EF\u68A6\u561B\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6211\u8BB0\u5F97\u4E66\u91CC\u8BF4\u8FC7\uFF0C\\n\u6B66\u9053\u718A\u5E08\u8FD9\u79CD\u5B9D\u53EF\u68A6\u597D\u50CF\\r\\n\u6700\u559C\u6B22[VAR FF00(0006)]\u9ECF\u7A20\u7684\u871C\u6C41[VAR FF00(0000)]\u4E86\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u8981\u627E\u871C\u6C41\uFF0C\u5C31\u5F97\u53BB\u627E\u690D\u7269\uFF01\\r\\n\u8981\u627E\u690D\u7269\uFF0C\u5C31\u5F97\u53BB\u68EE\u6797\u91CC\u554A\uFF01[VAR 0114(0005)]"
