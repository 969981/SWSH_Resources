  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u539F\u6765\u662F\u8FD9\u6837\u554A\u2026\u2026"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4ECA\u5929\u665A\u4E0A\u80AF\u5B9A\u80FD\u7761\u4E2A\\n\u5B89\u7A33\u5F97\u8981\u547D\u7684\u597D\u89C9\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u600E\u4E48\u4E86\uFF0C\u961F\u957F\uFF1F\\n\u4F60\u5BF9\u6211\u7684\u6795\u5934\u611F\u5174\u8DA3\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u5C31\u770B\u770B"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u563F\u563F\u563F\uFF01\\n\u968F\u4F60\u770B\uFF01\\r\\n\u628A\u5B83\u70D9\u5370\u5728\u4F60\u7684\u773C\u73E0\u5B50\u4E0A\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4EC0\u3001\u4EC0\u4E48\uFF01\uFF1F\u4F60\u60F3\u8BA9\u6211\u628A\u8FD9\u4E2A\\n\u5B8C\u7F8E\u5F97\u8981\u547D\u7684\u4E1C\u897F\u4EA4\u7ED9\u4F60\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5C31\u7B97\u4F60\u662F\u961F\u957F\uFF0C\u8FD9\u4E2A\u8981\u6C42\u4E5F\\n\u8FD8\u662F\u6709\u70B9\u5F3A\u4EBA\u6240\u96BE\u4E86\u5427\u2026\u2026\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u2026\u2026\u55EF\uFF1F\u4F60\u8BF4\u4EC0\u4E48\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4F60\u89C9\u5F97\u8FD9\u4E1C\u897F\u8DDF\\n\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u597D\u50CF\u6709\u70B9\u5173\u7CFB\uFF1F[VAR 0114(0076)]"
