  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5BF9\u5427\uFF01\u8FD9\u4E1C\u897F\u7684\u5F62\u72B6\u548C\u786C\u5EA6\\n\u662F\u4E0D\u662F\u90FD\u5B8C\u7F8E\u5F97\u8981\u547D\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u771F\u662F\u7684\u2026\u2026\u961F\u957F\uFF0C\\n\u5C31\u8BA9\u6211\u6765\u5411\u4F60\u4F20\u6388\u4E00\u4E2A\u91CD\u8981\u7406\u5FF5\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53EA\u8981\u662F\u80FD\u628A\u8111\u888B\u6401\u4E0A\u53BB\u7684\u4E1C\u897F\\n\u2026\u2026\u5168\u90FD\u53EF\u4EE5\u53EB\u505A\u6795\u5934\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5176\u5B9E\u554A\uFF0C\u6211\u662F\u56E0\u4E3A\u628A\u6211\u6700\u559C\u6B22\u7684\u6795\u5934\\n\u843D\u5728\u5BB6\u91CC\u5FD8\u8BB0\u5E26\u8FC7\u6765\u4E86\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6240\u4EE5\u6765\u4E86\u4EE5\u540E\uFF0C\u5C31\u5728\u6751\u5B50\u91CC\u91CC\u5916\u5916\u4E00\u901A\u627E\uFF0C\\n\u60F3\u770B\u770B\u6709\u6CA1\u6709\u5408\u9002\u7684\u66FF\u4EE3\u54C1\u3002\\c\\n\u7ED3\u679C\uFF0C\u563F\uFF01\\n\u8FD8\u771F\u8BA9\u6211\u5728\u6C11\u5BBF\u540E\u9762\u7ED9\u627E\u5230\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
