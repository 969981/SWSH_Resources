  {
    "index": 2,
    "flags": 0,
    "text": "\u5440\u2026\u2026\u5BF9\u4E0D\u8D77\uFF01\\c\\n\u771F\u670D\u4E86\u5C16\u9489\u9547\u7684\u8FD9\u5E2E\u5BB6\u4F19\u2026\u2026\\n\u4ED6\u4EEC\u5C45\u7136\u8BF4\u5173\u4E0A\u5377\u5E18\u95E8\\r\\n\u90FD\u662F\u4E3A\u4E86\u6211\u7740\u60F3\u2026\u2026[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C16\u9489\u9547\u8D8A\u6765\u8D8A\u8427\u6761\u3002\\c\\n\u7136\u800C\u9053\u9986\u9986\u4E3B\u8042\u6893\u5374\u53EA\u662F\\n\u4E00\u4E2A\u52B2\u5730\u8BF4\u6CA1\u95EE\u9898\u3002[VAR 0114(0043)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6240\u4EE5\u2026\u2026\uFF01\\n\u6211\u4EEC\u624D\u4F1A\u4E54\u88C5\u6210\u5450\u558A\u961F\uFF0C\\r\\n\u5230\u5904\u59A8\u788D\u9053\u9986\u6311\u6218\u8005\u3002[VAR 0114(0044)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53EA\u8981\u8BA9\u5176\u4ED6\u7684\u6311\u6218\u8005\\n\u6765\u4E0D\u4E86\u8FD9\u4E2A\u9053\u9986\u2026\u2026\\c\\n\u90A3\uFF5E\u4E48\u80FD\u95EF\u5165\u51A0\u519B\u676F\u7684\\n\u5C31\u53EA\u5269\u4E0B\u5927\u5C0F\u59D0\u4E86\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u90A3\uFF5E\u6837\u4E00\u6765\uFF0C\u6211\u4EEC\u7684\u5927\u5C0F\u59D0\\n\u6210\u4E3A\u65B0\u664B\u51A0\u519B\u7684\u673A\u4F1A\u5C31\u66F4\u5927\u4E86\u3002[VAR 0114(0044)]"
