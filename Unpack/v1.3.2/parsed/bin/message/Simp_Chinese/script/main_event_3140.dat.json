    "text": "\u8FD8\u5269\u4E0B\uFF12\u4E2A\u7ADE\u6280\u573A\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u73B0\u5728\u53EA\u5269\u4E0B\u4E00\u4E2A\u7ADE\u6280\u573A\\n\u6709\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u4E86\u3002\\c\\n\u8BA9\u6211\u4EEC\u5FEB\u70B9\u7ED3\u675F\u8FD9\u573A\\n\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u5F15\u53D1\u7684\u9A9A\u4E71\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\uFF0C\u6211\u4EEC\u53EA\u8981\u6349\u4F4F\u897F\u7D22\u4E8C\u4EBA\u7EC4\\n\u5C31\u53EF\u4EE5\u5927\u529F\u544A\u6210\u4E86\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u4EEC\u5FC5\u987B\u8981\u6349\u4F4F\u8FD9\u4E24\u4E2A\u5BB6\u4F19\uFF01\\n\u5426\u5219\u4ED6\u4EEC\u53EF\u80FD\u8FD8\u4F1A\u5236\u9020\u7978\u5BB3\u554A\uFF01[VAR 0114(0005)]"
