    "text": "\u611F\u8C22\u6C5D\u521A\u624D\u4FDD\u62A4\u4E86\u6751\u5B50\u3002[VAR 0114(0079)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u7167\u7406\u6765\u8BF4\uFF0C\\n\u672C\u8BE5\u7531\u5B64\u53BB\u9A7E\u9A6D\u4F4F\u90A3\u53AE\u3002[VAR 0114(0079)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F46\u5B64\u7528\u5C3D\u529B\u6C14\uFF0C\\n\u4E5F\u53EA\u80FD\u7528\u610F\u5FF5\u903C\u5B83\u79BB\u53BB\u3002[VAR 0114(0079)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u82E5\u662F\u6709\u7275\u7ECA\u7F30\u7EF3\uFF0C\\n\u5C31\u80FD\u8F7B\u677E\u5730\u9A7E\u9A6D\u5B83\u4E86\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u4EEC\u6765\u5236\u4F5C\u7F30\u7EF3\u5427\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u4EEC\u9700\u8981\u82B1\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4EC0\u4E48\uFF1F\u60F3\u5236\u4F5C\u7275\u7ECA\u7F30\u7EF3\uFF0C\\n\u5C31\u9700\u8981\u4EE5\u5B64\u4E4B\u529B\u7EFD\u653E\u7684\u5149\u8F89\u4E4B\u82B1\uFF0C\\r\\n\u4EE5\u53CA\u7231\u9A6C\u7684\u9B03\u6BDB\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u82B1\u2026\u2026\u82B1\u2026\u2026\\n\u8FD9\u6837\u554A\u2026\u2026\u539F\u6765\u5982\u6B64\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u672C\u4EE5\u4E3A\u4EBA\u7C7B\u4E0D\u518D\u5411\u5B64\u8FDB\u732E\u7275\u7ECA\u7F30\u7EF3\\n\u662F\u56E0\u4E3A\u4ED6\u4EEC\u5FD8\u8BB0\u4E86\u5BF9\u5B64\u7684\u4FE1\u4EF0\u3002\\c\\n\u60F3\u4E0D\u5230\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u539F\u6765\u662F\u56E0\u4E3A\u5B64\\n\u6CA1\u80FD\u63D0\u4F9B\u6240\u9700\u7684\u6750\u6599\u554A\u3002[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u597D\u50CF\u957F\u4E45\u4EE5\u6765\uFF0C\\n\u662F\u5B64\u8BEF\u4F1A\u4EBA\u7C7B\u4E86\u554A\u3002[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8981\u8BA9\u5149\u8F89\u4E4B\u82B1\u7EFD\u653E\uFF0C\\n\u5C31\u5FC5\u987B\u6D88\u8017\u5E9E\u5927\u7684\u529B\u91CF\u3002\\r\\n\u56E0\u6B64\u6570\u767E\u5E74\u6765\u90FD\u672A\u80FD\u4F7F\u5176\u7EFD\u653E\u3002[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F46\u4ECE\u521A\u624D\u5F00\u59CB\uFF0C\u5B64\u611F\u89C9\u5230\\n\u6709\u529B\u91CF\u6E10\u6E10\u6D8C\u73B0\u800C\u6765\u3002[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5B64\u5C31\u8BD5\u7740\u5728\u8FD9\u76F8\u9694\u5DF2\u4E45\u7684\u65F6\u4EE3\uFF0C\\n\u8BA9\u5149\u8F89\u4E4B\u82B1\u518D\u6B21\u7EFD\u653E\u5427\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u514B\u62C9\u545C\u65AF\u3001\u5498\u565C\u5463\u65AF\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5B69\u5B50\u554A\uFF0C\u6536\u4E0B\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u547C\u2026\u2026\u547C\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u8981\u8BA9\u6574\u6735\u82B1\u513F\u7EFD\u653E\uFF0C\\n\u5E76\u975E\u6613\u4E8B\u554A\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u867D\u7136\u4E0D\u77E5\u591F\u7528\u4E0E\u5426\uFF0C\\n\u4F46\u62DC\u6258\u6C5D\u7528\u90A3\u82B1\u74E3\uFF0C\\r\\n\u4E3A\u5B64\u5236\u4F5C\u7275\u7ECA\u7F30\u7EF3\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5236\u4F5C\u7F30\u7EF3\u4E00\u65CF\u7684\u540E\u88D4\\n\u5E94\u8BE5\u5C31\u5728\u6751\u4E2D\u3002[VAR 0114(0079)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5B64\u5C31\u62DC\u6258\u7ED9\u6C5D\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u7275\u7ECA\u7F30\u7EF3\uFF1F\\n\u6211\u8BB0\u5F97\u90A3\u597D\u50CF\u662F\u6751\u957F\u5BB6\\r\\n\u4EE3\u4EE3\u627F\u88AD\u5236\u6CD5\u7684\u7EF3\u5B50\u5594\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4F60\u8981\u662F\u60F3\u8C03\u67E5\u7684\u8BDD\uFF0C\\n\u4E0D\u5982\u5230\u6751\u957F\u5BB6\\r\\n\u501F\u4ED6\u7684\u4E66\u770B\u4E00\u770B\uFF1F"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u4F60\u60F3\u5236\u4F5C\u7F30\u7EF3\uFF1F\\c\\n\u53BB\u95EE\u95EE\u6751\u957F\u5427\u3002\\n\u4ED6\u8FDE\uFF34\u6064\u4E4B\u7C7B\u7684\u90FD\u4F1A\u505A\u5462\u3002"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4EC0\u4E48\uFF1F\u7275\u7ECA\u7F30\u7EF3\uFF1F\\n\u55EF\uFF5E\u4E0D\u6E05\u695A\u5594\u2026\u2026"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u770B\u4F60\u603B\u8DDF\u6751\u91CC\u7684\u5927\u4F19\u804A\u5929\uFF0C\\n\u5173\u7CFB\u4E00\u5B9A\u5904\u5F97\u90FD\u4E0D\u9519\u5427\u3002"
  }
