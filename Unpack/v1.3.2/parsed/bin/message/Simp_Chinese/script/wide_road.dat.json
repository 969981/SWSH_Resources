    "text": "\u718A\u5F92\u5F1F\u53D8\u5F97\u7CBE\u529B\u5145\u6C9B\u4E86\uFF01\\c\\n\u795D\u4F60\u5728\u6311\u6218\u6C34\u4E4B\u5854\u7684\u5F81\u9014\u4E0A\\n\u62AB\u8346\u65A9\u68D8\uFF0C\u6218\u65E0\u4E0D\u80DC\u3002"
  },
  {
    "index": 135,
    "flags": 0,
    "text": "\u5148\u8BA9\u6211\u5E2E\u4F60\\n\u56DE\u590D\u5B9D\u53EF\u68A6\u7684\u4F53\u529B\u5427\u3002"
  },
  {
    "index": 136,
    "flags": 0,
    "text": "\u5927\u5BB6\u90FD\u53D8\u5F97\u7CBE\u529B\u5145\u6C9B\u4E86\uFF01\\n\u90A3\u4E48\uFF0C\u8BF7\u52A0\u6CB9\u5427\uFF01"
  },
  {
    "index": 137,
    "flags": 0,
    "text": "\u6311\u6218\u5C1A\u672A\u5B8C\u6210\uFF0C\\n\u4F60\u4FBF\u6298\u621F\u6C89\u6C99\u4E86\u554A\u2026\u2026\\r\\n\u6211\u6765\u5E2E\u4F60\u56DE\u590D\u718A\u5F92\u5F1F\u7684\u4F53\u529B\u5427\u3002"
  },
  {
    "index": 138,
    "flags": 0,
    "text": "\u718A\u5F92\u5F1F\u53D8\u5F97\u7CBE\u529B\u5145\u6C9B\u4E86\uFF01\\c\\n\u795D\u4F60\u5728\u6311\u6218\u6076\u4E4B\u5854\u7684\u5F81\u9014\u4E0A\\n\u62AB\u8346\u65A9\u68D8\uFF0C\u6218\u65E0\u4E0D\u80DC\u3002"
  },
  {
    "index": 139,
    "flags": 0,
    "text": "\u5148\u8BA9\u6211\u5E2E\u4F60\\n\u56DE\u590D\u5B9D\u53EF\u68A6\u7684\u4F53\u529B\u5427\u3002"
  },
  {
    "index": 140,
    "flags": 0,
    "text": "\u5927\u5BB6\u90FD\u53D8\u5F97\u7CBE\u529B\u5145\u6C9B\u4E86\uFF01\\n\u90A3\u4E48\uFF0C\u8BF7\u52A0\u6CB9\u5427\uFF01"
  },
  {
    "index": 141,
    "flags": 0,
    "text": "\u628A\u5012\u4E0B\u7684\u5B9D\u53EF\u68A6\u5E26\u56DE\u6B66\u9986\u4F11\u606F\u5427\uFF01"
  },
  {
    "index": 142,
    "flags": 0,
    "text": "\u6240\u6709\u5B9D\u53EF\u68A6\u90FD\u6062\u590D\u4E86\u6D3B\u529B\uFF01"
  },
  {
    "index": 143,
    "flags": 0,
    "text": "\u628A\u5012\u4E0B\u7684\u5B9D\u53EF\u68A6\u5E26\u56DE\u57FA\u5730\u4F11\u606F\u5427\uFF01"
  },
  {
    "index": 144,
    "flags": 0,
    "text": "\u6240\u6709\u5B9D\u53EF\u68A6\u90FD\u6062\u590D\u4E86\u6D3B\u529B\uFF01"
  },
  {
    "index": 145,
    "flags": 0,
    "text": "\u542C\u6211\u8BF4\uFF0C\u542C\u6211\u8BF4\uFF01\u521A\u624D\u5440\uFF01\\n\u6211\u6361\u5230\u4E86\u597D\uFF5E\u591A\u7684\u7403\u679C\u5462\uFF01\\c\\n\u53EA\u8981[VAR 0203(0000,0000)]\uFF37\uFF0C\\n\u6211\u5C31\u7279\u522B\u628A\u7403\u679C\u8BA9\u7ED9\u4F60\uFF01\uFF01"
  },
  {
    "index": 146,
    "flags": 0,
    "text": "\u4F60\u4E0D\u9700\u8981\u7403\u679C\u554A\uFF1F\\n\u6536\u96C6\u8D77\u6765\u53EF\u8D39\u52B2\u4E86\u5462\uFF5E"
  },
  {
    "index": 147,
    "flags": 0,
    "text": "\u8FD9\u662F\u6211\u6361\u5230\u7684\u7403\u679C\uFF01\\n\u7ED9\u4F60\u5566\uFF01"
  },
  {
    "index": 148,
    "flags": 0,
    "text": "\u6211\u542C\u8BF4\uFF0C\u6B66\u9986\u91CC\u6709\u79CD\u53EB\u673A\u5668\u9E55\u7684\u4E1C\u897F\uFF0C\\n\u53EA\u8981\u5411\u90A3\u91CC\u9762\u653E\u8FDB\uFF14\u4E2A\u7403\u679C\u2026\u2026\\c\\n\u5728\u5F88\uFF5E\u5076\u5C14\u7684\u60C5\u51B5\u4E0B\uFF0C\\n\u5C31\u6709\u53EF\u80FD\u4F1A\u5F97\u5230\u7A00\u6709\u7684\u7CBE\u7075\u7403\u5462\u3002"
  },
  {
    "index": 149,
    "flags": 0,
    "text": "\u4F60\u7684\uFF37\u4E0D\u591F\u54E6\uFF01\u7B49\u4F60\u6536\u96C6\u5230\u4E86\\n\u8DB3\u591F\u7684\uFF37\u4EE5\u540E\uFF0C\u6211\u5C31\u628A\u7403\u679C\u8BA9\u7ED9\u4F60\uFF01"
  },
  {
    "index": 150,
    "flags": 0,
    "text": "\u5E74\u8F7B\u4EBA\u90FD\u8DD1\u5230\u57CE\u5E02\u53BB\u5566\u3002\\c\\n\u53EA\u6709\u4E0A\u5C81\u6570\u7684\u548C\u5B9D\u53EF\u68A6\\n\u7559\u5728\u8FD9\u513F\u4E00\u8D77\u52C9\u5F3A\u8FC7\u65E5\u5B50\u3002"
  },
  {
    "index": 151,
    "flags": 0,
    "text": "\u6751\u91CC\u4EBA\u5403\u591A\u5C11\uFF0C\\n\u519C\u4F5C\u7269\u5C31\u79CD\u591A\u5C11\u3002\\c\\n\u4E0D\u6D6A\u8D39\u4E1C\u897F\u7684\u751F\u6D3B\u2026\u2026\\n\u8FD9\u5C31\u662F\u6240\u8C13\u7684\u81EA\u7ED9\u81EA\u8DB3\u554A\u3002"
  },
  {
    "index": 152,
    "flags": 0,
    "text": "\u5728\u96EA\u5730\u8D70\u8DEF\u7684\u65F6\u5019\uFF0C\\n\u4F60\u8981\u7528\u6574\u4E2A\u978B\u5E95\u7740\u5730\uFF0C\\r\\n\u8FD9\u6837\u5C31\u4E0D\u4F1A\u6454\u5012\u4E86\u5594\u3002"
  },
  {
    "index": 153,
    "flags": 0,
    "text": "\u6BCF\u5E74\u90FD\u8981\u7ECF\u53D7\u5BD2\u51B7\u7684\u714E\u71AC\uFF0C\\n\u771F\u662F\u53D7\u591F\u4E86\u554A\u3002"
  },
  {
    "index": 154,
    "flags": 0,
    "text": "\u8FD9\u6751\u5B50\u867D\u7136\u6CA1\u4EC0\u4E48\u770B\u5934\uFF0C\\n\u4E0D\u8FC7\u8FD8\u662F\u6B22\u8FCE\u4F60\u5230\u5904\u6E9C\u6E9C\u5594\u3002\\c\\n\u8BDD\u8BF4\u56DE\u6765\uFF0C\u503C\u5F97\u4E00\u770B\u7684\\n\u4E5F\u5C31\u662F\u4E00\u5C0A\u53E4\u65E7\u7684\u96D5\u50CF\u800C\u5DF2\u3002"
  },
  {
    "index": 155,
    "flags": 0,
    "text": "\u4F60\u5DF2\u7ECF\u770B\u8FC7\\n\u4E30\u9976\u4E4B\u738B\u7684\u96D5\u50CF\u4E86\u5417\uFF1F[VAR 0114(007A)]"
  },
  {
    "index": 156,
    "flags": 0,
    "text": "\u6751\u957F\u7684\u5BB6"
  },
  {
    "index": 157,
    "flags": 0,
    "text": "\u51CD\u51DD\u3000\u6C11\u5BBF"
  },
  {
    "index": 158,
    "flags": 0,
    "text": "\u4E0A\u4E86\u9501\u3002\\n\u770B\u6765\u73B0\u5728\u8FDB\u4E0D\u53BB\u2026\u2026"
  },
  {
    "index": 159,
    "flags": 0,
    "text": "\u2026\u2026\u54A6\uFF1F\\n\u95E8\u4E0A\u5939\u7740\u4E00\u5F20\u7EB8\u6761\uFF01\\c\\n\u201C\u6211\u5728\u5DE8\u4EBA\u7761\u69BB\u7684\u7530\u5730\u2026\u2026\u6751\u957F\u201D"
  },
  {
    "index": 160,
    "flags": 0,
