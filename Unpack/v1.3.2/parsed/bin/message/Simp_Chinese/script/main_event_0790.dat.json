[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6B22\u8FCE\u4F60\uFF01\\n\u6211\u5C31\u662F\u706B\u5C5E\u6027\u7684\u9053\u9986\u9986\u4E3B\u5361\u829C\u3002\\c\\n\u4F60\u80FD\u6218\u80DC\u8349\u5C5E\u6027\u9986\u4E3B\u4E9A\u6D1B\u548C\\n\u6C34\u5C5E\u6027\u9986\u4E3B\u9732\u7483\u5A1C\u6765\u5230\u8FD9\u91CC\uFF0C\\r\\n\u786E\u5B9E\u4E0D\u7B80\u5355\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E3A\u4E86\u4E89\u53D6\u80DC\u5229\uFF0C\\n\u6BCF\u4E00\u4E2A\u8BAD\u7EC3\u5BB6\uFF0C\u6BCF\u4E00\u53EA\u5B9D\u53EF\u68A6\\r\\n\u90FD\u4F1A\u4E0D\u65AD\u5730\u8BAD\u7EC3\uFF01\\c\\n\u4F46\u662F\uFF0C\u5BF9\u624B\u4E5F\u540C\u6837\u5728\u52AA\u529B\uFF01\\c\\n\u6240\u4EE5\u51B3\u5B9A\u80DC\u8D1F\u7684\u5173\u952E\u5C31\u53D6\u51B3\u4E8E\\n\u5728\u5B9E\u6218\u4E2D\u80FD\u53D1\u6325\u51FA\u591A\u5C11\u5B9E\u529B\u4E86\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u91CC\u88AB\u516C\u8BA4\u4E3A\u9053\u9986\u6311\u6218\u7684\u9996\u9053\u96BE\u5173\uFF0C\\n\u800C\u4F60\u7ADF\u7136\u8D62\u4E86\u6211\uFF01\\c\\n\u6211\u957F\u5E74\u79EF\u7D2F\u7684\u4E30\u5BCC\u7ECF\u9A8C\\n\u5728\u4F60\u7684\u624D\u80FD\u9762\u524D\u4E5F\u843D\u4E86\u4E0B\u98CE\uFF01\\r\\n\u770B\u6765\u6211\u8FD8\u8981\u591A\u52A0\u5B66\u4E60\u624D\u884C\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6BEB\u65E0\u7591\u95EE\uFF0C\\n\u4F60\u4EEC\u4F1A\u6210\u4E3A\u6700\u5F3A\u7684\u961F\u4F0D\uFF01\\r\\n\u6211\u5F88\u9AD8\u5174\u4ECA\u5929\u80FD\u548C\u4F60\u5BF9\u6218\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F5C\u4E3A\u6218\u80DC\u6211\u7684\u8BC1\u660E\uFF0C\\n\u8FD9\u679A\u706B\u4E4B\u5FBD\u7AE0\u5C31\u9001\u7ED9\u4F60\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53EF\u4EE5\u6355\u6349\u7B49\u7EA7\uFF13\uFF15\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u56E0\u4E3A\u6709\u4E86\u6781\u5DE8\u5316\u8FD9\u4E00\u73B0\u8C61\uFF0C\\n\u6211\u4EEC\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\\r\\n\u73B0\u5728\u5DF2\u7ECF\u6210\u4E3A\u4E86\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u6587\u5316\u3002[VAR 0114(0010)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u522B\u5FD8\u4E86\uFF0C\\n\u4F20\u627F\u6587\u5316\u662F\u5E74\u8F7B\u8BAD\u7EC3\u5BB6\u7684\u4F7F\u547D\u3002\\c\\n\u5F53\u7136\uFF0C\u597D\u7684\u6587\u5316\u4E0D\u80FD\u5149\u5B89\u4E8E\u73B0\u72B6\uFF0C\\n\u9700\u8981\u4F60\u4EEC\u4E0D\u65AD\u6539\u8FDB\u624D\u884C\u3002\\r\\n\u6211\u4EEC\u5927\u4EBA\u4E5F\u4F1A\u652F\u6301\u4F60\u4EEC\u7684\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u8981\u56DE\u5230\u62A5\u5230\u5904\u5417\uFF1F"
  }
]
