[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F60\u548C\u51A0\u519B\u7684\u5DC5\u5CF0\u5BF9\u51B3\u2026\u2026\\n\u671F\u5F85\u5DF2\u4E45\u7684\u51A0\u519B\u8D5B\uFF01\\r\\n\u4F60\u505A\u597D\u6311\u6218\u4E39\u5E1D\u7684\u51C6\u5907\u4E86\u5417\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u4F1A\u8D62\u7684\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u8FD8\u8981\u51C6\u5907\u4E00\u4E0B"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u8BF7\u6362\u4E0A\u7ADE\u6280\u670D\uFF0C\\n\u524D\u5F80\u5BF9\u6218\u573A\u5427\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5DF2\u65E0\u9000\u8DEF\uFF0C\u552F\u6709\u5411\u524D\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u7684\u6BD4\u8D5B\u4E00\u5411\u662F\u573A\u573A\u7206\u6EE1\u3002\\c\\n\u4F46\u6211\u8FD8\u662F\u7B2C\u4E00\u6B21\u611F\u53D7\u5230\\n\u7ADE\u6280\u573A\u5185\u7684\u6C1B\u56F4\u5982\u6B64\u72C2\u70ED\u3002[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u56E0\u4E3A\u89C2\u4F17\u4EEC\u90FD\u77E5\u9053\\n\u4F60\u4E09\u5929\u524D\u7684\u52C7\u6562\u7684\u8868\u73B0\u2026\u2026\\c\\n\u662F\u4F60\u6349\u4F4F\u4E86\u65E0\u6781\u6C70\u90A3\uFF0C\\n\u4FDD\u62A4\u4E86\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u672A\u6765\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4E0E\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u82CD\u54CD\u3001\u85CF\u739B\u7136\u7279\\n\u5E76\u80A9\u4F5C\u6218\u7684\u82F1\u96C4\u2026\u2026\\c\\n\u4F60\u8FD9\u4E2A\u6311\u6218\u8005\u6709\u8DB3\u591F\u7684\u542B\u91D1\u91CF\u6765\\n\u5F53\u6211\u5237\u65B0\u4E0D\u8D25\u7EAA\u5F55\u7684\u8BD5\u91D1\u77F3\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64\u2026\u2026\\n\u4F60\u628A\u65E0\u6781\u6C70\u90A3\u4E5F\u52A0\u5165\u961F\u4F0D\u4E86\u554A\u3002\\c\\n\u6700\u5F3A\u7684\u6311\u6218\u8005\u8054\u5408\u6700\u5F3A\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\n\u771F\u662F\u592A\u8BA9\u4EBA\u5174\u594B\u4E86\u2026\u2026\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u53EA\u6709\u5148\u6FC0\u53D1\u51FA\u6700\u5F3A\u7684\u6311\u6218\u8005\\n\uFF11\uFF10\uFF10\uFF05\u7684\u5B9E\u529B\u2026\u2026\\c\\n\u518D\u628A\u8FD9\u4E2A\u5BF9\u624B\u6253\u7206\uFF0C\\n\u624D\u80FD\u5F70\u663E\u51FA\u51A0\u519B\u7684\u5B9E\u529B\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6765\u554A\uFF0C[VAR 0100(0000)]\uFF01\\c\\n\u6211\u4EEC\u8981\u4E0A\u6F14\u4E00\u573A\\n\u80FD\u591F\u8F7D\u5165\u4F3D\u52D2\u5C14\u53F2\u518C\u2026\u2026\u4E0D\uFF0C\\r\\n\u662F\u8DB3\u4EE5\u6539\u53D8\u4F3D\u52D2\u5C14\u672A\u6765\u7684\u5DC5\u5CF0\u5BF9\u51B3\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5C3D\u60C5\u4EAB\u53D7\u81F3\u9AD8\u65E0\u4E0A\u7684\u51A0\u519B\u65F6\u523B\u5427\uFF01[VAR 0114(0004)]"
  }
]
