  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8981\u8BF4\u50CF\u5427\uFF0C\u786E\u5B9E\u4E5F\u662F\u633A\u50CF\u7684\u3002\\n\u4E0D\u8FC7\u5B83\u7684\u817F\u548B\u90A3\u4E48\u7C97\u2026\u2026\\r\\n\u800C\u4E14\uFF0C\u770B\u8D77\u6765\u597D\u50CF\u4E00\u70B9\u90FD\u4E0D\u5E26\u7535\uFF1F[VAR 0114(0076)]"
