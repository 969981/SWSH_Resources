    "flags": 0,
    "text": "\u55EF\u54FC\u55EF\u54FC\u2026\u2026\uFF1F\\n\u4F60\u662F\u8BF4\uFF0C\u90A3\u4E2A\u53C8\u7CD9\u53C8\u786C\u7684\u5BB6\u4F19\\r\\n\u5C31\u662F\u5CA9\u77F3\u5DE8\u4EBA\uFF0C\u96F7\u5409\u6D1B\u514B\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\u662F\u6211\u8BF4\uFF0C\u4F60\u89C9\u4E0D\u89C9\u5F97\u5B83\u8DDF\\n\u73B0\u5728\u7684\u8349\u5C5E\u6027\u9053\u9986\u9986\u4E3B\u7279\u50CF\uFF1F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u4F60\u770B\u5B83\u90A3\u4E2A\u8180\u5B50\uFF0C\\n\u5C31\u8DDF\u8349\u5C5E\u6027\u9053\u9986\u9986\u4E3B\u4E00\u6837\uFF0C\\r\\n\u7C97\u58EE\u5F97\u8DDF\u4E00\u5757\u5927\u77F3\u5934\u4F3C\u7684\uFF01\u5389\u5BB3\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u884C\uFF0C\u5B83\u786E\u5B9E\u633A\u6709\u5CA9\u77F3\u5DE8\u4EBA\u7684\u6837\u5B50\u7684\uFF01\\n\u7B97\u4F60\u5B8C\u6210\u4E86\u4E00\u4E2A\u63A2\u9669\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u55EF\u54FC\u55EF\u54FC\u2026\u2026\uFF1F\\n\u4F60\u662F\u8BF4\uFF0C\u90A3\u4E2A\u786C\u90A6\u90A6\u7684\u5BB6\u4F19\\r\\n\u5C31\u662F\u51B0\u4E4B\u5DE8\u4EBA\uFF0C\u96F7\u5409\u827E\u65AF\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\u662F\u6211\u8BF4\uFF0C\u4F60\u89C9\u4E0D\u89C9\u5F97\u5B83\u770B\u7740\u50CF\\n\u4E00\u76CF\u534E\u4E3D\u4E3D\u7684\u95F4\u63A5\u7167\u660E\u7684\u5927\u706F\uFF1F\uFF01\\r\\n\u597D\u60F3\u628A\u5B83\u70B9\u4EAE\u4E86\u62FF\u7ED9\u5C0F\u590F\u590F\u770B\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u4F60\u770B\u5B83\u7684\u80F3\u818A\u957F\u5F97\u591A\u7C97\u554A\uFF01\\n\u770B\u5F97\u6211\u817F\u90FD\u8F6F\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u884C\uFF0C\u5B83\u786E\u5B9E\u633A\u6709\u51B0\u4E4B\u5DE8\u4EBA\u7684\u6837\u5B50\u7684\uFF01\\n\u7B97\u4F60\u5B8C\u6210\u4E86\u4E00\u4E2A\u63A2\u9669\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u55EF\u54FC\u55EF\u54FC\u2026\u2026\uFF1F\\n\u4F60\u662F\u8BF4\uFF0C\u90A3\u4E2A\u6CB9\u5149\u6C34\u6ED1\u7684\u5BB6\u4F19\\r\\n\u5C31\u662F\u94A2\u4E4B\u5DE8\u4EBA\uFF0C\u96F7\u5409\u65AF\u5947\u9C81\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\u662F\u6211\u8BF4\uFF0C\u4F60\u89C9\u4E0D\u89C9\u5F97\u5B83\\n\u770B\u7740\u50CF\u4E00\u4E2A\u5927\u4FDD\u9F84\u7403\uFF1F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u770B\u770B\u5B83\u90A3\u5F20\u6251\u514B\u8138\u54DF\uFF01\\n\u5B8C\u5168\u770B\u4E0D\u51FA\u5B83\u8111\u5B50\u91CC\u5728\u60F3\u4EC0\u4E48\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u884C\uFF0C\u5B83\u786E\u5B9E\u633A\u6709\u94A2\u4E4B\u5DE8\u4EBA\u7684\u6837\u5B50\u7684\uFF01\\n\u7B97\u4F60\u5B8C\u6210\u4E86\u4E00\u4E2A\u63A2\u9669\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u55EF\u54FC\u55EF\u54FC\u2026\u2026\uFF1F\\n\u4F60\u662F\u8BF4\uFF0C\u90A3\u4E2A\u6D51\u8EAB\u567C\u556A\u4F5C\u54CD\u7684\u5BB6\u4F19\\r\\n\u5C31\u662F\u7535\u4E4B\u5DE8\u4EBA\uFF0C\u96F7\u5409\u827E\u52D2\u5947\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\u662F\u6211\u8BF4\uFF0C\u4F60\u89C9\u4E0D\u89C9\u5F97\u90A3\u5565\uFF01\\n\u5B83\u957F\u5F97\u50CF\u4E0D\u50CF\u90A3\u79CD\u4F1A\u5728\u5634\u91CC\\r\\n\u567C\u91CC\u556A\u5566\u4E71\u8DF3\u4E71\u5D29\u7684\u5F69\u8272\u7CD6\u679C\uFF1F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u5B83\u80FD\u4E00\u76F4\u652F\u6491\u4F4F\u90A3\u4E2A\\n\u65CB\u8F6C\u5F97\u633A\u6709\u8282\u594F\u7684\u8EAB\u4F53\uFF0C\\r\\n\u5E73\u8861\u611F\u5F97\u6709\u591A\u597D\u554A\u2026\u2026\u60F3\u60F3\u90FD\u53EB\u4EBA\u5403\u60CA\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u884C\uFF0C\u5B83\u786E\u5B9E\u633A\u6709\u7535\u4E4B\u5DE8\u4EBA\u7684\u6837\u5B50\u7684\uFF01\\n\u7B97\u4F60\u5B8C\u6210\u4E86\u4E00\u4E2A\u63A2\u9669\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u55EF\u54FC\u55EF\u54FC\u2026\u2026\uFF1F\\n\u4F60\u662F\u8BF4\uFF0C\u90A3\u4E2A\u957F\u4E86\u4E00\u5806\u952F\u9F7F\u7684\u5BB6\u4F19\\r\\n\u5C31\u662F\u9F99\u4E4B\u5DE8\u4EBA\uFF0C\u96F7\u5409\u94CE\u62C9\u6208\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\u662F\u6211\u8BF4\uFF0C\u4F60\u89C9\u4E0D\u89C9\u5F97\\n\u5B83\u957F\u5F97\u5F88\u50CF\u80FD\u5939\u4F4F\u7279\u522B\u6C89\u7684\\r\\n\u8863\u670D\u7684\u5F3A\u529B\u667E\u8863\u5939\u5B50\uFF1F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u611F\u89C9\u6211\u8981\u662F\u60F9\u4E86\u5B83\uFF0C\u51C6\u5F97\u88AB\u5B83\\n\u5F20\u5F00\u5927\u5634\u4E00\u53E3\u54AC\u4F4F\uFF01\u771F\u4E0D\u662F\u95F9\u7740\u73A9\u513F\u7684\uFF01[VAR 0114(0076)]"
  },
  {
