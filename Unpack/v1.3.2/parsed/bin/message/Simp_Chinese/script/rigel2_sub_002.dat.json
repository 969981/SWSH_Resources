    "flags": 0,
    "text": "\u884C\uFF0C\u5B83\u786E\u5B9E\u633A\u6709\u9F99\u4E4B\u5DE8\u4EBA\u7684\u6837\u5B50\u7684\uFF01\\n\u7B97\u4F60\u5B8C\u6210\u4E86\u4E00\u4E2A\u63A2\u9669\uFF01[VAR 0114(0076)]"
  },
