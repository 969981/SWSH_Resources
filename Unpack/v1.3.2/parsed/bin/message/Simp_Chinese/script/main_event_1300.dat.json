[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4E3A\u4E86\u963B\u6B62\u4EFB\u4F55\u4EBA\u62B5\u8FBE\u5C16\u9489\u9547\uFF0C\\n\u6211\u4EEC\u5DF2\u7ECF\u5C01\u9501\u4E86\uFF19\u53F7\u9053\u8DEF\uFF01\\r\\n\u8C01\u90FD\u522B\u60F3\u4ECE\u8FD9\u91CC\u8FC7\u53BB\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u4EEC\u5450\u558A\u961F\u8981\\n\u4E00\u8FB9\u4E3A\u66B4\u566C\u9F9F\u52A0\u6CB9\uFF0C\\r\\n\u4E00\u8FB9\u963B\u6B62\u4EFB\u4F55\u4EBA\u6E21\u8FC7\u6218\u7ADE\u6E7E\uFF01[VAR 0114(0044)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u54D2\u54D2\u5DE5\uFF5E"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u884C\u554A\u2026\u2026\\n\u53CD\u6B63\u53EA\u8981\u8BA9\u6D1B\u6258\u59C6\u81EA\u884C\u8F66\\r\\n\u80FD\u9A91\u5728\u6C34\u4E0A\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD9\u4F4D\u9053\u9986\u6311\u6218\u8005\uFF01\\n\u4F60\u6765\u5F97\u771F\u662F\u65F6\u5019\u554A\uFF01\\c\\n\u770B\u5728\u6211\u9001\u4F60\u81EA\u884C\u8F66\u7684\u4EFD\u4E0A\uFF0C\\n\u4F60\u5C31\u5E2E\u6211\u6559\u8BAD\u4E00\u4E0B\u4ED6\u4EEC\u5427\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u4EEC\u8981\u4FDD\u62A4\u66B4\u566C\u9F9F\uFF01\\c\\n\u6240\u4EE5\uFF0C\u4F60\u752D\u60F3\u7EE7\u7EED\u9053\u9986\u6311\u6218\u5566\uFF01\\n\u8981\u662F\u4E0D\u7518\u5FC3\uFF0C\\r\\n\u5C31\u6765\u548C\u6211\u4EEC\u5BF9\u6218\u554A\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u90A3\u4F60\u5C31\u54EA\u51C9\u5FEB\u54EA\u5F85\u7740\u53BB\u5427\uFF01\\n\u6211\u4EEC\u8FD8\u5F97\u63A5\u7740\u7ED9\u66B4\u566C\u9F9F\u52A0\u6CB9\u5462\u3002[VAR 0114(0043)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4E3A\u4E86\u4FDD\u62A4\u66B4\u566C\u9F9F\uFF0C\\n\u6211\u4EEC\u8981\u6253\u7206\u4F60\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5C31\u7B97\u4F60\u73B0\u5728\u5230\u4E86\u5C16\u9489\u9547\uFF0C\\n\u4E5F\u6CA1\u6CD5\u53C2\u52A0\u9053\u9986\u6311\u6218\u3002\\r\\n\u6211\u529D\u4F60\u8FD8\u662F\u653E\u5F03\u5427\uFF01[VAR 0114(0044)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u54CE\u54DF\uFF01\u8FD9\u6837\u4E0B\u53BB\u2026\u2026\uFF01\\n\u66B4\u566C\u9F9F\u4F1A\u88AB[VAR 1100(00FF,0101)]\u4ED6\u5979\u9A91\u4E0A\u7684\u3002[VAR 0114(0043)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u6709\u4E2A\u597D\u4E3B\u610F\uFF01\\n\u6211\u4EEC\u5148\u9A91\u4E0A\u66B4\u566C\u9F9F\u4E0D\u5C31\u5F97\u4E86\uFF01[VAR 0114(0044)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\uFF01\u52A0\u6CB9\u554A\uFF01\u66B4\u566C\u9F9F\uFF01\\n\u518D\u89C1\u5566\uFF01\u9053\u9986\u6311\u6218\u8005\uFF01[VAR 0114(0043)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u54D2\u54D2\u5DE5\uFF5E"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u53C8\u6551\u4E86\u6211\u4E00\u6B21\u554A\u3002\\c\\n\u600E\u4E48\u6837\uFF1F\\n\u6709\u81EA\u884C\u8F66\u7684\u751F\u6D3B\uFF0C\u5FEB\u4E50\u5417\uFF1F"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8981\u662F\u80FD\u628A\u6D1B\u6258\u59C6\u81EA\u884C\u8F66\u9A91\u5230\u6C34\u4E0A\uFF0C\\n\u662F\u4E0D\u662F\u66F4\u68D2\u5462\uFF1F"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6240\u4EE5\uFF0C\u8BA9\u6211\u7279\u522B\u4E3A\u4F60\u88C5\u4E00\u4E2A\u65B0\u96F6\u4EF6\u5427\uFF01\\n\u8FD9\u6837\u4E00\u6765\uFF0C\u4F60\u5C31\u80FD\u5728\u6C34\u4E0A\u9A91\u8F66\u4E86\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6765\u6765\u6765\uFF01\\c\\n\u6D1B\u6258\u59C6\u81EA\u884C\u8F66\u6709\u4E86\u6C34\u4E0A\u6A21\u5F0F\uFF0C\\n\u5C31\u80FD\u5728\u6C34\u4E0A\u81EA\u7531\u79FB\u52A8\u4E86\uFF01\\c\\n\u5BF9\u4E86\uFF0C\u5728\u9646\u5730\u4E0A\u9A91\u8F66\u7684\u65F6\u5019\uFF0C\\n\u5C31\u662F\u9646\u4E0A\u6A21\u5F0F\u54E6\u3002"
  }
]
