[
  {
    "index": 0,
    "flags": 0,
    "text": "\u55EF\uFF1F\\n\u90A3\u662F\u4EC0\u4E48\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5FEB\u770B\uFF0C[VAR 0100(0000)]\uFF0C\\n\u662F\u8BB8\u613F\u661F\u554A\uFF01\uFF01\\c\\n\u800C\u4E14\u6709\uFF12\u4E2A\uFF01\\n\u6765\uFF0C\u5206\u7ED9\u4F60\uFF11\u4E2A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u8BB8\u613F\u661F\uFF0C\\n\u6211\u4E5F\u80FD\u8BA9\u5B9D\u53EF\u68A6\u6781\u5DE8\u5316\uFF01\\r\\n\u5B83\u4EEC\u4E00\u5B9A\u4F1A\u53D8\u5F97\u8D85\u7EA7\u5DE8\u5927\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u771F\u662F\u592A\u96BE\u5F97\u4E86\uFF01\\c\\n\u636E\u8BF4\u8BB8\u613F\u661F\u53EA\u4F1A\u843D\u5728\\n\u8BDA\u5FC3\u7948\u613F\u7684\u4EBA\u8EAB\u8FB9\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u8981\u6210\u4E3A\u6700\u5F3A\u7684\u8BAD\u7EC3\u5BB6\uFF01\\c\\n\u6211\u8981\u6210\u4E3A\u6700\u5F3A\u7684\u8BAD\u7EC3\u5BB6\uFF01\uFF01\\c\\n\u6211\u8981\u6210\u4E3A\u6700\u5F3A\u7684\u8BAD\u7EC3\u5BB6\uFF01\uFF01\uFF01\\c\\n\u597D\uFF01\u8BB8\u4E86\uFF13\u6B21\u613F\uFF0C\\n\u613F\u671B\u5E94\u8BE5\u80FD\u5B9E\u73B0\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8D6B\u666E\u3002\\c\\n\u8BB8\u613F\u661F\u662F\u9690\u85CF\u7740\\n\u672A\u77E5\u80FD\u91CF\u7684\u795E\u79D8\u77F3\u5934\u2026\u2026\\r\\n\u53EF\u4EE5\u8BF4\u662F\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u5B9D\u7269\u3002\\c\\n\u4F46\u662F\uFF0C\u5149\u6709\u539F\u77F3\u662F\u6CA1\u6709\u7528\u7684\u3002\\n\u4F60\u5148\u628A\u5B83\u4EA4\u7ED9\u6211\u5427\u3002[VAR 0114(000A)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5BF9\u54E6\uFF01\u535A\u58EB\u5728\u7814\u7A76\u6781\u5DE8\u5316\uFF01\\c\\n\u5FEB\u8BA9\u6211\u548C[VAR 0100(0000)]\\n\u4E5F\u62E5\u6709\u8FD0\u7528\u6781\u5DE8\u5316\u7684\u529B\u91CF\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u4EEC\u4E4B\u524D\u5728\u5FAE\u5BD0\u68EE\u6797\u548C\\n\u795E\u79D8\u7684\u5B9D\u53EF\u68A6\u6253\u4E86\u4E00\u573A\uFF0C\\r\\n\u73B0\u5728\u53C8\u5F97\u5230\u4E86\u8BB8\u613F\u661F\u2026\u2026\\r\\n\u603B\u89C9\u5F97\u6709\u5389\u5BB3\u7684\u4E8B\u8981\u53D1\u751F\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u7406\u89E3\u4F60\u5174\u594B\u7684\u5FC3\u60C5\uFF0C\\n\u4F46\u662F\u4F60\u660E\u5929\u8FD8\u8981\u51FA\u53D1\u53BB\u5192\u9669\uFF0C\\r\\n\u73B0\u5728\u8FD8\u662F\u591A\u4FDD\u7559\u4E0B\u7CBE\u529B\u5427\u3002[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6709\u4EC0\u4E48\u597D\u4E8B\u5417\uFF1F\\n\u6211\u624D\u4E00\u56DE\u6765\u5C31\u8FD9\u4E48\u70ED\u95F9\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u4F60\u4EEC\u8FD8\u6CA1\u5403\u665A\u996D\u5427\uFF1F\\c\\n\u6211\u8FF7\u4E0A\u4E86\u6700\u8FD1\u6B63\u6D41\u884C\u7684\u5496\u55B1\u996D\uFF0C\\n\u6B63\u5728\u78E8\u70BC\u53A8\u827A\u54E6\uFF01[VAR 0114(000B)]"
  }
]
