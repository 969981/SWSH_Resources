[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54E6\uFF1F\u4F60\u662F\u2026\u2026[VAR 0114(0016)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54E6\uFF5E\u51A0\u519B\uFF01\u4F60\u6765\u4E86\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u600E\u4E48\u4E86\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u597D\u4E45\u4E0D\u89C1"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD8\u8FD9\u4E48\u60A0\u95F2\u5730\u8BF4\u8BDD\u554A\u3002\\c\\n\u770B\u6765\u8FD9\u4F4D\u65B0\u51A0\u519B\u7684\u5FC3\u810F\u4E4B\u5927\uFF0C\\n\u548C\u6781\u5DE8\u5316\u7684\u5B9D\u53EF\u68A6\u6709\u5F97\u62FC\u4E86\u3002[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E8B\u60C5\u662F\u8FD9\u6837\u7684\u2026\u2026\\n\u6211\u548C\u8042\u6893\u8868\u6F14\u8D5B\u6253\u5230\u4E00\u534A\uFF0C\\r\\n\u7A81\u7136\u6709\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u5927\u95F9\u73B0\u573A\uFF0C\\r\\n\u800C\u4E14\u8FD8\u4E0D\u77E5\u9053\u8BAD\u7EC3\u5BB6\u662F\u8C01\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u4EEC\u521A\u624D\\n\u6B63\u5728\u758F\u6563\u89C2\u4F17\u548C\u5DE5\u4F5C\u4EBA\u5458\u3002[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u540E\u540E\uFF5E\uFF01\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5317\u9762\u7684\u6240\u6709\u89C2\u4F17\u90FD\u758F\u6563\u597D\u5566\uFF01\\c\\n\u2026\u2026\u4F60\u4EEC\u5E94\u8BE5\u542C\u5230\u4E86\u5427\uFF1F\\n\u6781\u5DE8\u5316\u7684\u5B9D\u53EF\u68A6\u8FD8\u5728\u5927\u95F9\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF0C\u592A\u8C22\u8C22\u4F60\u4E86\uFF01\\n\u4E0D\u6127\u662F\u9053\u9986\u6311\u6218\u8005\uFF0C\u771F\u53EF\u9760\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u8981\u662F\u771F\u6709\u90A3\u4E48\u53EF\u9760\uFF0C\\n\u5C31\u4E0D\u4F1A\u6B62\u6B65\u534A\u51B3\u8D5B\u4E86\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u554A\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u5728\u8FFD\u7EA2\u8863\u4EBA\u548C\u84DD\u8863\u4EBA\u7684\u65F6\u5019\uFF0C\\n\u770B\u5230\u4ED6\u4EEC\u8DD1\u8FDB\u4E86\u8349\u8DEF\u7ADE\u6280\u573A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u7136\u540E\u6211\u4ECE\u540E\u9762\u8FFD\u4E86\u4E0A\u53BB\uFF0C\\n\u53D1\u73B0\u7ADE\u6280\u573A\u7A81\u7136\u53D8\u5F97\u4E00\u56E2\u7CDF\u3002\\c\\n\u6211\u53C8\u4E0D\u80FD\u653E\u7740\u89C2\u4F17\u4E0D\u7BA1\uFF0C\\n\u4E8E\u662F\u5C31\u53BB\u5E2E\u5FD9\u758F\u6563\u4EBA\u7FA4\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6240\u4EE5\u554A\u2026\u2026\u5BF9\u4E0D\u8D77\uFF01\\n\u6211\u8DDF\u4E22\u90A3\u4E24\u4E2A\u5BB6\u4F19\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u55EF\uFF0C\u8D6B\u666E\u770B\u5230\u7684\u90A3\u4E24\u4E2A\u53EF\u7591\u4EBA\u7269\\n\u4E5F\u7684\u786E\u8BA9\u4EBA\u5F88\u5728\u610F\u2026\u2026[VAR 0114(000E)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F46\u6211\u4EEC\u8FD8\u662F\u5148\u8BA9\\n\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u8001\u5B9E\u4E0B\u6765\u5427\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5BF9\u624B\u53EF\u4E0D\u597D\u60F9\u554A\uFF5E\\c\\n\u8981\u662F\u51A0\u519B[VAR 0100(0000)]\u4E5F\u80FD\\n\u5E2E\u6211\u4EEC\u7684\u8BDD\u5C31\u592A\u597D\u4E86\u3002[VAR 0114(000E)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6CA1\u95EE\u9898\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u6211\u4EEC\u5C31\u524D\u5F80\u5BF9\u6218\u573A\u5427\u3002[VAR 0114(000E)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u4E5F\u53BB\u5E2E\u5E2E\u5FD9\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u867D\u7136\u8FD9\u4E0D\u662F\u5B9D\u53EF\u68A6\u7684\u9519\uFF0C\\n\u4F46\u662F\u6BD4\u8D5B\u573A\u5730\u88AB\u641E\u5F97\u4E00\u56E2\u7CDF\uFF0C\\r\\n\u8FD8\u662F\u8BA9\u6211\u54BD\u4E0D\u4E0B\u8FD9\u53E3\u6C14\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u563F\uFF0C\u524D\u4EFB\u51A0\u519B\u7684\u5F1F\u5F1F\uFF01\\n\u4F60\u4E5F\u8981\u6765\u5E2E\u5E2E\u5FD9\u3002[VAR 0114(0016)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u51ED\u6211\u8FD9\u70B9\u5B9E\u529B\uFF0C\u5C31\u7B97\u8DDF\u53BB\u4E86\uFF0C\\n\u4E5F\u4E0D\u4E00\u5B9A\u80FD\u6D3E\u4E0A\u7528\u573A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u641E\u4E0D\u597D\u8FD8\u4F1A\u6210\u4E3A\u5927\u5BB6\u7684\u7D2F\u8D58\u5462\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6211\u60F3\uFF0C\u5982\u679C\u662F\u4E39\u5E1D\u7684\u8BDD\uFF0C\\n\u4ED6\u4E00\u5B9A\u4E0D\u4F1A\u8FF7\u832B\u7684\uFF01\\c\\n\u2026\u2026\u867D\u7136\u4ED6\u4F1A\u8FF7\u8DEF\u5C31\u662F\u4E86\u3002[VAR 0114(0016)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u8D70\u4E0D\u8D70\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u90A3\u3001\u90A3\u8FD8\u7528\u8BF4\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u53EF\u80FD\u56E0\u4E3A\u8042\u6893\u662F\u4E2A\u5F53\u54E5\u54E5\u7684\u5427\uFF0C\\n\u611F\u89C9\u4ED6\u5F88\u4F1A\u4E3A\u4EBA\u8003\u8651\u95EE\u9898\u554A\uFF5E[VAR 0114(000E)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u6211\u4EEC\u4E5F\u51FA\u53D1\u5427\u3002[VAR 0114(000E)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u597D\u5427\uFF0C\u4F60\u8981\u505A\u597D\u5145\u5206\u7684\u51C6\u5907\u554A\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\u8981\u548C\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u5BF9\u6218\uFF0C\\n\u4F60\u505A\u597D\u51C6\u5907\u4E86\u5417\uFF1F[VAR 0114(000E)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u54EA\u4E2A\u8BAD\u7EC3\u5BB6\u8FD9\u4E48\u5927\u80C6\uFF0C\\n\u7ADF\u7136\u7528\u5B9D\u53EF\u68A6\u628A\u573A\u5730\u641E\u5F97\u4E00\u56E2\u7CDF\uFF01\\r\\n\u8981\u662F\u8BA9\u6211\u6349\u5230\u4E86\uFF0C\u51B3\u4E0D\u8F7B\u9976\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u8FD8\u6709\u4EC0\u4E48\u5176\u4ED6\u6211\u80FD\\n\u5E2E\u5F97\u4E0A\u5FD9\u7684\u4E8B\u60C5\u5417\u2026\u2026\uFF1F[VAR 0114(0005)]"
  }
