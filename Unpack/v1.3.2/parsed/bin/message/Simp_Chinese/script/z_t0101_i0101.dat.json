[
  {
    "index": 0,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\uFF0C\u4F60\u7684[VAR 0101(0001)]\\n\u770B\u4E0A\u53BB\u6CA1\u4EC0\u4E48\u6D3B\u529B\u554A\u3002\\r\\n\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u5427\u3002[VAR 0114(0008)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u5B9D\u53EF\u68A6\u4E00\u76F4\u966A\u5728\u8EAB\u8FB9\uFF0C\\n\u6D3B\u529B\u5341\u8DB3\u5730\u968F\u4F60\u8D70\u904D\u56DB\u65B9\uFF0C\\r\\n\u4F60\u5C31\u4F1A\u53D1\u81EA\u5185\u5FC3\u5730\u611F\u5230\u5FEB\u4E50\u5427\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u53EF\u771F\u7684\u662F\u610F\u60F3\u4E0D\u5230\u7684\u53D1\u5C55\u554A\u2026\u2026\\c\\n\u4E0D\u8FC7\u6709\u4E39\u5E1D\u5728\uFF0C\u5E94\u8BE5\u6CA1\u95EE\u9898\u3002\\n\u4F60\u4E5F\u4E0D\u4F1A\u5750\u89C6\u4E0D\u7406\u5BF9\u5417\uFF1F\\r\\n\u5988\u5988\u4F1A\u4E3A\u4F60\u52A0\u6CB9\u7684\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u51A0\u519B\u4E5F\u6709\u4E0D\u5F97\u4E0D\\n\u70E6\u607C\u7684\u4E8B\u60C5\u5427\uFF1F\\c\\n\u4E0D\u8FC7\u6700\u91CD\u8981\u7684\u8FD8\u662F\\n\u59CB\u7EC8\u575A\u6301\u505A\u4F60\u81EA\u5DF1\u5BF9\u5427\uFF1F[VAR 0114(0008)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5927\u5E08\u7403\u662F\u4E00\u79CD\u975E\u5E38\u5389\u5BB3\u7684\u7403\uFF0C\\n\u65E0\u8BBA\u4EC0\u4E48\u5B9D\u53EF\u68A6\u90FD\u80FD\u6349\u4F4F\u5BF9\u5427\uFF01\uFF1F\\c\\n\u603B\u6709\u4E00\u5929\uFF0C\u4F60\u4E00\u5B9A\u4E5F\u4F1A\u9047\u5230\\n\u60F3\u7528\u5927\u5E08\u7403\u6765\u6355\u6349\u7684\u5B9D\u53EF\u68A6\u5462\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6728\u5170\u535A\u58EB\u6240\u8BF4\u7684\u4E8B\\n\u771F\u662F\u592A\u60CA\u4EBA\u4E86\u3002\\c\\n\u539F\u6765\u6781\u5DE8\u5316\u7684\u65F6\u5019\uFF0C\\n\u5B9D\u53EF\u68A6\u672C\u8EAB\u5E76\u6CA1\u6709\u53D8\u5927\uFF01\\c\\n\u5C3D\u7BA1\u5982\u6B64\uFF0C\u5BF9\u65B9\u5374\u6478\u5F97\u5230\u5B83\uFF0C\\n\u6781\u5DE8\u5316\u91CA\u653E\u7684\u529B\u91CF\u771F\u5F3A\u5927\u554A\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8BDD\u8BF4\u56DE\u6765\uFF0C\u4F60\u53BB\u8FC7\\n\u5BAB\u95E8\u5E02\u7684\u5BF9\u6218\u5854\u4E86\u5417\uFF1F\\c\\n\u542C\u4E39\u5E1D\u5988\u5988\u8BF4\uFF0C\\n\u4E39\u5E1D\u975E\u5E38\u671F\u5F85\u4F60\u8FC7\u53BB\u5462\u3002[VAR 0114(0008)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54AF\u54AF\u54DE\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u560E\u5495\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5495\u55EF\uFF5E\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u547C\u547C\u2026\u2026"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u545C\u55EF\uFF01\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5988\u5988\u5E73\u65F6\u603B\u662F\u7528\\n\u8FD9\u53F0\u7535\u89C6\u673A\u89C2\u770B\u559C\u5267\u7247\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5B89\u88C5\u5728\u5BA2\u5385\u91CC\u7684\u58C1\u7089\u3002\\n\u6709\u4E86\u5B83\uFF0C\u51AC\u5929\u518D\u51B7\u4E5F\u4E0D\u6015\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u5C0F\u5361\u6BD4\u517D\u7684\u88AB\u7A9D\u91CC\uFF0C\\n\u65F6\u5E38\u80FD\u770B\u89C1\u5403\u5269\u4E0B\u7684\u98DF\u7269\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u51B0\u7BB1\u91CC\u88C5\u6EE1\u4E86\u5168\u5BB6\u4EBA\u559C\u6B22\u7684\u98DF\u7269\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5982\u679C\u4E0D\u628A\u98DF\u7269\u6536\u62FE\u5E72\u51C0\uFF0C\u5C0F\u5361\u6BD4\u517D\u5C31\u4F1A\u5077\u5403\uFF0C\\n\u6240\u4EE5\u6C34\u69FD\u6536\u62FE\u5F97\u5E72\u5E72\u51C0\u51C0\u7684\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5988\u5988\u575A\u6301\u8981\u4E70\u56DE\u5BB6\u7684\\n\u6700\u65B0\u578B\u53F7\u7684\u70E4\u7BB1\u5FAE\u6CE2\u7089\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5168\u5BB6\u4E00\u8D77\u9009\u8D2D\u7684\u5E8A\uFF0C\\n\u67D4\u8F6F\u8212\u9002\uFF0C\u4E00\u8EBA\u4E0B\u5C31\u80FD\u5B89\u5FC3\u5165\u7761\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u7535\u89C6\u673A\u65C1\u653E\u7740\u4E00\u53F0\u6700\u65B0\u6B3E\u7684\u6E38\u620F\u673A\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4E00\u5F20\u8BBE\u8BA1\u7B80\u7EA6\u7684\u684C\u5B50\uFF0C\\n\u5927\u4EBA\u5C0F\u5B69\u90FD\u53EF\u4EE5\u4F7F\u7528\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u8FD9\u91CC\u6446\u653E\u7740\u8BB8\u591A\\n\u5173\u4E8E\u5B9D\u53EF\u68A6\u7684\u4E66\u548C\u6742\u5FD7\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u4F0A\u5E03\u7684\u73A9\u5076\uFF0C\\n\u6478\u8D77\u6765\u624B\u611F\u7279\u522B\u597D\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u76AE\u5361\u4E18\u7684\u73A9\u5076\uFF0C\\n\u6478\u8D77\u6765\u624B\u611F\u7279\u522B\u597D\uFF01"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u8DDF\u6E38\u620F\u673A\u4E00\u8D77\u4E70\u56DE\u5BB6\u7684\\n\u6700\u65B0\u6B3E\u7535\u89C6\u673A\u3002"
  }
]
