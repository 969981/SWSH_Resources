    "text": "[~ 10]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u9053\u9986\u4EFB\u52A1\u5F00\u59CB\uFF01\\n\u597D\u597D\u5C55\u793A\u4F60\u7684\u8EAB\u624B\u5427\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6709\u4EC0\u4E48\u95EE\u9898\u5417\uFF1F"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5982\u4F55\u5B8C\u6210\u4EFB\u52A1\uFF1F"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u8981\u9000\u51FA"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6CA1\u4EC0\u4E48"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8BF7\u4E00\u8FB9\u56DE\u7B54\u9053\u9986\u8BAD\u7EC3\u5BB6\u51FA\u7684\u8C1C\u9898\uFF0C\\n\u4E00\u8FB9\u6253\u8D62\u5BF9\u6218\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4E00\u65E6\u9000\u51FA\u5C31\u8981\u4ECE\u5934\u518D\u6765\uFF0C\\n\u4F60\u786E\u5B9A\u8981\u9000\u51FA\u5417\uFF1F"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u968F\u65F6\u606D\u5019\u4F60\u518D\u6765\u6311\u6218\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u53BB\u6311\u6218\u5427\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u9053\u9986\u4EFB\u52A1\u8FD8\u7B97\u6709\u8DA3\u5417\uFF1F"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u606D\u559C\u4F60\u987A\u5229\u5730\u5B8C\u6210\u4E86\u9053\u9986\u4EFB\u52A1\uFF01\\c\\n\u771F\u597D\u5947\u9053\u9986\u9986\u4E3B\u4F1A\u5982\u4F55\u8BC4\u5224\u4F60\u554A\uFF01\\c\\n[VAR 0100(0000)]\uFF0C\\n\u4F60\u8981\u7EE7\u7EED\u6311\u6218\u9053\u9986\u9986\u4E3B\u5417\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6311\u6218\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u8BF7\u7B49\u4E00\u4E0B"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u597D\uFF01\u8BF7\u4F60\u7EE7\u7EED\u524D\u8FDB\uFF01\\n\u4EE3\u6211\u5411\u9053\u9986\u9986\u4E3B\u95EE\u597D\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4E5F\u662F\uFF0C\u5199\u597D\u8BB0\u5F55\uFF0C\u505A\u597D\u51C6\u5907\uFF0C\\n\u624D\u80FD\u4E07\u65E0\u4E00\u5931\u554A\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6765\u6765\uFF0C\u5FEB\u8BA9\u6211\u8003\u9A8C\u4E0B\u4F60\uFF0C\\n\u770B\u770B\u4F60\u591F\u4E0D\u591F\u683C\\r\\n\u5F53\u5996\u7CBE\u5C5E\u6027\u7684\u9053\u9986\u9986\u4E3B\u5427\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64\u2026\u2026\\n\u6CE2\u666E\u83C8\u4F1A\u600E\u4E48\u60F3\u6211\u4E0D\u77E5\u9053\u2026\u2026\\r\\n\u4F46\u662F\u6211\u5BF9\u4F60\u8FD8\u7B97\u6EE1\u610F\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6211\u662F\u7B2C\uFF12\u4E2A\u51FA\u9898\u4EBA\u3002\\c\\n\u4F60\u4E0D\u8981\u5728\u610F\u521A\u624D\u90A3\u9053\u9898\u7684\u7ED3\u679C\uFF0C\\n\u7EE7\u7EED\u6311\u6218\u5C31\u662F\u4E86\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u7B54\u5BF9\uFF0C\u7B54\u9519\uFF0C\u90FD\u522B\u5728\u610F\u3002\\n\u7EE7\u7EED\u6311\u6218\u5C31\u662F\u4E86\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u4E0B\u4E00\u4E2A\u8F6E\u5230\u6211\u4E86\u3002\\c\\n\u4EE5\u4F60\u7684\u5B9E\u529B\uFF0C\u8BF4\u4E0D\u5B9A\u771F\u7684\u80FD\\n\u5F53\u4E0A\u5996\u7CBE\u5C5E\u6027\u9053\u9986\u9986\u4E3B\u54E6\u3002"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u597D\u597D\u7684\u9053\u9986\u6311\u6218\uFF0C\u5374\u7528\u6765\u9009\u62D4\u7EE7\u627F\u4EBA\u2026\u2026\\n\u771F\u662F\u62FF\u6CE2\u666E\u83C8\u9986\u4E3B\u6CA1\u529E\u6CD5\u3002"
