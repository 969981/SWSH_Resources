[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F60\u6765\u4E86\u554A\uFF0C\\n\u8FD8\u4E0D\u591F\u7C89\u7EA2\u7684\u9053\u9986\u6311\u6218\u8005\u3002[VAR 0114(0013)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u8FD9\u91CC\u7684\u9053\u9986\u4EFB\u52A1\uFF0C\\n\u5176\u5B9E\u4E5F\u987A\u4FBF\u7528\u6765\u9009\u62D4\u65B0\u7684\u9053\u9986\u9986\u4E3B\u2026\u2026\\r\\n\u56E0\u4E3A\u6211\u4E5F\u9700\u8981\u4E2A\u63A5\u73ED\u4EBA\u554A\u3002[VAR 0114(0013)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u653E\u5FC3\uFF0C\u4EFB\u52A1\u7B80\u5355\u5F97\u5F88\uFF01\\c\\n\u4F60\u53EA\u8981\u4E00\u8FB9\u5BF9\u6218\uFF0C\\n\u4E00\u8FB9\u56DE\u7B54\u5927\u5BB6\u51FA\u7684\u8C1C\u9898\u5C31\u597D\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u4F60\u8981\u6CE8\u610F\uFF0C\u4E00\u65E6\u7B54\u9519\u9898\uFF0C\\n\u5BF9\u6218\u4E2D\u7684\u5B9D\u53EF\u68A6\u7684\u80FD\u529B\u5C31\u4F1A\u4E0B\u964D\u2026\u2026\\r\\n\u5F53\u7136\uFF0C\u7B54\u5BF9\u9898\u65F6\uFF0C\u80FD\u529B\u5C31\u4F1A\u63D0\u9AD8\u3002\\c\\n\u8FD9\u662F\u5996\u7CBE\u5C5E\u6027\u5B9D\u53EF\u68A6\\n\u7279\u6709\u7684\u795E\u5947\u529B\u91CF\u3002[VAR 0114(0013)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6765\uFF0C\u8BA9\u6211\u597D\u597D\u6B23\u8D4F\u4E00\u4E0B\\n\u4F60\u7684\u771F\u672C\u9886\u5427\u3002[VAR 0114(0013)]"
  },
