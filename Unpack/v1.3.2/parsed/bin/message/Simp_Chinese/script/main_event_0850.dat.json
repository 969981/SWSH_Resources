    "text": "\u6D1B\u5179\u4F1A\u957F\uFF01\\c\\n\u8BB8\u613F\u661F\u548C\u9053\u9986\u5FBD\u7AE0\uFF0C\\n\u6211\u90FD\u6536\u96C6\u5F97\u5F88\u987A\u5229\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F\u5F7C\u7279\u9009\u624B\uFF01\\c\\n\u770B\u6765\u4F60\u6CA1\u6709\u8F9C\u8D1F\u4F1A\u957F\u7684\u671F\u5F85\uFF0C\\n\u4E00\u76F4\u90FD\u5728\u52AA\u529B\u554A\u3002[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u8DB3\u591F\u7684\u8BB8\u613F\u661F\uFF0C\\n\u5C31\u80FD\u89E3\u51B3\u4F1A\u957F\u7684\u70E6\u607C\u4E86\uFF0C\u5BF9\u5427\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0D\uFF0C\u8FD9\u4E0D\u662F\u4E3A\u4E86\u89E3\u51B3\u6211\u7684\u95EE\u9898\uFF0C\\n\u800C\u662F\u4E3A\u4E86\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u672A\u6765\u554A\u3002[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u800C\u4E14\uFF0C\u6211\u4EEC\u9700\u8981\u7684\u4E0D\u53EA\u662F\u8BB8\u613F\u661F\u3002\\n\u6211\u4EEC\u8FD8\u9700\u8981\u50CF\u51A0\u519B\u90A3\u6837\\r\\n\u5B9E\u529B\u96C4\u539A\u7684\u8BAD\u7EC3\u5BB6\u3002[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u2026\u2026\u6055\u6211\u76F4\u8A00\u3002\\c\\n\u6211\u5DF2\u7ECF\u8BA9\u51A0\u519B\u63A8\u8350\u7684\u8BAD\u7EC3\u5BB6\uFF0C\\n\u90A3\u4E2A\u53EB\u8D6B\u666E\u7684\u2026\u2026\\r\\n\u8BA4\u8BC6\u5230\u4ED6\u548C\u6211\u5B9E\u529B\u60AC\u6B8A\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u51ED\u6211\u7684\u5B9E\u529B\uFF0C\u4E00\u5B9A\u80FD\u6218\u80DC\u51A0\u519B\uFF01\\n\u6211\u4F1A\u8D62\u7ED9\u60A8\u770B\u7684\uFF01[VAR 0114(000C)]"
  },
  {
