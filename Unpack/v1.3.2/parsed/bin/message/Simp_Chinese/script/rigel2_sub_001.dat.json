    "text": "\u4F60\u7684\u738B\u51A0\u96EA\u539F\u56FE\u9274\\n\u73B0\u5728\u7684\u5B8C\u6210\u5EA6\u662F\u2026\u2026"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u53D1\u73B0\u7684\u5B9D\u53EF\u68A6\u6709[VAR 0202(0000)]\u79CD\uFF01\\n\u6349\u5230\u7684\u5B9D\u53EF\u68A6\u6709[VAR 0202(0001)]\u79CD\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u54C8\u54C8\uFF0C\u522B\u6025\u522B\u6025\uFF0C\\n\u4F60\u7684\u738B\u51A0\u96EA\u539F\u56FE\u9274\u624D\u521A\u521A\u5347\u7EA7\u561B\uFF01\\c\\n\u4ECE\u8FD9\u91CC\u5F00\u59CB\u624D\u662F\u5192\u9669\u7684\u7B2C\u4E00\u6B65\u5462\uFF01\\n\u52A0\u6CB9\u54E6\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u867D\u7136\u4F60\u8FD8\u53EA\u662F\u4E2A\u65B0\u624B\uFF0C\\n\u4F46\u6211\u80FD\u770B\u51FA\u4F60\u5F88\u52AA\u529B\uFF01\\c\\n\u96EA\u9053\u3001\u6D1E\u7A9F\u3001\u5C71\u9876\u7B49\u2026\u2026\\c\\n\u5728\u4E0D\u540C\u7684\u5730\u65B9\uFF0C\\n\u80FD\u9047\u5230\u7684\u5B9D\u53EF\u68A6\u90FD\u4E0D\u4E00\u6837\u54E6\uFF01\\c\\n\u4E3A\u4E86\u4E0E\u5404\u79CD\u5404\u6837\u7684\u5B9D\u53EF\u68A6\u76F8\u9047\uFF0C\\n\u4F60\u8981\u5230\u5904\u591A\u8F6C\u8F6C\u54DF\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4F60\u5DF2\u7ECF\u6349\u5230\u8D85\u8FC7\uFF13\uFF10\u79CD\u5B9D\u53EF\u68A6\u4E86\uFF1F\\n\u901F\u5EA6\u76F8\u5F53\u5FEB\u554A\uFF01\\c\\n\u5BF9\u4E86\uFF0C\u4F60\u6709\u6CA1\u6709\u5728\u6CE8\u610F\u5929\u6C14\uFF1F\\n\u5929\u6674\u65F6\uFF0C\u4E0B\u96E8\u65F6\uFF0C\\r\\n\u51B0\u96F9\u6216\u6C99\u66B4\u65F6\u2026\u2026\\c\\n\u5929\u6C14\u4E0D\u540C\uFF0C\\n\u51FA\u73B0\u7684\u5B9D\u53EF\u68A6\u4E5F\u4F1A\u6709\u70B9\u4E0D\u540C\u54E6\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u5DF2\u7ECF\u6349\u5230\uFF15\uFF10\u79CD\u4EE5\u4E0A\u5B9D\u53EF\u68A6\u4E86\uFF01\uFF1F\\n\u8FD9\u662F\u4EC0\u4E48\u901F\u5EA6\uFF01\uFF1F\\c\\n\u4F60\u6349\u5230\u7684\u5B9D\u53EF\u68A6\u79CD\u7C7B\\n\u5DEE\u4E0D\u591A\u662F\u603B\u6570\u7684\uFF14\u5206\u4E4B\uFF11\u4E86\u54CE\uFF01\\c\\n\u7EE7\u7EED\u5728\u738B\u51A0\u96EA\u539F\u4E0A\u5192\u9669\u5427\uFF01\\n\u4E0D\u8FC7\u8BB0\u5F97\u8981\u5F53\u5FC3\u96EA\u539F\u4E0A\u7684\u96EA\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u770B\u6765\u4F60\u6B63\u7A33\u6B65\u987A\u5229\u5730\u4E0D\u65AD\u5C06\\n\u66F4\u591A\u65B0\u7684\u5B9D\u53EF\u68A6\u6DFB\u52A0\u5230\u56FE\u9274\u91CC\u5462\uFF01\\c\\n\u8981\u662F\u4F60\u9047\u5230\u5B9D\u53EF\u68A6\u65F6\\n\u80FD\u7528\u5148\u673A\u7403\u8FC5\u901F\u89E3\u51B3\u6218\u6597\u7684\u8BDD\u2026\u2026\\c\\n\u4F60\u56FE\u9274\u4E0A\u7684\u767B\u5F55\u6570\u4F30\u8BA1\u5F88\u5FEB\u5C31\u80FD\\n\u8F7B\u800C\u6613\u4E3E\u5730\u8D8A\u8FC7\uFF11\uFF10\uFF10\u79CD\u7684\u5927\u5173\u4E86\u5427\uFF1F"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u4E00\u7728\u773C\u7684\u529F\u592B\uFF0C\u4F60\u5C31\u5DF2\u7ECF\\n\u6355\u6349\u5230\u8D85\u8FC7\uFF11\uFF10\uFF10\u79CD\u5B9D\u53EF\u68A6\u4E86\uFF01\\c\\n\u770B\u6765\u627E\u4F60\u5F53\u6211\u7814\u7A76\u7684\u5E2E\u624B\uFF0C\\n\u6211\u8FD8\u771F\u662F\u627E\u5BF9\u4EBA\u4E86\u554A\u3002\\c\\n\u73B0\u5728\u8FDB\u5EA6\u5927\u6982\u5DF2\u7ECF\u5230\u4E00\u534A\u5DE6\u53F3\u4E86\uFF01\\n\u540E\u9762\u7684\u90E8\u5206\u4E5F\u8BF7\u4F60\u591A\u52A0\u6CB9\u54AF\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4FE1\u606F\u91CF\u8FD9\u4E48\u5927\u7684\u56FE\u9274\uFF0C\\n\u9605\u89C8\u8D77\u6765\u53EF\u771F\u662F\u79CD\u4EAB\u53D7\u554A\u3002\\c\\n\u770B\u6765\u4F60\u5404\u79CD\u5404\u6837\u7684\\n\u5730\u65B9\u90FD\u53BB\u8FC7\u5462\uFF0C\\r\\n\u6BD4\u5982\u6C34\u8FB9\u3001\u6D1E\u7A9F\u6216\u5C71\u4E0A\u4EC0\u4E48\u7684\u3002\\c\\n\u4FDD\u6301\u8FD9\u80A1\u52B2\u5934\uFF0C\u7EE7\u7EED\u591A\u8D70\u591A\u8F6C\uFF0C\\n\u4E89\u53D6\u628A\u56FE\u9274\u7ED9\u5F7B\u5E95\u586B\u6EE1\u5427\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5B8C\u6210\u5230\u8FD9\u4E2A\u7A0B\u5EA6\u7684\\n\u738B\u51A0\u96EA\u539F\u56FE\u9274\u2026\u2026\\r\\n\u6211\u8FD8\u4ECE\u6765\u90FD\u6CA1\u89C1\u5230\u8FC7\u5462\uFF01\\c\\n\u4F60\u80AF\u5B9A\u4E5F\u6709\u5728\u5229\u7528\\n\u9493\u9C7C\u7B49\u624B\u6BB5\u6355\u6349\u5B9D\u53EF\u68A6\u5427\uFF1F\\c\\n\u8FD9\u53EF\u662F\u79CD\u5F88\u5BB9\u6613\u88AB\u4EBA\u5FFD\u7565\u7684\\n\u4E0E\u5B9D\u53EF\u68A6\u76F8\u9047\u7684\u65B9\u6CD5\u5462\u3002"
