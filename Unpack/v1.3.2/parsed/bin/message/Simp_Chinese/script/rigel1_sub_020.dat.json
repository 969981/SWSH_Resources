  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u5BF9\u90A3\u5B69\u5B50\u5F88\u597D\u5947\uFF1F[VAR 0114(0075)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u771F\uFF5E\u6CA1\u52B2\u3002[VAR 0114(0075)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u563F\u563F\u563F\uFF0C\u4F60\u5F88\u61C2\u561B\u3002[VAR 0114(0075)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u90A3\u5B69\u5B50\u6B63\u662F\u865A\u62DF\u5B9D\u53EF\u68A6\uFF0C\\n\u591A\u8FB9\u517D\u54E6\u3002[VAR 0114(0075)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5B83\u662F\u8FD0\u7528\u4E86\u6700\u5148\u8FDB\u7684\u79D1\u6280\\n\u7ECF\u7531\u4EBA\u624B\u521B\u9020\u8BDE\u751F\u7684\u5B58\u5728\u3002[VAR 0114(0075)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6362\u53E5\u8BDD\u8BF4\uFF0C\u5B83\u662F\u79D1\u5B66\u6280\u672F\u7684\u7ED3\u6676\u3002\\n\u4E0D\u8FC7\u90A3\u4E5F\u662F\u5F88\u591A\u5E74\u4EE5\u524D\u7684\u4E8B\u4E86\u3002[VAR 0114(0075)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u56E0\u4E3A\u8BDE\u751F\u4E8E\u5F88\u4E45\u4EE5\u524D\uFF0C\u6240\u4EE5\u9020\u578B\u4EE5\u76F4\u7EBF\u4E3A\u4E3B\u3002\\n\u4E0D\u8FC7\uFF0C\u4E5F\u6B63\u56E0\u4E3A\u5B83\u662F\u8FD9\u6837\u4E00\u79CD\u5F62\u72B6\u2026\u2026[VAR 0114(0075)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6240\u4EE5\u624D\u4F1A\u6563\u53D1\u51FA\u4E00\u79CD\u590D\u53E4\u7684\u98CE\u60C5\uFF0C\\n\u5BF9\u4E8E\u7231\u597D\u8005\u6709\u7740\u96BE\u4EE5\u6297\u62D2\u7684\u5438\u5F15\u529B\u3002[VAR 0114(0075)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5BF9\u4E86\u5BF9\u4E86\uFF0C\u8BA9\u591A\u8FB9\u517D\u643A\u5E26\u5347\u7EA7\u6570\u636E\u540E\\n\u548C\u522B\u4EBA\u8FDE\u63A5\u4EA4\u6362\uFF0C\u5B83\u5C31\u4F1A\u8FDB\u5316\u6210\u591A\u8FB9\u517D\uFF12\u578B\u3002[VAR 0114(0075)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u591A\u8FB9\u517D\uFF12\u578B\u7684\u8EAB\u4F53\u7EBF\u6761\u5448\u6D41\u7EBF\u578B\uFF0C\\n\u987A\u6ED1\u6D41\u7545\uFF0C\u522B\u63D0\u591A\u4F18\u7F8E\u4E86\u3002[VAR 0114(0075)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u554A\uFF01\u5B83\u751A\u81F3\u80FD\u591F\u8BA9\u4EBA\u611F\u53D7\u5230\u4EBA\u7C7B\u7684\u8FDB\u5316\uFF0C\\n\u5B9E\u5728\u662F\u4E00\u79CD\u8FC7\u4E8E\u4F18\u79C0\u7684\u5B9D\u53EF\u68A6\uFF01\uFF01[VAR 0114(0075)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u2026\u2026\u80FD\u5728\u7239\u5730\u706B\u529B\u5168\u5F00\u65F6\\n\u6218\u80DC\u4ED6\u7684\u4EBA\u771F\u7684\u5F88\u5C11\u89C1\uFF0C\\r\\n\u6240\u4EE5\u6211\u5C31\u628A\u591A\u8FB9\u517D\u5F53\u8D3A\u793C\u9001\u7ED9\u4F60\u5427\u3002[VAR 0114(0075)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u53EF\u4EE5\u901A\u8FC7\u6B23\u8D4F\u591A\u8FB9\u517D\uFF0C\\n\u7EC6\u7EC6\u54C1\u5473\u4EBA\u7C7B\u7684\u82F1\u660E\u777F\u667A\u3002[VAR 0114(0075)]"
  }
]
