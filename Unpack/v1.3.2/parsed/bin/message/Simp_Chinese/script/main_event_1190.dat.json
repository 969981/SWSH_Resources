    "text": "[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E3A\u4E86\u53D8\u5F3A\uFF0C\u6211\u8981\u505A\u5404\u79CD\u5C1D\u8BD5\uFF01\\n\u4E0D\u7136\u7684\u8BDD\uFF0C\u8FFD\u4E0A\u5927\u54E5\u2026\u2026\\r\\n\u4E0D\uFF0C\u8D85\u8FC7\u5927\u54E5\u7684\u76EE\u6807\u5C31\u6CA1\u6CD5\u5B9E\u73B0\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u603B\u800C\u8A00\u4E4B\uFF01\u5F52\u6839\u7ED3\u5E95\uFF01\\n\u5FEB\u6765\u966A\u6211\u5BF9\u6218\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5728\u6211\u81EA\u5DF1\u5F00\u59CB\u5192\u9669\u4E4B\u524D\u2026\u2026\\n\u770B\u5230\u7535\u89C6\u91CC\u7684\u5927\u54E5\uFF0C\\r\\n\u53EA\u662F\u5355\u7EAF\u5730\u89C9\u5F97\u4ED6\u5F88\u5F3A\uFF0C\u5F88\u8000\u773C\u3002[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u800C\u73B0\u5728\uFF0C\u6211\u7EC8\u4E8E\u77E5\u9053\u4ED6\u5230\u5E95\u6709\u591A\u5F3A\u2026\u2026\\n\u4E5F\u77E5\u9053\u81EA\u5DF1\u7F3A\u5C11\u7684\u662F\u4EC0\u4E48\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u6211\u4E5F\u6709\u5728\u53D8\u5F3A\uFF01\\n\u53EA\u662F\u8FDB\u6B65\u7684\u901F\u5EA6\u6CA1\u4F60\u90A3\u4E48\u5FEB\u7F62\u4E86\u3002\\c\\n\u591A\u8C22\u4F60\u966A\u6211\u5BF9\u6218\uFF01\\n\u6211\u6765\u5E2E\u4F60\u7684\u5B9D\u53EF\u68A6\u6062\u590D\u6D3B\u529B\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u81EA\u5DF1\u7684\u5FC3\u613F\u662F\u4EC0\u4E48\u4E86\u2026\u2026\\n\u6211\u60F3\u548C\u5927\u54E5\u5BF9\u6218\u2026\u2026\uFF01\\c\\n\u4E0D\uFF0C\u6211\u8981\u6253\u8D62\u65E0\u654C\u7684\u51A0\u519B\uFF01\\n\u4E0D\u8D85\u8FC7\u5927\u54E5\u51B3\u4E0D\u7F62\u4F11\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u51B3\u5B9A\u4E86\uFF01\\n\u5728\u6218\u7ADE\u9547\u8D62\u5F97\u9053\u9986\u5FBD\u7AE0\u540E\uFF0C\\r\\n\u6211\u4F1A\u6253\u8D77\u7CBE\u795E\uFF0C\u518D\u6B21\u5411\u4F60\u6311\u6218\uFF01[VAR 0114(0005)]"
  }
]
