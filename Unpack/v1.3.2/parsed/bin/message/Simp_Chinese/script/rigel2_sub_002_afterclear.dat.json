    "text": "\u60F3\u548C\u4F60\u5BF9\u6218"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u6CA1\u4EC0\u4E48\u4E8B"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54E6\uFF1F\u4F60\u6539\u4E3B\u610F\u5566\uFF01\\n\u6CA1\u5173\u7CFB\uFF0C\u8FD9\u4E5F\u662F\u5E38\u6709\u7684\u4E8B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u6253\u7B97\u7ED9\u6211\u770B\u54EA\u4E00\u4E2A\u554A\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5440\uFF1F\u4F60\u7684\u540C\u884C\u961F\u4F0D\u91CC\\n\u597D\u50CF\u6CA1\u6709\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u554A\uFF01\\r\\n\u54C7\u54C8\u54C8\uFF01\u6CA1\u5173\u7CFB\uFF0C\u8FD9\u4E5F\u662F\u5E38\u6709\u7684\u4E8B\uFF01[VAR 0114(0076)]"
  },
