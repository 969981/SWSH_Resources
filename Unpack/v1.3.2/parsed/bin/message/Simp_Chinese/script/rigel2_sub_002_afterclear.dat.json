    "text": "[VAR 0101(0006)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8FD8\u662F\u7B97\u4E86"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54CE\u54DF\uFF01\u4F60\u53C8\u4E0D\u60F3\\n\u628A\u4F20\u8BF4\u62FF\u7ED9\u6211\u770B\u4E86\u554A\uFF1F\\r\\n\u54C7\u54C8\u54C8\uFF01\u6CA1\u5173\u7CFB\uFF0C\u8FD9\u4E5F\u662F\u5E38\u6709\u7684\u4E8B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u901A\u8FC7\u64CD\u4F5C\u9057\u4F20\u57FA\u56E0\u5236\u9020\u51FA\u6765\u7684\\n\u51F6\u66B4\u5B9D\u53EF\u68A6\uFF0C\u8D85\u68A6\uFF1F\\c\\n\u867D\u7136\u5B83\u7684\u8138\u8272\u662F\u6709\u70B9\u82CD\u767D\uFF0C\\n\u4E0D\u8FC7\u770B\u8D77\u6765\u662F\u4E2A\u633A\u6E29\u987A\u7684\u5BB6\u4F19\u561B\uFF01\\c\\n\u867D\u7136\u8FD9\u5F20\u8138\u770B\u8D77\u6765\u4E0D\u592A\u597D\u60F9\uFF0C\\n\u4F46\u9AA8\u5B50\u91CC\u4E00\u5B9A\u662F\u4E2A\u597D\u5BB6\u4F19\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6EDA\u51FA\u6765\u5566\uFF01\\n\u4F60\u8FD9\u53EA\u552C\u4EBA\u7684\u6025\u51BB\u9E1F\uFF01\\c\\n\u8FD8\u662F\u6234\u7740\u90A3\u526F\u5947\u602A\u7684\u9762\u5177\uFF0C\\n\u5230\u5E95\u5728\u60F3\u4EC0\u4E48\u554A\u2026\u2026\\c\\n\u603B\uFF5E\u611F\u89C9\u6211\u50CF\u662F\u88AB\u770B\u6241\u4E86\uFF0C\\n\u662F\u6211\u60F3\u592A\u591A\u4E86\u5417\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u54E6\u54E6\uFF01\uFF1F\u552C\u4EBA\u7684\u6025\u51BB\u9E1F\uFF0C\\n\u4F60\u6458\u4E0B\u90A3\u5947\u602A\u7684\u9762\u5177\u4E86\u554A\uFF01\\c\\n\u8FD9\u4E0B\u4F60\u90A3\u53CC\u6709\u795E\u7684\u773C\u775B\u5C31\u9732\u51FA\u6765\u4E86\u3002\\n\u4F60\u8FD8\u662F\u8FD9\u6837\u6BD4\u8F83\u80FD\u5438\u5F15\u5F02\u6027\u554A\uFF01\\c\\n\u8BDD\u8BF4\uFF0C\u600E\u4E48\u7A81\u7136\u53D8\u5F97\u8FD9\u4E48\u51B7\u554A\uFF1F\\n\u2026\u2026\u662F\u5916\u9762\u4E0B\u96EA\u4E86\u5417\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6EDA\u51FA\u6765\u5566\uFF01\\n\u4F60\u8FD9\u53EA\u552C\u4EBA\u7684\u95EA\u7535\u9E1F\uFF01\\c\\n\u770B\u4F60\u53C8\u662F\u628A\u8EAB\u4F53\u5F04\u5F97\u523A\u523A\u7684\uFF0C\\n\u53C8\u662F\u8BA9\u5634\u53D8\u5F97\u5C16\u5C16\u7684\u3002\\c\\n\u4F60\u5F88\u60F3\u53D8\u6210\u4E00\u53EA\u50CF\u6837\u7684\u95EA\u7535\u9E1F\u5427\uFF1F\\n\u6211\u5012\u662F\u627F\u8BA4\u4F60\u786E\u5B9E\u5F88\u52AA\u529B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u54E6\u54E6\uFF01\uFF1F\u8FD9\u5BB6\u4F19\uFF0C\\n\u6478\u4E0A\u53BB\u9EBB\u9EBB\u7684\u611F\u89C9\u554A\uFF01\\c\\n\u96BE\u9053\u8FD9\u552C\u4EBA\u7684\u95EA\u7535\u9E1F\\n\u8EAB\u4E0A\u5E26\u4E86\u9759\u7535\u5417\uFF01\uFF1F\\c\\n\u53EA\u8981\u5929\u6C14\u53C8\u51B7\u53C8\u5E72\u71E5\uFF0C\\n\u9759\u7535\u5C31\u4F1A\u627E\u4E0A\u9EBB\u70E6\u6765\u554A\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6EDA\u51FA\u6765\u5566\uFF01\\n\u4F60\u8FD9\u53EA\u552C\u4EBA\u7684\u706B\u7130\u9E1F\uFF01\\c\\n\u770B\u4F60\u70E7\u5F97\u597D\u50CF\u633A\u65FA\u7684\uFF0C\\n\u7ED3\u679C\u4E00\u70B9\u90FD\u4E0D\u70EB\u4EBA\u554A\uFF01\\c\\n\u4F60\u90A3\u773C\u795E\u867D\u7136\u770B\u7740\u633A\u51F6\uFF0C\\n\u4F46\u8BA9\u4EBA\u611F\u89C9\u4EB2\u8FD1\uFF0C\u8BA8\u538C\u4E0D\u8D77\u6765\u554A\u3002[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u54E6\u54E6\uFF01\uFF1F\u8FD9\u5BB6\u4F19\\n\u70E7\u5F97\u4E5F\u592A\u65FA\u4E86\u5427\uFF01\uFF1F\\c\\n\u552C\u4EBA\u7684\u706B\u7130\u9E1F\u2026\u2026\\n\u4F60\u8BE5\u4E0D\u4F1A\u662F\u53D1\u70E7\u4E86\u5427\uFF1F\\c\\n\u6CE8\u610F\u4FDD\u6696\uFF0C\u597D\u597D\u7761\u4E00\u89C9\u5427\uFF01\\n\u2026\u2026\u8981\u6CE8\u610F\u8EAB\u4F53\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u62E5\u6709\u4E03\u5F69\u7FC5\u8180\u7684\\n\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\uFF0C\u51E4\u738B\uFF1F\\r\\n\u7EA2\u8272\u3001\u767D\u8272\u3001\u9EC4\u8272\u2026\u2026\\c\\n\u8981\u8BF4\u662F\u4E03\u5F69\uFF0C\\n\u4F3C\u4E4E\u8FD8\u5DEE\u4E86\u4E9B\u989C\u8272\u554A\u2026\u2026\\c\\n\u4F46\u6211\u53C8\u4E0D\u5FCD\u5FC3\u574F\u4E86\u961F\u957F\u7684\u7F8E\u68A6\uFF0C\\n\u6240\u4EE5\u6211\u5C31\u76F8\u4FE1\u4F60\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u88AB\u79F0\u4E3A\u6D77\u795E\u7684\\n\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\uFF0C\u6D1B\u5947\u4E9A\uFF1F\\c\\n\u660E\u660E\u662F\u4E2A\u6D77\u795E\uFF0C\u5374\u662F\u98DE\u884C\u5C5E\u6027\u3002\\n\u53C8\u4F1A\u5728\u6C34\u91CC\u6E38\uFF0C\u53C8\u4F1A\u5728\u5929\u4E0A\u98DE\uFF0C\\r\\n\u4EC0\u4E48\u90FD\u4F1A\uFF0C\u7B80\u76F4\u592A\u5389\u5BB3\u5566\uFF01\\c\\n\u5728\u79BB\u8FD9\u91CC\u5F88\u8FDC\u7684\u5730\u533A\u6709\u4E2A\\n\u4E3E\u529E\u5B9D\u53EF\u5168\u80FD\u7ADE\u6280\u8D5B\u7684\u8FD0\u52A8\u8BBE\u65BD\uFF0C\\r\\n\u8FD9\u5BB6\u4F19\u4E00\u5B9A\u80FD\u5728\u90A3\u91CC\u5927\u663E\u8EAB\u624B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u542C\u8BF4\u662F\u4ECE\u5929\u4E0A\u548C\u96F7\u7535\u4E00\u8D77\\n\u843D\u4E0B\u6765\u7684\u5B9D\u53EF\u68A6\u2026\u2026\u96F7\u516C\uFF1F\\c\\n\u6211\u770B\u4F60\u5403\u4E86\u4E0D\u5C11\u82E6\u5934\u554A\u3002\\c\\n\u4E5F\u96BE\u602A\u4F60\u80CC\u4E0A\u7684\u6BDB\u4F1A\u5377\u8D77\u6765\u3002[VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u542C\u8BF4\u662F\u4ECE\u706B\u5C71\u7206\u53D1\u4E2D\\n\u8BDE\u751F\u7684\u5B9D\u53EF\u68A6\u2026\u2026\u708E\u5E1D\uFF1F\\c\\n\u54CE\uFF0C\u8FD9\u600E\u4E48\u53EF\u80FD\uFF01\\n\u5B9E\u5728\u6CA1\u6CD5\u8BA9\u4EBA\u76F8\u4FE1\u554A\uFF01\\c\\n\u8FD8\u662F\u8BF4\u4E8B\u60C5\u662F\u8FD9\u6837\uFF1F\\n\u5B83\u8001\u7238\u662F\u5EA7\u706B\u5C71\uFF1F\\c\\n\u8FD8\u662F\u8BF4\u5B83\u8001\u5988\u662F\u5EA7\u706B\u5C71\uFF1F\\n\u662F\u8FD9\u6837\u5417\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u54E6\uFF01\u633A\u6F02\u4EAE\u7684\u5B9D\u53EF\u68A6\u554A\uFF01\\n\u4F60\u662F\u8BF4\u8FD9\u5BB6\u4F19\u5C31\u662F\u6C34\u541B\u5417\uFF1F\\c\\n\u5B83\u5934\u4E0A\u7684\u89D2\u90FD\u6210\u4E86\u4E2A\u5708\u513F\uFF0C\\n\u771F\u662F\u592A\u9177\u4E86\uFF01\\c\\n\u2026\u2026\u4E0D\u8FC7\uFF0C\u5B83\u8FD9\u8111\u888B\\n\u5728\u7761\u89C9\u65F6\u8981\u600E\u4E48\u7FFB\u8EAB\u554A\uFF1F\\c\\n\u7761\u89C9\u65F6\u4F1A\u5F88\u8F9B\u82E6\u5427\uFF1F\\n\u6C34\u541B\u5B83\u7761\u5F97\u597D\u89C9\u5417\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u4F60\u8BF4\u5B83\u5C31\u662F\u88AB\u79F0\u4E3A\\n\u5927\u5730\u5316\u8EAB\u7684\u5B9D\u53EF\u68A6\uFF0C\u56FA\u62C9\u591A\uFF01\uFF1F\\c\\n\u8981\u662F\u5B83\u771F\u50CF\u4F20\u95FB\u4E2D\u8BF4\u7684\u4E00\u6837\\n\u7761\u5728\u7194\u5CA9\u91CC\uFF0C\u90A3\u5C31\u592A\u725B\u5566\uFF01\\c\\n\u6211\u4E5F\u7ECF\u5E38\u53BB\u84B8\u6851\u62FF\uFF0C\\n\u6240\u4EE5\u5B8C\u5168\u7406\u89E3\u5B83\u7684\u5FC3\u60C5\uFF01\\c\\n\u5B83\u4ECE\u7194\u5CA9\u91CC\u51FA\u6765\u65F6\uFF0C\\n\u60F3\u5FC5\u5FC3\u60C5\u4E00\u5B9A\u5F88\u8212\u670D\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u4F60\u8BF4\u5B83\u5C31\u662F\u4F20\u8BF4\u4E2D\\n\u521B\u9020\u4E86\u5927\u6D77\u7684\u5B9D\u53EF\u68A6\uFF0C\u76D6\u6B27\u5361\uFF01\uFF1F\\c\\n\u90FD\u8BF4\u5927\u6D77\u662F\u4E07\u7269\u4E4B\u6BCD\u2026\u2026\\n\u90A3\u4E07\u7269\u4E4B\u6BCD\u7684\u6BCD\u4EB2\u53C8\u662F\u4EC0\u4E48\uFF01\uFF1F\\c\\n\u8FD9\u6837\u8BF4\u6765\uFF0C\\n\u5B83\u4E0D\u5C31\u662F\u6211\u4EEC\u7684\u5976\u5976\u4E86\u5417\u2026\u2026\uFF1F\\c\\n\u5582\u5582\u2026\u2026\u961F\u957F\uFF0C\\n\u4F60\u53EF\u8981\u5BF9\u76D6\u6B27\u5361\u6E29\u67D4\u70B9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u554A\uFF1F\u70C8\u7A7A\u5750\uFF1F\\n\u5728\u9AD8\u7A7A\u4E2D\u7684\u81ED\u6C27\u5C42\\r\\n\u6816\u606F\u7684\u5B9D\u53EF\u68A6\uFF1F\\c\\n\u4F4F\u5728\u7A7A\u6C14\u90A3\u4E48\u7A00\u8584\u7684\u5730\u65B9\uFF0C\\n\u7B80\u76F4\u5C31\u662F\u4E2A\u8FD0\u52A8\u4E13\u5BB6\u554A\uFF01\\c\\n\u54CE\uFF0C\u4E0D\u8FC7\u4F60\u4E5F\u786E\u5B9E\u957F\u4E86\u5F20\\n\u5BF9\u81EA\u5DF1\u5F88\u4E25\u683C\u7684\u8138\u554A\uFF01\\c\\n\u867D\u7136\u6211\u4E0D\u77E5\u9053\u4F60\u5728\u641E\u4EC0\u4E48\u8FD0\u52A8\uFF0C\\n\u4E0D\u8FC7\u4F60\u597D\u597D\u52A0\u6CB9\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u80FD\u901A\u8FC7\u5FC3\u7075\u611F\u5E94\\n\u611F\u77E5\u4EBA\u5FC3\u7684\u5B9D\u53EF\u68A6\uFF0C\u62C9\u5E1D\u4E9A\u65AF\u554A\u2026\u2026\\c\\n\u8FD9\u5BB6\u4F19\u770B\u7740\u5F88\u53EF\u7231\uFF0C\\n\u60F3\u4E0D\u5230\u5374\u5F88\u5389\u5BB3\u554A\uFF01\\c\\n\u597D\uFF01\u90A3\u4F60\u731C\u731C\\n\u6211\u73B0\u5728\u6B63\u5728\u60F3\u4EC0\u4E48\u5427\uFF01\\c\\n\u2026\u2026\u7B49\u7B49\uFF0C\u8981\u662F\u771F\u88AB\u731C\u4E2D\u7684\u8BDD\\n\u5C31\u592A\u53EF\u6015\u4E86\uFF01\u5F53\u6211\u6CA1\u8BF4\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u62E5\u6709\u5F88\u9AD8\u7684\u667A\u5546\uFF0C\\n\u80FD\u7406\u89E3\u4EBA\u7C7B\u8BED\u8A00\u7684\u5B9D\u53EF\u68A6\uFF0C\u62C9\u5E1D\u6B27\u65AF\u2026\u2026\uFF1F\\c\\n\u8FD9\u8981\u662F\u771F\u7684\uFF0C\u90A3\u5C31\u592A\u5389\u5BB3\u4E86\u3002\\n\u4E0D\u8FC7\u6211\u6CA1\u6CD5\u4E00\u4E0B\u5B50\u5C31\u76F8\u4FE1\u554A\u3002\\c\\n\u5927\u5BB6\u90FD\u8BF4\u4F60\u662F\u90A3\u4E2A\\n\u53EB\u62C9\u5E1D\u4E9A\u65AF\u7684\u54E5\u54E5\u5427\u3002\\c\\n\u8FD9\u6837\u554A\u2026\u2026\u5F53\u54E5\u54E5\u7684\u554A\u2026\u2026\\n\u90A3\u4F60\u53EF\u8981\u5F53\u4E2A\u597D\u54E5\u54E5\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u4F60\u51FA\u6765\u5566\uFF01\\n\u5C0F\u5C0F\u7684\u5CA9\u77F3\u5DE8\u4EBA\uFF01\\c\\n\u2026\u2026\u54C7\u54C8\u54C8\uFF01\\n\u5F00\u73A9\u7B11\u5462\uFF0C\u4F60\u522B\u4ECB\u610F\u554A\uFF01\\c\\n\u6211\u5BF9\u4F60\u90A3\u5BBD\u5BBD\u7684\u80A9\u8180\uFF0C\\n\u53EF\u662F\u975E\uFF5E\u5E38\u656C\u4F69\u7684\u54E6\uFF01\\c\\n\u4EE5\u540E\u4F60\u4E5F\u8981\\n\u5751\u5751\u6D3C\u6D3C\u5730\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u4F60\u51FA\u6765\u5566\uFF01\\n\u5C0F\u5C0F\u7684\u51B0\u4E4B\u5DE8\u4EBA\uFF01\\c\\n\u2026\u2026\u54C7\u54C8\u54C8\uFF01\\n\u5F00\u73A9\u7B11\u5462\uFF0C\u4F60\u522B\u4ECB\u610F\u554A\uFF01\\c\\n\u6211\u5BF9\u4F60\u90A3\u7C97\u58EE\u7684\u624B\u81C2\uFF0C\\n\u53EF\u662F\u975E\uFF5E\u5E38\u8D5E\u8D4F\u7684\u54E6\uFF01\\c\\n\u4EE5\u540E\u4F60\u4E5F\u8981\\n\u786C\u90A6\u90A6\u5730\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u4F60\u51FA\u6765\u5566\uFF01\\n\u5C0F\u5C0F\u7684\u94A2\u4E4B\u5DE8\u4EBA\uFF01\\c\\n\u2026\u2026\u54C7\u54C8\u54C8\uFF01\\n\u5F00\u73A9\u7B11\u5462\uFF0C\u4F60\u522B\u4ECB\u610F\u554A\uFF01\\c\\n\u6211\u5BF9\u4F60\u90A3\u4FDD\u9F84\u7403\u4F3C\u7684\u4F53\u578B\uFF0C\\n\u53EF\u662F\u975E\uFF5E\u5E38\u7740\u8FF7\u7684\u54E6\uFF01\\c\\n\u4EE5\u540E\u4F60\u4E5F\u8981\\n\u5149\u6E9C\u6E9C\u5730\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u4F60\u8BF4\u5B83\u662F\u80FD\u64CD\u7EB5\u65F6\u95F4\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5E1D\u7259\u5362\u5361\uFF1F\\c\\n\u5B83\u8981\u662F\u771F\u6709\u90A3\u79CD\u80FD\u529B\u7684\u8BDD\uFF0C\\n\u90A3\u6211\u60F9\u5973\u513F\u751F\u6C14\u65F6\uFF0C\\r\\n\u80FD\u4E0D\u80FD\u8BA9\u5B83\u628A\u65F6\u95F4\u5012\u8F6C\u56DE\u53BB\u554A\uFF1F\\c\\n\u8BDD\u8BF4\u56DE\u6765\uFF0C\u8FD9\u5BB6\u4F19\u7684\u53EB\u58F0\\n\u53EF\u771F\u6709\u4E2A\u6027\uFF0C\u9177\u6BD9\u4E86\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u4F60\u8BF4\u5B83\u662F\u80FD\u64CD\u7EB5\u7A7A\u95F4\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5E15\u8DEF\u5947\u4E9A\uFF1F\\c\\n\u5B83\u8981\u662F\u771F\u6709\u90A3\u79CD\u80FD\u529B\u7684\u8BDD\uFF0C\\n\u90A3\u6211\u5973\u513F\u5C31\u7B97\u662F\u8DD1\u6389\u4E86\uFF0C\\r\\n\u6211\u4E5F\u80FD\u5728\u4E00\u77AC\u95F4\u8FFD\u4E0A\u5979\uFF0C\u65B9\u4FBF\u554A\uFF01\\c\\n\u8BDD\u8BF4\u56DE\u6765\uFF0C\u8FD9\u5BB6\u4F19\u7684\u53EB\u58F0\\n\u53EF\u771F\u6709\u4E2A\u6027\uFF0C\u9177\u6BD9\u4E86\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6816\u606F\u5728\u8FD9\u4E2A\u4E16\u754C\u80CC\u9762\u7684\u4E16\u754C\u7684\\n\u5B9D\u53EF\u68A6\uFF0C\u9A91\u62C9\u5E1D\u7EB3\uFF1F\\c\\n\u6240\u8C13\u7684\u80CC\u9762\u8BF4\u7684\u5C31\u662F\\n\u8FD9\u4E2A\u661F\u7403\u7684\u53E6\u4E00\u4FA7\u5427\uFF01\uFF1F\\c\\n\u4F60\u662F\u4ECE\u90A3\u4E48\u8FDC\u7684\u5730\u65B9\u6765\u7684\u554A\uFF01\\n\u8FD9\u4E00\u8DEF\u53EF\u8F9B\u82E6\u4F60\u5566\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u4F60\u770B\u4E0A\u53BB\u80FD\u54BB\uFF5E\u5730\u98DE\u6765\u98DE\u53BB\uFF0C\\n\u8BF4\u4E0D\u5B9A\u6765\u8FD9\u4E00\u8D9F\u662F\u5C0F\u83DC\u4E00\u789F\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u638C\u7BA1\u667A\u6167\u7684\u5B9D\u53EF\u68A6\uFF0C\u7531\u514B\u5E0C\uFF1F\\c\\n\u5F88\u597D\uFF01\u6211\u8FD9\u4EBA\u554A\uFF5E\\n\u5C31\u662F\u6709\u4E9B\u5730\u65B9\u5C11\u6839\u7B4B\uFF0C\\r\\n\u4E0D\u5982\u8BA9\u6211\u6765\u6CBE\u6CBE\u5149\u5427\uFF01\\c\\n\u7531\u514B\u5E0C\u554A\uFF0C\u7531\u514B\u5E0C\uFF0C\\n\u8BF7\u591A\u591A\u7167\u987E\u6211\u5427\uFF01\\c\\n\u54E6\uFF01\u6211\u7A81\u7136\u611F\u89C9\u597D\uFF5E\u50CF\\n\u53D8\u6210\u4E86\u77E5\uFF5E\u8BC6\u5206\u5B50\uFF01\u54C7\u54C8\u54C8\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u4E3A\u4EBA\u7C7B\u5E26\u6765\u611F\u60C5\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u827E\u59C6\u5229\u591A\uFF1F\\c\\n\u6211\u8FD9\u4E2A\u4EBA\u554A\uFF5E\\n\u6709\u65F6\u4F1A\u70ED\u60C5\u5F97\u6709\u70B9\u8FC7\u5934\u3002\\c\\n\u662F\u4E0D\u662F\u90FD\u662F\u56E0\u4E3A\u5B83\\n\u7ED9\u4E86\u6211\u592A\u591A\u611F\u60C5\u554A\uFF01\uFF1F\\r\\n\u2026\u2026\u5F00\u73A9\u7B11\u7684\u5566\uFF01\\c\\n\u54CE\uFF01\u6211\u6BD4\u4E00\u822C\u4EBA\u591A\u4E86\\n\u4E0D\u5C11\u9AD8\u5174\u548C\u4F24\u5FC3\u7684\u4E8B\u2026\u2026\\r\\n\u8FD9\u6837\u7684\u4EBA\u751F\u4E5F\u7B97\u8D5A\u5230\u4E86\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u80FD\u5E26\u6765\u575A\u5F3A\u610F\u5FD7\u5BF9\u6297\u56F0\u96BE\u7684\\n\u5B9D\u53EF\u68A6\uFF0C\u4E9A\u514B\u8BFA\u59C6\uFF1F\\c\\n\u90A3\u4E0D\u60F3\u8D77\u5E8A\uFF0C\\n\u6216\u662F\u61D2\u5F97\u626B\u5730\u7684\u65F6\u5019\u2026\u2026\\c\\n\u53EA\u8981\u8FD9\u5BB6\u4F19\u5728\uFF0C\u5C31\u80FD\u7ACB\u523B\\n\u6253\u8D77\u7CBE\u795E\uFF0C\u884C\u52A8\u8D77\u6765\u5417\uFF01\uFF1F\\c\\n\u90A3\u6BCF\u5BB6\u90FD\u9700\u8981\uFF11\u53EA\u4E9A\u514B\u8BFA\u59C6\u554A\uFF01\\n\u6211\u4E5F\u60F3\u53BB\u6349\u4E00\u53EA\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u706B\u5C71\u53E3\u5B9D\u53EF\u68A6\uFF0C\u5E2D\u591A\u84DD\u6069\u2026\u2026\uFF1F\\c\\n\u8FD9\u77EE\u77EE\u80D6\u80D6\u7684\u8EAB\u6750\u2026\u2026\uFF01\\n\u8FD9\u526F\u53DB\u9006\u7684\u8868\u60C5\u2026\u2026\uFF01\\c\\n\u7B80\u76F4\u662F\u53EF\u7231\u5230\\n\u6CA1\u6709\u5929\u7406\u5566\uFF01\uFF01\\c\\n\u4F60\u5230\u5E95\u662F\u5728\u54EA\u91CC\u6349\u5230\u7684\uFF1F\\n\u4E0D\u7BA1\u5B83\u662F\u4E0D\u662F\u4F20\u8BF4\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u6211\u90FD\u60F3\u628A\u5B83\u52A0\u5230\u6211\u7684\u540C\u884C\u961F\u4F0D\u91CC\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u54C7\u54E6\uFF01\uFF1F\u90A3\u5BB6\u4F19\u8BE5\u4E0D\u4F1A\u5C31\u662F\\n\u5DE8\u4EBA\u4F20\u8BF4\u7684\u8001\u5927\u5427\uFF1F\\c\\n\u5B83\u9AD8\u6210\u8FD9\u6837\uFF0C\u4E0D\u7BA1\u8C01\u770B\uFF0C\\n\u90A3\u5DE8\u4EBA\u7684\u611F\u89C9\u90FD\u5F88\u5F3A\u70C8\u554A\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u4ED6\u8EAB\u4E0A\u8FD9\u4E48\u591A\u70B9\u70B9\uFF0C\\n\u6211\u90FD\u641E\u4E0D\u6E05\u54EA\u4E2A\u624D\u662F\u773C\u775B\u4E86\u3002\\c\\n\u548C\u8FD9\u5BB6\u4F19\u8BF4\u8BDD\u7684\u65F6\u5019\uFF0C\\n\u8BE5\u770B\u7740\u54EA\u91CC\u8BF4\u624D\u597D\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u65B0\u6708\u7684\u5316\u8EAB\uFF0C\u514B\u96F7\u8272\u5229\u4E9A\uFF01\\n\u771F\u662F\u53EA\u6F02\u4EAE\u7684\u5B9D\u53EF\u68A6\u554A\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u90A3\u5BB6\u4F19\u80CC\u4E0A\u7684\u5708\u5708\uFF0C\\n\u770B\u8D77\u6765\u633A\u786C\u7684\u554A\u3002\\c\\n\u5B83\u8FD9\u6837\u80FD\u597D\u597D\u8EBA\u4E0B\u6765\u7761\u89C9\u5417\uFF1F\\n\u60F3\u7FFB\u8EAB\u7684\u65F6\u5019\u7FFB\u5F97\u4E86\u8EAB\u5417\uFF1F\\r\\n\u55EF\u2026\u2026\u6211\u5F00\u59CB\u4E3A\u5B83\u62C5\u5FC3\u4E86\u554A\u3002[VAR 0114(0076)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u54C7\uFF01\uFF1F\u90A3\u53EA\u5B9D\u53EF\u68A6\uFF0C\\n\u5C3E\u5DF4\u662F\u4E0D\u662F\u70E7\u8D77\u6765\u5566\uFF01\uFF1F\\c\\n\u4EC0\u4E48\uFF1F\u4F60\u8BF4\u5B83\u662F\u80FD\u7528\u706B\u7130\\n\u628A\u5168\u4E16\u754C\u71C3\u70E7\u6B86\u5C3D\u7684\u5B9D\u53EF\u68A6\uFF1F\\c\\n\u4F60\u5E26\u7740\u90A3\u4E48\u5371\u9669\u7684\u5BB6\u4F19\uFF0C\\n\u8FD8\u4E00\u8138\u82E5\u65E0\u5176\u4E8B\u7684\u6837\u5B50\uFF0C\\r\\n\u8FD9\u80C6\u5B50\u4E5F\u592A\u5927\u4E86\u5427\uFF01\u961F\u957F\uFF01\\c\\n\u5F53\u5FC3\u522B\u88AB\u5B83\u707C\u4F24\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u54C7\uFF01\uFF1F\u90A3\u53EA\u5B9D\u53EF\u68A6\uFF0C\\n\u5728\u567C\u91CC\u556A\u5566\u5730\u731B\u653E\u7535\u554A\uFF01\\c\\n\u4EC0\u4E48\uFF1F\u4F60\u8BF4\u5B83\u662F\u80FD\u7528\u95EA\u7535\\n\u628A\u5168\u4E16\u754C\u5316\u4E3A\u4E4C\u6709\u7684\u5B9D\u53EF\u68A6\uFF1F\\c\\n\u4F60\u5E26\u7740\u90A3\u4E48\u5371\u9669\u7684\u5BB6\u4F19\uFF0C\\n\u8FD8\u4E00\u8138\u82E5\u65E0\u5176\u4E8B\u7684\u6837\u5B50\uFF0C\\r\\n\u8FD9\u80C6\u5B50\u4E5F\u592A\u5927\u4E86\u5427\uFF01\u961F\u957F\uFF01\\c\\n\u5F53\u5FC3\u522B\u88AB\u5B83\u7535\u7740\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u547C\uFF5E\u51BB\u6B7B\u6211\u5566\uFF01\\n\u6211\u8FD8\u7EB3\u95F7\u600E\u4E48\u8FD9\u4E48\u51B7\uFF0C\\r\\n\u539F\u6765\u662F\u90A3\u53EA\u53EB\u914B\u96F7\u59C6\u7684\u5BB6\u4F19\u5728\u641E\u9B3C\u554A\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u7ADF\u7136\u4F1A\u88AB\u81EA\u5DF1\u7684\u51B7\u6C14\u7ED9\u51BB\u4F4F\uFF0C\\n\u771F\u662F\u4E2A\u6DD8\u6C14\u9B3C\u554A\uFF01\\c\\n\u4F60\u90A3\u8EAB\u4F53\u53EF\u771F\u591F\u5947\u7279\u7684\u3002\\n\u50CF\u62FC\u4E0A\u53BB\u7684\uFF0C\u8FD8\u968F\u65F6\u90FD\u8981\u6563\u67B6\u7684\u611F\u89C9\u2026\u2026\\c\\n\u54CE\u5440\uFF0C\u6211\u600E\u4E48\u8BF4\u8FD9\u79CD\u8BDD\u3002\\n\u62B1\u6B49\u5566\uFF0C\u914B\u96F7\u59C6\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "[~ 47]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "[~ 48]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "[~ 49]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\uFF0C\u7B49\u4E00\u4E0B\uFF0C\\n\u90A3\u5BB6\u4F19\u4E5F\u662F\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u5417\uFF01\uFF1F\\c\\n\u600E\u4E48\u548C\u6211\u90BB\u5C45\u7684\u8138\u662F\\n\u4E00\u4E2A\u6A21\u5B50\u523B\u51FA\u6765\u7684\uFF01\uFF1F\\c\\n\u65CB\u98CE\u5B9D\u53EF\u68A6\uFF0C\\n\u9F99\u5377\u4E91\u554A\u2026\u2026\\c\\n\u4E0D\u8FC7\uFF0C\u5B83\u5F15\u8D77\u7684\u66B4\u98CE\u96E8\\n\u5A01\u529B\u8DB3\u4EE5\u5C06\u6574\u680B\u623F\u5C4B\u5439\u8D70\uFF0C\\r\\n\u8FD9\u70B9\u5012\u662F\u548C\u6211\u90BB\u5C45\u4E0D\u4E00\u6837\u554A\u3002[VAR 0114(0076)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\uFF0C\u7B49\u4E00\u4E0B\uFF0C\\n\u90A3\u5BB6\u4F19\u4E5F\u662F\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u5417\uFF01\uFF1F\\c\\n\u600E\u4E48\u548C\u6211\u90BB\u5C45\u7684\u8138\u662F\\n\u4E00\u4E2A\u6A21\u5B50\u523B\u51FA\u6765\u7684\uFF01\uFF1F\\c\\n\u96F7\u51FB\u5B9D\u53EF\u68A6\uFF0C\\n\u96F7\u7535\u4E91\u554A\u2026\u2026\\c\\n\u4E0D\u8FC7\uFF0C\u5B83\u4F1A\u5728\u7A7A\u4E2D\\n\u98DE\u6765\u98DE\u53BB\uFF0C\u5F15\u8D77\u843D\u96F7\uFF0C\\r\\n\u8FD9\u70B9\u5012\u662F\u548C\u6211\u90BB\u5C45\u4E0D\u4E00\u6837\u554A\u3002[VAR 0114(0076)]"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\uFF0C\u7B49\u4E00\u4E0B\uFF0C\\n\u90A3\u5BB6\u4F19\u4E5F\u662F\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u5417\uFF01\uFF1F\\c\\n\u600E\u4E48\u548C\u6211\u90BB\u5C45\u7684\u8138\u662F\\n\u4E00\u4E2A\u6A21\u5B50\u523B\u51FA\u6765\u7684\uFF01\uFF1F\\c\\n\u4E30\u9976\u5B9D\u53EF\u68A6\uFF0C\u571F\u5730\u4E91\uFF01\\n\u8FD9\u4E0D\u662F\u548C\u4E30\u9976\u4E4B\u738B\u649E\u540D\u4E86\u5417\uFF1F\\c\\n\u4F20\u8BF4\u5B83\u4F1A\u53BB\u60E9\u7F5A\\n\u4E3A\u975E\u4F5C\u6B79\u7684\u5BB6\u4F19\uFF0C\\r\\n\u8FD9\u70B9\u4E5F\u548C\u6211\u90BB\u5C45\u4E00\u6837\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u4F1A\u5206\u4EAB\u6C38\u6052\u751F\u547D\u7684\\n\u751F\u547D\u5B9D\u53EF\u68A6\uFF0C\u54F2\u5C14\u5C3C\u4E9A\u65AF\uFF01\uFF1F\\c\\n\u8FD9\u8981\u662F\u771F\u7684\uFF0C\u53EF\u5C31\u4E0D\u5F97\u4E86\u5566\u3002\\n\u4E0D\u8FC7\u5B83\u5934\u4E0A\u7684\u89D2\u66F4\u662F\u4E0D\u5F97\u4E86\uFF01\\c\\n\u5B83\u5A01\u98CE\u6210\u8FD9\u4E2A\u6837\u5B50\uFF0C\\n\u7761\u89C9\u65F6\u5E94\u8BE5\u5F88\u96BE\u7FFB\u8EAB\u5427\u2026\u2026\\c\\n\u53CD\u6B63\u5B83\u80FD\u6C38\u8FDC\u6D3B\u4E0B\u53BB\uFF0C\\n\u7761\u4E0D\u597D\u89C9\u4E5F\u6CA1\u5565\u5427\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\u4F1A\u5438\u5149\u751F\u7269\u751F\u547D\u7684\u7834\u574F\u5B9D\u53EF\u68A6\uFF0C\\n\u4F0A\u88F4\u5C14\u5854\u5C14\uFF01\uFF1F\\c\\n\u4F60\u770B\u4E0A\u53BB\u633A\u6ED1\u7A3D\uFF0C\u50CF\u4E2A\u201C\u4E2B\u201D\u5B57\uFF0C\\n\u5B9E\u9645\u4E0A\u5374\u4E0D\u662F\u90A3\u4E48\u56DE\u4E8B\u554A\uFF01\\c\\n\u4F60\u597D\u6B79\u4E5F\u60F3\u60F3\uFF0C\u90A3\u4E9B\u88AB\u4F60\\n\u5438\u5149\u751F\u547D\u7684\u5BB6\u4F19\u662F\u4EC0\u4E48\u5FC3\u60C5\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u7531\u5C0F\u5C0F\u7684\u7EC6\u80DE\u805A\u96C6\u800C\u6210\u7684\\n\u5B9D\u53EF\u68A6\uFF0C\u57FA\u683C\u5C14\u5FB7\u2026\u2026\\c\\n\u4E0D\u662F\u6709\u53E5\u6210\u8BED\u53EB\u79EF\u5C11\u6210\u591A\u561B\uFF01\\n\u8BF4\u7684\u5C31\u662F\u8FD9\u5BB6\u4F19\u554A\uFF01\\c\\n\u6211\u867D\u7136\u5C81\u6570\u5927\u4E86\uFF0C\\n\u4F46\u662F\u809A\u5B50\u4E00\u70B9\u90FD\u4E0D\u5927\u3002\\c\\n\u8FD9\u662F\u56E0\u4E3A\\n\u6211\u6BCF\u5929\u90FD\u5728\u953B\u70BC\u8EAB\u4F53\uFF01\\r\\n\u6362\u53E5\u8BDD\u8BF4\uFF0C\u5C31\u662F\u5728\u79EF\u7D2F\u52AA\u529B\uFF01\\c\\n\u57FA\u683C\u5C14\u5FB7\u61C2\u5F97\u8FD9\u4E00\u70B9\uFF0C\\n\u771F\u662F\u4E86\u4E0D\u8D77\u554A\uFF5E\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\u65E5\u8F6E\u5B9D\u53EF\u68A6\uFF0C\u7D22\u5C14\u8FE6\u96F7\u6B27\uFF01\\n\u5F88\u6709\u592A\uFF5E\u9633\u7684\u611F\u89C9\u554A\uFF01\\c\\n\u8981\u662F\u5B83\u771F\u7684\u80FD\u628A\u665A\u4E0A\u7167\u5F97\\n\u50CF\u767D\u5929\u4E00\u6837\u4EAE\uFF0C\u90A3\u5C31\u4E0D\u5F97\u4E86\u5566\uFF01\\c\\n\u8981\u662F\u5230\u4E86\u665A\u4E0A\u8FD8\u4E0D\u60F3\u56DE\u5BB6\uFF0C\\n\u5C31\u662F\u5B83\u597D\u597D\u8868\u73B0\u7684\u65F6\u5019\u4E86\uFF01\\c\\n\u55EF\uFF1F\u800C\u4E14\u5B83\u8FD8\u662F\u5176\u4ED6\u4E16\u754C\u7684\u5B9D\u53EF\u68A6\uFF01\uFF1F\\n\u8FD9\u53EF\u771F\u662F\u592A\u731B\u70C8\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\u6708\u8F6E\u5B9D\u53EF\u68A6\uFF0C\u9732\u5948\u96C5\u62C9\uFF01\\n\u5F88\u6709\u6708\uFF5E\u4EAE\u7684\u611F\u89C9\u554A\uFF01\\c\\n\u8981\u662F\u5B83\u771F\u7684\u80FD\u8BA9\u767D\u5929\\n\u8FC7\u5F97\u50CF\u665A\u4E0A\u4E00\u6837\uFF0C\u90A3\u5C31\u4E0D\u5F97\u4E86\u5566\uFF01\\c\\n\u8981\u662F\u5230\u4E86\u65E9\u4E0A\u8FD8\u5F88\u56F0\u7684\u8BDD\uFF0C\\n\u5C31\u662F\u5B83\u597D\u597D\u8868\u73B0\u7684\u65F6\u5019\u4E86\uFF01\\c\\n\u55EF\uFF1F\u800C\u4E14\u5B83\u8FD8\u662F\u5176\u4ED6\u4E16\u754C\u7684\u5B9D\u53EF\u68A6\uFF01\uFF1F\\n\u8FD9\u53EF\u771F\u662F\u592A\u731B\u70C8\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\u68F1\u955C\u5B9D\u53EF\u68A6\uFF0C\u5948\u514B\u6D1B\u5179\u739B\uFF1F\\n\u600E\u4E48\u770B\u8D77\u6765\u9ED1\u4E4E\u4E4E\u7684\uFF0C\\r\\n\u4E00\u70B9\u68F1\u955C\u7684\u611F\u89C9\u90FD\u6CA1\u6709\u5462\uFF1F\\c\\n\u4EC0\u4E48\uFF01\uFF1F\u5B83\u662F\u4ECE\u5176\u4ED6\u4E16\u754C\\n\u8DD1\u5230\u8FD9\u91CC\u6765\u5BFB\u627E\u5149\u7684\uFF1F\\c\\n\u90A3\u5B83\u5E94\u8BE5\u5F85\u5728\u5916\u9762\uFF0C\\n\u7CBE\u7CBE\u795E\u795E\u5730\u6652\u592A\u9633\u554A\u3002\\c\\n\u8FD9\u6837\u4E00\u6765\uFF0C\u5B83\u5C31\u5E94\u8BE5\u80FD\u53D8\u5F97\\n\u95EA\u95EA\u53D1\u5149\uFF0C\u5065\u5065\u5EB7\u5EB7\u4E86\uFF01\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\u5BC4\u751F\u5B9D\u53EF\u68A6\uFF0C \u865A\u543E\u4F0A\u5FB7\uFF01\\n\u54C7\u54E6\uFF5E\u8FD9\u5BB6\u4F19\u8F6F\u4E4E\u4E4E\u7684\u554A\uFF01\\c\\n\u8981\u662F\u628A\u5B83\u6234\u5728\u5934\u4E0A\u4EE3\u66FF\u6795\u5934\uFF0C\\n\u611F\u89C9\u4F1A\u5F88\uFF5E\u8212\u670D\u554A\uFF01\\c\\n\u53CD\u6B63\u6211\u90A3\u4E2A\u8D85\u68D2\u7684\u6795\u5934\\n\u88AB\u961F\u957F\u62FF\u53BB\u7528\u4E86\u3002\\c\\n\u4E0D\u5982\u5C31\u8BA9\u6211\u6234\u4E0A\u865A\u543E\u4F0A\u5FB7\\n\u4EE3\u66FF\u6795\u5934\u5427\uFF01\u597D\u4E0D\u597D\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\u81A8\u80C0\u5B9D\u53EF\u68A6\uFF0C\u7206\u808C\u868A\uFF01\\n\u54C7\u54C8\u54C8\uFF01\u597D\u5389\u5BB3\u7684\u808C\u8089\u554A\uFF01\\c\\n\u6211\u81EA\u5DF1\u662F\u89C9\u5F97\\n\u5927\u90E8\u5206\u4EBA\u90FD\u6BD4\u4E0D\u8FC7\u6211\u3002\\c\\n\u4E0D\u8FC7\u5BF9\u4F60\u8FD9\u8EAB\u808C\u8089\uFF0C\\n\u6211\u662F\u7518\u62DC\u4E0B\u98CE\u554A\uFF01\\c\\n\u597D\uFF01\u6211\u4EEC\u4E0B\u6B21\u4E00\u8D77\u53BB\u5065\u8EAB\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\u7F8E\u8273\u5B9D\u53EF\u68A6\uFF0C\u8D39\u6D1B\u7F8E\u8782\uFF01\\n\u8FD9\u53EF\u771F\u662F\u4E2A\u6F02\u4EAE\u5230\u7206\u7684\u5B9D\u53EF\u68A6\u554A\u3002\\c\\n\u5E78\u4F1A\u5E78\u4F1A\uFF0C\\n\u6211\u4EEC\u63E1\u4E2A\u624B\u5427\uFF1F\\c\\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\c\\n\u6211\u8BF4\uFF0C\u5B83\u4E00\u76F4\u4E0D\u7406\u6211\uFF0C\\n\u662F\u6211\u505A\u9519\u4E86\u4EC0\u4E48\u5417\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\u706F\u9970\u5B9D\u53EF\u68A6\uFF0C\u7535\u675F\u6728\uFF01\\n\u4F60\u8FD9\u6837\u523A\u523A\u7684\uFF0C\u662F\u60F3\u5E72\u4EC0\u4E48\u554A\uFF01\uFF1F\\c\\n\u90A3\u53CC\u624B\u811A\u770B\u8D77\u6765\u50CF\u662F\u63D2\u5934\uFF0C\\n\u8981\u662F\u63D2\u8FDB\u63D2\u5EA7\u91CC\uFF0C\\r\\n\u662F\u4E0D\u662F\u4F1A\u53D1\u5149\u554A\uFF01\\c\\n\u6211\u8FD8\u771F\u662F\u597D\u5947\uFF0C\\n\u5230\u5E95\u4F1A\u7528\u4EC0\u4E48\u6837\u7684\u65B9\u6CD5\u53D1\u5149\uFF01\\c\\n\u2026\u2026\u4E0D\u8FC7\uFF0C\u6211\u6015\u7535\u8D39\u4F1A\u8D35\u5230\u7206\uFF01\\n\u8FD8\u662F\u7B97\u4E86\u5427\u3002[VAR 0114(0076)]"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\u62D4\u5200\u5B9D\u53EF\u68A6\uFF0C\u7EB8\u5FA1\u5251\uFF1F\\n\u961F\u957F\uFF0C\u4F60\u522B\u62FF\u6211\u627E\u4E50\u554A\u2026\u2026\\c\\n\u8FD9\u600E\u4E48\u770B\u90FD\u662F\\n\u522B\u4EBA\u6298\u7684\u6298\u7EB8\u554A\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u4ED4\u7EC6\u4E00\u770B\uFF0C\u8FD8\u771F\u7CBE\u81F4\uFF0C\\n\u8BA9\u4EBA\u770B\u5F97\u51FA\u795E\u554A\uFF01\\c\\n\u4F60\u53EF\u8981\u5C0F\u5FC3\u522B\u8BA9\u5B83\u88AB\u98CE\u5439\u8D70\uFF0C\\n\u8FD8\u8981\u5C0F\u5FC3\u522B\u7528\u6C34\u53BB\u6D17\u5B83\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\u8FD9\u2026\u2026\u8FD9\u8EAB\u4F53\u53EF\u771F\uFF5E\u5927\uFF01\uFF01\\c\\n\u54CE\u5440\u2026\u2026\u6211\u592A\u60CA\u8BB6\u4E86\uFF0C\\n\u5FCD\u4E0D\u4F4F\u543C\u4E86\u51FA\u6765\u2026\u2026\\c\\n\u53D1\u5C04\u5B9D\u53EF\u68A6\uFF0C\u94C1\u706B\u8F89\u591C\u554A\u3002\\n\u5B83\u80FD\u5728\u7A7A\u4E2D\u9AD8\u901F\u98DE\u884C\uFF0C\\r\\n\u4ECE\u624B\u81C2\u55B7\u51FA\u6C14\u4F53\u8BA9\u5468\u56F4\u8D77\u706B\uFF1F\\c\\n\u9664\u4E86\u4E0D\u5F97\u4E86\u4E4B\u5916\uFF0C\\n\u6211\u6324\u4E0D\u51FA\u522B\u7684\u611F\u60F3\u5566\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u5B83\u8DDF\u961F\u957F\u5F88\u4EB2\u5BC6\u7684\u6837\u5B50\u554A\u3002\\n\u2026\u2026\u4F60\u8FD8\u771F\u662F\u4F1A\u88AB\u602A\u5BB6\u4F19\u559C\u6B22\u4E0A\u554A\u3002[VAR 0114(0076)]"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\u5F02\u98DF\u5B9D\u53EF\u68A6\uFF0C\u6076\u98DF\u5927\u738B\uFF1F\\c\\n\u7684\u786E\u554A\uFF0C\\n\u8FD9\u5BB6\u4F19\u73B0\u5728\u4E5F\u6B63\\r\\n\u4E13\u5FC3\u5730\u5403\u8FD9\u9644\u8FD1\u7684\u5783\u573E\u5462\u3002\\c\\n\u54E6\u54E6\uFF01\u4E0D\u6311\u98DF\u662F\u4EF6\u597D\u4E8B\u554A\uFF01\\n\u8D2A\u5403\u9B3C\uFF01\\c\\n\u8981\u662F\u6211\u6709\u4EC0\u4E48\u4E0D\u597D\u6254\u6389\u7684\u5783\u573E\uFF0C\\n\u5C31\u628A\u8FD9\u5BB6\u4F19\u501F\u7ED9\u6211\u5427\uFF01\u961F\u957F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\u6765\u81EA\u5F02\u4E16\u754C\u7684\u6BD2\u9488\u5B9D\u53EF\u68A6\uFF0C\\n\u6BD2\u8D1D\u6BD4\uFF1F\\c\\n\u8FD9\u957F\u76F8\u786E\u5B9E\u4E0D\u5E38\u89C1\uFF0C\\n\u4E0D\u8FC7\uFF0C\u8981\u662F\u52AA\u628A\u529B\u7684\u8BDD\uFF0C\\r\\n\u597D\u50CF\u5728\u8DEF\u8FB9\u7684\u8349\u4E1B\u4E5F\u80FD\u627E\u5230\u2026\u2026\\c\\n\u54CE\u54DF\u5582\uFF01\uFF1F\u6709\u6DB2\u4F53\u4ECE\u5B83\\n\u5934\u4E0A\u7684\u9488\u55B7\u4E86\u8FC7\u6765\uFF01\uFF1F\\r\\n\u5F02\u4E16\u754C\u53EF\u771F\u662F\u4E0D\u5F97\u4E86\u554A\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\u6765\u81EA\u5F02\u4E16\u754C\u7684\u6BD2\u9488\u5B9D\u53EF\u68A6\uFF0C\\n\u56DB\u989A\u9488\u9F99\uFF1F\\c\\n\u90A3\u6839\u9488\u53C8\u5927\u53C8\u5C16\uFF0C\\n\u770B\u8D77\u6765\u5389\u5BB3\u7206\u4E86\u554A\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u5B83\u5C41\u80A1\u4E0A\\n\u7ADF\u7136\u4E5F\u957F\u4E86\uFF13\u6839\u9488\u2026\u2026\\r\\n\u8FD9\u8981\u7528\u4EC0\u4E48\u59FF\u52BF\u7761\u89C9\u554A\uFF1F\\c\\n\u56DB\u989A\u9488\u9F99\u7761\u5F97\u597D\u89C9\u5417\uFF1F\\n\u4F60\u8BF4\u5462\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\u795E\u79D8\u7684\u751F\u547D\u4F53\u2026\u2026\\n\u77F3\u5899\u5B9D\u53EF\u68A6\uFF0C\u5792\u78CA\u77F3\uFF01\\c\\n\u5B83\u662F\u7531\u5F88\u591A\u5C0F\u5757\u7684\u5BB6\u4F19\\n\u805A\u5728\u4E00\u8D77\u7EC4\u6210\u7684\uFF11\u53EA\u5B9D\u53EF\u68A6\u554A\u3002\\c\\n\u90A3\u5C0F\u5757\u7684\u5BB6\u4F19\uFF0C\\n\u770B\u8D77\u6765\u5F88\u9002\u5408\u5F53\u6211\u7684\u6795\u5934\uFF0C\\r\\n\u80FD\u4E0D\u80FD\u7ED9\u6211\uFF11\u5757\u554A\u2026\u2026\uFF1F\\c\\n\u2026\u2026\u55EF\uFF01\u679C\u7136\u4E0D\u884C\u554A\uFF01\\n\u6BD5\u7ADF\u8EAB\u4F53\u5C11\u4E86\u4E00\u5757\uFF0C\u4F1A\u96BE\u8FC7\u7684\u554A\uFF01\\c\\n\u8BDD\u8BF4\uFF0C\u90A3\u5C0F\u5757\u7684\u5BB6\u4F19\u8981\u5C11\u51E0\u5757\uFF0C\\n\u5792\u78CA\u77F3\u5C31\u4E0D\u662F\u5792\u78CA\u77F3\u4E86\u5462\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\u795E\u79D8\u7684\u751F\u547D\u4F53\u2026\u2026\\n\u70DF\u706B\u5B9D\u53EF\u68A6\uFF0C\u7830\u5934\u5C0F\u4E11\uFF01\\c\\n\u6211\u77E5\u9053\u4F60\u559C\u6B22\u626D\u6765\u626D\u53BB\uFF0C\\n\u662F\u4E2A\u641E\u7B11\u7684\u5BB6\u4F19\uFF01\\c\\n\u4F46\u4F60\u81EA\u66B4\u81EA\u5F03\u5230\u8BA9\u5934\u7206\u70B8\uFF0C\\n\u8FD9\u53EF\u5C31\u4E0D\u884C\u5566\uFF01\\c\\n\u60F3\u8981\u5413\u552C\u4EBA\u5012\u662F\u53EF\u4EE5\uFF0C\\n\u4E0D\u8FC7\u4F60\u53EF\u8981\u591A\u73CD\u60DC\u4E00\u70B9\\r\\n\u81EA\u5DF1\u7684\u8111\u888B\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 70,
    "flags": 0,
