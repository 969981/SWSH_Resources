    "text": "[~ 25]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8FD9\u57CE\u5E02\u53EF\u771F\u5927\u554A\uFF01\\c\\n\u5982\u679C\u4E0D\u4ED4\u7EC6\u67E5\u770B\u57CE\u9547\u5730\u56FE\uFF0C\\n\u6211\u80AF\u5B9A\u4F1A\u8FF7\u8DEF\u7684\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u5728\u4F3D\u52D2\u5C14\uFF0C\u51A0\u519B\u662F\\n\u82F1\u96C4\u822C\u7684\u5B58\u5728\u3002\\r\\n\u6240\u6709\u4EBA\u90FD\u5173\u6CE8\u7740\u4ED6\u7684\u4E00\u4E3E\u4E00\u52A8\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6295\u51FA\u7CBE\u7075\u7403\uFF01\\c\\n\u591A\u6295\u591A\u7EC3\uFF0C\\n\u7EC3\u597D\u6B63\u786E\u7684\u59FF\u52BF\uFF01"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u4E39\u5E1D\u5148\u751F\u6295\u7403\u8FC5\u731B\u65E0\u6BD4\uFF0C\\n\u91CC\u9762\u7684\u5B9D\u53EF\u68A6\u90FD\u5FEB\u8981\u5934\u6655\u76EE\u7729\u4E86\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u557E\u557E\uFF5E"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "[~ 31]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u6709\u8BA9\u751C\u821E\u59AE\u653E\u677E\u5FC3\u60C5\u7684\u7A7A\u95F4\u771F\u662F\u592A\u597D\u4E86\u3002\\c\\n\u8FDE\u6211\u81EA\u5DF1\u90FD\u5FCD\u4E0D\u4F4F\u60F3\u6DA6\u6DA6\u5589\u5499\u4E86\u3002"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u56E0\u4E3A\u6211\u7528\u4E86\u5B9D\u53EF\u68A6\u7684\u201C\u751F\u957F\u201D\u62DB\u5F0F\u517B\u82B1\uFF0C\\n\u6240\u4EE5\u82B1\u6735\u90FD\u5F88\u5927\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u65E0\u8BBA\u662F\u4E0D\u662F\u7279\u522B\u7684\u65E5\u5B50\uFF0C\\n\u6211\u90FD\u4F1A\u6BCF\u5929\u4E70\u82B1\u5E26\u56DE\u5BB6\u3002\\c\\n\u56E0\u4E3A\u6211\u5BB6\u7684\u5B9D\u53EF\u68A6\u559C\u6B22\u9C9C\u82B1\u7684\u82B3\u9999\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u6211\u6700\u559C\u6B22\u5F00\u82B1\u82B1\u7684\u5B9D\u53EF\u68A6\u4E86\u3002"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u5F53\u5B9D\u53EF\u68A6\u53EF\u771F\u4E0D\u5BB9\u6613\uFF01\\c\\n\u4E3A\u4E86\u8FDB\u5165\u7CBE\u7075\u7403\u91CC\u8981\u628A\u81EA\u5DF1\u53D8\u5C0F\uFF0C\\n\u53C8\u8981\u901A\u8FC7\u6781\u5DE8\u5316\u53D8\u5F97\u65E0\u6BD4\u5DE8\u5927\u3002"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u2026\u2026\u5495\u547C\u5495\u547C\u5495\u547C\uFF01"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u7231\u5E72\u51C0\u7684\u6CE1\u6CAB\u6817\u9F20\\n\u4F1A\u7528\u5C3E\u5DF4\u6E05\u626B\u7070\u5C18\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u56FE\u9274\u6709\u8FDB\u5C55\u5417\uFF1F\\c\\n\u524D\u5F80\u65F7\u91CE\u5730\u5E26\u7684\u8BDD\\n\u5C31\u80FD\u9047\u5230\u5404\u79CD\u5404\u6837\u7684\u5B9D\u53EF\u68A6\u4E86\u3002"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u5728\u5E97\u91CC\u4E70\u4E1C\u897F\u53EF\u4EE5\u63A5\u89E6\u5B9E\u7269\uFF0C\u786E\u5B9E\u8BA9\u4EBA\u653E\u5FC3\u3002\\c\\n\u4E0D\u8FC7\u6211\u4E5F\u540C\u6837\u559C\u6B22\u7531\u5B9D\u53EF\u68A6\\n\u5C06\u5546\u54C1\u9001\u6765\u7684\u7F51\u8D2D\u670D\u52A1\u3002"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u8D2D\u7269\u80FD\u591F\u4F53\u73B0\u4E00\u4E2A\u4EBA\u7684\u6027\u683C\u3002\\c\\n\u6211\u5148\u751F\u5C31\u662F\u4E0D\u7ECF\u8003\u8651\u5C31\u4E71\u4E70\u4E1C\u897F\u7684\u7C7B\u578B\u3002"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u5495\u5495\u4F0A\u54C7\uFF01"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u5927\u5CA9\u86C7\u672C\u6765\u5C31\u5F88\u5DE8\u5927\uFF0C\\n\u6781\u5DE8\u5316\u540E\u4F1A\u53D8\u5F97\u7855\u5927\u65E0\u670B\uFF01"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u6211\u5343\u91CC\u8FE2\u8FE2\u4ECE\u963F\u7F57\u62C9\u8D76\u6765\uFF0C\\n\u5C31\u662F\u4E3A\u4E86\u89C2\u770B\u9053\u9986\u6311\u6218\uFF01"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u5982\u679C\u6211\u4E5F\u6709\u7ADE\u6280\u670D\uFF0C\\n\u6211\u8BE5\u9009\u51E0\u53F7\u5462\uFF1F\u597D\u72B9\u8C6B\u3002"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u5982\u679C\u80FD\u548C\u559C\u6B22\u7684\u9053\u9986\u9986\u4E3B\\n\u7A7F\u4E0A\u76F8\u540C\u7684\u7ADE\u6280\u670D\u8BE5\u591A\u71C3\u554A\u3002"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u6709\u7684\u6B4C\u66F2\u867D\u7136\u518D\u4E5F\u65E0\u7F18\\n\u542C\u5230\u6B4C\u624B\u4EB2\u81EA\u6F14\u7ECE\u2026\u2026\\r\\n\u4F46\u662F\u8FD8\u53EF\u4EE5\u901A\u8FC7\u5531\u7247\u56DE\u5473\u4E00\u756A\u3002"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u6D1B\u5179\u6DF1\u7231\u4F3D\u52D2\u5C14\uFF0C\\n\u5728\u5F00\u5C55\u80FD\u6E90\u4E1A\u52A1\u7684\u540C\u65F6\uFF0C\\r\\n\u8FD8\u5E26\u52A8\u4E86\u9053\u9986\u6311\u6218\u7684\u98CE\u6F6E\u3002"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u80FD\u8BA9\u5DE8\u5927\u7684\u5347\u964D\u673A\u52A8\u8D77\u6765\uFF0C\\n\u84B8\u6C7D\u53EF\u771F\u4E86\u4E0D\u8D77\uFF01"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u50CF\u98DE\u673A\u90A3\u6837\u4F1A\u52A8\u7684\u5927\u94C1\u5757\uFF0C\\n\u6211\u89C9\u5F97\u597D\u53EF\u6015\u54E6\u3002\\r\\n\u4E0D\u8FC7\u5B9D\u53EF\u68A6\u5012\u662F\u53EF\u4EE5\u63A5\u53D7\u3002"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u6211\u4E00\u76F4\u5728\u770B\u7740\u8FD9\u4E2A\u9760\u84B8\u6C7D\u8FD0\u4F5C\u7684\\n\u5DE8\u5927\u9F7F\u8F6E\u4E0D\u505C\u5730\u8F6C\u5440\u8F6C\uFF01"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u6211\u7684\u7535\u97F3\u5A74\\n\u4E5F\u592A\u559C\u6B22\u7F50\u5934\u4E86\u5427\u3002"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u6709\u7684\u5B9D\u53EF\u68A6\u4E89\u5F3A\u597D\u80DC\uFF0C\\n\u6709\u7684\u5219\u4E0D\u7136\u3002\\r\\n\u548C\u5B83\u4EEC\u76F8\u5904\u53EF\u662F\u95E8\u5B66\u95EE\u3002"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\u80FD\u548C\u79C3\u9E70\u5A1C\u73A9\u867D\u7136\u5F00\u5FC3\uFF0C\\n\u4F46\u6211\u66F4\u60F3\u548C\u5B83\u4E00\u8D77\u98DE\u554A\u3002"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u5657\u9E70\u5A1C\uFF5E\uFF01"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\u5706\u562D\u562D\uFF5E"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\u5706\u874C\u86AA\u554A\uFF0C\\n\u8BE5\u56DE\u5BB6\u5566\u3002"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\u4E92\u76F8\u5E2E\u52A9\u662F\u4F3D\u52D2\u5C14\u7684\u5E38\u8BC6\uFF0C\\n\u6253\u626B\u536B\u751F\u4E5F\u662F\u5927\u5BB6\u81EA\u53D1\u53BB\u505A\u7684\u3002"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\u54EA\u6015\u53EA\u662F\u6F2B\u65E0\u76EE\u7684\u7684\u95F2\u8C08\uFF0C\\n\u53EA\u8981\u80FD\u542C\u5230\u559C\u6B22\u7684\u4EBA\u7684\u58F0\u97F3\uFF0C\\r\\n\u5C31\u5DF2\u7ECF\u662F\u81F3\u9AD8\u7684\u5E78\u798F\u4E86\uFF01"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\u4EBA\u53EA\u8981\u60F3\u6539\u53D8\uFF0C\\n\u5C31\u968F\u65F6\u90FD\u80FD\u6539\u53D8\u2026\u2026\\r\\n\u8001\u5934\u5B50\u8BF4\u4E0D\u5B9A\u4E5F\u4F1A\u6709\u65B0\u9762\u8C8C\u3002"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u8981\u60F3\u4F7F\u51FA\u62DB\u5F0F\uFF0C\\n\u9700\u8981\u6D88\u8017\uFF30\uFF30\u3002"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\u5982\u679C\u5728\u5E02\u533A\u4E2D\u5BF9\u6218\uFF0C\\n\u53EF\u8981\u6CE8\u610F\u522B\u5F71\u54CD\u5230\u5468\u56F4\u7684\u4EBA\u3002"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\u6211\u4F1A\u8DDF\u5C0F\u679C\u7136\u548C\u59B9\u59B9\\n\u4E00\u8D77\u73A9\u8DF3\u623F\u5B50\u3002\\r\\n\u77E5\u9053\u8DF3\u623F\u5B50\u5417\uFF1F\u5C31\u662F\u7528\u5355\u817F\u8DF3\u7740\u73A9\u7684\u90A3\u4E2A\u3002"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\u8FD9\u91CC\u662F\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u73A9\u7684\u5730\u65B9\uFF01"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\u679C\u3001\u679C\u679C\u3002"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\u5982\u679C\u6362\u4E86\u65B0\u53D1\u578B\uFF0C\\n\u53BB\u627E\u5B9D\u53EF\u68A6\u4E2D\u5FC3\u7684\u6D1B\u6258\u7C73\uFF0C\\r\\n\u5C31\u80FD\u66F4\u65B0\u8054\u76DF\u5361\u4E0A\u7684\u7167\u7247\u5566\uFF01"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\u4ECE\u65E9\u5230\u665A\uFF0C\u70ED\u70C8\u5730\u2026\u2026\\c\\n\u4E3A\u559C\u6B22\u7684\u9053\u9986\u9986\u4E3B\u52A0\u6CB9\u52A9\u5A01\u2026\u2026\\n\u559C\u6B22\u7684\u4E8B\u505A\u8D77\u6765\u771F\u7684\u662F\u4E0D\u4F1A\u75B2\u5026\uFF01"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\u5F3A\u5927\u7684\u529B\u91CF\u56FA\u7136\u662F\u5B9D\u53EF\u68A6\u7684\u9B45\u529B\uFF0C\\n\u4F46\u53EF\u7231\u4E0D\u4E5F\u662F\u5417\uFF1F"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u53EF\u662F\u79CD\u65C5\u7A0B\u554A\u3002\\c\\n\u548C\u5B9D\u53EF\u68A6\u5954\u6CE2\u4E8E\u5404\u5BB6\u9053\u9986\uFF0C\\n\u8E0F\u4E0A\u6F2B\u6F2B\u6311\u6218\u4E4B\u8DEF\u2026\u2026\\c\\n\u8BB0\u4F4F\uFF0C\u5343\u91CC\u4E4B\u884C\uFF0C\u59CB\u4E8E\u8DB3\u4E0B\u3002"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\u8001\u4EBA\u5BB6\u603B\u4F1A\u501A\u8001\u5356\u8001\uFF0C\\n\u5E74\u8F7B\u4EBA\u4E0D\u8981\u5728\u610F\u90A3\u4E48\u591A\uFF0C\\r\\n\u81EA\u7531\u505A\u81EA\u5DF1\u7231\u505A\u7684\u4E8B\u5427\u3002"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\u5657\u55DF\uFF5E\uFF01\uFF01"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\u6211\u4EEC\u7684\u79D8\u5BC6\u57FA\u5730\u600E\u4E48\u6837\uFF1F\\n\u771F\u60F3\u5EFA\u4E00\u5EA7\u65B0\u7684\u9053\u9986\u554A\u3002"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\u4EE5\u6211\u4EEC\u7684\u80FD\u529B\uFF0C\u53EA\u8981\uFF12\u5E74\u5DE6\u53F3\uFF0C\\n\u5C31\u80FD\u6253\u9020\u51FA\u4F3D\u52D2\u5C14\u6700\u68D2\u7684\u9053\u9986\uFF01"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\u4E0D\u540C\u4E8E\u9053\u9986\u6311\u6218\uFF0C\\n\u8FD9\u662F\u51B3\u5B9A\u9053\u9986\u9986\u4E3B\u4E4B\u95F4\\r\\n\u5B9E\u529B\u6392\u5E8F\u7684\u5BF9\u6218\u3002"
  },
  {
