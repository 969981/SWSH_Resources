[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5927\u54E5\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u521A\u624D\u53D1\u751F\u4E86\u4EC0\u4E48\u2026\u2026\\n\u90A3\u662F\u62F3\u5173\u5E02\u7684\u7ADE\u6280\u573A\u5427\uFF1F\\r\\n\u6D1B\u5179\u4F1A\u957F\u5230\u5E95\u505A\u4E86\u4EC0\u4E48\u554A\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u5B8C\u5168\u4E0D\u61C2\uFF01\\c\\n\u4ED6\u6628\u5929\u8DDF\u6211\u8BF4\\n\u8981\u89E3\u51B3\uFF11\uFF10\uFF10\uFF10\u5E74\u540E\u7684\u95EE\u9898\u2026\u2026\\r\\n\u96BE\u9053\u4ED6\u771F\u7684\u4E3A\u6B64\u884C\u52A8\u4E86\uFF01\uFF1F\\c\\n\u603B\u4E4B\uFF0C\u6211\u2026\u2026\\n\u6211\u662F\u51A0\u519B\uFF0C\u5FC5\u987B\u5F97\u53BB\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8D23\u4EFB\u5728\u6211\u8EAB\u4E0A\uFF0C\\n\u90FD\u602A\u6211\u6CA1\u80FD\u6478\u900F\u8054\u76DF\u4F1A\u957F\u7684\u610F\u56FE\u2026\u2026\\r\\n\u6240\u4EE5\u6211\u6709\u4E49\u52A1\u627F\u62C5\u8D23\u4EFB\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD9\u4EF6\u4E8B\u5C31\u4EA4\u7ED9\u6211\u5427\u3002\\n\u4ECE\u73B0\u5728\u8D77\uFF0C\u5C31\u662F\u51A0\u519B\u65F6\u523B\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5927\u54E5\u662F\u4E2A\u8DEF\u75F4\uFF0C\\n\u4ED6\u8BA4\u5F97\u53BB\u62F3\u5173\u5E02\u7684\u8DEF\u5417\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u60F3\u8981\u52A9\u5927\u54E5\u4E00\u81C2\u4E4B\u529B\uFF01\\c\\n\u4F46\u6211\u662F[VAR 0100(0000)]\u4F60\u7684\u624B\u4E0B\u8D25\u5C06\uFF0C\\n\u8FD9\u6837\u7684\u6211\uFF0C\u771F\u7684\u80FD\u5E2E\u5F97\u4E0A\u5FD9\u5417\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u80FD\u554A\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u52A0\u6CB9\u5E72\u5427\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8BF4\u7684\u5012\u662F\u7B80\u5355\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u80FD\u5E2E\u4E0A\u4EC0\u4E48\u5FD9\u554A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\u8BF4\u7684\u95C7\u591C\uFF0C\\n\u5C31\u662F\u5F88\u4E45\u4EE5\u524D\u53D1\u751F\u8FC7\u7684\\r\\n\u5929\u7A7A\u53D8\u6697\u7684\u73B0\u8C61\u5427\uFF1F\\c\\n\u91CD\u73B0\u662F\u4EC0\u4E48\u610F\u601D\uFF1F\\n\u8BDD\u8BF4\uFF0C\u8FD9\u4E8B\u6211\u4EEC\u662F\u5728\u54EA\u91CC\u542C\u5230\u7684\u6765\u7740\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u673A\u64CE\u5E02"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u82F1\u96C4\u96D5\u50CF"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u673A\u64CE\u5E02\u7684\u82F1\u96C4\u96D5\u50CF\uFF01\\n\u7D22\u59AE\u4E9A\u8BF4\u8FC7\u90A3\u6837\u7684\u8BDD\u6765\u7740\uFF1F\\c\\n\u6211\u8BB0\u5F97\u662F\u2026\u2026\u82F1\u96C4\u6709\u4E24\u4E2A\u4EBA\uFF0C\\n\u4ED6\u4EEC\u548C\u88AB\u79F0\u4E3A\u5251\u548C\u76FE\u7684\u5B9D\u53EF\u68A6\\r\\n\u4E00\u8D77\u5E73\u606F\u4E86\u95C7\u591C\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u4EEC\u53BB\u627E\u90A3\u4E24\u53EA\\n\u5E94\u8BE5\u6B63\u5728\u6C89\u7761\u7684\u5B9D\u53EF\u68A6\u5427\uFF01\\r\\n[VAR 0100(0000)]\uFF0C\u6211\u4EEC\u8BE5\u53BB\u54EA\u91CC\u624D\u597D\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5FAE\u5BD0\u68EE\u6797"
  },
  {
    "index": 17,
