    "text": "\u54A6\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u557E\u54C7\u54C7\u54C7\uFF5E[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5B69\u5B50\u554A\uFF0C\\n\u5173\u4E8E\u5B64\u7684\u7231\u9A6C\uFF0C\\r\\n\u6C5D\u5F97\u5230\u6D88\u606F\u4E86\u5417\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u662F\u5417\u2026\u2026\\n\u5018\u82E5\u5F97\u5230\u4E86\u6D88\u606F\uFF0C\\r\\n\u5E0C\u671B\u6C5D\u80FD\u544A\u77E5\u5B64\u3002[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6C5D\u5DF2\u5F97\u77E5\u5B64\u7684\u7231\u9A6C\\n\u559C\u7231\u4F55\u7269\u4E86\u554A\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4E0E\u7231\u9A6C\u76F8\u5904\u7684\u65F6\u4EE3\u8DDD\u4ECA\u8FC7\u4E8E\u9065\u8FDC\uFF0C\\n\u5B64\u5DF2\u4E0D\u8BB0\u5F97\u5B83\u559C\u7231\u4E4B\u7269\u4E3A\u4F55\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u82E5\u6709\u5B83\u559C\u7231\u4E4B\u7269\uFF0C\\n\u6216\u8BB8\u5C31\u80FD\u8BF1\u5176\u73B0\u8EAB\u4E86\uFF01\\r\\n\u5B83\u7A76\u7ADF\u559C\u7231\u4F55\u7269\u5462\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u7275\u7ECA\u7F30\u7EF3"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u841D\u535C"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u51BB\u51DD\u6751\u96EA\u4E2D\u821E"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E30\u9976\u4E4B\u738BT\u6064"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u4E0D\u77E5\u9053"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\\n\u662F\u7275\u7ECA\u7F30\u7EF3\u5417\uFF1F\\c\\n\u82E5\u5F97\u6B64\u7269\uFF0C\u786E\u5B9E\u53EF\u8F7B\u6613\u5730\\n\u8BA9\u7231\u9A6C\u4E0E\u5B64\u5F62\u5F71\u4E0D\u79BB\u2026\u2026\\c\\n\u7136\u800C\u4EBA\u7C7B\u65E9\u5DF2\u4E0D\u5411\u5B64\\n\u8FDB\u732E\u7275\u7ECA\u7F30\u7EF3\u3002\\c\\n\u5B64\u53C8\u4F55\u4EE5\u5F97\u4E4B\u554A\u3002[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\\n\u662F\u51BB\u51DD\u96EA\u4E2D\u821E\u5417\uFF1F\\c\\n\u5B64\u66FE\u7ECF\u76EE\u7779\u8FC7\\n\u6751\u6C11\u8DF3\u8D77\u602A\u5F02\u7684\u821E\u8E48\u2026\u2026\\c\\n\u89C1\u6B64\u5149\u666F\uFF0C\u52FF\u8BF4\u5B64\u7684\u7231\u9A6C\uFF0C\\n\u8FDE\u53EA\u85CF\u9971\u6817\u9F20\u90FD\u4F1A\u656C\u800C\u8FDC\u4E4B\u3002[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\\n\u662F\u7ED8\u6709\u5B64\u7684\u8863\u670D\u5417\uFF1F\\c\\n\u867D\u8BF4\u662F\u8D5D\u54C1\uFF0C\\n\u4F46\u5B64\u7684\u6837\u8C8C\u4E00\u65E6\\r\\n\u6620\u5165\u7231\u9A6C\u7684\u773C\u5E18\u2026\u2026\\c\\n\u6050\u6015\u5B83\u4FBF\u4F1A\u9003\u4E4B\u592D\u592D\u554A\u3002[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u54E6\uFF01\u662F\u841D\u535C\u554A\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u7684\u786E\uFF0C\u53EA\u8981\u53D1\u73B0\u67D0\u79CD\u519C\u4F5C\u7269\uFF0C\\n\u5B83\u5C31\u4F1A\u98DE\u5954\u8FC7\u53BB\uFF0C\\r\\n\u5B64\u8981\u8D39\u5C3D\u5468\u6298\u624D\u80FD\u8BA9\u5B83\u8001\u5B9E\u4E0B\u6765\u3002[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5982\u4ECA\u7EC6\u7EC6\u601D\u6765\uFF0C\\n\u539F\u6765\u90A3\u4E1C\u897F\u662F\u841D\u535C\u554A\uFF01\\r\\n\u5B69\u5B50\u554A\uFF01\u6C5D\u679C\u7136\u4E0D\u8D1F\u5B64\u4E4B\u6240\u671B\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u76EE\u4E0B\u53EA\u8981\u627E\u5230\u841D\u535C\uFF0C\\n\u4FBF\u53EF\u5F15\u8BF1\u53BB\u5411\u4E0D\u660E\u7684\\r\\n\u7231\u9A6C\u73B0\u8EAB\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6751\u91CC\u7684\u4EBA\u4EEC\\n\u662F\u5426\u6709\u79CD\u841D\u535C\u5462\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u53EA\u8981\u5C1A\u5B58\u4E00\u7C92\u79CD\u5B50\uFF0C\\n\u5B64\u4FBF\u80FD\u5C06\u5176\u57F9\u80B2\u6210\u719F\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6751\u91CC\u7684\u4EBA\u4EEC\\n\u662F\u5426\u6709\u79CD\u841D\u535C\u5462\uFF1F\\c\\n\u53EA\u8981\u5C1A\u5B58\u4E00\u7C92\u79CD\u5B50\uFF0C\\n\u5B64\u4FBF\u80FD\u5C06\u5176\u57F9\u80B2\u6210\u719F\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u771F\u662F\u4E0D\u51D1\u5DE7\uFF0C\\n\u8FD9\u5EA7\u6751\u5B50\u73B0\u5728\u6CA1\u4EBA\u79CD\u841D\u535C\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "[~ 25]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u4F60\u8981\u841D\u535C\uFF1F\\n\u8981\u571F\u8C46\u7684\u8BDD\uFF0C\u6211\u5BB6\u91CC\u5012\u662F\u6709\u3002\\c\\n\u4F60\u53BB\u95EE\u95EE\u5176\u4ED6\u4EBA\u5427\u3002\\n\u8BF4\u4E0D\u5B9A\u79CD\u5B50\u8FD8\u662F\u6709\u7684\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u738B\u51A0\u96EA\u539F\u66FE\u7ECF\u51FA\u4EA7\u8FC7\\n\u4E24\u79CD\u5F88\u6709\u540D\u7684\u841D\u535C\u3002\\r\\n\u53EF\u662F\u73B0\u5728\u90A3\u4E24\u79CD\u841D\u535C\\r\\n\u90FD\u6CA1\u4EBA\u79CD\u5566\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6D01\uFF5E\u767D\u5440\u561B\u53C8\u7C97\u66B4\uFF0C\\n\u5403\u4E86\u4E2A\u51B0\u51B0\u51B0\u841D\u535C\u266A\\c\\n\u6D01\uFF5E\u767D\u554A[VAR FF00(0006)]\u51B0[VAR FF00(0000)]\u7684\u989C\u8272\uFF0C\\n\u51C9\u51C9\u7684\u852C\u83DC\u54AC\u54AC\u54AC\u266A\\c\\n\u6F06\uFF5E\u9ED1\u5440\u561B\u53C8\u7C97\u66B4\uFF0C\\n\u5403\u4E86\u4E2A\u9ED1\u9ED1\u9ED1\u841D\u535C\u266A\\c\\n\u6F06\uFF5E\u9ED1\u554A[VAR FF00(0006)]\u5E7D\u7075[VAR FF00(0000)]\u989C\u8272\uFF0C\\n\u9ED1\u9ED1\u7684\u852C\u83DC\u56BC\u56BC\u56BC\u266A"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6211\u6700\uFF5E\u559C\u6B22\u542C\\n\u5976\u5976\u5531\u6B4C\u4E86\uFF01"
  },
  {
