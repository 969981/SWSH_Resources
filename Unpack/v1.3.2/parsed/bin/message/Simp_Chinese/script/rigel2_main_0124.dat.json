    "text": "\u51A0\u3001\u51A0\u514B\u62C9[VAR 0114(0079)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u55EF\uFF01\uFF1F\u961F\u957F\uFF01\\n\u6211\u597D\u50CF\u542C\u5230\u6709\u4EBA\u5728\u53EB\u6211\u2026\u2026\\r\\n\u662F\u4F60\u5417\uFF1F[VAR 0114(0076)]"
  },
  {
