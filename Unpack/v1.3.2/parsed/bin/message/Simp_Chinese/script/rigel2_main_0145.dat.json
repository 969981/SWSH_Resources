[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8981\u628A\u841D\u535C\u62D4\u51FA\u6765\u5417\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E00\u4E8C\u4E09\u2026\u2026\u6211\u62D4\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5B69\u5B50\u554A\uFF0C\\n\u6C5D\u505A\u5F97\u5F88\u597D\u3002[VAR 0114(0079)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u4E86\u90A3\u9897\u841D\u535C\uFF0C\\n\u5C31\u80FD\u6210\u529F\u5438\u5F15\\r\\n\u5B64\u4E4B\u7231\u9A6C\u73B0\u8EAB\u4E86\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\u53EA\u9700\u8981\u6709\\n\u80FD\u8BA9\u5B64\u7684\u529B\u91CF\u589E\u5F3A\u7684\u7275\u7ECA\u7F30\u7EF3\uFF0C\\r\\n\u5B64\u5C31\u80FD\u8F7B\u677E\u5730\u9A7E\u9A6D\u7231\u9A6C\u4E86\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u4EBA\u7C7B\u5927\u6982\u518D\u4E5F\u4E0D\u4F1A\\n\u628A\u90A3\u4E1C\u897F\u8FDB\u732E\u7ED9\u5B64\u4E86\u5427\u3002[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u767D\u568E\uFF5E\u5636\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u9ED1\u568E\uFF5E\u5636\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u90A3\u5BB6\u4F19\u662F\u5B64\u7684\u7231\u9A6C\\n\u2026\u2026\u96EA\u66B4\u9A6C\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u90A3\u5BB6\u4F19\u662F\u5B64\u7684\u7231\u9A6C\\n\u2026\u2026\u7075\u5E7D\u9A6C\uFF01\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u6D01\u767D\u95EA\u8000\u7684\u76AE\u6BDB\uFF01\\n\u90A3\u72C2\u91CE\u5954\u817E\u7684\u8EAB\u5F71\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u90A3\u6F06\u9ED1\u95EA\u8000\u7684\u76AE\u6BDB\uFF01\\n\u90A3\u72C2\u91CE\u5954\u817E\u7684\u8EAB\u5F71\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u7B80\u76F4\u4E0E\u521D\u89C1\u65F6\u6CA1\u6709\u4E1D\u6BEB\u4E0D\u540C\uFF01\\n\u554A\uFF5E\u592A\u4EB2\u5207\u4E86\uFF0C\u592A\u6000\u5FF5\u4E86\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u767D\u5509\uFF5E\u5636\u2026\u2026"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u9ED1\u5509\uFF5E\u5636\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5B64\u6599\u90A3\u5BB6\u4F19\u867D\u7136\\n\u611F\u53D7\u5230\u4E86\u841D\u535C\u7684\u9999\u6C14\uFF0C\\r\\n\u4F46\u4ECD\u672A\u638C\u63E1\u5230\u786E\u5207\u7684\u4F4D\u7F6E\u3002[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4ECE\u5B83\u8DD1\u53BB\u7684\u65B9\u5411\u6765\u770B\uFF0C\\n\u8BF4\u4E0D\u5B9A\u662F\u53BB\u6751\u5B50\u91CC\u62A2\u841D\u535C\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u82E5\u679C\u771F\u5982\u6B64\uFF0C\u5B69\u5B50\u554A\uFF0C\\n\u51BB\u51DD\u6751\u6709\u5371\u9669\u4E86\uFF01\\r\\n\u901F\u901F\u8D76\u8FC7\u53BB\u5427\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u8FD9\u2026\u2026\u8FD9\u662F\u6211\u7684\u7530\uFF0C\\n\u4F60\u4F11\u60F3\u5728\u8FD9\u91CC\u80E1\u95F9\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4E0D\u3001\u4E0D\u597D\u5566\uFF01\\n\u6709\u53EA\u5B9D\u53EF\u68A6\u6B63\u5728\u6751\u91CC\u80E1\u95F9\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u90A3\u53EA\u5B9D\u53EF\u68A6\u2026\u2026\\n\u96BE\u9053\u662F\u4F20\u8BF4\u91CC\u7684\u90A3\u53EA\uFF01\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u90A3\u4E48\u5927\u4E00\u53EA\u5B9D\u53EF\u68A6\u8981\u662F\\n\u5728\u6751\u5B50\u91CC\u5927\u95F9\u8D77\u6765\uFF0C\u90A3\u8FD8\u5F97\u4E86\u554A\uFF01\\c\\n\u8C01\u6765\u5E2E\u5E2E\u5FD9\uFF01\\n\u8BA9\u90A3\u53EA\u66B4\u8E81\u7684\u5BB6\u4F19\u8001\u5B9E\u4E0B\u6765\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u600E\u4E48\u8FD9\u4E48\u70ED\u95F9\u554A\u3002\\n\u73B0\u5728\u662F\u4E3E\u529E\u5E86\u5178\u7684\u5B63\u8282\u5417\uFF1F"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5B64\u7684\u7231\u9A6C\u2026\u2026\u4E07\u4E00\u628A\u4EBA\u7C7B\u2026\u2026\\n\u4F46\u73B0\u5728\u7684\u5B64\u65E0\u80FD\u4E3A\u529B\u2026\u2026\\c\\n\u5B69\u5B50\u554A\uFF0C\u62DC\u6258\u4E86\uFF01\\n\u5B64\u5E0C\u671B\u6C5D\u80FD\u6551\u6551\u6751\u5B50\uFF01[VAR 0114(0079)]"
