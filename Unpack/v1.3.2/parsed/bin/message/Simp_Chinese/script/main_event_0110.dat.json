[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5149\u5E26\u7740\u5B9D\u53EF\u68A6\uFF0C\\n\u8FD8\u7B97\u4E0D\u4E0A\u662F\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF01\\c\\n\u8981\u4F1A\u57F9\u80B2\u5B9D\u53EF\u68A6\uFF0C\u8BA9\u5B83\u4EEC\u5BF9\u6218\uFF0C\\n\u624D\u80FD\u79F0\u5F97\u4E0A\u662F\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u79F0\u4E0D\u79F0\u5F97\u4E0A\u662F\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\\n\u8FD8\u662F\u5148\u8BA9\u6211\u77A7\u77A7\u4F60\u4EEC\u7684\u8EAB\u624B\u518D\u8BF4\u5427\u3002\\c\\n\u4E0D\u5982\u4F60\u4EEC\u4E24\u4E2A\u597D\u597D\u51C6\u5907\u4E00\u4E0B\uFF0C\\n\u73B0\u5728\u5C31\u6765\u573A\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u662F\u4F60\u4EBA\u751F\u4E2D\u7B2C\u4E00\u573A\u5B9D\u53EF\u68A6\u5BF9\u6218\u3002\\n\u51C6\u5907\u597D\u4E86\u5417\uFF1F\u8981\u5F00\u59CB\u4E86\u54E6\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u7ED9\u4F60\u63D0\u4E00\u4E2A\u5EFA\u8BAE\uFF01\\c\\n\u4E3A\u4E86\u4E0D\u5FD8\u8BB0\u4E4B\u524D\u7ECF\u5386\u8FC7\u7684\u4E8B\u60C5\uFF0C\\n\u5EFA\u8BAE\u4F60\u52E4\u5199\u8BB0\u5F55\u3002[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8981\u76F8\u4FE1\u4E0E\u4F60\u642D\u6863\u7684\u5B9D\u53EF\u68A6\uFF01\\n\u8FD8\u8981\u4ECE\u5FC3\u91CC\u73CD\u60DC\u5B83\uFF01\\c\\n\u53EA\u6709\u8FD9\u6837\uFF0C\u4F60\u624D\u80FD\u77E5\u9053\u9009\u54EA\u4E2A\u62DB\u5F0F\\n\u53EF\u4EE5\u53D1\u6325\u51FA\u5B9D\u53EF\u68A6\u7684\u5B9E\u529B\u3002\\r\\n\u66F4\u91CD\u8981\u7684\u662F\uFF0C\u5BF9\u6218\u4E5F\u4F1A\u53D8\u5F97\u66F4\u6709\u8DA3\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u4F60\u4EEC\u4E24\u4E2A\u548C\u5B9D\u53EF\u68A6\u90FD\u7B49\u4E0D\u53CA\u4E86\u5427\uFF1F\\n\u90A3\u5C31\u6765\u4E00\u573A\u6FC0\u60C5\u7684\u5BF9\u6218\u5427\uFF01\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5927\u54E5\u7684\u6BCF\u573A\u6BD4\u8D5B\u6211\u90FD\u4F1A\u770B\uFF01\\c\\n\u5927\u54E5\u7559\u5728\u623F\u95F4\u91CC\u7684\u4E66\u548C\u6742\u5FD7\uFF0C\\n\u6211\u4E5F\u662F\u4E00\u672C\u4E0D\u843D\u5730\u8BFB\u5B8C\u4E86\uFF01\\r\\n\u6211\u77E5\u9053\u8BE5\u5982\u4F55\u53D6\u80DC\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u8FD8\u771F\u5389\u5BB3\u554A\uFF01\\n\u96BE\u602A\u5927\u54E5\u4F1A\u628A\u5B9D\u53EF\u68A6\u9001\u7ED9\u4F60\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u867D\u7136\u5927\u54E5\u4E5F\u9001\u4F60\u5B9D\u53EF\u68A6\u4E86\uFF0C\\n\u4F46\u6211\u624D\u662F\u6700\u5F3A\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4E24\u4E2A\u7684\u5B9D\u53EF\u68A6\u90FD\\n\u6253\u5F97\u5F88\u6F02\u4EAE\uFF0C\u5F88\u7CBE\u5F69\uFF01\\c\\n\u770B\u5F97\u6211\u5DEE\u70B9\u5C31\u8981\u6D3E\u51FA\\n\u55B7\u706B\u9F99\u52A0\u5165\u5BF9\u6218\u4E86\u2026\u2026\\c\\n[VAR 0101(0001)]\uFF0C\u4E5F\u8F9B\u82E6\u4F60\u4E86\uFF01\\n\u6765\uFF0C\u8BA9\u6211\u5E2E\u4F60\u6062\u590D\u6D3B\u529B\u5427\u3002[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u6211\u5F88\u770B\u597D\u4F60\uFF0C\\n\u6240\u4EE5\u60F3\u62DC\u6258\u4F60\u4E00\u4EF6\u4E8B\uFF01\\c\\n\u8BF7\u4F60\u6210\u4E3A\u8D6B\u666E\u7684\u52B2\u654C\uFF0C\\n\u4E24\u4E2A\u4EBA\u4E00\u8D77\u53D8\u5F3A\u5427\uFF01\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u548C[VAR 0101(0002)]\u90FD\u8FEB\u4E0D\u53CA\u5F85\u4E86\uFF01[VAR 0114(0005)]"
  }
]
