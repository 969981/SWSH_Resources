    "text": "\u6211\u5C31\u77E5\u9053\uFF0C\u4F60\u4E00\u5B9A\u4F1A\u96C6\u9F50\u9053\u9986\u5FBD\u7AE0\uFF0C\\n\u51FA\u73B0\u5728\u8FD9\u91CC\u3002[VAR 0114(000D)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u867D\u7136\u5927\u54E5\u7684\u4E8B\uFF0C\\n\u8FD8\u6709\u632F\u5174\u5C16\u9489\u9547\u7684\u4E8B\uFF0C\\r\\n\u786E\u5B9E\u8BA9\u6211\u60F3\u4E86\u5F88\u591A\u2026\u2026[VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F46\u8BF4\u5230\u5E95\uFF0C\u6211\u60F3\u8981\u5F53\u4E0A\u51A0\u519B\uFF0C\\n\u8FD8\u662F\u4E3A\u4E86\u6211\u81EA\u5DF1\u5450\uFF01\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6240\u4EE5\uFF0C\u6211\u8981\u8BA9\u4F60\u961F\u4F0D\u91CC\u7684\u5B9D\u53EF\u68A6\\n\u8212\u670D\u5730\u53BB\u7761\u4E0A\u4E00\u89C9\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7ADE\u6280\u573A\u91CC\u7684\u6BCF\u4E2A\u4EBA\\n\u90FD\u89C2\u770B\u4E86\u6211\u4EEC\u7684\u6BD4\u8D5B\u2026\u2026\\c\\n\u5927\u5BB6\u5BF9\u6211\u548C\u5B9D\u53EF\u68A6\u7684\u52A0\u6CB9\u58F0\u2026\u2026\\n\u6211\u90FD\u6E05\u695A\u5730\u542C\u5230\u4E86\u2026\u2026\\r\\n\u5FC3\u91CC\u7F8E\u6ECB\u6ECB\u7684\u5450\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u867D\u7136\u662F\u8F93\u4E86\u2026\u2026\\c\\n\u4F46\u662F\u6211\u4EEC\u8BA9\u6BCF\u4E2A\u89C2\u4F17\u90FD\u72C2\u70ED\u4E86\u3002\\c\\n\u8868\u73B0\u5F97\u8FD8\u7B97\u4E0D\u8D56\u5427\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\uFF0C\u6211\u5C31\u548C\u5927\u54E5\u4ED6\u4EEC\u4E00\u8D77\\n\u5728\u89C2\u4F17\u5E2D\u4E0A\u89C1\u8BC1\u4E00\u4E0B\\r\\n\u7A76\u7ADF\u8C01\u80FD\u5411\u51A0\u519B\u6311\u6218\u5427\u3002[VAR 0114(000D)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u6211\u8FD8\u6CA1\u51B3\u5B9A\u597D\\n\u8981\u4E0D\u8981\u4E3A\u4F60\u52A0\u6CB9\u54E6\u2026\u2026\u518D\u89C1\u5566\uFF01[VAR 0114(000D)]"
  }
