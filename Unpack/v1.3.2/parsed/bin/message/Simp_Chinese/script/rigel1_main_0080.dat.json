  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5999\u86D9\u79CD\u5B50\u6210\u4E3A\u4E86\\n[VAR 0100(0000)]\u7684\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6770\u5C3C\u9F9F\u597D\u50CF\\n\u5F88\u9AD8\u5174\u4F60\u9009\u4E86\u5B83\u54E6\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5999\u86D9\u79CD\u5B50\u597D\u50CF\\n\u5F88\u9AD8\u5174\u4F60\u9009\u4E86\u5B83\u54E6\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5999\u86D9\u79CD\u5B50\u5C31\u7531\u6211\u6765\\n\u7528\u6EE1\u6EE1\u7684\u7231\u53BB\u57F9\u80B2\u5427\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6770\u5C3C\u9F9F\u5C31\u7531\u6211\u6765\\n\u7528\u6EE1\u6EE1\u7684\u7231\u53BB\u57F9\u80B2\u5427\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u54B1\u4EEC\u4E00\u8D77\u52AA\u529B\u53D8\u5F3A\uFF0C\\n\u4E0D\u8981\u8F93\u7ED9[VAR 0101(0001)]\u4ED6\u4EEC\u54E6\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u79CD\u5B50\u79CD\uFF5E\u5B50\uFF1F"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6770\u5C3C\u6770\u5C3C\uFF1F"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5E08\u6BCD\uFF01\\n\u5982\u679C\u4F60\u60F3\u8BA9\u5B9D\u53EF\u68A6\u5B66\u4F1A[VAR FF00(0006)]\u65B0\u62DB\u5F0F[VAR FF00(0000)]\u7684\u8BDD\uFF0C\\r\\n\u5C31\u4EA4\u7ED9\u5728\u4E0B\u6211\u5427\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[~ 17]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u54CE\u5440\uFF01\u4E0D\u9519\u4E0D\u9519\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u53EA\u8981\u7ED9\u90A3\u5B69\u5B50\u94E0\u7532\u77FF\u77F3\uFF0C\\n\u5C31\u80FD\u8BA9\u4ED6\u6559\u5B9D\u53EF\u68A6\u65B0\u62DB\u5F0F\u3002\\r\\n\u4F60\u4E5F\u8BD5\u8BD5\u5427\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u8FD9\u4E9B\u5B69\u5B50\u8FDB\u5316\uFF12\u6B21\u4E4B\u540E\\n\u5C31\u80FD\u8D85\u6781\u5DE8\u5316\u4E86\u3002\\r\\n\u4F60\u8981\u597D\u597D\u57F9\u80B2\u5B83\u54E6\u3002[VAR 0114(0074)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6781\u5DE8\u5316\u2026\u2026\u90A3\u6B63\u662F\u4F3D\u52D2\u5C14\u7684\\n\u5B9D\u53EF\u68A6\u7684\u795E\u79D8\u4E4B\u5904\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6781\u5DE8\u5316\u540E\u7684\u5B9D\u53EF\u68A6\uFF0C\u4E0D\u4EC5\u6837\u5B50\u4F1A\u6539\u53D8\uFF0C\\n\u4F7F\u51FA\u7684\u62DB\u5F0F\u4E5F\u4F1A\u53D1\u751F\u53D8\u5316\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5728\u6781\u5DE8\u5316\u4E4B\u4E2D\uFF0C\\n\u66F4\u4E3A\u7279\u522B\u7684\u5C31\u662F\u8D85\u6781\u5DE8\u5316\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u8BF4\u8D77\u8D85\u6781\u5DE8\u5316\uFF0C\u4E0D\u5F97\u4E0D\u63D0\u7684\u5C31\u662F\\n\u9A6C\u5E08\u5085\u6B66\u9986\u79D8\u4F20\u7684\u90A3\u4E2A\u4E1C\u897F\u4E86\uFF01\\r\\n\u559D\u4E0B\u5C31\u4F1A\u53D8\u5F97[VAR FF00(0006)]\u8D85\u6781\u5DE8[VAR FF00(0000)]\u7684\uFF01[VAR FF00(0006)]\u6781\u5DE8\u6C64[VAR FF00(0000)]\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u8001\u5934\u513F\u6211\u597D\u4E45\u6CA1\u559D\u5230\u653E\u4E86\\n\u6EE1\u6EE1\u7684[VAR FF00(0006)]\u6781\u5DE8\u83C7\u83C7[VAR FF00(0000)]\u7684\u6781\u5DE8\u6C64\u4E86\uFF0C\\r\\n\u597D\u60F3\u559D\u554A\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u2026\u2026\u6240\u4EE5\u5462\uFF01\u7B2C\uFF12\u4E2A\u4FEE\u884C\uFF0C\\n\u5C31\u662F\u91C7\u8611\u83C7\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u8BF7\u5927\u5BB6\u53BB\u91C7\u96C63\u4E2A\u8D85\u6781\u5DE8\u5316\u7684\\n\u5173\u952E\u98DF\u6750\uFF01\u4E5F\u5C31\u662F\u6781\u5DE8\u83C7\u83C7\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6781\u5DE8\u83C7\u83C7[VAR FF00(0006)]\u7EA2\u7EA2\u7684\uFF0C\\n\u6709\u65CB\u6DA1\u72B6\u7684\u82B1\u7EB9[VAR FF00(0000)]\uFF01\\c\\n\u6211\u731C\u5B83\u4EEC\u4F1A\u957F\u5728\\n\u9634\u6697\u6F6E\u6E7F\u7684\u5730\u65B9\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u90A3\uFF0C\u5C31\u662F\u8FD9\u4E48\u56DE\u4E8B\u5566\uFF01\\n\u4FEE\u884C\u5F00\u59CB\uFF01\\r\\n\u62DC\u6258\u4F60\u4EEC\u565C\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u54E6\u2026\u2026\u5514\u5662\u5662\u5662\u5662\uFF01\uFF01"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u4E0D\u597D\u610F\u601D\u54E6\uFF5E\u6211\u5440\uFF5E\\n\u8FD8\u6CA1\u6709\u8BA4\u53EF\u4F60\u7684\u5B9E\u529B\u54E6\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u8FD9\u6B21\u7684\u4FEE\u884C\uFF0C\u6211\u662F\\n\u7EDD\uFF5E\uFF5E\uFF5E\u5BF9\u4E0D\u4F1A\u8F93\u7ED9\u4F60\u7684\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u547D\u8FD0\u6CE8\u5B9A\u6211\u4ECD\u65E7\\n\u65E0\u6CD5\u8BA4\u53EF\u4F60\u7684\u5B9E\u529B\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u4E14\u8BA9\u6211\u62A2\u5148\u627E\u5230\u6781\u5DE8\u83C7\u83C7\uFF0C\\n\u5C06\u4E0D\u5BB9\u7F6E\u7591\u7684\u80DC\u5229\u6536\u5165\u56CA\u4E2D\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u7B2C\uFF12\u4E2A\u4FEE\u884C\u7684\u5185\u5BB9\u5C31\u662F\\n\u91C7\u56DE\uFF13\u4E2A\u6781\u5DE8\u83C7\u83C7\uFF01\\c\\n\u6781\u5DE8\u83C7\u83C7\u662F\u4E00\u79CD\u7EA2\u8272\u7684\u3001\\n\u6709\u7740\u65CB\u6DA1\u82B1\u7EB9\u7684\u8611\u83C7\u3002\\c\\n\u6211\u731C\u5B83\u4EEC\u4F1A\u957F\u5728\\n\u9634\u6697\u6F6E\u6E7F\u7684\u5730\u65B9\u54DF\u3002[VAR 0114(0073)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u6211\u4EEC\u6682\u4E14\u5148\u5728\u8FD9\u513F\u81EA\u6211\u8BAD\u7EC3\u5566\uFF5E\uFF01"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6781\u5DE8\u83C7\u83C7\u662F\u957F\u5728\\n\u4E13\u6CE8\u68EE\u6797\u91CC\u6765\u7740\u5417\uFF1F\\r\\n\u8FD8\u662F\u957F\u5728\u7A7F\u8FC7\u68EE\u6797\u4E4B\u540E\u7684\u6D1E\u7A74\u91CC\uFF1F"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u55EF\uFF1F\u6211\u7559\u5728\u6B66\u9986\u770B\u5BB6\u4E86\u2026\u2026\\c\\n\u8C01\u8BA9\u6211\u6CA1\u6709\u5B8C\u6210\u5446\u5446\u517D\u7684\u4FEE\u884C\u5462\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u8DEF\u4E0A\u5C0F\u5FC3\uFF01\\n\u6211\u4F1A\u997F\u7740\u809A\u5B50\u2026\u2026\u4E0D\u662F\uFF0C\\r\\n\u6211\u4F1A\u4E3A\u4F60\u4EEC\u52A0\u6CB9\uFF0C\u7B49\u4F60\u4EEC\u56DE\u6765\u7684\uFF01"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u6211\u5F97\u52AA\u529B\u57F9\u80B2\u5999\u86D9\u79CD\u5B50\u54AF\uFF01[VAR 0114(0074)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u6211\u5F97\u52AA\u529B\u57F9\u80B2\u6770\u5C3C\u9F9F\u54AF\uFF01[VAR 0114(0074)]"
  }
