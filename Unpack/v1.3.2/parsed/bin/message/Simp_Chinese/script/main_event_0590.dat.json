    "text": "\u4F5C\u4E3A\u9053\u9986\u6311\u6218\u7684\u7B2C\u4E00\u5173\uFF0C\\n\u8FD9\u91CC\u4F1A\u6709\u9053\u9986\u6311\u6218\u8005\\r\\n\u63A5\u8FDE\u4E0D\u65AD\u5730\u524D\u6765\u6311\u6218\u3002\\c\\n\u6240\u4EE5\u6211\u523B\u610F\u63D0\u9AD8\u4E86\\n\u9053\u9986\u4EFB\u52A1\u7684\u96BE\u5EA6\u2026\u2026[VAR 0114(000E)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F46\u662F[VAR 0100(0000)]\uFF0C\\n\u4F60\u51FA\u8272\u5730\u5B8C\u6210\u4E86\u9053\u9986\u4EFB\u52A1\uFF01\\r\\n\u771F\u662F\u4E86\u4E0D\u5F97\u554A\u3002[VAR 0114(000E)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u4E00\u5B9A\u5F88\u4E86\u89E3\u5B9D\u53EF\u68A6\u5427\u3002\\c\\n\u770B\u6765\u8FD9\u4F1A\u662F\u4E00\u573A\u786C\u4ED7\uFF01\\n\u6211\u4E5F\u8981\u4F7F\u51FA[VAR FF00(0001)]\u6781\u5DE8\u5316[VAR FF00(0000)]\u624D\u884C\u554A\u3002[VAR 0114(000E)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u573A\u5BF9\u6218\u8BA9\u4F60\u6536\u83B7\u4E0D\u5C11\u5427\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8BF7\u6536\u4E0B\u8FD9\u679A\u8349\u4E4B\u5FBD\u7AE0\uFF01\\n\u5B83\u53EF\u4EE5\u8BC1\u660E\u4F60\u5728\u9053\u9986\u6311\u6218\u4E2D\\r\\n\u6218\u80DC\u4E86\u6211\u8FD9\u4E2A\u9053\u9986\u9986\u4E3B\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53EF\u4EE5\u6355\u6349\u7B49\u7EA7\uFF12\uFF15\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u5FC5\u987B\u96C6\u9F50\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u624D\u80FD\\n\u5728\u9053\u9986\u6311\u6218\u4E2D\u664B\u7EA7\u3002\\c\\n\u53BB\u6311\u6218\u5176\u4ED6\u7684\u9053\u9986\u9986\u4E3B\uFF0C\\n\u8BA9\u80DC\u5229\u5EF6\u7EED\u5230\u5E95\u5427\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
