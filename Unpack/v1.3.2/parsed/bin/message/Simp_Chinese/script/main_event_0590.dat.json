  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u4F60\u6218\u80DC\u9053\u9986\u9986\u4E3B\u4E9A\u6D1B\u4E86\u554A\u3002\\r\\n\u771F\u662F\u606D\u559C\u4F60\u4E86\u3002\\c\\n\u6536\u4E0B\u8FD9\u4E2A\u62DB\u5F0F\u5B66\u4E60\u5668\uFF0C\\n\u7559\u4F5C\u7EAA\u5FF5\u5427\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u53E6\u5916\uFF0C\u4E5F\u8BF7\u6536\u4E0B\u8FD9\u5957\u4E9A\u6D1B\u7684\u7ADE\u6280\u670D\u5427\uFF01\\n\u2026\u2026\u5F53\u7136\u4E86\uFF0C\u8FD9\u662F\u590D\u5236\u54C1\u3002"
