[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6211\u5C31\u662F\u4EBA\u79F0\\n\u201C\u6316\u6316\u5AC2\u201D\u7684\u4EBA\u7269\u2026\u2026\\c\\n\u4F60\u78B0\u89C1\u8FC7\u6316\u6316\u4F2F\u4E86\u5417\uFF1F\\n\u4ED6\u662F\u6211\u7684\u540C\u4F34\u54E6\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u6B63\u5728\u4EAB\u53D7\u6316\u6D1E\u7684\u4E50\u8DA3\uFF0C\u4E5F\u4F53\u9A8C\u7740\u523A\u6FC0\u54E6\u3002\\n\u8FD9\u628A\u94F2\u5B50\u662F\u6211\u7684\u6316\u6D1E\u597D\u642D\u6863\uFF0C\\r\\n\u6211\u628A\u5B83\u53EB\u505A\u201C\u6211\u7684\u7231\u52FA\u201D\u54E6\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E3A\u7EAA\u5FF5\u6211\u4EEC\u7684\u76F8\u9047\uFF0C\\n\u6211\u5F88\u60F3\u9001\u4F60\uFF11\u4E2A\u94E0\u7532\u77FF\u77F3\u2026\u2026"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\uFF01\u4F46\u662F\uFF01\uFF01\\c\\n\u4F60\u65E2\u53EF\u4EE5\u9009\u62E9\u76F4\u63A5\\n\u9886\u53D6\u8FD9\uFF11\u4E2A\u94E0\u7532\u77FF\u77F3\uFF0C\\c\\n\u4E5F\u53EF\u4EE5\u9009\u62E9\u4EE5\u5B83\u4E3A\u672C\u94B1\\n\u8BA9\u6211\u6316\u66F4\u591A\u7684\u77FF\u77F3\u7ED9\u4F60\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u53EA\u4E0D\u8FC7\uFF01\u5982\u679C\u6211\u7684\u7231\u52FA\\n\u5728\u6316\u7684\u8FC7\u7A0B\u4E2D\u574F\u6389\u4E86\uFF0C\\r\\n\u4F60\u80FD\u83B7\u5F97\u7684\u6570\u91CF\u5C31\u4F1A\u53D8\u4E3A\u96F6\u86CB\u2026\u2026"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u60F3\u8FFD\u6C42\u523A\u6FC0\u7684\u8BDD\uFF0C\\n\u4E0D\u5982\u8BD5\u7740\u628A\u4EBA\u751F\u6258\u4ED8\u7ED9\u6211\uFF1F\\r\\n\u6211\u4F1A\u8BA9\u4F60\u5148\u5199\u597D\u8BB0\u5F55\u7684\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[~ 7]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6316\u5B9D\u6709\u98CE\u9669\uFF0C\u60F3\u907F\u514D\u662F\u4E0D\u53EF\u80FD\u7684\u3002\\n\u8D4C\u4E0A\u4F60\u7684\u4EBA\u751F\uFF0C\u8FDB\u884C\u6311\u6218\u5427\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5343\u8F7D\u96BE\u9022\u7684\u8C6A\u8D4C\u7B49\u4F60\u6765\u6311\u6218\u3002\\n\u671F\u5F85\u7740\u518D\u6B21\u89C1\u5230\u4F60\u54E6\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6765\u5427\uFF0C\u6211\u8981\u5F00\u59CB\u5566\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u545C\u554A\u2026\u2026\u5BF9\u4E0D\u8D77\uFF01\\n\u6211\u7684\u7231\u52FA\u649E\u5230\u4E86\u8D85\u786C\u7684\u77F3\u5934\uFF0C\\r\\n\u574F\u6389\u4E86\u5462\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u672C\u6765\u53EF\u4EE5\u5F97\u5230\u7684\\n\u94E0\u7532\u77FF\u77F3\u4E5F\u5168\u90FD\u6CA1\u4E86\u2026\u2026"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8FD9\u5C31\u662F\u4EBA\u751F\u3002\\n\u90A3\u4E48\u2026\u2026\u6709\u7F18\u522B\u5904\u518D\u76F8\u9022\u5566\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u6316\u5230\u4E86[VAR 0203(0001,0000)]\u4E2A\u94E0\u7532\u77FF\u77F3\u54E6\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[~ 16]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u73B0\u5728\u7ED3\u675F\u7684\u8BDD\uFF0C\\n\u4F60\u5C31\u80FD\u5F97\u5230[VAR 0203(0002,0000)]\u4E2A\u94E0\u7532\u77FF\u77F3\uFF01"
