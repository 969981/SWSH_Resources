[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54E6\u2026\u2026\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\u535A\u58EB\uFF0C\u6709\u5BA2\u4EBA\u6765\u4E86\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6B22\u8FCE\u4F60\uFF0C[VAR 0100(0000)]\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5979\u662F\u8C01\uFF1F"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u6709\u52A9\u624B\u4E86\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5979\u662F\u6211\u7684\u52A9\u624B\uFF01\\c\\n\u6211\u7684\u7814\u7A76\u8D8A\u6765\u8D8A\u5FD9\uFF0C\\n\u4E8E\u662F\u5C31\u8BF7\u5979\u6765\u5E2E\u5FD9\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u975E\u5E38\u6B63\u786E\uFF01\\c\\n\u6211\u7684\u7814\u7A76\u8D8A\u6765\u8D8A\u5FD9\uFF0C\\n\u4E8E\u662F\u5C31\u8BF7\u5979\u6765\u5E2E\u5FD9\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\u4E4B\u524D\u5927\u91CF\u6536\u96C6\u7684\u90A3\u4E9B\u8BB8\u613F\u661F\uFF0C\\n\u73B0\u5728\u90FD\u4FDD\u7BA1\u5728\u8FD9\u4E2A\u7814\u7A76\u6240\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u591A\u4E8F\u6709\u5979\u5E72\u8106\u5229\u843D\u5730\\n\u5E2E\u6211\u505A\u597D\u4E86\u6574\u7406\u3002\\c\\n\u8981\u4E0D\u662F\u5979\u8FD9\u4E48\u80FD\u5E72\uFF0C\\n\u6211\u80AF\u5B9A\u8981\u5FD9\u5F97\u6655\u5934\u8F6C\u5411\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u54EA\u91CC\uFF0C\u4F60\u8FC7\u5956\u4E86\u2026\u2026"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u5C31\u662F\u65B0\u51A0\u519B[VAR 0100(0000)]\u5427\uFF1F\\c\\n\u5F88\u8363\u5E78\u80FD\u89C1\u5230\u4F60\uFF0C\u8BF7\u591A\u5173\u7167\u5566\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u6765\u4E00\u4E0B\uFF01\\n\u6211\u6709\u4E1C\u897F\u60F3\u8BA9\u4F60\u770B\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u8FD8\u8BB0\u5F97\u80FD\u91CF\u70B9\u63A2\u6D4B\u673A\u5417\uFF1F\\c\\n\u5728\u80FD\u6781\u5DE8\u5316\u7684\u5730\u65B9\u2026\u2026\\n\u4E5F\u5C31\u662F\u4F3D\u52D2\u5C14\u7C92\u5B50\u5927\u91CF\u805A\u96C6\u7684\u5730\u65B9\uFF0C\\r\\n\u8FD9\u4E2A\u673A\u5668\u5C31\u4F1A\u4EA7\u751F\u53CD\u5E94\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E00\u5B9A\u662F\u8FD9\u6837\u4E86\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u8FD8\u7EB3\u95F7\u5728\u90A3\u4E24\u4E2A\u5BB6\u4F19\u9644\u8FD1\u7684\u65F6\u5019\uFF0C\\n\u4E3A\u4EC0\u4E48\u63A2\u6D4B\u673A\u6709\u53CD\u5E94\u4E86\u5462\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6CA1\u51C6\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4E5F\u5C31\u662F\u8BF4\u2026\u2026\uFF1F"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6CA1\u9519\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4E5F\u5C31\u662F\u8BF4\u554A\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u53EA\u8981\u5229\u7528\u80FD\u91CF\u70B9\u63A2\u6D4B\u673A\u7684\u53CD\u5E94\uFF0C\\n\u8BF4\u4E0D\u5B9A\u5C31\u80FD\u8FFD\u8E2A\u897F\u7D22\u4E8C\u4EBA\u7EC4\u554A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6240\u8C13\u897F\u7D22\u4E8C\u4EBA\u7EC4\u2026\u2026\\n\u5C31\u662F\u4ECE\u897F\u5C14\u8FEA\u548C\u7D22\u5FB7\u7684\u540D\u5B57\u5404\u53D6\u4E00\u5B57\u2026\u2026\\r\\n\u5FF5\u8D77\u6765\u5F88\u987A\u53E3\u5427\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u65E2\u7136\u5982\u6B64\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6211\u4EEC\u5C31\u548C\u8BBE\u7F6E\u4E8E\u4F3D\u52D2\u5C14\u5730\u533A\\n\u5404\u5730\u7684\u80FD\u91CF\u70B9\u63A2\u6D4B\u673A\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u8FDE\u7EBF\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u54C7\uFF01\u8FD9\u4E2A\u53CD\u5E94\u5927\u5F97\u51FA\u4EBA\u610F\u6599\u554A\uFF01\\n\u5730\u70B9\u662F\u2026\u2026\u8349\u8DEF\u7ADE\u6280\u573A\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u867D\u8BF4\u7ADE\u6280\u573A\u662F\u4E2A\u53EF\u4EE5\u6781\u5DE8\u5316\u7684\u5730\u65B9\uFF0C\\n\u4EA7\u751F\u53CD\u5E94\u672C\u6765\u5E76\u4E0D\u5947\u602A\u2026\u2026\\r\\n\u4F46\u8FD9\u4E2A\u6570\u503C\u5B9E\u5728\u662F\u5F88\u5F02\u5E38\u554A\u2026\u2026\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u662F\u65E0\u6781\u6C70\u90A3\u5417\u2026\u2026\uFF1F\\n\u4E0D\uFF0C\u5E94\u8BE5\u4E0D\u662F\u5B83\u3002\\r\\n\u6BD5\u7ADF\u5B83\u5DF2\u7ECF\u88AB[VAR 0100(0000)]\u6349\u4F4F\u4E86\u3002\\c\\n\u96BE\u9053\u8FD9\u548C\u897F\u7D22\u4E8C\u4EBA\u7EC4\u6709\u5173\u7CFB\u5417\u2026\u2026\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\u8EAB\u4E3A\u51A0\u519B\u2026\u2026\\n\u4F60\u4E0D\u4F1A\u5BF9\u773C\u524D\u7684\u72B6\u51B5\u89C6\u800C\u4E0D\u89C1\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6211\u5DF2\u7ECF\u8C03\u6574\u4E86\u4F60\u7684\u57CE\u9547\u5730\u56FE\uFF0C\\n\u73B0\u5728\u4F60\u4E5F\u53EF\u4EE5\u770B\u5230\u54EA\u91CC\u6709\u7C92\u5B50\u53CD\u5E94\u4E86\u3002\\r\\n\u8981\u662F\u4F60\u4E0D\u77E5\u9053\u53BB\u54EA\u624D\u597D\uFF0C\u5C31\u770B\u5730\u56FE\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6211\u8FD8\u8981\u8C03\u67E5\u4E00\u4E0B\u90A3\u4E24\u4E2A\u5BB6\u4F19\u3002\\c\\n\u6240\u4EE5\u8349\u8DEF\u7ADE\u6280\u573A\u90A3\u8FB9\u5C31\u62DC\u6258\\n\u4F60\u53BB\u8C03\u67E5\u4E00\u4E0B\u5566\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6211\u5F88\u9AD8\u5174\u80FD\u5728\\n\u7D22\u59AE\u4E9A\u535A\u58EB\u7684\u624B\u4E0B\u5DE5\u4F5C\u3002\\c\\n\u56E0\u4E3A\u5979\u5E74\u7EAA\u8F7B\u8F7B\u5C31\u80FD\u62FF\u4E0B\\n\u535A\u58EB\u7684\u79F0\u53F7\uFF0C\u5B9E\u5728\u4E86\u4E0D\u8D77\u554A\u3002"
  }
]
