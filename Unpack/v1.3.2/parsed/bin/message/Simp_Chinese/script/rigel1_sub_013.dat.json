    "text": "\u5F00\u59CB\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6F02\u4EAE\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F60\u8981\u5E2E\u540C\u884C\u7684\u5B9D\u53EF\u68A6\\n\u56DE\u590D\u6D3B\u529B\u5417\uFF1F\uFF08\u8FD8\u5269[VAR 0200(0001)]\u6B21\u673A\u4F1A\uFF09"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4F60\u8F93\u4E86\u554A\u2026\u2026\\n\u8BF7\u4F60\u91CD\u65B0\u953B\u70BC\u5B9D\u53EF\u68A6\u548C\u81EA\u5DF1\uFF0C\\r\\n\u4E0B\u6B21\u518D\u6765\u6311\u6218\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5236\u7EA6\u6BD4\u8BD5\u672C\u6B21\u7684\u7ED3\u679C\u662F\u2026\u2026\\c\\n\u5728\u5C5E\u6027\u5236\u7EA6\u4E3A[VAR 0103(0002)]\u5C5E\u6027\u7684\u60C5\u51B5\u4E0B\uFF0C\\n\u4F60\u8FBE\u6210\u4E86[VAR 0203(0001,0000)]\u8FDE\u80DC\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u770B\u6765\uFF0C\u5BF9\u4E8E[VAR 0103(0002)]\u5C5E\u6027\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u4F60\u5DF2\u7ECF\u8FD0\u7528\u81EA\u5982\u4E86\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4E3A\u4E86\u79F0\u8D5E\u4F60\u4E0D\u61C8\u7684\u52AA\u529B\uFF0C\\n\u6211\u628A\u8FD9\u4E2A\u9001\u7ED9\u4F60\u5427\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5E0C\u671B\u4F60\u5728\u5176\u4ED6\u5C5E\u6027\u7684\u6BD4\u8BD5\u4E2D\\n\u4E5F\u80FD\u9AD8\u594F\u51EF\u6B4C\uFF0C\u4E00\u8DEF\u8FDE\u80DC\uFF01"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4EC0\u3001\u4EC0\u4E48\uFF01\uFF1F\\n\u4F60\u5728\u6240\u6709\u5C5E\u6027\u7684\u5236\u7EA6\u6BD4\u8BD5\u4E2D\\r\\n\u90FD\u8FDE\u80DC\u5230\u6700\u540E\u4E86\u2026\u2026\u662F\u5417\uFF01\uFF1F"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u7B80\u76F4\u8BA9\u4EBA\u96BE\u4EE5\u76F8\u4FE1\u2026\u2026\\n\u4F60\u5B8C\u6210\u4E86\u65E0\u6BD4\u60CA\u4EBA\u7684\u4E30\u529F\u4F1F\u4E1A\u554A\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u4E3A\u4E86\u79F0\u8D5E\u4F60\u90A3\u80FD\u5728\u6B66\u9986\u5386\u53F2\u4E2D\\n\u7559\u4E0B\u6D53\u58A8\u91CD\u5F69\u7684\u4E00\u7B14\u7684\u6218\u6597\u98CE\u91C7\uFF0C\\r\\n\u6211\u6388\u4E88\u4F60\u7A7F\u4E0A\u8FD9\u4EF6\u670D\u88C5\u7684\u6743\u5229\uFF01"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u4ECE\u4ECA\u5F80\u540E\uFF0C\u4E5F\u8981\u7EE7\u7EED\\n\u4E0D\u65AD\u7A81\u7834\u81EA\u5DF1\u7684\u6781\u9650\u554A\uFF01"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u4F60\u8981\u7EE7\u7EED\u6311\u6218\u5236\u7EA6\u6BD4\u8BD5\u5417\uFF1F"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u56DE\u590D\u540E\u7EE7\u7EED\u6311\u6218"
