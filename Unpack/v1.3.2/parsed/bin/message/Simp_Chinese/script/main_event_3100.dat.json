    "text": "\u4F60\u4EEC\u51E0\u4E2A\uFF01\\n\u6765\u5F97\u771F\u662F\u65F6\u5019\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9053\u9986\u7ADE\u6280\u573A\u5FEB\u6491\u4E0D\u4F4F\u4E86\uFF01\\c\\n\u7A81\u7136\u6765\u4E86\u597D\u51E0\u53EA\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\uFF0C\\n\u5B83\u4EEC\u6B63\u5728\u7ADE\u6280\u573A\u5185\u56DB\u5904\u5927\u95F9\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u662F\u6709\u4EBA\u501F\u8BB8\u613F\u661F\u7684\u529B\u91CF\u4F5C\u7684\u6076\u3002[VAR 0114(0016)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64\u2026\u2026\u8FD9\u7684\u786E\u4E5F\u662F\u4E2A\u95EE\u9898\u3002\\n\u4F46\u662F\u8981\u5148\u89E3\u51B3\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u7684\u4E8B\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u65E2\u7136\u4F60\u4EEC\u6765\u4E86\uFF0C\u5236\u670D\u6781\u5DE8\u5316\\n\u5B9D\u53EF\u68A6\u5C31\u4E0D\u7B97\u662F\u95EE\u9898\u4E86\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u4EEC\u5C31\u662F\u4E3A\u4E86\u8FD9\u4E2A\u624D\u6765\u7684\uFF01\\n\u5BF9\u5427\uFF1F[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
