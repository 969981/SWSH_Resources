    "flags": 0,
    "text": "\u4EA4\u7ED9\u6211\u4EEC\u5427"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u4EEC\u4F1A\u89E3\u51B3\u7684"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7279\u522B\u662F\u4F60\uFF0C\u8042\u6893\uFF01\\n\u4F60\u5728\u51B3\u8D5B\u4E2D\u2026\u2026\\c\\n\u53EF\u6CA1\u5C11\u8BA9\u6211\u5403\u82E6\u5934\u554A\uFF01\u6211\u7684\\n\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u90FD\u5DEE\u70B9\u8981\u675F\u624B\u65E0\u7B56\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD9\u6B21\u6211\u4EEC\u662F\u4E00\u4F19\u7684\u4E86\u3002\\n\u6211\u4EEC\u5206\u5934\u5E94\u6218\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u592A\u8D5E\u4E86\uFF01\u90A3\u6211\u4EEC\\n\u5C82\u4E0D\u662F\u6210\u4E86\u6700\u5F3A\u7684\u961F\u4F0D\uFF1F\uFF01[VAR 0114(0017)]"
