[
  {
    "index": 0,
    "flags": 0,
    "text": "\u53ED\u5477\uFF5E\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54C7\u2026\u2026\\n\u8FD9\u5B9D\u53EF\u68A6\u597D\u5927\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u80FD\u5728\u8FD9\u4E2A\u4E16\u754C\uFF0C\u548C\u8FD9\u4E48\u5927\u7684\u5B9D\u53EF\u68A6\\n\u5171\u540C\u751F\u6D3B\uFF0C\u771F\u7684\u662F\u592A\u597D\u4E86\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[~ 3]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5750\u4E0B\u4E4B\u540E\u53EF\u4EE5\u7AD9\u8D77\u6765\uFF0C\\n\u8F93\u4E86\u4E4B\u540E\u7EC8\u6709\u4E00\u5929\u4E5F\u80FD\u518D\u632F\u4F5C\u8D77\u6765\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9B54\u5899\u9B54\u5899\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4E39\u5E1D\u5B9E\u5728\u662F\u592A\u559C\u6B22\u5BF9\u6218\u4E86\uFF0C\\n\u5634\u89D2\u90FD\u5FCD\u4E0D\u4F4F\u4E0A\u626C\u4E86\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u53EF\u771F\u5389\u5BB3\u554A\uFF01\\n\u80FD\u5728\u4E16\u754C\u821E\u53F0\u4E0A\u8FDB\u884C\u5BF9\u6218\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6D1B\u5179\u5728\u4FDD\u7559\u57CE\u5E02\u98CE\u8C8C\u7684\u57FA\u7840\u4E0A\uFF0C\\n\u51DD\u805A\u4F01\u4E1A\u7684\u529B\u91CF\uFF0C\\r\\n\u628A\u8FD9\u5EA7\u57CE\u5E02\u6539\u9020\u6210\u4E86\u89C2\u5149\u80DC\u5730\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6D1B\u5179\u662F\u591A\u5C11\u4E2A\u516C\u53F8\u7684\u8001\u677F\u6765\u7740\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u9B54\u5899\u4EBA\u5076\u5C0F\u6770\uFF0C\\n\u4E5F\u592A\u5389\u5BB3\u4E86\u5427\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6240\u8C13\u652F\u6301\u8005\uFF0C\u5C31\u662F\u4F1A\u5BF9\u4EBA\\n\u5168\u5FC3\u5168\u610F\u4ED8\u51FA\u7684\u5927\u597D\u4EBA\u5417\uFF1F"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8EAB\u4E3A\u652F\u6301\u8005\uFF0C\\n\u5F53\u81EA\u5DF1\u652F\u6301\u7684\u8BAD\u7EC3\u5BB6\u8F93\u4E86\u6BD4\u8D5B\u65F6\uFF0C\\c\\n\u5C3D\u7BA1\u4E0D\u662F\u53D1\u751F\u5728\u81EA\u5DF1\u8EAB\u4E0A\uFF0C\\n\u5374\u4E5F\u5BF9\u90A3\u79CD\u6094\u6068\u611F\u540C\u8EAB\u53D7\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5728\u5B83\u8FD8\u662F\u5C0F\u706B\u9F99\u7684\u65F6\u5019\u5C31\u5F00\u59CB\u57F9\u517B\uFF0C\\n\u8FD9\u6837\u4F60\u4EEC\u4E4B\u95F4\u5C31\u4F1A\u6709\u6DF1\u539A\u7684\u611F\u60C5\u4E86\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4EBA\u5BB6\u8981\u5E26\u7740\u55B7\u706B\u9F99\\n\u53BB\u53C2\u52A0\u9053\u9986\u6311\u6218\u7684\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5582\u5582\uFF01\u6211\u4E70\u5230\u7ADE\u6280\u573A\u7684\u7968\u5566\uFF01\u5FEB\u6765\u5427\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5E73\u65F6\u88AB\u8FD9\u4E24\u4E2A\u5B69\u5B50\u800D\u5F97\u56E2\u56E2\u8F6C\uFF0C\\n\u8FD8\u8981\u540C\u65F6\u57F9\u80B2\uFF16\u53EA\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u8FD9\u5BF9\u6211\u6765\u8BF4\u6709\u70B9\u96BE\u554A\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u6765\u6A21\u4EFF\u5217\u9635\u5175\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6211\u4E5F\u6765\u6A21\u4EFF\u5217\u9635\u5175\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u554A\uFF0C\u4ECE\u4E39\u5E1D\u62A5\u540D\\n\u53C2\u52A0\u9053\u9986\u6311\u6218\u7684\u65F6\u4EE3\u5F00\u59CB\uFF0C\\r\\n\u5C31\u5DF2\u7ECF\u662F\u4ED6\u7684\u7C89\u4E1D\u4E86\uFF01"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u201C\u6211\u559C\u6B22\u4F60\u5F88\u4E45\u4E86\uFF01\u201D\\n\u201C\u6211\u4E00\u76F4\u90FD\u6709\u5173\u6CE8\u4F60\uFF01\u201D\u4E4B\u7C7B\u7684\u7C89\u4E1D\u5BA3\u8A00\uFF0C\\r\\n\u603B\u662F\u5DEE\u4E86\u70B9\u610F\u601D\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u521A\u521A\u62FF\u5230\u4E86\u739B\u4FD0\u7684\u7B7E\u540D\uFF01\\n\u53EF\u8981\u5F53\u6210\u5B9D\u8D1D\u597D\u597D\u73CD\u85CF\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8FD9\u6469\u5929\u8F6E\u5F88\u5927\u5427\u3002\\n\u5B83\u7684\u522B\u540D\u53EB\u505A\u4F3D\u52D2\u5C14\u5730\u72F1\u7FFB\u6EDA\u54DF\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u59D0\u59D0\u603B\u662F\u5439\u725B\uFF01"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6240\u8C13\u6865\uFF0C\u662F\u7528\u6765\u5C06\u4E24\u4E2A\\n\u76F8\u4E92\u5206\u79BB\u7684\u4E1C\u897F\u8FDE\u63A5\u5230\u4E00\u8D77\u7684\uFF0C\\r\\n\u4E5F\u662F\u4E00\u79CD\u53CB\u597D\u7684\u8C61\u5F81\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6BCF\u5F53\u770B\u8FC7\u4E00\u573A\u7CBE\u5F69\u7684\u6BD4\u8D5B\uFF0C\\n\u5C31\u4F1A\u611F\u89C9\u81EA\u5DF1\u7684\u8EAB\u4F53\u91CC\u5145\u6EE1\u4E86\u529B\u91CF\uFF01\\c\\n\u80FD\u8BA9\u6211\u4EEC\u770B\u5230\u5982\u6B64\u9AD8\u6C34\u5E73\u7684\u6BD4\u8D5B\uFF0C\\n\u771F\u7684\u662F\u592A\u4F69\u670D\u8FD9\u4E9B\u8BAD\u7EC3\u5BB6\u4E86\uFF01"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u65E0\u8BBA\u662F\u5728\u9152\u5E97\u5DE5\u4F5C\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u8FD8\u662F\u4E0A\u573A\u6BD4\u8D5B\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u90FD\u8BA9\u4EBA\u611F\u89C9\u671D\u6C14\u84EC\u52C3\u5462\u2026\u2026"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "[~ 31]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u53ED\u54BF\uFF01"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u662F\u5B9D\u53EF\u68A6\u628A\u6211\\n\u9001\u5230\u9152\u5E97\u6765\u7684\u5462\u3002"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u771F\u4E0D\u6127\u662F\u91CD\u6CE5\u633D\u9A6C\u5440\uFF01\\n\u9A6E\u7740\u597D\u591A\u4E2A\u4EBA\u8FD8\u5065\u6B65\u5982\u98DE\uFF01"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u5DE5\u4F5C\u53EF\u4EE5\u6362\uFF0C\u623F\u5B50\u53EF\u4EE5\u6362\uFF0C\\c\\n\u552F\u72EC\u6362\u4E0D\u4E86\u7684\uFF0C\\n\u662F\u81EA\u5DF1\u559C\u6B22\u7684\u9009\u624B\u548C\u5B9D\u53EF\u68A6\u554A\u3002"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u5361\u8482\u72D7\uFF01\u6211\u4EEC\u6765\u8D5B\u8DD1\u5427\uFF01\\n\u770B\u770B\u8C01\u5148\u8DD1\u5230\u7ADE\u6280\u573A\uFF1F"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u8FD9\u8981\u662F\u6362\u4E86\u5947\u5DF4\u7EB3\u4E0A\u573A\uFF0C\\n\u80AF\u5B9A\u4F1A\u5148\u53D1\u52A8\u6C99\u66B4\uFF01"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u7528\u901F\u5EA6\u5FEB\u7684\u5B9D\u53EF\u68A6\\n\u6253\u5012\u80FD\u6539\u53D8\u5929\u6C14\u7684\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u6C6A\uFF01"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "[~ 40]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u662F\u554A\uFF01\u6211\u7684\u5361\u8482\u72D7\u7626\u4E86\u597D\u591A\uFF01"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u53C2\u52A0\u5BAB\u95E8\u5E02\u7684\u73AF\u57CE\u9A6C\u62C9\u677E\uFF0C\\n\u80FD\u6D88\u8017\u7684\u70ED\u91CF\u53EF\u975E\u540C\u4E00\u822C\u554A\u3002"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u6E05\u626B\u662F\u4E3A\u4E86\\n\u4E86\u89E3\u82B1\u513F\u771F\u6B63\u7684\u7F8E\u3002"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u91CE\u9910\uFF01"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u4ECE\u6865\u4E0A\u8D70\u6765\u7684\u65F6\u5019\uFF0C\\n\u6EE1\u5FC3\u671F\u5F85\u7740\u6BD4\u8D5B\uFF0C\u8DC3\u8DC3\u6B32\u8BD5\u3002\\c\\n\u4ECE\u6865\u4E0A\u8D70\u56DE\u7684\u65F6\u5019\uFF0C\\n\u89C9\u5F97\u53D1\u6325\u5F97\u5F88\u597D\uFF0C\u5FC3\u6F6E\u6F8E\u6E43\u3002"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u6211\u4EEC\u666E\u901A\u89C2\u4F17\\n\u662F\u7528\u53CC\u817F\u8D70\u5230\u7ADE\u6280\u573A\u7684\u2026\u2026\\c\\n\u53EF\u662F\u9009\u624B\u4EEC\u662F\u4E00\u8DEF\u8FC7\u5173\u65A9\u5C06\\n\u624D\u62B5\u8FBE\u7ADE\u6280\u573A\u7684\u554A\u3002"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u5BAB\u95E8\u7ADE\u6280\u573A\\n\u662F\u6211\u5BB6\u7684\u51E0\u500D\u5927\u5440\uFF01\uFF1F"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u5728\u8D77\u5E8A\u4E4B\u524D\u4E0D\u4F1A\u77E5\u9053\u4ECA\u5929\u5929\u6C14\u5982\u4F55\uFF0C\\n\u5728\u6BD4\u8D5B\u7ED3\u675F\u4E4B\u524D\u4E5F\u4E0D\u4F1A\u77E5\u9053\u7ED3\u679C\u5982\u4F55\u3002"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u5168\u4E16\u754C\u7684\u4EBA\uFF0C\\n\u90FD\u5728\u6536\u770B\u540C\u4E00\u573A\u6BD4\u8D5B\u3002\\c\\n\u6240\u4EE5\u4E4B\u540E\u4E0E\u8C01\u90FD\u53EF\u4EE5\\n\u804A\u6709\u5173\u8FD9\u573A\u6BD4\u8D5B\u7684\u8BDD\u9898\u3002"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u9163\u7545\u6DCB\u6F13\u7684\u5927\u6218\uFF0C\\n\u4E00\u5B9A\u4F1A\u94ED\u523B\u5728\u6240\u6709\u4EBA\u7684\u8111\u6D77\u4E2D\uFF01"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u5173\u90FD\u4EBA\u548C\u4F3D\u52D2\u5C14\u4EBA\\n\u53EF\u771F\u80FD\u6392\u961F\u554A\u3002"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u51FA\u552E\u5B98\u65B9\u5468\u8FB9\u4E86\uFF5E\uFF01\\n\u8FD8\u6709\u8054\u76DF\u5361\u54E6\uFF5E\uFF01"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u6211\u5F88\u60F3\u8981\u7A00\u6709\u7684\u8054\u76DF\u5361\u2026\u2026\\n\u53EF\u60DC\u5DF2\u7ECF\u5356\u5B8C\u4E86\uFF01"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\u4ECA\u5929\u8FD9\u79CD\u5929\u6C14\\n\u6700\u9002\u5408\u6BD4\u8D5B\u4E86\uFF01\\c\\n\u867D\u7136\u4E0D\u7BA1\u4EC0\u4E48\u5929\u6C14\\n\u6211\u90FD\u4F1A\u8FD9\u4E48\u8BF4\u3002\\r\\n\u56E0\u4E3A\u53CD\u6B63\u7ADE\u6280\u573A\u6709\u5C4B\u9876\u5440\u3002"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u70B9\u5FC3\uFF01\u5B9D\u53EF\u68A6\u996E\u6599\uFF01\\n\u8981\u4E0D\u8981\u6765\u4E00\u4EFD\u5440\uFF1F"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\u521A\u624D\u660E\u660E\u8FD8\u4E0D\u89C9\u5F97\u6E34\uFF0C\\n\u4E00\u770B\u5230\u6709\u5356\u679C\u6C41\u7684\uFF0C\u7ACB\u523B\u5C31\u6E34\u4E86\u3002"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\u9009\u624B\u4EEC\u90FD\u592A\u4E0D\u5BB9\u6613\u4E86\u3002\\c\\n\u5728\u6570\u4E07\u7C89\u4E1D\u7684\u6CE8\u89C6\u4E0B\uFF0C\\n\u5C31\u7B97\u5931\u8BEF\u4E5F\u8981\u5FC3\u65E0\u65C1\u9A9B\u5730\u7EE7\u7EED\u6218\u6597\u2026\u2026\\r\\n\u8FD9\u9700\u8981\u975E\u5E38\u5F3A\u5927\u7684\u5FC3\u7406\u7D20\u8D28\u554A\u3002"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\u5927\u4EBA\u4EEC\u8BF4\uFF0C\u8981\u505A\u77E5\u8DB3\u5E38\u4E50\u7684\u4EBA\uFF0C\\n\u5E73\u5E73\u6DE1\u6DE1\u624D\u662F\u771F\u3002"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\u5728\u5916\u9762\u7684\u5E97\u91CC\u4E70\u4E1C\u897F\u5403\uFF0C\\n\u603B\u611F\u89C9\u6BD4\u5E73\u65F6\u66F4\u7F8E\u5473\u3002\\c\\n\u53EF\u80FD\u662F\u56E0\u4E3A\u591A\u4E86\u4E00\u4EFD\\n\u4E0E\u5F80\u5E38\u4E0D\u540C\u7684\u65B0\u9C9C\u611F\u5427\u3002"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\u8BA9\u4F60\u89C1\u8BC6\u89C1\u8BC6\\n\u5450\u558A\u961F\u7684\u96C6\u5927\u6210\u4E4B\u4F5C\u5427\uFF01"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\u6BD5\u7ADF\u6211\u4EEC\u81EA\u5DF1\u4E5F\u60F3\u770B\u6BD4\u8D5B\u554A\uFF0C\\n\u600E\u4E48\u53EF\u80FD\u4F1A\u6DFB\u4E71\u5462\uFF01"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "[~ 62]"
  },
  {
