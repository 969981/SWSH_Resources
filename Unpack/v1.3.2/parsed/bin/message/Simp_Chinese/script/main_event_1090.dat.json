[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6211\u662F\u4F1A\u957F\u63A8\u8350\u7684\u8BAD\u7EC3\u5BB6\uFF0C\\n\u8FDF\u65E9\u4F1A\u6218\u80DC\u51A0\u519B\u2026\u2026\\c\\n\u8EAB\u4E3A\u7CBE\u82F1\uFF0C\u6211\u80A9\u8D1F\u7740\u4F3D\u52D2\u5C14\u7684\u672A\u6765\uFF0C\\n\u5374\u5728\u9634\u6C9F\u91CC\u7FFB\u4E86\u8239\u2026\u2026\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5F7C\u7279\u9009\u624B\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u542C\u8BF4\u4F60\u8981\u501F\u7528\u6D1B\u5179\u4F1A\u957F\u7684\u5927\u738B\u94DC\u8C61\uFF0C\\n\u6B63\u60F3\u77E5\u9053\u8FD9\u662F\u600E\u4E48\u56DE\u4E8B\u2026\u2026\\c\\n\u771F\u6CA1\u6709\u6599\u5230\uFF0C\\n\u4F60\u7ADF\u7136\u662F\u4E3A\u4E86\u7834\u574F\u9057\u8FF9\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6BD4\u8D77\uFF11\uFF10\uFF10\uFF10\u5E74\u540E\u7684\u672A\u6765\uFF0C\\n\u533A\u533A\u4E00\u4E2A\u9057\u8FF9\u7B97\u5F97\u4E86\u4EC0\u4E48\uFF01\uFF1F\\c\\n\u51ED\u4F60\u8FD9\u79CD\u6BD4\u751C\u751C\u9999\u6C14\u8FD8\u8981\u751C\u5AE9\u7684\u60F3\u6CD5\uFF0C\\n\u771F\u7684\u80FD\u8F85\u4F50\u4F1A\u957F\u5417\uFF1F\\r\\n\u4F60\u8FD9\u4E2A\u79D8\u4E66\u662F\u600E\u4E48\u5F53\u7684\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5F7C\u7279\u3002[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u5F88\u5C11\u8FD9\u6837\u8BF4\u8BDD\u2026\u2026\\n\u4F46\u662F\u4F60\u592A\u8BA9\u6211\u5931\u671B\u4E86\u3002\\c\\n\u6CA1\u9519\uFF0C\u5728\u4F60\u8FD8\u5E74\u5E7C\u7684\u65F6\u5019\uFF0C\\n\u662F\u6211\u53D1\u6398\u4E86\u5B64\u72EC\u65E0\u52A9\u7684\u4F60\u3002[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4E3A\u4E86\u62D3\u5C55\u4F60\u7684\u624D\u80FD\uFF0C\\n\u6211\u8FD8\u8D44\u52A9\u4F60\u4E0A\u4E86\u8BAD\u7EC3\u5BB6\u5B66\u6821\u3002\\c\\n\u6B63\u56E0\u4E3A\u4F60\u8BA9\u6211\u60F3\u8D77\u4E86\u4ECE\u524D\u7684\u81EA\u5DF1\uFF0C\\n\u6211\u624D\u7ED9\u4E86\u4F60\u8FD9\u6B21\u673A\u4F1A\u554A\u3002[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F46\u662F\u4F60\u5BF9\u4F3D\u52D2\u5C14\u6CA1\u6709\u4EFB\u4F55\u611F\u60C5\uFF0C\\n\u53CD\u800C\u505A\u51FA\u7834\u574F\u9057\u8FF9\u8FD9\u79CD\u4E8B\u2026\u2026\\c\\n\u50CF\u4F60\u8FD9\u6837\u7684\u9009\u624B\\n\u6CA1\u6709\u8D44\u683C\u53C2\u52A0\u9053\u9986\u6311\u6218\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u4EEC\u4F1A\u51B3\u5B9A\u8BE5\u600E\u4E48\u5904\u5206\u4F60\u7684\uFF0C\\n\u4F60\u5148\u56DE\u62F3\u5173\u5E02\u53BB\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u60A8\u5728\u2026\u2026\u5F00\u73A9\u7B11\u5427\uFF1F\\c\\n\u5982\u679C\u6211\u5931\u53BB\u4E86\u6311\u6218\u7684\u8D44\u683C\uFF0C\\n\u5C31\u7B49\u4E8E\u662F\u60A8\u9009\u4EBA\u7684\u773C\u5149\u6709\u95EE\u9898\u554A\uFF01\\c\\n\u773C\u524D\u6709\uFF11\uFF10\uFF10\u79CD\u9009\u62E9\uFF0C\\n\u53EF\u60A8\u504F\u504F\u9009\u4E86\u6700\u5DEE\u7684\u4E00\u4E2A\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5F7C\u7279\u9009\u624B\uFF0C\\n\u4F60\u6536\u96C6\u5230\u7684\u8BB8\u613F\u661F\\r\\n\u5C31\u7531\u6211\u6765\u4FDD\u7BA1\u4E86\u3002[VAR 0114(0007)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\u3001[VAR 0100(0000)]\uFF0C\\n\u5F88\u62B1\u6B49\u8BA9\u4F60\u4EEC\u5377\u5165\u4E86\u8FD9\u573A\u95F9\u5267\u3002\\c\\n\u867D\u7136\u4EE5\u8FD9\u79CD\u5F62\u5F0F\u5265\u593A\u6311\u6218\u8005\u7684\\n\u53C2\u8D5B\u8D44\u683C\u8BA9\u4EBA\u611F\u5230\u975E\u5E38\u9057\u61BE\uFF0C\\r\\n\u4F46\u662F\u6BD4\u8D5B\u5FC5\u987B\u8981\u516C\u5E73\u516C\u6B63\u554A\u3002[VAR 0114(0006)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E4B\u524D\u5728\u5F7C\u7279\u9009\u624B\u7684\u6BD4\u8D5B\u4E2D\uFF0C\\n\u5B9E\u51B5\u89E3\u8BF4\u66FE\u7ECF\u63D0\u5230\u2026\u2026\\c\\n\u5F7C\u7279\u5BF9\u6218\u7684\u76EE\u7684\u662F\u4E3A\u4E86\u62A5\u7B54\u4F1A\u957F\u3002\\n\u56E0\u4E3A\u4F1A\u957F\u6536\u7559\u4E86\u65E0\u4F9D\u65E0\u9760\u7684\u4ED6\u3002[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u54CE\u2026\u2026\\n\u9057\u8FF9\u6CA1\u4E8B\u5427\uFF1F[VAR 0114(000B)]"
  }
]
