[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5728\u6B66\u9986\u65F6\uFF0C\u4F60\u7B80\u76F4\u5C31\u662F\\n\u6211\u7684\u773C\u4E2D\u9489\u3002\\c\\n\u4F46\u73B0\u5728\u80FD\u548C\u4F60\u4E00\u8D77\u593A\u9B41\uFF0C\\n\u8BA9\u6211\u89C9\u5F97\u975E\u5E38\u9A84\u50B2\u54E6\u3002[VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u53EA\u8981\u8BA9\u4F60\u7684\u5B9E\u529B\\n\u548C\u6211\u7684\u8D85\u80FD\u529B\u76F8\u7ED3\u5408\uFF0C\\c\\n\u90A3\u4E48\u5176\u4ED6\u4EBA\u8981\u6218\u80DC\u6211\u4EEC\uFF0C\\n\u5C31\u662F\u7EDD\uFF5E\u4E0D\u53EF\u80FD\u7684\u4E86\u3002[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u554A\u54C8\uFF01\u4E00\u5F00\u59CB\\n\u6211\u786E\u5B9E\u4E0D\u5927\u63A5\u53D7\u4F60\uFF5E\uFF01\\c\\n\u4F46\u662F\u73B0\u5728\uFF0C\u6211\u597D\u9AD8\u5174\\n\u6211\u4EEC\u80FD\u4E00\u8D77\u593A\u51A0\u54E6\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u597D\u554A\uFF01\u53C8\u8D62\u4E86\uFF5E\uFF01\\n\u6211\u771F\u662F\u8D85\u5F00\u5FC3\u554A\uFF01\\c\\n\u7ADE\u6280\u573A\u7684\u6240\uFF5E\u6709\u89C2\u4F17\uFF01\\n\u4F60\u4EEC\u7EDD\u5BF9\u7EDD\uFF5E\u5BF9\\r\\n\u5BF9\u6211\u4EEC\u4E2D\u6BD2\u4E86\u54E6\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8036\uFF5E\uFF01[VAR 0100(0000)]\uFF01\\n\u6211\u4EEC\u8D62\u565C\uFF01\\c\\n\u4EAB\u53D7\u4EBA\u751F\uFF0C\u5C31\u80FD\u593A\u51A0\uFF01\\n\u6240\u5230\u4E4B\u5904\uFF0C\u65E0\u4EBA\u80FD\u654C\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E0D\u7BA1\u7ECF\u5386\u591A\u5C11\u6B21\uFF0C\\n\u593A\u51A0\u90FD\u8BA9\u4EBA\u611F\u5230\u5F00\u5FC3\u554A\uFF5E\\c\\n\u591A\u8D62\u4E2A\u51E0\u6B21\uFF0C\\n\u8BF4\u4E0D\u5B9A\u8FD8\u80FD\u589E\u52A0\u5F92\u5F1F\u5537\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FD9\u771F\u662F\u76AE\u6B27\u5C3C\u63A2\u9669\u961F\u7684\\n\u5927\u3001\u5927\u3001\u5927\uFF5E\u80DC\u5229\u554A\uFF01\\c\\n\u80FD\u7528\u51FA\u8FD9\u4E48\u5F3A\u7684\u62DB\u5F0F\uFF0C\\n\u53EF\u771F\u662F\u592A\u723D\u5566\uFF01\u961F\u957F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54E6\uFF01\u53C8\u8D62\u4E86\u554A\uFF01\\c\\n\u53EA\u8981\u6211\u548C\u961F\u957F\u8054\u624B\uFF0C\\n\u5C31\u662F\u90A3\u4E2A\u5566\uFF01\u5389\u5BB3\u5230\u7206\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\u8C22\u8C22\u4F60\uFF01\\n\u6211\u4EEC\u7528\u70BD\u70ED\u7684\u5BF9\u6218\u70B9\u71C3\u4E86\u4F1A\u573A\u554A\uFF01\\c\\n\u6211\u5F88\u8363\u5E78\\n\u80FD\u548C\u4F60\u4E00\u8D77\u593A\u51A0\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\u4F60\u679C\u7136\u5389\u5BB3\uFF01\\c\\n\u770B\u7740\u4F60\u6BCF\u6B21\u5BF9\u6218\u90FD\u80FD\u53D8\u5F3A\uFF0C\\n\u603B\u662F\u4F1A\u7ED9\u6211\u5F88\u597D\u7684\u523A\u6FC0\uFF01\\c\\n\u8BA9\u6211\u4EEC\u4E0E\u4F3D\u52D2\u5C14\u5730\u533A\u6240\u6709\u8BAD\u7EC3\u5BB6\uFF0C\\n\u4E00\u8D77\u8FC8\u5411\u66F4\u5F3A\u5927\u7684\u5883\u754C\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u867D\u7136\u548C\u4F60\u4E00\u8D77\u593A\u51A0\u8FD9\u4EF6\u4E8B\\n\u8BA9\u6211\u4E0D\u662F\u5F88\u6EE1\u610F\uFF0C\\r\\n\u4F46\u593A\u51A0\u5C31\u662F\u593A\u51A0\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u54CE\uFF0C\u65E2\u7136\u9009\u6211\u5F53\u642D\u6863\uFF0C\\n\u90A3\u8FD9\u4E2A\u7ED3\u679C\u4E5F\u662F\u7406\u6240\u5F53\u7136\u7684\u3002\\r\\n\u4E0D\u8FC7\u6211\u8FD8\u662F\u606D\u559C\u4F60\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\u592A\u68D2\u4E86\uFF01\\n\u739B\u4FD0\u548C\u4F60\u4E00\u8D77\u593A\u51A0\u4E86\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u592A\u68D2\u4E86\uFF01\u60F3\u8D62\u51E0\u6B21\u5C31\u8D62\u51E0\u6B21\uFF01\\n\u6BD5\u7ADF\u6211\u4EEC\u662F\u6700\u5F3A\u7684\u7EC4\u5408\uFF0C\\r\\n\u8FD9\u662F\u6BEB\u65E0\u7591\u95EE\u7684\u554A\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u4F60\u679C\u7136\u5389\u5BB3\uFF01\\n\u6211\u4EEC\u62FF\u4E0B\u7B2C\u4E00\u540D\uFF0C\\r\\n\u8FDE\u8349\u5B9D\u53EF\u68A6\u4EEC\u4E5F\u5F88\u9AD8\u5174\u5462\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u592A\u68D2\u4E86\uFF0C[VAR 0100(0000)]\uFF01\\n\u771F\u4E0D\u6127\u662F\u51A0\u519B\u554A\u3002\\c\\n\u6709\u4F60\u5728\u6211\u7684\u65C1\u8FB9\uFF0C\\n\u603B\u4F1A\u8BA9\u6211\u89C9\u5F97\u642D\u6863\u5F88\u53EF\u9760\u554A\u3002[VAR 0114(000E)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5C06\u4E00\u5207\u90FD\u51B2\u8D70\u4E4B\u540E\uFF0C\\n\u5269\u4E0B\u7684\u5C31\u662F\u6211\u4EEC\u2026\u2026\\c\\n[VAR 0100(0000)]\uFF0C\u606D\u559C\u593A\u51A0\uFF01\\n\u53E6\u5916\uFF0C\u4E5F\u8C22\u8C22\u4F60\u3002[VAR 0114(000F)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4E0D\u7BA1\u6765\u51E0\u6B21\uFF0C\\n\u6211\u90FD\u662F\u90A3\u60CA\u6D9B\u9A87\u6D6A\uFF01\\c\\n\u770B\u6765\u6211\u53EA\u8981\u548C\u4F60\u642D\u6863\uFF0C\\n\u5C31\u6CA1\u6709\u9A7E\u9A6D\u4E0D\u4E86\u7684\u5927\u6D6A\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u8F9B\u82E6\u4F60\u4E86\uFF01\\n\u8FD9\u662F\u6211\u4EEC\u4E24\u4E2A\u4E00\u8D77\u62FF\u4E0B\u7684\u80DC\u5229\u554A\uFF01\\c\\n\u6211\u9AD8\u5174\u5F97\u90FD\u5FEB\u71C3\u70E7\u6B86\u5C3D\u4E86\uFF0C\\n\u4E0D\u8FC7\uFF0C\u4E0B\u6B21\u6BD4\u8D5B\u4E5F\u8981\u52A0\u6CB9\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u8FD9\u6B21\u7684\u5BF9\u6218\u4E5F\u5F88\u70BD\u70ED\uFF0C\\n\u8BA9\u6211\u5B8C\u5168\u71C3\u70E7\u8D77\u6765\u4E86\uFF01\\c\\n[VAR 0100(0000)]\uFF01\\n\u8C22\u8C22\u4F60\u4E0D\u6B62\u4E00\u6B21\u548C\u6211\u7EC4\u961F\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5F88\u9AD8\u5174\u80FD\u548C\u4F60\u4E00\u8D77\u62FF\u4E0B\u80DC\u5229\u3002\\n\u600E\u4E48\u6CA1\u4EBA\u5B89\u53EF\u5462\uFF1F\\c\\n\u8FD9\u6B21\u8981\u662F\u6709\u4EBA\u5B89\u53EF\u7684\u8BDD\uFF0C\\n\u6211\u5012\u662F\u53EF\u4EE5\u7834\u4F8B\u518D\u8868\u6F14\u4E00\u4E0B\u5594\u3002[VAR 0114(0016)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u4EEC\u53C8\u8D62\u4E86\u554A\u3002\\n\u8FD9\u7684\u786E\u8BA9\u6211\u5F88\u9AD8\u5174\u2026\u2026\\c\\n\u4E0D\u8FC7\u6211\u65E2\u7136\u5DF2\u7ECF\u4E0D\u662F\u9053\u9986\u9986\u4E3B\u4E86\uFF0C\\n\u8D62\u5F97\u592A\u591A\u597D\u50CF\u4E5F\u4E0D\u662F\u4EF6\u597D\u4E8B\u554A\u3002[VAR 0114(0016)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u8FD9\u662F\u4E0D\u8FB1\u6700\u5F3A\u4E4B\u540D\u7684\\n\u6700\u5F3A\u593A\u51A0\uFF0C\u662F\u5427\uFF01\\c\\n\u597D\uFF01\u6211\u4EEC\u6765\u5F20\u6700\u5F3A\u7684\u81EA\u62CD\u5427\uFF01\\n\u7B11\u4E00\u4E2A\u554A\uFF0C[VAR 0100(0000)]\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6700\u5F3A\u7EC4\u5408\u662F\u6218\u65E0\u4E0D\u80DC\u7684\uFF01\\n\u8981\u662F\u80FD\u5343\u53E4\u7559\u540D\uFF0C\u90A3\u5C31\u4E0D\u5F97\u4E86\u54AF\uFF01\\c\\n\u8FD9\u6B21\u4E5F\u6765\u62CD\u5F20\u593A\u51A0\u7EAA\u5FF5\u7167\u5427\u3002\\n\u6765\uFF01\u7B11\u4E00\u4E2A\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6210\u529F\u4E86\u2026\u2026\\n\u6211\u4EEC\u8D62\u4E86\uFF01\\c\\n\u80FD\u548C\u4F60\u4E00\u8D77\u594B\u6597\uFF0C\\n\u8BA9\u6211\u611F\u5230\u5F88\u5174\u594B\u3002[VAR 0114(0011)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6210\u529F\u4E86\uFF0C[VAR 0100(0000)]\uFF01\\c\\n\u6211\u4EEC\u7684\u9ED8\u5951\\n\u6BD4\u4EE5\u524D\u66F4\u597D\u4E86\u5462\u3002\\c\\n\u5982\u679C\u4F60\u613F\u610F\u7684\u8BDD\uFF0C\\n\u6211\u4EEC\u518D\u627E\u673A\u4F1A\u642D\u6863\u5427\u3002[VAR 0114(0011)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8FD9\u53EF\u771F\u662F\u4E00\u5C4A\\n\u8BA9\u4EBA\u5C3D\u5174\u7684\u5927\u8D5B\u3002\\c\\n[VAR 0100(0000)]\uFF0C\\n\u80FD\u914D\u5F97\u4E0A\u548C\u6211\u642D\u6863\u7684\uFF0C\\r\\n\u6B63\u662F\u50CF\u4F60\u8FD9\u6837\u5BF9\u6218\u7684\u4EBA\u554A\u3002[VAR 0114(0014)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u4EE5\u6211\u4EEC\u7684\u5B9E\u529B\uFF0C\\n\u8FD9\u6CA1\u4EC0\u4E48\u597D\u60CA\u8BB6\u7684\u3002\\c\\n\u53EA\u8981\u4F60\u5F00\u53E3\uFF0C\u8981\u6211\u966A\u4F60\\n\u593A\u51A0\u591A\u5C11\u6B21\u90FD\u6CA1\u95EE\u9898\u3002[VAR 0114(0014)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u6211\u3001\u6211\u4EEC\u593A\u51A0\u4E86\u2026\u2026\uFF01\\r\\n\u592A\u3001\u592A\u68D2\u4E86\u2026\u2026\uFF01[VAR 0114(0012)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6211\u3001\u6211\u5F88\u9AD8\u5174\u2026\u2026\\n\u80FD\u8FD9\u6837\u548C[VAR 0100(0000)]\u4E00\u8D77\u2026\u2026\\r\\n\u4E00\u6B21\u53C8\u4E00\u6B21\u5730\u593A\u51A0\u2026\u2026\u563B\u563B\uFF01[VAR 0114(0012)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6211\u4EEC\u5F7C\u6B64\u8F9B\u82E6\u4E86\u554A\uFF01\\n\u8FD9\u662F\u4E24\u4E2A\u4EBA\u7684\u52AA\u529B\u5E26\u6765\u7684\u80DC\u5229\uFF01\\c\\n\u4E0B\u6B21\u78B0\u9762\u6211\u4EEC\u53EF\u80FD\u5C31\u662F\u5BF9\u624B\u4E86\uFF0C\\n\u5230\u65F6\u6211\u53EF\u4E0D\u4F1A\u624B\u4E0B\u7559\u60C5\u7684\u54E6\u3002[VAR 0114(0015)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u5475\u5475\uFF01\u6211\u4EEC\u53C8\u593A\u51A0\u4E86\u554A\u3002\\c\\n\u518D\u8FD9\u6837\u4E0B\u53BB\uFF0C\u4F60\u6BCF\u573A\u6BD4\u8D5B\\n\u90FD\u4F1A\u5FCD\u4E0D\u4F4F\u8981\u548C\u7F8E\u84C9\u7EC4\u961F\u4E86\u5427\uFF1F[VAR 0114(0015)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u80FD\u4E0E\u6211\u7D22\u5FB7\u643A\u624B\u593A\u51A0\uFF0C\\n\u4F60\u679C\u7136\u6CA1\u6709\u8F9C\u8D1F\u6211\u7684\u671F\u5F85\uFF01\\c\\n\u867D\u7136\u8FD9\u6837\u4F1A\u5BF9\u4E0D\u8D77\u8D24\u5F1F\uFF0C\\n\u4F46\u6211\u8981\u5C3D\u60C5\u6C89\u6D78\u5728\u80DC\u5229\u5F53\u4E2D\uFF0C\\r\\n\u8BA9\u8FD9\u4EFD\u559C\u60A6\u8D2F\u7A7F\u5230\u6211\u7684\u5934\u9876\uFF01[VAR 0114(0068)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u54CE\uFF5E\u5440\uFF01\u54CE\u5440\u54CE\uFF5E\u5440\uFF01\\n\u6211\u7EC8\u4E8E\u770B\u51FA\u6765\u4E86\uFF01\\c\\n[VAR 0100(0000)]\u5927\u4EBA\u4E0D\u6B62\u4E00\u6B21\u5730\\n\u4E0E\u6211\u7D22\u5FB7\u643A\u624B\u593A\u51A0\uFF01\\c\\n\u8BF4\u660E\u6211\u5728\u4F60\u5FC3\u76EE\u4E2D\u7684\u5730\u4F4D\u5F88\u9AD8\u554A\uFF01[VAR 0114(0068)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u80FD\u4E0E\u6211\u897F\u5C14\u8FEA\u643A\u624B\u593A\u51A0\uFF0C\\n\u8FD9\u53EF\u771F\u662F\u592A\u68D2\u4E86\uFF5E\uFF01\\c\\n\u6211\u8981\u5728\u6B64\u5C06\u4E16\u754C\u540D\u6D41\u5956\\n\u6388\u4E88[VAR 0100(0000)]\u5927\uFF5E\u4EBA\uFF01[VAR 0114(0069)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u613F\u610F\u4E0D\u6B62\u4E00\u6B21\u5730\\n\u4E0E\u6211\u897F\u5C14\u8FEA\u643A\u624B\u593A\u51A0\u2026\u2026\\c\\n\u83AB\u975E\u6211\u5728[VAR 0100(0000)]\u5927\u4EBA\\n\u5FC3\u76EE\u4E2D\u7684\u5730\u4F4D\u4E5F\u662F\u540D\u6D41\u7EA7\u7684\uFF1F\\c\\n\u867D\u7136\u8FD9\u6837\u4F1A\u5BF9\u4E0D\u8D77\u5144\u957F\uFF0C\\n\u4F46\u8FD9\u4EFD\u8363\u8A89\uFF01\u6211\u8981\u72EC\u541E\u4E86\uFF01[VAR 0114(0069)]"
  },
  {
