[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54EA\u6015\u8FD9\u4E2A\u5C0F\u9547\u65E0\u6BD4\u8427\u6761\uFF0C\\n\u5BF9\u4E8E\u4F4F\u5728\u8FD9\u7684\u4EBA\u548C\u5B9D\u53EF\u68A6\u6765\u8BF4\u4F9D\u65E7\u5F88\u91CD\u8981\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u662F\u4E0D\u4F1A\u9000\u51FA\u5450\u558A\u961F\u7684\uFF01\\n\u5C06\u6765\u8FD8\u8981\u7EE7\u7EED\u652F\u6301\u739B\u4FD0\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u56E0\u4E3A\u6211\u662F\u8042\u6893\u7684\u7C89\u4E1D\uFF0C\\n\u6240\u4EE5\u5E0C\u671B\u4ECA\u540E\u80FD\u770B\u5230\u4ED6\u66F4\u591A\u7684\u6BD4\u8D5B\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0D\u7BA1\u600E\u4E48\u8BF4\uFF0C\u6709\u9053\u9986\u6311\u6218\u8005\u53C2\u8D5B\\n\u786E\u5B9E\u80FD\u8BA9\u9547\u4E0A\u7684\u6C14\u6C1B\u70ED\u95F9\u4E00\u4E9B\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8042\u6893\u4ED6\u554A\uFF0C\\n\u662F\u4E0D\u4F1A\u8BA9\u5B9D\u53EF\u68A6\u6781\u5DE8\u5316\u7684\uFF01\\c\\n\u4E0D\u8FC7\u4F1A\u957F\u4ED6\u66FE\u7ECF\\n\u60F3\u8981\u628A\u6574\u4E2A\u5C0F\u9547\u642C\u5230\\r\\n\u7A0D\u5FAE\u6709\u70B9\u8DDD\u79BB\u7684\u80FD\u91CF\u70B9\u9644\u8FD1\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E3A\u4E86\u963B\u6320\u6311\u6218\u8005\\n\u800C\u628A\u5377\u5E18\u95E8\u653E\u4E0B\uFF0C\\r\\n\u771F\u662F\u7F3A\u4E4F\u4F53\u80B2\u7CBE\u795E\u7684\u884C\u5F84\u554A\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9053\u9986\u8BAD\u7EC3\u5BB6\u59D1\u4E14\u4E0D\u8BF4\uFF0C\\n\u8981\u662F\u5B9D\u53EF\u68A6\u4E0D\u966A\u6211\u4E00\u8D77\u52AA\u529B\u53EF\u4E0D\u884C\u554A\u3002\\r\\n\u4F60\u4EEC\u90FD\u8F9B\u82E6\u4E86\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u563B\u563B\u563B\uFF5E\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5495\u6728\u5495\u6728\u3002"
  },
