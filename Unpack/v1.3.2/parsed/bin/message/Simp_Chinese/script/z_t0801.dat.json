    "text": "[~ 11]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8042\u6893\uFF01\\n\u4E0A\u5440\uFF01\u52A0\u6CB9\uFF01\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\uFF0C\\n\u4F60\u53EF\u771F\u591F\u5389\u5BB3\u7684\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F\u8042\u6893\u554A\uFF0C\\n\u592A\u5E05\u4E86\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u54E6\uFF0C\\n\u73B0\u5728\u662F\u739B\u4FD0\u7684\u65F6\u4EE3\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u8FD9\u5BB6\u4F19\u771F\u5389\u5BB3\u554A\uFF01\\n\u7ADF\u7136\u6253\u8D25\u4E86\u8042\u6893\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4EE5\u540E\u4E5F\u60F3\\n\u7EE7\u7EED\u4E3A\u4F60\u52A0\u6CB9\u554A\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\u4E00\u6765\uFF0C\\n\u5C31\u70ED\u95F9\u591A\u4E86\u5440\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u53EF\u559C\u6B22\u4EE5\u524D\u7684\\n\u8042\u6893\u9986\u4E3B\u4E86\u561B\u3002"
