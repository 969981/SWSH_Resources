[
  {
    "index": 0,
    "flags": 0,
    "text": "\u62F3\u5173\u5E02\u2026\u2026\u8FD8\u662F\u8001\u6837\u5B50\uFF0C\\n\u603B\u662F\u5C18\u571F\u98DE\u626C\u7684\u554A\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u6709\u7684\u5B9D\u53EF\u68A6\\n\u8FD8\u5C31\u559C\u6B22\u8FD9\u6837\u7684\u5730\u65B9\u3002[VAR 0114(0013)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u4EEC\u8FD8\u771F\u662F\u6709\u7F18\uFF0C\\n\u624D\u521A\u5206\u5F00\u5C31\u53C8\u89C1\u9762\u4E86\u554A\u3002[VAR 0114(0013)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u54A6\uFF1F\u90A3\u5B69\u5B50\u2026\u2026[VAR 0114(0013)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6B63\u662F\u6211\u4E2D\u610F\u7684\u7C89\u7EA2\u8272\u554A\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u7684\u6311\u6218\u8005\u8155\u5E26\u4E5F\u88AB\u6CA1\u6536\u4E86\uFF0C\\n\u9053\u9986\u6311\u6218\u8005\u7684\u8D44\u683C\u4E5F\u4E27\u5931\u4E86\u3002\\r\\n\u4E8B\u5230\u5982\u4ECA\uFF0C\u4F60\u5C45\u7136\u8FD8\u4F1A\u6765\u770B\u6211\u2026\u2026\\r\\n\u4F60\u6709\u90A3\u4E48\u591A\u95F2\u5DE5\u592B\u5417\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6709\u554A"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u561B\u2026\u2026"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54CE\uFF0C\u4E5F\u6CA1\u4EC0\u4E48\u597D\u5947\u602A\u7684\u3002\\n\u6BD5\u7ADF\uFF0C\u4F60\u5C11\u4E86\u6211\u8FD9\u4E2A\u5F3A\u654C\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u771F\u662F\u4E2A\u6A21\u68F1\u4E24\u53EF\u7684\u56DE\u7B54\u3002\\n\u679C\u7136\u5B9E\u529B\u548C\u6001\u5EA6\u662F\u6210\u6B63\u6BD4\u7684\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF01\\c\\n\u6211\u662F\u4E0D\u4F1A\u653E\u5F03\u7684\uFF01\\c\\n\u4E3A\u4E86\u4F1A\u957F\uFF0C\u6211\u4E00\u5B9A\u8981\u6210\u4E3A\u51A0\u519B\uFF01\\n\u6240\u4EE5\u6211\u4F1A\u62DC\u6258\u4ED6\uFF0C\\r\\n\u518D\u7ED9\u6211\u4E00\u6B21\u53C2\u52A0\u9053\u9986\u6311\u6218\u7684\u673A\u4F1A\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u53C8\u7387\u771F\uFF0C\u53C8\u4E56\u50FB\u2026\u2026\\n\u4E0D\u9519\u4E0D\u9519\u2026\u2026\u505A\u4EBA\u5C31\u8BE5\u8FD9\u6837\uFF0C\\r\\n\u5426\u5219\u96BE\u6210\u5927\u5668\u554A\u3002[VAR 0114(0013)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5373\u4F7F\u4F60\u4E0D\u662F\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u6211\u4E5F\u4F1A\u7ED9\u4F60\u5F00\u4E00\u4E2A\u7279\u4F8B\uFF0C\\r\\n\u5141\u8BB8\u4F60\u53C2\u52A0\u6211\u7684\u9053\u9986\u4EFB\u52A1\u3002\\c\\n\u613F\u4E0D\u613F\u610F\uFF0C\u53EF\u5C31\u7531\u4E0D\u5F97\u4F60\u54AF\u3002[VAR 0114(0013)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6765\uFF0C\u6311\u6218\u9053\u9986\u4EFB\u52A1\u5427\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u54CE\uFF1F\u54CE\uFF01\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u7C89\u7EA2\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u7C89\u7EA2\uFF01\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u7C89\u7EA2\uFF01\uFF01\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u606D\u559C\u4F60\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u591F\u7C89\u7EA2\u554A\u3002[VAR 0114(0013)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4F60\u3001\u4F60\u662F\u6CE2\u666E\u83C8\uFF01\uFF1F\\n\u5413\u4E86\u6211\u4E00\u8DF3\uFF0C\u4F60\u8FD9\u662F\u5728\u505A\u4EC0\u4E48\u554A\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4F60\u88AB\u90A3\u4E2A\u5965\u5229\u8587\u4EFB\u610F\u6446\u5E03\uFF0C\\n\u62FC\u4E86\u547D\u6536\u96C6\u8BB8\u613F\u661F\uFF0C\\r\\n\u6700\u540E\u5374\u88AB\u8FC7\u6CB3\u62C6\u6865\uFF0C\\r\\n\u73B0\u5728\u4F60\u8D70\u6295\u65E0\u8DEF\u4E86\u5427\uFF1F[VAR 0114(0013)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u8DDF\u6211\u6765\u5427\u3002\\n\u6211\u5012\u662F\u53EF\u4EE5\u4E3A\u4F60\u627E\u4E00\u6761\u51FA\u8DEF\u3002\\c\\n\u5F53\u7136\uFF0C\u6700\u540E\u8FD8\u662F\u8981\u770B\\n\u4F60\u80AF\u4E0D\u80AF\u52AA\u529B\u5C31\u662F\u4E86\u3002[VAR 0114(0013)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4F60\u662F\u8981\u8003\u9A8C\u6211\u5417\uFF1F\\c\\n\u597D\uFF0C\u6211\u63A5\u53D7\uFF01\u4E0D\u4EC5\u5982\u6B64\uFF0C\\n\u6211\u8FD8\u8981\u8BA9\u4F60\u5BF9\u6211\u522E\u76EE\u76F8\u770B\uFF0C\\r\\n\u544A\u8BC9\u6211\u66F4\u591A\u8BB8\u613F\u661F\u7684\u4E8B\u60C5\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u4F60\u4E5F\u8BE5\u8D70\u4E86\uFF0C\u5FEB\u53BB\u6218\u7ADE\u9547\u5427\u3002\\n\u8D70\uFF17\u53F7\u9053\u8DEF\u5C31\u5BF9\u4E86\uFF0C\u6CA1\u95EE\u9898\u5427\uFF1F[VAR 0114(0013)]"
  }
