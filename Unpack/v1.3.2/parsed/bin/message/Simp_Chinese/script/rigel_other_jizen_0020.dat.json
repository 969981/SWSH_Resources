  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5475\uFF0C\u6709\u5446\u5446\u517D\u524D\u6765\u8FCE\u63A5\u2026\u2026\\n\u8FD9\u53EF\u771F\u662F\u4F18\u96C5\u3002[VAR 0114(0042)]"
