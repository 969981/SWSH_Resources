  {
    "index": 16,
    "flags": 0,
    "text": "\u739B\u4FD0\u8981\u4E0D\u8981\u7D27\u554A\u2026\u2026\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u5C16\u9489\u9547\u597D\u50CF\u6CA1\u4E8B\u54E6\u3002\\c\\n\u73B0\u5728\u6211\u89C2\u6D4B\u5230\u80FD\u91CF\u53CD\u5E94\u7684\u53EA\u6709\\n\u6C34\u821F\u7ADE\u6280\u573A\u548C\u673A\u64CE\u7ADE\u6280\u573A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u2026\u2026\u662F\u8FD9\u6837\u554A\u3002[VAR 0114(0016)]"
