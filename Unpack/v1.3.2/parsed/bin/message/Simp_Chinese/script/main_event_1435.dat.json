    "text": "\u5F88\u62B1\u6B49\u53EB\u4F4F\u4F60\u3002\\n\u6709\u4EF6\u4E8B\u6211\u5DEE\u70B9\u5FD8\u4E86\u3002[VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u9996\u5148\uFF0C\u4E3A\u4E86\u8868\u793A\u6211\u5BF9\u4F60\u7684\u656C\u610F\uFF0C\\n\u8BF7\u6536\u4E0B\u8FD9\u4E2A\u62DB\u5F0F\u5B66\u4E60\u5668\uFF19\uFF19\u201C\u5E7F\u57DF\u7834\u574F\u201D\u3002[VAR 0114(0017)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\u2026\u2026\u6536\u4E0B\u8FD9\u5957\\n\u8C61\u5F81\u5F3A\u8005\u7684\u9F99\u5C5E\u6027\u7ADE\u6280\u670D\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u80CC\u53F7[VAR 01C4(0001)]\u53F7\u7684\u9009\u624B\\n[VAR 0100(0000)]\uFF01\\r\\n\u606D\u559C\u4F60\u5B8C\u6210\u4E86\u9053\u9986\u6311\u6218\uFF01\\c\\n\u63A5\u4E0B\u6765\uFF0C\u5C31\u5230\u51A0\u519B\u676F\u5C55\u73B0\u4F60\u7684\u5B9E\u529B\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5947\u5DF4\u7EB3\uFF01\\n\u8BA9\u6211\u9886\u6559\u4E00\u4E0B\u4F60\u7684\u5B9E\u529B\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4E39\u5E1D\u7684\u5F1F\u5F1F\uFF01\\n\u4F60\u5C0F\u5B50\u6765\u5F97\u597D\u554A\uFF01\\c\\n\u90A3\u6211\u5C31\u7528\u4E25\u9177\u5230\u8BA9\u4F60\\n\u6068\u4E0D\u5F97\u653E\u5F03\u9053\u9986\u6311\u6218\u7684\u6218\u6CD5\uFF0C\\r\\n\u6765\u6559\u6559\u4F60\u4EC0\u4E48\u53EB\u505A\u5B9D\u53EF\u68A6\u5BF9\u6218\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5728\u505A\u8FC7\u5F88\u591A\u5C1D\u8BD5\u540E\uFF0C\\n\u6211\u7EC8\u4E8E\u627E\u5230\u4E86\u9002\u5408\u81EA\u5DF1\u7684\u5BF9\u6218\u65B9\u5F0F\uFF01\\c\\n\u6211\u73B0\u5728\u53EF\u5389\u5BB3\u5566\uFF01\\n\u4F60\u548C[VAR 0100(0000)]\u5F53\u7136\u4E0D\u662F\u6211\u7684\u5BF9\u624B\uFF0C\\r\\n\u5C31\u7B97\u662F\u5927\u54E5\uFF0C\u4E5F\u4F1A\u8D25\u7ED9\u6211\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u518D\u89C1\u5566\uFF0C[VAR 0100(0000)]\u3002\\n\u6709\u673A\u4F1A\u518D\u6765\u5C3D\u60C5\u5730\u5BF9\u6218\u5427\uFF01\\c\\n\u4F60\u6700\u597D\u5728\u65F7\u91CE\u5730\u5E26\\n\u597D\u597D\u5730\u953B\u70BC\u4E00\u4E0B\u554A\uFF01[VAR 0114(0017)]"
  }
