[
  {
    "index": 0,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u3002\\c\\n\u6211\u4F1A\u7528\u6211\u7684\u8D85\u80FD\u529B\\n\u5F15\u9886\u4F60\u767B\u4E0A\u5B9D\u5EA7\u7684\uFF01\\r\\n\u656C\u8BF7\u671F\u5F85\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u521A\u624D\u7684\u5BF9\u6218\\n\u6253\u5F97\u53EF\u771F\u591F\u4F18\u96C5\u7684\u554A\u3002\\c\\n\u4E0B\u4E00\u573A\u6BD4\u8D5B\u4E5F\u8981\u4F18\u96C5\u5730\u8868\u73B0\u54E6\u3002\\n\u62DC\u6258\u4F60\u4E86\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u65E9\u5DF2\u901A\u8FC7\u9884\u77E5\u672A\u6765\\n\u7B97\u51FA\u6211\u4EEC\u80FD\u8D70\u5230\u8FD9\u4E00\u6B65\u4E86\uFF01\\c\\n\u81F3\u4E8E\u63A5\u4E0B\u6765\u4F1A\u53D1\u751F\u4EC0\u4E48\uFF0C\\n\u5C31\u8BA9\u6211\u4EEC\u4E00\u8D77\u53BB\u63ED\u6653\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u7ADF\u7136\u9009\u4E86\u6211\uFF0C\\n\u4F60\u5F88\u6709\u773C\u5149\u561B\uFF5E\uFF01\\c\\n\u6211\u4EEC\u5C31\u8054\u624B\u628A\u5F3A\u5927\u7684\u52B2\u654C\u4EEC\\n\u4E00\u4E2A\u4E2A\u5730\u8150\u8680\u6389\u5427\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u8BF4\u554A\uFF01\u60F3\u4E0D\u5230\u6211\u4EEC\u4E24\u4E2A\\n\u642D\u914D\u5728\u4E00\u8D77\u597D\u50CF\u8FD8\u4E0D\u9519\u2026\u2026\uFF1F\\c\\n\u53EA\u8981\u4F60\u613F\u610F\u7684\u8BDD\uFF0C\\n\u6211\u5012\u662F\u53EF\u4EE5\u4E00\u76F4\u548C\u4F60\u642D\u6863\u54E6\u3002[VAR 0114(0071)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4EBA\u5BB6\u603B\u89C9\u5F97\u597D\u5174\u594B\uFF0C\\n\u8EAB\u4F53\u90FD\u5728\u53D1\u6296\u5462\u2026\u2026\\c\\n[VAR 0100(0000)]\uFF01\\n\u6211\u4EEC\u8981\u52A0\u6CB9\uFF0C\u62FF\u4E0B\u51A0\u519B\u54E6\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8036\uFF5E\uFF01\u80FD\u548C[VAR 0100(0000)]\u5E76\u80A9\u4F5C\u6218\uFF0C\\n\u8001\u5934\u513F\u6211\u53EF\u771F\u9AD8\u5174\uFF01\\r\\n\u8BF7\u591A\u6307\u6559\u5566\u565C\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u679C\u7136\u5389\u5BB3\u554A\uFF5E\uFF01\\n\u8001\u5934\u513F\u6211\u53EF\u4EE5\u653E\u5FC3\u5730\\r\\n\u548C\u4F60\u5E76\u80A9\u4F5C\u6218\u565C\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7EC8\u4E8E\u664B\u7EA7\u51B3\u8D5B\u565C\uFF5E\\c\\n\u6211\u4EEC\u53BB\u548C\u7ADE\u6280\u573A\u7684\u5927\u5BB6\\n\u5C3D\uFF5E\u60C5\u4EAB\u53D7\u8FD9\u6BB5\\r\\n\u4E16\u754C\u7B2C\u4E00\u6B22\u4E50\u7684\u65F6\u95F4\u5427\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5582\uFF01\u961F\u957F\uFF01\\n\u8C22\u8C22\u4F60\u6311\u4E86\u6211\uFF01\\c\\n\u6211\u5F97\u52A0\u628A\u52B2\uFF0C\\n\u514D\u5F97\u626F\u4F60\u540E\u817F\u554A\uFF01\u54C7\u54C8\u54C8\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9996\u6218\u6253\u5F97\u8FD8\u7B97\u987A\u5229\uFF01\\n\u7B2C\uFF12\u8F6E\u4E5F\u8981\u786C\u78B0\u786C\u5730\u5BF9\u6218\u554A\uFF01\\c\\n\u5C0F\u590F\u590F\u4E5F\u6765\u770B\u6BD4\u8D5B\u4E86\uFF0C\\n\u6211\u53EF\u4E0D\u80FD\u8BA9\u5979\u770B\u5230\u6211\u51FA\u7CD7\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u548C\u4F60\u642D\u6863\u8D77\u6765\uFF0C\\n\u7ED3\u679C\u5F53\u7136\u662F\u90A3\u4E2A\u5566\uFF01\\c\\n\u54B1\u4EEC\u5C31\u94C6\u8DB3\u52B2\u8D62\u5230\u5E95\u5427\uFF01\\n[VAR 0100(0000)]\u961F\u957F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\c\\n\u6211\u548C\u4F60\u8054\u624B\u7684\u8BDD\uFF0C\\n\u5C31\u662F\u6700\u5F3A\u4E2D\u7684\u6700\u5F3A\u4E86\uFF01\\c\\n\u6211\u4EEC\u53BB\u6253\u51FA\u6700\u68D2\u7684\u5927\u8D5B\uFF0C\\n\u8BA9\u5927\u5BB6\u90FD\u80FD\u5C3D\u5174\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u7684\u5B9E\u529B\u6BD4\u4E4B\u524D\u66F4\u5F3A\u4E86\u554A\uFF0C\\n[VAR 0100(0000)]\uFF01\\c\\n\u6211\u5DEE\u70B9\u5C31\u8981\u4E0D\u5C0F\u5FC3\\n\u7528\u55B7\u706B\u9F99\u653B\u51FB\u4F60\u4E86\u2026\u2026\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u53CC\u91CD\u51A0\u519B\u65F6\u523B\\n\u7EC8\u4E8E\u8981\u8FDB\u5165\u9AD8\u6F6E\u4E86\uFF01\\c\\n[VAR 0100(0000)]\uFF01\\n\u8BA9\u6211\u4EEC\u5C3D\u60C5\u4EAB\u53D7\u6700\u68D2\u7684\u51B3\u8D5B\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u2026\u2026\u96BE\u9053\u5C31\u6CA1\u6709\u522B\u4EBA\\n\u613F\u610F\u548C\u4F60\u642D\u6863\u5417\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u4E0D\u4F1A\u626F\u6211\u540E\u817F\u8FD9\u4E00\u70B9\uFF0C\\n\u5012\u662F\u548C\u5176\u4ED6\u8BAD\u7EC3\u5BB6\u4E0D\u4E00\u6837\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u51B3\u8D5B\u554A\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u5C31\u7B97\u548C\u4F60\u4E00\u8D77\u593A\u51A0\uFF0C\\n\u4E5F\u4E0D\u80FD\u51F8\u663E\u51FA\u6211\u7684\u5F3A\u5927\u3002[VAR 0114(000C)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u8C22\u8C22\u4F60\u9009\u6211\u5F53\u642D\u6863\u3002\\c\\n\u83AB\u9C81\u8D1D\u53EF\u5B83\u4E5F\u5728\u8BF4\\n\u5F88\u9AD8\u5174\u80FD\u548C\u4F60\u7EC4\u961F\u54E6\u3002[VAR 0114(000D)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u8EAB\u4E3A\u9053\u9986\u9986\u4E3B\uFF0C\\n\u6211\u4E5F\u5728\u4E0D\u65AD\u78E8\u7EC3\u62DB\u5F0F\u3002\\c\\n\u6240\u4EE5\uFF0C\u6211\u662F\u4E0D\u4F1A\u53EA\u8BA9\\n\u4F60\u8FD9\u4E2A\u51A0\u519B\u51FA\u5C3D\u98CE\u5934\u7684\u54E6\u3002[VAR 0114(000D)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u8981\u662F\u80FD\u548C\u4F60\u4E00\u8D77\u593A\u51A0\uFF0C\\n\u90A3\u8BE5\u6709\u591A\u5F00\u5FC3\u554A\u3002\\c\\n\u2026\u2026\u6700\u540E\u4E00\u6218\uFF0C\\n\u6211\u53EF\u4E0D\u51C6\u4F60\u8F93\u54E6\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u80FD\u8BA9\u51A0\u519B\u6307\u540D\u4E3A\u642D\u6863\uFF0C\\n\u53EF\u771F\u662F\u8363\u5E78\u554A\uFF5E\\c\\n\u5C31\u8BA9\u6211\u8F7B\u8F7B\u677E\u677E\uFF0C\\n\u7A33\u7A33\u5F53\u5F53\u5730\u53BB\u4EAB\u53D7\u6BD4\u8D5B\u5427\u3002[VAR 0114(000E)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5927\u5BB6\u7684\u5B9E\u529B\u90FD\u5F88\u5F3A\uFF0C\\n\u4E00\u70B9\u90FD\u4E0D\u80FD\u677E\u61C8\u554A\uFF5E\\c\\n\u4E0D\u8FC7\uFF0C\u548C[VAR 0100(0000)]\u4F60\u4E00\u8D77\u642D\u6863\uFF0C\\n\u6211\u4E00\u70B9\u90FD\u4E0D\u62C5\u5FC3\u54E6\u3002[VAR 0114(000E)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u7EC8\u4E8E\u5230\u51B3\u8D5B\u4E86\u554A\u3002\\c\\n\u628A\u6211\u4EEC\u6240\u6709\u7684\u529B\u6C14\uFF01\\n\u5C3D\u60C5\u5730\u65BD\u5C55\u51FA\u6765\u5427\uFF01[VAR 0114(000E)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u548C\u4F60\u7EC4\u6210\u4E00\u961F\uFF0C\\n\u8FD8\u771F\u662F\u611F\u89C9\u602A\u602A\u7684\u5462\u3002\\c\\n\u4E0D\u2026\u2026\u6211\u5176\u5B9E\u5F88\u9AD8\u5174\u3002\\n\u53EA\u662F\u89C9\u5F97\u4F60\u592A\u53EF\u9760\u4E86\uFF0C\u4E5F\u4E0D\u592A\u597D\u3002[VAR 0114(000F)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u5E72\u51C0\u5229\u843D\u7684\u6C34\u5C5E\u6027\u62DB\u5F0F\uFF0C\\n\u4F60\u89C9\u5F97\u600E\u4E48\u6837\u5462\uFF1F\\c\\n\u4E0B\u573A\u6BD4\u8D5B\u6211\u4E5F\u4F1A\u5728\u4F60\u8EAB\u65C1\\n\u534E\u4E3D\u5730\u7EFD\u653E\u62DB\u5F0F\u7684\u3002[VAR 0114(000F)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u65E2\u7136\u4F60\u548C\u6211\u8054\u624B\u4E86\uFF0C\\n\u90A3\u5C31\u975E\u8981\u593A\u51A0\u4E0D\u53EF\u4E86\u3002\\r\\n\u7B49\u4F60\u51C6\u5907\u597D\uFF0C\u6211\u4EEC\u5C31\u4E0A\u573A\u5427\u3002[VAR 0114(000F)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u4F60\u65E2\u662F\u6211\u7684\u642D\u6863\uFF0C\u4E5F\u662F\u6211\u7684\u52B2\u654C\u3002\\c\\n\u6211\u4F1A\u5728\u4F60\u7684\u65C1\u8FB9\u4E00\u8FB9\u534F\u52A9\u4F60\uFF0C\\n\u4E00\u8FB9\u5411\u4F60\u5B66\u4E60\u7684\u3002[VAR 0114(0010)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u521A\u624D\u7684\u5BF9\u6218\\n\u53EF\u771F\u591F\u706B\u70ED\u7684\u3002\\c\\n\u4F46\u662F\u8DDD\u79BB\u70E7\u6210\u70AD\uFF0C\u8FD8\u592A\u65E9\u4E86\uFF01\\n\u6211\u4EEC\u8FD8\u8981\u71C3\u5F97\u66F4\u65FA\u624D\u884C\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6211\u5361\u829C\u7684\u706B\u7130\u2026\u2026\\n\u5728\u51A0\u519B[VAR 0100(0000)]\u7684\u987A\u98CE\u4E4B\u4E0B\uFF0C\\r\\n\u71C3\u70E7\u5F97\u66F4\u731B\u70C8\u4E86\u3002\\c\\n\u65E2\u7136\u90FD\u8D70\u5230\u8FD9\u91CC\u4E86\uFF0C\u5C31\u5FC5\u987B\u8981\u593A\u51A0\u3002\\n\u8BA9\u6211\u4EEC\u70B9\u71C3\u6597\u5FD7\u4E0A\u9635\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u7ADF\u7136\u60F3\u548C\u6211\u7EC4\u961F\uFF0C\\n\u4F60\u662F\u4E0D\u662F\u5403\u9519\u836F\u4E86\uFF1F\\c\\n\u6781\u5DE8\u5316\u6211\u662F\u4E0D\u7528\u7684\uFF0C\\n\u4F46\u6211\u4F1A\u505A\u597D\u5176\u4ED6\u8BE5\u505A\u7684\u4E8B\u3002[VAR 0114(0016)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u867D\u7136\u6211\u5DF2\u7ECF\u4E0D\u5F53\u9053\u9986\u9986\u4E3B\u4E86\uFF0C\\n\u4F46\u591A\u4E8F\u6709\u4F60\uFF0C\\r\\n\u6211\u6839\u672C\u4E0D\u6101\u6CA1\u6709\u5BF9\u6218\u53EF\u6253\u3002[VAR 0114(0016)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u597D\uFF0C\u5230\u51B3\u8D5B\u4E86\u3002\\n\u2026\u2026\u600E\u4E48\u4E86\uFF1F\\c\\n\u4F60\u6211\u8054\u624B\u7684\u8BDD\uFF0C\\n\u8FD9\u70B9\u573A\u9762\u7EF0\u7EF0\u6709\u4F59\u5427\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u4E0D\u5F97\u4E86\u554A\uFF01\u6211\u548C\u4F60\u8054\u624B\uFF0C\\n\u7B80\u76F4\u5C31\u662F\u6700\u5F3A\u7EC4\u5408\u554A\uFF01\\c\\n\u867D\u7136\u5BF9\u4E0D\u8D77\u5176\u4ED6\u7684\u5BB6\u4F19\u4EEC\uFF0C\\n\u4F46\u80FD\u593A\u51A0\u7684\u6BEB\u65E0\u7591\u95EE\u662F\u6211\u4EEC\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u78B0\u4E0A\u672C\u5927\u7237\u548C[VAR 0100(0000)]\uFF0C\\n\u4E0D\u7BA1\u4EC0\u4E48\u5BF9\u624B\u90FD\u4F1A\u76F8\u5F62\u89C1\u7ECC\u554A\uFF01\\c\\n\u6211\u90FD\u4F1A\u7528\u624B\u673A\u6D1B\u6258\u59C6\u62CD\u4E0B\u6765\u7684\u3002\\c\\n\u4E0B\u4E00\u573A\u6211\u4EEC\u4E5F\u8981\\n\u7559\u4E0B\u80DC\u5229\u7684\u5FAE\u7B11\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u4EE5\u6211\u4EEC\u7684\u5B9E\u529B\uFF0C\\n\u7A81\u7834\u7B2C\uFF12\u8F6E\u662F\u7406\u6240\u5F53\u7136\u7684\u554A\uFF01\\c\\n\u80FD\u8FD9\u4E48\u914D\u5408\u672C\u5927\u7237\uFF0C\\n[VAR 0100(0000)]\u4F60\u53EF\u771F\u662F\u4E0D\u7B80\u5355\uFF01\\c\\n\u7B49\u593A\u51A0\u540E\uFF0C\\n\u6211\u4FE9\u6765\u62CD\u5F20\u80DC\u5229\u7684\u7EAA\u5FF5\u7167\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u611F\u8C22\u4F60\u80FD\u9080\u8BF7\u6211\u3002\\c\\n\u4E3A\u4E86\u4E0D\u8F9C\u8D1F\u4F60\u7684\u671F\u5F85\uFF0C\\n\u6211\u4F1A\u5C3D\u529B\u5BF9\u6218\u7684\u3002\\r\\n\u8BF7\u591A\u6307\u6559\u4E86\u3002[VAR 0114(0011)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u4E0D\u80FD\u56E0\u4E3A\u4E00\u573A\u80DC\u5229\\n\u5C31\u8BA9\u81EA\u5DF1\u677E\u61C8\u4E86\u3002\\c\\n\u4F46\u662F\uFF0C\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\\n\u8BA9\u6211\u7684\u5FC3\u60C5\u5F88\u8212\u7545\u2026\u2026\\r\\n\u5FCD\u4E0D\u4F4F\u4F1A\u677E\u61C8\u4E00\u70B9\u5462\u3002[VAR 0114(0011)]"
  },
  {
    "index": 38,
