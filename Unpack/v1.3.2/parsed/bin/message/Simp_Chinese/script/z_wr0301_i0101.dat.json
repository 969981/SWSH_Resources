[
  {
    "index": 0,
    "flags": 0,
    "text": "\u662F\u5173\u4E8E\u738B\u51A0\u96EA\u539F\u7684\u4E66\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8981\u8BFB\u54EA\u672C\u4E66\u5462\uFF1F"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8981\u8BFB\u8BFB\u522B\u7684\u4E66\u5417\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E30\u9976\u4E4B\u738B"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u56FD\u738B\u7684\u7231\u9A6C"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7275\u7ECA\u7F30\u7EF3"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u96EA\u539F\u7684\u852C\u83DC"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u51BB\u51DD\u6751\u96EA\u4E2D\u821E"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7279\u4EA7\u7684\u7075\u611F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD8\u662F\u7B97\u4E86"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5B83\u662F\u4E3A\u8FD9\u7247\u571F\u5730\\n\u5E26\u6765\u4E30\u9976\u7684\u5B9D\u53EF\u68A6\u3002\\c\\n\u5F53\u5B83\u6325\u8D77\u53F3\u624B\uFF0C\\n\u5373\u53EF\u4F7F\u767E\u82B1\u7EFD\u653E\uFF0C\u7EFF\u8349\u5982\u8335\u3002\\c\\n\u5F53\u5B83\u6325\u8D77\u5DE6\u624B\uFF0C\\n\u5373\u53EF\u4F7F\u7530\u5730\u80A5\u6C83\uFF0C\u4F5C\u7269\u4E30\u6536\u3002\\c\\n\u5B83\u8BA9\u5DE8\u5927\u7684\u738B\u51A0\\n\u53D1\u51FA\u9752\u8272\u7684\u5149\u8F89\uFF0C\\r\\n\u4E0E\u7231\u9A6C\u5B9D\u53EF\u68A6\u4E00\u540C\u9A70\u9A8B\u5927\u5730\u3002\\c\\n\u5B83\u7684\u5230\u6765\uFF0C\u8BA9\u8349\u6728\u7115\u53D1\u65B0\u751F\uFF0C\\n\u4E3A\u571F\u5730\u5E26\u6765\u4E30\u9976\u3002\\c\\n\u6211\u7B49\u5949\u5B83\u4E3A\u738B\uFF0C\\n\u4FE1\u4EF0\u5E76\u5D07\u62DC\u5B83\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5B83\u4E0D\u4F46\u662F\u56FD\u738B\u7684\u6E29\u987A\u5750\u9A91\uFF0C\\n\u8FD8\u80FD\u6FC0\u53D1\u51FA\u56FD\u738B\u7684\u529B\u91CF\u3002\\c\\n\u5F53\u4E24\u8005\u5408\u800C\u4E3A\u4E00\u65F6\uFF0C\\n\u4E00\u591C\u4E4B\u95F4\u5373\u53EF\u5B55\u80B2\u51FA\u68EE\u6797\u3002\\c\\n\u5B83\u539F\u672C\u6027\u60C5\u5341\u5206\u7C97\u66B4\uFF0C\\n\u751A\u81F3\u4F1A\u62A2\u98DF\u6751\u91CC\u7684\u519C\u4F5C\u7269\uFF0C\\r\\n\u8BA9\u4EBA\u7C7B\u82E6\u4E0D\u582A\u8A00\u3002\\c\\n\u7136\u800C\u56FD\u738B\u529D\u8C0F\u4E86\u5B83\uFF0C\\n\u5E76\u5C06\u5B83\u6536\u4E3A\u4E0B\u5C5E\u3002\\c\\n\u6709\u4EBA\u8BF4\u5B83\u7684\u989C\u8272\\n\u5B9B\u5982\u51BB\u4EBA\u7684[VAR FF00(0006)]\u51B0[VAR FF00(0000)]\u4E00\u6837\u6D01\u767D\u3002\\c\\n\u4E5F\u6709\u4EBA\u8BF4\u5B83\u7684\u989C\u8272\\n\u5B9B\u5982\u5348\u591C[VAR FF00(0006)]\u5E7D\u7075[VAR FF00(0000)]\u4E00\u6837\u6F06\u9ED1\u3002\\c\\n\u4F46\u6CA1\u6709\u4EBA\u77E5\u9053\u7A76\u7ADF\\n\u54EA\u79CD\u8BF4\u6CD5\u624D\u662F\u6B63\u786E\u7684\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8FD9\u662F\u56FD\u738B\u9A6F\u670D\u7231\u9A6C\u4E4B\u9645\\n\u503E\u6CE8\u4E86\u81EA\u8EAB\u529B\u91CF\u7684\u7F30\u7EF3\u3002\\c\\n\u4E5F\u662F\u4E3A\u4E86\u611F\u8C22\u56FD\u738B\u6240\u8D50\u4E30\u6536\uFF0C\\n\u6211\u7B49\u4EBA\u7C7B\u5411\u5176\u8FDB\u732E\u4E4B\u7269\u3002\\c\\n\u901A\u8FC7\u7F30\u7EF3\u4E0E\u56FD\u738B\u7D27\u5BC6\u76F8\u8FDE\u7684\\n\u4E0D\u4EC5\u662F\u7231\u9A6C\uFF0C\u8FD8\u6709\u6211\u7B49\u4EBA\u7C7B\u3002\\c\\n\u52FF\u5FD8\u8981\u5728\u4E00\u5E74\u4E4B\u521D\\n\u5C06\u6B64\u7F30\u7EF3\u8FDB\u732E\u56FD\u738B\u3002\\c\\n\u7F30\u7EF3\u9700\u4EE5\u5149\u8F89\u4E4B\u82B1\u4E0E\u9A6C\u5B9D\u53EF\u68A6\u7684\\n\u9B03\u6BDB\u5C42\u5C42\u76F8\u53E0\uFF0C\u7F16\u7EC7\u800C\u6210\u3002\\c\\n\u9700\u5C06\u6B64\u5236\u6CD5\u4F20\u627F\u4E0B\u53BB\uFF0C\\n\u8BA9\u5B50\u5B50\u5B59\u5B59\u4E16\u4EE3\u627F\u88AD\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u738B\u51A0\u96EA\u539F\u7684\u841D\u535C\u6709\u7740\\n\u5947\u7279\u7684\u6210\u957F\u65B9\u5F0F\u3002\\c\\n\u5728\u79EF\u96EA\u6DF1\u539A\u7684\u571F\u5730\u7684\u7530\u91CC\uFF0C\\n\u5B83\u4F1A\u957F\u6210\u51B0\u841D\u535C\u3002\\c\\n\u5728\u575F\u5893\u65C1\u7684\u7530\u5730\u91CC\uFF0C\\n\u5B83\u5219\u4F1A\u957F\u6210\u9ED1\u841D\u535C\u3002\\c\\n[VAR FF00(0006)]\u51B0\u5C5E\u6027[VAR FF00(0000)]\u7684\u5B9D\u53EF\u68A6\\n\u559C\u6B22\u5403\u51B0\u841D\u535C\u3002\\c\\n[VAR FF00(0006)]\u5E7D\u7075\u5C5E\u6027[VAR FF00(0000)]\u7684\u5B9D\u53EF\u68A6\\n\u559C\u6B22\u5403\u9ED1\u841D\u535C\u3002\\c\\n\u5728\u4F20\u8BF4\u91CC\u767B\u573A\u7684\\n\u4E30\u9976\u4E4B\u738B\u7684\u7231\u9A6C\\r\\n\u4E5F\u975E\u5E38\u7231\u5403\u841D\u535C\u3002\\c\\n\u4F46\u662F\uFF0C\u6709\u7684\u4E66\u91CC\u8BF4\uFF0C\\n\u662F\u767D\u8272\u7684\u7231\u9A6C\u5403\u51B0\u841D\u535C\u3002\\c\\n\u800C\u6709\u7684\u4E66\u91CC\u5374\u8BF4\uFF0C\\n\u662F\u9ED1\u8272\u7684\u7231\u9A6C\u5403\u9ED1\u841D\u535C\u3002\\c\\n\u4E0D\u77E5\u4E3A\u4F55\u51FA\u73B0\u4E86\u4E0D\u540C\u7684\u63CF\u8FF0\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u96EA\u539F\u4E00\u5E74\u6BD4\u4E00\u5E74\u51B7\uFF0C\\n\u771F\u662F\u8BA9\u4EBA\u53D7\u4E0D\u4E86\u554A\u3002\\c\\n\u8981\u662F\u603B\u7A9D\u5728\u6696\u547C\u547C\u7684\u5BB6\u91CC\uFF0C\\n\u4E00\u4E0D\u5C0F\u5FC3\u5C31\u4F1A\u7F3A\u4E4F\u8FD0\u52A8\u4E86\u554A\u3002\\c\\n\u6240\u4EE5\uFF0C\u6765\u8DF3\u4E00\u8DF3\u201C\u51BB\u51DD\u6751\u96EA\u4E2D\u821E\u201D\u5427\uFF01\\n\u597D\u597D\u6D3B\u52A8\u4E00\u4E0B\uFF0C\u8BA9\u8EAB\u5B50\u6696\u8D77\u6765\uFF01\\c\\n\u4E3E\u8D77\u53CC\u624B\uFF0C\u522B\u505C\u522B\u505C\uFF01\\n\u6DF1\u6DF1\u5F2F\u8170\uFF0C\u51BB\u51DD\u51BB\u51DD\uFF01\\c\\n\u6765\uFF01\u4E00\u8D77\u56F4\u6210\u5708\uFF0C\u8DF3\u8DF3\u51BB\u51DD\u6751\u96EA\u4E2D\u821E\u5427\u3002\\n\u53EA\u8981\u52E4\u8DF3\u96EA\u4E2D\u821E\uFF0C\u8001\u4EBA\u5065\u5EB7\u5C31\u6709\u8C31\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u51BB\u51DD\u6751\u89C2\u5149\u529E\u4E8B\u5904\\n\u7279\u4EA7\u7075\u611F\u5F81\u96C6\u6D3B\u52A8\\c\\n\u672C\u6B21\u8131\u9896\u800C\u51FA\uFF0C\\n\u6210\u4E3A\u7279\u4EA7\u5546\u54C1\u7684\u662F\\r\\n\u4E30\u9976\u4E4B\u738B\u7684T\u6064\uFF01\\c\\n\u6211\u4EEC\u4F1A\u6CBF\u7528\u73B0\u6709\u7684\u65E7\u8D44\u6599\uFF0C\\n\u8282\u7701\u8BBE\u8BA1\u6210\u672C\uFF01\\c\\n\u611F\u8C22\u5927\u5BB6\u8E0A\u8DC3\u53C2\u52A0\u672C\u6B21\u6D3B\u52A8\u3002"
  }
]
