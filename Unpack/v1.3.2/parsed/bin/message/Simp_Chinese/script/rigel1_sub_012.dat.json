[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F60\u8FD9\u8F86\u81EA\u884C\u8F66\u5F88\u4E0D\u9519\u5462\uFF01\\c\\n\u5982\u679C\u4F60\u4E0D\u4ECB\u610F\u7684\u8BDD\uFF0C\\n\u5C31\u8BA9\u6211\u5E2E\u4F60\u5B9A\u5236\u4E00\u4E0B\u5427\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54CE\uFF1F\u4F60\u2026\u2026\\c\\n\u7B49\u4F60\u5F97\u5230\u80FD\u5728\u6C34\u4E0A\u9A91\u7684\u81EA\u884C\u8F66\u4EE5\u540E\uFF0C\\n\u8FC7\u6765\u8DDF\u6211\u8BF4\u4E00\u58F0\u5427\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u662F\u81EA\u884C\u8F66\u7EF4\u4FEE\u59D0\u59D0\u3002\\n\u6211\u8D85\u7EA7\u559C\u6B22\u81EA\u884C\u8F66\u7684\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u90A3\u8F86\u81EA\u884C\u8F66\uFF0C\\n\u4E0D\u5982\u8BA9\u6211\u5E2E\u4F60\u5B9A\u5236\u4E00\u4E0B\uFF0C\\r\\n\u6539\u6210\u6211\u8BBE\u8BA1\u51FA\u7684\u6B3E\u5F0F\u600E\u4E48\u6837\uFF1F"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u95EA\u4EAE\u767D"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u70AB\u8000\u9ED1"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6700\u5F00\u59CB\u7684\u6B3E\u5F0F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5B9A\u5236\u81EA\u884C\u8F66"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u66F4\u6362\u9A91\u884C\u670D\u7684\u989C\u8272"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD4\u56DE"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4E0D\u7528\u4E86"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8981\u5B9A\u5236\u6210\u54EA\u79CD\u6B3E\u5F0F\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u90A3\u6211\u5C31\u5E2E\u4F60\u628A\u5B83\u5B9A\u5236\u6210\u56E0\u4E3A\u8FC7\u5206\u629B\u5149\\n\u800C\u53D8\u5F97\u6D01\u767D\u8000\u773C\u7684\u95EA\u4EAE\u767D\u54AF\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u90A3\u6211\u5C31\u5E2E\u4F60\u628A\u5B83\u5B9A\u5236\u6210\u52A0\u4E86\\n\u7279\u6B8A\u6D82\u5C42\u800C\u95EA\u95EA\u53D1\u5149\u7684\u70AB\u8000\u9ED1\u54AF\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u55EF\uFF1F\uFF01\\n\u4F60\u60F3\u628A\u81EA\u884C\u8F66\u53D8\u56DE\u539F\u6765\u7684\u6837\u5B50\u54E6\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u554A\u54C8\u54C8\uFF01\u6211\u77E5\u9053\u5566\uFF0C\\n\u4F60\u5C31\u559C\u6B22\u4F60\u81EA\u884C\u8F66\u73B0\u5728\u7684\u6837\u5B50\u54E6\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u7B49\u4F60\u60F3\u8BA9\u6211\u5E2E\u4F60\u5B9A\u5236\u81EA\u884C\u8F66\u4E86\uFF0C\\n\u968F\u65F6\u90FD\u53EF\u4EE5\u6765\u627E\u6211\u54E6\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6CA1\u95EE\u9898\uFF5E\uFF01\u90A3\u4E48\uFF0C\u8BF7\u4F60\u7A0D\u7B49\u7247\u523B\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5B9A\u5236\u5B8C\u6210\uFF01\\n\u9A91\u5F97\u5F00\u5FC3\u54E6\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6D1B\u6258\u59C6\u81EA\u884C\u8F66\u7684\u6B3E\u5F0F\\n\u53D8\u6210\u4E86\u95EA\u4EAE\u767D\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6D1B\u6258\u59C6\u81EA\u884C\u8F66\u7684\u6B3E\u5F0F\\n\u53D8\u6210\u4E86\u70AB\u8000\u9ED1\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6D1B\u6258\u59C6\u81EA\u884C\u8F66\u7684\u6B3E\u5F0F\\n\u6062\u590D\u539F\u6837\u4E86\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u7B49\u4F60\u60F3\u628A\u81EA\u884C\u8F66\u5B9A\u5236\u6210\u522B\u7684\u6837\u5B50\u4E86\uFF0C\\n\u968F\u65F6\u90FD\u53EF\u4EE5\u518D\u6765\u627E\u6211\u54E6\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5916\u8868\u6539\u53D8\u4E86\uFF0C\\n\u5FC3\u60C5\u4E5F\u4F1A\u968F\u4E4B\u53D8\u5316\uFF01\\c\\n\u4F60\u90A3\u8F86\u81EA\u884C\u8F66\uFF0C\\n\u6211\u6765\u5E2E\u4F60\u5B9A\u5236\u4E00\u4E0B\u600E\u4E48\u6837\uFF1F"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6211\u8FD8\u987A\u4FBF\u5E2E\u4F60\u628A\u81EA\u884C\u8F66\u7684\u5145\u7535\u901F\u5EA6\\n\u4E5F\u63D0\u5347\u5230\u4E86\u6700\u9AD8\u54E6\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4F60\u662F\u60F3\u7ED9\u9A91\u884C\u670D\u6362\u4E2A\u989C\u8272\uFF0C\u5BF9\u5427\uFF1F\\c\\n\u6211\u6765\u5E2E\u4F60\u6362\u6210\u548C\u540C\u884C\u7684[VAR 0101(0006)]\\n\u76F8\u886C\u7684\u989C\u8272\u54E6\uFF01"
