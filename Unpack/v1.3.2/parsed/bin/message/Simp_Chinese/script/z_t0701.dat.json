[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6B22\u8FCE\u6765\u5230\u767D\u96EA\u5C0F\u9547\uFF01\\n\u4F60\u4E00\u5B9A\u542C\u8BF4\u8FC7\u8FD9\u4E2A\u5C0F\u9547\u7684\u540D\u5B57\u5427\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u96EA\u767D\uFF5E\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u7684\u62F3\u62F3\u86F8\uFF0C\\n\u56E0\u4E3A\u521A\u624D\u6CE1\u8FC7\u4E86\u6E29\u6CC9\uFF0C\\r\\n\u6240\u4EE5\u73B0\u5728\u8EAB\u4E0A\u6696\u6D0B\u6D0B\u7684\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u54C8\u5494\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u542C\u8BF4\u5B9D\u53EF\u68A6\u5F85\u5728\u7CBE\u7075\u7403\u91CC\\n\u6216\u8005\u76D2\u5B50\u91CC\u7684\u65F6\u5019\uFF0C\u4F1A\u611F\u89C9\u5F88\u8212\u9002\u5462\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u82F1\u96C4\u4E4B\u6CC9\u2026\u2026\u542C\u8BF4\u4ECE\u5F88\u4E45\u4EE5\u524D\u5F00\u59CB\uFF0C\\n\u8FD9\u91CC\u5C31\u6709\u6E29\u6CC9\u6D8C\u51FA\u4E86\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5E73\u65F6\u90FD\u662F\u901A\u8FC7\u7ADE\u6280\u573A\u7684\u5927\u5C4F\u5E55\\n\u89C2\u770B\u9053\u9986\u9986\u4E3B\u7684\u6BD4\u8D5B\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9F99\u5C5E\u6027\u5B9D\u53EF\u68A6\u53EF\u80FD\u5F88\u6015\u51B7\u5427\uFF0C\\n\u6240\u4EE5\u6BD4\u8F83\u6015\u9047\u5230\u51B0\u5C5E\u6027\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u808C\u8089\uFF01\u53EA\u8981\u8BA9\u808C\u8089\u8FD0\u52A8\u8D77\u6765\uFF0C\\n\u5C31\u4E0D\u4F1A\u754F\u60E7\u5BD2\u51B7\u5566\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5728\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\u65F6\u5019\uFF0C\\n\u5982\u679C\u88AB\u51BB\u4F4F\u5C31\u7CDF\u4E86\uFF01\u4E0D\u80FD\u52A8\u7684\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u96EA\u4EBA\u4E5F\u662F\u4E00\u79CD\u5B9D\u53EF\u68A6\u5417\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5012\u662F\u6709\u51B0\u5C5E\u6027\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u53EF\u662F\u6709\u50CF\u96EA\u4EBA\u4E00\u6837\u7684\u5B9D\u53EF\u68A6\u5417\uFF1F"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E00\u4E0B\u96EA\u5C31\u770B\u4E0D\u89C1\u51B0\u5C5E\u6027\u5B9D\u53EF\u68A6\u4E86\u5462\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u4E13\u7528\u7684\u6E29\u6CC9\u2026\u2026\\n\u4ECA\u5929\u7684\u6C34\u6E29\u4E5F\u521A\u521A\u597D\u5462\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5929\u6C14\u4E00\u53D8\u51B7\uFF0C\u5FC3\u60C5\u90FD\u6CA1\u90A3\u4E48\u597D\u4E86\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u5929\u6C14\u8D8A\u51B7\uFF0C\u706B\u7EA2\u4E0D\u5012\u7FC1\\n\u5C31\u80FD\u591F\u79EF\u84C4\u8D8A\u591A\u529B\u91CF\uFF0C\u4E5F\u662F\u4EF6\u597D\u4E8B\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8F70\u9686\u9686\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5636\u5566\u5636\u5566\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u54BB\u54C7\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5600\u54D2\u54D2\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5E93\u5E93\u5E93\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u547C\u54C7\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u8212\u670D\uFF0C\u8212\u670D\u554A\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u6B63\u5728\u5173\u6CE8\u7684\u662F\\n\u8D6B\u666E\u9009\u624B\u548C\u739B\u4FD0\u9009\u624B\u3002"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u8FD8\u6709\uFF0C\\n\u7EDD\u5BF9\u4E0D\u80FD\u6F0F\u6389[VAR 0100(0000)]\u9009\u624B\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u4E13\u7528\u7684\u6E29\u6CC9\u2026\u2026\\n\u4ECA\u5929\u7684\u6C34\u6E29\u4E5F\u521A\u521A\u597D\u5462\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8FD9\u5899\u58C1\u4E0A\u523B\u7684\uFF0C\\n\u83AB\u975E\u662F\u732B\u8001\u5927\uFF1F"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u549A\u549A\u9686\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u8FD9\u77F3\u9636\u4E0A\u4E00\u76F4\u51C9\u98D5\u98D5\u7684\uFF0C\\n\u8981\u662F\u4E0B\u4E86\u96EA\uFF0C\u5F88\u5FEB\u5C31\u4F1A\u6709\u79EF\u96EA\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6709\u5F88\u591A\u4EBA\u867D\u7136\u53C2\u52A0\u4E0D\u4E86\u9053\u9986\u6311\u6218\uFF0C\\n\u4F46\u8FD8\u662F\u5BF9\u5B9D\u53EF\u68A6\u5BF9\u6218\u5174\u81F4\u52C3\u52C3\u3002\\r\\n\u800C\u6839\u672C\u4E0D\u8FDB\u884C\u5BF9\u6218\u7684\u4EBA\\r\\n\u4E5F\u540C\u6837\u6709\u5F88\u591A\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u82F1\u96C4\u53D7\u4E86\u4F24\u7684\u65F6\u5019\uFF0C\\n\u597D\u50CF\u5C31\u662F\u9760\u8FD9\u4E2A\u6E29\u6CC9\u6CBB\u7597\u7684\u54E6\u3002"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u5C31\u7B97\u5C3D\u53EF\u80FD\u4ECE\u6BD4\u8D5B\u4E2D\\n\u628A\u4E00\u5207\u4E0D\u786E\u5B9A\u7684\u56E0\u7D20\u90FD\u6392\u9664\uFF0C\\r\\n\u6700\u540E\u53EF\u80FD\u8FD8\u662F\u8981\u770B\u8FD0\u6C14\u2026\u2026"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u521A\u60F3\u7740\u201C\u7CDF\u7CD5\uFF0C\u8981\u8F93\u4E86\u201D\uFF0C\\n\u5C31\u51FB\u4E2D\u4E86\u5BF9\u624B\u7684\u8981\u5BB3\uFF01"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u51B0\u5636\u5636\uFF5E"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u4E5F\u5FEB\u8981\u7ED3\u675F\u4E86\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u53C2\u52A0\u6DD8\u6C70\u8D5B\u7684\u4EBA\u6709\u54EA\u4E9B\u5462\uFF1F"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u7B2C\u4E00\u6B21\u53C2\u52A0\u5C31\u593A\u51A0\uFF0C\\n\u592A\u5389\u5BB3\u4E86\uFF01"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u767D\u96EA\u7691\u7691\uFF01\u6211\u6700\u7231\uFF01"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u201C\u662F\u6211\u201D\uFF0C\\n\u5B9D\u53EF\u68A6\u8BF4\u9053\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u96E8\u6EF4\u662F\u5929\u7A7A\u7684\u6CEA\uFF0C\\n\u90A3\u96EA\u82B1\u53C8\u662F\u4EC0\u4E48\u5440\uFF1F"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u6211\u5728\u8857\u4E0A\u5DE1\u903B\u3002"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u4E00\u76F4\u5728\u8857\u4E0A\u5230\u5904\u8D70\uFF0C\\n\u5B9E\u5728\u592A\u5065\u5EB7\u4E86\u3002"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u662F\u4E3A\u4E86\u6D88\u98DF\\n\u624D\u5728\u8857\u4E0A\u5230\u5904\u8D70\u7684\u3002"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u8001\u9955\u4F2F\u5BB6\u7684\u5496\u55B1\u914D\u6599\uFF01"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u5496\u55B1\u8BA9\u98DF\u6750\u548C\u7C73\u996D\\n\u5B8C\u7F8E\u7ED3\u5408\uFF01"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u5404\u79CD\u6ECB\u5473\u5728\u5496\u55B1\u4E2D\\n\u878D\u5408\u5230\u4E00\u8D77\uFF01"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u65E0\u8BBA\u662F\u5B9D\u53EF\u68A6\u8FD8\u662F\u4EBA\uFF0C\\n\u6700\u91CD\u8981\u7684\u662F\u8981\u6709\u6D3B\u529B\uFF01"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u53EA\u8981\u6D3B\u529B\u56DB\u5C04\uFF0C\\n\u5FBD\u7AE0\u624B\u5230\u64D2\u6765\uFF01"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\\n\u771F\u662F\u4E2A\u4E0D\u9519\u7684\u8D5B\u4E8B\u3002"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u542C\u8BF4\u8FC7\u53BB\u7684\u82F1\u96C4\\n\u5F88\u559C\u6B22\u6CE1\u6E29\u6CC9\u3002"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u82F1\u96C4\u5230\u5E95\u505A\u8FC7\u4E9B\u4EC0\u4E48\u5462\uFF1F"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u51A0\u519B\u4E5F\u662F\u82F1\u96C4\u5417\uFF1F"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\u8FD9\u91CC\u662F\u81EA\u53E4\u76F8\u4F20\u7684\u82F1\u96C4\u4E4B\u6CC9\u3002\\c\\n\u56E0\u5F53\u5E74\u82F1\u96C4\u4E3A\u4E86\u7597\u4F24\uFF0C\\n\u5728\u6B64\u6CE1\u8FC7\u6E29\u6CC9\u800C\u5F97\u540D\u3002"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\u5728\u5927\u51AC\u5929\u91CC\u5403\u51B0\u6FC0\u51CC\uFF0C\\n\u5012\u4E5F\u662F\u4E00\u79CD\u5947\u5999\u7684\u4EAB\u53D7\u554A\u3002"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "[~ 54]"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\u6B63\u56E0\u4E3A\u662F\u5728\u5BD2\u51B7\u7684\u5C0F\u9547\u624D\u8981\u7528\u51B0\u5C5E\u6027\uFF01\\n\u8FD9\u4E0D\u6B63\u662F\u96EA\u541E\u866B\u5927\u663E\u8EAB\u624B\u7684\u673A\u4F1A\u5417\uFF01"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\u6B63\u56E0\u4E3A\u662F\u5728\u5BD2\u51B7\u7684\u5C0F\u9547\u624D\u8981\u7528\u706B\u5C5E\u6027\uFF01\\n\u548C\u70E7\u706B\u86A3\u5F85\u5728\u4E00\u8D77\u597D\u6E29\u6696\u54E6\uFF01"
  }
