  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\u4ED6\u2026\u2026\\n\u4EE5\u524D\u4E5F\u5728\u7164\u77FF\u5DE5\u4F5C\u8FC7\u3002\\c\\n\u6240\u4EE5\u5BF9\u6211\u6765\u8BF4\uFF0C\\n\u73B0\u5728\u505A\u7684\u8FD9\u4E9B\u5176\u5B9E\u4E5F\u662F\u4E00\u79CD\u5FEB\u4E50\u3002\\c\\n\u6CA1\u9519\uFF0C\u6211\u592A\u5F00\u5FC3\u4E86\u3002\\n\u5F00\u5FC3\u5230\u8981\u628A\u8FD9\u5F20\u8054\u76DF\u5361\u9001\u7ED9\u4F60\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u4E0D\u5FC5\u5728\u610F\u7684\u3002\\n\u56E0\u4E3A\u6211\u2026\u2026\\c\\n\u5176\u5B9E\u6709\uFF11\uFF10\uFF10\u5F20\u6D1B\u5179\u4F1A\u957F\u7684\u8054\u76DF\u5361\uFF01\\n\u5E76\u4E14\u6BCF\u5F20\u5361\u4E0A\u90FD\u6709\u4ED6\u7684\u7B7E\u540D\u54E6\uFF01\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u51A0\u519B\u2026\u2026\\n\u8C22\u8C22\u4F60\u963B\u6B62\u4E86\u65E0\u6781\u6C70\u90A3\u3002\\c\\n\u6211\u53EF\u4EE5\u80AF\u5B9A\u2026\u2026\\n\u6D1B\u5179\u4F1A\u957F\u4ED6\u4E00\u5B9A\u4E5F\u5F88\u611F\u8C22\u4F60\u3002\\c\\n\u4F46\u4ED6\u5176\u5B9E\u53EA\u662F\\n\u592A\u62C5\u5FC3\u4F3D\u52D2\u5C14\u7684\u672A\u6765\u800C\u5DF2\u2026\u2026[VAR 0114(0007)]"
