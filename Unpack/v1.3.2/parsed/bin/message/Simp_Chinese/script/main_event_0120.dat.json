    "index": 0,
    "flags": 0,
    "text": "\u5927\u54E5\uFF01\u6211\u60F3\u8981\u53D8\u5F97\u66F4\u5F3A\uFF01\\n\u8BA9\u6211\u53BB\u6311\u6218[VAR FF00(0006)]\u5B9D\u53EF\u68A6\u9053\u9986[VAR FF00(0000)]\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64\u2026\u2026\\c\\n[VAR FF00(0006)]\u9053\u9986\u6311\u6218[VAR FF00(0000)]\u53EF\u662F\u4F3D\u52D2\u5C14\u5730\u533A\u6700\u5927\u7684\u6D3B\u52A8\u3002\\n\u4F60\u8FD9\u4E48\u60F3\u53C2\u52A0\u5417\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u6837\u5427\uFF01\u4F60\u4EEC\u4E24\u4E2A\\n\u5148\u591A\u4E86\u89E3\u4E00\u4E0B\u5B9D\u53EF\u68A6\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u7279\u522B\u662F[VAR 0100(0000)]\uFF01\\n\u4F60\u8981\u5148\u62FF\u5230\u5B9D\u53EF\u68A6\u56FE\u9274\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u67E5\u4E00\u4E0B\u5B9D\u53EF\u68A6\u56FE\u9274\uFF0C\\n\u5C31\u80FD\u4E86\u89E3\u5B9D\u53EF\u68A6\u7684\u5404\u79CD\u80FD\u529B\u548C\u7279\u6027\uFF01\\c\\n\u5BF9\u4E86\uFF0C\u5B9D\u53EF\u68A6\u56FE\u9274\u91CC\u88C5\u7740\u7684\u53EF\u4E0D\u662F\u6570\u636E\uFF0C\\n\u800C\u662F\u6EE1\u6EE1\u7684\u7231\u548C\u70ED\u60C5\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u5427\uFF0C[VAR 0100(0000)]\uFF01\\c\\n\u65E2\u7136\u8981\u62FF\u5B9D\u53EF\u68A6\u56FE\u9274\uFF0C\\n\u5C31\u5F97\u53BB\u5B9D\u53EF\u68A6\u7814\u7A76\u6240\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5F88\u597D\uFF01\u8FDE\u8D6B\u666E\u90FD\u8DC3\u8DC3\u6B32\u8BD5\u4E86\uFF01\\n\u6211\u4F1A\u63D0\u524D\u901A\u77E5\u535A\u58EB\u7684\u3002[VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u8D6B\u666E\u53EF\u662F\u8981\u6210\u4E3A\u51A0\u519B\u7684\u7537\u4EBA\uFF01\\c\\n\u96C6\u9F50\u56FE\u9274\u4E5F\u4F1A\u6210\u4E3A\\n\u6211\u4F20\u8BF4\u4E2D\u7684\u91CD\u8981\u4E00\u9875\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u53BB\u62FF\u5B9D\u53EF\u68A6\u56FE\u9274\u4E4B\u524D\uFF0C\\n\u522B\u5FD8\u4E86\u5148\u544A\u8BC9\u963F\u59E8\u4E00\u58F0\u54E6\u3002[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u627E\u5230\u6700\u68D2\u7684\u642D\u6863\u4E86\u554A\uFF01\\n\u606D\u559C\u4F60\uFF01"
  }
]
