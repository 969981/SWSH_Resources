    "text": "\u54FC\uFF01\u60F3\u4E0D\u5230\u6211\u4F1A\u5728\u9996\u8F6E\u5C31\u51FA\u5C40\u2026\u2026\\n\u83AB\u975E\u5BF9\u624B\u64C5\u957F\u7528\u50AC\u7720\u672F\u5417\u2026\u2026\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u51B3\u8D5B\u91CC\u6CA1\u6709\u6211\uFF0C\u5C31\u597D\u6BD4\u5496\u55B1\u4E2D\\n\u6CA1\u6709\u98DF\u6750\u4E00\u6837\u4EE4\u4EBA\u4E4F\u5473\u3002[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u51A0\u519B\u662F\u4F60\u4EEC\u7684\uFF0C\u6211\u4EEC\u53EA\u80FD\u671B\u5C18\u83AB\u53CA\u2026\u2026\\n\u867D\u7136\u5F88\u4E0D\u7518\u5FC3\uFF0C\u4F46\u4F60\u4EEC\u503C\u5F97\u5938\u5956\u554A\u3002[VAR 0114(0072)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u4EEC\u597D\u5DEE\u52B2\u554A\uFF5E\uFF01\\n\u54CE\uFF5E\u7CDF\u900F\u4E86\u2026\u2026[VAR 0114(0071)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u4E5F\u597D\u60F3\u8FDB\u5165\u51B3\u8D5B\u554A\u2026\u2026\\c\\n\u987A\u4FBF\u4E5F\u5E26\u4E0A\u6211\\n\u53BB\u53C2\u52A0\u51B3\u8D5B\u2026\u2026\u4E0D\u884C\u5417\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E9A\u519B\u4E5F\u4E0D\u9519\u5566\uFF0C\\n\u8FD9\u4E2A\u7ED3\u679C\u6211\u5F88\u6EE1\u610F\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5F53\u5E08\u5085\u7684\u53EA\u4EA4\u51FA\u8FD9\u4E2A\u7ED3\u679C\uFF0C\\n\u8001\u5934\u513F\u6211\u672A\u514D\u4E5F\u592A\u4E0D\u4E2D\u7528\u4E86\u5427\u3002[VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u679C\u7136\u5389\u5BB3\u554A\uFF5E\\n\u5230\u4E86\u51B3\u8D5B\u4E5F\u8981\u52A0\u6CB9\u54DF\u3002[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5475\u5475\u5475\uFF01\u6253\u5F97\u6F02\u4EAE\uFF5E\uFF01\\n\u8001\u5934\u513F\u6211\u771F\u5FC3\u5730\u732A\uFF5E\u8D3A\u4F60\u4EEC\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u961F\u957F\u554A\uFF0C\u600E\u4E48\u4E00\u4E0A\u6765\u5C31\u9047\u5230\u4F60\u4EEC\uFF0C\\n\u6211\u8FD9\u8FD0\u6C14\u4E5F\u592A\u5DEE\u4E86\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u54C7\u54C8\uFF01\u8FD9\u6BD4\u8D5B\u53EF\u771F\u591F\u786C\u78B0\u786C\u7684\uFF01\\n\u5230\u4E86\u51B3\u8D5B\u4F60\u4EEC\u4E5F\u8981\u52A0\u6CB9\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8FD9\u51B3\u8D5B\u8BA9\u6211\u5B8C\u5168\u71C3\u8D77\u6765\u54AF\uFF01\\n\u51A0\u519B\u662F\u4F60\u4EEC\u7684\uFF0C\u606D\u559C\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u771F\u60F3\u4E0D\u5230\u6211\u4F1A\u5728\u9996\u8F6E\u51FA\u5C40\uFF01\\c\\n\u4E0D\u8FC7\u8FD9\u573A\u9AD8\u6C34\u51C6\u7684\u5BF9\u6218\\n\u8BA9\u89C2\u4F17\u4EEC\u90FD\u5F88\u5174\u594B\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u867D\u7136\u6211\u4EEC\u5DF2\u7ECF\u4F7F\u51FA\u5168\u529B\uFF0C\\n\u4F46\u8FD8\u662F\u4F60\u4EEC\u66F4\u80DC\u4E00\u7B79\uFF01\\c\\n\u597D\u4E86\uFF0C\u5230\u51B3\u8D5B\u7684\u821E\u53F0\\n\u4E0A\u6F14\u66F4\u7CBE\u5F69\u7684\u5BF9\u6218\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8FD9\u573A\u5BF9\u6218\u7684\u7CBE\u5F69\u7A0B\u5EA6\\n\u582A\u6BD4\u51A0\u519B\u676F\u554A\uFF01\\c\\n\u80FD\u4E3E\u529E\u4F3D\u52D2\u5C14\u660E\u661F\u8D5B\\n\u771F\u7684\u8BA9\u6211\u611F\u5230\u5F88\u6B23\u6170\uFF01\u8C22\u8C22\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u6211\u4EEC\u4F1A\uFF11\u80DC\u96BE\u6C42\u2026\u2026\\c\\n\u9ED1\u9A6C\u7206\u51B7\u8BA9\u89C2\u4F17\u4EEC\\n\u90FD\u5927\u8DCC\u773C\u955C\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u90FD\u6253\u8D62\u6211\u4EEC\u95EF\u5165\u51B3\u8D5B\u4E86\uFF0C\\n\u6211\u53EF\u4E0D\u8BB8\u4F60\u8F93\u7ED9\u4EFB\u4F55\u4EBA\u3002[VAR 0114(000C)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F\u51A0\u519B\u961F\u4F0D\uFF0C\\n\u5C31\u628A\u8363\u8A89\u8BA9\u7ED9\u4F60\u4EEC\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6211\u8FD8\u6CA1\u6253\u591F\u5462\u2026\u2026\\n\u4E0D\u8FC7\uFF0C[VAR 0100(0000)]\u554A\uFF0C\\r\\n\u8FD9\u6B21\u6211\u5C31\u628A\u80DC\u5229\u8BA9\u7ED9\u4F60\u4EEC\u5427\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4F60\u8981\u8FDE\u540C\u739B\u4FD0\u548C\u5927\u5BB6\u7684\u4EFD\\n\u4E00\u8D77\u52AA\u529B\uFF0C\u4E00\u5B9A\u8981\u593A\u51A0\u54E6\u3002[VAR 0114(000D)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6211\u4EEC\u62FF\u51FA\u4E86\u5168\u529B\uFF01\\n\u6240\u4EE5\u6211\u80FD\u6B23\u7136\u5730\u63A5\u53D7\u5931\u8D25\u3002\\r\\n\u606D\u559C\u4F60\u4EEC\u593A\u51A0\u5566\u3002[VAR 0114(000D)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4F60\u4EEC\u679C\u7136\u5389\u5BB3\u3002\\n\u5230\u7B2C\uFF12\u8F6E\u4E5F\u8981\u52A0\u6CB9\u554A\u3002[VAR 0114(000E)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u51B3\u8D5B\u7684\u65F6\u5019\uFF0C\\n\u6211\u4F1A\u5728\u89C2\u4F17\u5E2D\u4E0A\u4E3A\u4F60\u4EEC\u52A0\u6CB9\u7684\u3002[VAR 0114(000E)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u8F93\u5F97\u5FC3\u670D\u53E3\u670D\uFF01\\n\u606D\u559C\u4F60\u4EEC\u593A\u51A0\u554A\u3002[VAR 0114(000E)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5C45\u7136\u5728\u6FC0\u6D41\u5F62\u6210\u4E4B\u524D\u5C31\u88AB\u5835\u4F4F\u4E86\u2026\u2026\\n\u8FD9\u5C31\u662F\u51A0\u519B\u7684\u5B9E\u529B\u5417\u2026\u2026[VAR 0114(000F)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4F60\u4EEC\u914D\u5408\u5F97\u53EF\u771F\u662F\\n\u9ED8\u5951\u5341\u8DB3\u554A\u3002\\c\\n\u8FDE\u6211\u90FD\u6709\u70B9\u5AC9\u5992\u4E86\u5462\u3002[VAR 0114(000F)]"
