  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u8FD9\u65B0\u4E3E\u529E\u7684\u5927\u8D5B\\n\u8FD8\u771F\u662F\u8BA9\u4EBA\u51FA\u4E4E\u610F\u6599\u3002\\r\\n\u53EA\u6709\u60F3\u4E0D\u5230\uFF0C\u6CA1\u6709\u4E0D\u53EF\u80FD\u554A\u3002[VAR 0114(0014)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u6211\u672C\u6253\u7B97\u81F3\u5C11\\n\u4E5F\u8981\u6253\u8FDB\u51B3\u8D5B\u5462\u3002\\c\\n\u8FD8\u662F\u4F60\u4EEC\u7684\u914D\u5408\\n\u66F4\u80DC\u6211\u4EEC\u4E00\u7B79\u554A\u3002[VAR 0114(0014)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u6211\u8FD8\u4EE5\u4E3A\u6211\u4EEC\u80FD\u8D62\u5462\u3002\\c\\n\u4F60\u4EEC\u662F\u51FB\u8D25\u6211\u739B\u74DC\u7684\u961F\u4F0D\\n\u593A\u51A0\u7684\uFF0C\u503C\u5F97\u9A84\u50B2\u3002[VAR 0114(0014)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u592A\u3001\u592A\u5389\u5BB3\u4E86\u2026\u2026\\n\u4E0B\u3001\u4E0B\u4E00\u8F6E\u4F60\u4EEC\u4E5F\u4E00\u5B9A\u80FD\u8D62\u2026\u2026\uFF01[VAR 0114(0012)]"
