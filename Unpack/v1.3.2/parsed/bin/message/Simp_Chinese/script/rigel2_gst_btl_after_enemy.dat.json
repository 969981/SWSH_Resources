  {
    "index": 26,
    "flags": 0,
    "text": "\u8FD9\u573A\u51B3\u8D5B\u7B80\u76F4\u68D2\u6781\u4E86\uFF01\\n\u5FEB\uFF0C\u4F60\u4EEC\u4FE9\u4E00\u8D77\u8C22\u8C22\\r\\n\u89C2\u4F17\u4EEC\u7684\u4E00\u8DEF\u652F\u6301\u5427\u3002[VAR 0114(000F)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u6094\u6068\u662F\u5F15\u5BFC\u6211\u4E0B\u6B21\u53D6\u80DC\u7684\u52A8\u529B\uFF01\\n\u5E0C\u671B\u8FD8\u80FD\u6709\u673A\u4F1A\u518D\u6B21\u8F83\u91CF\u554A\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6211\u4EEC\u80F8\u4E2D\u7684\u6EE1\u8154\u70ED\u60C5\\n\u5C31\u5168\u90FD\u5BC4\u6258\u7ED9\u4F60\u4EEC\u4E86\uFF01\\r\\n\u628A\u5B83\u4EEC\u5E26\u5230\u51B3\u8D5B\u7684\u8D5B\u573A\u4E0A\u53BB\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u8FD9\u573A\u70BD\u70ED\u7684\u5BF9\u6218\\n\u582A\u79F0\u540D\u526F\u5176\u5B9E\u7684\u51B3\u8D5B\u554A\u3002\\r\\n[VAR 0100(0000)]\uFF0C\u8C22\u8C22\u4F60\u4EEC\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u8FD9\u8F93\u5F97\u4E5F\u592A\u5FEB\u4E86\uFF0C\\n\u5F85\u4F1A\u513F\u739B\u4FD0\u4F1A\u6765\u627E\u6211\u7B97\u8D26\u7684\u3002[VAR 0114(0016)]"
