  {
    "index": 36,
    "flags": 0,
    "text": "\u592A\u9057\u61BE\u4E86\uFF0C\\n\u4F46\u662F\u6211\u8981\u8C03\u6574\u5FC3\u60C5\u2026\u2026\\c\\n\u795D\u613F\u4F60\u4EEC\u8FDE\u6218\u8FDE\u80DC\u3002[VAR 0114(0011)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u5230\u4E86\u51B3\u8D5B\u540E\uFF0C\u8981\u8FDE\\n\u6211\u4EEC\u7684\u4EFD\u4E5F\u4E00\u8D77\u52A0\u6CB9\u554A\u3002[VAR 0114(0011)]"
