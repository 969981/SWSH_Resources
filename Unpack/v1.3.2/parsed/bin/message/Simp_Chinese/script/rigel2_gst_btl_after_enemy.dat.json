  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u8FD9\u4E0B\u6211\u9886\u6559\u5230\u4E86\\n\u4EC0\u4E48\u53EB\u505A\u51A0\u519B\u7684\u5A01\u4E25\u3002\\c\\n\u2026\u2026\u89C2\u4F17\u4EEC\u6B63\u7B49\u7740\u4F60\u4EEC\u5462\u3002[VAR 0114(0016)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u867D\u8D25\u72B9\u8363\uFF0C\u8BDD\u662F\u8FD9\u4E48\u8BF4\u2026\u2026\\n\u4F46\u9996\u8F6E\u5C31\u51FA\u5C40\u4E5F\u592A\u900A\u4E86\u3002\\r\\n\u6211\u7684\u81EA\u62CD\u6587\u4EF6\u5939\u53C8\u6709\u65B0\u6536\u83B7\u5566\u3002[VAR 0114(0017)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u4F60\u4EEC\u8FDE\u672C\u5927\u7237\u7684\u961F\u4F0D\u90FD\u8D62\u4E86\u3002\\c\\n\u63A5\u4E0B\u6765\u8981\u662F\u4E0D\u593A\u51A0\\n\u53EF\u5C31\u8BF4\u4E0D\u8FC7\u53BB\u4E86\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u771F\u662F\u573A\u7CBE\u5F69\u7684\u6BD4\u8D5B\u554A\uFF01\\n\u8FD9\u6B21\u6211\u5C31\u628A\u6700\u5F3A\u7684\u5B9D\u5EA7\\r\\n\u8BA9\u7ED9\u4F60\u4EEC\u5427\u3002[VAR 0114(0017)]"
