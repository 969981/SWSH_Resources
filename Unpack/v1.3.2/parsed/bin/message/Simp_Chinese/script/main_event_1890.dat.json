    "index": 0,
    "flags": 0,
    "text": "\u4EC0\u4E48\u2026\u2026\u600E\u4E48\u4F1A\u8FD9\u6837\uFF01\\n\u8FD9\u53EF\u8BA9\u6211\u600E\u4E48\u5E2E\u5927\u54E5\u554A\u2026\u2026\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8FD9\u4F4D\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u4F60\u5230\u5E95\u60F3\u5E72\u4EC0\u4E48\u5462\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u8981\u963B\u6B62\u95C7\u591C\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u8981\u53BB\u5E2E\u51A0\u519B\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54CE\u5440\uFF5E\uFF01\u771F\u662F\u8BA9\u4EBA\u60CA\u8BB6\u3002\\n\u4F60\u5728\u8BF4\u4EC0\u4E48\u68A6\u8BDD\u554A\uFF1F\\c\\n\u5DF2\u7ECF\u8F6E\u4E0D\u5230\u4F60\u6765\u963B\u6B62\u4E86\u3002\\c\\n\u56E0\u4E3A\u95C7\u591C\u2026\u2026\u4E0D\uFF0C\\n\u6700\u5F3A\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\r\\n\u65E0\u6781\u6C70\u90A3\u5DF2\u7ECF\u89C9\u9192\u4E86\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u90A3\u53EF\u4E0D\u884C\uFF01\\c\\n\u6211\u8FD8\u9700\u8981\u51A0\u519B\\n\u5E2E\u6211\u9A7E\u9A6D\u65E0\u6781\u6C70\u90A3\u5462\u3002[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8010\u5FC3\u5730\u542C\u6211\u8BB2\u51E0\u53E5\u3002\\c\\n\u53EF\u80FD\u5728\u4F60\u770B\u6765\uFF0C\\n\u6211\u6B63\u5728\u505A\u5F88\u8352\u5510\u7684\u4E8B\u5427\uFF1F\\r\\n\u6211\u60F3\u4F60\u5927\u6982\u4E5F\u5B8C\u5168\u4E0D\u80FD\u7406\u89E3\u3002\\c\\n\u4F46\u662F\u5462\uFF0C\u4E3A\u4E86\u8BA9\u4EBA\u4EEC\u5B89\u5C45\u4E50\u4E1A\uFF0C\\n\u4E3A\u4E86\u8BA9\u4F3D\u52D2\u5C14\u5730\u533A\u957F\u76DB\u4E0D\u8870\uFF0C\\r\\n\u5C31\u9700\u8981\u5F00\u53D1\u51FA\u65E0\u9650\u7684\u80FD\u6E90\uFF01\\r\\n\u8FD9\u662F\u6211\u7684\u4FE1\u5FF5\uFF0C\u4E5F\u662F\u6211\u7684\u4F7F\u547D\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6B63\u56E0\u4E3A\u5982\u6B64\uFF0C\\n\u6211\u624D\u4F1A\u628A\u8BB8\u613F\u661F\u4F9B\u5E94\u7ED9\u65E0\u6781\u6C70\u90A3\uFF01\\c\\n\u8BA9\u62F3\u5173\u5E02\u9677\u5165\u6DF7\u4E71\u7684\u7EA2\u5149\u2026\u2026\\c\\n\u5176\u5B9E\u4E5F\u662F\u4E3A\u4E86\u5524\u9192\u65E0\u6781\u6C70\u90A3\\n\u6240\u505A\u7684\u5C0F\u5B9E\u9A8C\uFF01\\c\\n\u542C\u597D\u4E86\uFF01\u6211\u6240\u505A\u7684\u8FD9\u4E00\u5207\\n\u90FD\u662F\u4E3A\u4E86\u4FDD\u62A4\u4F3D\u52D2\u5C14\u7684\u672A\u6765\uFF01\\r\\n\u6211\u662F\u4E0D\u4F1A\u8BA9\u4F60\u7834\u574F\u6211\u7684\u8BA1\u5212\u7684\uFF01\uFF01[VAR 0114(0006)]"
  }
]
