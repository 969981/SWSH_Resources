[
  {
    "index": 0,
    "flags": 0,
    "text": "\u60A8\u8FD9\u6837\uFF0C\u6211\u5F88\u4E3A\u96BE\u7684\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E3A\u4EC0\u4E48\u554A\uFF01\u6211\u4EEC\u5BB6\u53EF\u7231\u7684\\n\u5C0F\u590F\u590F\u4E0D\u662F\u5230\u8FD9\u91CC\u9762\u53BB\u4E86\u5417\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6CA1\u9519\uFF0C\u53EF\u662F\u2026\u2026"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u5DF2\u7ECF\u8BF4\u8FC7\u4E86\uFF0C\\n\u6211\u4E5F\u8981\u53BB\u5927\u5192\u9669\uFF01\\r\\n\u73B0\u5728\u5C31\u53BB\uFF01\u7ACB\u523B\u5C31\u53BB\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u4E5F\u5DF2\u7ECF\u8BF4\u8FC7\u4E86\uFF01\\n\u6211\u4E0D\u80FD\u6279\u51C6\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5443\u2026\u2026\u5443\u5514\uFF5E\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u55EF\uFF1F\u8FD9\u4E0D\u662F\u521A\u624D\u90A3\u4E2A\u5C0F\u4F19\u5B50\u5417\uFF1F\\n\u4F60\u771F\u7684\u6765\u4E86\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54CE\uFF1F\u8FD9\u4E0D\u662F\u521A\u624D\u90A3\u4E2A\u5C0F\u59D1\u5A18\u5417\uFF01\\n\u4F60\u771F\u7684\u6765\u4E86\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u597D\u554A\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u8FD8\u597D\u5417\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u597D\u4F60\u4E2A\u5934\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6709\u4E2A\u5570\u55E6\u7206\u4E86\u7684\u7814\u7A76\u5458\\n\u975E\u5F97\u8DDF\u6211\u8FC7\u4E0D\u53BB\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u60A8\u8BF4\u8C01\u662F\\n\u5570\u55E6\u7684\u7814\u7A76\u5458\uFF1F\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u4E0D\u8BA9\u60A8\u8FDB\u53BB\uFF0C\\n\u8FD8\u4E0D\u90FD\u662F\u56E0\u4E3A\u60A8\u4E0D\u80AF\u542C\u6211\u8BB2\u89E3\u5417\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6BD5\u7ADF\u6781\u5DE8\u5927\u5192\u9669\u8FD9\u9879\u6D3B\u52A8\\n\u548C\u5371\u9669\u603B\u662F\u5F62\u5F71\u76F8\u4F34\u7684\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u554A\uFF5E\uFF01\u6211\u6700\u53D7\u4E0D\u4E86\\n\u8FD9\u79CD\u5570\u5570\u55E6\u55E6\u7684\u73A9\u610F\u513F\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5509\u2026\u2026\u6211\u548C\u4ED6\u4ECE\u521A\u624D\u5F00\u59CB\\n\u90FD\u4E00\u76F4\u5728\u91CD\u590D\u8FD9\u6BB5\u5BF9\u8BDD\u2026\u2026"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5982\u679C\u60A8\u8BA4\u8BC6\u4ED6\u7684\u8BDD\uFF0C\\n\u4E0D\u5982\u5C31\u7531\u60A8\u6765\u542C\u6211\u8BB2\u89E3\uFF0C\u600E\u4E48\u6837\uFF1F"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u90A3\u6837\u7684\u8BDD\uFF0C\u6211\u53EF\u4EE5\u7279\u522B\u6279\u51C6\u4ED6\\n\u5728\u60A8\u7684\u966A\u540C\u4E0B\u4E00\u8D77\u8FDB\u53BB\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u554A\uFF01\u8FD9\u4E2A\u529E\u6CD5\u597D\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u62DC\u6258\u4E86\uFF01\u4F60\u5C31\u597D\u597D\u542C\\n\u90A3\u4F4D\u7814\u7A76\u5458\u8BB2\u89E3\u4E00\u4E0B\u2026\u2026\\c\\n\u7136\u540E\u966A\u6211\u4E00\u8D77\u53BB\u627E\\n\u5C0F\u590F\u590F\u5427\uFF01\u597D\u5427\uFF01\uFF1F[VAR 0114(0076)]"
