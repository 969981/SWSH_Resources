    "index": 0,
    "flags": 0,
    "text": "\u8BDD\u8BF4\u56DE\u6765\u2026\u2026\\n\u600E\u4E48\u4F1A\u6709\u8FD9\u4E48\u591A\u9053\u9986\u6311\u6218\u8005\uFF1F\\r\\n\u6211\u4EEC\u8981\u548C\u8FD9\u4E48\u591A\u4EBA\u7ADE\u4E89\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u90A3\u5BB6\u4F19\u641E\u4EC0\u4E48\u554A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u603B\u4E4B\uFF0C\u6211\u4EEC\u5FEB\u53BB\u62A5\u5230\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u662F\u9053\u9986\u6311\u6218\u8005\u5417\uFF1F\\n\u8BF7\u51FA\u793A\u4E00\u4E0B\u4F60\u7684\u63A8\u8350\u51FD\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54CE\u5440\u2026\u2026\u6211\u8FD8\u662F\u7B2C\u4E00\u6B21\\n\u770B\u5230\u51A0\u519B\u7684\u63A8\u8350\u51FD\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u7684\u4E5F\u662F\u54E6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4EC0\u4E48\uFF01\\n\u7ADF\u7136\u6709\u4E24\u4E2A\u4E39\u5E1D\u770B\u597D\u7684\u8BAD\u7EC3\u5BB6\uFF01\uFF1F\\r\\n\u4F60\u4EEC\u7A76\u7ADF\u662F\u4EC0\u4E48\u6765\u5934\u2026\u2026"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u53EB\u8D6B\u666E\uFF01\\c\\n\u662F\u4E39\u5E1D\u7684\u5F1F\u5F1F\uFF01\\n\u8FD8\u662F\u672A\u6765\u7684\u51A0\u519B\u54E6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u54CE\u3001\u554A\u3001\u597D\u7684\u2026\u2026\\n\u8BF7\u7A0D\u7B49\u4E00\u4E0B\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4E24\u4E2A\u7684\u62A5\u5230\u624B\u7EED\u90FD\u529E\u597D\u4E86\u3002\\c\\n\u63A5\u4E0B\u6765\uFF0C\\n\u8BF7\u9009\u62E9\u4F60\u4EEC\u559C\u6B22\u7684\u53F7\u7801\u3002\\c\\n\u5BF9\u4E86\uFF0C\u4F60\u4EEC\u6240\u9009\u7684\u53F7\u7801\\n\u4F1A\u6210\u4E3A\u7ADE\u6280\u670D\u4E0A\u7684\u80CC\u53F7\u54E6\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9009[VAR 01C4(0001)]\u53F7\uFF0C\u6CA1\u9519\u5427\uFF01\\n\u90A3\u6211\u5C31\u5E2E\u4F60\u767B\u8BB0\u4E86\u3002\\c\\n\u53E6\u5916\uFF0C\u8BF7\u4E8C\u4F4D\u9053\u9986\u6311\u6218\u8005\\n\u522B\u5FD8\u4E86\u6234\u4E0A\u6311\u6218\u8005\u8155\u5E26\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u660E\u5929\u5C06\u5728\u8FD9\u91CC\u4E3E\u884C\\n\u9053\u9986\u6311\u6218\u7684\u5F00\u5E55\u5F0F\u3002\\c\\n\u53C2\u52A0\u5F00\u5E55\u5F0F\u7684\u9009\u624B\\n\u53EF\u4EE5\u5728\u542B\u7F9E\u82DE\u65C5\u5E97\u4F4F\u5BBF\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F1A\u957F\u51FA\u624B\u53EF\u771F\u9614\u6C14\u554A\uFF01\\c\\n\u597D\uFF0C\u6211\u5DF2\u7ECF\u7B49\u4E0D\u53CA\u8981\u5230\\n\u542B\u7F9E\u82DE\u65C5\u5E97\u5165\u4F4F\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u77A7\u4F60\u4E1C\u5F20\u897F\u671B\u7684\u2026\u2026\\c\\n\u4E00\u770B\u4F60\u5C31\u662F\u4ECE\u5C0F\u5730\u65B9\u6765\u7684\uFF01\\n\u8C01\u8BA9\u6211\u4E5F\u4E00\u6837\u5462\u3002[VAR 0114(0042)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u7684\u63A8\u8350\u51FD\u662F\\n\u8054\u76DF\u4F1A\u957F\u7ED9\u7684\u2026\u2026\\r\\n\u6362\u53E5\u8BDD\u8BF4\uFF0C\u6211\u662F\u7CBE\u82F1\u4E2D\u7684\u7CBE\u82F1\u3002\\c\\n\u6D6A\u8D39\u6211\u7684\u65F6\u95F4\u53EF\u662F\\n\u4E00\u4EF6\u7F6A\u5B7D\u6DF1\u91CD\u7684\u4E8B\u60C5\u54E6\u3002[VAR 0114(0042)]"
  },
