[
  {
    "index": 0,
    "flags": 0,
    "text": "\u554A\u54C8\uFF01\u627E\u5230\u4F60\u5566\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\u90A3\u4F4D\u7531\u6211\u5F15\u8DEF\u7684\u65C5\u4EBA\\n\u5E94\u8BE5\u5C31\u662F\u4F60\u5427\u3002[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6B63\u6B63\u597D\u597D\u5C31\u662F\u7EA6\u5B9A\u7684\u65F6\u95F4\uFF01\\n\u770B\u4F60\u5E74\u7EAA\u8F7B\u8F7B\u7684\uFF0C\u8FD8\u771F\u662F\u9760\u8C31\u5440\uFF5E\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4E0E\u7EA6\u5B9A\u7684\u65F6\u95F4\u5206\u6BEB\u4E0D\u5DEE\u2026\u2026\\n\u4F60\u7684\u6001\u5EA6\u503C\u5F97\u8868\u626C\u3002[VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54CE\u5440\uFF5E\uFF1F\\n\u4F60\u548C\u6211\u662F\u4E0D\u662F\u5728\u54EA\u91CC\u89C1\u8FC7\u5440\uFF5E\uFF1F\\r\\n\u2026\u2026\u7B97\u4E86\uFF0C\u4E0D\u7BA1\u5566\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u55EF\uFF1F\u6211\u4EEC\u662F\u4E0D\u662F\\n\u66FE\u7ECF\u5728\u54EA\u91CC\u89C1\u8FC7\u9762\u5462\uFF1F\\c\\n\u2026\u2026\u554A\u554A\uFF0C\u600E\u4E48\u77AC\u95F4\u5931\u5FC6\u4E86\u3002\\n\u73B0\u5728\u7684\u6211\u7B80\u76F4\u5C31\u50CF\u53EA\u5446\u5446\u517D\u3002[VAR 0114(0042)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u53EB\u514B\u62C9\u62C9\uFF01\\n\u662F\u4F60\u7684\u524D\u8F88\u54E6\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u53EB\u8D5B\u5B9D\u5229\uFF0C\\n\u7B97\u662F\u4F60\u7684\u524D\u8F88\u3002[VAR 0114(0072)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u524D\u8F88\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u662F\u4E0D\u662F\u8BA4\u9519\u4EBA\u4E86\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u771F\u662F\u7684\uFF01\u4F60\u4E0D\u662F\u4ECE\u4ECA\u5929\u5F00\u59CB\\n\u8981\u8FDB\u9A6C\u5E08\u5085\u6B66\u9986\u62DC\u5E08\u5B66\u827A\u5417\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u8BF4\u7684\u662F\u4F60\u63A5\u4E0B\u6765\u8FDB\u5165\\n\u9A6C\u5E08\u5085\u6B66\u9986\u62DC\u5E08\u5B66\u827A\u4E4B\u540E\u7684\u4E8B\u3002[VAR 0114(0072)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u54CE\u5440\u2026\u2026\uFF1F\u96BE\u4E0D\u6210\u6211\u8BA9\\n\u8FD9\u4E2A\u5C0F\u670B\u53CB\u7ED9\u6349\u5F04\u4E86\uFF1F\\c\\n\u4EBA\u5BB6\u53EF\u662F\u8D85\u7EA7\u65E0\u654C\\n\u5B8C\u7F8E\u53EF\u7231\u7684\u514B\u62C9\u62C9\u8036\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u7406\u89E3\u80FD\u529B\u7ADF\u7136\u5DEE\u5230\u8FD9\u4E2A\u4EFD\u4E0A\uFF0C\\n\u7B80\u76F4\u5C31\u50CF\u53EA\u98A4\u6296\u4E8E\u8FF7\u9014\u7684\u6BDB\u8FAB\u7F8A\u3002\\c\\n\u770B\u6765\u8FD8\u5F97\u7531\u4F18\u96C5\u7684\u672C\u4EBA\u5C55\u73B0\u6210\u719F\u98CE\u8303\uFF0C\\n\u9886[VAR 1100(00FF,0101)]\u4ED6\u5979\u5165\u95E8\u4E86\u3002[VAR 0114(0072)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u60F3\u60F3\u54E6\u2026\u2026\u9996\u5148\u8FD8\u662F\u901A\u8FC7\u5BF9\u6218\u6765\\n\u8BA9\u4F60\u4E86\u89E3\u4E00\u4E0B\u6211\u7684\u5B9E\u529B\u597D\u5566\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u2026\u2026\u90A3\u4E48\uFF0C\u6211\u4EEC\u5C31\u5148\u76F8\u4E92\u5C55\u73B0\u4E00\u4E0B\u5B9E\u529B\uFF0C\\n\u52A0\u6DF1\u4E00\u4E0B\u5F7C\u6B64\u4E4B\u95F4\u7684\u4EA4\u6D41\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u90A3\u6211\u5C31\u53BB\u5916\u9762\u7B49\u4F60\u5566\uFF01\\n\u51C6\u5907\u597D\u4E86\u5C31\u8FC7\u6765\u5427\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6211\u4F1A\u5728\u5916\u9762\u7B49\u4F60\u7684\uFF0C\\n\u505A\u597D\u51C6\u5907\u4E4B\u540E\u5C31\u6765\u627E\u6211\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u770B\u6211\u7ED9\u4F60\u70B9\u5389\u5BB3\u5C1D\u5C1D\u2026\u2026\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u4F1A\u8BA9\u4F60\u660E\u767D\u4E00\u4E2A\u4E8B\u5B9E\uFF0C\\n\u90A3\u5C31\u662F\u6211\u7684\u5B9E\u529B\u5728\u4F60\u4E4B\u4E0A\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6211\u4ECE\u4ECA\u5929\u8D77\u8981\u5728\u8FD9\u4E2A\u5C9B\u4E0A\u7684\\n\u6B66\u9986\u62DC\u5E08\u5B66\u827A\u2026\u2026\\c\\n\u53EF\u662F\u9A7F\u7AD9\u524D\u9762\u6709\u4E2A\u5947\u602A\u7684\u4EBA\uFF0C\\n\u6211\u597D\u7EA0\u7ED3\u5230\u5E95\u8BE5\u4E0D\u8BE5\u51FA\u53BB\u2026\u2026"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u521A\u624D\u90A3\u4E2A\u662F\u6B66\u9986\u7684\u4EBA\u5417\uFF1F\\n\u2026\u2026\u90A3\u6211\u8FD8\u662F\u522B\u53BB\u4E3A\u5999\u554A\u3002\\r\\n\u4F60\u8981\u4E0D\u8981\u4EE3\u66FF\u6211\u5165\u95E8\u5B66\u827A\uFF1F"
  }
]
