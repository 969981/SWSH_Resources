[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6C34\u821F\u9547"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5341\u5206\u62B1\u6B49\uFF01\\n\u4F1A\u957F\u73B0\u5728\u975E\u5E38\u7E41\u5FD9\u2026\u2026\\c\\n\u4ECA\u5929\u5C31\u5230\u8FD9\u91CC\u4E86\uFF01\\n\u5404\u4F4D\u8BF7\u56DE\u5427\uFF01\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u597D\u5427\uFF5E\\n\u4F1A\u957F\uFF0C\u518D\u89C1\u5566\u266A"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u554A\uFF0C\u5404\u4F4D\u2026\u2026\\n\u6211\u8FD8\u6709\u65F6\u95F4\u4E3A\u5927\u5BB6\u7B7E\u540D\u554A\u3002\\c\\n\u800C\u4E14\u6211\u8FD8\u8981\u628A\u81EA\u5DF1\u7684\u5B9D\u53EF\u68A6\u8054\u76DF\u5361\\n\u4E5F\u9001\u7ED9\u5927\u5BB6\u54E6\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u4EEC\u7684\u4E8B\u4E1A\u53D1\u5C55\\n\u79BB\u4E0D\u5F00\u7C89\u4E1D\u4EEC\u7684\u652F\u6301\u3002\\c\\n\u5965\u5229\u8587\uFF0C\u4F60\u628A\u4ED6\u4EEC\u8F70\u8D70\u2026\u2026\\n\u662F\u4E0D\u662F\u592A\u65E0\u60C5\u4E86\u554A\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5584\u5F85\u7C89\u4E1D\u56FA\u7136\u91CD\u8981\u3002\\n\u4F46\u662F\u4F1A\u957F\uFF0C\u4E3A\u4E86\u7C89\u4E1D\uFF0C\\r\\n\u60A8\u66F4\u662F\u9700\u8981\u597D\u597D\u5DE5\u4F5C\u554A\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\uFF0C\\n\u6211\u4E5F\u4F1A\u4E3A\u60A8\u5C3D\u5168\u529B\u7684\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u55EF\uFF1F\\n\u6211\u8BB0\u5F97\u4F60\u662F\u2026\u2026[VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u662F\u5F7C\u7279\u3002[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5BF9\u5BF9\u5BF9\uFF01\u4F60\u662F\u5F7C\u7279\uFF01\\n\u548C\u6211\u9001\u4F60\u5B9D\u53EF\u68A6\u90A3\u65F6\u5019\u76F8\u6BD4\uFF0C\\r\\n\u73B0\u5728\u7684\u4F60\u771F\u662F\u8BA9\u4EBA\u522E\u76EE\u76F8\u770B\u554A\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u60F3\uFF0C\u80FD\u5728\u9053\u9986\u6311\u6218\u4E2D\u664B\u7EA7\u7684\\n\u4E0D\u662F\u4F60\uFF0C\u5C31\u662F\u2026\u2026\\r\\n\u51A0\u519B\u63A8\u8350\u7684\u8BAD\u7EC3\u5BB6\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u662F\u4F1A\u957F\u60A8\u4EB2\u81EA\u63A8\u8350\u7684\uFF0C\\n\u7EDD\u5BF9\u4E0D\u4F1A\u8F93\u7ED9\u4EFB\u4F55\u4EBA\uFF01\\r\\n\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u5148\u5931\u966A\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u662F[VAR 0100(0000)]\u5427\uFF01\\c\\n\u6211\u4E5F\u5F88\u597D\u5947\u4E39\u5E1D\u4E3A\u4EC0\u4E48\u4F1A\u63A8\u8350\u4F60\u54E6\u3002[VAR 0114(0006)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF01\u60F3\u5230\u4E00\u4E2A\u597D\u4E3B\u610F\uFF01\\n\u6211\u771F\u662F\u592A\u6709\u624D\u4E86\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4F60\u63A5\u4E0B\u6765\u8981\u53BB\u6311\u6218\u9053\u9986\u9986\u4E3B\u9732\u7483\u5A1C\uFF0C\\n\u6CA1\u9519\u5427\uFF1F\\c\\n\u7B49\u4F60\u62FF\u5230\u9053\u9986\u5FBD\u7AE0\u540E\uFF0C\\n\u8BA9\u6211\u4E3A\u4F60\u597D\u597D\u5E86\u795D\u4E00\u4E0B\u5427\uFF01\\r\\n\u6B63\u597D\u6211\u4E5F\u60F3\u591A\u4E86\u89E3\u4E00\u4E0B\u4F60\u3002[VAR 0114(0006)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4F1A\u957F\uFF0C\\n\u60A8\u7684\u65F6\u95F4\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4E3A\u4E86\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u672A\u6765\uFF0C\\n\u4F60\u8981\u597D\u597D\u52A0\u6CB9\u554A\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4F1A\u957F\u4F1A\u5728\u9547\u4E0A\u7684\u6D77\u9C9C\u9910\u5385\u6446\u4E0B\u5BB4\u5E2D\u3002\\c\\n\u8BF7\u4F60\u5C3D\u5FEB\u8D62\u4E0B\u9053\u9986\u5FBD\u7AE0\uFF0C\\n\u4E0D\u8981\u6D6A\u8D39\u6211\u4EEC\u7684\u65F6\u95F4\u3002[VAR 0114(0007)]"
  }
]
