[
  {
    "index": 0,
    "flags": 0,
    "text": "\u706B\u54D7\u54D7\u54D7\uFF5E"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u55E8\uFF5E\uFF01\u8FD9\u513F\u662F\u9971\u4F2F\u7684\u5E97\u3002\\n\u6211\u4F1A\u8BA9\u4F60\u54C1\u5C1D\u5230\u5F88\u591A\u7F8E\u5473\u7684\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u6302\u6BEF\u5F88\u6F02\u4EAE\u5427\u3002\\n\u662F\u4ECE\u53E4\u8463\u5E02\u573A\u4E70\u56DE\u6765\u7684\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8981\u5148\u9971\u9971\u5730\u5403\u4E00\u987F\\n\u624D\u80FD\u53BB\u6BD4\u8D5B\u554A\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6B63\u6240\u8C13\u9152\u9999\u4E0D\u6015\u5DF7\u5B50\u6DF1\uFF0C\\n\u8FD9\u6599\u7406\u53EF\u662F\u8E0F\u7834\u94C1\u978B\u90FD\\r\\n\u4E0D\u5BB9\u9519\u8FC7\u7684\u7F8E\u5473\u54E6\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5403\u996D\u7684\u65F6\u5019\u8C08\u4EC0\u4E48\u5DE5\u4F5C\uFF1F\\n\u662F\u4E0D\u60F3\u597D\u597D\u5403\u996D\u4E86\u5417\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FD9\u70E4\u5F97\u592A\u6070\u5230\u597D\u5904\u4E86\uFF01\\c\\n\u7B80\u76F4\u662F\u9C9C\u5AE9\u591A\u6C41\uFF0C\\n\u8FD8\u56BC\u52B2\u5341\u8DB3\uFF01\\r\\n\u771F\u5F97\u597D\u597D\u5938\u5938\u8FD9\u4E2A\u53A8\u5E08\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5B69\u5B50\u5403\u5F97\u4E00\u8138\u5E78\u798F\u7684\u6837\u5B50\uFF0C\\n\u8BA9\u6211\u4E0D\u7531\u5F97\u6CE8\u89C6\u4E86\u8BB8\u4E45\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5B9E\u5728\u662F\u592A\u597D\u5403\u4E86\u3002\\c\\n\u771F\u60F3\u505A\u51FA\u540C\u6837\u7684\u5473\u9053\uFF0C\\n\u8BA9\u5B9D\u53EF\u68A6\u4E5F\u5C1D\u4E00\u5C1D\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD9\u662F\u4E00\u5F20\u6302\u6BEF\u3002\\n\u753B\u4E2D\u63CF\u7ED8\u4E86\u2026\u2026\\c\\n\u5931\u53BB\u4E86\u5251\u4E0E\u76FE\u7684\\n\u4E24\u4F4D\u82F1\u96C4\u2026\u2026"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6302\u5728\u8FD9\u91CC\u7684\u58C1\u6BEF\uFF0C\\n\u597D\u50CF\u5728\u54EA\u91CC\u89C1\u8FC7\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9971\u4F2F\u8001\u677F\u7684\u8096\u50CF\u753B\uFF01\\n\u4ED6\u662F\u4E00\u4E2A\u8BB2\u7A76\u706B\u5019\u7684\u7537\u4EBA\u3002"
  }
]
