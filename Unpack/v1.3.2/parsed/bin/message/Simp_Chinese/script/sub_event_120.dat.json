[
  {
    "index": 0,
    "flags": 0,
    "text": "\u55EF\uFF1F\\n\u627E\u6211\u6709\u4E8B\u5417\uFF1F\\r\\n\u55EF\u2026\u2026\u2026\u2026\\c\\n\u7B49\u4F60\u7684\u5B9E\u529B\u5F3A\u5230\u80FD\u6210\u4E3A\u51A0\u519B\u7684\u65F6\u5019\uFF0C\\n\u518D\u6765\u8FD9\u91CC\u627E\u6211\u5427\u3002[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54A6\uFF1F\u4F60\u771F\u7684\u6210\u4E3A\u51A0\u519B\u4E86\uFF1F\\n\u4F60\u5B9E\u5728\u662F\u592A\u5389\u5BB3\u4E86\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u662F\u68EE\u672C\u3002\\c\\n\u6211\u4E00\u76F4\u7B49\u7740\u7684\u5C31\u662F\\n\u50CF\u4F60\u8FD9\u6837\u5F3A\u5927\u7684\u8BAD\u7EC3\u5BB6\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u5BF9\u81EA\u5DF1\u7684\u5B9E\u529B\u6709\u81EA\u4FE1\uFF0C\\n\u5C31\u548C\u6211\u6765\u6BD4\u8BD5\u4E00\u4E0B\u5427\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD9\u6837\u554A\u3002\\n\u771F\u662F\u9057\u61BE\uFF5E"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u54A6\uFF1F\u5982\u679C\u6CA1\u6709\uFF12\u53EA\u5145\u6EE1\u6D3B\u529B\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5C31\u6CA1\u529E\u6CD5\u5BF9\u6218\u4E86\uFF5E"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FD9\u624D\u5BF9\u561B\uFF01\\n\u8BA9\u6211\u4EEC\u6765\u573A\u7D27\u5F20\u523A\u6FC0\u7684\u5BF9\u6218\u5427\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u771F\u7684\u597D\u5F3A\u554A\uFF5E\uFF01\\n\u4E0D\u6127\u662F\u51A0\u519B\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F5C\u4E3A\u6218\u80DC\u6211\u7684\u7EAA\u5FF5\uFF0C\\n\u5C31\u9001\u4F60\u4E00\u4E2A\u597D\u4E1C\u897F\u5427\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6709\u673A\u4F1A\u518D\u6765\u5BF9\u6218\u5427\uFF5E"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6BCF\u6B21\u4E0E\u4F60\u5BF9\u6218\u90FD\u662F\u523A\u6FC0\u4E07\u5206\u554A\u3002\\n\u6709\u673A\u4F1A\u518D\u6765\u4E00\u8F83\u9AD8\u4E0B\u5427\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4ECA\u5929\u6211\u5DF2\u7ECF\u5F88\u7D2F\u4E86\uFF0C\\n\u660E\u5929\u518D\u5BF9\u6218\u5427\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u54E6\uFF0C\u6211\u7B49\u4F60\u5F88\u4E45\u4E86\u3002\\n\u6765\u573A\u5B9D\u53EF\u68A6\u5BF9\u6218\u5427\uFF1F"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u2026\u2026\u6211\u6254\uFF01\u2026\u2026\u6211\u6254\uFF01\\n\u600E\u4E48\u6349\u90FD\u6349\u4E0D\u4F4F\u2026\u2026\\c\\n\u54CE\u5440\uFF1F\u4F60\u2026\u2026\\n\u770B\u8D77\u6765\u5F88\u4F1A\u6254\u7CBE\u7075\u7403\u554A\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u662F\u6E38\u620F\u7B56\u5212\uFF01\\c\\n\u8BBE\u8BA1\u6E38\u620F\u5185\u5BB9\u662F\u6211\u7684\u5DE5\u4F5C\uFF0C\\n\u73A9\u6E38\u620F\u5F53\u7136\u4E5F\u662F\u6211\u7684\u5DE5\u4F5C\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u623F\u95F4\u91CC\u64AD\u653E\u7684\u90A3\u4E9B\u80CC\u666F\u97F3\u4E50\u2026\u2026\\n\u5176\u5B9E\u662F\u6211\u5236\u4F5C\u7684\u54E6\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u662F\u4E3A\u4E86\u91C7\u8BBF\u6765\u4F3D\u52D2\u5C14\u7684\u3002\\n\u8FD9\u91CC\u771F\u662F\u4E2A\u597D\u5730\u65B9\u554A\uFF01\\c\\n\u5728\u8FD9\u91CC\u53EF\u4EE5\u4EAB\u53D7\u5230\u5404\u79CD\\n\u5173\u90FD\u5730\u533A\u4EBA\u6C14\u8D85\u9AD8\u7684\u5496\u55B1\u914D\u6599\uFF0C\\r\\n\u7B80\u76F4\u5C31\u662F\u5496\u55B1\u5929\u5802\u554A\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4F60\u559C\u6B22\u5B9D\u53EF\u68A6\u5417\uFF1F"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u8C22\u8C22\uFF01\\n\u4ECE\u4ECA\u4EE5\u540E\u4E5F\u8BF7\u4E00\u76F4\u559C\u6B22\u5B83\u4EEC\u54E6\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u660E\u767D\u4E86\uFF01\u4F60\u4E0D\u662F\u4E0D\u559C\u6B22\u5B9D\u53EF\u68A6\uFF0C\\n\u800C\u662F\u8D85\u7EA7\u559C\u6B22\u5B9D\u53EF\u68A6\u5BF9\u5427\uFF01\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u6211\u8FF7\u4E0A\u6D1B\u6258\u59C6\u8D8A\u91CE\u8D5B\u4E86\uFF01"
  }
