[
  {
    "index": 0,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u6211\u7B49\u6765\u7684\\n\u9053\u9986\u6311\u6218\u8005\u771F\u7684\u662F\u4F60\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F\u4E39\u5E1D\u770B\u597D\u7684\u8BAD\u7EC3\u5BB6\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u77E5\u9053\u8981\u6218\u80DC\u4E39\u5E1D\u2026\u2026\\n\u662F\u4E00\u4EF6\u591A\u56F0\u96BE\u7684\u4E8B\u5417\uFF1F\\c\\n\u8EAB\u4E3A\u90A3\u5BB6\u4F19\u7684\u52B2\u654C\uFF0C\\n\u5C31\u8BA9\u6211\u5947\u5DF4\u7EB3\u6765\u6559\u5BFC\u4E00\u4E0B\u4F60\u5427\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u9053\u9986\u9986\u4E3B\u5947\u5DF4\u7EB3\u4E0D\u53EA\u4F1A\u63A7\u5236\u5929\u6C14\uFF0C\\n\u8FD8\u4F1A\u91C7\u7528\uFF12\u5BF9\uFF12\u7684\u5BF9\u6218\u65B9\u5F0F\uFF01\\c\\n\u6CA1\u9519\uFF01\u6211\u5C31\u662F\u8981\u8003\u6838\\n\u6311\u6218\u8005\u80FD\u5426\u5BF9\u5E94\u6240\u6709\u7684\u72B6\u51B5\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6FC0\u70C8\u7684\u5BF9\u6218\u7ED3\u675F\u4E86\u2026\u2026\\c\\n\u6211\u73B0\u5728\u7684\u5FC3\u60C5\u5C31\u50CF\\n\u4E07\u91CC\u6674\u7A7A\u4E00\u6837\u6E05\u65B0\u8212\u7545\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u624D\u602A\uFF01\\n\u8FD9\u6837\u7684\u8BDD\u6211\u600E\u4E48\u53EF\u80FD\u8BF4\u5F97\u51FA\u53E3\uFF01\\c\\n\u6211\u7B97\u4EC0\u4E48\u5462\uFF1F\u4E39\u5E1D\u7684\u52B2\u654C\uFF1F\\n\u65E2\u7136\u6211\u6839\u672C\u4E0D\u662F\u51A0\u519B\uFF0C\\r\\n\u90A3\u6211\u548C\u6211\u7684\u5B9D\u53EF\u68A6\u662F\u5728\u56A3\u5F20\u4EC0\u4E48\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FD9\u662F\u9F99\u4E4B\u5FBD\u7AE0\uFF01\u8D4F\u7ED9\u4F60\u4E86\uFF01\\n\u4E5F\u7B97\u662F\u4F60\u6218\u80DC\u6211\u7684\u51ED\u8BC1\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u53EF\u4EE5\u6355\u6349\u6240\u6709\u7B49\u7EA7\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8FD9\u6837\u4E00\u6765\uFF0C\u4F60\u4E5F\u5C31\u96C6\u9F50\\n\u4F3D\u52D2\u5C14\u5730\u533A\u6240\u6709\u7684\u9053\u9986\u5FBD\u7AE0\u4E86\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u60F3\u6311\u6218\u51A0\u519B\u4E39\u5E1D\u7684\u8BDD\uFF0C\\n\u5C31\u4E89\u53D6\u4ECE\u6DD8\u6C70\u8D5B\u4E2D\u8131\u9896\u800C\u51FA\u5427\uFF01\\c\\n\u4E0D\uFF0C\u4F60\u975E\u8D62\u4E0D\u53EF\uFF01\\c\\n\u6CA1\u9519\uFF01\u4E0D\u5149\u662F\u4E3A\u4E86\u4F60\u81EA\u5DF1\uFF0C\\n\u4E5F\u662F\u4E3A\u4E86\u6211\u4EEC\u80FD\u6709\u673A\u4F1A\u4E00\u96EA\u524D\u803B\u554A\uFF01\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u96C6\u9F50\u4E86\u6240\u6709\u9053\u9986\u5FBD\u7AE0\u2026\u2026\\n\u7EC8\u4E8E\u8981\u53BB\u6311\u6218\u51A0\u519B\u676F\u4E86\u554A\uFF01\\r\\n\u6211\u5F88\u671F\u5F85\u4F60\u4EEC\u80FD\u5927\u663E\u8EAB\u624B\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u5B8C\u6210\u4E86\u9053\u9986\u6311\u6218\uFF01\\n\u6211\u4ECE\u5FC3\u5E95\u5BF9\u4F60\u8868\u793A\u795D\u8D3A\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u8981\u56DE\u5230\u62A5\u5230\u5904\u5417\uFF1F"
  }
]
