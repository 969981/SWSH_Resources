[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8D6B\u666E\uFF01\\n[VAR 0100(0000)]\uFF01\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54A6\uFF1F\u2026\u2026\u5927\u54E5\uFF1F\\n\u60F3\u4E0D\u5230\u4F60\u8FD9\u4E2A\u8DEF\u75F4\u8FD8\u771F\u627E\u5230\u6211\u4EEC\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u5C0F\u5B50\u8BA9\u6211\u8FD9\u4E48\u62C5\u5FC3\uFF0C\\n\u5634\u91CC\u8FD8\u4E0D\u9976\u4EBA\uFF01\\c\\n\u6211\u5DE6\u7B49\u53F3\u7B49\u7B49\u4E0D\u5230\u4F60\u4EEC\uFF0C\\n\u6240\u4EE5\u624D\u4F1A\u6765\u627E\u4EBA\u554A\u3002[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u6BDB\u8FAB\u7F8A\u5462\u2026\u2026\uFF01\uFF1F\\n\u6211\u4EEC\u662F\u6765\u6551\u6BDB\u8FAB\u7F8A\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6BDB\u54A9\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5B83\u6CA1\u4E8B\u3002\\c\\n\u4E0D\u8FC7\u6211\u521A\u624D\u5230\u8FD9\u91CC\u7684\u65F6\u5019\uFF0C\\n\u4F60\u4EEC\u5168\u90FD\u660F\u5012\u5728\u5730\u4E0A\u3002\\c\\n\u4E8B\u60C5\u7684\u6765\u9F99\u53BB\u8109\u6211\u4E86\u89E3\u4E86\u3002\\n\u64C5\u95EF\u68EE\u6797\u662F\u8BE5\u597D\u597D\u9A82\u4E00\u987F\u2026\u2026\\c\\n\u4F46\u6211\u627F\u8BA4\uFF0C\u4F60\u4EEC\u52C7\u6C14\u53EF\u5609\uFF01\\n\u597D\u6837\u7684\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u771F\u4E0D\u9519\u554A\uFF0C[VAR 0100(0000)]\u3002\\c\\n\u867D\u7136\u6211\u4EEC\u88AB\u6D53\u96FE\u56E2\u56E2\u5305\u56F4\uFF0C\\n\u8FD8\u548C\u795E\u79D8\u5B9D\u53EF\u68A6\u6765\u4E86\u573A\u5BF9\u6218\uFF0C\\r\\n\u4F46\u770B\u6765\u4E5F\u7B97\u6CA1\u6709\u767D\u6765\u4E00\u8D9F\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u795E\u79D8\u5B9D\u53EF\u68A6\u2026\u2026\uFF1F\\n\u4F60\u4EEC\u7A76\u7ADF\u9047\u5230\u4E86\u4EC0\u4E48\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u4EEC\u9047\u5230\u4E00\u53EA\u8D85\u6709\u5A01\u4E25\uFF0C\\n\u5B58\u5728\u611F\u7206\u68DA\u7684\u5B9D\u53EF\u68A6\u3002\\r\\n\u5947\u602A\u7684\u662F\uFF0C\u62DB\u5F0F\u5BF9\u5B83\u5B8C\u5168\u4E0D\u594F\u6548\u2026\u2026\\r\\n\u6216\u8005\u8BF4\u62DB\u5F0F\u4F1A\u7A7F\u900F\u8FC7\u53BB\uFF0C\u5A01\u529B\u5168\u65E0\u3002[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u62DB\u5F0F\u4F1A\u7A7F\u900F\u8FC7\u53BB\u2026\u2026\uFF1F\\c\\n\u96BE\u9053\u4F20\u95FB\u4E2D\u5728\u5FAE\u5BD0\u68EE\u6797\u91CC\u7684\\n\u5B9D\u53EF\u68A6\u662F\u5E7B\u5F71\u5417\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u53EA\u8981\u4F60\u4EEC\u597D\u597D\u953B\u70BC\uFF0C\u53D8\u5F97\u66F4\u5F3A\uFF0C\\n\u8BF4\u4E0D\u5B9A\u6709\u4E00\u5929\u5C31\u4F1A\u89E3\u5F00\u8FD9\u4E2A\u8C1C\u9898\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u4EEC\u5148\u79BB\u5F00\u5FAE\u5BD0\u68EE\u6797\u5427\u3002\\n\u6709\u6211\u966A\u7740\u4F60\u4EEC\uFF0C\u5C3D\u7BA1\u653E\u5FC3\u597D\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u867D\u7136\u6328\u4E86\u5927\u54E5\u4E00\u987F\u9A82\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F46\u662F\u8FD9\u6B21\u7684\u7ECF\u5386\u592A\u523A\u6FC0\u4E86\uFF01\\n\u8FD9\u4E00\u5B9A\u4F1A\u6210\u4E3A\u6211\u4F20\u8BF4\u4E2D\u7684\u91CD\u8981\u4E00\u9875\uFF01[VAR 0114(0005)]"
  },
