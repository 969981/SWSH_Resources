    "index": 0,
    "flags": 0,
    "text": "\u8FD9\u76C6\u690D\u7269\u679D\u7E41\u53F6\u8302\uFF0C\\n\u4E00\u770B\u5C31\u662F\u5E73\u65F6\u6709\u4EBA\u5728\u7CBE\u5FC3\u6253\u7406\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u767D\u677F\u4E0A\u5BC6\u5BC6\u9EBB\u9EBB\u5199\u6EE1\u4E86\\n\u5185\u5BB9\u4E0D\u660E\u7684\u7B14\u8BB0\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u96F7\u8FBE\u4E0A\u7684\u6570\u636E\u5728\u4E0D\u505C\u5730\u53D8\u5316\uFF0C\\n\u50CF\u662F\u6B63\u5728\u76D1\u6D4B\u7740\u4EC0\u4E48\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[~ 3]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u80D6\u6C6A\u6C6A\u6C6A\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uFF1C\u5173\u4E8E\u5B9D\u53EF\u68A6\u7684\u53D8\u5316\uFF1E\\n\u5B9D\u53EF\u68A6\u4E0D\u4EC5\u4F1A\u56E0\u4E3A\\n\u7B49\u7EA7\u63D0\u5347\u800C\u6539\u53D8\u6837\u5B50\uFF0C\\n\u8FD8\u4F1A\u56E0\u9053\u5177\u7684\u5F71\u54CD\u6216\\n\u573A\u6240\u800C\u4F7F\u6837\u5B50\u4EA7\u751F\u53D8\u5316\u3002\\c\\n\u636E\u63A8\u6D4B\u662F\u7531\u8574\u85CF\u5728\\n\u5B9D\u53EF\u68A6\u4F53\u5185\u7684\u67D0\u79CD\u56E0\u5B50\\n\u800C\u4F7F\u5B83\u4EEC\u7684\u6837\u8C8C\u548C\u6027\u8D28\u53D1\u751F\u6539\u53D8\u3002\\n\u4F46\u81F3\u4ECA\u4ECD\u6CA1\u6709\u627E\u5230\u51B3\u5B9A\u6027\u7684\u8BC1\u636E\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uFF1C\u4F55\u8C13\u6781\u5DE8\u5316\uFF1E\\n\u5F53\u5B9D\u53EF\u68A6\u5DE8\u5927\u5316\u65F6\u88AB\u79F0\u4E3A\u6781\u5DE8\u5316\u3002\\n\u76EE\u524D\u786E\u8BA4\u4EC5\u5728\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u7279\u5B9A\u573A\u6240\uFF0C\\n\u4E14\u5728\u7279\u5B9A\u7684\u6761\u4EF6\u4E0B\u624D\u4F1A\u53D1\u751F\u6781\u5DE8\u5316\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uFF1C\u5B9D\u53EF\u68A6\u7684\u5DE8\u5927\u5316\uFF1E\\n\u57FA\u672C\u4E0A\u5B9D\u53EF\u68A6\u8FDB\u5316\u540E\\n\u5C31\u4F1A\u53D8\u5F97\u53C8\u5F3A\u53C8\u5927\u3002\\n\u4EE5\u53D8\u5927\u7684\u8EAB\u4F53\u793A\u4EBA\\n\u5176\u5B9E\u662F\u4E00\u79CD\u751F\u5B58\u7684\u672C\u80FD\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u597D\u4E45\u4E0D\u89C1\u554A\uFF0C\\n\u51A0\u519B[VAR 0100(0000)]\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E4B\u524D\u771F\u7684\u5F88\u62B1\u6B49\uFF0C\\n\u8BA9[VAR 0101(0001)]\u56E0\u4E3A\u6211\u4EEC\u800C\u5931\u53BB\u63A7\u5236\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7D22\u5FB7\u5927\u4EBA\u3001\u897F\u5C14\u8FEA\u5927\u4EBA\u548C\u6211\uFF0C\\n\u90FD\u5728\u4E3A\u4E86\u8865\u507F\u81EA\u5DF1\u72AF\u4E0B\u7684\u7F6A\u8FC7\uFF0C\\r\\n\u52AA\u529B\u505A\u4E49\u5DE5\u5462\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\u535A\u58EB\u4E5F\u771F\u662F\u7684\uFF0C\u7ADF\u7136\\n\u62DC\u6258\u66FE\u7ECF\u9A97\u8FC7\u5979\u4E00\u6B21\u7684\u4EBA\u770B\u5BB6\u2026\u2026\\c\\n\u5979\u53EF\u771F\u662F\u4E2A\u4E86\u4E0D\u5F97\u7684\u4EBA\u7269\u554A\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u641E\u6765\u641E\u53BB\uFF0C\u6211\u8FD8\u662F\\n\u56DE\u5230\u8FD9\u91CC\u7EE7\u7EED\u5DE5\u4F5C\u4E86\u3002\\c\\n\u8FD9\u6B21\u6211\u4F1A\u771F\u5FC3\u5B9E\u610F\u5730\\n\u5E2E\u5FD9\u54E6\u2026\u2026\u5475\u5475\u5475\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u591A\u8C22\u4F60\u5728\u738B\u51A0\u96EA\u539F\u7684\u65B0\u53D1\u73B0\uFF01\\c\\n\u6211\u6B63\u5FD9\u7740\u6574\u7406\u6210\u8BBA\u6587\u5462\uFF5E\\n\u8981\u5199\u7684\u4E1C\u897F\u592A\u591A\uFF0C\u6101\u6B7B\u4EBA\u5566\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4EC0\u4E48\uFF5E\uFF01\uFF1F\u9664\u4E86\u52FE\u5E15\u8DEF\u7FC1\u3001\\n\u4EE3\u62C9\u57FA\u7FC1\u3001\u6BD5\u529B\u5409\u7FC1\u4E4B\u5916\uFF0C\\r\\n\u7ADF\u7136\u8FD8\u6709\u7B2C\uFF14\u53EA\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5443\u5443\u2026\u2026\u65E9\u77E5\u9053\u8FD9\u6837\\n\u5C31\u518D\u575A\u6301\u4E00\u4E0B\u4E86\u2026\u2026[VAR 0114(000B)]"
