  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F[VAR 0100(0000)]\u554A\uFF01\\n\u8C22\u8C22\u4F60\u7684\u62A5\u544A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u597D\u4E2A\u4F3D\u52D2\u5C14\u660E\u661F\u8D5B\uFF0C\\n\u5927\u54E5\u7684\u70B9\u5B50\u4E5F\u592A\u7EDD\u4E86\u5427\uFF01\\c\\n\u867D\u7136\u6211\u5E94\u8BE5\u4EE5\u5B66\u4E60\u4E3A\u91CD\uFF0C\\n\u4F46\u65E2\u7136\u8981\u6BD4\u8D5B\uFF0C\u6211\u5C31\u8981\u52AA\u628A\u529B\u5566\uFF01[VAR 0114(0005)]"
