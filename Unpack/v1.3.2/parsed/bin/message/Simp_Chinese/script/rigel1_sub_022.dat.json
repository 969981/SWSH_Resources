[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5582\uFF0C[VAR 0100(0000)]\uFF0C\\n\u4F60\u80FD\u4E0D\u80FD\u966A\u6211\\r\\n\u4E00\u8D77\u8BAD\u7EC3\u4E00\u4E0B\u554A\uFF5E\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u554A\uFF0C\u6211\u8BF4\uFF0C[VAR 0100(0000)]\uFF0C\\n\u6211\u60F3\u8BAD\u7EC3\u4E00\u4E0B\uFF0C\\r\\n\u4F60\u613F\u4E0D\u613F\u610F\u5949\u966A\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u554A\u54C8\uFF01\u60F3\u4E0D\u5230\u4F60\u7ADF\u7136\\n\u662F\u4E2A\u8D85\u7EA7\u65E0\u654C\u5927\u5FD9\u4EBA\u5440\uFF5E\\r\\n\u2026\u2026\u660E\u660E\u770B\u8D77\u6765\u90A3\u4E48\u95F2\u7684\u8BF4\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5443\u5443\uFF0C\u771F\u662F\u9057\u61BE\u3002\\n\u4F60\u5C31\u8FD9\u6837\u62D2\u7EDD\u4E86\u6211\u2026\u2026\\r\\n\u6211\u4F1A\u8BB0\u4E00\u8F88\u5B50\u7684\u3002[VAR 0114(0072)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD9\u624D\u50CF\u8BDD\u561B\uFF01\\n\u8D70\uFF0C\u6211\u4EEC\u5230\u5BF9\u6218\u573A\u53BB\u5427\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u7684\u51B3\u5B9A\u5F88\u660E\u667A\u3002\\n\u90A3\u6211\u4EEC\u5C31\u4E00\u540C\u524D\u5F80\u5BF9\u6218\u573A\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u679C\u7136\u8FD8\u662F\u90A3\u4E48\u5F3A\uFF5E\\n\u4E0D\u8FC7\uFF0C\u6211\u597D\u50CF\u5F00\u59CB\u6709\u70B9\u638C\u63E1\u5230\u8981\u9886\u4E86\u3002\\r\\n\u2026\u2026\u8C22\u8C22\u4F60\u966A\u6211\u8BAD\u7EC3\u3002[VAR 0114(0071)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u65E9\u5DF2\u9884\u77E5\u672A\u6765\uFF0C\u731C\u5230\u4E86\u8FD9\u4E2A\u7ED3\u679C\uFF01\\n\u4E0D\u8FC7\uFF0C\u6211\u8FD8\u662F\u6709\u6240\u6536\u83B7\u7684\u3002\\r\\n\u2026\u2026\u611F\u8C22\u4F60\u966A\u6211\u8BAD\u7EC3\u3002[VAR 0114(0072)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5929\u54EA\uFF01\u6211\u7ADF\u7136\u8D62\u4E86\uFF5E\uFF01\\n\u6211\u662F\u4E0D\u662F\u53D8\u5F3A\u4E86\u554A\uFF5E\uFF1F\\c\\n\u4E0D\u8FC7\u4E5F\u6709\u53EF\u80FD\u53EA\u662F\u4FA5\u5E78\uFF5E\\n\u2026\u2026\u4E0B\u6B21\u518D\u4E00\u8D77\u54E6\u3002[VAR 0114(0071)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u96BE\u4EE5\u7F6E\u4FE1\uFF0C\u6211\u7ADF\u53D6\u5F97\u4E86\u80DC\u5229\uFF01\\n\u96BE\u9053\u6709\u8C01\u7ED9\u4E86\u6211\u8F85\u52A9\u529B\u91CF\u5417\uFF01\uFF1F\\c\\n\u4E0D\u8FC7\uFF0C\u6211\u8FD8\u9700\u8981\u66F4\u4E0A\u4E00\u5C42\u697C\uFF01\\n\u2026\u2026\u4E0B\u6B21\u8FD8\u8BF7\u966A\u6211\u518D\u6218\u5427\u3002[VAR 0114(0072)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4ECA\u5929\u8BF4\u4EC0\u4E48\u4E5F\u4E0D\u5E72\u5566\uFF01\\n\u52AA\u529B\u8FC7\u5934\uFF0C\u76AE\u80A4\u4F1A\u53D8\u5DEE\u7684\u5462\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4ECA\u65E5\u6211\u5DF2\u5C06\u6240\u6709\u529B\u91CF\u8017\u7AED\u3002\\n\u8FD8\u8BF7\u540E\u65E5\u518D\u6218\u5427\u3002[VAR 0114(0072)]"
  }
]
