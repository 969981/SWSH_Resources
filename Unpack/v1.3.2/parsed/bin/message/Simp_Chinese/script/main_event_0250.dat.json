    "text": "\u5582\uFF0C[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8BDD\u8BF4\u56DE\u6765\uFF01[VAR 0100(0000)]\uFF0C\\n\u4F60\u8FD8\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u6349\u5B9D\u53EF\u68A6\u5427\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8BA9\u6211\u6765\u6559\u4F60\u5427\uFF01\\c\\n\u6BD5\u7ADF\u8981\u5B8C\u6210\u5B9D\u53EF\u68A6\u56FE\u9274\uFF0C\\n\u5C31\u8981\u5148\u6349\u5230\u5B9D\u53EF\u68A6\u624D\u884C\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5927\u54E5\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u5DF2\u7ECF\u6349\u5230\u5B9D\u53EF\u68A6\u4E86\u554A\uFF1F\\n\u53EF\u4EE5\u554A\uFF0C[VAR 0100(0000)]\uFF01\uFF01\\c\\n\u4F60\u7528\u7684\u662F\u5988\u5988\u9001\u7684\u7CBE\u7075\u7403\u5427\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4EFB\u4F55\u5B9D\u53EF\u68A6\u90FD\u62E5\u6709\u81EA\u5DF1\u7684\u5C5E\u6027\uFF0C\\n\u5C5E\u6027\u4E4B\u95F4\u8FD8\u5B58\u5728\u76F8\u751F\u76F8\u514B\uFF01\\c\\n\u6240\u4EE5\uFF0C\u6211\u5EFA\u8BAE\u4F60\u4EEC\u6355\u6349\\n\u80FD\u5728\u5C5E\u6027\u4E0A\u4E92\u8865\u7684\u5B9D\u53EF\u68A6\uFF01\\c\\n\u597D\u4E86\uFF0C\u5C31\u8BA9\u6211\u6765\u4E3A\u4F60\u4EEC\u793A\u8303\u4E00\u4E0B\u5427\uFF01\\n\u51A0\u519B\u65F6\u523B\uFF01\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[~ 7]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F\u5927\u54E5\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6765\uFF0C\u8FD9\u4E9B\u7CBE\u7075\u7403\u7ED9\u4F60\u4E86\uFF0C\\n\u591A\u53BB\u589E\u52A0\u4E00\u4E9B\u4F19\u4F34\u5427\uFF01\\c\\n\u5C24\u5176\u662F\u8FD9\u4E00\u5E26\u7684\u5B9D\u53EF\u68A6\\n\u597D\u50CF\u5F88\u60F3\u4E0E\u8BAD\u7EC3\u5BB6\u4E3A\u4F34\uFF0C\\r\\n\u6349\u8D77\u6765\u7279\u522B\u5BB9\u6613\u54E6\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6355\u6349\u5B9D\u53EF\u68A6\uFF0C\\n\u4E5F\u53EF\u4EE5\u83B7\u5F97\u7ECF\u9A8C\u503C\u54E6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5728\u8DEF\u4E0A\u9047\u5230\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u65F6\uFF0C\\n\u8981\u79EF\u6781\u5730\u901A\u8FC7\u5BF9\u6218\u953B\u70BC\u5B9D\u53EF\u68A6\uFF01\\c\\n\u4F60\u4EEC\u4F1A\u548C\u4EC0\u4E48\u6837\u7684\u5B9D\u53EF\u68A6\\n\u4E00\u8D77\u6210\u957F\u5462\u2026\u2026\\r\\n\u6211\u8FD9\u4E2A\u51A0\u519B\u4E5F\u5341\u5206\u671F\u5F85\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u4EEC\u53BB\u6349\u4E9B\u5B9D\u53EF\u68A6\uFF0C\\n\u7ED9\u5B9D\u53EF\u68A6\u535A\u58EB\u4E00\u4E2A\u60CA\u559C\u5427\uFF01[VAR 0114(0005)]"
  }
