[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5316\u6717\u9547\\n\u5C0F\u9547\u4E00\u76F4\u4EE5\u7ECF\u8425\u7267\u573A\u4E3A\u4E3B\u4E1A\uFF0C\\r\\n\u4EBA\u4EEC\u548C\u5B9D\u53EF\u68A6\u4EEC\u5728\u8FD9\u91CC\u548C\u8C10\u5730\u751F\u6D3B\u7740\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "[~ 1]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uFF11\u53F7\u9053\u8DEF"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6728\u6746\u9547\\n\u4E00\u5EA7\u90CA\u5916\u7684\u5B81\u9759\u5C0F\u9547\uFF0C\\r\\n\u5B9D\u53EF\u68A6\u7814\u7A76\u6240\u5750\u843D\u4E8E\u6B64\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uFF12\u53F7\u9053\u8DEF"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5B9D\u53EF\u68A6\u901A\u8FC7\u6218\u6597\uFF0C\\n\u4F1A\u5F97\u5230\u7ECF\u9A8C\u503C\uFF0C\u53D8\u5F97\u5F3A\u5927\uFF01\\c\\n\u53E6\u5916\uFF0C\u901A\u8FC7\u6355\u6349\u5B9D\u53EF\u68A6\uFF0C\\n\u4E5F\u4F1A\u5F97\u5230\u7ECF\u9A8C\u503C\uFF0C\u53D8\u5F97\u5F3A\u5927\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5077\u522B\u4EBA\u7684\u5B9D\u53EF\u68A6\u5C31\u662F\u5C0F\u5077\uFF01\\n\u7CBE\u7075\u7403\u53EA\u80FD\u6295\u5411\u91CE\u751F\u7684\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u53EF\u4EE5\u53D1\u73B0\u5B9D\u53EF\u68A6\u86CB\u7684\u5BC4\u653E\u5C4B\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u673A\u64CE\u5E02\\n\u8FD0\u7528\u84B8\u6C7D\u673A\\r\\n\u5B9E\u73B0\u4E86\u8FD1\u4EE3\u5316\u7684\u5DE5\u4E1A\u90FD\u5E02\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uFF13\u53F7\u9053\u8DEF"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5728\u516C\u8DEF\u4E0A\u4E5F\u53EF\u4EE5\u9732\u8425\u3002\\c\\n\u5B9D\u53EF\u68A6\u53EF\u4EE5\u901A\u8FC7\u9732\u8425\\n\u83B7\u5F97\u7ECF\u9A8C\u503C\u3002\\c\\n\u4E5F\u53EF\u4EE5\u53BB\u4ED6\u4EBA\u5728\u9732\u8425\u8425\u5730\\n\u8BBE\u7F6E\u7684\u5E10\u7BF7\u4E2D\u505A\u5BA2\u54E6\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[~ 11]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u524D\u65B9\u662F\u4F3D\u52D2\u5C14\u77FF\u5C71\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uFF14\u53F7\u9053\u8DEF"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5B9D\u53EF\u68A6\u7684\u62DB\u5F0F\u5206\u4E3A\uFF12\u79CD\uFF01\\n\u4E00\u79CD\u662F\u7269\u7406\uFF0C\u4E00\u79CD\u662F\u7279\u6B8A\u3002\\c\\n\u5B9D\u53EF\u68A6\u7684\u653B\u51FB\u8D8A\u9AD8\uFF0C\\n\u7269\u7406\u62DB\u5F0F\u5C31\u8D8A\u5F3A\uFF01\\c\\n\u5B9D\u53EF\u68A6\u7684\u7279\u653B\u8D8A\u9AD8\uFF0C\\n\u7279\u6B8A\u62DB\u5F0F\u5C31\u8D8A\u5F3A\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8349\u8DEF\u9547\\n\u6574\u5EA7\u5C0F\u9547\u50CF\u662F\u4E00\u4E2A\u5706\u5706\u7684\u76C6\u5730\uFF0C\\r\\n\u623F\u5C4B\u5206\u5E03\u5728\u5C42\u5C42\u68AF\u7530\u4E4B\u95F4\u3002"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8349\u8DEF\u9547\\n\u5728\u8FDC\u79BB\u8857\u533A\u7684\u5C71\u4E18\u4E0A\uFF0C\\r\\n\u53EF\u4EE5\u6B23\u8D4F\u5230\u81EA\u53E4\u6D41\u4F20\u7684\u5730\u753B\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u8349\u8DEF\u7ADE\u6280\u573A"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uFF15\u53F7\u9053\u8DEF"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u53EF\u4EE5\u53D1\u73B0\u5B9D\u53EF\u68A6\u86CB\u7684\u5BC4\u653E\u5C4B\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[~ 20]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5E26\u6709\u6C14\u573A\u7684\u5B9D\u53EF\u68A6\u4F1A\u6BD4\\n\u4E00\u822C\u7684\u5B9D\u53EF\u68A6\u66F4\u5F3A\u4E00\u70B9\uFF0C\\r\\n\u6253\u5012\u4E4B\u540E\u53EF\u80FD\u4F1A\u6389\u843D\uFF37\u2026\u2026\u74E6\u7279\u3002\\r\\n\u5B83\u4EEC\u88AB\u79F0\u4E3A\u6C14\u573A\u5B9D\u53EF\u68A6\uFF01\\c\\n\u6349\u5230\u7684\u5B9D\u53EF\u68A6\u8D8A\u591A\uFF0C\\n\u5E26\u6709\u6C14\u573A\u7684\u5B9D\u53EF\u68A6\\r\\n\u51FA\u73B0\u7684\u53EF\u80FD\u6027\u4F3C\u4E4E\u5C31\u8D8A\u9AD8\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6C34\u821F\u9547\\n\u8FD9\u91CC\u6709\u8BB8\u591A\u5546\u5E97\u548C\u9910\u5385\uFF0C\\r\\n\u662F\u4E00\u5EA7\u70ED\u95F9\u7684\u6E2F\u53E3\u5C0F\u9547\u3002"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6C34\u821F\u7ADE\u6280\u573A"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u673A\u64CE\u5E02\u90CA\u5916\u65B9\u5411"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u2192  \u7B2C\u4E8C\u77FF\u5C71\\n\u2190  \u673A\u64CE\u5E02"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u62F3\u5173\u5E02\\n\u8FD9\u91CC\u7684\u5EFA\u7B51\u878D\u5408\u4E86\u4E2D\u4E16\u7EAA\u7684\\r\\n\u57CE\u5899\u9057\u8FF9\uFF0C\u5386\u53F2\u6C14\u606F\u6D53\u90C1\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uFF16\u53F7\u9053\u8DEF"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u62DB\u5F0F\u5B66\u4E60\u5668\u53EF\u4EE5\u53CD\u590D\u4F7F\u7528\u3002\\c\\n\u901A\u8FC7\u5B66\u4E60\u5404\u79CD\u5C5E\u6027\u7684\u62DB\u5F0F\uFF0C\\n\u53EF\u4EE5\u4F7F\u51FA\u514B\u5236\u4E0D\u540C\u5B9D\u53EF\u68A6\u7684\u653B\u51FB\uFF01\\c\\n\u800C\u62DB\u5F0F\u8BB0\u5F55\u4F7F\u7528\u4E00\u6B21\u540E\\n\u5C31\u4F1A\u635F\u574F\uFF0C\u8FD8\u8BF7\u614E\u91CD\u4F7F\u7528\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6EAF\u4F20\u9547\\n\u8FD9\u662F\u4E00\u5EA7\u56E0\u53E4\u4EE3\u827A\u672F\\r\\n\u800C\u7E41\u8363\u8D77\u6765\u7684\u5C71\u95F4\u5C0F\u9547\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u2191\u3000\u821E\u59FF\u9547\\n\u2193\u3000\u6EAF\u4F20\u9547"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u6EAF\u4F20\u9547\u7684\u540D\u80DC\uFF01\\n\u4F3D\u52D2\u5C14\u5386\u53F2\u5927\u53D1\u73B0\uFF01"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "[~ 32]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6EAF\u4F20\u7ADE\u6280\u573A"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u821E\u59FF\u9547\\n\u5C0F\u9547\u7684\u5C45\u6C11\u533A\u662F\u628A\u5DE8\u6811\\r\\n\u638F\u7A7A\u540E\u5728\u5185\u90E8\u5EFA\u9020\u8D77\u6765\u7684\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u821E\u59FF\u7ADE\u6280\u573A"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uFF17\u53F7\u9053\u8DEF"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5F53\u5B9D\u53EF\u68A6\u773C\u770B\u5C31\u8981\u8FDB\u5316\u65F6\uFF0C\\n\u6309\uFF22\u952E\uFF0C\u4F1A\u5413\u5F97\u5B83\u505C\u6B62\u8FDB\u5316\u3002\\c\\n\u8FD9\u5C31\u53EB\u505A\u8FDB\u5316\u53D6\u6D88\u3002"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6218\u7ADE\u9547\\n\u8FD9\u662F\u4E00\u5EA7\u6E29\u6CC9\u5C0F\u9547\uFF0C\\r\\n\u53E4\u8001\u7684\u5EFA\u7B51\u9CDE\u6B21\u6809\u6BD4\u3002"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5B9D\u53EF\u68A6\u56FE\u9274\u4E2D\u4F1A\u663E\u793A\\n\u5411\u4F60\u63A8\u8350\u7684\u5B9D\u53EF\u68A6\u3002\\c\\n\u5728\u5C06\u5B83\u4EEC\u5168\u90E8\u6355\u6349\u4E4B\u540E\uFF0C\\n\u6216\u662F\u7ECF\u8FC7\u4E00\u5929\u4E4B\u540E\uFF0C\\r\\n\u63A8\u8350\u7684\u5B9D\u53EF\u68A6\u4E5F\u4F1A\u66F4\u65B0\u3002"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u6218\u7ADE\u7ADE\u6280\u573A"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uFF18\u53F7\u9053\u8DEF"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u53EA\u8981\u53BB\u8C03\u67E5\u5728\u65F7\u91CE\u5730\u5E26\\n\u53D1\u5149\u7684\u5B9D\u53EF\u68A6\u5DE2\u7A74\uFF0C\\r\\n\u5C31\u53EF\u4EE5\u4E0D\u65AD\u79EF\u6512\uFF37\uFF0C\u4E5F\u5C31\u662F\u74E6\u7279\uFF01\\c\\n\u4E00\u8DEF\u8DCB\u6D89\u81F3\u6B64\u7684\u884C\u8005\u554A\uFF0C\\n\u5728\u65F7\u91CE\u5730\u5E26\u4E5F\u4E0D\u8981\u505C\u4E0B\u811A\u6B65\uFF0C\\r\\n\u56DB\u5904\u5BFB\u627E\u5B9D\u53EF\u68A6\u5DE2\u7A74\u5427\uFF01"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u5C16\u9489\u9547\\n\u8FD9\u91CC\u7684\u5E97\u94FA\u6742\u4E71\u5730\u5206\u5E03\u5728\u5404\u5904\uFF0C\\r\\n\u6574\u4E2A\u5C0F\u9547\u591A\u5C11\u5E26\u6709\u4E00\u4E9B\u5E9E\u514B\u6C14\u606F\u3002"
  },
  {
