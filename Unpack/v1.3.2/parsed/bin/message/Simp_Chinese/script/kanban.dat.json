  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u2191\u3000\uFF19\u53F7\u9053\u8DEF\\n\u2192\u3000\u5C16\u9489\u9547"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u6218\u7ADE\u6E7E"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u2193\u3000\u5C16\u9489\u9547"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u5F53\u60F3\u8981\u6349\u5B9D\u53EF\u68A6\u65F6\uFF0C\\n\u6254\u8FC7\u53BB\u7684\u7CBE\u7075\u7403\u7B49\\r\\n\u4E5F\u4F1A\u6709\u4EC5\u6447\u6643\uFF11\u6B21\u7684\u65F6\u5019\u3002\\c\\n\u5B9D\u53EF\u68A6\u6349\u5F97\u8D8A\u591A\uFF0C\\n\u8FD9\u4E00\u73B0\u8C61\u5C31\u8D8A\u5BB9\u6613\u53D1\u751F\u3002\\c\\n\u56E0\u4E3A\u6BD4\u5E73\u65F6\u66F4\u5BB9\u6613\u6349\u4F4F\uFF0C\\n\u6240\u4EE5\u88AB\u79F0\u4E3A\u4F1A\u5FC3\u6355\u6349\uFF01"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uFF11\uFF10\u53F7\u9053\u8DEF"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\u6709\u7528\u7684\u516C\u544A\u724C\uFF01\\c\\n\u4ECE\u5B9D\u53EF\u68A6\u4F53\u5185\\n\u91CA\u653E\u51FA\u7684\u7279\u6B8A\u80FD\u91CF\\r\\n\u4F1A\u626D\u66F2\u5468\u56F4\u7684\u7A7A\u95F4\uFF0C\\c\\n\u4F7F\u5B9D\u53EF\u68A6\u770B\u8D77\u6765\\n\u8FDC\u8FDC\u8D85\u8FC7\u5176\u5B9E\u9645\u5927\u5C0F\uFF0C\\r\\n\u8FD9\u79CD\u73B0\u8C61\u88AB\u79F0\u4E3A\u6781\u5DE8\u5316\u3002\\c\\n\u6709\u7684\u5B9D\u53EF\u68A6\u8FD8\u4F1A\\n\u56E0\u6781\u5DE8\u5316\u800C\u6539\u53D8\u6A21\u6837\uFF0C\\r\\n\u8FD9\u5C31\u662F\u6240\u8C13\u7684\u8D85\u6781\u5DE8\u5316\u3002"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\u5BAB\u95E8\u5E02\\n\u8FD9\u662F\u4E00\u5EA7\u5728\u6D1B\u5179\u4F1A\u957F\u7684\u8BA1\u5212\u6307\u5BFC\u4E0B\\r\\n\u5EFA\u8BBE\u8D77\u6765\u7684\u5927\u90FD\u5E02\u3002"
  },
