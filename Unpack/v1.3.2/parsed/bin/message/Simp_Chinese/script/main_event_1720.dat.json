[
  {
    "index": 0,
    "flags": 0,
    "text": "\u51B3\u8D5B\u7684\u7B2C\uFF12\u8F6E\u6BD4\u8D5B\u5373\u5C06\u5F00\u59CB\uFF01\\c\\n\u5269\u4E0B\u7684\uFF14\u4F4D\u9009\u624B\u4E2D\uFF0C\\n\u80FD\u664B\u7EA7\u7684\u662F\u54EA\uFF12\u4F4D\u5462\uFF01\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u51B3\u8D5B\u7B2C\uFF12\u8F6E\u7B2C\uFF11\u573A\u6BD4\u8D5B\uFF01\\c\\n\u767B\u573A\u7684\u662F\u2026\u2026\\n\u5148\u6218\u80DC\u4E86\u4E0D\u671F\u800C\u81F3\u7684\u5F7C\u7279\u9009\u624B\uFF0C\\r\\n\u5E76\u4E14\u53C8\u5728\u7B2C\uFF11\u8F6E\u6BD4\u8D5B\u4E2D\u529B\u514B\\r\\n\u9732\u7483\u5A1C\u9009\u624B\u7684\u6700\u5F3A\u6311\u6218\u8005\u2014\u2014\\r\\n[VAR 0100(0000)]\u9009\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u7D27\u63A5\u7740\u662F\u2026\u2026\\c\\n\u4F3D\u52D2\u5C14\u7A7A\u624B\u9053\u7684\u5929\u624D\uFF01\\n\u5F69\u8C46\u9009\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u6B21\u6211\u4E00\u5B9A\u8981\u65BD\u5C55\u51FA\\n\u8BA9\u4F60\u4EEC\u5FC3\u614C\u610F\u4E71\u7684\u529F\u592B\uFF01[VAR 0114(0011)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8BF7\u591A\u6307\u6559\u3002[VAR 0114(0011)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5F69\u8C46\u88AB\u6253\u8D25\u4E86\uFF01\\n\u83B7\u80DC\u7684\u662F[VAR 0100(0000)]\uFF01\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u591A\u8C22\u6307\u6559\u3002[VAR 0114(0011)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u548C\u4F60\u4EEC\u5BF9\u6218\u8BA9\u6211\u5FCD\u4E0D\u4F4F\u4E50\u5728\u5176\u4E2D\u2026\u2026\\c\\n\u867D\u7136\u5931\u5229\u8BA9\u6211\u5F88\u4E0D\u7518\u5FC3\uFF0C\\n\u4F46\u540C\u65F6\u4E5F\u8BA9\u6211\u611F\u5230\u7545\u5FEB\u3002[VAR 0114(0011)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4ECE\u67D0\u79CD\u610F\u4E49\u4E0A\u8BB2\uFF0C\\n\u8FD9\u624D\u662F\u6700\u7406\u60F3\u7684\u5BF9\u6218\u5427\u3002[VAR 0114(0011)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u76F8\u4FE1\u4ECA\u540E\u4F60\u4EEC\u8FD8\u4F1A\u9047\u5230\u5404\u79CD\u5BF9\u624B\uFF0C\\n\u9762\u5BF9\u66F4\u591A\u5BF9\u6218\u3002\\c\\n\u5E0C\u671B\u8FD9\u4E9B\u7ECF\u5386\u90FD\u80FD\u6210\u4E3A\\n\u4F60\u4EEC\u5B9D\u8D35\u7684\u7CBE\u795E\u98DF\u7CAE\u3002[VAR 0114(0011)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u5728\u4E0B\u573A\u6BD4\u8D5B\u5F00\u59CB\u4E4B\u524D\uFF0C\\n\u8BF7\u5404\u4F4D\u89C2\u4F17\u7A0D\u7B49\u7247\u523B\u3002[VAR 0114(0018)]"
  }
