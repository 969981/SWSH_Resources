    "text": "[VAR 0100(0000)]\uFF01\\n\u4F60\u7684\u5FBD\u7AE0\u6536\u96C6\u5F97\u5F88\u987A\u5229\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5012\u662F\u4F60\u7684\u52B2\u654C\u8D6B\u666E\u2026\u2026\\n\u90A3\u5C0F\u5B50\u600E\u4E48\u4E86\uFF1F\\c\\n\u4E00\u89C1\u5230\u6211\u5C31\u548C\u6211\u9053\u6B49\uFF0C\\n\u8BF4\u4EC0\u4E48\u201C\u5927\u54E5\uFF0C\u5BF9\u4E0D\u8D77\uFF01\u201D\\r\\n\u5413\u4E86\u6211\u4E00\u8DF3\u2026\u2026[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u90A3\u5C0F\u5B50\u770B\u8D77\u6765\u5F88\u6CAE\u4E27\uFF0C\\n\u83AB\u975E\u662F\u2026\u2026\u56E0\u4E3A\u4ED6\u8F93\u4E86\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4ED6\u8F93\u7ED9\u4E86\u5F7C\u7279\u9009\u624B"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u597D\u50CF\u662F\u8FD9\u6837"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8F93\u4E86\u4E4B\u540E\u53EF\u4EE5\u6CAE\u4E27\uFF01\\c\\n\u6CAE\u4E27\u591F\u4E86\u5C31\u91CD\u65B0\u632F\u4F5C\u8D77\u6765\uFF01\\n\u601D\u8003\u4E00\u4E0B\u4E3A\u4EC0\u4E48\u4F1A\u8F93\uFF01\\c\\n\u539F\u6765\u5982\u6B64\uFF0C\u90A3\u5C0F\u5B50\u8BF4\u4E0D\u5B9A\u2026\u2026\\n\u4F1A\u6210\u4E3A\u4E00\u4E2A\u8BA9\u4EBA\u522E\u76EE\u76F8\u770B\u7684\u8BAD\u7EC3\u5BB6\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u603B\u4E4B\uFF0C\u4F60\u662F\u4ED6\u7684\u52B2\u654C\uFF0C\\n\u5C31\u62DC\u6258\u4F60\u597D\u597D\u97AD\u7B56\u4ED6\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54CE\u5440\uFF0C\u90FD\u8FD9\u4E2A\u65F6\u95F4\u4E86\uFF01\\c\\n\u6211\u548C\u4F1A\u957F\u6709\u7EA6\u53EF\u4E0D\u80FD\u8FDF\u5230\uFF0C\\n\u5426\u5219\u90A3\u4E2A\u79D8\u4E66\u53C8\u8981\u6765\u5FF5\u53E8\u6211\u4E86\u3002\\c\\n\u54CE\uFF0C\u6211\u90FD\u4E0D\u77E5\u9053\u80FD\u4E0D\u80FD\\n\u987A\u5229\u627E\u5230\u78B0\u5934\u7684\u5730\u70B9\u5462\u2026\u2026[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF01[VAR 0100(0000)]\uFF0C\\n\u4F60\u5148\u53BB\u89C1\u4E00\u4E0B\u5947\u5DF4\u7EB3\u5427\u3002\\c\\n\u4ED6\u662F\u6211\u6700\u68D2\u7684\u52B2\u654C\uFF0C\\n\u8D1F\u8D23\u628A\u5B88\u9053\u9986\u6311\u6218\u7684\u6700\u540E\u4E00\u5173\u3002\\c\\n\u4ED6\u73B0\u5728\u5E94\u8BE5\u5C31\u5728\\n\uFF16\u53F7\u9053\u8DEF\u8DDF\u524D\u7684\u5B9D\u7269\u5E93\u90A3\u91CC\uFF01[VAR 0114(0004)]"
  }
]
