    "index": 12,
    "flags": 0,
    "text": "\u6211\u521A\u521A\u68A6\u89C1\uFF0C\u5728\u4E00\u4E2A\u5947\u602A\u7684\u795E\u6BBF\u91CC\uFF0C\\n\u6709\u4E2A\u8111\u888B\u7279\u5927\u7684\u5BB6\u4F19\\r\\n\u5F20\u5634\u8BF4\u4E86\u4E9B\u5F88\u8BA4\u771F\u7684\u8BDD\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8BDD\u8BF4\uFF5E\u6211\u7A81\u7136\u60F3\u8D77\u4E4B\u524D\u7684\u4E00\u4E2A\u68A6\uFF01\\n\u6211\u68A6\u89C1\u6211\u5728\u4E00\u4E2A\u5947\u602A\u7684\u795E\u6BBF\u91CC\u2026\u2026\\c\\n\u770B\u89C1\u4E00\u4E2A\u8111\u888B\u7279\u5927\u7684\u5BB6\u4F19\\n\u5F20\u5634\u8BF4\u8BDD\u4E86\uFF01[VAR 0114(0076)]"
