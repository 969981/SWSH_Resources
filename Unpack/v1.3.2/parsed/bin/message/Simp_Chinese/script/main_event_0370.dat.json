    "text": "\u5FEB\u770B\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u90A3\u8FB9\u5C31\u662F\u6211\u4EEC\u8981\u53BB\u7684\u673A\u64CE\u5E02\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u77E5\u9053\u4E00\u8DEF\u4E0A\u6211\u4EEC\u4F1A\u9047\u5230\\n\u591A\u5C11\u53EA\u5B9D\u53EF\u68A6\u5462\uFF1F\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u54A6\uFF1F\u8FD9\u4E0D\u662F\u7D22\u59AE\u4E9A\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u662F\u6211\u5976\u5976\u8BA9\u6211\u51FA\u6765\u7684\u2026\u2026\\c\\n\u5979\u8BF4\u4F60\u4EEC\u4E24\u4E2A\u90FD\u53BB\u5192\u9669\u4E86\uFF0C\\n\u95EE\u6211\u8FD8\u7B49\u4EC0\u4E48\u3002[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5BF9\u4F60\u8868\u793A\u540C\u60C5"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u535A\u58EB\u2026\u2026"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u90A3\u4E2A\u2026\u2026\\n\u4F60\u4EEC\u4E0D\u7528\u4ECB\u610F\u5566\u3002\\c\\n\u5176\u5B9E\u6211\u5BF9\u4F60\u4EEC\u5728\u68EE\u6797\u91CC\\n\u9047\u5230\u7684\u5B9D\u53EF\u68A6\u4E5F\u5F88\u611F\u5174\u8DA3\uFF0C\\r\\n\u6B63\u60F3\u8C03\u67E5\u4E00\u4E0B\u5462\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8981\u662F\u6211\u80FD\u6709\u65B0\u7684\u53D1\u73B0\uFF0C\\n\u6211\u5976\u5976\u4E5F\u4F1A\u5BF9\u6211\u53E6\u773C\u76F8\u770B\u7684\u2026\u2026\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5927\u4EBA\u8FD8\u771F\u662F\u9EBB\u70E6\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6240\u4EE5\u6211\u624D\u8BF4\uFF0C\\n\u4F60\u4EEC\u4E0D\u8981\u4ECB\u610F\u5566\u3002\\c\\n\u6211\u4E5F\u662F\u96BE\u5F97\u6709\u673A\u4F1A\u51FA\u6765\u65C5\u884C\uFF0C\\n\u6B63\u597D\u53EF\u4EE5\u4EAB\u53D7\u4E00\u4E0B\u9493\u9C7C\u548C\u9732\u8425\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[~ 11]"
  },
  {
    "index": 12,
