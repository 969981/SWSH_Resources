  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u8981\u67E5\u904D\u6563\u53D1\u7EA2\u5149\u7684\u5DE2\u7A74\uFF01\\c\\n\u8FD8\u8981\u6253\u904D\u6781\u5DE8\u5316\u7684\u5B9D\u53EF\u68A6\uFF01\\n\u5199\u4E0B\u4F20\u8BF4\u7684\u4E00\u9875\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u62DC\u6258\uFF01\u6781\u5DE8\u5316\u540E\u7684\u5B9D\u53EF\u68A6\\n\u5389\u5BB3\u5F97\u4E0D\u5F97\u4E86\u5462\uFF01\\c\\n\u5230\u65F6\u522B\u5FD8\u4E86\u8BA9\u81EA\u5DF1\u7684\\n\u642D\u6863\u5B9D\u53EF\u68A6\u4E5F\u6781\u5DE8\u5316\u54E6\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5728\u65F7\u91CE\u5730\u5E26\uFF0C\\n\u5230\u5904\u90FD\u80FD\u53D1\u73B0\u7EA2\u8272\u7684\u5149\u67F1\u3002\\c\\n\u6709\u4FE1\u5FC3\u7684\u8BDD\u5C31\u53BB\u8C03\u67E5\u4E00\u4E0B\u5427\u3002\\n\u8981\u5C0F\u5FC3\u90A3\u91CC\u7684\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u54E6\u3002\\c\\n\u7ED9\uFF01\u8FD9\u662F\u524D\u8F88\u6211\u9001\u4F60\u7684\u4E00\u4EFD\u597D\u793C\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6709\u4E86\u5B9D\u53EF\u68A6\u76D2\uFF0C\\n\u5C31\u53EF\u4EE5\u5B58\u653E\u6216\u53D6\u51FA\u5B9D\u53EF\u68A6\u4E86\u3002\\c\\n\u52AA\u529B\u53BB\u6349\u5B9D\u53EF\u68A6\uFF0C\\n\u987A\u4FBF\u5145\u5B9E\u4E00\u4E0B\u5B9D\u53EF\u68A6\u56FE\u9274\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u53BB\u5427\uFF01\u5230\u65F7\u91CE\u5730\u5E26\u53BB\uFF01\\n\u90A3\u91CC\u5C31\u662F\u4F60\u5192\u9669\u7684\u8D77\u70B9\uFF01[VAR 0114(000B)]"
