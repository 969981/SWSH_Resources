    "text": "[VAR 0100(0000)]\uFF0C\u8D70\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54A6\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8EAB\u4E3A\u9053\u9986\u9986\u4E3B\u5374\u7279\u610F\u6765\u9001\u884C\u5417\uFF1F\\c\\n\u770B\u6765\u5361\u829C\u4F60\u5DF2\u7ECF\u770B\u51FA\u6765\\n\u51A0\u519B\u975E\u6211\u83AB\u5C5E\u4E86\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u56E0\u4E3A\u5B9E\u5728\u6709\u592A\u591A\u8BAD\u7EC3\u5BB6\\n\u8FDE\uFF13\u4E2A\u9053\u9986\u5FBD\u7AE0\u90FD\u6CA1\u6536\u96C6\u5230\uFF0C\\r\\n\u5C31\u653E\u5F03\u4E86\u9053\u9986\u6311\u6218\u2026\u2026\\c\\n\u6240\u4EE5\u53EA\u8981\u662F\u6253\u8D62\u6211\u7684\u4EBA\uFF0C\\n\u6211\u90FD\u4F1A\u6765\u9001\u884C\u7684\u3002[VAR 0114(0010)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u547C\uFF5E\u8D76\u4E0A\u4E86\u2026\u2026\\n\u591A\u4E8F\u4E86\u98DE\u7FD4\u51FA\u79DF\u8F66\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u3001\u8D6B\u666E\uFF0C\u606D\u559C\u4F60\u4EEC\uFF01\\n\u4F60\u4EEC\u7ADF\u7136\u80FD\u6253\u8D62\u5361\u829C\uFF0C\u592A\u5389\u5BB3\u4E86\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u80FD\u4ECE\u5361\u829C\u90A3\u91CC\u62FF\u5230\u9053\u9986\u5FBD\u7AE0\u7684\\n\u9053\u9986\u6311\u6218\u8005\u771F\u7684\u5F88\u5C11\u3002\\c\\n\u6240\u4EE5\u4E3A\u4E86\u8868\u793A\u5BF9\u4ED6\u4EEC\u7684\u652F\u6301\uFF0C\\n\u6211\u4EEC\u4F1A\u4E00\u8D77\u6765\u9001\u884C\u3002[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\\n\u8BA9\u6211\u4EEC\u4E3A\u4F60\u4EEC\u52A0\u52A0\u6CB9\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u51B2\u554A\u51B2\u554A\uFF01\u8D6B\u666E\uFF01\\n\u52A0\u6CB9\u52A0\u6CB9\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u4EEC\u63A5\u4E0B\u6765\u8981\u9762\u5BF9\u7684\\n\u9053\u9986\u9986\u4E3B\u4E2A\u4E2A\u8EAB\u624B\u4E0D\u51E1\u3002\\c\\n\u4F46\u662F\u4F60\u4EEC\u4E00\u5B9A\u80FD\u6218\u80DC\u4ED6\u4EEC\uFF01\\n\u76F8\u4FE1\u5B9D\u53EF\u68A6\uFF0C\u52C7\u5F80\u76F4\u524D\u5427\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5361\u829C\uFF0C\u8FD8\u6709\u5927\u5BB6\uFF0C\u8C22\u5566\uFF01\\c\\n\u6211\u4EEC\u4E24\u4E2A\u4F1A\u6253\u8D62\u5230\u5E95\uFF0C\\n\u7136\u540E\u5728\u51B3\u6218\u4E2D\u4E00\u51B3\u80DC\u8D1F\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4E0B\u4E00\u7AD9\uFF0C\u62F3\u5173\u5E02\uFF01\\n\u6211\u4EEC\u52A0\u6CB9\u5427\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u627E\u51FA\u81EA\u5DF1\u7684\u4E0D\u8DB3\u4E4B\u5904\u5427\uFF01\\c\\n\u552F\u6709\u8BA4\u6E05\u81EA\u5DF1\u7F3A\u70B9\u7684\u4EBA\uFF0C\\n\u624D\u80FD\u83B7\u5F97\u957F\u8DB3\u7684\u8FDB\u6B65\uFF01[VAR 0114(0010)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u52A1\u519C\u65F6\u603B\u662F\u4F1A\u9047\u5230\u9884\u6599\u4E4B\u5916\u7684\u4E8B\u3002\\c\\n\u5B9D\u53EF\u68A6\u5BF9\u6218\u4E5F\u662F\u4E00\u6837\uFF0C\\n\u53EA\u8981\u575A\u6301\u4E0B\u53BB\uFF0C\u8239\u5230\u6865\u5934\u81EA\u7136\u76F4\u3002[VAR 0114(000E)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u867D\u7136\u4E25\u4E8E\u5F8B\u5DF1\u4E5F\u6CA1\u4EC0\u4E48\u4E0D\u597D\uFF0C\\n\u4F46\u662F\u8981\u6C42\u592A\u4E25\u4F1A\u7D2F\u574F\u81EA\u5DF1\u7684\u3002\\c\\n\u5F53\u4F60\u9700\u8981\u653E\u677E\u65F6\uFF0C\\n\u5C31\u5230\u6D77\u9C9C\u9910\u5385\u6765\u5427\u3002[VAR 0114(000F)]"
  }
]
