  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u80E1\u8BF4\u4EC0\u4E48\uFF5E\uFF01\uFF1F\\n\u518D\u3001\u518D\u8BF4\u4E86\uFF0C\u4EBA\u5BB6\u5728\u54EA\u91CC\u5E72\u4EC0\u4E48\uFF0C\\r\\n\u8DDF\u4F60\u53C8\u6709\u4EC0\u4E48\u5173\u7CFB\uFF5E\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5443\uFF01\u8EB2\u5728\u89D2\u843D\u91CC\u57CB\u5934\u4FEE\u884C\uFF0C\\n\u5B9E\u5728\u6BEB\u65E0\u4F18\u96C5\u53EF\u8A00\uFF01\\r\\n\u6211\u8981\u5168\u529B\u955C\u9762\u53CD\u5C04\u4F60\u7684\u95EE\u9898\u3002[VAR 0114(0072)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u597D\uFF5E\uFF01\uFF1F\u6211\u597D\u7740\u5462\uFF5E\uFF01\uFF1F\\c\\n\u4F60\u770B\u8D77\u6765\u4E5F\u4E0D\u9519\u554A\uFF0C\\n\u771F\u662F\u592A\uFF5E\u68D2\u4E86\u5462\uFF01\u884C\u884C\u884C\uFF01[VAR 0114(0071)]"
