[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5582\uFF01\u6211\u4EEC\u5728\u8FD9\u8FB9\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u554A\uFF0C\u8FD9\u4E0D\u662F[VAR 0100(0000)]\u5417\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E39\u5E1D\u548C\u55B7\u706B\u9F99\\n\u771F\u4E0D\u6127\u662F\u6700\u4F73\u642D\u6863\uFF01\\c\\n\u542C\u8BF4\u4F60\u4EEC\u4E00\u7728\u773C\u7684\u5DE5\u592B\\n\u5C31\u5236\u670D\u4E86\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u554A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8C01\u8BA9\u6211\u662F\u65E0\u654C\u7684\u51A0\u519B\u5462\uFF01\\n\u8BDD\u8BF4\u56DE\u6765\uFF0C\u5230\u5E95\u53D1\u751F\u4E86\u4EC0\u4E48\u4E8B\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7A81\u7136\u51FA\u73B0\u4E86\u7EA2\u5149\u2026\u2026\\n\u4E0D\u5728\u80FD\u91CF\u70B9\u4E0A\u7684\u5B9D\u53EF\u68A6\\r\\n\u5C45\u7136\u6781\u5DE8\u5316\u4E86\u2026\u2026\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u600E\u4E48\u4F1A\u8FD9\u6837\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u4E0D\u77E5\u9053\u2026\u2026\\n\u8FD9\u7A76\u7ADF\u662F\u600E\u4E48\u56DE\u4E8B\u2026\u2026\uFF1F\\c\\n\u800C\u4E14\uFF0C\u6211\u4E5F\u4E0D\u77E5\u9053\u7EA2\u8272\u7684\u5149\\n\u4F1A\u4E0D\u4F1A\u518D\u6B21\u51FA\u73B0\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u80FD\u505A\u51FA\u6B63\u786E\u7684\u9884\u6D4B\uFF0C\\n\u4E5F\u662F\u4F18\u79C0\u7814\u7A76\u5BB6\u7684\u6807\u51C6\u4E4B\u4E00\u54E6\u3002[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5976\u5976\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F1A\u957F\u628A\u6211\u53EB\u6765\u2026\u2026\\c\\n\u95EE\u4E86\u6211\u5F88\u591A\u6781\u5DE8\u5316\u4E0E\u7EA2\u5149\\n\u4E4B\u95F4\u7684\u5173\u7CFB\u3002[VAR 0114(000A)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6709\u4EC0\u4E48\u6536\u83B7\u5417\uFF1F[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6536\u83B7\uFF1F\\n\u4F1A\u957F\u89C9\u5F97\u80FD\u6E90\u5F88\u91CD\u8981\uFF0C\\r\\n\u4E00\u5207\u90FD\u53EA\u4EA4\u7ED9\u4ED6\u7684\u79D8\u4E66\u5904\u7406\u2026\u2026\\c\\n\u6240\u4EE5\u6211\u4EEC\u4E5F\u6CA1\u6709\u8DB3\u591F\u7684\u8D44\u6599\u3002[VAR 0114(000A)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6240\u4EE5\u554A\uFF0C\u7D22\u59AE\u4E9A\uFF0C\\n\u4F60\u4E5F\u8981\u6765\u8C03\u67E5\u3002\\c\\n\u6BD5\u7ADF\uFF0C\u4F60\u6BD4\u4EFB\u4F55\u4EBA\u90FD\u66F4\u6DF1\u5165\u5730\\n\u5728\u8C03\u67E5\u95C7\u591C\u4E86\uFF0C\u4E0D\u662F\u5417\uFF1F[VAR 0114(000A)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u662F\u8BF4\u7EA2\u8272\u7684\u5149\u53EF\u80FD\u662F\u707E\u5384\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54CE\uFF0C\u6709\u6CA1\u6709\u6211\u4EEC\u4E5F\u80FD\u51FA\u529B\u7684\u4E8B\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6709\u554A\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u4EEC\u5E2E\u5FD9\u5427\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u8C22\u8C22\uFF01\\n\u4F60\u4EEC\u7684\u597D\u610F\u6211\u5FC3\u9886\u4E86\u3002\\c\\n\u4F46\u662F\u6211\u66F4\u5E0C\u671B\u4F60\u4EEC\\n\u80FD\u5728\u51B3\u8D5B\u4E2D\u4E0A\u6F14\u5DC5\u5CF0\u5BF9\u51B3\uFF01\\c\\n\u672A\u6765\u7531\u6211\u6765\u4FDD\u62A4\uFF01\\n\u4F60\u4EEC\u4E13\u5FC3\u5B8C\u6210\u9053\u9986\u6311\u6218\u5C31\u597D\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u77E5\u9053\u4E86\uFF01\u542C\u5927\u54E5\u7684\u8BDD\u51C6\u6CA1\u9519\uFF01\\n\u8C01\u8BA9\u4F60\u662F\u65E0\u654C\u7684\u51A0\u519B\u5462\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5976\u5976\uFF0C\u5176\u5B9E\u6709\u4EF6\u4E8B\u6211\u5F88\u5728\u610F\u3002\\n\u4F60\u80FD\u5E2E\u4E00\u4E0B\u6211\u5417\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5F53\u7136\u53EF\u4EE5\u3002[VAR 0114(000A)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u4E5F\u8BE5\u8D70\u4E86\u3002\u4F60\u4EEC\u8981\u5B8C\u6210\\n\u9053\u9986\u4EFB\u52A1\uFF0C\u664B\u7EA7\u5230\u51A0\u519B\u676F\u554A\uFF01\\r\\n\u5E0C\u671B\u90A3\u65F6\u6211\u8FD8\u80FD\u89C1\u5230\u4F60\u4EEC\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6211\u4E5F\u4F1A\u5C3D\u529B\u800C\u4E3A\u7684\uFF01\\n\u9996\u5148\u5C31\u8981\u6253\u8D62\u8042\u6893\uFF01\\c\\n[VAR 0100(0000)]\uFF0C\\n\u4F60\u8BE5\u53BB\u62F3\u5173\u7ADE\u6280\u573A\u4E86\u5427\uFF01\\r\\n\u90A3\u91CC\u7684\u5947\u5DF4\u7EB3\u53EF\u5389\u5BB3\u5566\uFF01[VAR 0114(0005)]"
  }
]
