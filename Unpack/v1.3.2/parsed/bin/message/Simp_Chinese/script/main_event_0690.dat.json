[
  {
    "index": 0,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u8BA9\u6211\u4EEC\u597D\u597D\u5E86\u795D\u4E00\u4E0B\u4F60\u7684\u80DC\u5229\u5427\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54CE\u5440\uFF0C\u4F60\u4E5F\u88AB\u9080\u8BF7\u4E86\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4E24\u4E2A\u8BA4\u8BC6\u554A\uFF1F\u90A3\u592A\u597D\u4E86\uFF01\\n\u6765\u6765\uFF0C\u5FEB\u5750\u4E0B\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6C34\u821F\u9547\u4EE5\u6C34\u4EA7\u95FB\u540D\u3002\\c\\n\u5728\u5F53\u5730\u73B0\u635E\u7684\u6D77\u9C9C\\n\u5403\u8D77\u6765\u624D\u662F\u6700\u9C9C\u7F8E\u7684\u554A\uFF01\\r\\n\u8FD9\u91CC\u7684\u6BCF\u4E00\u9053\u83DC\u90FD\u7F8E\u5473\u6781\u4E86\u3002[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u6728\u5170\u535A\u58EB\u6700\u8FD1\u53EF\u597D\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u5E94\u8BE5\u611F\u8C22\u6728\u5170\u535A\u58EB\u554A\u3002\\c\\n\u591A\u4E8F\u4E86\u6709\u5979\u7684\u7814\u7A76\uFF0C\\n\u6211\u4EEC\u624D\u80FD\u5229\u7528\u8BB8\u613F\u661F\u4E2D\u8574\u85CF\u7684\u80FD\u91CF\uFF0C\\r\\n\u505A\u51FA\u8BA9\u5B9D\u53EF\u68A6\u53D8\u5DE8\u5927\u7684\u6781\u5DE8\u8155\u5E26\u3002[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\u4F46\u662F\u5979\u8BF4\u8FC7\uFF0C\\n\u6781\u5DE8\u5316\u8FD8\u6709\u8BB8\u591A\u5C1A\u4E0D\u660E\u786E\u7684\u5730\u65B9\uFF0C\\r\\n\u8FD9\u4E5F\u8BA9\u5979\u611F\u5230\u6709\u4E9B\u4E0D\u5B89\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u8FD9\u6B21\u51FA\u6765\u5192\u9669\u65F6\uFF0C\u5979\u751A\u81F3\\n\u8981\u6211\u5E26\u4E0A\u80FD\u91CF\u70B9\u63A2\u6D4B\u673A\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u80FD\u91CF\u70B9\u63A2\u6D4B\u673A\uFF01\\c\\n\u591A\u4E8F\u4E86\u8FD9\u4E1C\u897F\uFF0C\\n\u6211\u4EEC\u624D\u80FD\u53D1\u73B0\u80FD\u91CF\u70B9\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u6709\u4F3D\u52D2\u5C14\u7C92\u5B50\u51FA\u73B0\uFF0C\\r\\n\u5E76\u4E14\u80FD\u4F7F\u7528\u6781\u5DE8\u5316\u7684\u5730\u70B9\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u6211\u4E0D\u5E0C\u671B\\n\u8BA9\u6728\u5170\u535A\u58EB\u611F\u5230\u4E0D\u5B89\u3002\\c\\n\u6211\u80FD\u4E0D\u80FD\u4E3A\u5979\u51FA\u70B9\u529B\u5462\u2026\u2026\uFF1F[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\uFF0C\u6211\u5EFA\u8BAE\u4F60\\n\u5230\u62F3\u5173\u5E02\u7684\u5B9D\u7269\u5E93\u53BB\u770B\u770B\u3002\\c\\n\u6211\u4E00\u76F4\u8BA4\u4E3A\\n\u89E3\u5F00\u6781\u5DE8\u5316\u4E4B\u8C1C\u7684\u94A5\u5319\\r\\n\u5C31\u85CF\u5728\u5386\u53F2\u4E4B\u4E2D\u3002[VAR 0114(0006)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u77E5\u9053\u4E86\u3002\u6211\u4F1A\u505A\u597D\u5B89\u6392\uFF0C\\n\u8BA9\u7D22\u59AE\u4E9A\u5C0F\u59D0\u597D\u597D\u53C2\u89C2\u4E00\u4E0B\u7684\u3002[VAR 0114(0007)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u2026\u2026\u4E0D\u8FC7\uFF0C\u4F1A\u957F\uFF0C\\n\u6211\u4EEC\u5DEE\u4E0D\u591A\u4E5F\u8BE5\u8D70\u4E86\u3002[VAR 0114(0007)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E0D\u662F\u5427\uFF1F\u6211\u8FD8\u6CA1\u6765\u5F97\u53CA\u548C[VAR 0100(0000)]\\n\u597D\u597D\u804A\u4E00\u4E0B\u5462\u2026\u2026\\c\\n\u54CE\uFF0C\u5929\u4E0B\u6CA1\u6709\u4E0D\u6563\u7684\u5BB4\u5E2D\u3002\\n\u51B5\u4E14\u6211\u8981\u5904\u7406\u7684\u4E8B\u60C5\u5FC5\u987B\u9A6C\u4E0A\u843D\u5B9E\uFF01\\r\\n\u5404\u4F4D\uFF0C\u540E\u4F1A\u6709\u671F\u4E86\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54CE\u2026\u2026\\n\u8FD9\u662F\u5728\u5356\u6211\u4EBA\u60C5\u5417\uFF1F\\c\\n\u4E0D\u8FC7\uFF0C\u5B9D\u7269\u5E93\u786E\u5B9E\u662F\\n\u8C03\u67E5\u4F20\u8BF4\u7684\u597D\u53BB\u5904\u5C31\u662F\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u4F60\u62FF\u5230\u6C34\u4E4B\u5FBD\u7AE0\u4E86\u5427\uFF1F\\n\u80FD\u6253\u8D25\u9732\u7483\u5A1C\uFF0C\u53EF\u771F\u662F\u4E0D\u7B80\u5355\uFF01\\r\\n\u6211\u9001\u4F60\u62DB\u5F0F\u5B66\u4E60\u5668\u5F53\u505A\u5956\u52B1\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9732\u7483\u5A1C\u662F\u6211\u7684\u597D\u670B\u53CB\u3002\\n\u6211\u8FD8\u662F\u53BB\u89C1\u5979\u4E00\u9762\u5427\u3002\\c\\n\u518D\u89C1\u5566\uFF0C\u9053\u9986\u6311\u6218\u8005\uFF01[VAR 0114(000B)]"
  }
]
