    "text": "[VAR 0100(0000)]\u5B8C\u6210\u4E86\\n\u8BE5\u505A\u7684\u4E8B\u4EE5\u540E\uFF0C\\r\\n\u5C31\u8BE5\u8FDB\u5165\u4E0B\u4E00\u4E2A\u9636\u6BB5\u565C\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\u554A\uFF0C[VAR 0100(0000)]\uFF01\\n\u6CA1\u4E8B\uFF0C\u662F\u8001\u5934\u513F\u6211\u5728\u81EA\u8A00\u81EA\u8BED\u5566\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\u53CC\u62F3\u5854\u7684\u523A\u5BA2\u4EEC\\n\u662F\u6211\u4EEC\u7684\u5927\u524D\u8F88\uFF01\\c\\n\u542C\u8BF4\u4ED6\u4EEC\u4E00\u65E6\u53D7\u5230\u53EC\u5524\uFF0C\\n\u5C31\u4F1A\u4E00\u76F4\u5F85\u5728\u5854\u91CC\u51C6\u5907\u884C\u52A8\uFF01"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\u6700\u8FD1\u514B\u62C9\u62C9\u4E00\u76F4\u5728\\n\u8BA4\u771F\u953B\u70BC\u5462\uFF01\\r\\n\u5979\u662F\u4E0D\u662F\u5403\u9519\u4EC0\u4E48\u4E1C\u897F\u4E86\u554A\uFF1F"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\u6700\u8FD1\u8D5B\u5B9D\u5229\u4E00\u76F4\u5728\\n\u8BA4\u771F\u953B\u70BC\u5462\uFF01\\r\\n\u4ED6\u662F\u4E0D\u662F\u5403\u9519\u4EC0\u4E48\u4E1C\u897F\u4E86\u554A\uFF1F"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\u542C\u4F20\u95FB\u8BF4\uFF0C\u8FC7\u53BB\uFF0C\u51A0\u519B\u4E39\u5E1D\\n\u5728\u53BB\u53CC\u62F3\u5854\u7684\u8DEF\u4E0A\u8FF7\u4E86\u8DEF\u2026\u2026\\c\\n\u540E\u6765\u4E0D\u77E5\u600E\u7684\u5C31\u56DE\u5230\u4E86\u5316\u6717\u9547\uFF01"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\u5230\u5E95\u8BA9\u718A\u5F92\u5F1F\u8FDB\u5316\u6210\\n\u6C34\u5C5E\u6027\u8FD8\u662F\u6076\u5C5E\u6027\u597D\u5462\uFF1F\\r\\n\u7EF4\u6301\u73B0\u5728\u7684\u6837\u5B50\u4E5F\u633A\u53EF\u7231\u7684\u2026\u2026\\r\\n\u5982\u679C\u662F\u6211\u7684\u8BDD\uFF0C\u5230\u5E95\u4F1A\u600E\u4E48\u9009\u5462\uFF1F"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\u6C34\u4E4B\u5854\u9644\u8FD1\u4E00\u5E26\u662F\\n\u98CE\u666F\u4F18\u7F8E\u7684\u62CD\u7167\u6253\u5361\u5723\u5730\uFF01\\c\\n\u636E\u8BF4\u5E08\u5085\u548C\u5E08\u6BCD\u7ECF\u5E38\\n\u5728\u90A3\u8FB9\u6563\u6B65\u7EA6\u4F1A\u5462\uFF01"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\u4E0A\u54EA\u513F\u80FD\u627E\u5230\\n\u5927\u628A\u8D5A\u94B1\u7684\u597D\u673A\u4F1A\u5462\uFF5E\uFF1F"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\u7B49\u6211\u5B9E\u529B\u53D8\u5F3A\u4EE5\u540E\uFF0C\\n\u6211\u4E5F\u8981\u53C2\u52A0\\r\\n\u4E0B\u4E00\u6B21\u7684\u9053\u9986\u6311\u6218\uFF01"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\u5076\u5C14\u6211\u4E5F\u4F1A\u6709\u70B9\u5B64\u5355\uFF0C\\n\u60F3\u8981\u56DE\u5BB6\u3002\\c\\n\u4F46\u53EA\u8981\u5E08\u6BCD\u4F7F\u52B2\u5730\u62B1\u62B1\u6211\uFF0C\\n\u6211\u5C31\u4F1A\u611F\u5230\u5B89\u5FC3\u4E86\u3002"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\u5475\u5475\u5475\uFF0C\u4F60\u7ADF\u7136\u8FDE\u53CC\u62F3\u5854\\n\u90FD\u80FD\u767B\u9876\uFF0C\u771F\u662F\u4E0D\u7B80\u5355\u3002\\c\\n\u6211\u81EA\u5DF1\u867D\u7136\u6CA1\u6709\u4E0A\u53BB\u8FC7\uFF0C\\n\u4F46\u60F3\u6765\u4E00\u5B9A\u975E\u5E38\u4E86\u4E0D\u5F97\u5427\u2026\u2026"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\u6211\u672C\u6765\u6253\u7B97\\n\u4FEE\u884C\u7ED3\u675F\u4EE5\u540E\u5C31\u4E0A\u8DEF\u7684\u2026\u2026\\c\\n\u4F46\u4E0D\u77E5\u4E0D\u89C9\u5C31\u5F85\u4E86\u8FD9\u4E48\u4E45\u3002\\n\u8C01\u8BA9\u9A6C\u5E08\u5085\u6B66\u9986\u8FD9\u4E48\u8212\u670D\u5462\u3002"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\u6211\u60F3\u6BD4\u522B\u4EBA\u66F4\u5F3A\uFF0C\\n\u6240\u4EE5\u5FC5\u987B\u5F97\u6BD4\u522B\u4EBA\u66F4\u52AA\u529B\u5462\uFF5E\\r\\n\u2026\u2026\u867D\u7136\u8FD9\u6837\u771F\u7684\u8D85\u8F9B\u82E6\u8036\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\u539F\u6765\uFF0C\u65E0\u6CD5\u6218\u80DC\u81EA\u5DF1\u7684\u4EBA\uFF0C\\n\u662F\u4E0D\u53EF\u80FD\u6218\u80DC\u4ED6\u4EBA\u7684\u554A\u3002\\r\\n\u2026\u2026\u7406\u8BBA\u4E0A\u6211\u90FD\u660E\u767D\u3002[VAR 0114(0072)]"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\u6B38\uFF1F\u65E2\u7136\u4F60\u8BA9\u5B83\u643A\u5E26\u4E86\u4E0D\u53D8\u4E4B\u77F3\uFF0C\\n\u4E5F\u5C31\u662F\u8BF4\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\u5982\u679C\u8BA9\u718A\u5F92\u5F1F\u643A\u5E26\u4E86\u4E0D\u53D8\u4E4B\u77F3\uFF0C\\n\u5C31\u4E0D\u80FD\u7ED9\u5B83\u770B\u6302\u8F74\uFF01"
  }
]
