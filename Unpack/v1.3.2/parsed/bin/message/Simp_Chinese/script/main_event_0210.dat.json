    "index": 0,
    "flags": 0,
    "text": "\u771F\u4E0D\u6127\u662F\u6728\u5170\u535A\u58EB\u3002\\n\u5230\u5904\u90FD\u662F\u6211\u611F\u5174\u8DA3\u7684\u8D44\u6599\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u80D6\u6C6A\u6C6A\u6C6A\u6C6A\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E39\u5E1D\uFF0C\u4F60\u4ECA\u5929\u6765\u5E72\u4EC0\u4E48\uFF1F\\c\\n\u8BE5\u4E0D\u4F1A\u662F\u60F3\u4E86\u89E3\\n\u8FD8\u6CA1\u89C1\u8FC7\u7684\u6700\u5F3A\u5B9D\u53EF\u68A6\u5427\uFF1F\\r\\n\u6211\u53EF\u4E0D\u63A5\u53D7\u7C7B\u4F3C\u8FD9\u6837\u79BB\u8C31\u7684\u8981\u6C42\u3002[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u55E8\uFF0C\u6765\u7535\u6C6A\uFF0C\\n\u8C22\u8C22\u4F60\u603B\u662F\u5E2E\u6211\u5E26\u8DEF\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6765\u8FCE\u63A5\u6211\u4EEC\u7684\u8FD9\u53EA\u5B9D\u53EF\u68A6\\n\u53EB\u505A\u6765\u7535\u6C6A\uFF01\\c\\n\u6211\u8FF7\u8DEF\u7684\u65F6\u5019\uFF0C\\n\u597D\u51E0\u6B21\u90FD\u662F\u88AB\u5B83\u6551\u56DE\u6765\u7684\u5462\u3002\\c\\n\u5BF9\u4E86\uFF0C\u5B83\u7684\u8BAD\u7EC3\u5BB6\u662F\u7D22\u59AE\u4E9A\u3002\\c\\n\u5979\u505A\u7684\u6599\u7406\u5F88\u4E0D\u9519\uFF0C\\n\u53C8\u5FEB\u53C8\u597D\u5403\u3002[VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u771F\u662F\u7684\uFF01\u867D\u7136\u6211\u4EEC\u4EE5\u524D\\n\u4E00\u8D77\u53C2\u52A0\u8FC7\u9053\u9986\u6311\u6218\uFF0C\\r\\n\u4F46\u4F60\u8FD9\u6837\u4ECB\u7ECD\u6211\u7B97\u4EC0\u4E48\u554A\u2026\u2026\\c\\n\u522B\u53EA\u987E\u7740\u8C22\u6765\u7535\u6C6A\uFF0C\\n\u5E2E\u8FC7\u4F60\u7684\u8FD8\u6709\u6211\u5462\u3002[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u597D\uFF01\u6211\u53EB\u7D22\u59AE\u4E9A\u3002\\n\u6211\u662F\u535A\u58EB\u7684\u52A9\u624B\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8FD9\u4F4D\u662F[VAR 0100(0000)]\u3002\\c\\n[VAR 1100(00FF,0101)]\u4ED6\u5979\u662F\u4E2A\u65B0\u624B\u8BAD\u7EC3\u5BB6\u3002\\n\u7D22\u59AE\u4E9A\uFF0C\u62DC\u6258\u4F60\u7ED9\u4E9B\u597D\u5EFA\u8BAE\u5427\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8FD9\u662F\u628A\u6211\u5F53\u4EC0\u4E48\u554A\uFF1F\\n\u4ED6\u5C31\u662F\u592A\u4F1A\u8D70\u81EA\u5DF1\u7684\u8DEF\u4E86\uFF0C\\r\\n\u6240\u4EE5\u624D\u4F1A\u4E0D\u8BA4\u8DEF\u54E6\u3002[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u54A6\uFF1F\u4F60\u4E5F\u6709\u624B\u673A\u6D1B\u6258\u59C6\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u563F\uFF01\u6D1B\u6258\u59C6\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u54B3\u55D2\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u624B\u673A\u6D1B\u6258\u59C6\u5F88\u65B9\u4FBF\u5427\uFF1F\\n\u5B83\u4F1A\u5E2E\u6211\u4EEC\u5728\u5730\u56FE\u4E0A\u505A\u5BFC\u822A\u2026\u2026\\c\\n\u4E0D\u8FC7\u4E39\u5E1D\u8FD8\u662F\u4F1A\u8FF7\u8DEF\u5C31\u662F\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8BDD\u8BF4\uFF0C\u4F60\u5F88\u719F\u6089\u5B9D\u53EF\u68A6\u5417\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u719F\u6089\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4E0D\u592A\u719F\u6089\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u54DF\uFF0C\u4F60\u8FD9\u4E48\u6709\u81EA\u4FE1\u554A\uFF1F\\n\u6765\uFF0C\u8BA9\u6211\u628A[VAR FF00(0001)]\u5B9D\u53EF\u68A6\u56FE\u9274[VAR FF00(0000)]\u5BFC\u5165\u5230\\r\\n\u624B\u673A\u6D1B\u6258\u59C6\u4E2D\uFF0C\u65B9\u4FBF\u4F60\u67E5\u770B\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u522B\u62C5\u5FC3\uFF01\\n\u6211\u4F1A\u628A[VAR FF00(0001)]\u5B9D\u53EF\u68A6\u56FE\u9274[VAR FF00(0000)]\u5BFC\u5165\u5230\\r\\n\u624B\u673A\u6D1B\u6258\u59C6\u4E2D\uFF0C\u65B9\u4FBF\u4F60\u67E5\u770B\u7684\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u83B7\u5F97\u4E86[VAR FF00(0008)]\u5B9D\u53EF\u68A6\u56FE\u9274[VAR FF00(0000)]\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u5B9D\u53EF\u68A6\u56FE\u9274\u5176\u5B9E\u662F\\n\u6211\u5976\u5976\u4E3A\u4F60\u51C6\u5907\u7684\u793C\u7269\u54E6\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4F60\u5148\u53BB\u544A\u8BC9\u6211\u5976\u5976\\n\u4F60\u5DF2\u7ECF\u6536\u5230\u4E86\u5B9D\u53EF\u68A6\u56FE\u9274\u5427\u3002\\c\\n\u6CBF\u7740\uFF12\u53F7\u9053\u8DEF\u5F80\u524D\u8D70\uFF0C\\n\u4F60\u5C31\u80FD\u627E\u5230\u6211\u5976\u5976\u4E86\u3002[VAR 0114(000B)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4E39\u5E1D\u662F\u4E2A\u5802\u5802\u7684\u51A0\u519B\u3002\\n\u800C\u6211\u2026\u2026\u7B97\u662F\u535A\u58EB\u7684\u52A9\u624B\u2026\u2026\\r\\n\u8FD8\u662F\u4E2A\u81EA\u79F0\u7684\u52A9\u624B\u2026\u2026\\r\\n\u5947\u602A\uFF0C\u600E\u4E48\u8D8A\u60F3\u8D8A\u522B\u626D\u5462\uFF1F[VAR 0114(000B)]"
  },
