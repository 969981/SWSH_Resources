[
  {
    "index": 0,
    "flags": 0,
    "text": "\u54A6\uFF1F[VAR 0100(0000)]\u3001\u8D6B\u666E\uFF1F\\c\\n\u54CE\u5440\uFF0C\u6211\u5DEE\u70B9\u5FD8\u4E86\uFF01\\n\u4E0D\u662F\u8FD8\u6709\u51A0\u519B\u8D5B\u5417\uFF1F\\r\\n\u4F60\u4EEC\u600E\u4E48\u8DD1\u5230\u8FD9\u91CC\u6765\u4E86\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u7D22\u59AE\u4E9A\u554A\uFF01\\n\u4F60\u4EC0\u4E48\u90FD\u6CA1\u542C\u8BF4\u5417\uFF01\uFF1F\\c\\n\u6D1B\u5179\u4F1A\u957F\u628A\u6BD4\u8D5B\u641E\u5F97\u4E71\u4E03\u516B\u7CDF\uFF01[VAR 0114(0008)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u54CE\uFF1F\\c\\n\u4E0D\u662F\u5427\uFF01\uFF1F\\c\\n\u5728\u6211\u8C03\u67E5\u5FAE\u5BD0\u68EE\u6797\u7684\u8FD9\u6BB5\u65F6\u95F4\u91CC\uFF0C\\n\u5230\u5E95\u53D1\u751F\u4E86\u4EC0\u4E48\u4E8B\u60C5\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u662F\u8FD9\u6837\uFF0C\u62F3\u5173\u7ADE\u6280\u573A\u88AB\\n\u9ED1\u8272\u7684\u65CB\u6DA1\u56E2\u56E2\u7B3C\u7F69\u4E86\uFF01\\c\\n\u540D\u5B57\u53EB\u4EC0\u4E48\u6765\u7740\uFF1F\u95C7\u591C\uFF1F\\n\u603B\u4E4B\uFF0C\u73B0\u573A\u88AB\u641E\u5F97\u4E00\u56E2\u7CDF\u554A\u3002[VAR 0114(0008)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u6CA1\u4EC0\u4E48\u597D\u62C5\u5FC3\u7684\uFF01\\c\\n\u56E0\u4E3A\u65E0\u654C\u7684\u51A0\u519B\\n\u4F1A\u5E2E\u6211\u4EEC\u89E3\u51B3\u95EE\u9898\u7684\u5427\uFF1F[VAR 0114(0008)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7B49\u7B49\uFF0C\u7B49\u7B49\uFF01\\n\u963F\u59E8\uFF0C\u4F60\u521A\u624D\u63D0\u5230\u95C7\u591C\u4E86\u5427\uFF01\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5F88\u4E45\u4EE5\u524D\uFF0C\\n\u5DEE\u70B9\u6BC1\u706D\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u9ED1\u8272\u65CB\u6DA1\uFF0C\\r\\n\u540D\u5B57\u5C31\u53EB\u95C7\u591C\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54A6\uFF1F[VAR 0100(0000)]\uFF0C\\n\u90A3\u4F60\u662F\u6765\u505A\u4EC0\u4E48\u7684\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u8981\u963B\u6B62\u95C7\u591C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u8981\u627E\u51FA\u88AB\u79F0\u4E3A\u5251\u7684\u5B9D\u53EF\u68A6"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u8981\u627E\u51FA\u88AB\u79F0\u4E3A\u76FE\u7684\u5B9D\u53EF\u68A6"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u963B\u6B62\u95C7\u591C\u2026\u2026\\c\\n\u4E5F\u5C31\u662F\u8BF4\uFF0C\u4F60\u8981\u627E\u51FA\\n\u88AB\u79F0\u4E3A\u5251\u548C\u76FE\u7684\u5B9D\u53EF\u68A6\u5417\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5982\u679C\u4F20\u8BF4\u662F\u771F\u7684\uFF0C\u90A3\u4E48\u5251\u548C\u76FE\\n\u5C31\u662F\u80FD\u591F\u4E3A\u6211\u4EEC\u5E73\u606F\u95C7\u591C\u2026\u2026\\r\\n\u9A71\u6563\u65CB\u6DA1\u7684\u5B9D\u53EF\u68A6\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u4E86\uFF01\\n\u4F60\u62FF\u7740\u8FD9\u4E2A\u5148\u53BB\u5FAE\u5BD0\u68EE\u6797\u5427\uFF01\\c\\n\u6211\u8FD8\u6709\u653E\u4E0D\u4E0B\u7684\u4E8B\u60C5\u9700\u8981\u8C03\u67E5\u3002\\n\u4E8B\u540E\u6211\u4F1A\u7ACB\u523B\u8FFD\u4E0A\u53BB\u7684\u3002[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u8FD8\u5F97\u67E5\u4E00\u67E5\uFF0C\\n\u5251\u548C\u76FE\u8FD9\u4E24\u53EA\u5B9D\u53EF\u68A6\u662F\u4ECE\u54EA\u91CC\u6765\u7684\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5B69\u5B50\uFF0C\u5C3D\u529B\u800C\u4E3A\u5C31\u597D\u3002\\c\\n\u56E0\u4E3A\u4F60\u5DF2\u7ECF\u662F\u4E00\u4E2A\\n\u51FA\u8272\u7684\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u4E86\uFF01[VAR 0114(0008)]"
  }
]
