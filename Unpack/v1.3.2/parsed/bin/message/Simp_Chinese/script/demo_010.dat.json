    "text": "\u6B22\u8FCE\u6765\u5230\u5B9D\u53EF\u68A6\u7684\u4E16\u754C\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u4EEC\u4F3D\u52D2\u5C14\u5730\u533A\u7684\\n\u81EA\u7136\u666F\u89C2\u548C\u57CE\u9547\u5BB9\u8C8C\u5341\u5206\u7F8E\u4E3D\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8FD8\u6709\u8BB8\u591A\u5B9D\u53EF\u68A6\u548C\u5927\u5BB6\\n\u4E00\u8D77\u5728\u6B64\u5171\u540C\u751F\u6D3B\uFF0C\u5176\u4E50\u878D\u878D\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u518D\u5F3A\u8C03\u4E00\u6B21\uFF01\\n\u5B9D\u53EF\u68A6\u662F\u6211\u4EEC\u91CD\u8981\u7684\u4F19\u4F34\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5728\u751F\u6D3B\u4E2D\uFF0C\u5B83\u4EEC\u548C\u6211\u4EEC\u9F50\u5FC3\u534F\u529B\u2026\u2026\\n\u771F\u662F\u4E0D\u53EF\u601D\u8BAE\u7684\u751F\u7269\u554A\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6CA1\u9519\uFF01\u5927\u6D77\u3001\u5929\u7A7A\u3001\u8857\u4E0A\u2026\u2026\\n\u5230\u5904\u90FD\u80FD\u770B\u5230\u5B9D\u53EF\u68A6\u7684\u8EAB\u5F71\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u800C\u57F9\u80B2\u5B9D\u53EF\u68A6\uFF0C\u6307\u6325\u5B83\u4EEC\\n\u5BF9\u6218\uFF0C\u4E92\u76F8\u5207\u78CB\u7684\u4EBA\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5219\u88AB\u79F0\u4E3A\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u54E6\uFF01\u5DEE\u70B9\u5FD8\u4E86\u81EA\u6211\u4ECB\u7ECD\u3002\\n\u6211\u53EB\u6D1B\u5179\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\uFF0C\u8BF7\u5404\u4F4D\u6B23\u8D4F\u7531\\n\u4F3D\u52D2\u5C14\u5730\u533A\u6700\u5F3A\u7684\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u2014\u2014"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u51A0\u519B\u4E39\u5E1D\u6240\u5E26\u6765\u7684\u5BF9\u6218\u8868\u6F14\uFF01\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E39\u5E1D\uFF01\u867D\u8BF4\u8FD9\u662F\u8868\u6F14\u8D5B\u2026\u2026\\n\u4F46\u662F\u6211\u4F1A\u7EC8\u7ED3\u4F60\u7684\u4E0D\u8D25\u7EAA\u5F55\uFF01"
