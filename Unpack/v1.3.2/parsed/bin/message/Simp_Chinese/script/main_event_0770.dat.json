[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\uFF01\\c\\n\u8981\u60F3\u6311\u6218\u5361\u829C\uFF0C\\n\u4F60\u5FC5\u987B\u5148\u62FF\u5230\u8349\u8DEF\u9547\u7684\u8349\u4E4B\u5FBD\u7AE0\uFF0C\\r\\n\u4EE5\u53CA\u6C34\u821F\u9547\u7684\u6C34\u4E4B\u5FBD\u7AE0\u54E6\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54E6\uFF01\u9053\u9986\u6311\u6218\u8005\uFF01\\n\u4F60\u6709\uFF12\u679A\u5FBD\u7AE0\uFF0C\u771F\u4E86\u4E0D\u8D77\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u5361\u829C\u597D\u50CF\u6B63\u5728\\n\u7B2C\u4E8C\u77FF\u5C71\u7279\u8BAD\u5462\u3002\\r\\n\u4F60\u4ECE\u6C34\u821F\u9547\u53BB\u627E\u4ED6\u5427\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\uFF01\\n\u6B22\u8FCE\u4F60\u524D\u6765\u6311\u6218\uFF01\\c\\n\u9053\u9986\u6311\u6218\u662F\u5F88\u8270\u96BE\u7684\u2026\u2026\\n\u80FD\u6311\u6218\u5361\u829C\u7684\u4EBA\u53EF\u4E0D\u591A\u54E6\u3002\\r\\n\u9700\u8981\u6211\u73B0\u5728\u5C31\u5E2E\u4F60\u529E\u624B\u7EED\u5417\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u597D\u7684\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\u968F\u65F6\u6B22\u8FCE\u4F60\u518D\u6765\u6311\u6218\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u65E2\u7136\u4F60\u8981\u53C2\u52A0\u9053\u9986\u6311\u6218\uFF0C\\n\u90A3\u5C31\u8BF7\u5148\u6362\u4E0A\u7ADE\u6280\u670D\u5427\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u5B8C\u6210\u9053\u9986\u4EFB\u52A1\u5566\uFF01\\n\u606D\u559C\u4F60\uFF01\u592A\u7CBE\u5F69\u4E86\uFF01\\c\\n\u63A5\u4E0B\u6765\u5C31\u8981\u6311\u6218\u5361\u829C\u4E86\u2026\u2026\\n\u8C01\u66F4\u70ED\u8840\uFF0C\u8C01\u5C31\u80FD\u5360\u636E\u4E3B\u52A8\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u706B\u5C5E\u6027\u7684\u9053\u9986\u4EFB\u52A1\u522B\u6709\u4E00\u756A\u7279\u8272\uFF01\\n\u8BF7\u5427\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8BF7\u6536\u4E0B\u8FD9\u4E2A\u62DB\u5F0F\u5B66\u4E60\u5668\\n\u5F53\u505A\u7EAA\u5FF5\u5427\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u53E6\u5916\uFF0C\u4E5F\u6536\u4E0B\u8FD9\u5957\u7ADE\u6280\u670D\u5427\uFF01\\n\u6B3E\u5F0F\u548C\u5361\u829C\u7A7F\u7684\u90A3\u5957\u662F\u4E00\u6837\u7684\u54E6\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u80FD\u6311\u6218\u5361\u829C\u7684\u4EBA\u672C\u6765\u5C31\u4E0D\u591A\uFF0C\\n\u80FD\u6218\u80DC\u5361\u829C\u7684\u4EBA\u5C31\u66F4\u662F\u5C11\u4E4B\u53C8\u5C11\u4E86\u3002\\r\\n\u4F60\u7684\u6F5C\u529B\u771F\u662F\u8BA9\u4EBA\u671F\u5F85\u554A\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u662F\u6765\u6311\u6218\u9053\u9986\u4EFB\u52A1\u7684\u5427\uFF01\\n\u90A3\u5C31\u62FC\u547D\u8D5A\u53D6\u5206\u6570\u5427\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54DF\uFF01[VAR 0100(0000)]\uFF01\\n\u6211\u548C\u5361\u829C\u6253\u4E86\u573A\u8D85\u706B\u70ED\u7684\u5BF9\u6218\u54E6\uFF01[VAR 0114(0005)]"
  }
