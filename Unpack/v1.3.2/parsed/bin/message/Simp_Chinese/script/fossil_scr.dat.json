    "text": "\u8981\u5C06\u54EA\u4E2A\u5316\u77F3\u590D\u539F\u6210\u5B9D\u53EF\u68A6\uFF1F"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u597D\uFF01\u4EA4\u7ED9\u6211\u5427\uFF01\\n\u5C06[VAR 0109(0000)]\u590D\u539F\u6210\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8981\u53D6\u6D88\u5316\u77F3\u7684\u590D\u539F\u5417\uFF1F\\n\u554A\u2026\u2026\u5E0C\u671B\u4F60\u80FD\u61C2\u6211\u7684\u6D6A\u6F2B\u554A\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4ECE\u4F60\u90A3\u91CC\u6536\u5230\u7684\u5316\u77F3\u5DF2\u7ECF\u53D8\u56DE\u5B9D\u53EF\u68A6\u4E86\uFF01\\n\u8FD9\u5C31\u662F[VAR 0101(0001)]\uFF01\\c\\n\u4F60\u53EF\u8981\u597D\u597D\u7167\u6599\u5B83\u554A\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0002)]\\n\u83B7\u5F97\u4E86[VAR 0101(0001)]\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u2026\u2026\u55EF\uFF1F\u600E\u4E48\u4E86\uFF0C\u600E\u4E48\u4E86\uFF0C\\n\u540C\u884C\u7684\u5B9D\u53EF\u68A6\u4E0D\u662F\u6EE1\u4E86\u561B\u3002\\c\\n\u5728\u4F60\u6765\u9886\u56DE\u5B83\u4E4B\u524D\uFF0C\u6211\u4F1A\u66FF\u4F60\u4FDD\u7BA1\u7684\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u603B\u6709\u4E00\u5929\uFF0C\u6211\u4F1A\u8BA9\u8FD9\u91CC\u904D\u5730\\n\u90FD\u662F\u5F88\u4E45\u4EE5\u524D\u7684\u5B9D\u53EF\u68A6\uFF01\\c\\n\u8FD9\u5C31\u662F\u68A6\u60F3\u7267\u573A\uFF01\\n\u592A\u53E4\u4E16\u754C\u7684\u91CD\u73B0\uFF01"
