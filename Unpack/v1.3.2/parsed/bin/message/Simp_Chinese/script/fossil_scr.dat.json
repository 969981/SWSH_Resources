  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u60F3\u89C1\u5230\u5F88\u4E45\u4EE5\u524D\\n\u5C31\u6D88\u5931\u4E86\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u90A3\u5C31\u53BB\u5BFB\u627E\u5316\u77F3\u5427\uFF01\\n\u4F60\u77E5\u9053\u5316\u77F3\u7684\u4E8B\u60C5\u5427\uFF1F"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u627E\u5230\u5316\u77F3\u4E86\uFF0C\\n\u5C31\u628A\u5B83\u4EA4\u7ED9\u6211\u7684\u7238\u7238\u5427\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6240\u8C13\u5316\u77F3\u5462\uFF0C\\n\u5C31\u662F\u5F88\u4E45\u4EE5\u524D\u7684\u5B9D\u53EF\u68A6\\r\\n\u88AB\u4FDD\u5B58\u5728\u5730\u5C42\u91CC\u800C\u5F62\u6210\u7684\u4E1C\u897F\u54E6\u3002\\c\\n\u6240\u4EE5\uFF0C\u6211\u4EEC\u53EF\u4EE5\u5C06\u5B83\u590D\u539F\u6210\u53E4\u4EE3\u7684\u5B9D\u53EF\u68A6\uFF01\\n\u4F60\u770B\uFF0C\u662F\u4E0D\u662F\u5F88\u6D6A\u6F2B\u554A\uFF01"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u2026\u2026\u54C7\uFF01\\n\u4F60\u597D\u5389\u5BB3\u554A\uFF01\\c\\n\u4F60\u7ADF\u7136\u83B7\u5F97\u4E86\u6240\u6709\\n\u4ECE\u5316\u77F3\u590D\u539F\u800C\u6210\u7684\u5B9D\u53EF\u68A6\u3002\\c\\n\u4F60\u592A\u5389\u5BB3\u4E86\uFF0C\u6240\u4EE5\u6211\u8981\u7ED9\u4F60\u5956\u52B1\uFF01\\n\u5C31\u662F\u201C\u5316\u77F3\u5927\u5E08\u201D\u7684\u79F0\u53F7\u4EE5\u53CA\u5956\u54C1\u5566\uFF01"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u4F60\u662F\u4E00\u4E2A\u5BF9\u5316\u77F3\u5341\u5206\u6709\u5174\u8DA3\u7684\u4EBA\u5417\uFF1F\\c\\n\u6211\u7684[VAR 0109(000A)]\\n\u53D8\u6210\u4E86\u4EC0\u4E48\u5B9D\u53EF\u68A6\u5462\uFF1F\\c\\n\u5982\u679C\u4F60\u60F3\u77E5\u9053\u7B54\u6848\uFF0C\\n\u5C31\u6765\u548C\u6211\u8FDB\u884C\u5B9D\u53EF\u68A6\u5BF9\u6218\u770B\u770B\u5427\uFF1F"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u90A3\u53EF\u771F\u662F\u592A\u9057\u61BE\u592A\u53EF\u60DC\u4E86\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u6CA1\u9519\u6CA1\u9519\uFF01[VAR 0109(000A)]\u4F1A\u53D8\u6210\\n[VAR 0101(000B)]\u54E6\uFF5E"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u9664\u4E86[VAR 0109(000A)]\uFF0C\\n\u6211\u4E5F\u597D\u60F3\u770B\u770B\u5176\u4ED6\u7684\u5316\u77F3\u554A\uFF01"
  }
