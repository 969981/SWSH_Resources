    "text": "\u53C8\u662F\u4F60\u554A\u2026\u2026[VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F4E\u6C34\u5E73\u7684\u5BF9\u6218\u4F1A\u8BA9\u5B9D\u53EF\u68A6\\n\u53D7\u59D4\u5C48\u7684\uFF0C\u8FD9\u4E00\u70B9\u4F60\u4E5F\u540C\u610F\u5427\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u672C\u6765\u662F\u6CA1\u6709\u5FC3\u60C5\u548C\\n\u65E0\u80FD\u4E4B\u8F88\u4EA4\u6218\u7684\u3002\\c\\n\u4F46\u662F\uFF0C\u65AD\u4E86\u65E0\u80FD\u4E4B\u8F88\u7684\u975E\u5206\u4E4B\u60F3\uFF0C\\n\u4E5F\u7B97\u662F\u4E00\u79CD\u6148\u60B2\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u81EA\u4EE5\u4E3A\u5F88\u6709\u5B9E\u529B\uFF0C\\n\u90A3\u5C31\u6765\u6311\u6218\u6211\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5411\u4F60\u6311\u6218\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u2026\u2026\u7B49\u4E00\u4E0B"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u53EF\u662F\u4F1A\u957F\u63D0\u62D4\u7684\u7CBE\u82F1\uFF01\\n\u5931\u8D25\u548C\u6211\u662F\u65E0\u7F18\u7684\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54FC\u2026\u2026\uFF01\\n\u65E0\u80FD\u4E4B\u8F88\uFF0C\u8FD8\u4E0D\u901F\u901F\u79BB\u53BB\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5931\u656C\u5931\u656C\uFF0C\\n\u6211\u8981\u64A4\u56DE\u524D\u8A00\u3002\\c\\n\u4F60\u8FD8\u4E0D\u7B97\u65E0\u80FD\uFF0C\\n\u53EA\u662F\u6709\u4E00\u70B9\u5F31\u800C\u5DF2\u3002\\c\\n\u53CD\u6B63\u51ED\u4F60\u8FD9\u70B9\u672C\u4E8B\uFF0C\\n\u662F\u65E0\u6CD5\u5728\u9053\u9986\u6311\u6218\u4E2D\u664B\u7EA7\u7684\uFF0C\\r\\n\u5C31\u9001\u4F60\u8FD9\u4E2A\u5F53\u505A\u7EAA\u5FF5\u5427\u3002[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\uFF0C\\n\u6211\u8BE5\u5230\u54EA\u91CC\u6536\u96C6\u8BB8\u613F\u661F\u5462\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4E0D\u80FD\u800D\u5634\u76AE\u5B50\u2026\u2026\\c\\n\u5426\u5219\u53C8\u8981\u88AB\u90A3\uFF5E\u5BB6\u4F19\u7684\\n\u5B9D\u53EF\u68A6\u6253\u7206\u5566\u2026\u2026[VAR 0114(0043)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u8981\u505A\u4E2A\u7F8E\u68A6\u2026\u2026\\n\u6253\u8D62\u5BF9\u6218\u7684\u7F8E\u68A6\u2026\u2026[VAR 0114(0044)]"
  }
