[
  {
    "index": 0,
    "flags": 0,
    "text": "\u82F1\u96C4\u4E4B\u6CC9\u2026\u2026\\c\\n\u662F\u5F88\u4E45\u4EE5\u524D\u7684\u4E24\u4F4D\u82F1\u96C4\\n\u94F2\u9664\u90AA\u6076\u540E\u7597\u4F24\u7684\u5730\u65B9\u3002[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u73B0\u5728\u53EA\u6709\u5B9D\u53EF\u68A6\\n\u624D\u80FD\u6CE1\u82F1\u96C4\u4E4B\u6CC9\u2026\u2026\\c\\n\u90A3\u2026\u2026\u4F20\u8BF4\u4E2D\u7684\u82F1\u96C4\\n\u8FC7\u53BB\u662F\u600E\u4E48\u6CE1\u7684\u6E29\u6CC9\u5462\uFF1F\\c\\n\u2026\u2026\u7A0D\u540E\u6211\u518D\u8C03\u67E5\u4E00\u4E0B\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u65E2\u7136\u4F60\u4EEC\u5728\u5FAE\u5BD0\u68EE\u6797\\n\u9047\u5230\u4E86\u795E\u79D8\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u90A3\u8BF4\u4E0D\u5B9A\u4F60\u4EEC\u4FE9\u4E5F\u80FD\u6210\u4E3A\u82F1\u96C4\u54E6\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5251\u548C\u76FE\u7684\u82F1\u96C4\u5417\u2026\u2026\uFF1F\\n\u90A3\u6211\u8981\u5F53\u62FF\u76FE\u7684\u82F1\u96C4\u3002[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5251\u548C\u76FE\u7684\u82F1\u96C4\u5417\u2026\u2026\uFF1F\\n\u90A3\u6211\u8981\u5F53\u6301\u5251\u7684\u82F1\u96C4\u3002[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u771F\u597D\u5947\uFF0C\u5F88\u4E45\u4EE5\u524D\u7684\u82F1\u96C4\\n\u7A76\u7ADF\u7ECF\u5386\u4E86\u4EC0\u4E48\u6837\u7684\u6218\u6597\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u563F\uFF0C[VAR 0100(0000)]\uFF0C\\n\u6211\u4EEC\u6765\u5BF9\u6218\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u597D\u554A\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u8981\u4E00\u8DEF\u5411\u524D\uFF0C\u53D8\u5F97\u66F4\u5F3A\uFF01\\c\\n\u4E0D\u4EC5\u8981\u6253\u8D62\u51A0\u519B\uFF0C\u8D85\u8FC7\u82F1\u96C4\uFF0C\\n[VAR 0100(0000)]\uFF01\u6211\u8FD8\u8981\u6218\u80DC\u4F60\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u2026\u2026\u6CA1\u529E\u6CD5\u3002\\n\u4F60\u5148\u53BB\u51C6\u5907\u597D\u518D\u8BF4\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5403\u4E86\u7D22\u59AE\u4E9A\u8BF7\u5BA2\u7684\u7F8E\u5473\u5496\u55B1\u996D\uFF0C\\n\u6709\u4E00\u80A1\u5E72\u52B2\u6EDA\u6EDA\u800C\u6765\u5566\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u867D\u7136\u6211\u5B8C\u5168\u4E0D\u61C2\u4F60\u5728\u8BF4\u4EC0\u4E48\uFF0C\\n\u4F46\u662F\u673A\u4F1A\u96BE\u5F97\uFF0C\u5C31\u8BA9\u6211\u89C1\u8BC6\u4E00\u4E0B\u5427\u3002\\c\\n[VAR 0100(0000)]\uFF0C\u6211\u6765\u5E2E\u4F60\u7684\\n\u5B9D\u53EF\u68A6\u6062\u590D\u6D3B\u529B\uFF0C\u8981\u597D\u597D\u8868\u73B0\u54E6\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8FD9\u53EF\u662F\u672A\u6765\u51A0\u519B\u5E26\u6765\u7684\u8868\u6F14\u8D5B\u54E6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8C22\u8C22\u4F60\u4EEC\u4E24\u4E2A\uFF01\\n\u771F\u662F\u573A\u7CBE\u5F69\u7684\u5BF9\u6218\uFF01\u4F60\u4EEC\u8981\u2026\u2026\\r\\n\u4FDD\u6301\u8FD9\u80A1\u52B2\u5934\uFF0C\u51FB\u8D25\u65E0\u654C\u7684\u4E39\u5E1D\u554A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\uFF0C\u4F60\u4EEC\u6709\u4EC0\u4E48\u6253\u7B97\uFF1F\\c\\n\u6211\u6253\u7B97\u8FDE\u5FAE\u5BD0\u68EE\u6797\u4E5F\u4E00\u8D77\u8C03\u67E5\u4E00\u4E0B\u3002[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6211\u4F1A\u53CD\u590D\u6311\u6218\u9053\u9986\uFF0C\\n\u76F4\u5230\u6210\u529F\u4E3A\u6B62\uFF01\\c\\n\u62FF\u5230\u9053\u9986\u5FBD\u7AE0\u4E4B\u540E\uFF0C\\n\u6211\u51C6\u5907\u7A7F\u8FC7\uFF19\u53F7\u9053\u8DEF\uFF0C\\r\\n\u524D\u5F80\u5C16\u9489\u9547\uFF01\u56DE\u89C1\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u770B\u6765\u4ED6\u7EC8\u4E8E\u60F3\u901A\u4E86\u3002\\c\\n\u8981\u662F\u8D6B\u666E\u65E0\u7CBE\u6253\u91C7\u7684\u8BDD\uFF0C\\n\u4E39\u5E1D\u4E5F\u4F1A\u653E\u5FC3\u4E0D\u4E0B\u7684\u3002\\c\\n\u800C\u4E14\u4F60\u8EAB\u4E3A\u4ED6\u7684\u52B2\u654C\uFF0C\\n\u4E5F\u4F1A\u89C9\u5F97\u63D0\u4E0D\u8D77\u52B2\u6765\u5427\uFF01\u90A3\u518D\u89C1\u5566\u3002[VAR 0114(000B)]"
  }
]
