    "text": "\u60F3\u4E0D\u5230\u8FD9\u7247\u96EA\u539F\u4E0A\\n\u7ADF\u7136\u4F1A\u6709\u90A3\u4E48\u51F6\u66B4\u7684\u5B9D\u53EF\u68A6\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u7B80\u76F4\u5C31\u50CF\u662F\u4F20\u8BF4\u4E2D\u56FD\u738B\u7684\\n\u90A3\u53EA\u66B4\u8E81\u7684\u7231\u9A6C\u2026\u2026[VAR 0114(007A)]"
