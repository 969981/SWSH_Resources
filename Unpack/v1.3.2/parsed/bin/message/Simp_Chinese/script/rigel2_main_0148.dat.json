    "flags": 0,
    "text": "\u54CE\u5440\uFF1F\u90A3\u662F\u2026\u2026\\n\u9ED1\u8272\u9B03\u6BDB\uFF1F[VAR 0114(007A)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4F20\u8BF4\u91CC\u6709\u63D0\u5230\uFF0C\\n\u56E0\u56FD\u738B\u4E4B\u529B\u800C\u7EFD\u653E\u7684[VAR FF00(0006)]\u5149\u8F89\u4E4B\u82B1[VAR FF00(0000)]\u2026\u2026\\r\\n\u53EA\u8981\u5C06\u5B83\u548C\u7231\u9A6C\u7684\u9B03\u6BDB\u7F1D\u5408\u5728\u4E00\u8D77\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5C31\u80FD\u5236\u6210\u8BA9\u56FD\u738B\u4E0E\u7231\u9A6C\\n\u7D27\u5BC6\u76F8\u8FDE\u7684\u7275\u7ECA\u7F30\u7EF3\u2026\u2026[VAR 0114(007A)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u636E\u8BF4\u6211\u7684\u7956\u5148\\n\u66FE\u7ECF\u4E5F\u6548\u4EFF\u8FD9\u4E2A\u4F20\u8BF4\uFF0C\\r\\n\u5236\u4F5C\u8FC7\u7F30\u7EF3\u5462\u3002[VAR 0114(007A)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u6211\u4ECE\u6765\u90FD\u6CA1\u89C1\u8FC7\u90A3\u79CD\u82B1\u513F\uFF0C\\n\u5236\u4F5C\u7F30\u7EF3\u7684\u4F20\u7EDF\u4E5F\u65E9\u5C31\u6CA1\u843D\u4E86\u3002[VAR 0114(007A)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u2026\u2026\u597D\u4E86\uFF01\u6211\u4E0D\u80FD\\n\u5149\u987E\u7740\u8BB2\u4F20\u8BF4\u7684\u6545\u4E8B\u4E86\uFF01[VAR 0114(007A)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6211\u5F97\u53BB\u60F3\u60F3\u5BF9\u7B56\uFF0C\\n\u597D\u8BA9\u90A3\u53EA\u5B9D\u53EF\u68A6\\r\\n\u6CA1\u6CD5\u518D\u6765\u6751\u91CC\u6363\u4E71\u3002[VAR 0114(007A)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u90A3\u6211\u5C31\u5148\u544A\u8F9E\u4E86\u3002\\n\u8FD9\u6B21\u771F\u662F\u592A\u611F\u8C22\u4F60\u5566\u3002[VAR 0114(007A)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u5C0F\u670B\u53CB\u2026\u2026\\n\u8C22\u8C22\u4F60\u6551\u4E86\u6211\u4EEC\u554A\u3002"
  },
  {
