[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5965\u5229\u8587\u6311\u9009\u7684\u8054\u76DF\u804C\u5458\u554A\u2026\u2026\\c\\n\u8FD9\u4E2A\u561B\u2026\u2026\u6211\u4EEC\u53BB\u628A\\n\u90A3\u4E2A\u574F\u8054\u76DF\u804C\u5458\u627E\u51FA\u6765\u5427\u3002\\c\\n\u6211\u8BB0\u5F97\u90A3\u4E2A\u574F\u804C\u5458\u6234\u4E86\u4E00\u526F\\n\u5947\u602A\u7684\u58A8\u955C\uFF0C\u6CA1\u9519\u5427\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u8BB0\u5F97\u90A3\u4E2A\u574F\u804C\u5458\u6234\u4E86\u4E00\u526F\\n\u5947\u602A\u7684\u58A8\u955C\uFF0C\u6CA1\u9519\u5427\uFF1F\\c\\n\u53E6\u5916\uFF0C\u627E\u4EBA\u7684\u7A8D\u95E8\u5C31\u662F\u2026\u2026\\n\u4E0D\u538C\u5176\u70E6\uFF0C\u591A\u591A\u6253\u542C\u3002[VAR 0114(0016)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5176\u4ED6\u5730\u65B9\u90FD\u6CA1\u4EBA\u770B\u5230\u8FC7\\n\u90A3\u4E2A\u574F\u8054\u76DF\u804C\u5458\u3002\\c\\n\u6240\u4EE5\u4ED6\u4E00\u5B9A\u85CF\u5728\u8FD9\u9644\u8FD1\u3002[VAR 0114(0016)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4EBA\u4E00\u65E6\u88AB\u903C\u6025\u4E86\uFF0C\\n\u5C31\u559C\u6B22\u8EB2\u5230\u72ED\u7A84\u7684\u5730\u65B9\u53BB\u3002\\r\\n\u8FD9\u9644\u8FD1\u6709\u6CA1\u6709\u7BB1\u5B50\u4E4B\u7C7B\u7684\u5462\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u79D8\u4E66\u5236\u9020\u7684\u95F9\u5267\u5230\u6B64\u7ED3\u675F\u4E86\u554A\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u5450\u558A\u961F\u7684\u90A3\u4E9B\u59A8\u788D\u4EBA\u7684\\n\u5957\u8DEF\u4E5F\u90FD\u662F\u5C0F\u6253\u5C0F\u95F9\u3002\\r\\n\u4E94\u5341\u6B65\u7B11\u767E\u6B65\u7684\u8BDD\u8FD8\u662F\u4E0D\u8BF4\u4E86\u3002\\c\\n\u597D\u4E86\uFF0C\u6211\u4EEC\u53BB\u8F66\u7AD9\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u2026\u2026\u2026\u2026\u2026\u2026"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u662F[VAR 0100(0000)]\u554A\uFF01\\n\u8FD9\u5BB6\u4F19\u5F88\u53EF\u7591\uFF0C\u4E00\u76F4\u4E0D\u80AF\u56DE\u5934\uFF01\\c\\n\u4F60\u8BF4\u70B9\u4EC0\u4E48\u8BA9\u4ED6\u5403\u60CA\u7684\u8BDD\uFF0C\\n\u8BA9\u4ED6\u8F6C\u8FC7\u5934\u6765\u5427\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5965\u5229\u8587\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u627E\u5230\u94A5\u5319\u4E86\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u8BF4\u4EC0\u4E48\uFF01\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7CDF\u7CD5\uFF01\\n\u6211\u4E0D\u5C0F\u5FC3\u56DE\u5934\u4E86\u3002\\c\\n\u8FD9\u4E0B\u53EF\u8EB2\u4E0D\u8FC7\u53BB\u4E86\uFF01\\n\u6CA1\u529E\u6CD5\uFF0C\u6765\u5BF9\u6218\u5427\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u53EA\u8981\u85CF\u8D77\u6765\uFF0C\\n\u5C31\u4E0D\u7528\u4EA4\u51FA\u94A5\u5319\u4E86\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8FD9\u5BB6\u4F19\u6E9C\u5F97\u771F\u5FEB\u2026\u2026\\n\u6211\u90FD\u6CA1\u770B\u89C1\u4ED6\u85CF\u5230\u4E86\u54EA\u91CC\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u600E\u4E48\u77E5\u9053\u6211\u5728\u8FD9\u91CC\u2026\u2026\uFF1F\\n\u8FD8\u662F\u8BF4\uFF0C\u4F60\u53EA\u662F\u5728\u968F\u4FBF\u642D\u8BDD\uFF1F\\r\\n\u65E0\u6240\u8C13\u4E86\uFF01\u6765\u5BF9\u6218\u5427\uFF01\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5C0F\u9690\u9690\u4E8E\u91CE\uFF0C\\n\u5927\u9690\u9690\u4E8E\u5E02\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\u773C\u529B\uFF01\\n\u8FD9\u6B21\u6211\u4E00\u5B9A\u8981\u6253\u8D25\u4F60\uFF0C\\r\\n\u7136\u540E\u9003\u5F97\u65E0\u5F71\u65E0\u8E2A\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u770B\u6765\u6211\u7EC8\u4E8E\u88AB\u903C\u5230\u7EDD\u5883\u4E86\u2026\u2026\\c\\n\u4E0D\u8FC7\uFF0C\u6211\u4E0D\u60F3\u8BA9\u5965\u5229\u8587\u5C0F\u59D0\u751F\u6C14\uFF0C\\n\u6240\u4EE5\u6211\u662F\u4E0D\u4F1A\u653E\u5F03\u7684\uFF01\\c\\n\u53EA\u8981\u6211\u5750\u4E0A\u5355\u8F68\u5217\u8F66\uFF0C\\n\u4F60\u4EEC\u5C31\u6349\u4E0D\u5230\u6211\u4E86\u5427\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5450\u558A\u961F\uFF01\u5FEB\u628A\u8D6B\u666E\u53EB\u6765\uFF01\\n\u6211\u4EEC\u4E00\u8D77\u53BB\u8F66\u7AD9\u56F4\u5835\u4ED6\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u80FD\u628A\u574F\u804C\u5458\\n\u903C\u5F97\u8D70\u6295\u65E0\u8DEF\uFF0C\u53EF\u771F\u6709\u4F60\u7684\uFF01\\c\\n\u4E3A\u4E86\u52A9\u5174\u4EE5\u53CA\u6B4C\u9882\u4F60\u7684\u529F\u7EE9\uFF0C\\n\u8BA9\u6211\u4E3A\u4F60\u732E\u4E0A\u4E00\u9996\u8D85\u7EA7\u597D\u542C\u7684\u6B4C\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4E0D\u8D77\u773C\u7684\u5C0F\u6B4C\u624B\uFF0C\u4ED6\u80FD\u6709\u4F55\u4F5C\u4E3A\u3002\\n\u65CB\u5F8B\u4E00\u54CD\u8D77\uFF0C\u4ED6\u77E5\u9053\uFF0C\u5531\u6B4C\u7684\u65F6\u95F4\u5230\u4E86\u2026\u2026[VAR 0114(0016)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4E00\u9996\u6B4C\uFF5E\u80FD\u7ED9\u4EBA\u4EEC\u5E26\u6765\u52C7\u6C14\uFF5E\u4F60\u4FE1\u5417\u266A\\n\u8BF4\u5B9E\u5728\u8BDD\uFF5E\u90A3\u4E0D\u771F\u5B9E\uFF5E\u4E5F\u4E0D\u73B0\u5B9E\uFF5E[VAR 0114(0016)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4E00\u9996\u6B4C\uFF5E\u80FD\u7ED9\u4EBA\u4EEC\u5E26\u6765\u5E78\u798F\uFF5E\u4F60\u4FE1\u5417\u266A\\n\u5728\u6211\u770B\u6765\uFF5E\u65E0\u7A3D\u4E4B\u8C08\uFF5E\u5929\u65B9\u591C\u8C2D\uFF5E[VAR 0114(0016)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u660E\u77E5\u9053\u5531\u6B4C\u65E0\u7528\uFF5E\u5374\u8FD8\u8981\u5531\uFF5E\\n\u65CB\u5F8B\u4E00\u54CD\u8D77\uFF5E\u4ED6\u77E5\u9053\uFF5E\u5531\u6B4C\u7684\u65F6\u95F4\u5230\u4E86\u266A[VAR 0114(0016)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u8042\u6893\uFF01\uFF01"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u597D\u8036\uFF5E\u8042\u6893\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u54A6\uFF0C\u90A3\u4E0D\u662F\u8042\u6893\u5417\uFF1F\\n\u600E\u4E48\u5F00\u8857\u5934\u6F14\u5531\u4F1A\u4E86\u554A\uFF1F"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u6211\u770B\u554A\uFF0C\\n\u8FD8\u4E0D\u5982\u8BF4\u8FD9\u662F\u8F66\u7AD9\u6F14\u5531\u4F1A\u5462\u3002\\c\\n\u95F2\u8BDD\u5C11\u8BF4\uFF0C\\n\u6211\u4EEC\u518D\u9760\u8FC7\u53BB\u4E00\u4E9B\u5427\uFF01"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u8042\u6893\uFF5E\uFF01\\n\u94A5\u5319\u5230\u624B\u4E86\uFF01\\c\\n\u53EF\u4EE5\u4E58\u5750\u5355\u8F68\u5217\u8F66\u53BB\u6D1B\u5179\u5927\u53A6\u5566\uFF01"
