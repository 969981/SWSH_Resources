    "text": "\u8FD8\u6709\u4F60\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4E24\u4E2A\u90FD\u4E0D\u8D56\u3002[VAR 0114(0013)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F46\u4E5F\u7B97\u4E0D\u4E0A\u597D\u5427\u3002\\c\\n\u6CA1\u9519\uFF0C\\n\u4F60\u4EEC\u7684\u7C89\u7EA2\u8272\u8FD8\u4E0D\u591F\u3002\\c\\n\u597D\u597D\u7814\u7A76\u4E00\u4E0B\u8054\u76DF\u5361\uFF0C\\n\u53BB\u6DFB\u52A0\u4E00\u70B9\u7C89\u7EA2\u7684\u5473\u9053\u6765\u5427\u3002[VAR 0114(0013)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u4EEC\u8FDF\u65E9\u5F97\u5411\u6211\u4E00\u5C55\u8EAB\u624B\u7684\u3002\\n\u6240\u4EE5\uFF0C\u8D81\u73B0\u5728\u597D\u597D\u953B\u70BC\u5427\u3002[VAR 0114(0013)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u90A3\u5B69\u5B50\u2026\u2026[VAR 0114(0013)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\u5C31\u5E94\u8BE5\\n\u4E3A\u81EA\u5DF1\u548C\u5B9D\u53EF\u68A6\u800C\u6218\uFF01\\c\\n\u51A0\u519B\u7684\u5B9E\u529B\u662F\u6709\u76EE\u5171\u7779\u7684\uFF0C\\n\u6839\u672C\u4E0D\u9700\u8981\u522B\u4EBA\u6765\u8BC1\u660E\u554A\u3002[VAR 0114(0013)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u5C31\u7B97\u662F\u4F60\u4E3A\u6211\\n\u5C55\u793A\u5B9E\u529B\u7684\u8C22\u793C\u5427\u3002[VAR 0114(0013)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u4F60\u63A5\u4E0B\u6765\u8BE5\u53BB\u6EAF\u4F20\u9547\u7684\u9053\u9986\u4E86\u5427\uFF1F\\n\u5C3D\u60C5\u4EAB\u53D7\u9053\u9986\u6311\u6218\u5427\u3002[VAR 0114(0013)]"
  }
]
