    "text": "\u8FD9\u540D\u5B57\u8D85\uFF5E\u7EA7\u9002\u5408\u4F60\uFF01\\n\u5F97\u597D\u597D\u611F\u8C22\u4F60\u7238\u5988\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5657\uFF01\u4F60\u5E73\u65F6\u90FD\u8FD9\u4E48\u8BF4\u8BDD\u5417\uFF1F\\n\u4F60\u53EF\u771F\u591F\u9017\u7684\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8BDD\u8BF4\uFF0C\u8001\u7239\u4E5F\u6765\u4E86\uFF1F\\c\\n\u6211\u6CA1\u770B\u5230\u4ED6\u554A\u2026\u2026\\n\u5927\u6982\u662F\u8FF7\u4E86\u8DEF\u5C31\u56DE\u5230\u5165\u53E3\u53BB\u4E86\u5427\uFF1F[VAR 0114(0078)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u554A\u5BF9\u4E86\uFF0C\u521A\u624D\u6211\u4E3A\u4E86\u5206\u6563\u8001\u7239\u7684\u6CE8\u610F\u529B\\n\u62FF\u4F60\u5F53\u63A9\u62A4\uFF0C\u5B9E\u5728\u4E0D\u597D\u610F\u601D\u554A\uFF5E[VAR 0114(0078)]"
