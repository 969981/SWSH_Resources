  {
    "index": 20,
    "flags": 0,
    "text": "\u4E0D\u662F\u5427\uFF5E\uFF01\u4F60\u7ADF\u7136\\n\u6253\u8D62\u4E86\u6211\u90A3\u4E2A\u8001\u7239\uFF5E\uFF01\uFF1F[VAR 0114(0078)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u4E0D\u662F\u5427\uFF5E\uFF01\u4F60\u7ADF\u7136\u80FD\u8DDF\\n\u6211\u90A3\u4E2A\u8001\u7239\u6253\u5F97\u6709\u6765\u6709\u56DE\uFF5E\uFF01\uFF1F[VAR 0114(0078)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u90A3\u4E2A\u4EBA\u597D\u6B79\u4E5F\u5F53\u8FC7\u9053\u9986\u9986\u4E3B\u5462\uFF01\\n\u5C31\u7B97\u6B63\u5728\u5EA6\u5047\uFF0C\u4E5F\u7EDD\u5BF9\u4E0D\u597D\u5BF9\u4ED8\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5509\uFF0C\u8BF4\u8D77\u8001\u7239\uFF0C\u4ED6\u5BF9\u8FD9\u56DE\u7684\u5EA6\u5047\\n\u90A3\u53EB\u4E00\u4E2A\u6295\u5165\uFF0C\u7B80\u76F4\u90FD\u75AF\u9B54\u4E86\uFF5E[VAR 0114(0078)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u4ED6\u597D\u50CF\u6253\u7B97\u5E26\u6211\u4E00\u8D77\u6328\u4E2A\u8C03\u67E5\\n\u8FD9\u4E00\u5E26\u7684\u5404\u79CD\u4F20\u8BF4\uFF0C\\r\\n\u6765\u4E00\u573A\u8D27\u771F\u4EF7\u5B9E\u7684\u6240\u8C13\u201C\u63A2\u9669\u4E4B\u65C5\u201D\u3002[VAR 0114(0078)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u5BF9\u6211\u8FD9\u4E2A\u5E74\u7EAA\u7684\u5973\u5B69\u513F\u6765\u8BF4\uFF0C\\n\u8DDF\u81EA\u5DF1\u8001\u7239\u4E00\u8D77\u641E\u8FD9\u79CD\u6D3B\u52A8\uFF0C\\r\\n\u600E\u4E48\u8BF4\u5462\uFF0C\u5B9E\u5728\u662F\u6709\u70B9\u7F9E\u803B\u2026\u2026[VAR 0114(0078)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u518D\u8BF4\u4E86\uFF0C\u6211\u8FD8\u60F3\u8DDF\\n\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u5BF9\u6218\u5462\uFF5E[VAR 0114(0078)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u8DDF\u8D85\uFF5E\u7EA7\u5E9E\u5927\u7684\u5B9D\u53EF\u68A6\\n\u5927\u6218\u4E00\u573A\u7684\u75DB\u5FEB\u611F\u89C9\uFF01\\r\\n\u5149\u662F\u60F3\u8C61\u4E00\u4E0B\u90FD\u2026\u2026\u563F\u563F\u563F\u2026\u2026[VAR 0114(0078)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u2026\u2026\u554A\uFF0C\u5BF9\u4E86\uFF5E\uFF01\\n[VAR 0100(0000)]\uFF0C\u65E2\u7136\u4F60\u8FD9\u4E48\u5389\u5BB3\uFF5E[VAR 0114(0078)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u5E94\u8BE5\u53EF\u4EE5\u4EE3\u66FF\u6211\\n\u966A\u8001\u7239\u8FDB\u884C\u63A2\u9669\u4E4B\u65C5\u5427\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u611F\u89C9\u5F88\u6709\u8DA3\uFF01"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u8FD9\u4E0D\u592A\u597D\u5427"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u5BF9\u5427\uFF01\u5BF9\u5427\uFF5E\uFF01\\n\u8FDE\u6211\u81EA\u5DF1\u90FD\u89C9\u5F97\u8FD9\u4E3B\u610F\u53EF\u771F\u5999\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u6CA1\u4E8B\uFF01\u6CA1\u4E8B\u7684\uFF01\u8001\u7239\u867D\u7136\u770B\u8D77\u6765\\n\u662F\u90A3\u526F\u5FB7\u884C\uFF0C\u4F46\u5176\u5B9E\u633A\u4F1A\u7167\u987E\u4EBA\u7684\u3002[VAR 0114(0078)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u4E3B\u8981\u662F\u6211\u5B9E\u5728\u4E0D\u5FCD\u5FC3\u8BA9\u90A3\u4E48\u5174\u81F4\u52C3\u52C3\\n\u7684\u8001\u7239\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u88AB\u667E\u5728\u90A3\u91CC\uFF5E[VAR 0114(0078)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u800C\u4E14\u4F60\u8981\u662F\u966A\u4ED6\u4E00\u8D77\u7684\u8BDD\uFF0C\u8BF4\u4E0D\u5B9A\\n\u8FD8\u6709\u53EF\u80FD\u4F1A\u9047\u89C1\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u5462\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u6211\u5148\u5728\u6781\u5DE8\u5DE2\u7A74\u91CC\u9762\\n\u73A9\u4E2A\u75DB\u5FEB\u4EE5\u540E\uFF0C\\r\\n\u5C31\u53BB\u627E\u4F60\u4EEC\u6C47\u5408\uFF5E[VAR 0114(0078)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4E24\u4E2A\u5C31\u5148\u53BB\\n\u6328\u4E2A\u8C03\u67E5\u90A3\u4E9B\u4F20\u8BF4\u5427\uFF5E\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u5C31\u62DC\u6258\u4F60\u5E2E\u6211\u5E26\u4E2A\u8BDD\uFF0C\\n\u7136\u540E\u66FF\u6211\u966A\u7740\u8001\u7239\u54AF\uFF5E[VAR 0114(0078)]"
