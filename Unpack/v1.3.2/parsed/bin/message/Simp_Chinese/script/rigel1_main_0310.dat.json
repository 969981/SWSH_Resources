    "text": "\u563F\u3001\u563F\u3001\u563F\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6B66\u9053\u718A\u5E08\u559C\u6B22\u5403\u7684\u6781\u5DE8\u751C\u871C\uFF01\\n\u6211\u4EEC\u6F02\u4EAE\u5730\u641E\u5230\u624B\u4E86\u54E6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54CE\u5466\u5582\uFF5E\uFF01\\n\u5728\u8FD9\u4E48\u77ED\u7684\u65F6\u95F4\u91CC\u5C31\u641E\u5B9A\u4E86\uFF01\uFF1F[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u548C[VAR 0100(0000)]\u4E00\u8D77\u4E0A\uFF0C\\n\u5F53\u7136\u6218\u65E0\u4E0D\u80DC\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5475\u5475\u5475\uFF0C\u6211\u57FA\u672C\u6CA1\u7ED9\u4F60\u4EEC\u7EBF\u7D22\uFF0C\\n\u4F60\u4EEC\u7ADF\u7136\u8FD8\u771F\u627E\u5230\u6781\u5DE8\u751C\u871C\u4E86\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u771F\u725B\uFF0C[VAR 0100(0000)]\uFF01\\n\u8D85\u68D2\uFF0C\u5C0F\u666E\u666E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u679C\u7136\u662F\u5047\u88C5\u5FD8\u8BB0\u4E86\u6781\u5DE8\u751C\u871C\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u52A0\u4E86\u6781\u5DE8\u751C\u871C\u4EE5\u540E\uFF0C\\n\u6B66\u9053\u718A\u5E08\u80AF\u5B9A\u4E5F\u4F1A\\r\\n\u613F\u610F\u559D\u4E0B\u6781\u5DE8\u6C64\u4E86\u554A\uFF01"
