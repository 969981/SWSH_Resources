  {
    "index": 21,
    "flags": 0,
    "text": "\u7B49\u5230\u4F60\u548C\u9A6C\u58EB\u5FB7\u5E08\u5085\u5BF9\u6218\u7684\u65F6\u5019\uFF0C\\n\u6211\u4E5F\u4F1A\u8D76\u6765\u4E3A\u4F60\u52A0\u6CB9\u7684\uFF01[VAR 0114(0005)]"
