  {
    "index": 33,
    "flags": 0,
    "text": "\u539F\u6765\u8D6B\u666E\u662F\u90A3\u4E2A\u4E39\u5E1D\u7684\u5F1F\u5F1F\u554A\uFF01\uFF1F\\c\\n\u6240\u4EE5\uFF0C\u770B\u8D77\u6765\u548C\u8D6B\u666E\u5173\u7CFB\u8FD9\u4E48\u597D\u7684\\n[VAR 0100(0000)]\u4F60\u7A76\u7ADF\u53C8\u662F\u2026\u2026\uFF1F"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u8D6B\u666E\u2026\u2026\u7B11\u5BB9\u90A3\u4E48\u9633\u5149\uFF0C\\n\u6027\u683C\u53C8\u662F\u90A3\u4E48\u7EAF\u6D01\u800C\u53C8\u4F53\u8D34\u2026\u2026\\c\\n\u554A\uFF5E\u4E0D\u884C\uFF01\u6211\u6C38\u8FDC\u53EA\u559C\u6B22\\n\u4E2A\u6027\u4E56\u5F20\u7684\u514B\u62C9\u62C9\uFF01"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u8D6B\u666E\u2026\u2026\u7B11\u5BB9\u90A3\u4E48\u9633\u5149\uFF0C\\n\u6027\u683C\u53C8\u662F\u90A3\u4E48\u7EAF\u6D01\u800C\u53C8\u4F53\u8D34\u2026\u2026\\c\\n\u554A\uFF5E\u4E0D\u884C\uFF01\u6211\u6C38\u8FDC\u53EA\u559C\u6B22\u5446\u5446\u7684\u8D5B\u5B9D\u5229\uFF01"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u6709\u4F20\u95FB\u8BF4\uFF0C\u9A6C\u5E08\u5085\u6B66\u9986\u66FE\u6709\u8FC7\\n\u56E0\u4E3A\u96BE\u5EA6\u592A\u9AD8\u800C\u88AB\u5C01\u5370\u8D77\u6765\u7684\u8BAD\u7EC3\u3002"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u6211\u4E00\u76F4\u5728\u601D\u8003\u8981\u8BA9\u718A\u5F92\u5F1F\\n\u8FDB\u5316\u6210\u54EA\u4E00\u79CD\u5C5E\u6027\uFF0C\\r\\n\u7ED3\u679C\u4E0D\u77E5\u4E0D\u89C9\u95F4\uFF11\u5929\u5C31\u8FC7\u53BB\u4E86\u2026\u2026"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6709\u4E2A\u53EF\u6015\u7684\u4F20\u95FB\uFF0C\u4F60\u60F3\u4E0D\u60F3\u542C\uFF1F\\c\\n\u636E\u8BF4\uFF0C\u5728\u94E0\u5C9B\u7684\u67D0\u4E2A\u5730\u65B9\u6709\u4E2A\u59D0\u59D0\uFF0C\\n\u5979\u4F1A\u628A\u5B9D\u53EF\u68A6\u7684\u52AA\u529B\\r\\n\u90FD\u6E05\u5F97\u4E00\u5E72\u4E8C\u51C0\u54E6\u2026\u2026"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u8BF4\u8D77\u6765\uFF0C\u9053\u9986\u6311\u6218\u7684\u5B63\u8282\\n\u662F\u4E0D\u662F\u5FEB\u8981\u5230\u4E86\uFF1F\\c\\n\u5E08\u5085\u603B\u662F\u9738\u7740\u7535\u89C6\u4E0D\u653E\uFF0C\\n\u641E\u5F97\u6211\u4EEC\u90FD\u63A5\u89E6\u4E0D\u5230\u5916\u9762\u7684\u6D88\u606F\u5462\uFF5E"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u8D6B\u666E\u8D85\u5E05\u7684\uFF01\\n\u6211\u7684\u5B9D\u53EF\u68A6\u53D7\u4F24\u4E86\uFF0C\\r\\n\u4ED6\u5E2E\u6211\u6CBB\u597D\u4E86\uFF01"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u5988\u5988\u5199\u4FE1\u8DDF\u6211\u8BF4\u4E39\u5E1D\u9000\u5F79\u4E86\uFF01\\n\u771F\u662F\u7684\uFF0C\u73A9\u7B11\u4E5F\u6CA1\u6709\u8FD9\u4E48\u5F00\u7684\u5440\uFF01"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u5514\uFF01\u6211\u6709\u9884\u611F\uFF0C\u4E00\u573A\u64BC\u5929\u52A8\u5730\u7684\u5BF9\u6218\\n\u5C31\u8981\u547C\u5578\u800C\u6765\u4E86\u2026\u2026\uFF01"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u4F60\u5728\u627E\u5E08\u5085\u7684\u8BDD\uFF0C\\n\u6211\u521A\u521A\u770B\u89C1\u4ED6\u559C\u5F62\u4E8E\u8272\u5730\u5F80\u5BF9\u6218\u573A\u53BB\u4E86\u3002"
  }
]
