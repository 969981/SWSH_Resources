  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5457\u554A\uFF5E\u563F\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u9A6C\u5E08\u5085\u6B66\u9986\u6240\u80FD\u6559\u7684\uFF0C\\n\u6211\u57FA\u672C\u4E0A\u5DF2\u7ECF\u90FD\u4E00\u4E1D\u4E0D\u5269\u5730\\r\\n\u6559\u7ED9[VAR 0100(0000)]\u4F60\u4E86\u54EA\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u89C9\u5F97\uFF0C\u73B0\u5728\u7684\u4F60\uFF0C\\n\u5E94\u8BE5\u53EF\u4EE5\u548C\u706B\u529B\u5168\u5F00\u7684\u6211\u6765\u573A\u5BF9\u6218\u4E86\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u800C\u4E14\u8001\u5934\u513F\u6211\u4E5F\u9700\u8981\\n\u7A0D\u5FAE\u8BAD\u7EC3\u4E00\u5C0F\u4E0B\u4E0B\u4E86\u5462\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u7B49\u4F60\u505A\u597D\u4E86\u548C\u706B\u529B\u5168\u5F00\u7684\u8001\u5934\u513F\u6211\\n\u5BF9\u6218\u7684\u5FC3\u7406\u51C6\u5907\u4EE5\u540E\u2026\u2026\\c\\n\u5C31\u5230\u6B66\u9986\u540E\u9762\u7684\u5BF9\u6218\u573A\u6765\u5427\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u706B\u529B\u5168\u5F00\u7684\u5E08\u5085\uFF1F\\n\u90A3\u5230\u5E95\u5F97\u6709\u591A\u5F3A\u5927\u554A\u2026\u2026"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4ED6\u6BD5\u7ADF\u662F\u5927\u54E5\u7684\u5E08\u5085\u5462\u2026\u2026\\n\u7EDD\u5BF9\u5F3A\u5F97\u5413\u6B7B\u4E2A\u4EBA\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u90A3\u5F53\u7136\u4E86\uFF01[VAR 0100(0000)]\uFF01\\n\u4F60\u8981\u505A\u597D\u5FC3\u7406\u51C6\u5907\u518D\u53BB\u6311\u6218\u554A\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u5DEE\u4E0D\u591A\u4E5F\u5F97\u5F00\u59CB\\n\u597D\u597D\u5728\u94E0\u5C9B\u8FDB\u884C\u8C03\u67E5\u4E86\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u4E5F\u8981\u52A0\u6CB9\u554A\uFF01\\n\u4E00\u5982\u65E2\u5F80\uFF0C\u641E\u5B9A\u4E00\u5207\uFF01[VAR 0114(0005)]"
