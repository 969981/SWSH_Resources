    "index": 0,
    "flags": 0,
    "text": "\u770B\u6765\u6F2B\u957F\u7684\u9053\u9986\u6311\u6218\\n\u4E5F\u7EC8\u4E8E\u63A5\u8FD1\u5C3E\u58F0\u4E86\u554A\u3002\\c\\n\u8FD9\u91CC\u662F\u9F99\u4F7F\u8005\u5947\u5DF4\u7EB3\u7EDF\u9886\u7684\u62F3\u5173\u9053\u9986\u3002\\n\u4F60\u505A\u597D\u6311\u6218\u7684\u51C6\u5907\u4E86\u5417\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5F53\u7136\u4E86\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0B\u6B21\u518D\u8BF4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u60F3\u8981\u7A81\u7834\u96BE\u5173\uFF0C\\n\u6709\u65F6\u591A\u5C11\u4E5F\u662F\u9700\u8981\u5BF9\u81EA\u5DF1\u72E0\u4E00\u70B9\u7684\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u90A3\u597D\uFF0C\u4F60\u5148\u5230\u66F4\u8863\u5BA4\u6362\u4E0A\u7ADE\u6280\u670D\u5427\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8FD9\u8EAB\u7ADE\u6280\u670D\u89C1\u8BC1\u4E86\\n\u4F60\u8D70\u5230\u8FD9\u4E00\u6B65\u7684\u8282\u8282\u80DC\u5229\uFF0C\\r\\n\u4F60\u7A7F\u4E0A\u5B83\u5E94\u8BE5\u4F1A\u5E95\u6C14\u5341\u8DB3\u7684\uFF01\\c\\n\u597D\u4E86\uFF0C\u9053\u9986\u8BAD\u7EC3\u5BB6\u4EEC\u6B63\u5728\u7ADE\u6280\u573A\u2026\u2026\\n\u4E0D\uFF0C\u6B63\u5728\u5B9D\u7269\u5E93\u7B49\u4F60\u5462\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u554A\uFF01\u7B49\u4E00\u4E0B\uFF01\\c\\n\u6311\u6218\u5947\u5DF4\u7EB3\u7684\u65F6\u5019\uFF0C\\n\u81F3\u5C11\u9700\u8981\uFF12\u53EA\u80FD\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u53C8\u6765\u6311\u6218\u9053\u9986\u4EFB\u52A1\u4E86\u554A\uFF01\\n\u548C\u4F60\u7684\u642D\u6863\u8054\u624B\u62FF\u4E0B\u80DC\u5229\u5427\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u7A7F\u7684\u8FD9\u5957\u7ADE\u6280\u670D\u771F\u9177\uFF01\\n\u53BB\u5427\uFF01[VAR 01C4(0001)]\u53F7\u9009\u624B\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u54CE\u5440\uFF01\u8981\u60F3\u6311\u6218\u5947\u5DF4\u7EB3\uFF0C\\n\u4F60\u5FC5\u987B\u5148\u6536\u96C6\uFF17\u4E2A\u9053\u9986\u5FBD\u7AE0\uFF01\\c\\n\u5728\u8FD9\u4E4B\u540E\uFF0C\u80FD\u4E0D\u80FD\u548C\u5947\u5DF4\u7EB3\u5BF9\u6218\uFF0C\\n\u8FD8\u8981\u770B\u4ED6\u662F\u5426\u8BA4\u53EF\u4F60\u8FD9\u4E2A\u5BF9\u624B\uFF01"
  }
]
