[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4F60\u4EEC\u51E0\u4E2A\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5F7C\u7279\uFF01\uFF1F\\n\u6781\u5DE8\u5316\u7684\u5B9D\u53EF\u68A6\u5462\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u662F\u62C5\u5FC3\u6211\u641E\u4E0D\u5B9A\u5417\uFF1F\\c\\n\u522B\u5FD8\u4E86\uFF0C\u6211\u4E0D\u4F46\u662F\u4E2A\u7CBE\u82F1\uFF0C\\n\u8FD8\u662F\u5996\u7CBE\u5C5E\u6027\u7684\u9053\u9986\u9986\u4E3B\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5BF9\u54E6\uFF0C\u6211\u5DEE\u70B9\u5FD8\u4E86\u4F60\u662F\u9053\u9986\u9986\u4E3B\uFF01\\n\u2026\u2026\u4E0D\u8FC7\u662F\u4E0D\u662F\u7CBE\u82F1\u6211\u5C31\u4E0D\u77E5\u9053\u4E86\u3002[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u83AB\u975E\uFF0C\u6211\u662F\u8BF4\u83AB\u975E\u54E6\uFF01\\n\u4F60\u4EEC\u662F\u8DD1\u6765\u5E2E\u6211\u7684\uFF1F\\c\\n\u4F60\u4EEC\u660E\u77E5\u6211\u8FD9\u4E2A\u7CBE\u82F1\\n\u4E0D\u9700\u8981\u4EFB\u4F55\u5E2E\u52A9\uFF0C\u5374\u8FD8\u662F\u6765\u4E86\uFF1F[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u771F\u662F\u4E00\u70B9\u6CA1\u53D8\u2026\u2026\\n\u6211\u4EEC\u662F\u62C5\u5FC3\u4F60\u624D\u6765\u7684\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u771F\u662F\u4E2A\u9EBB\u70E6\u7684\u9053\u9986\u9986\u4E3B\u3002\\c\\n\u770B\u6765\u4E0B\u4E00\u5C4A\u7684\u9053\u9986\u6311\u6218\\n\u53C8\u6709\u5F97\u6298\u817E\u4EBA\u4E86\u2026\u2026[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u4EE5\u524D\u786E\u5B9E\u88AB\u5965\u5229\u8587\u79D8\u4E66\\n\u73A9\u5F04\u4E8E\u80A1\u638C\u4E4B\u95F4\u2026\u2026\\c\\n\u4F46\u662F\u73B0\u5728\uFF0C\u6211\u8981\u8D70\u81EA\u5DF1\u7684\u8DEF\u4E86\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F5C\u4E3A\u6211\u8FC8\u51FA\u7684\u7B2C\u4E00\u6B65\u2026\u2026\\n[VAR 0100(0000)]\uFF01\u4F60\u8981\u548C\u6211\u6765\u573A\u5BF9\u6218\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u8BF4\u2026\u2026\\n\u73B0\u5728\u4E0D\u662F\u8BF4\u8FD9\u4E2A\u7684\u65F6\u5019\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7B54\u5BF9\u4E86\u6240\u6709\u8C1C\u9898\u7684\u5C0F\u5B50\uFF0C\\n\u4F60\u4E0D\u8981\u592A\u6027\u6025\u5440\u3002[VAR 0114(0013)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5F7C\u7279\u4ED6\u4E00\u4E2A\u4EBA\u5C31\u5236\u670D\u4E86\\n\uFF13\u53EA\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u8FD9\u5C31\u7B49\u4E8E\u8BF4\uFF0C\\n\u4ED6\u5DF2\u7ECF\u4E3A\u4F60\u4EEC\u4E89\u53D6\u4E86\u65F6\u95F4\u3002[VAR 0114(0013)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u672C\u6765\u561B\uFF0C\u5F7C\u7279\u8981\u8D70\u4EC0\u4E48\u8DEF\uFF0C\\n\u65C1\u4EBA\u662F\u6CA1\u4EC0\u4E48\u597D\u63D2\u5634\u7684\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u6211\u4E5F\u786E\u5B9E\u8BA9\u4ED6\u7684\u4EBA\u751F\\n\u8F6C\u4E86\u4E00\u4E2A\u5927\u5F2F\u5C31\u662F\u4E86\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u2026\u2026\u8BF4\u6765\u4E5F\u662F\u554A\u3002[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u522B\u4E89\u4E86\u522B\u4E89\u4E86\uFF01\u5230\u5E95\u662F\uFF18\uFF18\u5C81\u7684\u957F\u8005\uFF0C\\n\u59DC\u8FD8\u662F\u8001\u7684\u8FA3\u554A\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8FD9\u548C\u6CE2\u666E\u83C8\u65E0\u5173\uFF01\\n\u662F\u6211\u81EA\u5DF1\u60F3\u6E05\u695A\u7684\uFF0C\u8981\u4E3A\u81EA\u5DF1\u800C\u6218\uFF01\uFF01\\c\\n\u6765\u5427\uFF01\u4F60\u53EA\u6709\u4E00\u4E2A\u9009\u62E9\uFF01\\n\u90A3\u5C31\u662F\u2026\u2026\u548C\u6211\u5BF9\u6218\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6765\u5BF9\u6218\u5427"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u4E86\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u90A3\u5C31\u8BA9\u4F60\u7A0D\u5FAE\u89C1\u8BC6\u4E00\u4E0B\u2026\u2026\\n\u8131\u80CE\u6362\u9AA8\u7684\u6211\u548C\u5B9D\u53EF\u68A6\\r\\n\u7CBE\u5F69\u7EDD\u4F26\u7684\u8868\u73B0\u5427\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u591A\u8C22\u6307\u6559\u3002\\c\\n\u6211\u7EC8\u4E8E\u53EF\u4EE5\u627F\u8BA4\\n\u4F60\u914D\u5F97\u4E0A\u51A0\u519B\u8FD9\u4E2A\u79F0\u53F7\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u867D\u7136\u8F93\u6389\u5BF9\u6218\u8BA9\u6211\u5F88\u4E0D\u7518\u5FC3\uFF0C\\n\u4F46\u6211\u77E5\u9053\u81EA\u5DF1\u7684\u4E0D\u8DB3\u4E4B\u5904\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u4F1A\u6311\u6218\u5996\u7CBE\u5C5E\u6027\u7684\u6781\u9650\uFF0C\\n\u8BA9\u81EA\u5DF1\u53D8\u5F97\u66F4\u5F3A\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u8EAB\u4E3A\u9053\u9986\u9986\u4E3B\uFF0C\\n\u6211\u8981\u6E05\u626B\u9053\u9986\u7ADE\u6280\u573A\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u521A\u624D\u90A3\u573A\u5BF9\u6218\u2026\u2026\\n\u771F\u662F\u628A\u7C89\u7EA2\u8272\u4F53\u73B0\u5F97\u6DCB\u6F13\u5C3D\u81F4\u5462\uFF01[VAR 0114(0013)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u90A3\u5C0F\u5B50\u5C31\u7B97\u5931\u53BB\u4E86\\n\u9053\u9986\u6311\u6218\u7684\u8D44\u683C\u2026\u2026\\c\\n\u8FD8\u662F\u4F1A\u505A\u51FA\u5230\u51B3\u8D5B\u6405\u5C40\u7684\u4E8B\uFF0C\\n\u4ED6\u786E\u5B9E\u662F\u4E2A\u6253\u4E0D\u5012\u7684\u5BB6\u4F19\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u597D\u50CF\u4E5F\u660E\u767D\u4ED6\u4E3A\u4EC0\u4E48\\n\u6709\u8D44\u683C\u5F53\u9053\u9986\u9986\u4E3B\u4E86\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5F7C\u7279\u8FD9\u5C0F\u5B50\u2026\u2026\u867D\u7136\u6211\u5F88\u70E6\u4ED6\uFF0C\\n\u4F46\u4ED6\u786E\u5B9E\u662F\u4E2A\u5389\u5BB3\u7684\u8BAD\u7EC3\u5BB6\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u56E0\u4E3A\u4ED6\u5F88\u8BA4\u771F\u554A"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u4ED6\u5C31\u662F\u5389\u5BB3\u554A"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u662F\u554A\uFF0C\u4ECE\u4ED6\u5728\u5BF9\u6218\u4E2D\u7684\u8868\u73B0\\n\u5C31\u80FD\u611F\u89C9\u5230\u4ED6\u4E00\u76F4\u5F88\u52AA\u529B\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u8FDE\u4F60\u8FD9\u4E2A\u51A0\u519B\u90FD\\n\u627F\u8BA4\u4ED6\u5F88\u5389\u5BB3\u554A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4E24\u4E2A\u804A\u6210\u8FD9\u6837\u2026\u2026\\n\u662F\u8981\u8BA9\u6211\u7ED9\u4F60\u4EEC\u4E0A\u7EA2\u8336\u5417\uFF1F[VAR 0114(0016)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u53EF\u4E0D\u80FD\u843D\u540E\uFF01\\n\u5FEB\u5230\u4E0B\u4E00\u4E2A\u5730\u65B9\u53BB\u5427\uFF01[VAR 0114(0005)]"
