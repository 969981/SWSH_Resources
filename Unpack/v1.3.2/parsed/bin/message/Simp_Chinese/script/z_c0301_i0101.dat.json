[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6B22\u8FCE\u5149\u4E34\u4F26\u5EA6\u7F57\u745F\u3002\\c\\n\u6211\u4EEC\u662F\u4E00\u5BB6\u4E94\u661F\u7EA7\u9152\u5E97\uFF0C\\n\u5728\u5168\u4E16\u754C\u90FD\u5E7F\u53D7\u9752\u7750\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u53EF\u662F\u4E13\u4E1A\u524D\u53F0\uFF01\\n\u8BED\u8A00\u4E0D\u901A\u7684\u5B9D\u53EF\u68A6\u4EEC\u7684\u9700\u6C42\uFF0C\\r\\n\u6211\u90FD\u80FD\u591F\u53D7\u7406\u54E6\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u2026\u2026\u867D\u7136\u817F\u5DF2\u7ECF\u9178\u4E86\uFF0C\\n\u4F46\u8981\u4FDD\u8BC1\u5168\u7A0B\u5FAE\u7B11\u670D\u52A1\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u6B21\u4E0D\u5750\u79C1\u5BB6\u98DE\u673A\uFF0C\\n\u800C\u662F\u9A91\u52C7\u58EB\u96C4\u9E70\u6765\u4F3D\u52D2\u5C14\uFF0C\\r\\n\u8BF4\u5B9E\u8BDD\u771F\u591F\u7D2F\u7684\u2026\u2026\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u59BB\u5B50\u867D\u7136\u5634\u4E0A\u4E0D\u505C\u62B1\u6028\uFF0C\\n\u4F46\u5176\u5B9E\u8FD8\u662F\u559C\u6B22\u4E0E\u5B9D\u53EF\u68A6\u540C\u884C\u7684\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u662F\u5E94\u9A6C\u6D1B\u79D1\u8499\u9080\u8BF7\\n\u524D\u6765\u89C2\u770B\u6BD4\u8D5B\u7684\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FDE\u540D\u6D41\u90FD\u5728\u5173\u6CE8\u7684\u6BD4\u8D5B\uFF0C\\n\u65E0\u7591\u4F1A\u540A\u8D77\u516C\u4F17\u80C3\u53E3\u7684\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u95E8\u7AE5\u5E76\u4E0D\u662F\u8F7B\u677E\u7684\u6D3B\u513F\uFF01\\c\\n\u6709\u518D\u591A\u7684\u4EBA\u8FDB\u8FDB\u51FA\u51FA\uFF0C\\n\u4E5F\u4E0D\u80FD\u51FA\u534A\u70B9\u5C94\u5B50\uFF01\\r\\n\u8FD8\u6709\u5B9D\u53EF\u68A6\u5728\u4E3A\u8FD9\u4EFD\u5DE5\u4F5C\u52A9\u529B\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7FFB\uFF5E\u8FCE\uFF5E"
  }
]
