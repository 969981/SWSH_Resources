  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u73B0\u5728\uFF0C\u5976\u5976\u4E5F\u5BF9\u6211\u53E6\u773C\u76F8\u770B\u4E86\uFF01\\n\u6211\u5199\u7684\u4E66\u4E5F\u51FA\u7248\u4E86\uFF01\\c\\n\u6211\u7D22\u59AE\u4E9A\u535A\u58EB\u4F1A\u518D\u63A5\u518D\u5389\u7684\uFF0C\\n\u4F60\u4EEC\u5C3D\u7BA1\u671F\u5F85\u5427\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\\n\u7D22\u59AE\u4E9A\u548C[VAR 0100(0000)]\u90FD\u597D\u5389\u5BB3\u554A\uFF01\\r\\n\u6211\u771F\u4F69\u670D\u4F60\u4EEC\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 31,
