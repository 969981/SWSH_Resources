    "text": "\u2026\u2026\u8BDD\u8BF4\uFF0C\\n\u4F60\u4EEC\u5230\u5E95\u5728\u8FD9\u91CC\u505A\u4EC0\u4E48\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u54CE\uFF1F\u8FD9\u4E2A\u561B\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u2026\u2026\u554A\uFF0C\u6211\u77E5\u9053\u4E86\uFF01\\c\\n\u4F60\u4EEC\u662F\u6765\u5F52\u8FD8\u8150\u673D\u7684\u5251\u548C\u76FE\u7684\u5427\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 34,
