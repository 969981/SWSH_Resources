  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u6211\u4EEC\u5FEB\u53BB\u8C22\u8C22\u5B83\u4EEC\u76F8\u52A9\uFF0C\\n\u7136\u540E\u628A\u5251\u548C\u76FE\u653E\u56DE\u539F\u5904\u5427\uFF01\\c\\n\u800C\u4E14\u6211\u6709\u9884\u611F\uFF0C\u8BF4\u4E0D\u5B9A\u8FD8\u80FD\u89C1\u5230\\n\u82CD\u54CD\u548C\u85CF\u739B\u7136\u7279\u5462\uFF01[VAR 0114(0005)]"
