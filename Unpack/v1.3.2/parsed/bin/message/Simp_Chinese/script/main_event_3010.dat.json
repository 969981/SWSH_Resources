  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u6211\u5DF2\u7ECF\u6709\u4E00\u672C\u4E86\u54E6\uFF01\\n\u8FD8\u662F\u53D1\u552E\u65E5\u5F53\u5929\u6392\u961F\u4E70\u7684\u5462\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 28,
