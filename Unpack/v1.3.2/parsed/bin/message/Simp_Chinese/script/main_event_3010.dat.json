    "text": "\u6211\u662F\u771F\uFF5E\u7684\u5F88\u611F\u8C22\u4F60\u4EEC\u3002[VAR 0114(000B)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u591A\u4E8F\u4E86\u548C\u4F60\u4EEC\u4E00\u8D77\u5230\u5904\u5192\u9669\uFF0C\\n\u6211\u624D\u4F1A\u5E0C\u671B\u81EA\u5DF1\u66F4\u6DF1\u5165\u5730\\r\\n\u4E86\u89E3\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u5386\u53F2\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 22,
