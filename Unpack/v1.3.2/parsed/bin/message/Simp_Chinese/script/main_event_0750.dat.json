    "text": "\u65E9\u554A\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u7684\u670B\u53CB\u5DF2\u7ECF\u53BB\u53C2\u52A0\u9053\u9986\u6311\u6218\u4E86\u54E6\u3002\\c\\n\u4ED6\u8BF4\u4ED6\u4ED4\u7EC6\u7814\u7A76\u4E86\u5361\u829C\u7684\u8054\u76DF\u5361\uFF0C\\n\u505A\u597D\u4E86\u5145\u8DB3\u7684\u5BF9\u7B56\u3002\\c\\n\u4ED6\u8FD8\u7ED9\u4E86\u6211\u597D\u51E0\u5F20\u5361\u829C\u7684\u8054\u76DF\u5361\uFF0C\\n\u4E5F\u5206\u4E00\u5F20\u7ED9\u4F60\u5427\u3002[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u4F60\u966A\u6211\u4E00\u4E0B\u5427\u3002\\c\\n\u6211\u6B63\u597D\u60F3\u6D4B\u8BD5\u4E00\u4E0B\u81EA\u5DF1\u7684\u5B9E\u529B\\n\u80FD\u4E0D\u80FD\u8D62\u4E0B\u9053\u9986\u6311\u6218\u5462\u3002[VAR 0114(000D)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64\u2026\u2026\\n\u770B\u6765\u83AB\u9C81\u8D1D\u53EF\u5B83\u4EEC\u8FD8\u9700\u8981\u953B\u70BC\u4E00\u4E0B\u5450\u3002\\c\\n\u8C22\u54AF\uFF01\u4E5F\u6CA1\u4EC0\u4E48\u4E1C\u897F\u597D\u8C22\u4F60\uFF0C\\n\u5C31\u8BA9\u6211\u5E2E\u4F60\u7684\u5B9D\u53EF\u68A6\u6062\u590D\u6D3B\u529B\u5427\u3002[VAR 0114(000D)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u53E6\u5916\uFF0C\u8FD8\u6709\u8FD9\u4E2A\u2026\u2026\\n\u5C31\u5F53\u662F\u6628\u5929\u4F60\u966A\u6211\u5BF9\u6218\u7684\u8C22\u793C\u5427\u3002[VAR 0114(000D)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u867D\u7136\u5361\u829C\u5F88\u70ED\u8840\uFF0C\\n\u4F46\u4EE5\u4F60\u7684\u5B9E\u529B\u5E94\u8BE5\u80FD\u6253\u8D62\u4ED6\u5427\uFF1F\\c\\n\u522B\u78E8\u8E6D\u4E86\uFF0C\u5FEB\u53BB\u673A\u64CE\u7ADE\u6280\u573A\\n\u62FF\u4E0B\u9053\u9986\u5FBD\u7AE0\u5427\u3002[VAR 0114(000D)]"
  },
