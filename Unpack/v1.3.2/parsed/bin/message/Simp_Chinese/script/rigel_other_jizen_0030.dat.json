[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5446\uFF5E\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u662F\u4E2A\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u5427\uFF1F"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8981\u662F\u8FD9\u53EA\u5446\u5446\u517D\u4E00\u76F4\\n\u5835\u5728\u68C0\u7968\u53E3\u4E0D\u79BB\u5F00\u7684\u8BDD\uFF0C\\r\\n\u4F1A\u4E3A\u5176\u4ED6\u4E58\u5BA2\u5E26\u6765\u4E0D\u4FBF\u7684\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5B83\u592A\u91CD\u4E86\uFF0C\u5B9E\u5728\u662F\u4E0D\u597D\u79FB\u5F00\u2026\u2026\\n\u4F60\u80FD\u5E2E\u5FD9\u6349\u4F4F\u5B83\u5417\uFF1F"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5446\uFF5E"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E3A\u4E86\u6349\u4F4F\u5446\u5446\u517D\uFF0C\\n\u8981\u53D1\u8D77\u5BF9\u6218\u5417\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5446\u5446\uFF01\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[~ 7]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u554A\uFF5E\uFF01\\n\u5446\u5446\u517D\u8FD8\u8981\u7EE7\u7EED\u5F85\u5728\u8FD9\u91CC\u554A\uFF01\uFF1F"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u770B\u6765\u6253\u8D25\u5B83\u6CA1\u6709\u7528\uFF0C\\n\u53EA\u6709\u6349\u4F4F\u5B83\u624D\u80FD\u8BA9\u5B83\u79BB\u5F00\u554A\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u54E6\uFF1F\\n\u9003\u8DD1\u4E86\u53EF\u5C31\u6CA1\u6CD5\u6349\u4F4F\u5B83\u4E86\u54E6\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u60F3\u8981\u6349\u4F4F\u5B9D\u53EF\u68A6\uFF0C\\n\u9700\u8981\u5148\u8BA9\u5B83\u53D8\u5F31\uFF0C\\r\\n\u7136\u540E\u518D\u6295\u51FA\u7CBE\u7075\u7403\u54E6\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5446\u2026\u2026\uFF01\uFF1F"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8C22\u8C22\uFF01\u591A\u4E8F\u4E86\u4F60\uFF0C\\n\u624D\u80FD\u817E\u51FA\u8FD9\u4E48\u5BBD\u655E\u7684\u5730\u65B9\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5440\uFF5E\u4F60\u771F\u5389\u5BB3\u8036\uFF5E\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u56AF\u2026\u2026\u771F\u662F\u6709\u610F\u601D\u3002[VAR 0114(0042)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u6349\u5446\u5446\u517D\u7684\u65B9\u5F0F\\n\u771F\u662F\u5E05\u5F97\u6CA1\u8BDD\u8BF4\u4E86\u5462\uFF5E[VAR 0114(0042)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4F60\u7684\u6355\u6349\u65B9\u5F0F\u975E\u5E38\u4F18\u96C5\u3002[VAR 0114(0042)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u8FD9\u4F4D\u4E58\u5BA2\uFF0C\u62B1\u6B49\u8BA9\u60A8\u4E45\u7B49\u4E86\u3002\\n\u8FD9\u662F\u60A8\u7684\u94E0\u7532\u8F66\u7968\\r\\n\u6211\u5DF2\u7ECF\u786E\u8BA4\u8FC7\u4E86\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u73B0\u5728\u60A8\u53EF\u4EE5\u4E58\u5750\\n\u5F00\u5F80\u94E0\u5C9B\u7684\u5217\u8F66\u4E86\u3002\\c\\n\u4E2D\u95F4\u9700\u8981\u6362\u4E58\uFF0C\\n\u8BF7\u60A8\u591A\u591A\u6CE8\u610F\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u597D\u7684\uFF5E[VAR 0114(0042)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u77E5\u9053\u4E86\u3002[VAR 0114(0042)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6211\u63A5\u4E0B\u6765\u8981\u53BB\\n\u4E00\u4E2A\u53EB\u505A\u94E0\u5C9B\u7684\u5730\u65B9\u2026\u2026\\c\\n\u6349\u6349\u7F55\u89C1\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u8FD8\u8981\u4FEE\u884C\u4E00\u4E0B\u54E6\u3002[VAR 0114(0042)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6211\u63A5\u4E0B\u6765\u8981\u53BB\\n\u4E00\u4E2A\u53EB\u94E0\u5C9B\u7684\u5730\u65B9\u2026\u2026\\c\\n\u6355\u6349\u7F55\u89C1\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5E76\u4E14\u597D\u597D\u4FEE\u884C\u4E00\u756A\u3002[VAR 0114(0042)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5E0C\u671B\u80FD\u8DDF\u4F60\u518D\u4F1A\u54E6\uFF5E\\n\u2026\u2026\u90A3\u5C31\uFF0C\u62DC\u62DC\u5566\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u5E0C\u671B\u80FD\u6709\u673A\u4F1A\u518D\u89C1\u5230\u4F60\u3002\\n\u2026\u2026\u90A3\u4E48\uFF0C\u540E\u4F1A\u6709\u671F\u3002[VAR 0114(0042)]"
  }
