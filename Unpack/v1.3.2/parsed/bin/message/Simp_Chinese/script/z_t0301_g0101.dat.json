[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5728\u9762\u5BF9\u8349\u5C5E\u6027\u7684\u65F6\u5019\uFF0C\\n\u7528\u706B\u5C5E\u6027\u6BD4\u8F83\u6709\u5229\u2026\u2026\u8FD9\u662F\u57FA\u672C\u5E38\u8BC6\u5427\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5C45\u7136\u62FF\u5230\u4E86\u8349\u4E4B\u5FBD\u7AE0\uFF0C\\n\u4F60\u53EF\u771F\u5389\u5BB3\uFF01\\c\\n\u5E0C\u671B\u4F60\u80FD\u7EE7\u7EED\u4FDD\u6301\u8FD9\u4E2A\u52BF\u5934\uFF0C\\n\u987A\u5229\u62FF\u5230\u6C34\u4E4B\u5FBD\u7AE0\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u8BB0\u5F97\u5FC5\u987B\u5B8C\u6210\u6240\u6709\u7684\u9053\u9986\u4EFB\u52A1\uFF0C\\n\u624D\u53EF\u4EE5\u548C\u9053\u9986\u9986\u4E3B\u4E00\u51B3\u9AD8\u4E0B\u2026\u2026\\c\\n\u9053\u9986\u4EFB\u52A1\u5177\u4F53\u662F\u8981\u505A\u4E9B\u4EC0\u4E48\u5462\uFF1F\\n\u8DF3\u821E\u7684\u8BDD\u6211\u5012\u662F\u5F88\u64C5\u957F\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C45\u7136\u8FFD\u7740\u6BDB\u8FAB\u7F8A\u8DD1\u2026\u2026\\n\u6CA1\u60F3\u5230\u4E9A\u6D1B\u4E5F\u6709\u8FD9\u6837\u7231\u4F7F\u574F\u7684\u4E00\u9762\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\u554A\uFF0C\\c\\n\u5982\u679C\u4F60\u80FD\u8D62\u5F97\u8349\u4E4B\u5FBD\u7AE0\uFF0C\\n\u6211\u59D1\u4E14\u5C31\u8BB0\u4F4F\u4F60\u7684\u540D\u5B57\u5427\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u53EB[VAR 0100(0000)]\u554A\uFF01\\n\u4F60\u5B9E\u5728\u592A\u5389\u5BB3\u4E86\uFF0C\u90A3\u6211\u5C31\u505A\u4F60\u7684\u7C89\u4E1D\u5427\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5657\u53FD\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u90A3\u5B69\u5B50\u4E5F\u662F\u6765\u53C2\u52A0\\n\u9053\u9986\u6311\u6218\u7684\u5417\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u6218\u80DC\u4E86\u4E9A\u6D1B\u5440\uFF0C\\n\u771F\u662F\u573A\u7CBE\u5F69\u7684\u6BD4\u8D5B\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u51A0\u519B\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u542C\u8BF4\u90A3\u4E2A\u8BAD\u7EC3\u5BB6\uFF0C\\n\u662F\u4E39\u5E1D\u63A8\u8350\u6765\u7684\u4EBA\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u55EF\uFF0C\u8868\u73B0\u5F97\u52C9\u52C9\u5F3A\u5F3A\u5427\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u5728\u7535\u89C6\u4E0A\u770B\u4E86\u54E6\u266A"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u542C\u8BF4\u90A3\u4E2A\u8BAD\u7EC3\u5BB6\uFF0C\\n\u597D\u50CF\u662F\u8D6B\u666E\u7684\u52B2\u654C\u5462\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8BF4\u4E0D\u5B9A\u2026\u2026\\n\u90A3\u4E2A\u4EBA\u4F1A\u662F\u4E00\u5339\u9ED1\u9A6C\u3002"
  }
]
