    "text": "\u7EC8\u4E8E\u8981\u5F00\u59CB\u4E86\u3002\\n\u4F60\u7761\u597D\u89C9\u4E86\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u660E\u660E\u662F\u4F60\u53BB\u6BD4\u8D5B\uFF0C\\n\u600E\u4E48\u8FDE\u6211\u90FD\u7D27\u5F20\u8D77\u6765\u4E86\u5462\u2026\u2026[VAR 0114(0005)]"
  },
  {
