    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u4F60\u597D\u3002\\c\\n\u51B3\u8D5B\u5C31\u8981\u5F00\u59CB\u4E86\u3002\\n\u8BF7\u8DDF\u6211\u524D\u5F80\u7ADE\u6280\u573A\u5427\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5582\uFF01\\n\u4F60\u8FD9\u4E48\u5FEB\u5C31\u5FD8\u8BB0\u6628\u5929\u7684\u4E8B\u4E86\u5417\uFF1F\\c\\n\u5C0F\u5FC3\u8D6B\u666E\u6211\u548C\u6211\u7684\u642D\u6863[VAR 0101(0001)]\\n\u8BA9\u4F60\u5403\u4E0D\u4E86\u515C\u7740\u8D70\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B\uFF01\\c\\n\u867D\u7136\u8FD9\u6837\u8BF4\u6709\u70B9\u81EA\u5439\u81EA\u64C2\u2026\u2026\\n\u6211\u53EF\u662F\u4E2A\u5584\u826F\u6B63\u76F4\u7684\u597D\u804C\u5458\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6628\u5929\u7684\u4E8B\u60C5\u6211\u90FD\u542C\u8BF4\u4E86\u3002\\c\\n\u5965\u5229\u8587\u79D8\u4E66\u6709\u4E2A\u7F3A\u70B9\uFF0C\\n\u90A3\u5C31\u662F\u53EA\u8981\u662F\u4E3A\u4E86\u4F1A\u957F\u597D\uFF0C\\r\\n\u5979\u4EC0\u4E48\u4E8B\u60C5\u90FD\u5E72\u5F97\u51FA\u6765\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u542C\u8BF4\u5979\u624B\u4E0B\u8FD8\u85CF\u7740\u4E00\u6279\\n\u5BF9\u5979\u552F\u547D\u662F\u4ECE\u7684\u8054\u76DF\u804C\u5458\u2026\u2026"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F46\u662F\uFF0C\u4ECA\u5929\u4F60\u5C3D\u7BA1\u653E\u5FC3\u597D\u4E86\uFF01\\n\u5728\u573A\u7684\u90FD\u662F\u53EF\u4EE5\u4FE1\u4EFB\u7684\u8054\u76DF\u804C\u5458\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u90A3\u6211\u4EEC\u5C31\u653E\u5FC3\u5427\uFF01\\c\\n\u4E0A\u554A\uFF01[VAR 0100(0000)]\uFF01\\n\u6211\u90FD\u7B49\u4E0D\u53CA\u8981\u770B\u4F60\u7684\u6BD4\u8D5B\u5566\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9700\u8981\u6211\u5E26\u4F60\u524D\u5F80\u5BAB\u95E8\u7ADE\u6280\u573A\u5417\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u597D\uFF0C\u6211\u4EEC\u8D70\u5427\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u597D\u5427\u3002\\c\\n\u4F60\u8FD8\u53EF\u4EE5\u4E58\u5750\u9152\u5E97\u95E8\u524D\u7684\\n\u98DE\u7FD4\u51FA\u79DF\u8F66\u524D\u5F80\u7ADE\u6280\u573A\u3002\\r\\n\u5F53\u7136\u4E5F\u53EF\u4EE5\u518D\u6765\u627E\u6211\u3002\u8BF7\u968F\u610F\u3002"
  }
