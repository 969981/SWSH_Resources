[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6765\u7535\u6C6A\uFF0C\u8C22\u8C22\u4F60\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u80D6\u6C6A\u6C6A\u6C6A\u6C6A\u6C6A\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u53EB\u4F60\u8FC7\u6765\u627E\u6211\uFF0C\\n\u5C31\u662F\u60F3\u542C\u542C\u4F60\u7684\u770B\u6CD5\u3002[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90A3\u5E45\u5DE8\u5927\u7684\u5730\u753B\u2026\u2026\\n\u4F60\u89C9\u5F97\u5230\u5E95\u662F\u4EC0\u4E48\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u95C7\u591C\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6781\u5DE8\u5316\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5389\u5BB3\uFF01\\n\u771F\u662F\u597D\u773C\u529B\uFF01\\c\\n\u9ED1\u8272\u65CB\u6DA1\u7684\u7EBF\u6761\u5DF2\u7ECF\u6240\u5269\u65E0\u51E0\u4E86\uFF0C\\n\u4F60\u5C45\u7136\u8FD8\u80FD\u770B\u5F97\u51FA\u6765\u3002[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u786E\u5B9E\uFF0C\u90A3\u770B\u8D77\u6765\\n\u4E5F\u50CF\u662F\u53D8\u5927\u7684\u5B9D\u53EF\u68A6\u3002\\c\\n\u4F46\u662F\uFF0C\u5C31\u7B97\uFF13\uFF10\uFF10\uFF10\u5E74\u524D\u7684\u4EBA\\n\u60F3\u8C61\u529B\u518D\u600E\u4E48\u4E30\u5BCC\uFF0C\\r\\n\u4E5F\u5F88\u96BE\u51ED\u7A7A\u753B\u51FA\u6781\u5DE8\u5316\u5B9D\u53EF\u68A6\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5F88\u4E45\u4EE5\u524D\u2026\u2026\\n\u9ED1\u8272\u7684\u65CB\u6DA1\u7B3C\u7F69\u4E86\u4F3D\u52D2\u5C14\u5730\u533A\uFF0C\\r\\n\u5DE8\u5927\u7684\u5B9D\u53EF\u68A6\u5728\u5404\u5730\u5927\u95F9\u2026\u2026\\c\\n\u88AB\u79F0\u4E3A\u95C7\u591C\u7684\u9ED1\u8272\u65CB\u6DA1\u7A76\u7ADF\u662F\u4EC0\u4E48\uFF1F\\n\u5B83\u548C\u6781\u5DE8\u5316\u53C8\u6709\u4EC0\u4E48\u6837\u7684\u5173\u7CFB\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD9\u4E9B\u90FD\u9700\u8981\u6211\u53BB\u8C03\u67E5\u6E05\u695A\u2026\u2026\\n\u5976\u5976\u7ED9\u6211\u7684\u4EFB\u52A1\u597D\u8270\u5DE8\u554A\u3002[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u611F\u8C22\u4F60\u7684\u5B9D\u8D35\u610F\u89C1\uFF01\\n\u8FD9\u5F20\u8054\u76DF\u5361\u5C31\u9001\u7ED9\u4F60\u5F53\u8C22\u793C\u5427\u3002[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4E9A\u6D1B\u53EF\u662F\u4E2A\u8349\u5C5E\u6027\u7684\u9053\u9986\u9986\u4E3B\u54E6\u3002\\c\\n\u6240\u4EE5\u4F7F\u7528\u706B\u5C5E\u6027\u3001\u866B\u5C5E\u6027\\n\u6216\u8005\u98DE\u884C\u5C5E\u6027\u7684\u62DB\u5F0F\u90FD\u4F1A\u6709\u6548\u54E6\uFF01\\c\\n\u53E6\u5916\uFF0C\u8FD9\u4E2A\u4E5F\u7ED9\u4F60\u4E86\uFF01\\n\u5B9D\u53EF\u68A6\u53EF\u4E0D\u80FD\u6CA1\u6709\u6D3B\u529B\u554A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u5FEB\u53BB\u8349\u8DEF\u7ADE\u6280\u573A\u5C3D\u60C5\u5730\u5BF9\u6218\u5427\uFF01[VAR 0114(000B)]"
  }
]
