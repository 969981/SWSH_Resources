  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u4E3B\u610F\uFF01\\n\u90A3\u6211\u4EEC\u5C31\u5FEB\u628A\u5927\u54E5\u627E\u56DE\u6765\u5427\uFF01\\c\\n\u8981\u4E0D\u7136\u4F60\u5C31\u4E0D\u80FD\u6311\u6218\u51A0\u519B\u4E86\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FD9\u53EF\u4E0D\u662F\u4E2A\u597D\u4E3B\u610F\u3002\\c\\n\u6211\u8981\u662F\u4F60\uFF0C\u8BF4\u4EC0\u4E48\u4E5F\u4E0D\u4F1A\\n\u6789\u8D39\u5450\u558A\u961F\u7684\u4E00\u7247\u5FC3\u610F\u7684\u3002[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u65E2\u7136\u8FD9\u6761\\n\u901A\u5411\u6D1B\u5179\u5927\u53A6\u7684\u8DEF\u662F\u4F60\u5F00\u51FA\u6765\u7684\uFF0C\\r\\n\u4F60\u5C31\u7EE7\u7EED\u5411\u524D\u51B2\u523A\u5427\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8BDD\u8BF4\u56DE\u6765\uFF0C\u90A3\u4E2A\u79D8\u4E66\u53EF\u771F\u4E0D\u50CF\u8BDD\u3002\\c\\n\u5979\u5C45\u7136\u4E3A\u4E86\u53D6\u60A6\u4F1A\u957F\uFF0C\\n\u800C\u628A\u5355\u8F68\u5217\u8F66\u7684\u94A5\u5319\u85CF\u4E86\u8D77\u6765\u3002[VAR 0114(000D)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\u4E5F\u662F\u5947\u602A\uFF0C\\n\u600E\u4E48\u4E00\u76F4\u7F20\u7740\u51A0\u519B\u4E0D\u653E\uFF1F\\r\\n\u771F\u641E\u4E0D\u61C2\u4ED6\u5728\u60F3\u4EC0\u4E48\u3002[VAR 0114(000D)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  },
  {
