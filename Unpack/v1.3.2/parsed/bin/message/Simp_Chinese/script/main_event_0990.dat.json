  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u547C\u2026\u2026\\n\u8FD9\u6B21\u8F83\u91CF\u8BA9\u6211\u6709\u4E86\u65B0\u7684\u611F\u609F\u3002[VAR 0114(0011)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u81EA\u4ECE\u548C\u4F60\u4EEC\u5BF9\u5CD9\u7684\u90A3\u4E00\u523B\u8D77\uFF0C\\n\u5C31\u8BA9\u6211\u2026\u2026\\r\\n\u4E0D\u7531\u81EA\u4E3B\u5730\u5FC3\u6F6E\u6F8E\u6E43\u3002\\c\\n\u770B\u6765\u6DE1\u5B9A\u4E0E\u5426\u5E76\u4E0D\u662F\u80DC\u8D1F\u7684\u5168\u90E8\uFF0C\\n\u80FD\u5426\u4EAB\u53D7\u5176\u4E2D\uFF0C\u4E5F\u662F\u4E00\u79CD\u80DC\u8D1F\u89C2\u554A\u3002[VAR 0114(0011)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u591A\u8C22\u4F60\u7684\u6307\u6559\u3002\\n\u8BF7\u6536\u4E0B\u8FD9\u679A\u683C\u6597\u5FBD\u7AE0\u5427\u3002[VAR 0114(0011)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u53EF\u4EE5\u6355\u6349\u7B49\u7EA7\uFF14\uFF10\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u76F8\u4FE1\u4ECA\u540E\u4F60\u4EEC\u8FD8\u4F1A\u9047\u5230\u5404\u79CD\u5BF9\u624B\uFF0C\\n\u9762\u5BF9\u66F4\u591A\u5BF9\u6218\u3002\\c\\n\u5E0C\u671B\u8FD9\u4E9B\u7ECF\u5386\u90FD\u80FD\u6210\u4E3A\\n\u4F60\u4EEC\u5B9D\u8D35\u7684\u7CBE\u795E\u98DF\u7CAE\u3002[VAR 0114(0011)]"
