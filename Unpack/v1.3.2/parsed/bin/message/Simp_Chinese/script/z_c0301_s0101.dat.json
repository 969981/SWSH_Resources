    "index": 0,
    "flags": 0,
    "text": "\u6BD5\u7ADF\u5BAB\u95E8\u5E02\u592A\u5927\u5566\uFF0C\\n\u5750\u5355\u8F68\u5217\u8F66\u6216\u8005\u98DE\u7FD4\u51FA\u79DF\u8F66\u5427\uFF0C\\r\\n\u8FD9\u6837\u6BD4\u8F83\u65B9\u4FBF\u54E6\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "[~ 1]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "[~ 2]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5BAB\u95E8\u5E02\u6709\u6765\u81EA\u56DB\u9762\u516B\u65B9\u7684\u6E38\u5BA2\uFF0C\\n\u6240\u4EE5\u6599\u7406\u7684\u53E3\u5473\u4E5F\u4F1A\u914D\u5408\u505A\u4E9B\u8C03\u6574\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u56E0\u4E3A\u89C2\u4F17\u770B\u6BD4\u8D5B\u4E00\u5B9A\u4F1A\u975E\u5E38\u5165\u8FF7\uFF0C\\n\u5728\u7ADE\u6280\u573A\u8FDE\u996D\u4E5F\u987E\u4E0D\u4E0A\u5403\u5566\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u60F3\u597D\u597D\u773A\u671B\u4E00\u4E0B\u6574\u4E2A\u4F3D\u52D2\u5C14\u5730\u533A\uFF01\\n\u5750\u6469\u5929\u8F6E\u4E0D\u6B63\u662F\u4E0D\u4E8C\u4E4B\u9009\u5417\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6469\u5929\u8F6E\u554A\u2026\u2026\\n\u6211\u6709\u6050\u9AD8\u75C7\u554A\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64\u554A\uFF0C\u4E0D\u5750\u5355\u8F68\u5217\u8F66\u7684\u8BDD\uFF0C\\n\u5C31\u6CA1\u529E\u6CD5\u5230\u6D1B\u5179\u5927\u53A6\u53BB\u4E86\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u56E0\u4E3A\u6709\u4E9B\u5B9D\u53EF\u68A6\u559C\u6B22\u5F85\u5728\u8F68\u9053\u4E0A\uFF0C\\n\u6240\u4EE5\u4E5F\u4F1A\u53D1\u751F\u4E00\u4E9B\u6709\u8DA3\u7684\u9EBB\u70E6\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD9\u91CC\u5C31\u662F\u5BAB\u95E8\u5E02\u7684\\n\u6807\u5FD7\u6027\u5EFA\u7B51\uFF0C\u5355\u8F68\u5217\u8F66\u7AD9\uFF01\\c\\n\u8FD9\u6761\u5355\u8F68\u662F\u7ED5\u7740\u6574\u4E2A\u5BAB\u95E8\u5E02\\n\u4E00\u5708\u4E00\u5708\u8FD0\u884C\u7684\u73AF\u7EBF\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u54D4\u5440\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u7684\u5B9D\u53EF\u68A6\u4EEC\\n\u90FD\u53EF\u559C\u6B22\u97F3\u4E50\u5566\uFF01\\c\\n\u4E00\u542C\u5230\u60A6\u8033\u7684\u65CB\u5F8B\uFF0C\\n\u5C31\u4F1A\u5174\u594B\u5F97\u4E00\u6E9C\u70DF\u8DD1\u51FA\u53BB\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u53FD\u53FD\uFF5E\uFF01"
  },
  {
    "index": 13,
