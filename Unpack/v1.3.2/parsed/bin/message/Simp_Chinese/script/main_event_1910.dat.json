[
  {
    "index": 0,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u4F60\u679C\u7136\u5389\u5BB3\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u771F\u4E0D\u6127\u662F\u65E0\u654C\u51A0\u519B\u770B\u4E2D\u7684\\n\u9053\u9986\u6311\u6218\u8005\uFF01\\c\\n\u4E5F\u96BE\u602A\u5728\u6211\u6DF1\u7231\u7684\u4F3D\u52D2\u5C14\u5730\u533A\\n\u65E0\u4EBA\u4E0D\u4EE5\u51A0\u519B\u4E3A\u50B2\u554A\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u54CE\u5440\uFF01\u5176\u5B9E\u6211\u4E5F\u5F88\u60F3\u4E00\u7779\\n\u4F60\u4EEC\u5728\u51A0\u519B\u8D5B\u4E0A\u7684\u5DC5\u5CF0\u5BF9\u51B3\uFF01\\c\\n\u4F46\u662F\u5F88\u62B1\u6B49\uFF0C\u6211\u8BA9\u4F60\u4EEC\u6311\u6218\u8005\\n\u4E00\u8DEF\u4E0B\u6765\u7684\u52AA\u529B\u5168\u90FD\u767D\u8D39\u4E86\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F46\u662F\u6CA1\u529E\u6CD5\u554A\u2026\u2026\\c\\n\u4E3A\u4E86\u89E3\u51B3\u80FD\u6E90\u4E0D\u8DB3\\n\u8FD9\u4E2A\u523B\u4E0D\u5BB9\u7F13\u7684\u95EE\u9898\uFF0C\\r\\n\u6211\u5FC5\u987B\u5524\u9192\u65E0\u6781\u6C70\u90A3\u3002\\r\\n\u53EA\u662F\uFF0C\u6CA1\u60F3\u5230\u6211\u6839\u672C\u63A7\u5236\u4E0D\u4F4F\u5B83\u2026\u2026\\c\\n\u51A0\u519B\u4E5F\u662F\u4E3A\u4E86\u6765\u6551\u6211\uFF0C\\n\u624D\u653E\u5F03\u4E86\u6BD4\u8D5B\u3002[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6B63\u5982\u4ECE\u6076\u9F99\u7684\u9B54\u722A\u4E2D\\n\u62EF\u6551\u516C\u4E3B\u7684\u9A91\u58EB\u4E00\u6837\u554A\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u54CE\uFF0C\u6211\u8FD9\u4E2A\u4EBA\u6700\u559C\u6B22\u6F14\u8BB2\u4E86\u3002\\c\\n\u8BDD\u4E00\u8BF4\u8D77\u6765\u5C31\u505C\u4E0D\u4E0B\u6765\uFF0C\\n\u4E0D\u8FC7\u73B0\u5728\u8FD8\u662F\u5148\u5230\u6B64\u4E3A\u6B62\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u60F3\u5FC5\u51A0\u519B\u73B0\u5728\u5DF2\u7ECF\u5728\u4E0A\u9762\\n\u6349\u5230\u65E0\u6781\u6C70\u90A3\u4E86\u5427\u3002\\c\\n\u4F60\u60F3\u77E5\u9053\u7ED3\u679C\u7684\u8BDD\uFF0C\\n\u5C31\u5750\u5347\u964D\u673A\u4E0A\u53BB\u770B\u770B\u5427\u3002[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u88AB\u6211\u6253\u5F97\u7070\u5934\u571F\u8138\u7684\u8D6B\u666E\uFF0C\\n\u4F60\u4E5F\u4F1A\u53BB\u5427\uFF1F\\c\\n\u8FD8\u7B49\u4EC0\u4E48\uFF1F\\n\u4F60\u4EEC\u4E24\u4E2A\u5FEB\u53BB\u51A0\u519B\u90A3\u91CC\u5427\uFF01[VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u7070\u5934\u571F\u8138\u2026\u2026\uFF1F\\n\u4F1A\u957F\uFF0C\u4F60\u8FD8\u662F\u4E0D\u4E86\u89E3\u6211\u554A\u3002\\r\\n\u6211\u548C\u5B9D\u53EF\u68A6\u662F\u7EDD\u5BF9\u4E0D\u4F1A\u653E\u5F03\u7684\uFF01\\c\\n\u800C\u8FD9\u80A1\u6597\u5FD7\uFF0C\u4E5F\u662F\u5728\u4F1A\u957F\u4E3E\u529E\u7684\\n\u9053\u9986\u6311\u6218\u4E2D\u5B66\u5230\u7684\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u6211\u5DF2\u7ECF\u505A\u597D\u5FC3\u7406\u51C6\u5907\u4E86\uFF01\\r\\n\u4F60\u5462\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u90A3\u8FD8\u7528\u8BF4\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E0D\u6127\u662F\u6211\u7684\u52B2\u654C\uFF01\\c\\n\u597D\uFF01\u6211\u4EEC\u5FEB\u53BB\u5E2E\u5927\u54E5\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\u4E0D\u77E5\u9053\u4F1A\u53D1\u751F\u4EC0\u4E48\u4E8B\u60C5\u3002\\n\u6211\u4EEC\u8981\u505A\u597D\u5145\u5206\u7684\u51C6\u5907\u554A\u3002[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5750\u5347\u964D\u673A\u5C31\u80FD\u5230\u4E0A\u9762\u53BB\u3002\\n\u8BF7\u4FBF\u5427\u3002[VAR 0114(0006)]"
  }
