    "index": 0,
    "flags": 0,
    "text": "\u54CE\u5440\uFF5E\u6211\u521A\u624D\u4E00\u9192\u6765\uFF0C\\n\u5C31\u53D1\u73B0\u81EA\u5DF1\u53C8\u7AD9\u5728\u5916\u9762\u7761\u7740\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u90A3\u65F6\u6211\u90FD\u5FEB\u51BB\u50F5\u4E86\uFF0C\\n\u4E8E\u662F\u5C31\u60F3\u5728\u57FA\u5730\u51B2\u4E2A\u70ED\u6C34\u6FA1\u2026\u2026\\r\\n\u8C01\u77E5\u9053\u55B7\u51FA\u6765\u7684\u662F\u51C9\u6C34\u554A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u53EF\u628A\u6211\u7ED9\u5413\u7206\u4E86\uFF0C\\n\u7ED3\u679C\u6211\u8863\u670D\u90FD\u6CA1\u7A7F\u5C31\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u557E\u54C7\u54C7\u54C7\uFF5E[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5B69\u5B50\u554A\uFF01\\n\u7275\u7ECA\u7F30\u7EF3\u505A\u597D\u4E86\u5417\uFF1F[VAR 0114(0079)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u505A\u597D\u4E86\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u76AE\u6B27\u5C3C\u961F\u957F\u5E2E\u4E86\u5FD9\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u554A\uFF01\u53EF\u559C\uFF0C\u53EF\u559C\u554A\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u54E6\uFF0C\u5B64\u771F\u662F\u6B20\u4E86\u8FD9\u5BB6\u4F19\\n\u5F88\u591A\u6069\u60C5\u554A\u3002[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8BDD\u8BF4\uFF0C\u771F\u662F\u597D\u4E8B\u4E0D\u65AD\uFF01\\n\u5B64\u521A\u624D\u7EC8\u4E8E\u641E\u6E05\\r\\n\u7231\u9A6C\u7684\u6240\u5728\u4E4B\u5730\u4E86\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u539F\u6765\u96EA\u66B4\u9A6C\u662F\u5C06\\n\u738B\u51A0\u795E\u6BBF\u4F5C\u4E3A\u4E86\u6839\u636E\u5730\uFF01\\c\\n\u90A3\u662F\u5B64\u66FE\u4E0E\u5B83\\n\u5171\u5EA6\u65F6\u5149\u7684\u5730\u65B9\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u539F\u6765\u7075\u5E7D\u9A6C\u662F\u5C06\\n\u738B\u51A0\u795E\u6BBF\u4F5C\u4E3A\u4E86\u6839\u636E\u5730\uFF01\\c\\n\u90A3\u662F\u5B64\u66FE\u4E0E\u5B83\\n\u5171\u5EA6\u65F6\u5149\u7684\u5730\u65B9\uFF01[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u56E0\u4E3A\u5BB3\u6015\u60F3\u8D77\u7F8E\u597D\u5F80\u4E8B\uFF0C\u5B64\u4E00\u76F4\u4EE5\u6765\\n\u90FD\u523B\u610F\u907F\u5F00\u90A3\u91CC\uFF0C\u4E0D\u8FC7\u2026\u2026[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u96BE\u9053\u90A3\u5BB6\u4F19\u662F\u56E0\u4E3A\u6C89\u6D78\u5728\\n\u4E0E\u5B64\u4E00\u8D77\u7684\u56DE\u5FC6\u5F53\u4E2D\uFF0C\u624D\u2026\u2026\uFF1F\\r\\n\u4E0D\uFF0C\u8FD9\u4E0D\u53EF\u80FD\u3002[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u738B\u51A0\u795E\u6BBF\u8038\u7ACB\u4E8E\\n\u5317\u65B9\u5927\u5C71\u7684\u5C71\u5DC5\u3002[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5B64\u5E0C\u671B\u6C5D\u80FD\u643A\u7275\u7ECA\u7F30\u7EF3\u4E0E\u841D\u535C\uFF0C\\n\u6500\u81F3\u90A3\u5EA7\u5C71\u7684\u5C71\u9876\u3002[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5B64\u7684\u5185\u5FC3\u65E9\u5DF2\u6025\u4E0D\u53EF\u8010\uFF0C\\n\u5C31\u6B64\u5148\u884C\u4E00\u6B65\u3002[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5B64\u5C31\u62DC\u6258\u7ED9\u6C5D\u4E86\u3002[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u867D\u7136\u6CA1\u6CD5\u597D\u597D\u62DB\u5F85\u4F60\uFF0C\\n\u4F46\u662F\u5982\u679C\u4F60\u613F\u610F\u7684\u8BDD\uFF0C\\r\\n\u60F3\u5728\u6751\u5B50\u91CC\u5F85\u591A\u4E45\u90FD\u6CA1\u95EE\u9898\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u738B\u51A0\u96EA\u539F\u4E0A\\n\u6709\u51E0\u4E2A\u795E\u5947\u7684\u9057\u8FF9\u3002\\c\\n\u4E0D\u8FC7\u554A\uFF01\u9057\u8FF9\u7684\u95E8\u4E0D\u7BA1\\n\u600E\u4E48\u63A8\uFF0C\u600E\u4E48\u62C9\uFF0C\u90FD\u7EB9\u4E1D\u4E0D\u52A8\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4ECE\u5DE8\u4EBA\u7761\u69BB\u5411\u4E1C\u8FB9\u8D70\uFF0C\\n\u518D\u722C\u4E0A\u5317\u8FB9\u7684\u5C71\uFF0C\\r\\n\u5C31\u80FD\u770B\u5230\u4E00\u5EA7\u53E4\u8001\u7684\u795E\u6BBF\u54E6\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u8981\u53BB\u722C\u5C71\u7684\u8BDD\uFF0C\\n\u53EF\u5343\u4E07\u8981\u5C0F\u5FC3\u554A\u3002\\c\\n\u901A\u5F80\u5C71\u9876\u7684\u8DEF\u53EF\u662F\u5F88\u957F\u7684\u54E6\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u6211\u5BB6\u7684\u6D77\u8C79\u7403\u513F\\n\u662F\u4E0D\u662F\u5F88\u5706\u554A\uFF1F"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u6211\u5F97\u53BB\u4FEE\u4E00\u4E0B\\n\u6C11\u5BBF\u7684\u6DCB\u6D74\u5566\u3002[VAR 0114(007A)]"
  }
