[
  {
    "index": 0,
    "flags": 0,
    "text": "\u554A\uFF01\u4F60\u6765\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u5C0F\u7834\u623F\u95F4\\n\u5C31\u662F\u6211\u79DF\u4F4F\u7684\u6C11\u5BBF\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u4ECE\u73B0\u5728\u8FD9\u4E2A\u77AC\u95F4\u5F00\u59CB\uFF0C\\n\u8FD9\u91CC\u5C06\u6B63\u5F0F\u5347\u7EA7\u6210\u4E3A\u6211\u4EEC\u7684\u57FA\u5730\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u2026\u2026\u563F\u563F\uFF01\u641E\u8FD9\u79CD\u4E8B\u60C5\uFF0C\\n\u4E0D\u5236\u9020\u4E00\u4E0B\u6C14\u6C1B\u600E\u4E48\u884C\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u95F2\u8BDD\u5C11\u8BF4\uFF0C[VAR 0100(0000)]\uFF01\\n\u6211\u8FD9\u5C31\u8981\u5F00\u59CB\u8BB2\u89E3\\r\\n\u54B1\u4EEC\u76AE\u6B27\u5C3C\u63A2\u9669\u961F\u7684\u76EE\u6807\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5728\u8FD9\u4E2A\u5730\u533A\uFF0C\\n\u6D41\u4F20\u7740\u51E0\u4E2A\u795E\u5947\u7684\u4F20\u8BF4\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u597D\u3001\u6BD4\u3001\u8BF4\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u88AB\u4EBA\u4EEC\u53EB\u505A\u4E30\u9976\u4E4B\u738B\u7684\\n\u8111\u888B\u8D3C\u5927\u7684\u5B9D\u53EF\u68A6\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u53C8\u3001\u6216\u3001\u8005\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u80FD\u5438\u5F15\u4F20\u8BF4\u7684\u98DE\u5929\u5B9D\u53EF\u68A6\\n\u805A\u96C6\u800C\u6765\u7684\u7EA2\u8272\u5927\u6811\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u518D\u3001\u6BD4\u3001\u5982\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6C89\u7761\u5728\u50CF\u662F\u9057\u8FF9\u7684\u5947\u602A\u5EFA\u7B51\\n\u91CC\u9762\u7684\u5706\u70B9\u70B9\u5DE8\u4EBA\u4EEC\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E4B\u3001\u7C7B\u3001\u4E4B\u3001\u7C7B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u50CF\u8FD9\u6837\u5999\uFF5E\u4E0D\u53EF\u8A00\u7684\u4F20\u8BF4\\n\u53EF\u662F\u6570\u4E0D\u80DC\u6570\u54E9\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5BF9\u4E8E\u8FD9\u4E9B\u4F20\u8BF4\u7684\u771F\u5B9E\u6027\\n\u8FDB\u884C\u5F7B\u5E95\u7684\u9A8C\u8BC1\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8FD9\u5C31\u662F\u54B1\u4EEC\\n\u76AE\u6B27\u5C3C\u63A2\u9669\u961F\u7684\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5DE8\u5927\u3001\u65E0\u654C\u3001\u7EC8\uFF5E\u6781\u5927\u76EE\u6807\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5509\uFF0C\u8BF4\u771F\u5FC3\u8BDD\uFF0C\u8FD9\u4E48\u597D\u73A9\u7684\u63A2\u9669\\n\u6211\u672C\u6765\u662F\u60F3\u8DDF\u5C0F\u590F\u590F\u4E00\u8D77\u7684\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u4E0D\u662F\u6709\u53E5\u8C1A\u8BED\u8BF4\uFF0C\\n\u840D\u6C34\u76F8\u9022\u4E5F\u662F\u90A3\u4E2A\u4EC0\u4E48\u4EC0\u4E48\u5417\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "[VAR 0100(0000)]\u961F\u957F\uFF01\\n\u54B1\u4EEC\u5C31\u4E00\u8D77\u73A9\u4E2A\u75DB\u5FEB\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u961F\u957F\uFF1F"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u5417\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u5BF9\u5BF9\u5BF9\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u4F60\u60F3\u60F3\u554A\u2026\u2026\u8981\u662F\u54B1\u4FE9\u4E00\u8D77\u51FA\u53BB\\n\u5F00\u5F00\u5FC3\u5FC3\u5730\u5230\u5904\u63A2\u9669\u7684\u8BDD\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5C31\u7B97\u5C0F\u590F\u590F\u60F3\u8DDF\u54B1\u4EEC\u6C47\u5408\uFF0C\u6765\u627E\u54B1\u4EEC\uFF0C\\n\u4E5F\u4F1A\u53D1\u73B0\u8FD9\u91CC\u662F\u4EBA\u53BB\u5C4B\u7A7A\u4E0D\u662F\u5417\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u7136\u540E\uFF0C\u6211\u53EF\u7231\u7684\u5973\u513F\u5C31\u4F1A\u5B64\u96F6\u96F6\u5730\u5F85\u5728\\n\u6CA1\u6709\u7238\u7238\u7684\u623F\u95F4\u91CC\uFF0C\u8138\u4E0A\u5199\u6EE1\u843D\u5BDE\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u554A\uFF5E\uFF01\u8FD9\u600E\u4E48\u884C\uFF01\\n\u6211\u7EDD\u5BF9\u4E0D\u80FD\u8BA9\u8FD9\u79CD\u4E8B\u60C5\u53D1\u751F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u6240\u4EE5\u8BF4\u5462\uFF0C\\n\u6211\u5C31\u8D1F\u8D23\u62C5\u4EFB\u770B\u5BB6\u961F\u957F\u7684\u804C\u52A1\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u63A2\u9669\u961F\u957F\u5C31\u8BA9\u7ED9\u4F60\u53BB\u5F53\u5427\uFF01\\n\u54C7\u54C8\u54C8\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u4E8B\u60C5\u5C31\u662F\u8FD9\u6837\uFF01\u6240\u4EE5\uFF0C\u7ED9\uFF01\\n\u8FD9\u73A9\u610F\u513F\u5C31\u4EA4\u7ED9\u4F60\u4E86\u3002[VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "[VAR 0100(0000)]\\n\u5F97\u5230\u4E86[VAR FF00(0008)]\u63A2\u9669\u5957\u88C5[VAR FF00(0000)]\uFF01"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u54C7\u54C8\u54C8\uFF01\\n\u8FD9\u8863\u670D\u8FD8\u633A\u9002\u5408\u4F60\u7684\u561B\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u6211\u4E3A\u5C0F\u590F\u590F\u51C6\u5907\u4E86\\n\u597D\u51E0\u5957\u66FF\u6362\u8863\u7269\uFF0C\\r\\n\u6240\u4EE5\u53EF\u4EE5\u5206\u4E00\u5957\u7ED9\u4F60\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u4F60\u8981\u662F\u60F3\u6362\u8863\u670D\u6216\u8005\u4F11\u606F\u7684\u8BDD\uFF0C\\n\u53EF\u4EE5\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u7528\u6700\u91CC\u9762\u7684\u8FD9\u4E2A\u623F\u95F4\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u8FD9\u5939\u514B\u4E0A\u7CFB\u7740\u7684\u65B9\u5DFE\uFF0C\\n\u6211\u8FD8\u51C6\u5907\u4E86\u597D\u51E0\u79CD\u989C\u8272\u5462\uFF0C\\r\\n\u4F60\u53EF\u4EE5\u6839\u636E\u5FC3\u60C5\u6362\u7740\u5E26\uFF0C\u4FDD\u51C6\u65F6\u5C1A\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u7136\u540E\uFF0C\u8FD9\u4E2A\u4E5F\u7ED9\u4F60\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u8FD9\u662F\u6211\u4EB2\u624B\u5236\u4F5C\u7684\u4F20\u8BF4\u7B14\u8BB0\uFF01\\n\u770B\u4E86\u597D\u591A\u7535\u89C6\u624D\u6536\u96C6\u5230\u7684\u4FE1\u606F\u54E9\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\u8981\u4E0D\u4F60\u5148\u53BB\u8C03\u67E5\u8C03\u67E5\\n\u6211\u5728\u7B14\u8BB0\u91CC\u63D0\u5230\u7684\\r\\n\u201C\u4E30\u9976\u4E4B\u738B\u201D\uFF0C\u600E\u4E48\u6837\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u8BE5\u600E\u4E48\u8BF4\u5462\uFF1F\u542C\u8BF4\u548C\\n\u56FD\u738B\u4E0E\u7231\u9A6C\u7684\u7275\u7ECA\u6709\u5F88\u5927\u5173\u7CFB\uFF01\\r\\n\u8FD9\u4E2A\u63A2\u9669\u5C31\u53D6\u540D\u53EB\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u5BF9\u4E86\uFF0C\u6751\u5B50\u4E2D\u5FC3\u8FD8\u6709\u8FD9\u5BB6\u4F19\u7684\u96D5\u50CF\u5462\uFF01\\n\u867D\u8BF4\u90A3\u4E2A\u96D5\u50CF\u7684\u8111\u888B\\r\\n\u4E0D\u5982\u6211\u7B14\u8BB0\u91CC\u5199\u7684\u90A3\u4E48\u5927\u5427\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u8981\u6362\u56DE\u539F\u672C\u7684\u670D\u88C5\u5417\uFF1F"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\u8863\u670D\u6362\u597D\u4E86\u2026\u2026\uFF01\\c\\n\u5FEB\u53BB\u8C03\u67E5\\n\u738B\u51A0\u96EA\u539F\u7684\u4F20\u8BF4\u5427\uFF01"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\u5C31\u7A7F\u8FD9\u8EAB\u8863\u670D\u4E5F\u6CA1\u95EE\u9898\uFF01\\c\\n\u5FEB\u53BB\u8C03\u67E5\\n\u738B\u51A0\u96EA\u539F\u7684\u4F20\u8BF4\u5427\uFF01"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\u2026\u2026\u5BF9\u4E86\uFF01\u6211\u6709\u4E2A\u597D\u4E1C\u897F\uFF0C\\n\u4F60\u8981\u4E0D\u8981\u5E26\u8D70\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u968F\u4F60\u628A\u5B83\u7528\u5728\u54EA\u53EA\u5B9D\u53EF\u68A6\u90FD\u884C\u3002\\n\u542C\u8BF4\u8FD9\u662F\u4E2A\u5DE8\u5389\u5BB3\u7684\u7403\u5594\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\u8FD9\u662F\u4EE5\u524D\u4E00\u4E2A\u670B\u53CB\u7ED9\u6211\u7684\uFF0C\\n\u4F46\u6211\u5C31\u662F\u4E0D\u600E\u4E48\u60F3\u7528\u5B83\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u8981\u662F\u6709\u4EC0\u4E48\u4E0D\u660E\u767D\u7684\u4E8B\uFF0C\\n\u4F60\u968F\u65F6\u90FD\u53EF\u4EE5\u56DE\u57FA\u5730\u6765\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\u5916\u9762\u63D2\u7740\u7684\u90A3\u9762\u65D7\u5B50\\n\u5C31\u662F\u63A2\u9669\u961F\u57FA\u5730\u7684\u8BB0\u53F7\uFF01\\r\\n\u90A3\u53EF\u662F\u6211\u4EB2\u624B\u505A\u7684\u5594\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\u597D\u5566\uFF01\u4EE4\u4EBA\u5174\u594B\u7684\u63A2\u9669\uFF01\\n\u5C31\u6B64\u5F00\u59CB\uFF01\u5C31\u6B64\u5F00\u59CB\uFF5E\uFF01\\r\\n\u4F60\u5F00\u5F00\u5FC3\u5FC3\u5730\u53BB\u5427\uFF01[VAR 0114(0076)]"
  }
]
