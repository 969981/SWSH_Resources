    "text": "\u5C0F\u4F19\u5B50\uFF01\u522B\u8D70\uFF01\\n\u4F60\u627E\u5230\u5C0F\u590F\u590F\u4E86\u5417\uFF01\uFF1F\u554A\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5C0F\u59D1\u5A18\uFF01\u522B\u8D70\uFF01\\n\u4F60\u627E\u5230\u5C0F\u590F\u590F\u4E86\u5417\uFF01\uFF1F\u554A\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u4EBA\u53D7\u4E86\u4F24\uFF0C\\n\u6240\u4EE5\u6211\u5F3A\u884C\u628A\u4ED6\u5E26\u4E86\u56DE\u6765\u2026\u2026"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54CE\u54DF\u597D\u75BC\uFF01\u771F\u662F\u75BC\u5F97\u8981\u547D\u554A\u2026\u2026\uFF01\\n\u5C0F\u590F\u590F\uFF01\u5C0F\u590F\u590F\u2026\u2026\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u600E\u4E48\u4E86\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6CA1\u4E8B\u5427\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8FD9\u4F4D\u559C\u6B22\u5927\u5435\u5927\u95F9\u7684\u5148\u751F\\n\u88AB\u4E00\u5757\u77F3\u5934\u72E0\u72E0\u7ECA\u5012\uFF0C\u78D5\u5230\u4E86\u8111\u888B\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5514\u2026\u2026\u6211\u53EF\u7B97\u662F\u4EB2\u8EAB\u611F\u53D7\u5230\u4E86\\n\u5927\u5192\u9669\u7684\u6050\u6016\u4E4B\u5904\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u521A\u624D\u6211\u5C31\u662F\u60F3\u770B\u770B\u6211\u5973\u513F\u5728\u6CA1\u5728\\n\u77F3\u5934\u540E\u9762\uFF0C\u7ED3\u679C\u5C31\u6454\u6210\u4E86\u8FD9\u6837\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u60A8\u662F\u89C9\u5F97\u4EE4\u7231\\n\u662F\u5C0F\u70AD\u4ED4\u8FD8\u662F\u600E\u4E48\u6837\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u597D\u561E\uFF01\u7A0D\u5FAE\u6B47\u4E86\u4F1A\u513F\uFF0C\\n\u6211\u5DF2\u7ECF\u500D\u513F\u7CBE\u795E\u4E86\uFF01\u6839\u672C\u4E0D\u7528\u836F\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8BDD\u8BF4\uFF01\u5C0F\u4F19\u5B50\u5440\uFF01\\n\u4F60\u89C1\u5230\u5C0F\u590F\u590F\u4E86\u5417\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8BDD\u8BF4\uFF01\u5C0F\u59D1\u5A18\u5440\uFF01\\n\u4F60\u89C1\u5230\u5C0F\u590F\u590F\u4E86\u5417\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u89C1\u5230\u4E86"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5176\u5B9E\u2026\u2026"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u54E6\u54E6\u2026\u2026\u539F\u6765\u5982\u6B64\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5C0F\u590F\u590F\u8BF4\u5979\u8981\u5148\u5728\u90A3\u4E2A\u4EC0\u4E48\\n\u6781\u5DE8\u5927\u5192\u9669\u91CC\u9762\u73A9\u4E2A\u591F\uFF0C\\r\\n\u7136\u540E\u624D\u80AF\u56DE\u6765\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u6240\u4EE5\u5E0C\u671B\u54B1\u4FE9\u522B\u7B49\u5979\uFF0C\\n\u76F4\u63A5\u5148\u5F00\u59CB\\r\\n\u76AE\u6B27\u5C3C\u51FA\u54C1\u7684\u63A2\u9669\u4E4B\u65C5\u2026\u2026\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5509\u2026\u2026\u8BF4\u8D77\u8FD9\u6B21\u7684\u65C5\u884C\u554A\uFF01\\n\u6211\u4E3A\u4E86\u5C0F\u590F\u590F\u80FD\u73A9\u597D\uFF0C\\r\\n\u89C9\u90FD\u4E0D\u7761\u5730\u624D\u7422\u78E8\u51FA\u4E86\u8FD9\u4E2A\u65C5\u884C\u8BA1\u5212\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u5979\u73B0\u5728\u53EF\u80FD\u6B63\u662F\u60F3\u8981\\n\u4E00\u4E2A\u4EBA\u5C1D\u8BD5\u5404\u79CD\u65B0\u4E8B\u7269\u7684\u5E74\u7EAA\u5427\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u8FC7\u5206\u628A\u6211\u7684\u610F\u5FD7\u5F3A\u52A0\u7ED9\u5979\uFF0C\\n\u4F30\u8BA1\u4E5F\u8D77\u4E0D\u5230\u592A\u7406\u60F3\u7684\u6559\u80B2\u6548\u679C\u2026\u2026[VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u2026\u2026\u90A3\u597D\u5427\uFF01\\n\u4F60\u53EB\u4EC0\u4E48\u540D\u5B57\u5440\uFF0C\u5B69\u5B50\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\u6211\u53EB\u76AE\u6B27\u5C3C\uFF01\\n\u54E6\u5BF9\uFF0C\u6211\u597D\u50CF\u5DF2\u7ECF\u8BF4\u8FC7\u4E86\uFF01\uFF1F\u54C7\u54C8\u54C8\uFF01\\r\\n\u90A3\u5C31\u91CD\u65B0\u8BA4\u8BC6\u4E00\u4E0B\u5427\uFF01\u4ECA\u540E\u591A\u591A\u6307\u6559\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5F97\u561E\uFF0C\u90A3\u54B1\u4EEC\u5C31\u4E00\u8D77\u6B22\u4E50\u5730\u63A2\u9669\u5427\uFF01\\n\u7528\u63A2\u9669\u7684\u4E50\u8DA3\u5438\u5F15\u5C0F\u590F\u590F\u4E5F\u6765\u53C2\u52A0\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u597D\u554A\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5443\u2026\u2026"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u4F60\u7684\u56DE\u7B54\u771F\u662F\u7ED9\u529B\u5F97\u8981\u547D\u554A\uFF01\\n\u8FD9\u624D\u662F\u90A3\u4E2A\u4EC0\u4E48\u54EA\uFF01\u54C7\u54C8\u54C8\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u54C7\u54C8\u54C8\uFF01\u4E0D\u7528\u62C5\u5FC3\uFF01\\n\u6211\u5DF2\u7ECF\u505A\u597D\u5404\u79CD\u5404\u6837\u7684\u51C6\u5907\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u54B1\u4EEC\u5F00\u5FC3\u5730\\n\u53BB\u627E\u904D\u4F20\u8BF4\u7684\u5B9D\u53EF\u68A6\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u65E2\u7136\u5DF2\u7ECF\u4E0B\u5B9A\u51B3\u5FC3\uFF0C\\n[VAR 0100(0000)]\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u90A3\u5C31\u8D76\u7D27\u5230\u8FD9\u524D\u9762\u7684\u51BB\u51DD\u6751\u53BB\uFF0C\\n\u5546\u91CF\u4E00\u4E0B\u76AE\u6B27\u5C3C\u63A2\u9669\u4E4B\u65C5\u7684\\r\\n\u884C\u52A8\u7B56\u7565\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u5177\u4F53\u60C5\u51B5\uFF0C\u73B0\u573A\u8BB2\u89E3\uFF01\\n\u706B\u901F\u524D\u5F80\uFF0C\u7D27\u6025\u96C6\u5408\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u8D70\u8D70\u8D70\uFF01\u5FEB\u5FEB\u5FEB\uFF01\\n\u8DDF\u968F\u6211\u778E\u7F16\u7684\u53E3\u53F7\u884C\u52A8\u8D77\u6765\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u54C7\uFF5E\u54C8\u54C8\u54C8\u54C8\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u90A3\u4E2A\u4EBA\u53EF\u771F\u662F\u80FD\u5435\u80FD\u95F9\u554A\uFF0C\\n\u5404\u79CD\u610F\u4E49\u4E0A\u90FD\u662F\u2026\u2026"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u90A3\u4E2A\u4EBA\u4E0D\u662F\u8BF4\\n\u8981\u548C\u60A8\u5728\u51BB\u51DD\u6751\u4F1A\u5408\u5417\uFF1F\\c\\n\u8BF7\u60A8\u5FEB\u70B9\u53BB\u627E\u4ED6\u5427\uFF0C\\n\u8D81\u4ED6\u8FD8\u6CA1\u56DE\u6765\u4E4B\u524D\u3002"
  }
