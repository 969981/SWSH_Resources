[
  {
    "index": 0,
    "flags": 0,
    "text": "\u65E0\u8BBA\u662F\u88D9\u513F\u5C0F\u59D0\u7684\u82B1\u871C\u2026\u2026\\n\u8FD8\u662F\u5543\u679C\u866B\u7684\u871C\u6C41\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u90FD\u4E0D\u591F\u9ECF\u7A20\uFF0C\\n\u4E0D\u662F\u6B66\u9053\u718A\u5E08\u4F1A\u559C\u6B22\u7684\u871C\u6C41\u5462\u3002[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u82B1\u6735\u548C\u679C\u5B9E\u7684\u871C\u6C41\u867D\u7136\u751C\uFF0C\\n\u9ECF\u5EA6\u5374\u6709\u70B9\u4F4E\u3002[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u4E00\u542C\u871C\u6C41\u5C31\u60F3\u5230\u690D\u7269\uFF0C\u6240\u4EE5\u6765\u4E86\u68EE\u6797\u3002\\n\u96BE\u9053\u6211\u7684\u601D\u8DEF\u9519\u4E86\u5417\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5514\uFF5E"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u54C7\uFF01\u662F\u767E\u8DB3\u8708\u86A3\uFF01\\n\u8FD9\u53EF\u771F\u662F\u5C11\u89C1\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u522B\u770B\u8FD9\u5BB6\u4F19\u957F\u5F97\u633A\u53EF\u7231\u7684\uFF0C\\n\u5176\u5B9E\u5B83\u4F1A\u5728\u8EAB\u4F53\u91CC\u5236\u9020\u6D53\u7A20\u7684\u6BD2\u6DB2\uFF0C\\r\\n\u76F8\u5F53\u5371\u9669\u5462\u3002[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u2026\u2026\u5BF9\u54E6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5982\u679C\u662F\u82B1\u871C\u6216\u679C\u871C\u548C\\n\u5B9D\u53EF\u68A6\u8EAB\u4F53\u91CC\u7684\u7269\u8D28\\r\\n\u6DF7\u5408\u800C\u6210\u7684\u871C\u6C41\u5462\u2026\u2026\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5C31\u4F1A\u53D8\u5F97\u6D53\u539A\uFF01\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5C31\u4F1A\u6709\u9ECF\u6027\uFF01\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u80AF\u5B9A\u7684\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7136\u540E\u2026\u2026\\n\u8BF4\u8D77\u4F1A\u5728\u8EAB\u4F53\u91CC\u50A8\u5B58\u690D\u7269\u871C\u6C41\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u4F60\u5E94\u8BE5\u5DF2\u7ECF\u77E5\u9053\u4E86\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u7EF5\u7F8A\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8702\u5DE2\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4E0D\u662F\u2026\u2026\u90A3\u4E2A\u662F\u6BDB\u8FAB\u7F8A\u597D\u5417\uFF1F\\n\u867D\u8BF4\u5B83\u786E\u5B9E\u4F1A\u5403\u8349\u5427\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u6CA1\u9519\uFF01\\n\u7B54\u6848\u5C31\u662F\u8702\u5DE2\u5B9D\u53EF\u68A6\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u90A3\u662F\u4E00\u79CD\u53EB\u505A\u8702\u5973\u738B\u7684\u5B9D\u53EF\u68A6\u3002\\n[VAR 0100(0000)]\u4F60\u89C1\u8FC7\u6CA1\u6709\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u8981\u8BF4\u8FD9\u4E00\u5E26\u7684\u8BDD\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u597D\u50CF\u8702\u5973\u738B\u5C31\u6816\u606F\u5728\\n\u84DD\u8272\u9AD8\u5854\u9644\u8FD1\u7684\\r\\n[VAR FF00(0006)]\u516D\u89D2\u5F62\u7684\u5C9B\u5C7F[VAR FF00(0000)]\u4E0A\u5462\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u65E2\u7136\u786E\u5B9A\u4E86\uFF0C\u5C31\u5149\u901F\u51B2\u8FC7\u53BB\u5427\uFF01\\n\u8D70\u7740\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(0005)]"
  }
