[
  {
    "index": 0,
    "flags": 0,
    "text": "\u7B49\u7B49\uFF01[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u90A3\u662F\u8C01\u5440\uFF1F[VAR 0114(006B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5404\u4F4D\uFF0C\u8BF7\u542C\u6211\u8BF4\u51E0\u53E5\u8BDD\u3002\\n\u5927\u5BB6\u8FD8\u8BB0\u5F97\u6211\u5417\uFF1F\\c\\n\u6211\u662F\u5728\u9053\u9986\u6311\u6218\u65F6\u4E2D\u9014\u9000\u51FA\uFF0C\\n\u7559\u4E0B\u4E07\u5206\u9057\u61BE\u7684\u5F7C\u7279\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u662F\u5F7C\u7279\uFF01\\n\u6D1B\u5179\u4F1A\u957F\u63A8\u8350\u7684\u90A3\u4E2A\u9053\u9986\u6311\u6218\u8005\uFF01[VAR 0114(006B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u8FD9\u6837\u505A\u662F\u8FDD\u89C4\u7684\uFF01\\c\\n\u4F46\u662F\u8BF7\u5927\u5BB6\u7ED9\u6211\u4E00\u4E2A\\n\u548C[VAR 0100(0000)]\u9009\u624B\u4E86\u7ED3\u6069\u6028\u7684\u673A\u4F1A\uFF01\\c\\n\u6211\u8D4C\u4E0A\u9009\u624B\u751F\u6DAF\uFF0C\u53EA\u6C42\u4E00\u6218\uFF01\\n\u5982\u679C\u6211\u8F93\u4E86\uFF0C\u6211\u4F1A\u653E\u5F03\u8BAD\u7EC3\u5BB6\u7684\u8EAB\u4EFD\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u51FA\u73B0\u610F\u5916\u72B6\u51B5\u4E86\uFF01\\c\\n\u5931\u53BB\u6BD4\u8D5B\u8D44\u683C\u7684\u9053\u9986\u6311\u6218\u8005\\n\u5F7C\u7279\u9009\u624B\u7A81\u7136\u51FA\u73B0\u5566\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u4EEC\u6B63\u5728\u5BA1\u8BAE\u5F7C\u7279\u9009\u624B\u63D0\u51FA\u7684\u8981\u6C42\u3002\\c\\n\u8BF7\u7ADE\u6280\u573A\u548C\u7535\u89C6\u673A\u524D\u7684\\n\u5404\u4F4D\u89C2\u4F17\u7A0D\u7B49\u7247\u523B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u81EA\u5DF1\u4E5F\u77E5\u9053\u8FD9\u4E2A\u8981\u6C42\u63D0\u5F97\u5F88\u8FC7\u5206\u3002\\c\\n\u4F46\u662F\uFF0C\u6211\u5FC5\u987B\u8981\u8BF4\u51FA\u6765\u2026\u2026\\n\u6211\u4E0D\u80FD\u5FCD\u6C14\u541E\u58F0\u5730\u9000\u51FA\u8FD9\u4E2A\u821E\u53F0\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u628A\u6211\u5BB3\u5F97\u597D\u60E8\u554A\uFF01\\c\\n\u6211\u53EA\u662F\u53D7\u5965\u5229\u8587\u79D8\u4E66\u4E4B\u6258\uFF0C\\n\u4E3A\u6D1B\u5179\u4F1A\u957F\u6536\u96C6\u8BB8\u613F\u661F\u800C\u5DF2\u3002\\r\\n\u7136\u800C\u5FE0\u5FC3\u803F\u803F\u7684\u6211\u5374\u88AB\u4F1A\u957F\u629B\u5F03\u4E86\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u800C\u4E14\u7978\u4E0D\u5355\u884C\uFF01\\n\u8FD8\u6709\u4E2A\u83AB\u540D\u5176\u5999\u7684\u8001\u5A46\u5A46\\r\\n\u6574\u5929\u5411\u6211\u704C\u8F93\u5996\u7CBE\u5C5E\u6027\u7684\u4E8B\uFF01\\c\\n\u4F60\u80FD\u60F3\u8C61\u5417\uFF1F\\n\u6BCF\u5929\u90FD\u88AB\u7C89\u7EA2\u8272\u5305\u56F4\u7740\u2026\u2026\\c\\n\u65E5\u590D\u4E00\u65E5\u5730\u548C\u5996\u7CBE\u5C5E\u6027\u7684\\n\u5B9D\u53EF\u68A6\u5BF9\u6218\u3001\u731C\u8C1C\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u554A\u554A\uFF01\u6211\u7ADF\u7136\u4F1A\u8FD9\u4E48\u6FC0\u52A8\u5730\u8BC9\u82E6\uFF01\\n\u8FD9\u53EF\u4E0D\u50CF\u662F\u6211\u7684\u4F5C\u98CE\u554A\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5929\u554A\uFF01\u51A0\u519B\u5C45\u7136\u5141\u8BB8\u4E86\\n\u8FD9\u573A\u7A81\u5982\u5176\u6765\u7684\u5BF9\u6218\uFF01\\c\\n\u8FD9\u662F\u51FA\u81EA\u51A0\u519B\u5E0C\u671B\u4F3D\u52D2\u5C14\u6240\u6709\u8BAD\u7EC3\u5BB6\\n\u90FD\u53D8\u5F97\u66F4\u5F3A\u7684\u7F8E\u597D\u613F\u671B\u5462\uFF1F\\c\\n\u8FD8\u662F\u51A0\u519B\u7ED9\u4E88\\n[VAR 0100(0000)]\u9009\u624B\u7684\u8003\u9A8C\u5462\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u7684\u5185\u5FC3\u575A\u5F3A\u65E0\u6BD4\uFF01\\n\u4E0D\u4F1A\u8F7B\u6613\u788E\u6389\u7684\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u8F93\u4E86\u2026\u2026[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54E6\uFF01[VAR 0100(0000)]\u9009\u624B\u548C[VAR 1100(00FF,0101)]\u4ED6\u5979\u7684\u5B9D\u53EF\u68A6\\n\u5F3A\u529B\u56DE\u5E94\u4E86\u5F7C\u7279\u9009\u624B\u7684\u6311\u6218\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u54DF\uFF01\u5F7C\u7279\u9009\u624B\uFF0C\\n\u4F60\u8868\u73B0\u5F97\u4E0D\u8D56\u561B\uFF01[VAR 0114(006B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9000\u5F79\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u518D\u590D\u51FA\u5C31\u662F\u4E86\uFF01[VAR 0114(006B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u600E\u4E48\u4F1A\u8FD9\u6837\u2026\u2026\\c\\n\u6211\u672C\u6765\u60F3\u5F97\u633A\u597D\u2026\u2026\\c\\n\u8FD9\u4E2A\u4EC7\u80FD\u62A5\u5C31\u62A5\uFF0C\\n\u4E0D\u80FD\u62A5\u4E5F\u80FD\u5C31\u6B64\u9000\u5F79\u9003\u79BB\u90A3\u4E2A\u8001\u5A46\u5A46\u2026\u2026[VAR 0114(000C)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F60\u679C\u7136\u662F\u6211\u7684\u707E\u661F\uFF01\\c\\n\u5927\u5BB6\u4E00\u65E6\u8BA4\u53EF\u6211\uFF0C\\n\u6211\u5C31\u5FC5\u987B\u8981\u7EE7\u7EED\u5F53\\r\\n\u5996\u7CBE\u5C5E\u6027\u7684\u9053\u9986\u9986\u4E3B\u4E86\uFF01[VAR 0114(000C)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u4EE5\u6211\u7684\u624D\u80FD\uFF0C\u4E00\u7728\u773C\u7684\u529F\u592B\\n\u5C31\u80FD\u8D85\u8FC7\u6CE2\u666E\u83C8\u5C31\u662F\u4E86\u3002[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5BF9\u4E24\u4F4D\u5E74\u8F7B\u4EBA\u7684\u79F0\u8D5E\u58F0\\n\u6B63\u8D2F\u7A7F\u4E8E\u6574\u4E2A\u7ADE\u6280\u573A\u4E2D\uFF01\\c\\n\u597D\u4E86\uFF0C[VAR 0100(0000)]\u9009\u624B\u7ECF\u5386\u4E86\u8FD9\u573A\\n\u610F\u6599\u4E4B\u5916\u7684\u5BF9\u6218\u540E\uFF0C\\r\\n\u4E5F\u9700\u8981\u5230\u4F11\u606F\u5BA4\u6062\u590D\u4E00\u4E0B\u6D3B\u529B\u2026\u2026[VAR 0114(0018)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u60F3\u4E0D\u5230\u5F7C\u7279\u4F1A\u7A81\u7136\u51FA\u73B0\u554A\uFF01\\n\u771F\u662F\u8F9B\u82E6\u4F60\u4E86\u3002\\c\\n\u7B49\u4F60\u505A\u597D\u51C6\u5907\u4E4B\u540E\uFF0C\\n\u5C31\u8BF7\u524D\u5F80\u5BF9\u6218\u573A\u5427\uFF01\\r\\n\u51B3\u8D5B\u9A6C\u4E0A\u5C31\u8981\u5F00\u59CB\u4E86\u3002"
  }
]
