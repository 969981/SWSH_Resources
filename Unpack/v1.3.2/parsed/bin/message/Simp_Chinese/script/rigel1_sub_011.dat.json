  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u591A\u4E8F\u4E86\u4F60\uFF0C\u53C8\u6709[VAR 0202(0001)]\u53EA\\n\u5730\u9F20\u56DE\u5230\u4E86\u6211\u8EAB\u8FB9\uFF01"
  },
