  {
    "index": 20,
    "flags": 0,
    "text": "\u4F60\u5F88\u6709\u627E\u5730\u9F20\u7684\u5929\u8D4B\u554A\uFF01\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u53EF\u4EE5\u7684\u8BDD\uFF0C\u80FD\u9EBB\u70E6\u4F60\u5E2E\u6211\\n\u628A\u5176\u5B83\u5730\u9F20\u4E5F\u627E\u51FA\u6765\u5417\u2026\u2026\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4F60\u771F\u662F\u592A\u5584\u826F\u4E86\uFF01\\n\u6211\u90FD\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u611F\u8C22\u4F60\u4E86\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u6CA1\u4E8B\u3001\u6CA1\u4E8B\uFF01\u4F60\u8BE5\u5E72\u4EC0\u4E48\u5C31\u5E72\u4EC0\u4E48\uFF0C\\n\u5728\u5192\u9669\u9014\u4E2D\u770B\u5230\uFF13\u6839\u6BDB\u7684\u8BDD\uFF0C\\r\\n\u987A\u4FBF\u8DDF\u5B83\u642D\u4E2A\u8BDD\u5C31\u53EF\u4EE5\u7684\u3002"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u73B0\u5728\u4F60\u5DF2\u7ECF\u5E2E\u6211\u627E\u5230\u4E86[VAR 0202(0001)]\u53EA\u5730\u9F20\uFF0C\\n\u5269\u4E0B\u7684\u8FD8\u6709[VAR 0202(0002)]\u53EA\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u9EBB\u70E6\u4F60\u627E\u5230\u5B83\u4EEC\u65F6\uFF0C\\n\u53EB\u5B83\u4EEC\u8D76\u7D27\u56DE\u6765\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u9EBB\u70E6\u4F60\u627E\u5230\u5B83\u4EEC\u65F6\uFF0C\\n\u53EB\u5B83\u4EEC\u8D76\u7D27\u56DE\u6765\uFF01"
