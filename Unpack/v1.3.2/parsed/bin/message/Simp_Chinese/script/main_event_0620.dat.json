[
  {
    "index": 0,
    "flags": 0,
    "text": "\u563F\u563F\u563F\uFF01\\c\\n\u672C\u5927\u7237\u8981\u8FC7\u8FD9\u5EA7\u957F\u957F\u7684\u5927\u6865\uFF0C\\n\u5FEB\u628A\u81EA\u884C\u8F66\u4EA4\u51FA\u6765\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u8981\u7528\u62A2\u6765\u7684\u81EA\u884C\u8F66\\n\u59A8\u788D\u90A3\uFF5E\u4E9B\u9053\u9986\u6311\u6218\u8005\uFF01\\r\\n\u8BA9\u4ED6\u4EEC\u88AB\u81EA\u884C\u8F66\u8FFD\u5F97\u56DB\u5904\u8DD1\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8BF4\u4EC0\u4E48\u9B3C\u8BDD\uFF01\\c\\n\u4F60\u4EEC\u8FDE\u53EA\u6D1B\u6258\u59C6\u90FD\u6CA1\u6709\uFF0C\\n\u8FD8\u8981\u5565\u81EA\u884C\u8F66\u554A\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u4F4D\u9053\u9986\u6311\u6218\u8005\uFF01\\n\u8FD9\u4E9B\u5BB6\u4F19\u8981\u62A2\u6211\u7684\u81EA\u884C\u8F66\uFF01\\c\\n\u4F60\u5C31\u884C\u884C\u597D\uFF0C\\n\u5E2E\u6211\u6559\u8BAD\u4E00\u4E0B\u4ED6\u4EEC\u5427\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u4EEC\u624D\u4E0D\u662F\u8981\u62A2\u81EA\u884C\u8F66\uFF01\\c\\n\u53EA\u662F\u8981\u501F\u6765\u8FFD\u8D76\u90A3\uFF5E\u4E9B\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u628A\u4ED6\u4EEC\u641E\u5F97\u7CBE\u75B2\u529B\u5C3D\u7F62\u4E86\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u6211\u4EEC\u8981\u5728\u5BF9\u6218\u4E2D\u6253\u7206\u4F60\uFF0C\\n\u8BA9\u4F60\u5C1D\u591F\u88AB\u59A8\u788D\u7684\u6ECB\u5473\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u545C\u2026\u2026\\n\u788D\u4EBA\u4E0D\u6210\u53CD\u88AB\u788D\u3002[VAR 0114(006F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u53EF\u6076\uFF5E\uFF01\u6211\u5C31\u60F3\u8981\u81EA\u884C\u8F66\uFF01\\n\u522B\u59A8\u788D\u6211\uFF5E\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u50CF\u4F60\u8FD9\u6837\u5389\u5BB3\u7684\u9053\u9986\u6311\u6218\u8005\\n\u8981\u662F\u4E0D\u5FEB\u70B9\u6D88\u5931\u7684\u8BDD\uFF0C\\r\\n\u6211\u4EEC\u652F\u6301\u7684\u90A3\uFF5E\u4F4D\u5C31\u6CA1\u6CD5\u80DC\u51FA\u4E86\uFF01\\c\\n\u6211\u4EEC\u8981\u66F4\u52AA\u529B\u5730\u59A8\u788D\u4F60\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u771F\u4E86\u4E0D\u8D77\uFF01\\c\\n\u65E2\u7136\u4F60\u6709\u5B9D\u53EF\u68A6\u56FE\u9274\uFF0C\\n\u90A3\u4E5F\u6709\u6D1B\u6258\u59C6\u5427\uFF01\\c\\n\u8FD9\u6837\u597D\u4E86\uFF01\u4E0E\u5176\u88AB\u5450\u558A\u961F\u62A2\u8D70\uFF0C\\n\u8FD8\u4E0D\u5982\u73B0\u5728\u5C31\u628A\u81EA\u884C\u8F66\u9001\u7ED9\u4F60\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u542C\u597D\u4E86\uFF01\u4F60\u77E5\u9053\u6D1B\u6258\u59C6\\n\u975E\u5E38\u975E\u5E38\u559C\u6B22\u9A6C\u8FBE\u5427\uFF1F\\c\\n\u5B83\u8981\u662F\u77E5\u9053\u54EA\u4E2A\u673A\u5668\u91CC\u6709\u9A6C\u8FBE\uFF0C\\n\u5C31\u975E\u8981\u94BB\u8FDB\u53BB\u4E0D\u53EF\u3002\\c\\n\u4E8E\u662F\u6211\u7075\u673A\u4E00\u52A8\uFF01\\n\u60F3\u5230\u5982\u679C\u4E5F\u4E3A\u81EA\u884C\u8F66\u914D\u4E0A\u9A6C\u8FBE\uFF0C\\r\\n\u8BF4\u4E0D\u5B9A\u6D1B\u6258\u59C6\u5C31\u4F1A\u4E56\u4E56\u5730\u94BB\u8FDB\u53BB\u4E86\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u54E6\u2026\u2026"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u539F\u6765\u5982\u6B64"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u591A\u5C1D\u8BD5\u4E00\u4E0B\u6CA1\u574F\u5904\uFF01\\c\\n\u4F60\u4E5F\u548C\u6D1B\u6258\u59C6\u4E00\u8D77\u4EAB\u53D7\u4E00\u4E0B\\n\u9A91\u81EA\u884C\u8F66\u515C\u98CE\u7684\u4E50\u8DA3\u5427\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6765\u6765\u6765\uFF01\\c\\n\u4F60\u4E5F\u6765\u548C\u6D1B\u6258\u59C6\u4E00\u8D77\u9A91\u81EA\u884C\u8F66\u5427\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u6765\u5FF5\u4E00\u4E0B\u8BF4\u660E\u4E66\u5427\u3002\\c\\n\u6309\u4E0B\uFF0B\u952E\u6216\uFF0D\u952E\uFF0C\\n\u5373\u53EF\u548C\u6D1B\u6258\u59C6\u9A91\u81EA\u884C\u8F66\u3002\\r\\n\u53BB\u5427\uFF0C\u5C3D\u60C5\u5730\u515C\u98CE\u5427\uFF01"
  }
]
