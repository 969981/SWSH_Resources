[
  {
    "index": 0,
    "flags": 0,
    "text": "\u547C\u2026\u2026\\n\u7EC8\u4E8E\u6709\u4EBA\u6765\u4E86\u554A\u3002[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u89C9\u5F97\u4E4B\u6240\u4EE5\u6CA1\u4EBA\u6765\u627E\u6211\u6311\u6218\uFF0C\\n\u5C31\u662F\u56E0\u4E3A\u6211\u662F\u4E2A\u65E0\u53EF\u6551\u836F\u7684\u5BB6\u4F19\u3002\\c\\n\u8FD9\u7B97\u662F\u6211\u7684\u4E00\u4E2A\u5FC3\u7ED3\u5427\u3002[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u7684\u8033\u6735\u5F88\u7075\uFF0C\\n\u6240\u4EE5\u5377\u5E18\u95E8\u7684\u4E8B\u4E5F\u90FD\u6709\u542C\u5230\u3002\\c\\n\u4F46\u662F\u4E00\u4E2A\u4EBA\u5F85\u5728\u8FD9\u91CC\uFF0C\\n\u6211\u7684\u5185\u5FC3\u90FD\u5FEB\u8981\u5D29\u6E83\u4E86\u3002[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u662F\u4E2A\u4E0D\u80FD\u4F7F\u7528\u6781\u5DE8\u5316\u7684\u9053\u9986\u7ADE\u6280\u573A\uFF0C\\n\u6240\u4EE5\u5BF9\u6218\u4F1A\u53D8\u5F97\u76F4\u622A\u4E86\u5F53\u2026\u2026\\r\\n\u4F46\u6211\u8FD8\u662F\u5E0C\u671B\u4F60\u80FD\u611F\u53D7\u5230\u4E50\u8DA3\u3002[VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u547C\u2026\u2026[VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u662F\uFF01\u5C16\u9489\u9547\u7684\uFF01\u9053\u9986\u9986\u4E3B\uFF01\\n\u4F7F\u7528\u6076\u5C5E\u6027\u5B9D\u53EF\u68A6\u7684\u5929\u624D\uFF01\\r\\n\u4EBA\u79F0\uFF01\u5FE7\u90C1\u7684\u8042\u6893\uFF01\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5C3D\u7BA1\u4F60\uFF01\u660E\u77E5\u5FC5\u8D25\uFF01\u5374\u4F9D\u7136\u5411\u6211\u6311\u6218\uFF01\\n\u4E3A\u4E86\u56DE\u5E94\uFF01\u4F60\u7684\u611A\u8822\u884C\u4E3A\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u8981\u548C\uFF01\u6211\u6B22\u5FEB\u7684\u4F19\u4F34\u4EEC\uFF01\u4E00\u8D77\u4E0A\u9635\uFF01\\n\u597D\u597D\u5C1D\u5C1D\uFF01\u5C16\u9489\u9547\u7684\u5389\u5BB3\uFF01\uFF01[VAR 0114(0016)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u80FD\u548C\u4F60\u5BF9\u6218\u771F\u662F\u592A\u68D2\u4E86\uFF01\\c\\n\u6211\u7684\u5B9D\u53EF\u68A6\u4EEC\u597D\u50CF\u90FD\u662F\u8FD9\u4E48\u60F3\u7684\u3002[VAR 0114(0016)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD9\u5C31\u662F\u6076\u5C5E\u6027\u9053\u9986\u7684\u5FBD\u7AE0\u2014\u2014\\n\u6076\u4E4B\u5FBD\u7AE0\u3002[VAR 0114(0016)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u53EF\u4EE5\u6355\u6349\u7B49\u7EA7\uFF15\uFF15\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8FD8\u6709\u8FD9\u5957\u7ADE\u6280\u670D\u4F60\u4E5F\u6536\u4E0B\u2026\u2026\\c\\n\u8981\u662F\u6211\u5F00\u6F14\u5531\u4F1A\u7684\u8BDD\uFF0C\\n\u8FD8\u771F\u60F3\u628A\u5B83\u5F53\u5546\u54C1\u5356\u5462\u3002[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E0B\u4E00\u4E2A\u6765\u6311\u6218\u7684\uFF0C\\n\u5E94\u8BE5\u5C31\u662F\u6211\u59B9\u59B9\u739B\u4FD0\u4E86\u5427\u3002[VAR 0114(0016)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u8981\u56DE\u5230\u62A5\u5230\u5904\u5417\uFF1F"
  }
]
