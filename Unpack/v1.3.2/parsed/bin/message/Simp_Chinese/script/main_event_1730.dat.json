[
  {
    "index": 0,
    "flags": 0,
    "text": "\u7EC8\u4E8E\u5230\u4E86\u51B3\u8D5B\u7684\u6700\u540E\u4E00\u8F6E\uFF01\\c\\n\u5411\u65E0\u654C\u7684\u51A0\u519B\u4E39\u5E1D\\n\u53D1\u8D77\u6311\u6218\u7684\u7A76\u7ADF\u662F\u2026\u2026[VAR 0114(0018)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u95EA\u4EAE\u7684\u8D85\u7EA7\u65B0\u661F\\n[VAR 0100(0000)]\u9009\u624B\u5462\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD8\u662F\u88AB\u51A0\u519B\u4E39\u5E1D\u89C6\u4E3A\u52B2\u654C\u7684\u7537\u4EBA\u2014\u2014\\n\u9F99\u4E4B\u98CE\u66B4\uFF0C\u5947\u5DF4\u7EB3\u5462\uFF01\uFF1F[VAR 0114(0018)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u80FD\u4E00\u8DEF\u664B\u7EA7\u5230\u8FD9\u91CC\uFF0C\\n\u8BF4\u660E\u4F60\u786E\u5B9E\u5F88\u4E86\u4E0D\u8D77\uFF01\\c\\n\u771F\u4E0D\u6127\u662F\u51A0\u519B\u4E39\u5E1D\u63A8\u8350\u7684\\n\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E3A\u4E86\u8D85\u8FC7\u6211\u7684\u52B2\u654C\u4E39\u5E1D\uFF0C\\n\u6211\u8981\u5148\u6218\u80DC\u4ED6\u6240\u770B\u4E2D\u7684\u4F60\uFF01\\c\\n\u4E3A\u4E86\u5728\uFF11\u5BF9\uFF11\u7684\u5BF9\u6218\u4E2D\u53D6\u80DC\uFF0C\\n\u6211\u8FD8\u9488\u5BF9\u961F\u4F0D\u6210\u5458\u505A\u51FA\u4E86\u8C03\u6574\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u53EF\u80FD\u4F1A\u89C9\u5F97\u6211\u5728\u53E3\u51FA\u72C2\u8A00\uFF0C\\n\u6BD5\u7ADF\u6211\u66FE\u662F\u4F60\u7684\u624B\u4E0B\u8D25\u5C06\u3002\\c\\n\u4F46\u662F\u529D\u4F60\u4E0D\u8981\u5C0F\u770B\u672C\u5927\u7237\uFF0C\\n\u73B0\u5728\u7684\u6211\u4E0D\u662F\u9053\u9986\u6311\u6218\u65F6\u7684\u90A3\u4E2A\u6211\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u83B7\u80DC\u7684\u662F[VAR 0100(0000)]\u9009\u624B\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u672C\u5927\u7237\u548C\u5FC3\u7231\u7684\u5B9D\u53EF\u68A6\u4EEC\\n\u5DF2\u7ECF\u53D8\u5F97\u76F8\u5F53\u5F3A\u5927\u4E86\uFF01\\r\\n\u800C\u4F60\u8FD9\u5BB6\u4F19\u6210\u957F\u7684\u5E45\u5EA6\\r\\n\u7ADF\u7136\u8FD8\u8FDC\u8FDC\u8D85\u8FC7\u4E86\u6211\u4EEC\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u867D\u8BF4\u672C\u5927\u7237\u4E5F\u8FD8\u5E74\u8F7B\uFF0C\\n\u4F46\u770B\u5230\u4F60\u4EEC\u8FD9\u4E9B\u5C0F\u9B3C\u5934\u8FDB\u6B65\u795E\u901F\uFF0C\\r\\n\u9664\u4E86\u60CA\u8BB6\uFF0C\u8FD8\u662F\u60CA\u8BB6\uFF01\u672A\u6765\u662F\u4F60\u4EEC\u7684\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u8981\u4FDD\u6301\u8FD9\u80A1\u52B2\u5934\uFF0C\\n\u628A\u4E39\u5E1D\u4E5F\u62C9\u4E0B\u738B\u5EA7\u554A\uFF01[VAR 0114(0017)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5149\u5F69\u593A\u76EE\u7684\u80CC\u53F7[VAR 01C4(0001)]\uFF01\\n\u83B7\u80DC\u7684\u662F[VAR 0100(0000)]\u9009\u624B\uFF01\\c\\n\u5F97\u5230\u51A0\u519B\u63A8\u8350\u7684\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\\n\u5373\u5C06\u6311\u6218\u63A8\u8350\u81EA\u5DF1\u7684\u51A0\u519B\u4E86\uFF01\uFF01[VAR 0114(0018)]"
  }
]
