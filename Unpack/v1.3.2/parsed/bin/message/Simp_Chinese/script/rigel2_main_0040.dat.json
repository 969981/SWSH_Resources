  },
  {
    "index": 1,
    "flags": 0,
    "text": "[~ 1]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u60A8\u8981\u542C\u6211\u8BB2\u89E3\\n\u6781\u5DE8\u5927\u5192\u9669\u5417\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u522B\u8BF4\u8FD9\u4E48\u53EB\u4EBA\u96BE\u8FC7\u7684\u8BDD\u561B\uFF01\\n\u62DC\u6258\u4F60\u4E86\uFF0C\u597D\u642D\u6863\uFF5E\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8BF7\u4E0D\u8981\u7406\u4F1A\u90A3\u4F4D\u5148\u751F\u3002\\n\u7B49\u60A8\u505A\u597D\u51C6\u5907\u4EE5\u540E\uFF0C\\r\\n\u518D\u6765\u627E\u6211\u642D\u8BDD\u5427\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u54C8\u54C8\uFF01\u8FD9\u624D\u662F\u6211\u7684\u597D\u4F19\u4F34\uFF01\\n\u7B97\u6211\u6B20\u4F60\u4E00\u4E2A\u4EBA\u60C5\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u2026\u2026\u90A3\u4E48\uFF0C\\n\u6211\u73B0\u5728\u5C31\u5F00\u59CB\u4E3A\u60A8\u8BB2\u89E3\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6781\u5DE8\u5DE2\u7A74\u662F\u4E00\u5EA7\u5730\u4E0B\u8FF7\u5BAB\uFF0C\\n\u91CC\u9762\u6816\u606F\u7740\u5728\u4F3D\u52D2\u5C14\u5730\u533A\\r\\n\u65E0\u6CD5\u89C1\u5230\u7684\u7A00\u6709\u5B9D\u53EF\u68A6\u2026\u2026"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7531\u4E8E\u5927\u5BB6\u7684\u540C\u884C\u5B9D\u53EF\u68A6\u6709\u53EF\u80FD\\n\u4F1A\u5BF9\u4F3D\u52D2\u5C14\u7C92\u5B50\u8D77\u53CD\u5E94\uFF0C\\r\\n\u53D8\u5F97\u5931\u53BB\u63A7\u5236\u2026\u2026"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6240\u4EE5\uFF0C\u6211\u4EEC\u4E3A\u5927\u5BB6\u51C6\u5907\u4E86\u4E00\u4E9B\\n\u80FD\u591F\u62B5\u5FA1\u4F4F\u7C92\u5B50\u5F71\u54CD\u7684\u5B9D\u53EF\u68A6\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u55EF\uFF1F\u6211\u61C2\u4E86\uFF01\u4E5F\u5C31\u662F\u8BF4\u2026\u2026\\c\\n\u5982\u679C\uFF14\u4E2A\u6211\u5168\u90FD\u5931\u53BB\u63A7\u5236\uFF0C\\n\u5C31\u4F1A\u88AB\u5B89\u5168\u5730\u79DF\u7528\uFF0C\\r\\n\u7136\u540E\u5927\u5BB6\u7684\u7A00\u6709\u6F5C\u529B\u5C31\u4F1A\u88AB\u6FC0\u53D1\uFF01\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u60A8\u7684\u7406\u89E3\u5B8C\u5168\u9519\u8BEF\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8FD9\u4E2A\u5730\u65B9\u5F88\u5371\u9669\uFF0C\\n\u8BF7\u60A8\u4E00\u5B9A\u8981\u7262\u8BB0\u89C4\u5219\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u662F\u4E0D\u61C2\u8FD9\u5230\u5E95\u662F\u4E2A\u4EC0\u4E48\u5730\u65B9\uFF0C\\n\u4E0D\u8FC7\u4F60\u8BF4\u662F\u4EC0\u4E48\u5C31\u662F\u4EC0\u4E48\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u597D\u8036\uFF01\\n\u770B\u6765\u6211\u641E\u4E0D\u61C2\u90A3\u4E48\u591A\u554A\u3002\\r\\n\u90A3\u6211\u5148\u8FDB\u53BB\u7785\u7785\u5C31\u662F\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5C0F\u590F\u590F\uFF5E\uFF5E\uFF5E\uFF01\uFF01\\n\u7238\u7238\u8FD9\u5C31\u53BB\u627E\u4F60\uFF5E\uFF5E\uFF5E\uFF01\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u554A\uFF01\u7B49\u4E00\u4E0B\uFF01\uFF01\\n\u6211\u90FD\u8BF4\u4E86\u90A3\u6837\u5F88\u5371\u9669\uFF01\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u90A3\u4E2A\u4EBA\u5230\u5E95\\n\u662F\u4EC0\u4E48\u60C5\u51B5\u554A\uFF1F\\c\\n\u8138\u660E\u660E\u957F\u5F97\u8DDF\\n\u6D1B\u5179\u4F1A\u957F\u90A3\u4E48\u50CF\u2026\u2026"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5982\u679C\u60A8\u60F3\u53BB\u8FFD\u90A3\u4E2A\u4EBA\\n\u2026\u2026\u4E0D\u597D\u610F\u601D\uFF0C\u4E0D\u662F\u3002\\c\\n\u6211\u662F\u8BF4\uFF0C\u5982\u679C\u60A8\u60F3\u6311\u6218\u6781\u5DE8\u5927\u5192\u9669\u7684\u8BDD\uFF0C\\n\u5C31\u6765\u8DDF\u6211\u8BF4\u4E00\u58F0\u5427\u3002"
  }
]
