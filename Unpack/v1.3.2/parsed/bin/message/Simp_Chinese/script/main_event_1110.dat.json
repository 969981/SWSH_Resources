[
  {
    "index": 0,
    "flags": 0,
    "text": "\u4E00\u573A\u610F\u5916\uFF0C\\n\u7ADF\u8BA9\u9057\u8FF9\u7684\u5185\u90E8\u91CD\u89C1\u5929\u65E5\u4E86\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u5B83\u6240\u5448\u73B0\u7684\u662F\\n\u4EC0\u4E48\u6837\u7684\u4F3D\u52D2\u5C14\u4F20\u8BF4\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5251\u548C\u76FE\uFF1F"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u662F\u554A\uFF01\u8FD9\u4E24\u5C0A\u770B\u4F3C\u5B9D\u53EF\u68A6\u7684\u96D5\u50CF\\n\u8FDC\u6BD4\u82F1\u96C4\u8981\u663E\u773C\uFF01\\c\\n\u800C\u4E14\u5B9D\u53EF\u68A6\u770B\u8D77\u6765\u5C31\u50CF\u662F\\n\u5251\u548C\u76FE\u7684\u4E3B\u4EBA\u4E00\u6837\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8FD8\u6709\u6CA1\u6709\u5176\u4ED6\u5728\u610F\u7684\u5730\u65B9\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u82F1\u96C4\u6709\u2026\u2026\u4E24\u4E2A\u4EBA\uFF1F"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u548C\u6302\u6BEF\u4E0A\u63CF\u7ED8\u7684\u4E00\u6837\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u662F\u554A\uFF01\\n\u770B\u6765\u6709\u4E24\u4E2A\u82F1\u96C4\u554A\u3002\\c\\n\u53EF\u662F\u542B\u7F9E\u82DE\u65C5\u5E97\u91CC\u7684\\n\u82F1\u96C4\u96D5\u50CF\u53EA\u6709\u4E00\u4E2A\u4EBA\uFF0C\\r\\n\u53C8\u8BE5\u5982\u4F55\u89E3\u91CA\u5462\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6309\u7406\u8BF4\uFF0C\u8FD9\u5EA7\u9057\u8FF9\u7684\u5386\u53F2\\n\u6BD4\u82F1\u96C4\u96D5\u50CF\u548C\u53E4\u8001\u7684\u6302\u6BEF\u90FD\u66F4\u4E45\u8FDC\u2026\u2026\\r\\n\u5B83\u6240\u5448\u73B0\u7684\u5E94\u8BE5\u66F4\u63A5\u8FD1\u771F\u5B9E\u7684\u5386\u53F2\u3002[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4E5F\u5C31\u662F\u8BF4\u2026\u2026[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5251\u662F\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u76FE\u4E5F\u662F\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E00\u5B9A\u662F\u8FD9\u6837\uFF01\\c\\n\u968F\u7740\u65F6\u5149\u6D41\u901D\uFF0C\u4F20\u8BF4\u4E2D\u63D0\u5230\u7684\u5251\u4E0E\u76FE\\n\u4E0E\u88AB\u79F0\u4E3A\u5251\u4E0E\u76FE\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u6E10\u6E10\u88AB\u4EBA\u4EEC\u6DF7\u6DC6\u2026\u2026\\n\u7136\u540E\u5728\u5386\u53F2\u4E2D\u9500\u58F0\u533F\u8FF9\u4E86\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u5176\u5B9E\u82F1\u96C4\u662F\u4E24\u4E2A\u5E74\u8F7B\u4EBA\u2026\u2026\\c\\n\u5251\u548C\u76FE\u90FD\u662F\u5B9D\u53EF\u68A6\u3002\\c\\n\u4F46\u662F\uFF0C\u4F20\u627F\u5386\u53F2\u771F\u76F8\u7684\u9057\u8FF9\u5374\u88AB\\n\u85CF\u5728\u827A\u672F\u6C14\u606F\u6D53\u539A\u7684\u58C1\u753B\u4E4B\u4E0B\u3002\\r\\n\u8FD9\u7A76\u7ADF\u662F\u600E\u4E48\u56DE\u4E8B\uFF1F[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8C22\u8C22\uFF01\u591A\u4E8F\u4E86\u4F60\uFF0C\\n\u6211\u53EF\u80FD\u6709\u4E86\u4E2A\u5927\u53D1\u73B0\uFF01\\c\\n\u4F60\u63A5\u4E0B\u6765\u7684\u9053\u9986\u6311\u6218\u5728\u821E\u59FF\u9547\u5427\uFF1F\\n\u6765\uFF0C\u518D\u628A\u8FD9\u4E2A\u5206\u4F60\u4E00\u4E9B\uFF0C\\r\\n\u4F60\u4E5F\u8981\u52A0\u6CB9\u554A\uFF01[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5386\u53F2\u7684\u771F\u76F8\u7ADF\u7136\u4F1A\\n\u85CF\u5728\u827A\u672F\u6C14\u606F\u6D53\u539A\u7684\u58C1\u753B\u4E4B\u4E0B\u2026\u2026\\r\\n\u6211\u8FD8\u8981\u518D\u6DF1\u5165\u8C03\u67E5\u4E0B\u624D\u884C\u3002[VAR 0114(000B)]"
  }
]
