    "text": "\u54CE\u54DF\uFF01\\n\u8FD9\u4E0D\u662F\u6211\u4EEC\u961F\u957F\u5417\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u770B\u770B\uFF0C\u6211\u8FD9\u513F\u7EC8\u4E8E\u80FD\u8DDF\\n\u5C0F\u590F\u590F\u4EAB\u53D7\u4E00\u4E0B\u4EB2\u5B50\u65F6\u5149\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5565\uFF1F\u4F60\u8BF4\u6211\u79BB\u5F00\u57FA\u5730\u7684\u65F6\u5019\\n\u6389\u4E86\u4E00\u4EFD\u7B14\u8BB0\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u8EAB\u4E0A\u5E26\u7740\u90A3\u79CD\u7B14\u8BB0\u6765\u7740\u5417\u2026\u2026\uFF1F\\n\u600E\u4E48\u4E00\u70B9\u5370\u8C61\u4E5F\u6CA1\u6709\u3002[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u54CE\uFF1F\u4F60\u770B\u90A3\u7B14\u8BB0\u4E0A\\n\u62CD\u5230\u7684\u5730\u65B9\u2026\u2026\\r\\n\u4E0D\u5C31\u662F\u8FD9\u513F\uFF0C\u6781\u5DE8\u5DE2\u7A74\u5417\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u545C\u54C7\uFF5E\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u55EF\uFF1F[VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u53D1\u751F\u4EC0\u4E48\u4E8B\u60C5\u4E86\uFF01\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u521A\u624D\uFF0C\u5728\u6781\u5DE8\u5DE2\u7A74\u7684\u6DF1\u5904\u2026\u2026\uFF01\\c\\n\u51FA\u73B0\u4E86\u597D\u591A\u597D\u591A\\n\u4E0D\u77E5\u662F\u4E0D\u662F\u5B9D\u53EF\u68A6\u7684\u8BE1\u5F02\u751F\u7269\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4F60\u8BF4\u4EC0\u4E48\uFF01\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u679C\u7136\u662F\u7531\u4E8E\u67D0\u79CD\u5F71\u54CD\uFF0C\\n\u8BA9\u522B\u7684\u4E16\u754C\u7684\u751F\u6001\u7CFB\u2026\u2026\uFF1F\\c\\n\u524D\u4E0D\u4E45\u51FA\u73B0\u4E00\u77AC\u95F4\u7684\u7A76\u6781\u4E4B\u6D1E\uFF0C\\n\u548C\u8FD9\u4E8B\u6709\u5173\u5417\u2026\u2026\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u54CE\uFF5E\u5440\uFF0C\\n\u611F\u89C9\u51FA\u5927\u4E8B\u513F\u4E86\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u961F\u957F\uFF0C\u8FD9\u4E5F\u5C31\u662F\u8BF4\u554A\uFF01\\n\u53EF\u80FD\u53C8\u6709\u65B0\u7684\u63A2\u9669\\r\\n\u5728\u7B49\u7740\u4F60\u54EA\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u8981\u7ED9\u8FD9\u4E2A\u63A2\u9669\\n\u53D6\u4E2A\u540D\u5B57\u7684\u8BDD\uFF0C\u5C31\u5B83\u5566\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54C8\uFF01\u54C8\uFF01\u597D\uFF5E\u73A9\u5427\uFF01[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u603B\u4E4B\u554A\uFF01\u76EE\u6807\u662F\u5148\u6349\u5230\\n\u90A3\u7B14\u8BB0\u4E0A\u62CD\u5230\u7684\u2026\u2026\u5B9D\u53EF\u68A6\uFF1F\\r\\n\u536F\u8DB3\u5E72\u52B2\u53BB\u5927\u5192\u9669\u5427\uFF01[VAR 0114(0076)]"
  }
