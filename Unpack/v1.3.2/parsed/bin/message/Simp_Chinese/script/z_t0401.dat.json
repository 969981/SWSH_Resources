[
  {
    "index": 0,
    "flags": 0,
    "text": "[~ 0]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6240\u8C13\u8D2D\u7269\u7684\u672C\u8D28\uFF0C\\n\u5C31\u662F\u7EA0\u7ED3\u548C\u72B9\u8C6B\u7684\u8FC7\u7A0B\u554A\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u53EA\u8981\u4ECE\u73B0\u5728\u8D77\uFF0C\u6293\u7D27\u6BCF\u5206\u6BCF\u79D2\u953B\u70BC\u81EA\u5DF1\uFF0C\\n\u7B49\u5230\u53BB\u9053\u9986\u6311\u6218\u7684\u65F6\u5019\u5C31\u6E38\u5203\u6709\u4F59\u5566\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u55B5\u55B5\u5657\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E3A\u4EC0\u4E48\u9732\u7483\u5A1C\u2026\u2026\\n\u4F1A\u559C\u6B22\u706F\u5854\u5462\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u56E0\u4E3A\u4F3D\u52D2\u5C14\u662F\u4E2A\u5DE8\u5927\u7684\u5C9B\u5C7F\u561B\u3002\\c\\n\u65E0\u8BBA\u662F\u4EE5\u524D\u8FD8\u662F\u73B0\u5728\uFF0C\\n\u7ED9\u6765\u5F80\u8239\u53EA\u6307\u5F15\u65B9\u5411\u7684\u706F\u5854\u90FD\u662F\u4E0D\u53EF\u6216\u7F3A\u7684\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5982\u679C\u5728\u65F7\u91CE\u5730\u5E26\u9493\u9C7C\u65F6\uFF0C\\n\u9047\u5230\u5DE8\u5927\u7684\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u611F\u89C9\u5C31\u7B97\u786C\u7740\u5934\u76AE\u4E5F\u8981\u6253\u4E00\u573A\u5440\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9732\u7483\u5A1C\u53EF\u662F\u4E2A\u81EA\u5F8B\u7684\u4EBA\uFF0C\\n\u6240\u4EE5\u5BF9\u9053\u9986\u4EFB\u52A1\u8981\u6C42\u4E5F\u5F88\u4E25\u683C\u54E6\uFF01"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6311\u6218\u9053\u9986\u554A\u2026\u2026\u8FD9\u8BA9\u6211\u60F3\u8D77\\n\u6211\u6CA1\u80FD\u62FF\u5230\u6C34\u4E4B\u5FBD\u7AE0\uFF0C\u5509\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u5F88\u770B\u597D\u4F60\u54E6\uFF01\\n\u4E0D\u8FC7\u5176\u5B9E\u6211\u5BF9\u6BCF\u4E2A\u4EBA\u90FD\u8FD9\u4E48\u8BF4\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u521A\u91C7\u6458\u7684\u852C\u83DC\uFF01\u770B\u7740\u591A\u65B0\u9C9C\u5440\uFF1F\\n\u521A\u91C7\u6458\u7684\u6811\u679C\uFF01\u770B\u8D77\u6765\u5F88\u597D\u5403\uFF0C\u662F\u5427\uFF1F"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u5927\u5BB6\u4E00\u8D77\u505A\u7684\u6599\u7406\uFF0C\\n\u5C31\u7B97\u5931\u8D25\u4E86\u4E5F\u662F\u4E00\u4EF6\u8DA3\u4E8B\u554A\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u7B2C\u4E8C\u77FF\u5C71\u662F\u4E2A\u597D\u5730\u65B9\uFF01\\n\u90A3\u91CC\u6709\u597D\u591A\u575A\u786C\u7684\u5B9D\u53EF\u68A6\u54E6\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5440\uFF5E\u543C\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6D1B\u5179\u4F1A\u957F\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8BF7\u7ED9\u6211\u7B7E\u4E2A\u540D\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8981\u8D62\u9732\u7483\u5A1C\u53EF\u4E0D\u5BB9\u6613\u554A\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5C45\u7136\u80FD\u6253\u8D25\u9732\u7483\u5A1C\uFF0C\\n\u771F\u662F\u4E2A\u4E86\u4E0D\u8D77\u7684\u8BAD\u7EC3\u5BB6\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u65E0\u6781\u6C70\u90A3\u2026\u2026\\n\u90A3\u662F\u4EC0\u4E48\u5440\uFF01\uFF1F"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6211\u8981\u52A0\u6CB9\u5F80\u524D\u8D70\uFF01\\n\u4E0D\u8BBA\u5929\u6DAF\u6D77\u89D2\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u9732\u7483\u5A1C\u641C\u7F57\u6765\u7684\\n\u98DF\u6750\u771F\u597D\u554A\u3002"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u4E5F\u8981\u5411\u7740\u51A0\u519B\u52AA\u529B\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4EC0\u4E48\u90FD\u9493\u4E0D\u5230\u2026\u2026"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u8981\u4E0D\u8981\u53BB\u65F7\u91CE\u5730\u5E26\\n\u9493\u9493\u9C7C\u5462\u2026\u2026"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6709\u6CA1\u6709\u4EC0\u4E48\\n\u9493\u9C7C\u7684\u597D\u5730\u65B9\u5462\uFF1F"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6211\u62FF\u5230\u4F1A\u957F\u7684\u7B7E\u540D\u5566\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8981\u4E0D\u5C31\u987A\u4FBF\u53BB\\n\u9632\u6CE2\u4EAD\u6D77\u9C9C\u9910\u5385\u5403\u4E2A\u996D\u5427\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u6D77\u98CE\u8FCE\u9762\u5439\u6765\u2026\u2026\\n\u4EE4\u4EBA\u5FC3\u60C5\u8212\u7545\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u8BF4\u5230\u6C34\u821F\u9547\u7684\u7279\u4EA7\u2026\u2026"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6D77\u9C9C\u771F\u597D\u5403\uFF0C\\n\u4E0D\u81EA\u89C9\u5730\u62FF\u6765\u505A\u914D\u83DC\u4E86\u3002"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u8981\u4E0D\u7D22\u6027\u4EE5\u540E\u5C31\u4F4F\u5728\u8FD9\u5427\u3002"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u4F60\u597D\u554A\uFF0C\\n\u9053\u9986\u6311\u6218\u8005\u3002"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u606D\u559C\u4F60\u62FF\u5230\u6C34\u4E4B\u5FBD\u7AE0\u3002"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\u4F60\u597D\uFF0C\u51A0\u519B\uFF01"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\u8BF4\u8D77\u9732\u7483\u5A1C,\\n\u9A6C\u4E0A\u5C31\u4F1A\u60F3\u5230\u706F\u5854\u5427\u3002"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\u5450\u558A\u961F\uFF1F\\n\u90A3\u662F\u4EC0\u4E48\u5440\uFF01"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\u540D\u4FA6\u63A2\u5B9D\u53EF\u68A6\\n\u662F\u4E0D\u662F\u771F\u7684\u5B58\u5728\u554A\uFF1F"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\u597D\u50CF\u662F\u5BB6\u80FD\u6DD8\u5230\u7A00\u7F55\u8D27\u7684\u97F3\u50CF\u5E97\u3002"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "[~ 38]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u7684\u77F3\u50CF\u3002\\n\u4F20\u8BF4\u4E2D\u662F\u5B83\u4EEC\u4FDD\u62A4\u4E86\u8FD9\u91CC\u7684\u706F\u5854\u3002"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\u5409\u54BF\u54BF\uFF5E"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\u8D1D\u8D1D\u55EF\uFF5E"
  },
  {
    "index": 42,
