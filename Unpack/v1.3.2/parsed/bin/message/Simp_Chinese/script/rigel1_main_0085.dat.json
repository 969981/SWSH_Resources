    "text": "\u53EA\u6709\u4F60\u4E00\u4E2A\u4EBA\u662F\\n\u521A\u5230\u94E0\u5C9B\u6765\u7740\u5462\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5230\u54EA\u513F\u624D\u80FD\u627E\u5230\u6781\u5DE8\u83C7\u83C7\uFF0C\\n\u4F30\u8BA1\u4F60\u4E00\u70B9\u5934\u7EEA\u4E5F\u6CA1\u6709\u5427\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8001\u5934\u513F\u6211\u6B63\u597D\u6563\u6563\u6B65\uFF0C\\n\u987A\u4FBF\u7ED9\u4F60\u5E26\u4E2A\u8DEF\u5427\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8D70\u3001\u8D70\u3001\u8D70\u8D70\u8D70\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8981\u662F\u653E\u5728\u5E73\u65F6\uFF0C\u8FD9\u7247\u4E13\u6CE8\u68EE\u6797\u91CC\\n\u662F\u6709\u5F88\u591A\u6781\u5DE8\u83C7\u83C7\u7684\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u554A\uFF0C\u524D\u4E00\u9635\u5B50\uFF0C\u5927\u7FA4\u7684\u85CF\u9971\u6817\u9F20\\n\u8DD1\u5230\u8FD9\u91CC\u6765\uFF0C\u628A\u6781\u5DE8\u83C7\u83C7\u5403\u4E86\u4E2A\u7CBE\u5149\uFF5E[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5982\u679C\u7A7F\u8FC7\u68EE\u6797\uFF0C\\n\u8D70\u5230\u53E6\u4E00\u4FA7\u7684[VAR FF00(0006)]\u70ED\u8EAB\u6D1E\u7A74[VAR FF00(0000)]\u91CC\uFF0C\\r\\n\u8BF4\u4E0D\u5B9A\u8FD8\u80FD\u627E\u5230\u4E00\u4E9B\u6781\u5DE8\u83C7\u83C7\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5728\u68EE\u6797\u91CC\u5BB9\u6613\u8FF7\u8DEF\uFF0C\\n\u4F60\u53EF\u5F97\u4E00\u8DEF\u5C0F\u5FC3\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u90A3\uFF0C\u91C7\u6781\u5DE8\u83C7\u83C7\u7684\u4EFB\u52A1\uFF0C\\n\u5C31\u62DC\u6258\u4F60\u565C\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u554A\uFF01\u6781\u5DE8\u83C7\u83C7\uFF01\\c\\n\u2026\u2026\u4EC0\u4E48\u554A\uFF0C\u4ED4\u7EC6\u4E00\u770B\uFF0C\\n\u8FD9\u4E0D\u662F[VAR 0100(0000)]\u5417\u3002\\r\\n\u5C11\u6765\u6DF7\u6DC6\u89C6\u542C\u554A\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u6211\u5728\u4E13\u6CE8\u68EE\u6797\u91CC\\n\u627E\u4E0D\u5230\u6781\u5DE8\u83C7\u83C7\u2026\u2026\\r\\n\u96BE\u9053\u5B83\u4EEC\u957F\u5728\u522B\u7684\u5730\u65B9\uFF1F"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E0D\u597D\uFF01\\c\\n\u70ED\u8EAB\u6D1E\u7A74\u4E0D\u5728\u8FD9\u8FB9\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8FD9\u8FB9\u597D\u50CF\u6CA1\u6709\u6781\u5DE8\u83C7\u83C7\u3002\\n\u6211\u8FD8\u5F97\u518D\u953B\u70BC\u4E00\u4E0B\u81EA\u5DF1\u7684\u65B9\u5411\u611F\u554A\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u672C\u6765\u60F3\u53BB\u953B\u70BC\u5E73\u539F\u7684\uFF0C\\n\u8FD9\u662F\u8D70\u9519\u51FA\u53E3\u4E86\u5417\uFF1F"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8981\u662F\u6211\u628A\u54CE\u5440\u7403\u83C7\u5F53\u4F5C\u6781\u5DE8\u83C7\u83C7\u5E26\u56DE\u53BB\uFF0C\\n\u80AF\u5B9A\u4F1A\u7ACB\u9A6C\u8D25\u9732\u5427\uFF1F"
