    "text": "\u542C\u8BF4\u6D1B\u5179\u4F1A\u957F\u81EA\u9996\u4E86\uFF1F\\n\u592A\u51FA\u4E4E\u610F\u6599\u4E86\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u8FD9\u4E5F\u662F\u7406\u6240\u5F53\u7136\u7684\u554A\u3002\\n\u8C01\u8BA9\u4ED6\u5524\u9192\u65E0\u6781\u6C70\u90A3\uFF0C\\r\\n\u641E\u5F97\u5929\u4E0B\u5927\u4E71\u5462\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u8FD9\u51E0\u5929\u8FC7\u5F97\u600E\u4E48\u6837\u554A\uFF1F\\n\u603B\u4E4B\u6211\u7761\u5F97\u50CF\u70C2\u6CE5\u4E00\u6837\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u867D\u7136\u5927\u5BB6\u73B0\u5728\u8FD8\u5728\u8BAE\u8BBA\u7EB7\u7EB7\uFF0C\\n\u4F46\u597D\u5728\u4E8B\u4EF6\u5DF2\u7ECF\u89E3\u51B3\u4E86\uFF01\\c\\n\u591A\u4E8F\u6709\u85CF\u739B\u7136\u7279\u548C\u82CD\u54CD\uFF0C\\n\u6211\u4EEC\u624D\u80FD\u6253\u8D25\u65E0\u6781\u6C70\u90A3\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5927\u54E5\u8FD9\u5BB6\u4F19\u4E5F\u662F\uFF0C\\n\u5C31\u77E5\u9053\u901E\u5F3A\uFF0C\\r\\n\u8BF4\u4EC0\u4E48\u4E00\u5B9A\u8981\u53C2\u52A0\u51A0\u519B\u8D5B\u3002\\c\\n\u4ED6\u90FD\u4E0D\u7BA1\u81EA\u5DF1\u53D7\u91CD\u4F24\u660F\u8FC7\u53BB\u7684\u4E8B\uFF0C\\n\u7B80\u76F4\u662F\u80E1\u6765\u561B\u3002[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4E0D\u8FC7\uFF0C\u5927\u54E5\u7684\u5FC3\u60C5\\n\u6211\u4E5F\u53EF\u4EE5\u7406\u89E3\u5C31\u662F\u4E86\u3002\\c\\n\u56E0\u4E3A\u80FD\u548C[VAR 0100(0000)]\u4F60\u51B3\u4E00\u80DC\u8D1F\uFF0C\\n\u786E\u5B9E\u8BA9\u4EBA\u6309\u637A\u4E0D\u4F4F\u554A\u3002[VAR 0114(0005)]"
  },
