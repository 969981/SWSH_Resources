    "index": 0,
    "flags": 0,
    "text": "\u6B22\u8FCE\u4F60\u4EEC\u6765\u5230\u6D1B\u5179\u4F1A\u957F\\n\u79BB\u5730\uFF13\uFF10\uFF10\u7C73\u9AD8\u7684\u5C0A\u8D35\u79C1\u4EBA\u7A7A\u95F4\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u7279\u610F\u5B89\u6392\u4E86\u4E00\u4E9B\u53EA\u542C\u547D\u4E8E\u6211\u7684\\n\u7279\u522B\u804C\u5458\u53BB\u963B\u6B62\u4F60\u4EEC\uFF0C\\r\\n\u800C\u4F60\u4EEC\u5374\u82E5\u65E0\u5176\u4E8B\u5730\u95EF\u4E86\u8FDB\u6765\u2026\u2026\\c\\n\u51A0\u519B\u4E39\u5E1D\u63A8\u8350\u7684\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\\n\u771F\u662F\u4E0D\u53EF\u5C0F\u89D1\u5462\u3002[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u554A\uFF0C\u4E5F\u5C31\u5230\u6B64\u4E3A\u6B62\u4E86\u3002\\n\u6211\u8FD8\u662F\u8981\u8BF7\u4F60\u4EEC\u6253\u9053\u56DE\u5E9C\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u56E0\u4E3A\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u53EA\u8981\u6709\u6211\u5728\uFF0C\\n\u4EFB\u4F55\u4EBA\u90FD\u4F11\u60F3\u59A8\u788D\u6D1B\u5179\u4F1A\u957F\u7684\u8BA1\u5212\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u9996\u5148\u662F\u4F60\uFF0C[VAR 0100(0000)]\uFF01\\c\\n\u53EA\u8981\u6211\u628A\u4F60\u5F7B\u5E95\u6467\u6BC1\uFF0C\\n\u51A0\u519B\u5C31\u4F1A\u653E\u5F03\u5BF9\u4F60\u7684\u671F\u5F85\uFF0C\\r\\n\u4E56\u4E56\u5730\u542C\u4F1A\u957F\u7684\u8BDD\u4E86\uFF01[VAR 0114(0007)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u54CE\u5440\u5440\u2026\u2026\uFF01\\n\u600E\u4E48\u4F1A\u8FD9\u6837\u2026\u2026\\c\\n\u4E0D\u6127\u662F\u4E00\u8DEF\u8D62\u4E0B\u6765\u7684\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u6211\u592A\u5C0F\u770B\u4F60\u7684\u5B9E\u529B\u4E86\u2026\u2026[VAR 0114(0007)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u8BF4\u5B9E\u8BDD\uFF0C\\n\u6211\u8FD8\u4E0D\u60F3\u5C31\u8FD9\u4E48\u653E\u8FC7\u4F60\u2026\u2026\\c\\n\u4F46\u53CD\u6B63\u8BB8\u613F\u661F\u6211\u4EEC\u5DF2\u7ECF\u6536\u96C6\u591F\u4E86\uFF0C\\n\u4F60\u60F3\u505A\u4EC0\u4E48\u90FD\u65E0\u59A8\uFF0C\u8BF7\u4FBF\u5427\u3002[VAR 0114(0007)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF0C\u4F60\u679C\u7136\u5389\u5BB3\uFF01\\n\u4F60\u628A[VAR 0101(0001)]\u7684\u5B9E\u529B\\r\\n\u53D1\u6325\u5F97\u6DCB\u6F13\u5C3D\u81F4\u554A\uFF01[VAR 0114(0005)]"
  },
