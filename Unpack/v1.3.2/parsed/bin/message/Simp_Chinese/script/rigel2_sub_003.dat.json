    "text": "\u90A3\u4E2A\u7814\u7A76\u5458\u59D0\u59D0\\n\u4EE5\u524D\u5012\u662F\u8BF4\u8FC7\u2026\u2026\\c\\n\u8FD9\u91CC\u7B2C\u4E00\u4E2A\u88AB\u53D1\u73B0\u7684\\n\u4F20\u8BF4\u5B9D\u53EF\u68A6\uFF0C\\r\\n\u636E\u8BF4\u662F[VAR 0101(0000)]\u54E6\u3002[VAR 0114(0078)]"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\u542C\u8BF4\u7814\u7A76\u5458\u59D0\u59D0\u4EE5\u524D\u662F\u5728\\n\u963F\u7F57\u62C9\u5730\u533A\u7684\u7814\u7A76\u6240\u5DE5\u4F5C\u3002\\c\\n\u963F\u7F57\u62C9\uFF01\u6211\u597D\u60F3\u53BB\u54E6\uFF5E\uFF01\\n\u9A6C\u62C9\u8428\u8FBE\u80FD\u8BA9\u6211\u5403\u4E2A\u591F\u5462\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\u6211\u8D85\uFF5E\u60F3\u7ED9\u6211\u7684\u5B9D\u8D1D\u602A\u989A\u9F99\\n\u4F7F\u7528\u7279\u6027\u818F\u836F\u5462\u3002\\r\\n\u8C01\u8BA9\u5B83\u7684\u53CC\u5203\u5934\u9524\u90A3\uFF5E\u4E48\u52B2\u7206\u5462\uFF01[VAR 0114(0078)]"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\u6781\u5DE8\u5927\u5192\u9669\u7684\u7A8D\u95E8\uFF1F\\c\\n\u4F7F\u7528\u53CD\u5C04\u58C1\u6216\u8005\u5149\u5899\u4E4B\u7C7B\\n\u80FD\u51CF\u5C11\u4F24\u5BB3\u7684\u62DB\u5F0F\u662F\u5F88\u91CD\u8981\u7684\u5427\uFF1F[VAR 0114(0078)]"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\u6781\u5DE8\u5927\u5192\u9669\u7684\u7A8D\u95E8\uFF1F\\c\\n\u4ED4\u7EC6\u89C2\u5BDF\u5F85\u5728\u6DF1\u5904\u7684\u5B9D\u53EF\u68A6\\n\u53D1\u51FA\u7684\u662F\u4EC0\u4E48\u5C5E\u6027\u7684\u53CD\u5E94\uFF01\u4E4B\u7C7B\u7684\uFF1F[VAR 0114(0078)]"
