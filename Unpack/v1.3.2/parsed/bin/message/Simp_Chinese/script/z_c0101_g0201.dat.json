[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\uFF01\\c\\n\u8981\u60F3\u6311\u6218\u5361\u829C\uFF0C\\n\u4F60\u5FC5\u987B\u5148\u62FF\u5230\u8349\u8DEF\u9547\u7684\u8349\u4E4B\u5FBD\u7AE0\uFF0C\\r\\n\u4EE5\u53CA\u6C34\u821F\u9547\u7684\u6C34\u4E4B\u5FBD\u7AE0\u54E6\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54E6\uFF01\u9053\u9986\u6311\u6218\u8005\uFF01\\n\u4F60\u6709\uFF12\u679A\u5FBD\u7AE0\uFF0C\u771F\u4E86\u4E0D\u8D77\uFF01\\c\\n\u4E0D\u8FC7\uFF0C\u5361\u829C\u597D\u50CF\u6B63\u5728\\n\u7B2C\u4E8C\u77FF\u5C71\u7279\u8BAD\u5462\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u54CE\u5440\u2026\u2026\u4ECA\u5929\u65F6\u95F4\u5DF2\u7ECF\u665A\u4E86\uFF0C\\n\u8BF7\u660E\u5929\u518D\u6765\u5427\u3002\\c\\n\u53EA\u8981\u662F\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u90FD\u53EF\u4EE5\u4F4F\u5728\u542B\u7F9E\u82DE\u65C5\u5E97\u54E6\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u540C\u4E3A\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u6211\u4EEC\u5C31\u7AED\u5C3D\u5168\u529B\u62FC\u640F\u5427\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u9996\u5148\u5F97\u53BB\u8349\u8DEF\u9547\uFF01\\n\u51FA\u53D1\u5427\uFF0C\u5411\u7740\uFF13\u53F7\u9053\u8DEF\u524D\u8FDB\uFF01"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u597D\u4E0D\u5BB9\u6613\u8D70\u5230\u4ECA\u5929\u2026\u2026\\n\u5374\u7A81\u7136\u4E27\u5931\u4E86\u83B7\u80DC\u7684\u4FE1\u5FC3\u3002\\r\\n\u5509\uFF0C\u6211\u8BE5\u600E\u4E48\u529E\u554A\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u7684\u5B9D\u53EF\u68A6\u5728\u573A\u4E0A\\n\u771F\u7684\u975E\u5E38\u52AA\u529B\u5462\u2026\u2026\\c\\n\u770B\u4E86\u4F60\u7684\u6BD4\u8D5B\u540E\uFF0C\\n\u6211\u611F\u89C9\u81EA\u5DF1\u4E5F\u53D7\u5230\u4E86\u9F13\u821E\u3002"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u7684\u5F00\u5E55\u5F0F\u2026\u2026\\n\u6211\u5BB6\u4EBA\u4E5F\u4F1A\u5728\u7535\u89C6\u673A\u4E0A\u6536\u770B\u2026\u2026\\c\\n\u6211\u662F\u4E0D\u662F\u5E94\u8BE5\u518D\u53BB\u7167\u7167\u955C\u5B50\uFF0C\\n\u770B\u770B\u53D1\u578B\u6709\u6CA1\u6709\u4E71\u554A\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u542C\u4E86\u6D1B\u5179\u4F1A\u957F\u7684\u81F4\u8F9E\u2026\u2026\\n\u7A81\u7136\u611F\u89C9\u81EA\u5DF1\u5145\u6EE1\u4E86\u5E72\u52B2\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8349\u4E4B\u5FBD\u7AE0\u2026\u2026\u6C34\u4E4B\u5FBD\u7AE0\u2026\u2026\\n\u4E0D\u77E5\u9053\u63A5\u4E0B\u6765\u80FD\u4E0D\u80FD\u62FF\u5230\u706B\u4E4B\u5FBD\u7AE0\u5462\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u4F60\u6253\u8D25\u4E86\u5361\u829C\uFF01\uFF1F\\n\u771F\u662F\u4E2A\u4E86\u4E0D\u8D77\u7684\u8BAD\u7EC3\u5BB6\u3002\\c\\n\u4EE5\u540E\u53EF\u80FD\u4F1A\u6709\u5176\u4ED6\u7684\u9053\u9986\u6311\u6218\u8005\\n\u6765\u627E\u4F60\u5207\u78CB\u54E6\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u542C\u8BF4\u8FD9\u6B21\u53C2\u52A0\u5927\u8D5B\u7684\\n\u4F17\u591A\u9053\u9986\u6311\u6218\u8005\u4E2D\uFF0C\\r\\n\u6709\u7684\u4EBA\u662F\u7531\u4F1A\u957F\u548C\u51A0\u519B\u63A8\u8350\u6765\u7684\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8981\u6536\u96C6\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u2026\u2026\\n\u8FD9\u542C\u8D77\u6765\u5C31\u50CF\u662F\u6536\u96C6\u5B9D\u85CF\u4E00\u6837\u554A\uFF01\\c\\n\u548C\u9053\u9986\u9986\u4E3B\u7684\u8F83\u91CF\uFF0C\\n\u5230\u5E95\u4F1A\u662F\u4EC0\u4E48\u6837\u7684\u5462\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u662F\u4E39\u5E1D\u63A8\u8350\u6765\u7684\\n\u9053\u9986\u6311\u6218\u8005\u554A\u3002\\r\\n\u5C45\u7136\u6709\u80C6\u91CF\u6311\u6218\u5361\u829C\uFF0C\u679C\u7136\u5389\u5BB3\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u80FD\u591F\u6167\u773C\u8BC6\u73E0\uFF0C\\n\u53D1\u6398\u51FA\u4F60\u7684\u624D\u80FD\u8FD8\u63A8\u8350\u4E86\u4F60\uFF0C\\c\\n\u4E0D\u6127\u662F\u4E39\u5E1D\uFF0C\u771F\u6709\u773C\u5149\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u8FD9\u8BE5\u5982\u4F55\u662F\u597D\uFF0C\\n\u5F00\u5E55\u5F0F\u90FD\u8FD8\u6CA1\u5F00\u59CB\u6211\u5C31\u7D27\u5F20\u5F97\u53D1\u6296\u2026\u2026\\c\\n\u6211\u7CBE\u7075\u7403\u91CC\u7684\u5B9D\u53EF\u68A6\\n\u90FD\u8FD8\u4E00\u4E2A\u4E2A\u5E72\u52B2\u5341\u8DB3\u5462\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u7EC8\u4E8E\u6765\u5230\u4E86\u6211\u61A7\u61AC\u5DF2\u4E45\u7684\u7ADE\u6280\u573A\u2026\u2026\\n\u63A5\u4E0B\u6765\u6211\u8981\u7AD9\u4E0A\u5BF9\u6218\u573A\uFF01\\c\\n\u4E0D\uFF0C\u6211\u8981\u53D6\u5F97\u80DC\u5229\uFF0C\\n\u8BA9\u5927\u5BB6\u90FD\u56E0\u6211\u800C\u6B22\u547C\u96C0\u8DC3\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u867D\u7136\u53C2\u8D5B\u8005\u4F17\u591A\uFF0C\\n\u4F46\u80FD\u591F\u7559\u5230\u6700\u540E\u7684\u5374\u5BE5\u5BE5\u65E0\u51E0\u2026\u2026"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u80FD\u89C1\u5230\u51A0\u519B\u5C31\u5DF2\u7ECF\u5F88\u6EE1\u8DB3\u4E86\u2026\u2026\\n\u4E0D\uFF0C\u4E0D\u662F\u7684\uFF0C\u6211\u7684\u76EE\u6807\u662F\u6253\u8D25\u51A0\u519B\u3002"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u7EC8\u4E8E\u62C9\u5F00\u5E37\u5E55\u4E86\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u597D\u561E\uFF01\u53BB\uFF13\u53F7\u9053\u8DEF\\n\u597D\u597D\u953B\u70BC\u4E00\u4E0B\u5B9D\u53EF\u68A6\u5427\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u6211\u51C6\u5907\u53BB\u6311\u6218\\n\u706B\u5C5E\u6027\u9053\u9986\u9986\u4E3B\u5361\u829C\u3002"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u8FD8\u6CA1\u6709\u7ED3\u675F\u5462\uFF0C\\n\u7EE7\u7EED\u52A0\u6CB9\u5427\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5927\u5BB6\u80FD\u4E0D\u80FD\u5728\u8FD9\u7D27\u5F20\u7684\\n\u6BD4\u8D5B\u6C1B\u56F4\u91CC\u8131\u9896\u800C\u51FA\u5462\uFF1F"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u80FD\u7B11\u5230\u6700\u540E\u7684\uFF0C\\n\u4E00\u5B9A\u662F\u6211\u5427\u3002"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u6709\u597D\u51E0\u4E2A\u6311\u6218\u8005\\n\u7279\u522B\u96BE\u7F20\u5462\u3002"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8FD9\u9053\u9986\u6311\u6218\u8005\u7684\u6570\u91CF\\n\u8FDC\u8FDC\u8D85\u51FA\u4E86\u6211\u7684\u60F3\u8C61\u554A\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u55EF\u2026\u2026\u5927\u5BB6\u90FD\u662F\u6311\u6218\u8005\u554A\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u5927\u5BB6\u8981\u987D\u5F3A\u5730\u7559\u5230\u6700\u540E\u554A\uFF0C\\n\u6BD5\u7ADF\u90FD\u662F\u60FA\u60FA\u76F8\u60DC\u7684\u5BF9\u624B\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u545C\u5566\u5566\u266A"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u975E\u5E38\u62B1\u6B49\u3002\\c\\n\u4ECE\u8FD9\u91CC\u5F00\u59CB\uFF0C\u53EA\u6709\u6311\u6218\\n\u9053\u9986\u4EFB\u52A1\u7684\u9009\u624B\u624D\u53EF\u4EE5\u8FDB\u5165\u3002"
  },
