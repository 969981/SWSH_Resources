  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u554A\uFF0C\u4F60\u7684\u540C\u884C\u961F\u4F0D\u91CC\u6709\u5446\u5446\u517D\uFF01\\c\\n\u770B\u6765\u4F60\u5F88\u559C\u6B22\u5446\u5446\u517D\u5462\uFF5E\\n\u90A3\uFF0C\u6211\u60F3\u4F60\u5E94\u8BE5\u4E5F\u4F1A\u559C\u6B22\u8FD9\u4EF6T\u6064\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u554A\uFF0C\u4F60\u7684\u540C\u884C\u961F\u4F0D\u91CC\u6709\u5446\u5446\u517D\uFF01\\c\\n\u5176\u4ED6\u5730\u533A\u7684\u5446\u5446\u517D\u4E5F\u5446\u5934\u5446\u8111\u7684\uFF0C\\n\u8D85\u53EF\u7231\u5462\uFF0C\u5BF9\u5427\uFF5E"
