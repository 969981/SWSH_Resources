[
  {
    "index": 0,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\u554A\uFF0C\\n\u6211\u606D\u5019\u4F60\u591A\u65F6\u4E86\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u518D\u4ECB\u7ECD\u4E00\u4E0B\u81EA\u5DF1\u597D\u4E86\uFF0C\u6211\u662F\u9732\u7483\u5A1C\u3002\\n\u521A\u624D\u8FD8\u8BA9\u4F60\u7279\u5730\u6765\u627E\u6211\uFF0C\u771F\u662F\u62B1\u6B49\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E0D\u662F\u6211\u5938\u5927\u5176\u8BCD\u2026\u2026\\n\u6211\u7684\u4EFB\u52A1\u771F\u7684\u4E0D\u7B80\u5355\uFF0C\\r\\n\u800C\u4F60\u5374\u987A\u5229\u5730\u5B8C\u6210\u4E86\u3002\\c\\n\u770B\u6765\u4F60\u2026\u2026\\n\u662F\u4E2A\u5934\u8111\u6E05\u6670\u7684\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F46\u662F\u4E0D\u7BA1\u4F60\u7528\u90A3\u806A\u660E\u7684\u5934\u8111\\n\u60F3\u51FA\u4EC0\u4E48\u6837\u7684\u6218\u672F\uFF0C\\c\\n\u6211\u548C\u6211\u53EF\u9760\u7684\u4F19\u4F34\u90FD\u4F1A\u5C06\u5B83\u51B2\u57AE\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u600E\u2026\u2026\uFF01\\n\u600E\u4E48\u4F1A\u8FD9\u6837\uFF01\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u547C\u2026\u2026\\n\u548C\u4F60\u4EEC\u4EA4\u624B\u4E4B\u540E\uFF0C\u6211\u660E\u767D\u4E86\u3002[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4F60\u548C\u4F60\u7684\u5B9D\u53EF\u68A6\\n\u62E5\u6709\u5F88\u68D2\u7684\u5BF9\u6218\u7CBE\u795E\u3002\\c\\n\u5B83\u8DB3\u4EE5\u8BA9\u4F60\u4EEC\u5728\u9053\u9986\u6311\u6218\u4E2D\u664B\u7EA7\uFF0C\\n\u83B7\u5F97\u6311\u6218\u51A0\u519B\u7684\u673A\u4F1A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u4EEC\u2026\u2026\\n\u7684\u786E\u6709\u8D44\u683C\u62FF\u5230\u8FD9\u679A\u5FBD\u7AE0\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u53EF\u4EE5\u6355\u6349\u7B49\u7EA7\uFF13\uFF10\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E0B\u4E00\u4E2A\u8981\u6311\u6218\u7684\u662F\\n\u706B\u5C5E\u6027\u7684\u9053\u9986\u9986\u4E3B\u5427\u3002\\c\\n\u4EE5\u4F60\u4EEC\u73B0\u5728\u7684\u5B9E\u529B\uFF0C\\n\u4ED6\u4E5F\u4F1A\u5F88\u613F\u610F\u4E0E\u4F60\u4EEC\u5BF9\u6218\u7684\u3002[VAR 0114(000F)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u4F60\u6218\u80DC\u9053\u9986\u9986\u4E3B\u9732\u7483\u5A1C\u4E86\u554A\u3002\\r\\n\u771F\u662F\u606D\u559C\u4F60\u4E86\u3002\\c\\n\u6536\u4E0B\u8FD9\u4E2A\u62DB\u5F0F\u5B66\u4E60\u5668\uFF0C\\n\u7559\u4F5C\u7EAA\u5FF5\u5427\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8FD9\u5957\u9732\u7483\u5A1C\u7684\u590D\u5236\u54C1\u7ADE\u6280\u670D\\n\u4E5F\u9001\u7ED9\u4F60\u4E86\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u4EEC\u8D62\u5F97\u6C34\u4E4B\u5FBD\u7AE0\u540E\uFF0C\\n\u8FD8\u80FD\u8D70\u591A\u8FDC\u5462\uFF1F\\r\\n\u6211\u4E5F\u4F1A\u62ED\u76EE\u4EE5\u5F85\u7684\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u6218\u80DC\u9053\u9986\u9986\u4E3B\u9732\u7483\u5A1C\u4E86\u554A\uFF01\\n\u771F\u662F\u606D\u559C\u4F60\u4E86\uFF01"
  },
