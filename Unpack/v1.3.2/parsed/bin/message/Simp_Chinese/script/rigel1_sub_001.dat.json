  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u7684\u94E0\u5C9B\u56FE\u9274\\n\u73B0\u5728\u7684\u5B8C\u6210\u5EA6\u662F\u2026\u2026"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u53D1\u73B0\u7684\u5B9D\u53EF\u68A6\u6709[VAR 0202(0000)]\u79CD\uFF01\\n\u6349\u5230\u7684\u5B9D\u53EF\u68A6\u6709[VAR 0202(0001)]\u79CD\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5475\u5475\uFF0C\u4F60\u7684\u94E0\u5C9B\u56FE\u9274\u624D\u521A\u521A\u5347\u7EA7\uFF01\\c\\n\u4ECE\u8FD9\u91CC\u5F00\u59CB\u624D\u662F\u5192\u9669\u7684\u7B2C\u4E00\u6B65\u5462\uFF01\\n\u52A0\u6CB9\u54E6\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u563F\u563F\uFF01\u867D\u7136\u4F60\u8FD8\u662F\u4E2A\u65B0\u624B\uFF0C\\n\u4F46\u6211\u80FD\u770B\u51FA\u4F60\u5F88\u52AA\u529B\uFF01\\c\\n\u8349\u4E1B\u6C99\u6C99\u4F5C\u54CD\u7740\u6643\u52A8\u8D77\u6765\u65F6\uFF0C\\n\u91CC\u9762\u4E5F\u8BB8\u5C31\u85CF\u7740\u7A00\u6709\u7684\u5B9D\u53EF\u68A6\u54E6\uFF01\uFF1F\\r\\n\u51B2\u554A\uFF01\u591A\u5230\u8349\u4E1B\u91CC\u53BB\u627E\u627E\u54E6\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4EC0\u4E48\uFF01\u5DF2\u7ECF\u6349\u5230\u8D85\u8FC7\uFF13\uFF10\u79CD\u5B9D\u53EF\u68A6\u4E86\uFF01\uFF1F\\n\u4F60\u5F88\u6709\u5929\u5206\u554A\uFF01\\c\\n\u6211\u60F3\u4F60\u80AF\u5B9A\u4E5F\u6709\u5728\\n\u597D\u597D\u57F9\u80B2\u90A3\u4E9B\u5B9D\u53EF\u68A6\uFF0C\u8BA9\u5B83\u4EEC\u8FDB\u5316\u5427\uFF1F\\r\\n\u90A3\u6837\u53EF\u4EE5\u5E2E\u4F60\u66F4\u5FEB\u586B\u6EE1\u5B9D\u53EF\u68A6\u56FE\u9274\u5462\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u90FD\u5DF2\u7ECF\u6349\u5230\uFF15\uFF10\u79CD\u5B9D\u53EF\u68A6\u4E86\uFF01\uFF1F\\n\u4E5F\u592A\u731B\u4E86\u5427\uFF01\\c\\n\u8FD9\u3001\u8FD9\u5927\u6982\u5DF2\u7ECF\u8D85\u8FC7\\n\u6574\u4F53\u7684\uFF14\u5206\u4E4B\uFF11\u4E86\u2026\u2026\uFF1F\\c\\n\u8981\u5728\u94E0\u5C9B\u4E0A\u7EE7\u7EED\u8F6C\u54E6\u3002\\n\u6BD4\u4E4B\u524D\u8FD8\u52AA\u529B\u5730\u8F6C\u54E6\u3002"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5929\u54EA\uFF01\u600E\u4E48\u4F1A\u6709\u8FD9\u4E48\u51FA\u7C7B\u62D4\u8403\u7684\u4EBA\u624D\uFF1F\\n\u770B\u6765\u8981\u6355\u6349\u5230\u8D85\u8FC7\uFF11\uFF10\uFF10\u79CD\u4E5F\u4E0D\u662F\u68A6\u4E86\u3002\\c\\n\u6211\u60F3\u4F60\u80AF\u5B9A\u6709\u53BB\u8C03\u67E5\u5B9D\u53EF\u68A6\u5DE2\u7A74\u5427\uFF1F\\n\u5728\u90A3\u91CC\u53EF\u4EE5\u9047\u5230\u7A00\u6709\u7684\u5B9D\u53EF\u68A6\u5462\u3002"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u54C7\uFF5E\u54E6\uFF01\u4F60\u5DF2\u7ECF\u6355\u6349\u5230\u8D85\u8FC7\uFF11\uFF10\uFF10\u79CD\u4E86\uFF01\\n\u6211\u8FDE\u505A\u68A6\u90FD\u4F1A\u68A6\u89C1\u8FD9\u4E00\u5E55\u5462\uFF01\\c\\n\u8FDB\u5EA6\u5927\u6982\u5DF2\u7ECF\u5230\u4E00\u534A\u5DE6\u53F3\u4E86\u5427\uFF01\uFF1F\\c\\n\u591A\u4E8F\u4E86\u4F60\uFF0C\\n\u6211\u7684\u7814\u7A76\u53D6\u5F97\u4E86\u5F88\u5927\u8FDB\u5C55\u5462\uFF01\\r\\n\u592A\u8C22\u8C22\u4F60\u4E86\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\c\\n\u554A\uFF01\u5BF9\u4E0D\u8D77\uFF01\\n\u9762\u5BF9\u7A7A\u767D\u5982\u6B64\u4E4B\u5C11\u7684\u56FE\u9274\uFF0C\\r\\n\u6211\u4E00\u4E0D\u5C0F\u5FC3\u5C31\u770B\u5165\u8FF7\u4E86\u2026\u2026\\c\\n\u5929\u554A\uFF5E\u4F60\u8BE5\u4E0D\u4F1A\u662F\\n\u771F\u7684\u8981\u628A\u56FE\u9274\u7ED9\u5B8C\u6210\u4E86\u5427\uFF1F\\c\\n\u6211\u770B\u4F60\u80AF\u5B9A\u4E5F\u77E5\u9053\u5929\u6C14\u4E0D\u540C\u65F6\uFF0C\\n\u53EF\u4EE5\u9047\u5230\u7684\u5B9D\u53EF\u68A6\u4E5F\u4F1A\u4E0D\u4E00\u6837\u3002"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5B8C\u6210\u5230\u8FD9\u4E2A\u7A0B\u5EA6\u7684\u94E0\u5C9B\u56FE\u9274\uFF0C\\n\u6211\u8FD8\u4ECE\u6765\u90FD\u6CA1\u89C1\u5230\u8FC7\u5462\uFF01\\c\\n\u4F60\u80FD\u505A\u5230\u8FD9\u4E2A\u4EFD\u513F\u4E0A\uFF0C\\n\u662F\u4E0D\u662F\u56E0\u4E3A\u9B54\u6CD5\u4EA4\u6362\u8FD0\u7528\u5F97\u7279\u522B\u597D\u554A\uFF1F\\c\\n\u6BD5\u7ADF\uFF0C\u4E00\u4E2A\u4EBA\u4E0D\u5BB9\u6613\u6536\u96C6\u5230\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u53EA\u8981\u548C\u522B\u4EBA\u5408\u4F5C\u5C31\u80FD\u987A\u5229\u641E\u5B9A\u4E86\u5462\u3002"
