    "text": "\u6211\u53EF\u662F\u4F60\u7684\u524D\u8F88\uFF5E\\n\u5E0C\u671B\u4F60\u80FD\u628A\u90A3\u4E9B\u6781\u5DE8\u83C7\u83C7\u8BA9\u7ED9\u6211\u8036\uFF5E[VAR 0114(0071)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6839\u636E\u5148\u77E5\u5148\u8D62\u7684\u539F\u5219\uFF0C\\n\u90A3\u51E0\u4E2A\u6781\u5DE8\u83C7\u83C7\u5E94\u8BE5\u8BA9\u7ED9\u6211\uFF01[VAR 0114(0072)]"
