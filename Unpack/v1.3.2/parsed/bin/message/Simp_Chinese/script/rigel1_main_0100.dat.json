  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5207\uFF01\\n\u6211\u5C31\u77E5\u9053\u4F60\u4F1A\u8FD9\u4E48\u8BF4\u2026\u2026[VAR 0114(0071)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u54FC\uFF0C\u4F60\u679C\u7136\u542C\u4E0D\u8FDB\u6211\u7684\u8BDD\u554A\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u90A3\u526F\u6DE1\u5B9A\u7684\u6837\u5B50\u662F\u4EC0\u4E48\u610F\u601D\u561B\uFF5E\uFF1F\\n\u4F60\u662F\u770B\u4E0D\u8D77\u4EBA\u5BB6\u5417\uFF5E\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8FD9\u5C31\u662F\u2026\u2026\u5F3A\u8005\u7684\u4ECE\u5BB9\u5417\uFF1F\\n\u771F\u662F\u6076\u5FC3\u5F97\u8BA9\u4EBA\u53CD\u9178\u6C34\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u4F60\u771F\u7684\u5F88\u788D\u4E8B\u8036\u2026\u2026\\n\u4E0D\u77E5\u9053\u662F\u4ECE\u54EA\u91CC\u7A81\u7136\u5192\u51FA\u6765\u7684\uFF0C\\r\\n\u504F\u504F\u8FD8\u8FD9\u4E48\u5E74\u8F7B\u6709\u5B9E\u529B\u2026\u2026[VAR 0114(0071)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F60\u771F\u7684\u788D\u4E8B\u81F3\u6781\uFF01\\n\u7A81\u7136\u51FA\u73B0\u5728\u6B66\u9986\uFF0C\\r\\n\u8FD8\u65E2\u5E74\u8F7B\u53C8\u6709\u5B9E\u529B\u2026\u2026[VAR 0114(0072)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u6253\u7B97\u6321\u4EBA\u5BB6\u7684\u8DEF\uFF0C\\n\u5C31\u522B\u602A\u6211\u7528\u8D85\uFF5E\u6076\u5FC3\u7684\u6BD2\u6765\u8150\u8680\u4F60\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u662F\u60F3\u6765\u963B\u6321\u6211\u7684\u524D\u9014\uFF0C\\n\u83AB\u602A\u6211\u7528\u8D85\u80FD\u529B\u62DB\u5F0F\u5C06\u4F60\u6253\u98DE\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u5624\u5624\u5624\uFF01\u600E\u4E48\u5C31\u662F\u8D62\u4E0D\u4E86\u4F60\u5462\uFF01\uFF1F\\n\u4EBA\u5BB6\u660E\u660E\u8D85\u7EA7\u52AA\u529B\u7684\u8BF4\uFF01\\r\\n\u5230\u5E95\u662F\u54EA\u91CC\u505A\u5F97\u8FD8\u4E0D\u591F\u561B\uFF5E\uFF01\uFF1F[VAR 0114(0071)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u53EF\u6076\uFF0C\u4E3A\u4EC0\u4E48\u6211\u6CA1\u529E\u6CD5\u83B7\u5F97\u80DC\u5229\uFF1F\\n\u6211\u7A76\u7ADF\u54EA\u91CC\u4E0D\u8DB3\u2026\u2026\uFF1F[VAR 0114(0072)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u8FD9\u6B21\u5C31\u8BA9\u7ED9\u4F60\u597D\u4E86\uFF01\\n\u4EBA\u5BB6\u4F1A\u627E\u5230\u66F4\u597D\u7684\u6781\u5DE8\u83C7\u83C7\u7684\uFF01[VAR 0114(0071)]"
  },
