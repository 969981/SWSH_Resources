    "text": "\u4EC0\u4E48\uFF01\uFF1F\uFF13\u4E2A\u6781\u5DE8\u83C7\u83C7\u5168\u957F\u5728\u4E00\u8D77\uFF01\uFF1F\\n\u8FD9\u5267\u60C5\u4E0D\u5BF9\u5440\uFF01\u5E94\u8BE5\u662F\u8981\u4E00\u4E2A\u4E00\u4E2A\u627E\u5427\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u5475\uFF01\u679C\u7136\u662F\u6709\u591A\u4E2A\\n\u6781\u5DE8\u83C7\u83C7\u8038\u7ACB\u4E8E\u6B64\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u5582\uFF5E\uFF01\\n\u90A3\u662F\u4EBA\u5BB6\u5148\u627E\u5230\u7684\u5566\uFF5E\uFF01\uFF01[VAR 0114(0071)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u90A3\u51E0\u4E2A\u6781\u5DE8\u83C7\u83C7\\n\u662F\u6211\u7528\u8D85\u80FD\u529B\u7387\u5148\u611F\u5E94\u5230\u7684\uFF01[VAR 0114(0072)]"
  },
  {
    "index": 9,
