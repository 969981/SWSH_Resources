[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8FDC\u5904\u9690\u9690\u7EA6\u7EA6\u80FD\u770B\u5230\u7684\\n\u90A3\u5EA7\u7D2B\u8272\u5C4B\u9876\u7684\u623F\u5B50\uFF0C\\r\\n\u5C31\u662F\u5B9D\u53EF\u68A6\u535A\u58EB\u7684\u4F4F\u5904\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u548C\u5B9D\u53EF\u68A6\u4E00\u8D77\u5403\u996D\uFF0C\\n\u611F\u89C9\u996D\u83DC\u90FD\u53D8\u5F97\u66F4\u53EF\u53E3\u4E86\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u542C\u8BF4\u4E39\u5E1D\u597D\u50CF\u8FD8\u6709\u4E2A\u5F1F\u5F1F\u2026\u2026\\c\\n\u4ED6\u5F1F\u5F1F\u4E00\u5B9A\u4E5F\u50CF\u4ED6\u4E00\u6837\uFF0C\\n\u662F\u4E00\u4F4D\u4F18\u79C0\u7684\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u5427\u3002"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u8FD9\u91CC\u786E\u5B9E\u662F\u4E2A\u5B81\u9759\u7684\u4E61\u6751\u5C0F\u9547\uFF0C\u6709\u673A\u4F1A\\n\u4F60\u53EF\u4EE5\u53BB\u57CE\u91CC\u770B\u770B\uFF0C\u80AF\u5B9A\u4F1A\u5927\u5403\u4E00\u60CA\u7684\u3002"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u8BA9\u5B9D\u53EF\u68A6\u5BF9\u6218\u53EF\u4EE5\u4F7F\u5B83\u4EEC\u53D8\u5F3A\u3002\\c\\n\u4F46\u662F\u901A\u8FC7\u600E\u6837\u7684\u65B9\u5F0F\u53BB\u57F9\u80B2\uFF0C\\n\u5C31\u5B8C\u5168\u53D6\u51B3\u4E8E\u8BAD\u7EC3\u5BB6\u7684\u6C34\u5E73\u4E86\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u65E0\u654C\u7684\u51A0\u519B\u4E39\u5E1D\\n\u662F\u5927\u5BB6\u773C\u4E2D\u7684\u8D85\u7EA7\u5DE8\u661F\u554A\uFF01"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u770B\uFF01\u55B7\u706B\u9F99\u7684\u59FF\u52BF\uFF01\\c\\n\u603B\u89C9\u5F97\u53EA\u8981\u548C\u5B83\u6446\u51FA\u4E00\u6837\u7684\u59FF\u52BF\uFF0C\\n\u81EA\u5DF1\u5C31\u597D\u50CF\u771F\u7684\u53D8\u5F3A\u4E86\u4E00\u6837\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6BCF\u5929\u65E9\u4E0A\u90FD\u662F\u5B9D\u53EF\u68A6\u53EB\u6211\u8D77\u5E8A\uFF0C\\n\u6BCF\u5929\u665A\u4E0A\u90FD\u662F\u5B9D\u53EF\u68A6\u966A\u6211\u5165\u7761\u2026\u2026\\c\\n\u5B9E\u5728\u662F\u5F88\u96BE\u60F3\u8C61\\n\u6CA1\u6709\u5B9D\u53EF\u68A6\u7684\u65E5\u5B50\u4F1A\u662F\u600E\u6837\u554A\u3002"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6211\u7EC8\u4E8E\u60F3\u8D77\u6765\u4EE5\u524D\u7ACB\u5728\u8FD9\u91CC\u7684\\n\u63D0\u793A\u724C\u4E0A\u5199\u7740\u4EC0\u4E48\u4E86\u3002\\c\\n\u53F3\u8FB9\u662F\u5B9D\u53EF\u68A6\u7814\u7A76\u6240\uFF0C\\n\u5BF9\u9762\u662F\u8F66\u7AD9\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u4E5F\u66FE\u7ECF\u8003\u8651\u8FC7\u8981\u4E0D\u8981\u5F80\\n\u804C\u4E1A\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u7684\u65B9\u5411\u53D1\u5C55\uFF0C\\c\\n\u4F46\u662F\u6211\u505A\u4E0D\u5230\u50CF\u4E39\u5E1D\u90A3\u6837\\n\u4E00\u5FC3\u90FD\u6251\u5728\u5B9D\u53EF\u68A6\u8EAB\u4E0A\u3002"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u8981\u53BB\u65F6\u88C5\u5E97\u8D2D\u7269\uFF01\\n\u54EA\u6015\u53EA\u662F\u6362\u4E00\u9876\u5E3D\u5B50\uFF0C\u5FC3\u60C5\u4E5F\u4F1A\u968F\u4E4B\u6539\u53D8\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u90A3\u4F4D\u5B9D\u53EF\u68A6\u535A\u58EB\u554A\uFF0C\\n\u5979\u5E73\u65F6\u90FD\u5F85\u5728\u6E56\u8FB9\u7684\u5BB6\u91CC\uFF0C\\r\\n\u8FC7\u7740\u60A0\u95F2\u7684\u65E5\u5B50\u3002"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u7684\\n\u57FA\u672C\u77E5\u8BC6\u7B2C\uFF11\u6761\uFF01\\c\\n\u5BF9\u6218\u65F6\u7387\u5148\u767B\u573A\u7684\u662F\\n\u540C\u884C\u961F\u4F0D\u4E2D\u6392\u5728\u7B2C\u4E00\u4F4D\u7684\u5B9D\u53EF\u68A6\u3002"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4F60\u5982\u679C\u4E5F\u8FF7\u8DEF\u4E86\uFF0C\\n\u8BB0\u5F97\u62FF\u51FA\u57CE\u9547\u5730\u56FE\u770B\u4E00\u770B\u54E6\u3002"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u5728\u8F66\u7AD9\u770B\u89C1\u51A0\u519B\u4E86\uFF01\\n\u79BB\u5F97\u5F88\u8FDC\u90FD\u80FD\u611F\u53D7\u5230\u90A3\u80A1\u5F3A\u5927\u6C14\u573A\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[~ 15]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[~ 16]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[~ 17]"
  },
  {
    "index": 18,
