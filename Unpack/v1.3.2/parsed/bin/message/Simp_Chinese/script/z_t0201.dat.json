    "text": "[~ 19]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u54A9\u563B\u563B\u563B\uFF5E"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u54A9\u6BDB\u6BDB\uFF5E"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u54C6\u54A9\u54A9\uFF5E"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u54A9\uFF5E"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u7684\u57FA\u672C\u77E5\u8BC6\u7B2C\uFF12\u6761\uFF01\\n\u517B\u6210\u968F\u65F6\u8BB0\u5F55\u7684\u4E60\u60EF\uFF01\\c\\n\u5B9D\u53EF\u68A6\u8BAD\u7EC3\u5BB6\u7684\u57FA\u672C\u77E5\u8BC6\u7B2C\uFF13\u6761\uFF01\\n\u5B9D\u53EF\u68A6\u5C5E\u6027\u548C\u62DB\u5F0F\u5C5E\u6027\u76F8\u540C\u7684\u8BDD\uFF0C\\r\\n\u5A01\u529B\u4F1A\u5927\u5927\u63D0\u9AD8\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u8981\u60F3\u53D1\u6325\u51FA\u5B9D\u53EF\u68A6\u7684\u771F\u6B63\u5B9E\u529B\uFF0C\\n\u8BAD\u7EC3\u5BB6\u7684\u77E5\u8BC6\u50A8\u5907\u5C24\u4E3A\u91CD\u8981\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u8D6B\u666E\u4ED6\u8E51\u624B\u8E51\u811A\u5730\u5F80\u8F66\u7AD9\u53BB\u4E86\u3002"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u54AC\u54AC\uFF01\uFF1F"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u51A0\u519B\u6765\u5566\uFF01\uFF01"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u6700\u5F3A\u7684\u55B7\u706B\u9F99\uFF01"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u53ED\u557E\uFF01\uFF01"
  }
