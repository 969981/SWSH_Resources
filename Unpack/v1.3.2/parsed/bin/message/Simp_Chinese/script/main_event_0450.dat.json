    "index": 0,
    "flags": 0,
    "text": "\u4E3A\u4E86\u7ED9\u9053\u9986\u6311\u6218\u8005\u52A0\u6CB9\uFF0C\\n\u6211\u7279\u5730\u6765\u5230\u4E86\u8FD9\u4E2A\u5927\u90FD\u5E02\uFF01\\c\\n\u5982\u679C\u4F60\u8981\u59A8\u788D\u50CF\u6211\u8FD9\u6837\\n\u52E4\u52B3\u8E0F\u5B9E\u7684\u5450\u558A\u961F\u961F\u5458\uFF0C\\r\\n\u90A3\u5C31\u6765\u573A\u5B9D\u53EF\u68A6\u5BF9\u6218\u5427\u3002"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6765\u5BF9\u6218\u5427\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u5FD9\u4F60\u7684\u5C31\u662F\u4E86"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5582\uFF01\u6211\u4E0D\u662F\u8BF4\u8FC7\uFF0C\\n\u518D\u788D\u4E8B\u6211\u5C31\u8981\u548C\u4F60\u5BF9\u6218\u4E86\u5417\uFF01\\c\\n\u4E3A\u4E86\u8BA9\u90A3\uFF5E\u4F4D\u8BAD\u7EC3\u5BB6\u53D6\u80DC\uFF0C\\n\u6211\u4EEC\u5450\u558A\u961F\u4F1A\u52AA\u529B\u5450\uFF5E\u558A\u52A9\u5A01\uFF01\\c\\n\u6765\u554A\uFF01\u90A3\uFF5E\u5C31\u8BA9\u4F60\u597D\u597D\\n\u89C1\u8BC6\u4E00\u4E0B\u6211\u4EEC\u7684\u5389\u5BB3\u5427\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u5582\uFF5E\uFF01\u5450\u558A\u961F\u7684\u4F19\u4F34\u4EEC\uFF0C\\n\u4F60\u4EEC\u8981\u66FF\u6211\u62A5\u4EC7\u554A\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6765\u5566\u6765\u5566\uFF5E\uFF01\\n\u80FD\u5728\u65C5\u5E97\u91CC\u5BF9\u6218\uFF0C\u771F\u662F\u592A\u68D2\u4E86\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u8FD9\u91CC\u7684\u73AF\u5883\u592A\u9AD8\u96C5\u2026\u2026\\n\u5BB3\u6211\u6CA1\u6CD5\u9759\u4E0B\u5FC3\u6765\u5BF9\u6218\u554A\u2026\u2026[VAR 0114(006F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u4F60\u7684\u5165\u4F4F\u624B\u7EED\u529E\u5F97\u597D\u70ED\u95F9\u554A\u2026\u2026\\c\\n\u54A6\uFF0C\u8FD9\u662F\u600E\u4E48\u56DE\u4E8B\uFF1F\\n\u4F60\u4EEC\u600E\u4E48\u5728\u5BF9\u6218\u554A\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\\n\u4E5F\u7B97\u6211\u4E00\u4E2A\uFF0C\u5C31\u5F53\u7279\u8BAD\u4E86\uFF01\\c\\n[VAR 0100(0000)]\uFF0C\\n\u8BA9\u6211\u4E3A\u4F60\u7684\u5B9D\u53EF\u68A6\u6062\u590D\u6D3B\u529B\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u662F\u9053\u9986\u6311\u6218\u8005\u8D6B\u666E\uFF01\\n\u51A0\u519B\u7684\u5934\u8854\u65E9\u665A\u662F\u6211\u7684\uFF01\\r\\n\u6765\u554A\uFF0C\u6211\u4EEC\uFF12\u5BF9\uFF12\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u4F1A\u770B\u5230\u4F60\u7684\u5931\u8D25\u5450\uFF5E\uFF01\\n\u6211\u4F1A\u542C\u5230\u4F60\u7684\u54ED\u58F0\u5450\uFF5E\uFF01[VAR 0114(006F)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u6211\u770B\u5230\u7684\u662F\u6211\u4EEC\u7684\u5931\u8D25\u5450\u2026\u2026\\n\u6211\u542C\u5230\u7684\u662F\u6211\u4EEC\u7684\u54ED\u58F0\u5450\u2026\u2026[VAR 0114(006F)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u4F60\u4EEC\u5728\u5E72\u4EC0\u4E48\u554A\uFF1F[VAR 0114(0042)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u739B\u4FD0\uFF01\uFF1F[VAR 0114(006F)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4E0D\uFF0C\u4F60\u542C\u6211\u4EEC\u89E3\u91CA\u2026\u2026[VAR 0114(006F)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u77E5\u9053\u4F60\u4EEC\\n\u5F88\u5728\u610F\u5176\u4ED6\u9053\u9986\u6311\u6218\u8005\u3002\\r\\n\u4F46\u662F\uFF0C\u4F60\u4EEC\u95F9\u5F97\u6709\u70B9\u8FC7\u706B\u4E86\u3002[VAR 0114(000D)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u5BF9\u4E0D\u8D77\uFF01\\n\u5450\u558A\u961F\u5176\u5B9E\u662F\u6211\u7684\u52A9\u5A01\u56E2\uFF0C\\r\\n\u4F46\u5927\u5BB6\u597D\u50CF\u6709\u70B9\u98D8\u98D8\u7136\u4E86\u2026\u2026[VAR 0114(000D)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u597D\u4E86\uFF01\\n\u5927\u5BB6\u6563\u5566\uFF01\u6563\u5566\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4ED6\u4EEC\u4E00\u5FC3\u53EA\u60F3\u4E3A\u6211\u52A0\u6CB9\uFF0C\\n\u7ED3\u679C\u5728\u9047\u5230\u5176\u4ED6\u9053\u9986\u6311\u6218\u8005\u7684\u65F6\u5019\uFF0C\\r\\n\u6001\u5EA6\u5C31\u4F1A\u53D8\u5F97\u7279\u522B\u6709\u654C\u610F\u3002\\c\\n\u5982\u679C\u56E0\u6B64\u5F97\u7F6A\u4E86\u4F60\u4EEC\uFF0C\\n\u90A3\u771F\u662F\u62B1\u6B49\u4E86\u3002[VAR 0114(000D)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u539F\u6765\u4F60\u4E5F\u662F\u9053\u9986\u6311\u6218\u8005\u554A\uFF01\\n\u4ED6\u4EEC\u662F\u53EB\u201C\u5450\u558A\u961F\u201D\u5417\uFF1F\\r\\n\u4F60\u90FD\u6709\u7C89\u4E1D\u56E2\u4E86\uFF0C\u771F\u5389\u5BB3\u554A\uFF01[VAR 0114(0005)]"
  }
