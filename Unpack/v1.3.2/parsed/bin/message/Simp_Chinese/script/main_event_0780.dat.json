[
  {
    "index": 0,
    "flags": 0,
    "text": "\u706B\u5C5E\u6027\u9053\u9986\u7684\u9053\u9986\u4EFB\u52A1\u662F\uFF5E\uFF01\\c\\n\u591A\u6349\u5B9D\u53EF\u68A6\uFF0C\u53D6\u5F97\u9AD8\u5206\u6570\uFF01"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u9053\u9986\u6311\u6218\u8005\u9700\u8981\\n\u7D2F\u79EF\uFF15\u5206\u624D\u7B97\u5B8C\u6210\u4EFB\u52A1\uFF01\\c\\n\u53E6\u5916\uFF0C\u548C\u8349\u4E1B\u91CC\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\u65F6\uFF0C\\n\u6253\u8D25\u5B9D\u53EF\u68A6\u53EF\u5F97\uFF11\u5206\uFF0C\\r\\n\u6349\u5230\u5B9D\u53EF\u68A6\u53EF\u5F97\uFF12\u5206\u3002\\c\\n\u4F46\u662F\uFF0C\u548C\u5B9D\u53EF\u68A6\u5BF9\u6218\u65F6\uFF0C\\n\u5176\u4ED6\u7684\u8BAD\u7EC3\u5BB6\u4E5F\u4F1A\u4E00\u8D77\u53C2\u6218\u3002"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u8981\u6839\u636E\u5BF9\u624B\u7684\u884C\u52A8\\n\u91C7\u53D6\u6700\u4F73\u7684\u5E94\u5BF9\u65B9\u6848\u3002\\r\\n\u8FD9\u6837\u624D\u80FD\u53D6\u5F97\u66F4\u9AD8\u7684\u5206\u6570\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u9053\u9986\u4EFB\u52A1\u73B0\u5728\u5F00\u59CB\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6709\u4EC0\u4E48\u95EE\u9898\u5417\uFF1F"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u5982\u4F55\u5B8C\u6210\u4EFB\u52A1\uFF1F"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6211\u8981\u9000\u51FA"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6CA1\u4EC0\u4E48"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8981\u5B8C\u6210\u4EFB\u52A1\uFF0C\u4F60\u9700\u8981\u7D2F\u79EF\uFF15\u5206\uFF01\\c\\n\u548C\u8349\u4E1B\u91CC\u7684\u5B9D\u53EF\u68A6\u5BF9\u6218\u65F6\uFF0C\\n\u6253\u8D25\u5B9D\u53EF\u68A6\u53EF\u5F97\uFF11\u5206\uFF0C\\r\\n\u6349\u5230\u5B9D\u53EF\u68A6\u53EF\u5F97\uFF12\u5206\u3002"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u4E00\u65E6\u9000\u51FA\u5C31\u8981\u4ECE\u5934\u518D\u6765\uFF0C\\n\u4F60\u786E\u5B9A\u8981\u9000\u51FA\u5417\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u968F\u65F6\u606D\u5019\u4F60\u518D\u6765\u6311\u6218\u3002"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u606D\u559C\u4F60\u987A\u5229\u5B8C\u6210\u4E86\u9053\u9986\u4EFB\u52A1\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u63A5\u4E0B\u6765\u4F60\u8981\u6311\u6218\\n\u706B\u5C5E\u6027\u9053\u9986\u9986\u4E3B\u5361\u829C\u5566\uFF01\\r\\n\u53BB\u5427\uFF01\u6311\u6218\u8005\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5F88\u597D\uFF01\\n\u53BB\u5427\uFF0C\u6311\u6218\u8005\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u597D\u5427\uFF01\\n\u90A3\u4F60\u5C31\u597D\u597D\u51C6\u5907\u4E00\u4E0B\u5427\u3002"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u597D\u4E86\uFF0C\u53BB\u6311\u6218\u5427\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u9053\u9986\u4EFB\u52A1\u5F00\u59CB\u5566\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u9053\u9986\u4EFB\u52A1\uFF0C\u987A\u5229\u5B8C\u6210\uFF01\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u7ADF\u7136\u80FD\u5B8C\u6210\u5361\u829C\u7684\u9053\u9986\u4EFB\u52A1\u2026\u2026\\n\u771F\u662F\u592A\u70ED\u8840\u4E86\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u606D\u559C\u5B8C\u6210\u9053\u9986\u4EFB\u52A1\uFF01"
