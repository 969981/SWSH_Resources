    "flags": 0,
    "text": "[VAR 0100(0000)]\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u521A\u624D\u6211\u8BF4\u7684\u2026\u2026\u8981\u662F\u6211\u592A\u5F31\uFF0C\\n\u5C31\u4F1A\u8BA9\u5927\u54E5\u4E5F\u88AB\u770B\u6241\u7684\u4E8B\u2026\u2026\\r\\n\u6211\u8FD8\u662F\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u529E\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u867D\u7136\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u529E\u2026\u2026\\n\u4F46\u662F\u53D8\u5F3A\u662F\u6211\u552F\u4E00\u7684\u51FA\u8DEF\u554A\uFF01\\c\\n\u6240\u4EE5\u6211\u8981\u505A\u5404\u79CD\u5C1D\u8BD5\uFF01\\n\u4F60\u5C31\u5E2E\u6211\u4E00\u628A\uFF0C\u8BA9\u6211\u6E05\u9192\u4E00\u70B9\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u597D\u7684\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u7B49\u4E00\u4E0B"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4F60\u662F\u6211\u7684\u52B2\u654C\uFF0C\u548C\u4F60\u6765\u573A\u5BF9\u6218\uFF0C\\n\u6211\u5E94\u8BE5\u5C31\u80FD\u6E05\u9192\u4E00\u4E9B\u4E86\u2026\u2026\\c\\n\u6765\uFF01\u5BF9\u6218\u5427\uFF01\\n\u6211\u8981\u9F13\u8D77\u5E72\u52B2\u5566\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u4E8F\u4F60\u8FD8\u662F\u6211\u7684\u52B2\u654C\uFF0C\\n\u770B\u5230\u6211\u8FD9\u4E48\u6CAE\u4E27\u90FD\u4E0D\u80AF\u5E2E\u5FD9\u5417\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u54CE\u2026\u2026\\c\\n\u6211\u751A\u81F3\u66FF\u6362\u4E86\u961F\u4F0D\u4E2D\u7684\u5B9D\u53EF\u68A6\uFF0C\\n\u5BFB\u627E\u81EA\u5DF1\u7684\u53EF\u80FD\u6027\u2026\u2026\\c\\n\u4F46\u603B\u89C9\u5F97\u54EA\u91CC\u4E0D\u5BF9\u52B2\u2026\u2026\\n\u4E5F\u5C31\u662F\u8BF4\u6211\u771F\u7684\u5F88\u5F31\u4E48\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5927\u54E5\u662F\u6211\u7684\u5076\u50CF\uFF01\\n\u4ED6\u771F\u7684\u662F\u4E2A\u8D85\u5E05\u7684\u8BAD\u7EC3\u5BB6\uFF01\\c\\n\u6211\u53EF\u4E0D\u80FD\u56E0\u4E3A\u81EA\u5DF1\u592A\u5F31\uFF0C\\n\u800C\u8BA9\u5927\u54E5\u4E5F\u88AB\u4EBA\u770B\u6241\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6211\u8981\u505A\u51FA\u66F4\u591A\uFF01\u66F4\u591A\uFF01\\n\u66F4\u591A\u66F4\u591A\u7684\u5C1D\u8BD5\uFF01\\c\\n\u6211\u8981\u627E\u51FA\u80FD\u548C\u6211\u4E00\u8D77\\n\u53D1\u6325\u5B9E\u529B\u7684\u5B9D\u53EF\u68A6\u2026\u2026\uFF01[VAR 0114(0005)]"
  }
]
