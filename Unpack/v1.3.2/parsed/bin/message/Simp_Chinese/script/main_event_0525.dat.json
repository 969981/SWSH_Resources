    "text": "\u597D\u554A\uFF01"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4E3A\u4EC0\u4E48\uFF1F"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u4F60\u53EF\u771F\u6709\u5E72\u52B2\u554A\uFF01\\c\\n\u90A3\u6211\u4EEC\u5C31\u597D\u597D\u52A0\u628A\u52B2\uFF0C\\n\u5343\u4E07\u4E0D\u80FD\u8F93\u7ED9\u5176\u4ED6\u7684\u7ADE\u4E89\u5BF9\u624B\u4EEC\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u5C31\u62FF\u51FA\u70B9\u5E72\u52B2\uFF0C\u7B54\u5E94\u6211\u5427\u3002\\c\\n\u5426\u5219\u5C31\u51ED\u4F60\u73B0\u5728\u8FD9\u4E2A\u72B6\u6001\uFF0C\\n\u600E\u4E48\u5728\u9053\u9986\u6311\u6218\u4E2D\u8D62\u5230\u6700\u540E\u554A\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u771F\u4E0D\u6127\u662F\u6211\u7684\u52B2\u654C\u554A\uFF01\\c\\n\u4F60\u7684\u5B9E\u529B\u6211\u53EF\u4EE5\u6253\u5305\u7968\uFF0C\\n\u8FD9\u5F20\u8054\u76DF\u5361\u5C31\u9001\u7ED9\u4F60\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6B64\u65F6\u6B64\u523B\uFF0C\u6211\u4EEC\u7684\u9053\u9986\u6311\u6218\\n\u5C31\u8981\u4ECE\u673A\u64CE\u5E02\u5F00\u59CB\u5566\uFF01\\c\\n\u867D\u7136\u7B2C\u4E00\u4E2A\u8981\u6311\u6218\u7684\u9053\u9986\u9986\u4E3B\\n\u6240\u5728\u7684\u9547\u5B50\u79BB\u8FD9\u91CC\u633A\u8FDC\u7684\u2026\u2026\\c\\n\u4F46\u662F\u65E0\u8BBA\u5982\u4F55\uFF0C\u6211\u4E00\u5B9A\u8981\u8D62\u5230\u6700\u540E\uFF0C\\n\u83B7\u5F97\u6311\u6218\u51A0\u519B\u7684\u8D44\u683C\uFF01\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4E0B\u4E00\u4EFB\u51A0\u519B\uFF0C\\n\u5C31\u662F\u5316\u6717\u9547\u7684\u8D6B\u666E\uFF5E\uFF01\uFF01[VAR 0114(0005)]"
