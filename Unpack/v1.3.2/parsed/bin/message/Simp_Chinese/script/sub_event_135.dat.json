  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u54E6\uFF1F\\n\u770B\u6765\u4F60\u8FD8\u6CA1\u6709\u505A\u8FC7\u6599\u7406\u554A\uFF01\\c\\n\u7B49\u4F60\u505A\u4E86\u6599\u7406\u4E4B\u540E\uFF0C\\n\u518D\u6765\u7ED9\u6211\u770B\u770B\u5427\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u5BF9\u4E8E\u7CBE\u901A\u5496\u55B1\u4E4B\u9053\u7684\u4F60\\n\u6211\u5DF2\u7ECF\u6CA1\u4EC0\u4E48\u53EF\u6559\u7684\u4E86\u2026\u2026\uFF01\\c\\n\u4EE5\u540E\u4F60\u4E5F\u8981\u7EE7\u7EED\u505A\u51FA\\n\u6700\u68D2\u7684\u5496\u55B1\u554A\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u5496\u55B1\u56FE\u9274\u5B8C\u6210\u5F97\u600E\u4E48\u6837\u4E86\uFF1F\\n\u8981\u4E0D\u2026\u2026\u6211\u6765\u7ED9\u4F60\u770B\u4E00\u4E0B\u5427\uFF01\\c\\n\u5230\u73B0\u5728\u4E3A\u6B62[VAR 0100(0000)]\u4F60\\n\u6240\u505A\u7684\u5496\u55B1\u4E00\u5171\u6709[VAR 0202(0001)]\u79CD\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u4F60\u8FD8\u662F\u4E2A\u9732\u8425\u65B0\u624B\uFF01\\c\\n\u5148\u653E\u80C6\u628A\u5404\u79CD\u6750\u6599\u6254\u8FDB\u9505\u5B50\u91CC\\n\u5C1D\u8BD5\u4E00\u4E0B\u5427\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u770B\u6765\u4F60\u5DF2\u7ECF\u6E10\u6E10\u719F\u6089\\n\u9732\u8425\u7684\u6599\u7406\u4E86\uFF01\\c\\n\u8BD5\u7740\u7528\u6811\u679C\\n\u505A\u51FA\u7B26\u5408\u81EA\u5DF1\u53E3\u5473\u7684\u5496\u55B1\u5427\uFF01"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u505A\u8FC7\uFF11\uFF10\u79CD\u5496\u55B1\u7684\u8BDD\uFF0C\\n\u4F60\u4E5F\u7B97\u662F\u4ECE\u65B0\u624B\u6BD5\u4E1A\u5566\uFF01\\c\\n\u4F46\u662F\u4E16\u754C\u4E0A\u8FD8\u6709\u66F4\u591A\u79CD\u7C7B\u7684\u5496\u55B1\\n\u7B49\u7740\u4F60\u53BB\u53D1\u73B0\u54E6\uFF01"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4F60\u5DF2\u7ECF\u5728\u8FD9\u6F2B\u957F\u7684\\n\u5496\u55B1\u4E4B\u8DEF\u4E0A\u8D77\u8DD1\u4E86\uFF01\\c\\n\u5982\u679C\u8981\u7EE7\u7EED\u5411\u524D\u8FC8\u8FDB\uFF0C\\n\u5C31\u5F97\u5F7B\u5E95\u638C\u63E1\u4F4F\u6070\u5230\u597D\u5904\u7684\u706B\u5019\uFF0C\\r\\n\u548C\u7CBE\u6E5B\u4ED4\u7EC6\u7684\u6405\u62CC\u6280\u672F\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u54E6\uFF5E\uFF01\\n\u4F60\u5DF2\u7ECF\u505A\u8FC7\uFF13\uFF10\u79CD\u4EE5\u4E0A\u7684\u5496\u55B1\u4E86\u554A\uFF01\\c\\n\u6211\u80FD\u4ECE\u4F60\u8EAB\u4E0A\u611F\u53D7\u5230\u4E00\u80A1\\n\u5496\u55B1\u8FBE\u4EBA\u7684\u624D\u6C14\uFF01\\c\\n\u6211\u76F8\u4FE1\u4F60\u4E00\u5B9A\u80FD\u5230\u8FBE\u66F4\u9AD8\u7684\u5883\u754C\uFF01\\n\u594B\u6597\u5427\uFF01"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u6211\u770B\u5236\u4F5C\u5496\u55B1\u5DF2\u7136\u6210\u4E3A\\n\u4F60\u751F\u6D3B\u7684\u4E00\u90E8\u5206\u4E86\u5427\uFF1F\\c\\n\u98DF\u6750\u4E0D\u4F46\u80FD\u4ECE\u5546\u5E97\u8D2D\u4E70\uFF0C\\n\u6709\u65F6\u4E5F\u80FD\u5728\u8DEF\u8FB9\u6361\u5230\u3002\\c\\n\u53EA\u8981\u5E73\u65F6\u6709\u610F\u8BC6\u5730\u53BB\u6536\u96C6\uFF0C\\n\u5C31\u80FD\u505A\u51FA\u79CD\u7C7B\u66F4\u4E30\u5BCC\u7684\u5496\u55B1\u5566\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4F60\u5DF2\u7ECF\u53EF\u4EE5\u79F0\u5F97\u4E0A\u662F\\n\u5236\u4F5C\u5496\u55B1\u7684\u5185\u884C\u4E86\uFF01\\c\\n\u6211\u76F8\u4FE1\u4F60\u4E00\u5B9A\u5DF2\u7ECF\u610F\u8BC6\u5230\u4E86\uFF0C\\n\u5728\u5176\u4ED6\u4EBA\u7684\u5E10\u7BF7\u91CC\u505A\u6599\u7406\u2026\u2026\\c\\n\u662F\u7528\u81EA\u5DF1\u6240\u6CA1\u6709\u7684\u98DF\u6750\\n\u6765\u5236\u4F5C\u5496\u55B1\u7684\u5927\u597D\u673A\u4F1A\u54E6\uFF01"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u770B\u770B\u4F60\u8138\u4E0A\u7684\u795E\u60C5\uFF01\\n\u8FD8\u6709\u4F60\u8EAB\u4E0A\u98D8\u6765\u7684\u6DE1\u6DE1\u9999\u6599\u5473\uFF01\\c\\n\u4F60\u5B8C\u5168\u5C31\u662F\u4E2A\u5496\u55B1\u5927\u53A8\uFF01\\n\u5076\u5C14\u6B23\u8D4F\u4E00\u4E0B\u5496\u55B1\u56FE\u9274\uFF0C\\r\\n\u8BA9\u81EA\u5DF1\u6C89\u6D78\u4E8E\u56DE\u5FC6\u4E4B\u4E2D\u4E5F\u522B\u6709\u8DA3\u5473\u54E6\uFF01"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u6211\u6240\u77E5\u9053\u7684\u5496\u55B1\u4F60\u5C45\u7136\u5168\u505A\u51FA\u6765\u4E86\uFF01\\n\u5389\u5BB3\u554A\u2026\u2026\u5B9E\u5728\u592A\u5389\u5BB3\u4E86\uFF01\\c\\n\u4F60\u6216\u8BB8\u80FD\u591F\u8D85\u8D8A\u6211\uFF0C\\n\u5B9E\u73B0\u5B8C\u6210\u5496\u55B1\u56FE\u9274\u7684\u4F1F\u4E1A\uFF01\uFF01"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u54E6\uFF1F\u54E6\uFF01\uFF1F\\n\u8FD9\u3001\u8FD9\u662F\u2026\u2026\u6211\u6CA1\u770B\u9519\u5427\uFF01\uFF1F\\c\\n\u4F60\u7EC8\u4E8E\u2026\u2026\\n\u7EC8\u4E8E\u5B8C\u6210\u4E86\u5496\u55B1\u56FE\u9274\u554A\uFF01\uFF01\\c\\n\u4F60\u5DF2\u7ECF\u6311\u6218\u8FC7\\n\u8FD9\u4E16\u4E0A\u6240\u6709\u7684\u5496\u55B1\u4E86\uFF01\\c\\n\u4F60\u5C45\u7136\u628A\u9732\u8425\u7684\u6599\u7406\\n\u7814\u7A76\u5F97\u8FD9\u4E48\u900F\u5F7B\u2026\u2026\\c\\n\u6211\u5B9E\u5728\u662F\u592A\u611F\u52A8\u4E86\uFF01\\n\u8C22\u8C22\uFF01\u8C22\u8C22\u4F60\u554A\uFF01\uFF01"
