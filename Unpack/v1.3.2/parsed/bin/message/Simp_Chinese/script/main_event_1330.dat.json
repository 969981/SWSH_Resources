[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5377\u5E18\u95E8\u5173\u5F97\u7D27\u7D27\u7684\uFF0C\\n\u8FD8\u600E\u4E48\u8BA9\u4EBA\u53BB\u6311\u6218\u5450\u2026\u2026\\r\\n\u6211\u5F97\u8C03\u67E5\u4E0B\u60C5\u51B5\u624D\u884C\u3002[VAR 0114(000D)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8FD9\u662F\u591A\u4F59\u7684\uFF0C\u7ED9\u4F60\u4E86\u3002\\n\u597D\u597D\u52A0\u6CB9\u5427\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u563F\uFF01\u6B22\u8FCE\u4F60\u6765\u5C16\u9489\u9547\uFF01\\n\u9053\u9986\u6311\u6218\u4ECE\u8FD9\u91CC\u5F00\u59CB\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u60F3\u53C2\u52A0\u9053\u9986\u6311\u6218\u7684\u8BDD\uFF0C\\n\u5C31\u5148\u6362\u4E0A\u7ADE\u6280\u670D\u5427\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u60F3\u89C1\u9053\u9986\u9986\u4E3B\u7684\u8BDD\uFF0C\\n\u4E00\u76F4\u5411\u524D\u8D70\u5C31\u884C\u5566\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u8D70\u56DE\u5934\u8DEF\u5C31\u53EF\u4EE5\u9000\u51FA\u3002\\n\u4F60\u662F\u8981\u9000\u51FA\u5417\uFF1F[VAR 0114(0045)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u6CE8\u610F\uFF01\u8D8A\u8FC7\u90A3\u91CC\u5C31\u7B97\u9000\u51FA\u4E86\u3002[VAR 0114(0045)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u53EA\u6709\uFF11\u53EA\u6709\u6D3B\u529B\u7684\u5B9D\u53EF\u68A6\uFF1F\\n\u90A3\uFF5E\u5C31\u8BF7\u56DE\u5427\u3002[VAR 0114(0045)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u7ADF\u7136\u6253\u8D62\u4E86\u8042\u6893\uFF01\uFF1F\\n\u7ED9\u4F60\u62DB\u5F0F\u5B66\u4E60\u5668\uFF0C\u62FF\u53BB\u7559\u4F5C\u7EAA\u5FF5\u5427\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u5582\uFF01\uFF19\u53F7\u9053\u8DEF\u51FA\u5927\u4E8B\u4E86\uFF01\\n\u8FDE\u51A0\u519B\u90FD\u4EB2\u81EA\u6765\u5904\u7406\u5566\uFF01\\c\\n\u554A\uFF01\u4F60\u6253\u8D62\u4E86\u8042\u6893\u5417\uFF1F\\n\u90A3\u4F60\u6700\u597D\u53BB\u5E2E\u5E2E\u5FD9\uFF01\\r\\n\u6765\uFF0C\u6211\u5E26\u4F60\u53BB\u5427\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u6211\u60F3\u6253\u5DE5\u8D5A\u70B9\u5916\u5FEB\uFF0C\\n\u6240\u4EE5\u5728\u66FF\u8054\u76DF\u804C\u5458\u5E72\u6D3B\u5450\uFF5E[VAR 0114(0045)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u9053\u9986\u9986\u4E3B\u6B63\u7B49\u4F60\u5462\u3002\\n\u5FEB\u53BB\u6328\u6253\u5427\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u8FD9\u4F4D\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u4F60\u5F88\u60F3\u4ECE\u8FD9\u91CC\u901A\u8FC7\u5427\uFF1F\\r\\n\u4F46\u662F\u554A\uFF0C\u6211\u504F\u4E0D\u8981\u4F60\u901A\u8FC7\uFF01\\c\\n\u4E5F\u5C31\u662F\u8BF4\uFF0C\u4F60\u60F3\u8FC7\u53BB\uFF0C\u800C\u6211\u4E0D\u60F3\u8BA9\u8DEF\uFF0C\\n\u90A3\u5C31\u53EA\u80FD\u7528\u5BF9\u6218\u8BF4\u8BDD\u4E86\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u6211\u5C31\u662F\u4E0D\u60F3\u8BA9\u4F60\u8FC7\u53BB\uFF01\\c\\n\u6240\u4EE5\u6211\u8FD8\u7279\u610F\u5B88\u5728\u623F\u5C4B\u7684\\n\u95F4\u9699\u5904\u7B49\u4E86\u4F60\u534A\u5929\uFF01\\r\\n\u4F46\u662F\u6211\u8F93\u4E86\uFF01\u7B49\u4E8E\u767D\u5FD9\u6D3B\u4E00\u573A\uFF01\\c\\n\u7B97\u4E86\uFF0C\u8F93\u4E86\u5C31\u8BE5\u6EDA\u86CB\u3002\\n\u4F60\u60F3\u8FC7\u53BB\u5C31\u8FC7\u53BB\u5427\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u4F60\u77E5\u9053\u5B9D\u53EF\u68A6\u6709\u4E2A\u62DB\u5F0F\u53EB\u505A\u201C\u5149\u5899\u201D\u5417\uFF1F[VAR 0114(0045)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u54CE\u5440\u5440\uFF0C\\n\u9053\u9986\u6311\u6218\u8005\uFF0C\u4F60\u8981\u7A7F\u8FC7\u8FD9\u91CC\u5417\uFF1F\\c\\n\u4F46\u662F\u5F88\u4E0D\u51D1\u5DE7\uFF0C\u5230\u4E86\u5450\u558A\u961F\u7684\u5730\u76D8\u2026\u2026\\n\u4F60\u4E0D\u6253\u58F0\u62DB\u547C\u5C31\u60F3\u8FC7\u53BB\uFF1F\u6CA1\u95E8\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4F60\u7684\u62DB\u547C\u6253\u5F97\u597D\u5927\u554A\uFF01\\c\\n\u4F60\u4EEC\u4E5F\u592A\u5389\u5BB3\u4E86\uFF0C\\n\u8FDE\u6211\u7684\u5B9D\u53EF\u68A6\u4EEC\u90FD\u88AB\u4F60\u4EEC\u8FF7\u5012\u4E86\u3002\\c\\n\u597D\uFF0C\u6211\u5C31\u653E\u4F60\u8FC7\u53BB\u5427\u3002\\n\u6CE8\u610F\u770B\u9713\u8679\u62DB\u724C\u554A\u3002[VAR 0114(0045)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u821E\u8E48\u5B9D\u53EF\u68A6\u9B54\u5899\u4EBA\u5076\u2026\u2026\\n\u5B83\u662F\u6211\u4EEC\u7684\u597D\u4F19\u4F34\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u5373\u4F7F\u6CA1\u6709\u610F\u4E49\uFF0C\u4E5F\u8981\u75AF\u72C2\u5450\u558A\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u5413\u4E86\u4F60\u4E00\u8DF3\u5427\uFF1F\\c\\n\u843D\u5730\u8FD9\u4E00\u4E0B\u641E\u5F97\u6211\\n\u817F\u811A\u5F88\u75DB\uFF0C\u5FC3\u60CA\u80C6\u6218\uFF01\\c\\n\u7EE7\u7EED\u6775\u5728\u8FD9\u91CC\u5C31\u8981\u75BC\u54ED\u6211\u4E86\uFF0C\\n\u6240\u4EE5\u5FEB\u6765\u548C\u6211\u5BF9\u6218\u5427\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u8F93\u4E86\u5F52\u8F93\u4E86\uFF01\\c\\n\u6211\u597D\u6B79\u6709\u52AA\u529B\u5730\u5FCD\u75DB\u3002\\n\u8FD9\u4E00\u70B9\u4F60\u5E94\u8BE5\u80AF\u5B9A\u4E00\u4E0B\u554A\uFF01\\c\\n\u597D\uFF01\u6211\u5C31\u5FCD\u7740\u75DB\uFF0C\\n\u88C5\u4F5C\u6CA1\u4E8B\u4E00\u6837\u64A4\u9000\u5427\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5B9D\u53EF\u68A6\u7684\u4F53\u529B\u5FEB\u6491\u4E0D\u4F4F\u4E86\u5427\uFF1F[VAR 0114(0045)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u8FD9\u662F\u6211\u4E3A\u4E86\u6210\u4E3A\u5076\u50CF\\n\u800C\u52AA\u529B\u7EC3\u4E60\u7684\u540E\u7A7A\u7FFB\uFF01\\r\\n\u5403\u60CA\u4E86\u5427\uFF1F\u518D\u5403\u60CA\u4E00\u70B9\uFF01\\c\\n\u8D81\u4F60\u5403\u60CA\u7684\u65F6\u5019\uFF0C\\n\u6211\u8981\u5077\u8D70\u80DC\u5229\u5566\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u770B\u6765\u6211\u5E94\u8BE5\u597D\u597D\u7EC3\u4E60\u7684\\n\u4E0D\u662F\u4EC0\u4E48\u540E\u7A7A\u7FFB\uFF0C\\r\\n\u800C\u662F\u5B9D\u53EF\u68A6\u5BF9\u6218\u554A\u2026\u2026\\c\\n\u8C22\u8C22\u4F60\u8BA9\u6211\u660E\u767D\u8FD9\u4E00\u70B9\u3002\\n\u6211\u4F1A\u4E3A\u4F60\u52A0\u6CB9\u7684\u3002[VAR 0114(0045)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u5450\u558A\u961F\u95EA\u4EAE\u767B\u573A\uFF01\\c\\n\u4F60\u53EF\u4E0D\u8981\u4ED7\u7740\u81EA\u5DF1\u662F\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u5C31\u5BF9\u6211\u4EEC\u7684\u57FA\u5730\u80E1\u4F5C\u975E\u4E3A\u554A\u3002[VAR 0114(0045)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u4EC0\u4E48\uFF01\uFF1F\u4F60\u53EA\u6709\uFF11\u53EA\\n\u6709\u6D3B\u529B\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\uFF1F\\c\\n\u8981\u662F\u4F60\u6CA1\u6709\u6D3B\u529B\u788E\u7247\u4E4B\u7C7B\u7684\u9053\u5177\uFF0C\\n\u5C31\u5FEB\u70B9\u6EDA\u56DE\u53BB\u5427\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u597D\uFF01\u6211\u8981\u9760\u5939\u51FB\u5236\u80DC\uFF01\\n\u73B0\u5728\u987E\u4E0D\u5F97\u4F53\u9762\u4E0D\u4F53\u9762\u4E86\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u54C7\u554A\uFF01\u6765\u4E0D\u53CA\u6362\u88C5\u4E86\u3002\\c\\n\u6CA1\u9519\uFF01\u5450\u558A\u961F\u7684\u771F\u5B9E\u8EAB\u4EFD\\n\u5C31\u662F\u5C16\u9489\u9547\u7684\u9053\u9986\u8BAD\u7EC3\u5BB6\uFF01"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u4E0D\u5173\u6211\u7684\u4E8B\u4E86\uFF01\\n\u63A5\u4E0B\u6765\u53EF\u662F\u9053\u9986\u9986\u4E3B\u54E6\uFF01\\r\\n\u544A\u8BC9\u4F60\uFF0C\u4ED6\u5389\u5BB3\u5F97\u4E0D\u5F97\u4E86\uFF01[VAR 0114(0045)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\u672C\u6765\u5450\u558A\u961F\u7684\u771F\u5B9E\u8EAB\u4EFD\\n\u4E5F\u65E9\u5C31\u8D25\u9732\u4E86\u3002\\r\\n\u6211\u6CA1\u6765\u5F97\u53CA\u6362\u88C5\uFF0C\\r\\n\u5E94\u8BE5\u4E0D\u81F3\u4E8E\u6328\u9A82\u5427\u2026\u2026\u518D\u89C1\u4E86\u3002"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\u9B54\u5899\u9B54\u5899\u2026\u2026\uFF01"
  },
  {
    "index": 33,
