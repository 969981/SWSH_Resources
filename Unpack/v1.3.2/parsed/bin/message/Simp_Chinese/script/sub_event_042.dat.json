    "flags": 0,
    "text": "\u5657\u55DF\u2026\u2026\uFF1F"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u662F\u8D70\u4E22\u7684\u6CE1\u6CAB\u6817\u9F20\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u6CE1\u6CAB\u6817\u9F20\u56DE\u5230\u4E86\u5C0F\u7537\u5B69\u7684\u8EAB\u8FB9\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u627E\u6CE1\u6CAB\u6817\u9F20\uFF1F\\n\u53EF\u6211\u53EA\u662F\u4E2A\u73A9\u6C34\u5927\u53D4\u554A\uFF01"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u5927\u53D4\u6211\u6B63\u5728\u8FD9\u91CC\u7792\u7740\u5927\u5BB6\u5077\u5077\u73A9\u6C34\u2026\u2026\\n\u4E0D\u8FC7\u770B\u6837\u5B50\u6211\u5DF2\u7ECF\u66B4\u9732\u4E86\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u4E3A\u4E86\u7EAA\u5FF5\u6211\u4EEC\u7684\u76F8\u9047\uFF0C\\n\u5C31\u9001\u4F60\u4E00\u4EFD\u8584\u793C\u5427\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u90A3\u5C31\u518D\u89C1\u5566\uFF01\\n\u54C8\u54C8\u54C8\u54C8\uFF5E\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5927\u53D4\u56DE\u53BB\u4E86\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u90A3\u662F\u6211\u7684\u6CE1\u6CAB\u6817\u9F20\uFF01"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u6CE1\u6CAB\u6817\u9F20\u56DE\u5230\u6211\u8EAB\u8FB9\u4E86\uFF01\\n\u8C22\u8C22\u4F60\u5E2E\u6211\u627E\u56DE\u5B83\uFF01"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u4E3A\u4E86\u611F\u8C22\u4F60\u7684\u5E2E\u52A9\uFF0C\\n\u5C31\u8BF7\u4F60\u6536\u4E0B\u8FD9\u4EFD\u793C\u7269\u5427\uFF01"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6CE1\u6CAB\u6817\u9F20\u662F\u6211\u7684\u597D\u670B\u53CB\uFF01\\n\u4E0D\u8FC7\u5B83\u5B9E\u5728\u592A\u6D3B\u6CFC\u597D\u52A8\u4E86\uFF0C\u6211\u5F97\u770B\u7740\u70B9\u5B83\uFF01"
  }
