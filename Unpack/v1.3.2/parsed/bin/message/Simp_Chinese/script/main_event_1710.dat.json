[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8BA9\u5927\u5BB6\u4E45\u7B49\u5566\uFF01\\n\u51A0\u519B\u676F\u7684\u51B3\u8D5B\u7EC8\u4E8E\u8981\u62C9\u5F00\u5E37\u5E55\u4E86\uFF01\\c\\n\u9996\u8F6E\u7B2C1\u573A\u6BD4\u8D5B\uFF01\\n\u9996\u5148\u767B\u573A\u7684\u662F\u2026\u2026[VAR 0114(0018)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u51A0\u519B\u63A8\u8350\u7684\u9053\u9986\u6311\u6218\u8005\uFF0C\\n[VAR 0100(0000)]\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5BF9\u624B\u662F\u60CA\u6D9B\u9A87\u6D6A\uFF01\\n\u6C34\u5C5E\u6027\u7684\u4E13\u5BB6\uFF0C\u9732\u7483\u5A1C\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6BD4\u8D77\u5728\u6C34\u821F\u7ADE\u6280\u573A\u548C\u4F60\u4EA4\u624B\u7684\u65F6\u5019\uFF0C\\n\u4F60\u7684\u5B9E\u529B\u53C8\u5927\u6709\u957F\u8FDB\u4E86\u554A\u2026\u2026\\c\\n\u4E0D\u6127\u662F\u65E0\u654C\u7684\u51A0\u519B\uFF0C\\n\u8FDE\u770B\u4EBA\u7684\u773C\u5149\u4E5F\u662F\u51A0\u519B\u7EA7\u7684\u3002[VAR 0114(000F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4E0D\u8FC7\u5462\uFF0C\\n\u4F60\u65E2\u4E0D\u662F\u51A0\u519B\uFF0C\u4E5F\u5F53\u4E0D\u4E86\u51A0\u519B\u3002\\c\\n\u56E0\u4E3A\u4F60\u548C\u4E39\u5E1D\u90FD\u4F1A\\n\u6210\u4E3A\u6211\u9732\u7483\u5A1C\u7684\u624B\u4E0B\u8D25\u5C06\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u4E0D\u4F1A\u4F4E\u4F30\u4F60\u7684\u5B9E\u529B\uFF01\\c\\n\u8FD9\u6B21\u6211\u4E00\u5B9A\u8981\u7528\u6781\u5DE8\u5316\\n\u5C06\u4F60\u4EEC\u51B2\u5230\u4E16\u754C\u7684\u5C3D\u5934\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u83B7\u80DC\u7684\u662F[VAR 0100(0000)]\uFF01\\c\\n\u7EE7\u9053\u9986\u6311\u6218\u4E4B\u540E\uFF0C\\n[VAR 1100(00FF,0101)]\u4ED6\u5979\u518D\u6B21\u51FB\u8D25\u4E86\u9732\u7483\u5A1C\uFF01[VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u4F60\u4EEC\u5B9E\u5728\u662F\u592A\u6709\u5B58\u5728\u611F\u4E86\u2026\u2026\\c\\n\u5373\u4F7F\u6211\u8BA9\u6211\u7684\u642D\u6863\u6781\u5DE8\u5316\uFF0C\\n\u4E5F\u6CA1\u529E\u6CD5\u51B2\u57AE\u4F60\u4EEC\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u8BDD\u8BF4\u56DE\u6765\uFF0C\\n\u7D22\u59AE\u4E9A\u66FE\u7ECF\u5BF9\u6211\u5938\u4E86\u4F60\u4E00\u901A\u5462\u3002\\c\\n\u65E9\u77E5\u5982\u6B64\uFF0C\u5F53\u521D\u5C31\u8BE5\u597D\u597D\\n\u542C\u4E00\u4E0B\u5979\u662F\u600E\u4E48\u5938\u5956\u4F60\u7684\u554A\u3002[VAR 0114(000F)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u73B0\u5728\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u4EBA\\n\u5E94\u8BE5\u90FD\u5728\u4E3A\u4F60\u800C\u75AF\u72C2\u5427\uFF01\\c\\n\u4F60\u8981\u8E0F\u4E0A\u6218\u80DC\u6211\u4EEC\u7684\u6D6A\u6F6E\uFF0C\\n\u4E00\u9F13\u4F5C\u6C14\u8FDB\u5165\u51B3\u6218\u54E6\uFF01[VAR 0114(000F)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u7A0D\u540E\u5C06\u8FDB\u884C\u9996\u8F6E\u7B2C\uFF12\u573A\u6BD4\u8D5B\uFF0C\\n\u8BF7\u5404\u4F4D\u89C2\u4F17\u7A0D\u7B49\u7247\u523B\u3002[VAR 0114(0018)]"
  }
]
