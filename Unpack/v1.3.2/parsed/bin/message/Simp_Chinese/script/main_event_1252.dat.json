[
  {
    "index": 0,
    "flags": 0,
    "text": "\u6211\u53EB\u7F8E\u84C9\u3002\\c\\n\u5982\u4F60\u6240\u89C1\uFF0C\u6211\u7684\u961F\u4F0D\u662F\u7531\\n\u51B0\u5C5E\u6027\u5B9D\u53EF\u68A6\u7EC4\u6210\u7684\u3002[VAR 0114(0015)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u5012\u662F\u633A\u5389\u5BB3\u7684\u561B\uFF01\\c\\n\u5C45\u7136\u80FD\u907F\u5F00\u6240\u6709\u7684\u9677\u9631\uFF0C\\n\u6210\u529F\u6765\u5230\u6211\u8FD9\u91CC\u3002\\c\\n\u770B\u6765\u6211\u4E0D\u6253\u8D77\u70B9\u7CBE\u795E\u6765\uFF0C\\n\u641E\u4E0D\u597D\u4F1A\u9634\u6C9F\u91CC\u7FFB\u8239\u554A\u3002[VAR 0114(0015)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6389\u8FDB\u9677\u9631\u7684\u6ECB\u5473\u5982\u4F55\uFF1F\\n\u60F3\u5FC5\u4F60\u73B0\u5728\u6D51\u8EAB\u90FD\u5F88\u75DB\u5427\uFF01\\r\\n\u4F46\u662F\u4F60\u4E0D\u8981\u6307\u671B\u6211\u4F1A\u56E0\u6B64\u653E\u6C34\u54E6\uFF01[VAR 0114(0015)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u6211\u4EEC\u5F00\u59CB\u5427\uFF01\\c\\n\u5148\u628A\u4F60\u51BB\u4F4F\uFF0C\u8BA9\u4F60\u65E0\u6CD5\u8131\u8EAB\uFF0C\\n\u7136\u540E\u2026\u2026\u5C31\u662F\u597D\u620F\u4E86\uFF01\\c\\n\u6CA1\u9519\uFF01\\n\u6211\u4EEC\u7684\u5BF9\u6218\u98CE\u683C\u5C31\u662F\u8FD9\u4E48\u51B7\u9177\uFF01[VAR 0114(0015)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u4F60\u2026\u2026\u8FD8\u771F\u6709\u4E24\u4E0B\u5B50\uFF01\\c\\n\u770B\u5230\u5B9D\u53EF\u68A6\u4EEC\u8D25\u4E0B\u9635\u6765\uFF0C\\n\u6211\u5F53\u7136\u662F\u4E0D\u4F1A\u7518\u5FC3\u7684\u3002\\c\\n\u4E0D\u8FC7\u5462\uFF0C\u80FD\u9047\u5230\u5E74\u8F7B\u6709\u4E3A\u7684\u5BF9\u624B\uFF0C\\n\u4E5F\u8BA9\u6211\u9AD8\u5174\u5F97\u4E0D\u5F97\u4E86\u554A\u3002[VAR 0114(0015)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u62FF\u53BB\u5427\uFF01\\n\u8FD9\u679A\u4EAE\u6676\u6676\u7684\u51B0\u4E4B\u5FBD\u7AE0\u5F52\u4F60\u4E86\uFF01[VAR 0114(0015)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u53EF\u4EE5\u6355\u6349\u7B49\u7EA7\uFF15\uFF10\u4EE5\u4E0B\u7684\u5B9D\u53EF\u68A6\u4E86\uFF01"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u5DF2\u7ECF\u60F3\u8C61\u51FA\u4F60\u5C06\u6765\u4F1A\u6210\u4E3A\u51A0\u519B\uFF0C\\n\u5E76\u63A5\u53D7\u6211\u513F\u5B50\u6311\u6218\u7684\u666F\u8C61\u4E86\u3002\\c\\n\u5230\u65F6\u4F60\u53EF\u4E0D\u8981\u624B\u4E0B\u7559\u60C5\u554A\uFF01[VAR 0114(0015)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uFF01\\n\u606D\u559C\u4F60\u6218\u80DC\u4E86\u9053\u9986\u9986\u4E3B\u7F8E\u84C9\uFF01\\c\\n\u4F5C\u4E3A\u7EAA\u5FF5\uFF0C\u8BF7\u6536\u4E0B\u8FD9\u4E2A\u62DB\u5F0F\u5B66\u4E60\u5668\u5427\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8FD9\u5957\u7531\u7F8E\u84C9\u7A7F\u51FA\u4EBA\u6C14\u7684\u7ADE\u6280\u670D\uFF0C\\n\u4E5F\u8BF7\u4F60\u4E00\u5E76\u6536\u4E0B\u5427\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u51B0\u4E4B\u5FBD\u7AE0\u5F88\u9002\u5408\u4F60\u554A\uFF01\\n[VAR 0100(0000)]\uFF0C\u8981\u518D\u63A5\u518D\u5389\u54E6\uFF01"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u8981\u56DE\u5230\u62A5\u5230\u5904\u5417\uFF1F"
  }
