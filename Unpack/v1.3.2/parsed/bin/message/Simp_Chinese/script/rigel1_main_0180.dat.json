[
  {
    "index": 0,
    "flags": 0,
    "text": "\u5457\u554A\u2026\u2026\uFF1F"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u8FD9\u53EA\u5B9D\u53EF\u68A6\u5C31\u662F\\n\u9A6C\u5E08\u5085\u6B66\u9986\u7684\u79D8\u4F20\u94E0\u7532\uFF01\\r\\n\u5B83\u7684\u540D\u5B57\u53EB\u505A\u2026\u2026\u718A\u5F92\u5F1F\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u522B\u770B\u5B83\u4E2A\u5934\u5C0F\uFF0C\\n\u53EA\u8981\u80FD\u591F\u52E4\u594B\u4E25\u8083\u5730\u597D\u597D\u57F9\u80B2\u2026\u2026\\c\\n\u5B83\u5C31\u4F1A\u6210\u957F\u4E3A\\n\u80FD\u591F\u62B5\u6321\u4EFB\u4F55\u5F3A\u654C\u8FDB\u653B\u7684\u575A\u56FA\u94E0\u7532\u54DF\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u5C24\u5176\u662F\u8FD9\u5B69\u5B50\uFF0C\\n\u5B83\u6709\u7740\u975E\uFF5E\u5E38\u4E86\u4E0D\u5F97\u7684\u6F5C\u80FD\uFF0C\\r\\n\u5C31\u662F\u6027\u683C\u6709\u70B9\u817C\u8146\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u597D\u50CF\u5BF9\u81EA\u5DF1\u4E0D\u5927\u6709\u81EA\u4FE1\u54EA\u3002[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u6211\u89C9\u5F97\u5462\uFF0C\\n\u5982\u679C\u5B83\u548C[VAR 0100(0000)]\u4F60\u4E00\u8D77\u5192\u9669\u2026\u2026\\c\\n\u8BF4\u4E0D\u5B9A\u5C31\u80FD\u7834\u58F3\u800C\u51FA\u5C55\u73B0\u81EA\u6211\u5566\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6240\u4EE5\u5462\uFF01\u718A\u5F92\u5F1F\u5C31\u4EA4\u7ED9\u4F60\u5566\uFF01\\n\u62DC\u6258\u4F60\u591A\u8D39\u5FC3\u565C\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u5457\u3001\u5457\uFF5E\u554A\u2026\u2026"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u718A\u5F92\u5F1F\u6210\u4E3A\u4E86\\n[VAR 0100(0000)]\u7684\u5B9D\u53EF\u68A6\uFF01"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u9996\u5148\u5462\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4E24\u4E2A\u5F97\u5148\u53D8\u6210\u597D\u670B\u53CB\uFF0C\\n\u5F7C\u6B64\u76F8\u4E92\u4FE1\u4EFB\u624D\u884C\u54DF\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u90A3\u5B69\u5B50\u8FD8\u6CA1\u600E\u4E48\u5230\u6B66\u9986\u7684\u5916\u9762\u53BB\u8FC7\uFF0C\\n\u6240\u4EE5\u2026\u2026[VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u5E26\u5B83\u4E00\u8D77\u5230\\n\u94E0\u5C9B[VAR FF00(0006)]\u98CE\u666F\u4F18\u7F8E\u7684\u5730\u65B9[VAR FF00(0000)]\u53BB\u770B\u770B\uFF0C\\r\\n\u8BF4\u4E0D\u5B9A\u7ACB\u523B\u5C31\u80FD\u6D88\u9664\u9694\u9602\uFF0C\u4EB2\u5BC6\u8D77\u6765\u5462\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u6211\u4F1A\u6D3E\u5F92\u5F1F\u7AD9\u5728\u98CE\u666F\u4F18\u7F8E\u7684\u5730\u65B9\u5F53\u8DEF\u6807\uFF0C\\n\u4F60\u4EEC\u6CE8\u610F\u627E\u5C31\u597D\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u5F53\u7136\u4E86\uFF0C\u6307\u6325\u5B83\u5BF9\u6218\u6216\u5E26\u5B83\u4E00\u8D77\u9732\u8425\uFF0C\\n\u4E5F\u80FD\u52A0\u6DF1\u4F60\u4EEC\u7684\u7275\u7ECA\u5566\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u8FD8\u6709\uFF0C\u662F[VAR 0100(0000)]\u4F60\u7684\u8BDD\uFF0C\\n\u53EF\u4EE5\u628A\u6700\u524D\u9762\u7684\u5B9D\u53EF\u68A6\u4ECE\u7403\u91CC\u653E\u51FA\u6765\uFF0C\\r\\n\u5728\u94E0\u5C9B[VAR FF00(0006)]\u5E26\u7740\u4E00\u8D77\u8D70[VAR FF00(0000)]\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u53EA\u8981\u4E00\u8D77\u884C\u8D70\uFF0C\u611F\u60C5\u5F88\u5FEB\u5C31\u4F1A\u53D8\u597D\uFF01\\n\u53BB\u548C\u718A\u5F92\u5F1F\u5230\u5904\u8D70\u8D70\u5427\uFF5E\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u7B49\u4F60\u4EEC\u53D8\u6210\u8D85\u7EA7\u8981\u597D\u7684\u670B\u53CB\u4EE5\u540E\uFF0C\\n\u5C31\u53EF\u4EE5\u5F00\u59CB\u718A\u5F92\u5F1F\u7684\u4FEE\u884C\u4E86\uFF0C\\r\\n\u6240\u4EE5\uFF0C\u5230\u65F6\u5019\u6765\u544A\u8BC9\u8001\u5934\u513F\u6211\u4E00\u58F0\u54DF\uFF01[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u6CA1\u60F3\u5230\u79D8\u4F20\u94E0\u7532\u7ADF\u7136\u662F\u5B9D\u53EF\u68A6\uFF01\\c\\n\u4E0D\u8FC7\u8BDD\u8BF4\u56DE\u6765\uFF0C\\n\u5B83\u521A\u624D\u90A3\u4E00\u8FDE\u4E32\u52A8\u4F5C\u53EF\u771F\u662F\u60CA\u4EBA\uFF01"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u514B\u62C9\u62C9\u5979\u597D\u6D88\u6C89\u54EA\u3002\\n\u6211\u80FD\u4E0D\u80FD\u4E3A\u5979\u505A\u70B9\u4EC0\u4E48\u554A\uFF5E\uFF1F"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u8D5B\u5B9D\u5229\u4ED6\u597D\u6D88\u6C89\u54EA\u3002\\n\u6211\u80FD\u4E0D\u80FD\u4E3A\u4ED6\u505A\u70B9\u4EC0\u4E48\u554A\uFF5E\uFF1F"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u4E3A\u4E86\u5728\u5E08\u5085\u4E0B\u4E00\u6B21\u7A81\u7136\u5BA3\u5E03\\n\u5F00\u59CB\u4FEE\u884C\u65F6\uFF0C\u81EA\u5DF1\u80FD\u4E0D\u7559\u9057\u61BE\u2026\u2026\\c\\n\u6211\u8981\u4ECE\u73B0\u5728\u5F00\u59CB\u5C31\u8BA4\u771F\u51C6\u5907\uFF01"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u5728\u505A\u4E8B\u60C5\u7684\u65F6\u5019\u4E0D\u5FD8\u601D\u8003\u5B83\u7684\u610F\u4E49\uFF0C\\n\u5C31\u80FD\u8BA9\u81EA\u5DF1\u53D8\u5F97\u66F4\u6295\u5165\u3002"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\u94E0\u5C9B\u5468\u56F4\u6709\u5F88\u591A\u5C0F\u5C9B\uFF01\\c\\n\u9A91\u7740\u80FD\u5728\u6C34\u4E0A\u79FB\u52A8\u7684\u81EA\u884C\u8F66\\n\u5230\u5404\u4E2A\u5C9B\u4E0A\u53BB\u63A2\u7D22\u4E00\u4E0B\u4E5F\u4E0D\u9519\u554A\uFF01"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u4FEE\u884C\u4E5F\u6682\u544A\u4E00\u6BB5\u843D\u4E86\uFF0C\\n\u6211\u8981\u4E0D\u8981\u53BB\u6536\u96C6\u94E0\u7532\u77FF\u77F3\uFF0C\\r\\n\u597D\u597D\u8D5A\u4E0A\u4E00\u7B14\u5462\uFF1F"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\u662F\u4E0D\u662F\u4E5F\u8BE5\u7ED9\u6211\u4EEC\\n\u5B9A\u5236\u4E9B\u5C0F\u53F7\u7684\u4FEE\u884C\u5957\u88C5\u4E86\u5462\uFF5E"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\u542C\u8BF4\uFF0C\u718A\u5F92\u5F1F\u662F\u9A6C\u58EB\u5FB7\u5E08\u5085\\n\u5728\u5468\u6E38\u4E16\u754C\u7684\u65F6\u5019\u2026\u2026\\c\\n\u4ECE\u6D77\u5916\u53D1\u73B0\u4E86\u5E26\u56DE\u6765\u7684\u3002"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\u770B\u90A3\u79D8\u4F20\u94E0\u7532\u7684\u8EAB\u624B\u2026\u2026\\n\u563F\u563F\uFF01\u6211\u597D\u671F\u5F85\u770B\u89C1\u5B83\u672A\u6765\u7684\u6210\u957F\u554A\u3002"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\u718A\u5F92\u5F1F\u597D\u53EF\u7231\uFF01\\n\u65E9\u77E5\u9053\u6211\u5C31\u518D\u591A\u52AA\u529B\u4E00\u70B9\u4E86\uFF01"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "[~ 30]"
  },
