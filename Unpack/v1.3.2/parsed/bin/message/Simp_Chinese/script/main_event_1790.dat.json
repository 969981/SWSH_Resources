    "text": "\u5BF9\u6218\u573A\u4E0A\u8FD9\u7D27\u5F20\u7684\u6C14\u6C1B\u2026\u2026\\c\\n\u548C\u89C2\u4F17\u72C2\u70ED\u7684\u6B22\u547C\u58F0\\n\u5F62\u6210\u4E86\u9C9C\u660E\u7684\u5BF9\u6BD4\u2026\u2026\\r\\n\u80FD\u540C\u65F6\u611F\u53D7\u5B8C\u5168\u76F8\u53CD\u7684\u6C1B\u56F4\uFF0C\\r\\n\u771F\u662F\u592A\u68D2\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u4F60\u77E5\u9053\u5417\uFF1F\\n\u8FD9\u4E9B\u89C2\u4F17\u4E5F\u6709\u53EF\u6015\u7684\u4E00\u9762\uFF01\\c\\n\u90A3\u5C31\u662F\u4ED6\u4EEC\u4E5F\u4F1A\\n\u76FC\u671B\u5176\u4E2D\u4E00\u65B9\u8F93\u6389\u6BD4\u8D5B\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u6211\u6700\u559C\u6B22\u7684\u5C31\u662F\u9876\u4F4F\u90A3\u79CD\u53EF\u6015\u7684\u538B\u529B\uFF0C\\n\u5C06\u8BAD\u7EC3\u5BB6\u548C\u961F\u4F0D\u7684\u5168\u90E8\u529B\u91CF\\r\\n\u90FD\u53D1\u6325\u5230\u6781\u81F4\uFF0C\u7136\u540E\u65A9\u83B7\u80DC\u5229\uFF01\\c\\n\u90A3\u4E00\u523B\u7684\u5FC3\u60C5\\n\u771F\u7684\u8BA9\u6211\u65E0\u6CD5\u81EA\u62D4\u554A\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6211\u6700\u68D2\u7684\u4F19\u4F34\u4EEC\u4E5F\u90FD\u5728\\n\u7CBE\u7075\u7403\u4E2D\u7B49\u5F97\u4E0D\u8010\u70E6\u4E86\u3002\\c\\n\u6765\u5427\uFF0C\u51A0\u519B\u65F6\u523B\u5F00\u59CB\u4E86\uFF01[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u8FD9\u4E2A\u4F3D\u52D2\u5C14\u5730\u533A\u7684\u51A0\u519B\u4E39\u5E1D\\n\u548C\u6211\u7684\u4F19\u4F34\u55B7\u706B\u9F99\uFF0C\\r\\n\u4EE5\u53CA\u961F\u4F0D\u4E2D\u5176\u4ED6\u7684\u5B9D\u53EF\u68A6\u2026\u2026\\c\\n\u4F1A\u53D1\u6325\u7ECF\u9A8C\u548C\u77E5\u8BC6\u4E0A\u7684\u4F18\u52BF\uFF0C\\n\u5C06\u4F60\u4EEC\u5F7B\u5E95\u51FB\u8D25\uFF01[VAR 0114(0004)]"
  },
  {
