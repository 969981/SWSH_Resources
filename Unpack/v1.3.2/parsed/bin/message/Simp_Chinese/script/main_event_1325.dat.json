    "flags": 0,
    "text": "\u5582\uFF0C\u8FC7\u6765\u4E00\u4E0B\uFF0C\\n[VAR 0100(0000)]\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u6211\u662F\u5728\u8FD9\u9547\u4E0A\u957F\u5927\u7684\uFF0C\\n\u6240\u4EE5\u77E5\u9053\u54EA\u91CC\u6709\u540E\u95E8\u3002[VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u5982\u679C\u4F60\u60F3\u5230\u9547\u91CC\u53BB\u7684\u8BDD\uFF0C\\n\u6211\u5012\u662F\u53EF\u4EE5\u5E26\u8DEF\u54E6\u3002\\c\\n\u4E0D\u8FC7\u2026\u2026\u4F60\u6BD5\u7ADF\u662F\u6211\u7684\u52B2\u654C\uFF0C\\n\u6240\u4EE5\u4F60\u8981\u5148\u6253\u8D62\u6211\u624D\u6709\u7684\u8C08\u3002[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u6C42\u4E4B\u4E0D\u5F97\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u6211\u8003\u8651\u4E00\u4E0B"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u54A6\uFF1F\u96BE\u9053\u662F\u6211\u770B\u9519\u4F60\u4E86\u5417\u2026\u2026\uFF1F\\n\u4E0D\uFF0C\u4F60\u53EA\u662F\u9700\u8981\u51C6\u5907\u4E00\u4E0B\u5427\uFF1F\\r\\n\u597D\uFF01\u90A3\u6211\u5C31\u5728\u8FD9\u91CC\u7B49\u4F60\u3002[VAR 0114(000D)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u540C\u662F\u9053\u9986\u6311\u6218\u8005\uFF0C\\n\u4F60\u4E5F\u4E00\u8DEF\u8D62\u4E86\u4E0B\u6765\u2026\u2026\\c\\n\u5C31\u50CF\u6211\u4E4B\u524D\u8BF4\u7684\u90A3\u6837\uFF0C\\n\u6211\u5F88\u5C0A\u656C\u4F60\u8FD9\u4E2A\u52B2\u654C\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u6211\u80A9\u4E0A\u7684\u62C5\u5B50\u4E5F\u633A\u6C89\u7684\uFF0C\\n\u6240\u4EE5\u7EDD\u4E0D\u80FD\u8F93\u7ED9\u4F60\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u597D\u50CF\u4F53\u4F1A\u5230\u4E3A\u4EC0\u4E48\\n\u83AB\u9C81\u8D1D\u53EF\u660E\u660E\u662F\u6211\u7684\u4F19\u4F34\uFF0C\\r\\n\u5374\u8FD9\u4E48\u5728\u610F\u4F60\u8FD9\u4E2A\u5BF9\u624B\u4E86\u3002\\c\\n\u4F46\u662F\u4F60\u522B\u5F97\u610F\uFF01\\n\u56E0\u4E3A\u80FD\u8BA9\u5C16\u9489\u9547\u7684\u5927\u5BB6\\r\\n\u9AD8\u5174\u7684\u8FD8\u662F\u6211\u554A\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u4F60\u8BB0\u7740\uFF01\\n\u4E3A\u4E86\u80FD\u518D\u6B21\u548C\u4F60\u5BF9\u6218\uFF0C\\r\\n\u6211\u975E\u5F97\u96C6\u9F50\uFF18\u4E2A\u9053\u9986\u5FBD\u7AE0\u4E0D\u53EF\uFF01\\r\\n\u6211\u4F1A\u5728\u51A0\u519B\u676F\u4E0A\u6273\u56DE\u4E00\u57CE\u7684\uFF01[VAR 0114(000D)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u90A3\u4E48\uFF0C\u6309\u7167\u7EA6\u5B9A\uFF01\\n\u8DDF\u6211\u6765\u5427\u3002[VAR 0114(000D)]"
  }
]
