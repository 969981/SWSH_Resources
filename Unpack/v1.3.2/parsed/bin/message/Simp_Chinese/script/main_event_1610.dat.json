[
  {
    "index": 0,
    "flags": 0,
    "text": "\u8FD8\u6CA1\u5230\u5934\u554A\u2026\u2026[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u54A6\uFF1F\u8FD8\u6CA1\u5230\u5462\uFF01\\n\u7535\u68AF\u600E\u4E48\u505C\u4E86\uFF01\uFF1F[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u4F60\u4EEC\u662F\u9053\u9986\u6311\u6218\u8005\u5427\uFF1F\\n\u611F\u8C22\u4F60\u4EEC\u6765\u53C2\u52A0\u6BD4\u8D5B\uFF01\\c\\n\u4F46\u662F\uFF0C\u6211\u4E0D\u5141\u8BB8\u4F60\u4EEC\u6765\u6363\u4E71\uFF01\\c\\n\u4E3A\u4E86\u4FDD\u62A4\u6D1B\u5179\u5927\u53A6\u91CC\u7684\u5404\u5BB6\u96C6\u56E2\u516C\u53F8\uFF0C\\n\u6211\u8981\u628A\u4F60\u4EEC\u8D76\u56DE\u53BB\uFF01"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u53EF\u4EE5\u8FDB\u884C\u5B9D\u53EF\u68A6\u5BF9\u6218\u7684\u7535\u68AF\\n\u662F\u6D1B\u5179\u5927\u53A6\u5F15\u4EE5\u4E3A\u50B2\u7684\u8BBE\u65BD\uFF01\\c\\n\u5236\u9020\u5546\u662F\u6211\u4EEC\u7684\u96C6\u56E2\u516C\u53F8\uFF0C\\n\u9A6C\u6D1B\u79D1\u8499\u5EFA\u8BBE\uFF01"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u65E2\u7136\u8F93\u4E86\uFF0C\u6211\u5C31\u4E56\u4E56\u64A4\u9000\u5427\u3002\\c\\n\u4E0D\u8FC7\uFF0C\\n\u4F60\u4EEC\u53EF\u4E0D\u8981\u53BB\u6253\u6270\u6D1B\u5179\u4F1A\u957F\u554A\u3002"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u4E58\u5750\u6D1B\u5179\u5927\u53A6\u7684\u7535\u68AF\u65F6\uFF0C\\n\u53EA\u6709\u5730\u677F\u4F1A\u4E0A\u5347\u3002\\c\\n\u4E0D\u8FC7\uFF0C\u4E3A\u4E86\u5B89\u5168\u8D77\u89C1\uFF0C\\n\u8FD8\u4F1A\u5728\u56DB\u5468\u4EA7\u751F\u5149\u5899\u3002\\c\\n\u8BF7\u5927\u5BB6\u591A\u591A\u652F\u6301\u9A6C\u6D1B\u79D1\u8499\u5EFA\u8BBE\u3002"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u539F\u6765\u5728\u5927\u53A6\u91CC\u5DE5\u4F5C\u7684\u4EBA\\n\u4F1A\u4ECE\u5916\u9762\u62E6\u4E0B\u7535\u68AF\u554A\u3002\\r\\n\u6211\u4EEC\u53EF\u662F\u6025\u7740\u8981\u5230\u9876\u697C\u7684\u554A\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u6211\u6765\u5E2E\u52AA\u529B\u5BF9\u6218\u7684\u5B9D\u53EF\u68A6\u4EEC\\n\u6062\u590D\u6D3B\u529B\u5427\uFF01[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u6D1B\u5179\u5927\u53A6\u6709\uFF13\uFF10\uFF10\u7C73\u9AD8\uFF0C\\n\u73B0\u5728\u7684\u9AD8\u5EA6\u662F\uFF11\uFF15\uFF10\u7C73\uFF01"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u8981\u662F\u4F60\u4EEC\u8FD8\u6CA1\u4E70\u4FDD\u9669\u7684\u8BDD\uFF0C\\n\u8003\u8651\u4E00\u4E0B\uFF2D\uFF23\u4EBA\u5BFF\u5427\uFF1F"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u5176\u5B9E\u6211\u6709\u6050\u9AD8\u75C7\u2026\u2026"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u8F93\u6389\u5BF9\u6218\u4E5F\u9886\u4E0D\u4E86\u4FDD\u9669\u91D1\u2026\u2026"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u8FD8\u5DEE\u4E00\u70B9\u5C31\u5230\u9876\u697C\u4E86\uFF01\\n\u4F46\u662F\uFF0C\u6211\u4E0D\u4F1A\u8BA9\u4F60\u4EEC\u89C1\u5230\u4F1A\u957F\u7684\uFF01"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u6211\u4E00\u70B9\u90FD\u4E0D\u6015\u9AD8\uFF01\\c\\n\u56E0\u4E3A\u6211\u5728\u9A6C\u6D1B\u79D1\u8499\u822A\u7A7A\u5DE5\u4F5C\uFF0C\\n\u603B\u662F\u4F1A\u8DDF\u9AD8\u5904\u6253\u4EA4\u9053\uFF01"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u4F60\u4EEC\u4F11\u60F3\u89C1\u5230\u4F1A\u957F\u3002\\n\u6709\u4E2A\u4EBA\u4E00\u5B9A\u80FD\u6321\u4F4F\u4F60\u4EEC\u7684\u53BB\u8DEF\u2026\u2026\uFF01"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u4E00\u822C\u6765\u8BF4\uFF0C\u5728\u9AD8\u697C\u5927\u53A6\u5DE5\u4F5C\u7684\u4EBA\uFF0C\\n\u79BB\u9876\u697C\u8D8A\u8FD1\u5730\u4F4D\u5C31\u8D8A\u9AD8\u3002\\c\\n\u6D1B\u5179\u4F1A\u957F\u5728\u5927\u53A6\u9876\u697C\u529E\u516C\uFF0C\\n\u4E5F\u5C31\u662F\u540D\u526F\u5176\u5B9E\u7684\u201C\u81F3\u9AD8\u65E0\u4E0A\u201D\uFF01"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u770B\u6765\u6211\u4EEC\u5FEB\u5230\u4E86\u3002\\n\u6253\u8D77\u7CBE\u795E\u6765\u5427\uFF01[VAR 0114(0005)]"
  }
]
