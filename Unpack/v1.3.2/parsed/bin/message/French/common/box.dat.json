    "index": 176,
    "flags": 0,
    "text": "[VAR 0100(0000)]"
  },
  {
    "index": 177,
    "flags": 4,
    "text": "En attente d\u2019une r\u00E9ponse...\\nVeuillez patienter."
  },
  {
    "index": 178,
    "flags": 0,
    "text": "L\u2019\u00E9change a \u00E9t\u00E9 interrompu.\\c"
  },
  {
    "index": 179,
    "flags": 0,
    "text": "L\u2019autre joueur a choisi d\u2019annuler l\u2019\u00E9change.\\nL\u2019\u00E9change a donc \u00E9t\u00E9 interrompu.\\c"
  },
  {
    "index": 180,
    "flags": 0,
    "text": "L\u2019autre joueur a interrompu l\u2019\u00E9change.\\c\\nFin de l\u2019\u00E9change.\\c"
  },
  {
    "index": 181,
    "flags": 0,
    "text": "Voulez-vous arr\u00EAter d\u2019\u00E9changer des Pok\u00E9mon\u202F?"
  },
  {
    "index": 182,
    "flags": 4,
    "text": "Un probl\u00E8me avec le Pok\u00E9mon de l\u2019autre joueur\\nrend tout \u00E9change impossible.\\c"
  },
  {
    "index": 183,
    "flags": 4,
    "text": "Un probl\u00E8me avec votre Pok\u00E9mon\\nrend tout \u00E9change impossible.\\c"
  },
  {
    "index": 184,
    "flags": 4,
    "text": "Attention\u202F!\\nSi une erreur de communication survient ou\\nque votre console s\u2019\u00E9teint pendant un \u00E9change,\\nvous ne pourrez plus \u00E9changer de Pok\u00E9mon\\npendant quelque temps."
  },
  {
    "index": 185,
    "flags": 0,
    "text": "Sauvegarde en cours...\\nNe pas \u00E9teindre la console."
  },
  {
    "index": 186,
    "flags": 0,
    "text": "Communication en cours...\\nVeuillez patienter."
  },
  {
    "index": 187,
    "flags": 0,
    "text": "Voulez-vous recevoir la carte de Ligue\\nde votre partenaire d\u2019\u00E9change\u202F?"
  },
  {
    "index": 188,
    "flags": 0,
    "text": "Voulez-vous \u00E9changer votre [VAR 0101(0001)]\\ncontre [VAR 1002][VAR 1400(0000,0001)][VAR 0101(0000)] de votre partenaire\u202F?"
  },
  {
    "index": 189,
    "flags": 0,
    "text": "Cet \u0152uf ne peut pas \u00EAtre \u00E9chang\u00E9.\\c"
  },
  {
    "index": 190,
    "flags": 4,
    "text": "\u00C9changer"
  },
  {
    "index": 191,
    "flags": 0,
    "text": "Valider"
  },
  {
    "index": 192,
    "flags": 0,
    "text": "[VAR 0201(0000)]/[VAR 0201(0001)]"
  },
  {
    "index": 193,
    "flags": 0,
    "text": "[VAR 0102(0000)]"
  },
  {
    "index": 194,
    "flags": 0,
    "text": "Ce Pok\u00E9mon ne peut pas \u00EAtre \u00E9chang\u00E9.\\c"
  },
  {
    "index": 195,
    "flags": 4,
    "text": "Aucun de vos Pok\u00E9mon ne peut \u00EAtre \u00E9chang\u00E9.\\c"
  },
  {
    "index": 196,
    "flags": 0,
    "text": "L\u2019\u00E9change d\u2019\u0152ufs est impossible.\\c"
  },
  {
    "index": 197,
    "flags": 4,
    "text": "Il est impossible d\u2019\u00E9changer un Pok\u00E9mon\\nenregistr\u00E9 dans une \u00C9quipe Combat.\\c"
  },
  {
    "index": 198,
    "flags": 0,
    "text": "Ce Pok\u00E9mon tient un objet tr\u00E8s sp\u00E9cial.\\nVous ne pouvez pas l\u2019\u00E9changer\u202F!\\c"
  },
  {
    "index": 199,
    "flags": 0,
    "text": "Voulez-vous ajouter [VAR 0100(0000)]\\n\u00E0 votre liste noire\u202F?"
  },
  {
    "index": 200,
    "flags": 0,
    "text": "Vous ne pourrez plus jouer en r\u00E9seau\\navec les personnes ajout\u00E9es \u00E0 la liste noire.\\c\\nVoulez-vous continuer malgr\u00E9 tout\u202F?\\n(Il sera possible de d\u00E9bloquer ces personnes.)"
  },
  {
    "index": 201,
    "flags": 0,
    "text": "Vous avez ajout\u00E9 cette personne\\n\u00E0 votre liste noire. Fin de l\u2019\u00E9change.\\c"
  },
  {
    "index": 202,
    "flags": 0,
    "text": "Cette personne est d\u00E9j\u00E0 sur votre liste noire.\\c"
  },
  {
    "index": 203,
    "flags": 0,
    "text": "L\u2019ajout de cette personne \u00E0 votre liste noire\\na \u00E9chou\u00E9.\\c"
  },
  {
    "index": 204,
    "flags": 0,
    "text": " S\u00E9lectionner"
  },
  {
    "index": 205,
    "flags": 0,
    "text": "R\u00E9sum\u00E9 du Pok\u00E9mon du partenaire"
  },
  {
    "index": 206,
    "flags": 0,
    "text": "[~ 206]"
  },
  {
    "index": 207,
    "flags": 0,
    "text": "Vous ne pouvez pas changer l\u2019objet tenu\\npar un Pok\u00E9mon destin\u00E9 \u00E0 l\u2019\u00C9change Magique.\\c"
  },
  {
    "index": 208,
    "flags": 0,
    "text": "Vous ne pouvez pas modifier les marques\\nd\u2019un Pok\u00E9mon destin\u00E9 \u00E0 l\u2019\u00C9change Magique.\\c"
  },
  {
    "index": 209,
    "flags": 0,
    "text": "Vous ne pouvez pas rel\u00E2cher un Pok\u00E9mon\\ndestin\u00E9 \u00E0 l\u2019\u00C9change Magique.\\c"
  },
  {
    "index": 210,
    "flags": 0,
    "text": "Vous ne pouvez pas d\u00E9placer un Pok\u00E9mon\\ndestin\u00E9 \u00E0 l\u2019\u00C9change Magique.\\c"
  },
  {
    "index": 211,
    "flags": 0,
    "text": "Vous ne pouvez pas ajouter un Pok\u00E9mon destin\u00E9\\n\u00E0 l\u2019\u00C9change Magique \u00E0 une \u00C9quipe Combat.\\c"
  },
  {
    "index": 212,
    "flags": 0,
    "text": "Vous ne pouvez pas s\u00E9lectionner un \u0152uf.\\c"
  },
  {
    "index": 213,
    "flags": 0,
    "text": "Vous ne pouvez pas s\u00E9lectionner un Pok\u00E9mon\\nappartenant \u00E0 une \u00C9quipe Combat.\\c"
  },
  {
    "index": 214,
    "flags": 0,
    "text": "Vous ne pouvez pas s\u00E9lectionner un Pok\u00E9mon\\ndestin\u00E9 \u00E0 l\u2019\u00C9change Magique.\\c"
  },
  {
    "index": 215,
    "flags": 0,
    "text": "Vous ne pouvez pas s\u00E9lectionner un Pok\u00E9mon\\nde votre \u00E9quipe.\\c"
  },
  {
    "index": 216,
    "flags": 0,
    "text": "Votre s\u00E9lection est trop grande.\\c"
  },
  {
    "index": 217,
    "flags": 0,
    "text": "Vous ne pouvez pas s\u00E9lectionner un Pok\u00E9mon K.O.\\c"
  },
  {
    "index": 218,
    "flags": 0,
    "text": "Ce Pok\u00E9mon est trop exceptionnel\\npour \u00EAtre \u00E9chang\u00E9 par \u00C9change Magique.\\c"
  },
  {
    "index": 219,
    "flags": 0,
    "text": "Vous ne pouvez pas s\u00E9lectionner ce Pok\u00E9mon\u202F!\\c"
  },
  {
    "index": 220,
    "flags": 4,
    "text": "Aucun Pok\u00E9mon ne peut \u00EAtre s\u00E9lectionn\u00E9.\\c"
