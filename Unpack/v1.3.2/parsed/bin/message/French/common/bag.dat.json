    "index": 166,
    "flags": 64,
    "text": "PV"
  },
  {
    "index": 167,
    "flags": 0,
    "text": "Voulez-vous modifier les stats\\n[VAR 1408(0000,0001)][VAR 0102(0000)]\u202F?"
  },
  {
    "index": 168,
    "flags": 0,
    "text": "Gr\u00E2ce [VAR 1404(0000,0000)][VAR 010A(0000)],\\nles stats [VAR 1408(0001,0001)][VAR 0102(0001)] ont chang\u00E9\u202F![VAR BE05(0005)][VAR BE05(0001)]\\c"
  },
  {
    "index": 169,
    "flags": 0,
    "text": "Combien [VAR 1001][VAR 1408(0001,0000)][VAR 010A(0001)]\\nvoulez-vous utiliser\u202F?"
  },
  {
    "index": 170,
    "flags": 0,
    "text": "Le niveau Dynamax augmente d[VAR 1101(0000,0201)]\u2019e [VAR 0201(0000)] point[VAR 1101(0000,0100)]s.\\c"
  },
  {
    "index": 171,
    "flags": 0,
    "text": "Combien [VAR 1001][VAR 1408(0001,0000)][VAR 010A(0001)]\\nvoulez-vous utiliser\u202F?"
  },
  {
    "index": 172,
    "flags": 0,
    "text": "Vous ne pouvez pas utiliser votre v\u00E9lo\\ndepuis votre Sac.\\c"
  },
  {
    "index": 173,
    "flags": 0,
    "text": "Vous ne pouvez pas p\u00EAcher depuis votre Sac.\\c"
  },
  {
    "index": 174,
    "flags": 0,
    "text": "Vous ne pouvez pas utiliser la Bo\u00EEte Pok\u00E9mon\\ndepuis votre Sac.\\c"
  },
  {
    "index": 175,
    "flags": 4,
    "text": "Ampoule \u00E9lectrique"
  },
  {
    "index": 176,
    "flags": 0,
    "text": "Four \u00E0 micro-ondes"
  },
  {
    "index": 177,
    "flags": 0,
    "text": "Machine \u00E0 laver"
  },
  {
    "index": 178,
    "flags": 0,
    "text": "R\u00E9frig\u00E9rateur"
  },
  {
    "index": 179,
    "flags": 0,
    "text": "Ventilateur"
  },
  {
    "index": 180,
    "flags": 0,
    "text": "Tondeuse"
  },
  {
    "index": 181,
    "flags": 0,
    "text": "Quel appareil \u00E9lectrique souhaitez-vous\\ncommander\u202F?"
  },
  {
    "index": 182,
    "flags": 4,
    "text": "Un [VAR 0101(0000)] est apparu dans\\nl\u2019antre g\u00E9ant des Terres Sauvages\u202F!\\c"
  },
  {
    "index": 183,
    "flags": 4,
    "text": "Il y a d\u00E9j\u00E0 un Pok\u00E9mon dans l\u2019antre g\u00E9ant.\\c"
  },
  {
    "index": 184,
    "flags": 0,
    "text": "Changer de forme"
  },
  {
    "index": 185,
    "flags": 0,
    "text": "Changer de talent"
  },
  {
    "index": 186,
    "flags": 0,
    "text": "Voulez-vous vraiment fusionner ces objets\u202F?"
  },
  {
    "index": 187,
    "flags": 0,
    "text": "Vous n\u2019avez qu\u2019un seul exemplaire de cet objet.\\nVoulez-vous vraiment le s\u00E9lectionner\u202F?"
  },
  {
    "index": 188,
    "flags": 4,
    "text": "\u00C0 quel Pok\u00E9mon voulez-vous l\u2019enseigner\u202F?"
