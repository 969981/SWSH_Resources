  },
  {
    "index": 50,
    "flags": 0,
    "text": "Ruban comm\u00E9morant la victoire contre le Ma\u00EEtre de Kalos\\net l\u2019entr\u00E9e au Panth\u00E9on."
  },
  {
    "index": 51,
    "flags": 0,
    "text": "Ruban re\u00E7u il y a longtemps pour une victoire\\ncontre la Ligue Pok\u00E9mon d\u2019une certaine r\u00E9gion."
  },
  {
    "index": 52,
    "flags": 0,
    "text": "Ruban comm\u00E9morant la victoire contre le Ma\u00EEtre de Sinnoh\\net l\u2019entr\u00E9e au Panth\u00E9on."
  },
  {
    "index": 53,
    "flags": 0,
    "text": "Ruban \u00E0 offrir \u00E0 un Pok\u00E9mon auquel on est tr\u00E8s attach\u00E9."
  },
  {
    "index": 54,
    "flags": 0,
    "text": "Ruban pour r\u00E9compenser un Pok\u00E9mon ayant r\u00E9ussi\\nun entra\u00EEnement sans piti\u00E9."
  },
  {
    "index": 55,
    "flags": 0,
    "text": "Ruban pour r\u00E9compenser un Pok\u00E9mon ayant remport\u00E9\\nde difficiles combats."
  },
  {
    "index": 56,
    "flags": 0,
    "text": "Ruban pour r\u00E9compenser un Pok\u00E9mon s\u2019\u00E9tant surpass\u00E9\\nau cours des combats."
  },
  {
    "index": 57,
    "flags": 0,
    "text": "Ruban pour r\u00E9compenser un dur labeur."
  },
  {
    "index": 58,
    "flags": 0,
    "text": "Ruban rappelant un \u00E9v\u00E8nement vivifiant qui a cr\u00E9\u00E9\\nde l\u2019\u00E9nergie vitale."
  },
  {
    "index": 59,
    "flags": 0,
    "text": "Ruban rappelant un \u00E9v\u00E8nement palpitant qui a rendu la vie\\nplus passionnante."
  },
  {
    "index": 60,
    "flags": 0,
    "text": "Ruban rappelant des moments de tristesse ayant ajout\u00E9\\nun peu de piment \u00E0 la vie."
  },
  {
    "index": 61,
    "flags": 0,
    "text": "Ruban rappelant une n\u00E9gligence qui a aid\u00E9 \u00E0 prendre\\ndes d\u00E9cisions vitales."
  },
  {
    "index": 62,
    "flags": 0,
    "text": "Ruban rappelant un \u00E9v\u00E8nement rafra\u00EEchissant qui a ajout\u00E9\\ndu pep \u00E0 la vie."
  },
  {
    "index": 63,
    "flags": 0,
    "text": "Ruban rappelant un \u00E9v\u00E8nement ensommeill\u00E9 qui a rendu\\nla vie plus reposante."
  },
  {
    "index": 64,
    "flags": 0,
    "text": "Ruban rappelant que le sourire am\u00E9liore la qualit\u00E9 de vie."
  },
  {
    "index": 65,
    "flags": 0,
    "text": "Ruban somptueux et excentrique."
  },
  {
    "index": 66,
    "flags": 4,
    "text": "Incroyable ruban royal qui a un petit air de noblesse."
  },
  {
    "index": 67,
    "flags": 0,
    "text": "Ruban somptueux et royal, qui repr\u00E9sente le comble\\nde la beaut\u00E9."
  },
  {
    "index": 68,
    "flags": 0,
    "text": "Ruban pour les mod\u00E8les de Hoenn expos\u00E9s au mus\u00E9e."
  },
  {
    "index": 69,
    "flags": 0,
    "text": "Ruban r\u00E9compensant un Pok\u00E9mon pour la qualit\u00E9\\nexceptionnelle de son empreinte."
  },
  {
    "index": 70,
    "flags": 0,
    "text": "Ruban r\u00E9compensant un record incroyable."
  },
  {
    "index": 71,
    "flags": 0,
    "text": "Ruban r\u00E9compensant un record l\u00E9gendaire."
  },
  {
    "index": 72,
    "flags": 0,
    "text": "Ruban r\u00E9compensant la victoire \u00E0 la Ligue Pok\u00E9mon."
  },
  {
    "index": 73,
    "flags": 0,
    "text": "Ruban pour avoir triomph\u00E9 face \u00E0 toutes les difficult\u00E9s."
  },
  {
    "index": 74,
    "flags": 0,
    "text": "Ruban r\u00E9compensant 100 victoires \u00E0 la suite."
  },
  {
    "index": 75,
    "flags": 0,
    "text": "Ruban r\u00E9compensant la victoire \u00E0 la Ligue Pok\u00E9mon."
  },
  {
    "index": 76,
    "flags": 0,
    "text": "Ruban qui montre l\u2019amour port\u00E9 \u00E0 un Pok\u00E9mon."
  },
  {
    "index": 77,
    "flags": 0,
    "text": "Ruban comm\u00E9morant un jour sp\u00E9cial."
  },
  {
    "index": 78,
    "flags": 0,
    "text": "Ruban r\u00E9compensant la participation \u00E0 un \u00C9v\u00E8nement\\nPok\u00E9mon."
  },
  {
    "index": 79,
    "flags": 0,
    "text": "Ruban comm\u00E9morant un anniversaire."
  },
  {
    "index": 80,
    "flags": 0,
    "text": "Ruban sp\u00E9cial pour un jour tr\u00E8s particulier."
  },
  {
    "index": 81,
    "flags": 0,
    "text": "Ruban comm\u00E9morant un souvenir cher."
  },
  {
    "index": 82,
    "flags": 0,
    "text": "Ruban suppos\u00E9 exaucer les v\u0153ux."
  },
  {
    "index": 83,
    "flags": 0,
    "text": "Ruban r\u00E9compensant la victoire \u00E0 une comp\u00E9tition."
  },
  {
    "index": 84,
    "flags": 0,
    "text": "Ruban r\u00E9compensant la victoire au Championnat R\u00E9gional."
  },
  {
    "index": 85,
    "flags": 0,
    "text": "Ruban r\u00E9compensant la victoire au Championnat National."
  },
  {
    "index": 86,
    "flags": 0,
    "text": "Ruban r\u00E9compensant la victoire aux Pok\u00E9mon World\\nChampionships."
  },
  {
    "index": 87,
    "flags": 0,
    "text": "Ruban re\u00E7u il y a longtemps dans une lointaine r\u00E9gion.\\nIl rappelle le souvenir de magnifiques concours\u202F!"
  },
  {
    "index": 88,
    "flags": 0,
    "text": "Ruban re\u00E7u il y a longtemps dans une lointaine r\u00E9gion.\\nIl rappelle le souvenir de f\u00E9roces combats\u202F!"
  },
  {
    "index": 89,
    "flags": 0,
    "text": "Ruban comm\u00E9morant la victoire contre le Ma\u00EEtre de Hoenn\\net l\u2019entr\u00E9e au Panth\u00E9on."
  },
  {
    "index": 90,
    "flags": 0,
    "text": "Ruban offert \u00E0 un Pok\u00E9mon ayant marqu\u00E9 les esprits\\ndans tous les types de concours possibles."
  },
  {
    "index": 91,
    "flags": 0,
    "text": "Ruban comm\u00E9morant une incroyable d\u00E9monstration\\nde Sang-froid durant un concours."
  },
  {
    "index": 92,
    "flags": 0,
    "text": "Ruban comm\u00E9morant une incroyable d\u00E9monstration\\nde Beaut\u00E9 durant un concours."
  },
  {
    "index": 93,
    "flags": 0,
    "text": "Ruban comm\u00E9morant une incroyable d\u00E9monstration\\nde Gr\u00E2ce durant un concours."
  },
  {
    "index": 94,
    "flags": 0,
    "text": "Ruban comm\u00E9morant une incroyable d\u00E9monstration\\nd\u2019Intelligence durant un concours."
  },
  {
    "index": 95,
    "flags": 0,
    "text": "Ruban comm\u00E9morant une incroyable d\u00E9monstration\\nde Robustesse durant un concours."
  },
  {
    "index": 96,
    "flags": 0,
    "text": "Ruban comm\u00E9morant l\u2019accession au rang de Ma\u00EEtre d\u2019Alola\\net l\u2019entr\u00E9e au Panth\u00E9on."
  },
  {
    "index": 97,
    "flags": 0,
    "text": "Ruban offert \u00E0 un Pok\u00E9mon \u00E9tant sorti grand vainqueur\\nde la Bataille Royale."
  },
  {
    "index": 98,
    "flags": 0,
    "text": "Ruban comm\u00E9morant la victoire contre les Dresseurs\\nde l\u00E9gende \u00E0 l\u2019Arbre de Combat."
  },
