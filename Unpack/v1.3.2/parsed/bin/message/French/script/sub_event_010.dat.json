[
  {
    "index": 0,
    "flags": 0,
    "text": "The Maximizers, c\u2019est le meilleur groupe\\nde musique Pok\u00E9mon du monde\u202F!\\r\\nTu veux assister \u00E0 leur concert\u202F?"
  },
  {
    "index": 1,
    "flags": 4,
    "text": "Oui\u202F!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "Non, merci."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "Je te pr\u00E9viens, c\u2019est plut\u00F4t long,\\nmais je te promets que c\u2019est que du bonheur\u202F!\\r\\nTu veux quand m\u00EAme assister au concert\u202F?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "Carr\u00E9ment\u202F!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "Finalement, j\u2019ai pas le temps..."
  },
  {
    "index": 6,
    "flags": 4,
    "text": "Alors\u202F? Ils \u00E9taient pas g\u00E9niaux\u202F?!\\nThe Maximizers, c\u2019est vraiment du bon son\u202F!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "Pas de souci\u202F!\\nReviens me voir si tu changes d\u2019avis\u202F!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "Zwiiing\u202F!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "Zwooong\u202F!"
  },
  {
    "index": 10,
    "flags": 0,
