[
  {
    "index": 0,
    "flags": 0,
    "text": "\u00E7a lui a fait plaisir"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\u00E7a l\u2019a bien amus\u00E9"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\u00E7a l\u2019a rendu heureux"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\u00E7a l\u2019a fait sourire"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\u00E7a l\u2019a \u00E9mu"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u00E7a l\u2019a rendu perplexe"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u00E7a l\u2019a mis de bonne humeur"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u00E7a lui a mis les larmes aux yeux"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\u00E7a lui a mis du baume au c\u0153ur"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\u00E7a l\u2019a rendu nerveux"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\u00E7a l\u2019a apais\u00E9"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\u00E7a chatouillait"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\u00E7a l\u2019a vraiment emball\u00E9"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\u00E7a lui a laiss\u00E9 un go\u00FBt amer"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\u00E7a lui a fait de la peine"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\u00E7a l\u2019a rendu nostalgique"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\u00E7a n\u2019\u00E9tait pas facile pour lui"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\u00E7a l\u2019a \u00E9puis\u00E9"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\u00E7a n\u2019\u00E9tait pas facile \u00E0 accepter"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\u00E7a l\u2019a rendu fier"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\u00E7a l\u2019a mis d\u2019humeur maussade"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\u00E7a l\u2019a rendu furieux"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\u00E7a l\u2019a rendu jaloux"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\u00E7a lui a donn\u00E9 sommeil"
  }
]
