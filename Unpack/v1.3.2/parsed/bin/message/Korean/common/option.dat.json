    "text": "\uD3EC\uCF13\uBAAC\uC744 \uC190\uC5D0 \uB123\uC5C8\uC744 \uB54C\\n\uB2C9\uB124\uC784\uC744 \uBD99\uC77C\uC9C0 \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "LAN \uBAA8\uB4DC\uB97C \uAE30\uB3D9 \uC911\uC785\uB2C8\uB2E4\\n\uC7A0\uC2DC \uAE30\uB2E4\uB824 \uC8FC\uC2ED\uC2DC\uC624"
  },
