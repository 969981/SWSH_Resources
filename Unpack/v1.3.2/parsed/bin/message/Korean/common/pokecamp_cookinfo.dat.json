    "index": 134,
    "flags": 0,
    "text": "\uBC00\uD06C\uC758 \uACE0\uAE09\uC2A4\uB7EC\uC6B4 \uB2E8\uB9DB\uACFC\\n\uB9CC\uB098\uC11C \uCE74\uB808 \uB8E8\uC758 \uB5AB\uC740\uB9DB\uC774\\n\uD6CC\uB96D\uD55C \uAC10\uCE60\uB9DB\uC73C\uB85C \uBC14\uB00C\uC5C8\uB2E4."
  },
  {
    "index": 135,
    "flags": 0,
    "text": "\uC0C1\uB2F9\uD788 \uB2EC\uCF64\uD55C \uCE74\uB808\uC9C0\uB9CC\\n\uBC00\uD06C\uC5D0\uC11C \uB098\uC628 \uB2E8\uB9DB\uC774\uAE30 \uB54C\uBB38\uC5D0\\n\uBB3C\uB9AC\uC9C0 \uC54A\uACE0 \uBA39\uC744 \uC218 \uC788\uB2E4."
  },
  {
    "index": 136,
    "flags": 0,
    "text": "\uBC00\uD06C\uC758 \uB2E8\uB9DB\uACFC \uAC10\uCE60\uB9DB\uC774\\n\uCE74\uB808 \uB8E8\uC758 \uC4F4\uB9DB\uC744 \uB9DB\uC788\uAC8C \uBC14\uAFD4\uC900\uB2E4.\\n\uAE30\uBC1C\uD55C \uB9DB\uC774\uB780 \uBC14\uB85C \uC774\uB7F0 \uAC83\uC774\uB2E4."
  },
  {
    "index": 137,
    "flags": 0,
    "text": "\uC80A\uC740\uC774\uB4E4\uC5D0\uAC8C \uC778\uAE30 \uC788\uB294 \uC694\uB9AC.\\n\uC2E0\uB9DB\uC774 \uB098\uB294 \uCE74\uB808 \uB8E8\uC640\\n\uBC00\uD06C\uC758 \uB2E8\uB9DB\uC774 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4."
  },
  {
    "index": 138,
    "flags": 0,
    "text": "\uB808\uD1A0\uB974\uD2B8\uBA74\uACFC \uCE74\uB808\uAC00\\n\uB9CC\uB098\uC790 \uC608\uC0C1\uD588\uB358 \uBC14\uC640 \uAC19\uC774\\n\uC778\uC2A4\uD134\uD2B8\uC2A4\uB7EC\uC6B4 \uB9DB\uC774 \uB9CC\uB4E4\uC5B4\uC84C\uB2E4."
  },
  {
    "index": 139,
    "flags": 0,
    "text": "\uC80A\uC740\uC774\uB4E4\uC758 \uCDE8\uD5A5\uC5D0 \uB9DE\uB294 \uB9DB\uC774\uB2E4.\\n\uB9E4\uC6B4 \uCE74\uB808 \uB8E8\uC640 \uB808\uD1A0\uB974\uD2B8\uBA74\uC740\\n\uC758\uC678\uB85C \uC798 \uC5B4\uC6B8\uB9B0\uB2E4."
  },
  {
    "index": 140,
    "flags": 0,
    "text": "\uB5AB\uC740\uB9DB\uC758 \uCE74\uB808 \uB8E8\uC640 \uC11E\uC600\uC744 \uB54C\\n\uB808\uD1A0\uB974\uD2B8\uBA74\uC740 \uD55C \uB2E8\uACC4 \uC704\uC758\\n\uB9DB\uC73C\uB85C \uC9C4\uD654\uD55C\uB2E4."
  },
  {
    "index": 141,
    "flags": 0,
    "text": "\uB808\uD1A0\uB974\uD2B8\uBA74\uC758 \uC778\uACF5\uC801\uC778\\n\uAC10\uCE60\uB9DB\uC740 \uB2E8\uB9DB\uC758 \uCE74\uB808 \uB8E8\uC640\\n\uAD81\uD569\uC774 \uC798 \uB9DE\uB294\uB2E4."
  },
  {
    "index": 142,
    "flags": 0,
    "text": "\uC4F4\uB9DB\uC774 \uAC15\uD55C \uCE74\uB808 \uB8E8\uAC00\\n\uB808\uD1A0\uB974\uD2B8\uBA74\uC744 \uD6CC\uB96D\uD55C\\n\uB9DB\uC73C\uB85C \uD0C8\uBC14\uAFC8\uC2DC\uCF30\uB2E4."
  },
  {
    "index": 143,
    "flags": 0,
    "text": "\uB808\uD1A0\uB974\uD2B8\uBA74\uC758 \uBD80\uC871\uD55C \uBD80\uBD84\uC744\\n\uCE74\uB808 \uB8E8\uC758 \uAC15\uD55C \uC2E0\uB9DB\uC774\\n\uBCF4\uC644\uD574\uC918\uC11C \uAF64 \uB9DB\uC788\uB2E4."
  },
  {
    "index": 144,
    "flags": 0,
    "text": "\uD584\uBC84\uADF8\uB97C \uC73C\uAE68\uC11C\\n\uCE74\uB808\uC5D0 \uBE44\uBCBC \uBA39\uC73C\uBA74\\n\uAD49\uC7A5\uD55C \uB9DB\uC774 \uB41C\uB2E4."
  },
  {
    "index": 145,
    "flags": 0,
    "text": "\uB9E4\uC6B4\uB9DB\uC774 \uB098\uB294 \uCE74\uB808 \uB8E8\uC640 \uC721\uC999\uC774 \uAC00\uB4DD\uD55C\\n\uD584\uBC84\uADF8\uC758 \uD6CC\uB96D\uD55C \uCF64\uBE44\uB124\uC774\uC158 \uB54C\uBB38\uC5D0\\n\uC21F\uAC00\uB77D\uC9C8\uC744 \uBA48\uCD9C \uC218 \uC5C6\uAC8C \uB41C\uB2E4."
  },
  {
    "index": 146,
    "flags": 0,
    "text": "\uC790\uCE6B\uD558\uBA74 \uB290\uB07C\uD574\uC9C8 \uC218\uB3C4 \uC788\uB294\\n\uD584\uBC84\uADF8\uB97C \uCE74\uB808 \uB8E8\uC758 \uB5AB\uC740\uB9DB\uC774\\n\uC7A1\uC544\uC918\uC11C \uBA39\uAE30 \uD3B8\uD558\uB2E4."
  },
  {
    "index": 147,
    "flags": 0,
    "text": "\uCDE8\uD5A5\uC744 \uD0C0\uB294 \uC694\uB9AC\uB2E4.\\n\uB2EC\uCF64\uD55C \uCE74\uB808 \uB8E8\uC640 \uD584\uBC84\uADF8\uC758\\n\uC870\uD569\uC740 \uB9E4\uC6B0 \uB3C5\uD2B9\uD55C \uB9DB\uC774 \uB09C\uB2E4."
  },
  {
    "index": 148,
    "flags": 0,
    "text": "\uB290\uB07C\uD55C \uD584\uBC84\uADF8\uC640\\n\uC4F4\uB9DB\uC758 \uCE74\uB808 \uB8E8\uAC00 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4.\\n\uC2E4\uD328\uD558\uAE30 \uD798\uB4E0 \uC694\uB9AC\uB2E4."
  },
  {
    "index": 149,
    "flags": 0,
    "text": "\uD1A1 \uC3D8\uB294 \uC2E0\uB9DB\uC758 \uCE74\uB808 \uB8E8\uAC00\\n\uD584\uBC84\uADF8\uC758 \uAC10\uCE60\uB9DB\uC744\\n\uB04C\uC5B4\uB0B4\uB294 \uB9DB\uC788\uB294 \uC694\uB9AC."
  },
  {
    "index": 150,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uB77C\uB294 \uC774\uB984\uC5D0\\n\uBD80\uB044\uB7FD\uC9C0 \uC54A\uAC8C \uC5B4\uB9C8\uC5B4\uB9C8\uD55C\\n\uAC10\uCE60\uB9DB\uC774 \uD718\uBAB0\uC544\uCE58\uB294 \uCE74\uB808."
  }
]
