[
  {
    "index": 0,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB9C8\uC0B4\uB77C\uC758 \uD5A5\uC774\\n\uCF54\uB05D\uC744 \uAC04\uC9C8\uC774\uB294 \uB9E4\uC6B0 \uB9E4\uC6B0\\n\uC2EC\uD50C\uD55C \uAE30\uBCF8\uC801\uC778 \uCE74\uB808."
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB9C8\uC0B4\uB77C\uC758 \uD5A5\uC5D0\\n\uC2EC\uD50C\uD55C \uB9E4\uC6B4\uB9DB\uC774 \uB3CB\uBCF4\uC774\uB294\\n\uC9C0\uADF9\uD788 \uAE30\uBCF8\uC801\uC778 \uCE74\uB808."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB9C8\uC0B4\uB77C\uC758 \uD5A5\uC5D0\\n\uAC15\uD55C \uB5AB\uC740\uB9DB\uC774 \uB3CB\uBCF4\uC774\uB294\\n\uBA39\uAE30 \uC88B\uC740 \uAE30\uBCF8\uC801\uC778 \uCE74\uB808."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB9C8\uC0B4\uB77C\uC758 \uD5A5\uC5D0\\n\uAC15\uD55C \uB2E8\uB9DB\uC73C\uB85C \uD3EC\uC778\uD2B8\uB97C \uC900\\n\uBAA8\uB450\uAC00 \uC88B\uC544\uD558\uB294 \uCE74\uB808."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB9C8\uC0B4\uB77C\uC758 \uD5A5\uC774\\n\uC4F4\uB9DB\uC744 \uB354\uC6B1 \uB3CB\uBCF4\uC774\uAC8C \uD558\uB294\\n\uC9C0\uADF9\uD788 \uAE30\uBCF8\uC801\uC778 \uCE74\uB808."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB9C8\uC0B4\uB77C\uC758 \uD5A5\uC774\\n\uC2E0\uB9DB\uC744 \uC21C\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uB294\\n\uB9E4\uC6B0 \uC2EC\uD50C\uD55C \uCE74\uB808."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC2EC\uD50C\uD558\uAC8C \uAC04\uC744 \uD558\uC5EC\\n\uC0B6\uC740 \uC18C\uC2DC\uC9C0\uC758\\n\uB9DB\uC774 \uB3CB\uBCF4\uC774\uB294 \uCE74\uB808."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB9E4\uC6B4\uB9DB\uC774 \uB098\uB294 \uCE74\uB808 \uB8E8\uC758\\n\uC601\uD5A5\uC73C\uB85C \uC18C\uC2DC\uC9C0\uC758 \uAC10\uCE60\uB9DB\uC774\\n\uB354\uC6B1 \uB450\uB4DC\uB7EC\uC9C0\uB294 \uCE74\uB808."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC18C\uC2DC\uC9C0\uC758 \uB290\uB07C\uD568\uC744\\n\uB5AB\uC740 \uCE74\uB808 \uB8E8\uAC00 \uC7A1\uC544\uC918\uC11C\\n\uB9E4\uC6B0 \uBA39\uAE30 \uC88B\uC740 \uCE74\uB808."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC18C\uC2DC\uC9C0\uC758 \uAC10\uCE60\uB9DB\uACFC\\n\uB2EC\uCF64\uD55C \uCE74\uB808 \uB8E8\uAC00\\n\uC870\uD654\uB97C \uC774\uB8E8\uB294 \uC138\uB828\uB41C \uCE74\uB808."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC18C\uC2DC\uC9C0\uC758 \uC2DD\uAC10\uACFC\\n\uC501\uC4F8\uD55C \uCE74\uB808 \uB8E8\uAC00 \uC870\uD654\uB97C \uC774\uB8E8\uB294\\n\uC57D\uAC04 \uC5B4\uB978 \uCDE8\uD5A5\uC758 \uCE74\uB808."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC2E0\uB9DB\uC774 \uB3CB\uBCF4\uC774\uB294 \uCE74\uB808 \uB8E8\uC640\\n\uC9C4\uD55C \uAC10\uCE60\uB9DB\uC774 \uB098\uB294 \uC18C\uC2DC\uC9C0\uAC00\\n\uC2DD\uC695\uC744 \uC790\uADF9\uD558\uB294 \uCE74\uB808."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBC25\uC758 \uBE44\uBC00 \uC2DD\uC7AC\uB8CC \uB355\uBD84\uC5D0\\n\uB180\uB77C\uC6B8 \uC815\uB3C4\uC758 \uC591\uACFC\\n\uAC15\uD55C \uD48D\uBBF8\uB97C \uC990\uAE38 \uC218 \uC788\uB294 \uCE74\uB808."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAE4A\uC740 \uB9E4\uC6B4\uB9DB\uACFC\\n\uD1A1 \uC3D8\uB294 \uAC74\uB354\uAE30\uC758\\n\uB9CC\uB0A8\uC774 \uAE30\uC801\uC744 \uC77C\uC73C\uCF30\uB2E4."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB5AB\uC740\uB9DB\uACFC \uAE30\uB984\uC758 \uD558\uBAA8\uB2C8\uB294\\n\uB0A8\uB140\uB178\uC18C\uAC00 \uC88B\uC544\uD558\uB294\\n\uC775\uC219\uD558\uACE0 \uC548\uC815\uB41C \uB9DB\uC744 \uB0B8\uB2E4."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBBF8\uC2A4\uB9E4\uCE58\uB85C \uC5EC\uACA8\uC9C8 \uC218 \uC788\uB294 \uC870\uD569\uC774\\n\uD48D\uBD80\uD568\uACFC \uBD80\uB4DC\uB7EC\uC6C0\uC744 \uB3D9\uC2DC\uC5D0 \uC7A1\uC544\\n\uBE44\uD560 \uB370 \uC5C6\uB294 \uB9DB\uC744 \uC790\uC544\uB0B8\uB2E4."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC9C4\uD55C \uAE30\uB984 \uC18D\uC5D0\uC11C\\n\uCE74\uB808 \uB8E8\uC758 \uC4F4\uB9DB\uC774 \uD76C\uBBF8\uD558\uAC8C\uB098\uB9C8\\n\uC874\uC7AC\uAC10\uC744 \uB098\uD0C0\uB0B4\uB294 \uCE74\uB808."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC2E0\uB9DB\uC73C\uB85C \uAC74\uB354\uAE30\uC758 \uB3C5\uD2B9\uD55C \uB9DB\uC744\\n\uC911\uD654\uD558\uBA74\uC11C \uAC10\uCE60\uB9DB\uB9CC\uC744\\n\uB3CB\uBCF4\uC774\uAC8C \uD558\uB294 \uB370 \uC131\uACF5\uD588\uB2E4."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBE44\uBC00\uB9AC\uC5D0 \uC804\uD574\uC838 \uB0B4\uB824\uC624\uB294\\n\uBC14\uD06C\uC758 \uC2DD\uC7AC\uB8CC\uB97C\\n\uC0AC\uC6A9\uD55C \uADC0\uC911\uD55C \uCE74\uB808."
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uAC10\uCE60\uB9DB\uC774 \uAC15\uD55C \uC2DD\uC7AC\uB8CC\uC640\\n\uB9E4\uC6B4\uB9DB\uC774 \uB098\uB294 \uCE74\uB808 \uB8E8\uB294\\n\uC815\uC11D\uC801\uC778 \uC870\uD569\uC73C\uB85C \uC77C\uCEEC\uC5B4\uC9C4\uB2E4."
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCE74\uB808 \uB8E8\uC758 \uC0B0\uB73B\uD558\uACE0 \uB5AB\uC740\uB9DB \uB355\uBD84\uC5D0\\n\uC9C4\uD55C \uB9DB\uC774 \uB098\uB294 \uC7AC\uB8CC\uAC00\\n\uD55C\uCE35 \uB354 \uB3CB\uBCF4\uC774\uB294 \uCE74\uB808."
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uAC15\uD55C \uB2E8\uB9DB\uACFC \uAE4A\uACE0 \uC9C4\uD55C \uB9DB.\\n\uC790\uCE6D \uCE74\uB808 \uC804\uBB38\uAC00\uB77C\uBA74\\n\uAF2D \uBA39\uC5B4\uBD10\uC57C \uD560 \uC694\uB9AC\uB2E4."
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uD600\uAC00 \uB9C8\uBE44\uB420 \uC815\uB3C4\uC758 \uAC10\uCE60\uB9DB.\\n\uC501\uC4F8\uD558\uAC8C \uAC04\uC744 \uD55C \uB355\uBD84\uC5D0\\n\uC7AC\uB8CC\uC758 \uB9DB\uC774 \uB354 \uC0B4\uC544\uB09C \uB290\uB08C\uC774\uB2E4."
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC2E0\uB9DB\uC774 \uB098\uB294 \uCE74\uB808 \uB8E8\uC640\\n\uC11E\uC778 \uAC74\uB354\uAE30\uB294\\n\uC544\uBB34\uB9AC \uBA39\uC5B4\uB3C4 \uC9C8\uB9AC\uC9C0 \uC54A\uB294\uB2E4."
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC815\uC11D\uC801\uC778 \uCE74\uB808 \uB8E8\uC640\\n\uC801\uB2F9\uD788 \uC0B6\uC740 \uCF69\uC758 \uC870\uD654\uB294\\n\uC2E4\uB85C \uC18C\uBC15\uD55C \uB9DB\uC774 \uC544\uB2D0 \uC218 \uC5C6\uB2E4."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uCE74\uB808 \uB8E8\uAC00 \uAC00\uC9C4 \uAC15\uD55C \uB9E4\uC6B4\uB9DB\uACFC\\n\uCF69\uC774 \uAC00\uC9C4 \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uB2E8\uB9DB\uC758\\n\uB300\uBE44\uB97C \uC990\uAE38 \uC218 \uC788\uB2E4."
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uCE74\uB808 \uB8E8\uC758 \uB5AB\uC740\uB9DB\uACFC\\n\uCF69\uC758 \uC2EC\uD50C\uD558\uACE0 \uAC00\uBCBC\uC6B4 \uAC10\uCE60\uB9DB.\\n\uC18C\uBC15\uD558\uC9C0\uB9CC \uC9C8\uB9AC\uC9C0 \uC54A\uB294\uB2E4."
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB2E8\uB9DB\uC774 \uB098\uB294 \uB4EF\uD558\uB2E4\uAC00\\n\uB2F4\uBC31\uD55C \uCF69\uC774 \uBD80\uB4DC\uB7EC\uC6C0\uC744 \uB354\uD574\\n\uAE4A\uC740 \uB9DB\uC744 \uC790\uC544\uB0B8\uB2E4."
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uCE74\uB808 \uB8E8\uC758 \uC4F4\uB9DB\uC774 \uCF69\uC758\\n\uB3C5\uD2B9\uD55C \uB9DB\uC744 \uC911\uD654\uD574\uC900\uB2E4.\\n\uCF69\uC744 \uC2EB\uC5B4\uD558\uB294 \uC0AC\uB78C\uB3C4 \uC798 \uBA39\uB294\uB2E4."
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC539\uC744\uC218\uB85D \uAE30\uBD84 \uC88B\uC740 \uCF69\uC758\\n\uC2DD\uAC10\uC774 \uC0C8\uCF64\uD55C \uCE74\uB808 \uB8E8\uC640\\n\uD6CC\uB96D\uD55C \uD558\uBAA8\uB2C8\uB97C \uC77C\uAD88\uB0B8\uB2E4."
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB450 \uC885\uB958\uC758 \uD0C4\uC218\uD654\uBB3C\uC774 \uB4E4\uC5B4\uAC00\\n\uBC30\uBD80\uB974\uC9C0 \uC54A\uC744 \uC218 \uC5C6\uB294\\n\uADF8\uC57C\uB9D0\uB85C \uCD08\uBCF4\uC790\uC758 \uC694\uB9AC."
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB9C8\uAD6C\uC7A1\uC774\uB85C \uC62C\uB77C\uAC04 \uD1A0\uC2A4\uD2B8\uB3C4\\n\uB9E4\uCF64\uD55C \uCE74\uB808 \uB8E8 \uB355\uBD84\uC5D0\\n\uC758\uC678\uB85C \uB05D\uAE4C\uC9C0 \uC2F9\uC2F9 \uBA39\uC744 \uC218 \uC788\uB2E4."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uBA3C\uC800 \uD1A0\uC2A4\uD2B8\uB97C \uCC22\uC5B4\uC11C\\n\uCE74\uB808 \uB8E8\uC640 \uC798 \uC11E\uC73C\uBA74 \uB5AB\uC740\uB9DB\uC774\\n\uC21C\uD574\uC838\uC11C \uBA39\uAE30 \uD3B8\uD574\uC9C4\uB2E4."
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uACE0\uC18C\uD55C \uD1A0\uC2A4\uD2B8\uC5D0 \uB2EC\uCF64\uD55C\\n\uCE74\uB808 \uB8E8\uB97C \uC7BC\uCC98\uB7FC \uBC1C\uB77C\uC11C\\n\uBA39\uC73C\uBA74 \uC2E0\uAE30\uD558\uAC8C\uB3C4 \uB9DB\uC788\uB2E4."
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uB178\uB987\uB178\uB987\uD558\uAC8C \uAD6C\uC6B4 \uD1A0\uC2A4\uD2B8\uC758\\n\uD48D\uBBF8\uC640 \uCE74\uB808 \uB8E8\uC758 \uC4F4\uB9DB\uC774\\n\uC2E0\uAE30\uD558\uAC8C\uB3C4 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4."
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uBD80\uB4DC\uB7EC\uC6B4 \uB9DB\uC758 \uD1A0\uC2A4\uD2B8\uAC00\\n\uC2E0\uB9DB\uC774 \uB098\uB294 \uCE74\uB808 \uB8E8\uC5D0\\n\uAE4A\uC774\uB97C \uB354\uD574\uC900\uB2E4."
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uCE74\uB808\uB77C\uC774\uC2A4\uC640 \uCE74\uB808\uD30C\uC2A4\uD0C0\uB97C\\n\uB3D9\uC2DC\uC5D0 \uC990\uAE38 \uC218 \uC788\uB294 \uC694\uB9AC.\\n\uACF5\uBCF5\uC77C \uB54C \uBA39\uC73C\uBA74 \uC88B\uB2E4."
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB9E4\uC6B4\uB9DB\uC744 \uC0B4\uB9AC\uAE30 \uC704\uD574\\n\uCC98\uC74C\uBD80\uD130 \uC804\uBD80 \uC11E\uC740 \uB2E4\uC74C\uC5D0\\n\uBA39\uB294 \uAC83\uC744 \uCD94\uCC9C\uD55C\uB2E4."
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uB5AB\uC740\uB9DB\uC774 \uD30C\uC2A4\uD0C0\uC5D0\uB3C4 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4.\\n\uB77C\uC774\uC2A4\uC640 \uD30C\uC2A4\uD0C0\\n\uB450 \uC885\uB958\uC758 \uD0C4\uC218\uD654\uBB3C\uC744 \uC990\uAE30\uC790."
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uAC89\uBCF4\uAE30\uC640 \uB2E4\uB974\uAC8C \uB9DB\uC740 \uC88B\uB2E4.\\n\uC801\uB2F9\uD788 \uB2EC\uCF64\uD55C \uCE74\uB808\uB294\\n\uD30C\uC2A4\uD0C0\uC5D0\uB3C4 \uB77C\uC774\uC2A4\uC5D0\uB3C4 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4."
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC501\uC4F8\uD558\uBA74\uC11C\uB3C4 \uB18D\uD6C4\uD55C \uB9DB\uC740\\n\uD30C\uC2A4\uD0C0\uAC00 \uB4E4\uC5B4 \uC788\uAE30 \uB54C\uBB38\uC5D0\\n\uC808\uBB18\uD558\uAC8C \uC870\uD654\uB97C \uC774\uB8EC\uB2E4."
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uB77C\uC774\uC2A4\uB3C4 \uD30C\uC2A4\uD0C0\uB3C4 \uBA39\uACE0 \uC2F6\uC740\\n\uC695\uC2EC\uC7C1\uC774\uC5D0\uAC8C \uCD94\uCC9C\uD55C\uB2E4. \uC2E0\uB9DB\uC774 \uAC15\uD55C\\n\uCE74\uB808 \uB8E8\uB294 \uC2DD\uC695\uC744 \uB3CB\uAC8C \uD55C\uB2E4."
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC5EC\uB7EC \uC885\uB958\uC758 \uBC84\uC12F\uC758 \uAC10\uCE60\uB9DB\uC774\\n\uCE74\uB808 \uB8E8\uC5D0 \uB179\uC544\uB4E4\uC5B4 \uCD5C\uACE0\uC758\\n\uC694\uB9AC\uAC00 \uC644\uC131\uB418\uC5C8\uB2E4."
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uBC84\uC12F\uC758 \uAC10\uCE60\uB9DB\uC744 \uB04C\uC5B4\uB0B4\uB294\\n\uBE44\uACB0\uC740 \uAC00\uB2A5\uD55C \uD55C \uCE74\uB808 \uB8E8\uC758\\n\uB9E4\uC6B4\uB9DB\uC744 \uAC15\uD558\uAC8C \uD558\uB294 \uAC83\uC774\uB2E4."
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uB2E4\uC591\uD55C \uBC84\uC12F\uC758 \uB9DB\uC774\\n\uC11C\uB85C \uC5B4\uC6B0\uB7EC\uC9C0\uBA74\uC11C \uCE74\uB808 \uB8E8\uC758\\n\uB5AB\uC740\uB9DB\uC744 \uBD80\uB4DC\uB7FD\uAC8C \uC7A1\uC544\uC900\uB2E4."
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uB2EC\uCF64\uD55C \uCE74\uB808 \uB8E8\uB97C \uB450\uB978\\n\uBC84\uC12F\uB4E4\uC758 \uCAC4\uAE43\uD55C\\n\uC2DD\uAC10\uC744 \uC990\uAE38 \uC218 \uC788\uB294 \uCE74\uB808."
