  },
  {
    "index": 95,
    "flags": 0,
    "text": "\uBA78\uB9DD\uC758\uB178\uB798\uB97C \uB4E4\uC740\\n\uBAA8\uB4E0 \uD3EC\uCF13\uBAAC\uC774\\n3\uD134 \uD6C4\uC5D0 \uAE30\uC808\uD55C\uB2E4."
