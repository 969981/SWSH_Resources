    "text": "\uD0C0\uC785\uC5D0 \uD480\uD0C0\uC785\uC774 \uCD94\uAC00\uB41C\uB2E4."
  },
  {
    "index": 104,
    "flags": 0,
    "text": "\uC528\uBFCC\uB9AC\uAE30"
  },
  {
    "index": 105,
    "flags": 0,
    "text": "\uD134 \uB9C8\uC9C0\uB9C9\uC5D0\\n\uC528\uBFCC\uB9AC\uAE30\uC5D0 \uC758\uD574 HP\uB97C \uBE7C\uC557\uACA8\\n\uC0C1\uB300\uB97C \uD68C\uBCF5\uC2DC\uD0A8\uB2E4."
