  },
  {
    "index": 97,
    "flags": 0,
    "text": "\uAD50\uCCB4\uD55C \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uB370\uBBF8\uC9C0\uB97C \uC900\uB2E4.\\n\uBE44\uD589\uD0C0\uC785\uC774\uB098 \uD2B9\uC131 \uBD80\uC720\uC758\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB294 \uB9DE\uC9C0 \uC54A\uB294\uB2E4."
  },
  {
    "index": 98,
    "flags": 0,
    "text": "\uBB3C\uB180\uC774"
  },
  {
    "index": 99,
    "flags": 0,
    "text": "5\uD134 \uB3D9\uC548\\n\uBD88\uAF43\uD0C0\uC785 \uAE30\uC220\uC758 \uC704\uB825\uC774\\n\uC808\uBC18\uC73C\uB85C \uC904\uC5B4\uB4E0\uB2E4."
  },
  {
    "index": 100,
    "flags": 0,
    "text": "\uAE38\uB3D9\uBB34"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "\uC790\uC2E0\uC744 \uAE30\uC808\uC2DC\uD0A8 \uC0C1\uB300\uB97C\\n\uAE38\uB3D9\uBB34\uB85C \uC0BC\uC544 \uAE30\uC808\uC2DC\uD0A8\uB2E4."
