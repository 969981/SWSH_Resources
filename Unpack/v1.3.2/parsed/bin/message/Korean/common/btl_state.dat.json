  {
    "index": 106,
    "flags": 0,
    "text": "\uB85D\uC628"
  },
  {
    "index": 107,
    "flags": 0,
    "text": "\uB85D\uC628\uD55C \uC0C1\uB300\uC5D0\uAC8C\\n\uAE30\uC220\uC744 \uBC18\uB4DC\uC2DC \uBA85\uC911\uC2DC\uD0A8\uB2E4."
  },
  {
    "index": 108,
    "flags": 0,
    "text": "\uBC14\uC778\uB4DC"
  },
  {
    "index": 109,
    "flags": 0,
    "text": "\uC870\uC774\uAE30\uB97C \uB2F9\uD574\uC11C\\n\uB9E4 \uD134 \uB370\uBBF8\uC9C0\uB97C \uBC1B\uB294\uB2E4."
