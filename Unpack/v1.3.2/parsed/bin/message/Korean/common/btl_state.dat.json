    "text": "\uD398\uC5B4\uB9AC\uB85D"
  },
  {
    "index": 131,
    "flags": 0,
    "text": "\uAE30\uC220\uC744 \uC0AC\uC6A9\uD55C \uB2E4\uC74C \uD134\uC740\\n\uBAA8\uB4E0 \uD3EC\uCF13\uBAAC\uC744 \uB3C4\uB9DD\uAC00\uC9C0 \uBABB\uD558\uAC8C \uD55C\uB2E4."
