  },
  {
    "index": 121,
    "flags": 0,
    "text": "\uAE30\uC220\uC744 \uC0AC\uC6A9\uD55C 2\uD134\\n\uB4A4\uC5D0 \uB370\uBBF8\uC9C0\uB97C \uBC1B\uB294\uB2E4."
  },
  {
    "index": 122,
    "flags": 0,
    "text": "\uC18C\uB780\uD53C\uAE30"
  },
  {
    "index": 123,
    "flags": 0,
    "text": "3\uD134 \uB3D9\uC548 \uC18C\uB780 \uD53C\uC6CC\\n\uACF5\uACA9\uD55C\uB2E4.\\n\uADF8\uB3D9\uC548\uC740\\n\uC544\uBB34\uB3C4 \uC7A0\uB4E4\uC9C0 \uC54A\uAC8C \uB41C\uB2E4."
  },
  {
    "index": 124,
    "flags": 0,
    "text": "\uC544\uCFE0\uC544\uB9C1"
  },
  {
    "index": 125,
    "flags": 0,
    "text": "\uC790\uC2E0\uC758 \uBAB8 \uC8FC\uBCC0\uC744\\n\uBB3C\uB85C \uB9CC\uB4E0 \uBCA0\uC77C\uB85C \uB36E\uB294\uB2E4.\\n\uB9E4 \uD134 HP\uB97C \uD68C\uBCF5\uD55C\uB2E4."
