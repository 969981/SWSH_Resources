  {
    "index": 110,
    "flags": 0,
    "text": "\uCC38\uAE30"
  },
  {
    "index": 111,
    "flags": 0,
    "text": "2\uD134 \uB3D9\uC548\\n\uACF5\uACA9\uC744 \uACAC\uB38C\\n\uC785\uC740 \uB370\uBBF8\uC9C0\uB97C 2\uBC30\uB85C \uB9CC\uB4E4\uC5B4\\n\uC0C1\uB300\uC5D0\uAC8C \uB3CC\uB824\uC900\uB2E4."
