[
  {
    "index": 0,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB9AC\uC790\uBABD\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uBD88\uAF43\uD0C0\uC785 \uACF5\uACA9.\\n4\uD134 \uB3D9\uC548 \uB370\uBBF8\uC9C0\uB97C \uC900\uB2E4."
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uBC84\uD130\uD50C\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uBC8C\uB808\uD0C0\uC785 \uACF5\uACA9.\\n\uB3C5 \uB9C8\uBE44 \uC7A0\uB4E6 \uC911 \uC5B4\uB290 \uD558\uB098\uB85C \uB9CC\uB4E0\uB2E4."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uD53C\uCE74\uCE04\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uC804\uAE30\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uB97C \uB9C8\uBE44 \uC0C1\uD0DC\uB85C \uB9CC\uB4E0\uB2E4."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB098\uC639\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uB178\uB9D0\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uB97C \uD63C\uB780\uC2DC\uD0A4\uACE0 \uB3C8\uB3C4 \uBC1B\uC744 \uC218 \uC788\uB2E4."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uAD34\uB825\uBAAC\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uACA9\uD22C\uD0C0\uC785 \uACF5\uACA9.\\n\uAE09\uC18C\uC5D0 \uB9DE\uAE30 \uC26C\uC6CC\uC9C4\uB2E4."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uD32C\uD140\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uACE0\uC2A4\uD2B8\uD0C0\uC785 \uACF5\uACA9.\\n\uADF8\uB9BC\uC790\uB97C \uBC1F\uC544 \uAD50\uCCB4\uD560 \uC218 \uC5C6\uAC8C \uD55C\uB2E4."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB77C\uD504\uB77C\uC2A4\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uC5BC\uC74C\uD0C0\uC785 \uACF5\uACA9.\\n5\uD134 \uB3D9\uC548 \uB370\uBBF8\uC9C0\uB97C \uC57D\uD558\uAC8C \uD55C\uB2E4."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC774\uBE0C\uC774\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uB178\uB9D0\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uB97C \uD5E4\uB871\uD5E4\uB871\uD558\uAC8C \uB9CC\uB4E0\uB2E4."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC7A0\uB9CC\uBCF4\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uB178\uB9D0\uD0C0\uC785 \uACF5\uACA9.\\n\uBA39\uC740 \uB098\uBB34\uC5F4\uB9E4\uB97C \uC7AC\uC0DD\uD55C\uB2E4."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB354\uC2A4\uD2B8\uB098\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uB3C5\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uB97C \uB3C5 \uC0C1\uD0DC\uB85C \uB9CC\uB4E0\uB2E4."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uAC08\uAC00\uBD80\uAE30\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uBB3C\uD0C0\uC785 \uACF5\uACA9.\\n\uC608\uB9AC\uD55C \uBC14\uC704\uB97C \uBB34\uC218\uD788 \uBFCC\uB9B0\uB2E4."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC544\uBA38\uAE4C\uC624\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uBE44\uD589\uD0C0\uC785 \uACF5\uACA9.\\n\uB9AC\uD50C\uB809\uD130\uB098 \uBE5B\uC758\uC7A5\uB9C9\uC744 \uC5C6\uC564\uB2E4."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC2A4\uD2B8\uB9B0\uB354\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uC804\uAE30\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uB97C \uB3C5 \uB610\uB294 \uB9C8\uBE44 \uC5B4\uB290 \uD558\uB098\uB85C \uB9CC\uB4E0\uB2E4."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB9C8\uD718\uD551\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uD398\uC5B4\uB9AC\uD0C0\uC785 \uACF5\uACA9.\\n\uAC19\uC740 \uD3B8\uC758 HP\uB97C \uD68C\uBCF5\uD55C\uB2E4."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB450\uB784\uB8E8\uB3C8\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uB4DC\uB798\uACE4\uD0C0\uC785 \uACF5\uACA9.\\n\uB9C8\uC9C0\uB9C9\uC5D0 \uC0AC\uC6A9\uD55C \uAE30\uC220\uC758 PP\uB97C \uC904\uC778\uB2E4."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC774\uC62C\uBE0C\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uC5D0\uC2A4\uD37C\uD0C0\uC785 \uACF5\uACA9.\\n5\uD134 \uB3D9\uC548 \uC911\uB825\uC774 \uBC14\uB010\uB2E4."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC11D\uD0C4\uC0B0\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uBC14\uC704\uD0C0\uC785 \uACF5\uACA9.\\n4\uD134 \uB3D9\uC548 \uB370\uBBF8\uC9C0\uB97C \uC900\uB2E4."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC0AC\uB2E4\uC774\uC0AC\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uB545\uD0C0\uC785 \uACF5\uACA9.\\n4-5\uD134 \uB3D9\uC548 \uAC70\uCE5C \uBAA8\uB798\uBC14\uB78C\uC774 \uBD84\uB2E4."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC624\uB871\uD138\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uC545\uD0C0\uC785 \uACF5\uACA9.\\n\uD070 \uD558\uD488\uC73C\uB85C \uC878\uC74C\uC744 \uC720\uB3C4\uD55C\uB2E4."
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC560\uD504\uB8E1\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uD480\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uC758 \uD68C\uD53C\uC728\uC744 \uB5A8\uC5B4\uB728\uB9B0\uB2E4."
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB2E8\uC9C0\uB798\uD50C\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uD480\uD0C0\uC785 \uACF5\uACA9.\\n\uAC19\uC740 \uD3B8\uC758 \uC0C1\uD0DC \uC774\uC0C1\uC744 \uD68C\uBCF5\uD55C\uB2E4."
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uBE0C\uB9AC\uBB34\uC74C\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uD398\uC5B4\uB9AC\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uB97C \uD63C\uB780\uC2DC\uD0A8\uB2E4."
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB300\uC655\uB07C\uB9AC\uB3D9\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uAC15\uCCA0\uD0C0\uC785 \uACF5\uACA9.\\n\uC608\uB9AC\uD55C \uAC00\uC2DC\uB97C \uBB34\uC218\uD788 \uBFCC\uB9B0\uB2E4."
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uBA5C\uBA54\uD0C8\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uAC15\uCCA0\uD0C0\uC785 \uACF5\uACA9.\\n\uB611\uAC19\uC740 \uAE30\uC220\uC744 \uC5F0\uC18D\uC73C\uB85C \uC4F8 \uC218 \uC5C6\uAC8C \uD55C\uB2E4."
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uD0B9\uD06C\uB7A9\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uBB3C\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uC758 \uC2A4\uD53C\uB4DC\uB97C \uD06C\uAC8C \uB5A8\uC5B4\uB728\uB9B0\uB2E4."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uB2E4\uD0DC\uC6B0\uC9C0\uB124\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uBD88\uAF43\uD0C0\uC785 \uACF5\uACA9.\\n4-5\uD134 \uB3D9\uC548 \uBD88\uAF43 \uC18D\uC5D0 \uAC00\uB454\uB2E4."
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC774\uC0C1\uD574\uAF43\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uD480\uD0C0\uC785 \uACF5\uACA9.\\n4\uD134 \uB3D9\uC548 \uB370\uBBF8\uC9C0\uB97C \uC900\uB2E4."
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uAC70\uBD81\uC655\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uBB3C\uD0C0\uC785 \uACF5\uACA9.\\n4\uD134 \uB3D9\uC548 \uB370\uBBF8\uC9C0\uB97C \uC900\uB2E4."
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uACE0\uB9B4\uD0C0\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uD480\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uC758 \uD2B9\uC131\uC5D0 \uC601\uD5A5\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC5D0\uC774\uC2A4\uBC88\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uBD88\uAF43\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uC758 \uD2B9\uC131\uC5D0 \uC601\uD5A5\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC778\uD154\uB9AC\uB808\uC628\uC774\\n\uC0AC\uC6A9\uD558\uB294 \uBB3C\uD0C0\uC785 \uACF5\uACA9.\\n\uC0C1\uB300\uC758 \uD2B9\uC131\uC5D0 \uC601\uD5A5\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC6B0\uB77C\uC624\uC2A4\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uC545\uD0C0\uC785 \uACF5\uACA9.\\n\uB2E4\uC774\uC6D4\uC744 \uBB34\uC2DC\uD558\uB294 \uC77C\uACA9\uC744 \uB0A0\uB9B0\uB2E4."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD55C \uC6B0\uB77C\uC624\uC2A4\uAC00\\n\uC0AC\uC6A9\uD558\uB294 \uBB3C\uD0C0\uC785 \uACF5\uACA9.\\n\uB2E4\uC774\uC6D4\uC744 \uBB34\uC2DC\uD558\uB294 \uC5F0\uACA9\uC744 \uB0A0\uB9B0\uB2E4."
  }
