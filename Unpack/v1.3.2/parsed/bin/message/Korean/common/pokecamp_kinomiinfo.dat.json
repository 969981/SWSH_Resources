[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB9E4\uCF64\uD55C \uB9DB\uC774 \uC911\uB3C5\uC131 \uC788\uB2E4.\\n\uC694\uB9AC \uCD08\uBCF4\uC790\uB77C\uB3C4\\n\uC4F0\uAE30 \uC26C\uC6B4 \uC2EC\uD50C\uD55C \uB098\uBB34\uC5F4\uB9E4."
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC740\uC740\uD55C \uB5AB\uC740\uB9DB\uC774\\n\uB290\uB07C\uD55C \uC7AC\uB8CC\uC640 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4\uACE0\\n\uD638\uD3C9\uC774 \uC790\uC790\uD55C \uB098\uBB34\uC5F4\uB9E4."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAE54\uB054\uD55C \uB2E8\uB9DB \uB54C\uBB38\uC5D0 \uC778\uAE30\uAC00 \uC788\uB2E4.\\n\uC190\uC5D0 \uB123\uAE30 \uC26C\uC6CC\uC11C \uC694\uB9AC\uC5D0\uB3C4\\n\uC790\uC8FC \uB4E4\uC5B4\uAC00\uB294 \uB098\uBB34\uC5F4\uB9E4."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC57D\uAC04\uC758 \uC4F4\uB9DB\uC774 \uC694\uB9AC\uC758\\n\uD3EC\uC778\uD2B8\uAC00 \uB418\uC5B4\uC8FC\uAE30 \uB54C\uBB38\uC5D0\\n\uC870\uBBF8\uB8CC\uB85C \uC790\uC8FC \uC0AC\uC6A9\uB41C\uB2E4."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD55C\uBC88 \uBCA0\uC5B4 \uBB3C\uBA74 \uC2E0\uB9DB\uC774 \uAC10\uB3C8\uB2E4.\\n\uB9CE\uC774 \uB123\uC73C\uBA74\\n\uB4B7\uB9DB\uC774 \uC0B0\uB73B\uD574\uC9C4\uB2E4."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB2E4\uC591\uD55C \uB9DB\uC774 \uACE8\uACE0\uB8E8\\n\uB2F4\uAE34 \uC7AC\uBBF8\uC788\uB294 \uB098\uBB34\uC5F4\uB9E4.\\n\uB5AB\uC740\uB9DB\uC740 \uC5C6\uC5B4\uC11C \uBA39\uAE30 \uD3B8\uD558\uB2E4."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB2EC\uC9C0 \uC54A\uC740 \uC5B4\uB978 \uCDE8\uD5A5\uC758 \uB9DB.\\n\uC694\uB9AC\uC5D0 \uC0AC\uC6A9\uD558\uBA74\\n\uB3C5\uD2B9\uD55C \uD48D\uBBF8\uAC00 \uB098\uC628\uB2E4."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB9DB\uC774 \uB3C5\uD2B9\uD558\uC9C0\uB9CC \uC4F4\uB9DB\uC774 \uC5C6\uC5B4\uC11C\\n\uC694\uB9AC\uC5D0\uB3C4 \uC0AC\uC6A9\uD558\uAE30 \uD3B8\uD558\uB2E4.\\n\uC120\uBA85\uD55C \uBE5B\uAE54\uC740 \uC798 \uC5EC\uBB3C\uC5C8\uB2E4\uB294 \uC99D\uAC70\uB2E4."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC2E0\uB9DB\uC740 \uC5C6\uC9C0\uB9CC \uADE0\uD615\uC774 \uC798 \uC7A1\uD78C\\n\uB9DB\uC744 \uB0B8\uB2E4. \uD3EC\uCF13\uBAAC\uC758 \uBAB8\uC5D0 \uC88B\uC740\\n\uC131\uBD84\uC774 \uB4EC\uBFCD \uB4E4\uC5B4 \uC788\uB2E4."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB9F5\uC9C0 \uC54A\uC544\uC11C \uB204\uAD6C\uB77C\uB3C4 \uC27D\uAC8C\\n\uBA39\uC744 \uC218 \uC788\uACE0 \uC5B4\uB514\uC5D0\uB4E0\\n\uC4F8 \uC218 \uC788\uB294 \uB9CC\uB2A5 \uB098\uBB34\uC5F4\uB9E4."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD2B9\uC9D5\uC801\uC778 \uAC89\uBAA8\uC2B5 \uC548\uC5D0\uB294\\n\uB9E4\uC6B4 \uC131\uBD84\uC774\\n\uAC00\uB4DD \uB4E4\uC5B4 \uC788\uB2E4."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC8FC\uBCC0\uC758 \uB3CC\uAE30\uC5D0\uB294 \uB5AB\uC740\uB9DB\uC744 \uB0B4\uB294\\n\uC131\uBD84\uC774 \uB4EC\uBFCD \uB2F4\uACA8 \uC788\uACE0\\n\uC2DD\uAC10\uB3C4 \uC7AC\uBBF8\uC788\uB2E4."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5F4\uB9E4\uAC00 \uB9CE\uC774 \uAD7D\uC744\uC218\uB85D \uB2EC\uCF64\uD558\uB2E4.\\n\uADF8\uB300\uB85C \uBA39\uAE30\uC5D0\uB3C4 \uC88B\uC544\uC11C\\n\uAC04\uB2E8\uD55C \uAC04\uC2DD\uC73C\uB85C \uC54C\uB9DE\uB2E4."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAF2D\uC9C0 \uC8FC\uBCC0\uC758 \uBD80\uBD84\uC774\\n\uD2B9\uD788 \uB354 \uC4F0\uC9C0\uB9CC \uC798 \uC0B6\uC73C\uBA74\\n\uAE4A\uC740 \uB9DB\uC774 \uB354\uD574\uC9C4\uB2E4."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD070 \uC5F4\uB9E4 \uC548\uC5D0\uB294\\n\uC2E0\uB9DB\uACFC \uC218\uBD84\uC774\\n\uAC00\uB4DD \uB4E4\uC5B4 \uC788\uB2E4."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB2EC\uCF64\uD558\uBA74\uC11C\uB3C4 \uB9E4\uCF64\uD55C \uACFC\uC721\uC744\\n\uACC4\uC18D\uD574\uC11C \uC539\uB2E4 \uBCF4\uBA74\\n\uB4A4\uC774\uC5B4 \uC4F4\uB9DB\uC774 \uD600 \uC804\uCCB4\uC5D0 \uD37C\uC9C4\uB2E4."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uADF8\uB300\uB85C \uBA39\uC744 \uC218\uB3C4 \uC788\uC9C0\uB9CC\\n\uD479 \uACE0\uC558\uC744 \uB54C \uB098\uC624\uB294 \uC9C4\uC561\uC774\\n\uC694\uB9AC\uC758 \uB9DB\uC744 \uB3CB\uBCF4\uC774\uAC8C \uD574\uC900\uB2E4."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uAECD\uC9C8\uC740 \uB9F5\uC9C0\uB9CC \uACFC\uC721\uC758\\n\uC0C8\uCF64\uB2EC\uCF64\uD55C \uD5A5\uC774\\n\uC2DD\uC695\uC744 \uC790\uADF9\uD558\uB294 \uB098\uBB34\uC5F4\uB9E4."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB178\uB780 \uBD80\uBD84\uC774 \uC19F\uC544\uC62C\uB77C \uC788\uC73C\uBA74\\n\uB098\uBB34\uC5F4\uB9E4\uAC00 \uC798 \uC775\uC5C8\uB2E4\uB294 \uB73B\uC774\uB2E4.\\n\uB3C5\uD2B9\uD55C \uB9DB\uC774\uC9C0\uB9CC \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uB3C4 \uB9CE\uB2E4."
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC0B4\uC9DD \uBCA0\uC5B4 \uBB3C\uBA74 \uC2E0\uB9DB\uACFC \uB2E8\uB9DB\uC758\\n\uD558\uBAA8\uB2C8\uAC00 \uC785\uC548 \uAC00\uB4DD \uD3BC\uCCD0\uC9C4\uB2E4.\\n\uC0D0\uB7EC\uB4DC\uC5D0\uB3C4 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4."
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC785\uC774 \uC0C8\uBE68\uAC1C\uC9C8 \uC815\uB3C4\uB85C \uB9F5\uB2E4.\\n\uC77C\uBD80\uB7EC \uB2E4\uB978 \uD5A5\uC2E0\uB8CC\uC640 \uC870\uD569\uD574\uC11C\\n\uC544\uC8FC \uB9E4\uC6B4 \uC694\uB9AC\uB97C \uC990\uAE30\uB294 \uBC29\uBC95\uB3C4 \uC788\uB2E4."
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC5F4\uB9E4\uAC00 \uB531\uB531\uD558\uACE0 \uB9DB\uB3C4 \uB9F5\uC9C0\uB9CC\\n\uAC00\uC5F4\uD558\uBA74 \uB2E8\uB9DB\uC774 \uB354\uD574\uC9C4\uB2E4.\\n\uAC15\uD55C \uB9DB\uC744 \uB0B4\uACE0 \uC2F6\uC744 \uB54C \uC548\uC131\uB9DE\uCDA4\uC774\uB2E4."
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC0DD\uAE34 \uAC83\uCC98\uB7FC \uB5AB\uC740\uB9DB\uC774 \uB09C\uB2E4.\\n\uBD80\uB4DC\uB7EC\uC6B4 \uACFC\uC721\uC740 \uBB3C\uC5D0 \uC798 \uB179\uACE0\\n\uC694\uB9AC\uC758 \uB9DB\uC744 \uC7A1\uC544\uC900\uB2E4."
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB178\uB797\uACE0 \uADC0\uC5EC\uC6B4 \uC0DD\uAE40\uC0C8\uC640\\n\uC0C8\uCF64\uB2EC\uCF64\uD55C \uB9DB \uB54C\uBB38\uC5D0 \uB514\uC800\uD2B8\uC5D0\uB3C4\\n\uC0AC\uC6A9\uB41C\uB2E4. \uC7BC\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uB3C4 \uB9DB\uC788\uB2E4."
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC4F4\uB9DB\uC774 \uB098\uB294 \uAC00\uC6B4\uB370 \uC740\uC740\uD558\uAC8C\\n\uD37C\uC9C0\uB294 \uB9E4\uC6B4\uB9DB\uC774 \uC5EC\uC6B4\uC744 \uB0A8\uAE34\uB2E4.\\n\uAC04\uC2DD\uC73C\uB85C \uBA39\uB294 \uC5B4\uB978\uB3C4 \uB9CE\uB2E4."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB5AB\uC73C\uBA74\uC11C\uB3C4 \uC0C8\uCF64\uD558\uACE0 \uC0B0\uB73B\uD55C \uB9DB\uC774 \uB09C\uB2E4.\\n\uCC28\uAC8C \uD574\uC11C \uBA39\uC73C\uBA74 \uB354\uC704\uC5D0 \uC9C0\uCE5C \uBAB8\uB3C4\\n\uC2DC\uC6D0\uD558\uAC8C \uC2DD\uB294\uB2E4."
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uACFC\uC721 \uC548\uC5D0 \uC5F4\uC744 \uB098\uAC8C \uD558\uB294\\n\uC131\uBD84\uC774 \uB4E4\uC5B4 \uC788\uC5B4\uC11C \uB9F5\uB2E4.\\n\uCD94\uC6B4 \uC9C0\uBC29\uC5D0\uC11C \uADC0\uC911\uD558\uAC8C \uC5EC\uACA8\uC9C4\uB2E4."
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC120\uBA85\uD55C \uB179\uC0C9 \uBD80\uBD84\uC5D0\uC11C\uB294 \uC2E0\uB9DB\uC774 \uB098\uC9C0\uB9CC\\n\uC18D\uC744 \uC5F4\uC5B4\uBCF4\uBA74 \uB5AB\uACE0 \uAC80\uC740 \uACFC\uC721\uC774\\n\uAC00\uB4DD \uB4E4\uC5B4 \uC788\uB2E4."
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB178\uB780 \uACFC\uC721\uC740 \uB2E8\uB9DB\uC774 \uBB3C\uC52C \uB09C\uB2E4.\\n\uADF8\uB300\uB85C \uBA39\uC5B4\uB3C4 \uB9DB\uC788\uC9C0\uB9CC\\n\uAC00\uC5F4\uD558\uBA74 \uACE0\uC18C\uD55C \uD48D\uBBF8\uAC00 \uB354\uD574\uC9C4\uB2E4."
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uB531\uB531\uD558\uACE0 \uC4F4\uB9DB\uC774 \uB09C\uB2E4.\\n\uD30C\uB780 \uC0C9\uC18C\uAC00 \uB4E4\uC5B4 \uC788\uC5B4\uC11C\\n\uBCA0\uC5B4 \uBB3C\uBA74 \uD613\uBC14\uB2E5\uC774 \uC0C8\uD30C\uB798\uC9C4\uB2E4."
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB465\uAE00\uAC8C \uBD80\uD480\uC5B4 \uC624\uB97C\uC218\uB85D\\n\uB2E8\uB9DB\uB3C4 \uC218\uBD84\uB3C4 \uB9CE\uC544\uC838\uC11C\\n\uAD70\uCE68\uC774 \uB3C4\uB294 \uD5A5\uC774 \uAC10\uB3C8\uB2E4."
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uBB34\uD131\uB300\uACE0 \uB9CE\uC774 \uB123\uC73C\uBA74\\n\uAC15\uD55C \uB9E4\uC6B4\uB9DB\uC744 \uAC00\uC9C4\\n\uB9E4\uC6B0 \uC790\uADF9\uC801\uC778 \uC694\uB9AC\uAC00 \uD0C4\uC0DD\uD55C\uB2E4."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB5AB\uC740\uB9DB\uC774 \uAC15\uD574\uC11C \uD53C\uD074 \uC7AC\uB8CC\uB85C\\n\uC0AC\uC6A9\uB418\uB294 \uC77C\uC774 \uB9CE\uB2E4.\\n\uD479 \uC0B6\uC73C\uBA74 \uAF64 \uBD80\uB4DC\uB7EC\uC6CC\uC9C4\uB2E4."
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uAF43\uCC98\uB7FC \uC0DD\uAE34 \uAC89\uBAA8\uC2B5\uACFC\\n\uC9C4\uD55C \uB2E8\uB9DB\uC774 \uACFC\uC790 \uB9CC\uB4E4\uAE30\uC5D0 \uC54C\uB9DE\uB2E4.\\n\uB9D0\uB824\uC11C \uBD80\uC801\uC73C\uB85C \uC4F8 \uB54C\uB3C4 \uC788\uB2E4."
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uB3C5\uD2B9\uD55C \uC4F4\uB9DB\uC774 \uB098\uC9C0\uB9CC\\n\uC624\uB7AB\uB3D9\uC548 \uC0B6\uC73C\uBA74\\n\uB2E8\uB9DB\uC774 \uC62C\uB77C\uC640\uC11C \uBA39\uAE30 \uD3B8\uD574\uC9C4\uB2E4."
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uBFB0\uC871\uBFB0\uC871\uD55C \uC0DD\uAE40\uC0C8\uCC98\uB7FC \uC0C8\uCF64\uD558\uB2E4.\\n\uAC89\uBA74\uC758 \uAC00\uC2DC\uB85C \uD3EC\uCF13\uBAAC\uC5D0 \uB2EC\uB77C\uBD99\uC5B4\\n\uBA38\uB098\uBA3C \uACF3\uAE4C\uC9C0 \uD37C\uC9C4\uB2E4\uACE0 \uD55C\uB2E4."
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD788 \uB531\uB531\uD558\uACE0\\n\uC544\uC8FC \uC790\uADF9\uC801\uC73C\uB85C \uB9E4\uC6B4 \uAC83\uC774 \uD2B9\uC9D5\uC774\uB2E4.\\n\uC61B\uB0A0\uC5D0\uB294 \uC57D\uC73C\uB85C\uB3C4 \uC0AC\uC6A9\uB410\uB2E4."
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB465\uADF8\uC2A4\uB984\uD55C \uAC89\uBAA8\uC2B5\uB9CC \uBD10\uC11C\uB294\\n\uC0C1\uC0C1\uD560 \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uB5AB\uC5B4\uC11C\\n\uC2DD\uC7AC\uB8CC\uC758 \uAD70\uB0B4\uB97C \uC7A1\uC544\uC900\uB2E4."
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC870\uAE08 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uBA39\uC73C\uBA74 \uB9E4\uC6B4\uB9DB\uACFC \uB2E8\uB9DB\uC774\\n\uC785\uC548 \uAC00\uB4DD \uCDA9\uB3CC\uD55C\uB2E4."
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC870\uAE08 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uB3C5\uD2B9\uD55C \uB5AB\uC740\uB9DB\uACFC \uAC15\uD55C \uC4F4\uB9DB \uB54C\uBB38\uC5D0\\n\uC0AC\uB78C\uC5D0 \uB530\uB77C \uD638\uBD88\uD638\uAC00 \uAC08\uB9B0\uB2E4."
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC870\uAE08 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uC6B8\uD241\uBD88\uD241\uD55C \uAECD\uC9C8 \uC548\uC758 \uACFC\uC721\uC740\\n\uAD49\uC7A5\uD788 \uC0C8\uCF64\uB2EC\uCF64\uD558\uB2E4."
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC870\uAE08 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uB208\uC774 \uD280\uC5B4\uB098\uC62C \uC815\uB3C4\uB85C \uB9F5\uACE0 \uC4F0\uC9C0\uB9CC\\n\uADF8 \uB300\uC2E0 \uC601\uC591\uBD84\uC774 \uAC00\uB4DD \uB4E4\uC5B4 \uC788\uB2E4."
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC870\uAE08 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uD30C\uB780 \uBD80\uBD84\uC740 \uB9E4\uC6B0 \uB5AB\uACE0\\n\uB179\uC0C9 \uBD80\uBD84\uC740 \uB9E4\uC6B0 \uC2DC\uB2E4."
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74 \uD589\uBCF5\uD574\uC9C4\uB2E4\uACE0 \uC804\uD574\uC9C0\uBA70\\n\uBA39\uC73C\uBA74 \uC774\uC0C1\uD55C \uB9DB\uC774 \uB09C\uB2E4."
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uAC15\uD55C \uD798\uC744 \uC9C0\uB2C8\uACE0 \uC788\uB2E4\uACE0\\n\uC804\uD574\uC9C0\uB294 \uD658\uC0C1\uC758 \uB098\uBB34\uC5F4\uB9E4.\\n\uB9DB\uB3C4 \uCD5C\uACE0\uB85C \uC88B\uB2E4."
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC815\uCCB4\uBD88\uBA85\uC758 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uBB34\uC2A8 \uB9DB\uC774 \uB098\uB294\uC9C0\uB294\\n\uBA39\uC5B4\uBCF4\uC9C0 \uC54A\uC73C\uBA74 \uBAA8\uB978\uB2E4."
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uB5AB\uC740\uB9DB\uC774 \uC5C4\uCCAD\uB098\uAC8C \uAC15\uD574\uC11C\\n\uB2E4\uB978 \uC7AC\uB8CC\uAC00 \uC624\uD788\uB824 \uB2EC\uAC8C \uB290\uAEF4\uC9C4\uB2E4."
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uAC89\uC740 \uB531\uB531\uD558\uC9C0\uB9CC \uC18D\uC740\\n\uD06C\uB9BC\uCC98\uB7FC \uBD80\uB4DC\uB7FD\uACE0 \uB2EC\uB2E4."
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uC790\uADF9\uD558\uBA74 \uC4F4 \uC5F4\uB9E4\uAC00\\n\uD1A1\uD1A1 \uD280\uAE30 \uB54C\uBB38\uC5D0 \uC8FC\uC758\uD574\uC57C \uD55C\uB2E4."
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uB208\uBB3C\uC774 \uB0A0 \uC815\uB3C4\uB85C \uC2DC\uAE30 \uB54C\uBB38\uC5D0\\n\uC798\uAC8C \uCABC\uAC1C\uC11C \uC870\uAE08\uC529 \uC4F0\uC790."
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uC9C4\uD55C \uB2E8\uB9DB\uACFC \uACE0\uC0C1\uD55C \uD5A5\uC774 \uB098\uAE30 \uB54C\uBB38\uC5D0\\n\uC5B4\uB5A4 \uC694\uB9AC\uB4E0 \uACE0\uAE09\uC2A4\uB7EC\uC6CC\uC9C4\uB2E4.\\n\uD5C8\uBE0C\uD2F0\uC758 \uC7AC\uB8CC\uB85C\uB3C4 \uC4F0\uC778\uB2E4."
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uC870\uAE08 \uADC0\uC911\uD55C \uB098\uBB34\uC5F4\uB9E4.\\n\uC9C0\uC625\uACFC\uB3C4 \uAC19\uC740 \uB9E4\uC6B4\uB9DB\uC5D0 \uC774\uC5B4\uC11C\\n\uAC15\uB82C\uD55C \uB5AB\uC740\uB9DB\uC774 \uBAB0\uC544\uCE5C\uB2E4."
  },
  {
