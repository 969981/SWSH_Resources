  },
  {
    "index": 54,
    "flags": 0,
    "text": "20\uB300 \uC2DC\uC808\uBD80\uD130\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744 \uB9E1\uACE0 \uC788\uB2E4.\\n\uC6B0\uC218\uD55C \uCF54\uCE58\uB85C\uB3C4\\n\uC798 \uC54C\uB824\uC838 \uC788\uC9C0\uB9CC \uC9C0\uB3C4 \uBC29\uC2DD\uC740\\n\uC9C0\uADF9\uD788 \uC2A4\uD30C\uB974\uD0C0\uC2DD\uC774\uB2E4.\\n\uC2B9\uBD80\uD558\uB294 \uC2A4\uD0C0\uC77C\uB3C4\\n\uD639\uB3C5\uD558\uACE0 \uC5C4\uACA9\uD558\uB2E4.\\n\uADF8\uB798\uC11C \uB0A8\uC544 \uC788\uB294 \uCCB4\uC721\uAD00 \uD2B8\uB808\uC774\uB108\uB3C4\\n\uC0C1\uB2F9\uD55C \uC2E4\uB825\uC790\uB4E4\uBFD0\uC774\uB2E4.\\n\uB54C\uBB38\uC5D0 \uD0A4\uB974\uCFE0\uC2A4\uC2A4\uD0C0\uB514\uC6C0\uC740\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC758 \uB09C\uAD00\uC73C\uB85C \uBD88\uB9B0\uB2E4.\\n\uAC70\uCE5C \uC2B9\uBD80\uB97C \uD3BC\uCE58\uAC8C \uB41C \uAC83\uC740\\n\uC544\uB4E4\uACFC\uC758 \uB2E4\uD23C\uC774 \uC6D0\uC778\uC774\uB77C\uB294\\n\uADF8\uB7F4 \uB4EF\uD55C \uC18C\uBB38\uC774 \uC788\uB2E4."
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744\\n\uB9E1\uAE30\uACE0 \uC2F6\uB2E4\uB294 \uC5C4\uB9C8 \uBA5C\uB860\uACFC\\n\uBC14\uC704\uD0C0\uC785\uC744 \uB354 \uAC08\uACE0\uB2E6\uACE0 \uC2F6\uB2E4\uB294\\n\uC544\uB4E4 \uB9C8\uCFE0\uC640\uC758 \uBAA8\uC790 \uAC04 \uC2F8\uC6C0\uC740\\n\uB9C8\uC744\uC744 \uB450 \uD328\uB85C \uB098\uB204\uB294\\n\uD070 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uAC00 \uB418\uC5C8\uB2E4.\\n\uADF8 \uB4A4\uB85C \uBA5C\uB860\uACFC \uB9C8\uCFE0\uC640\uB294\\n\uC11C\uB85C \uC5BC\uAD74\uC744 \uBCF4\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uD55C\uB2E4.\\n\uCC38\uACE0\uB85C \uB9C8\uCFE0\uC640\uC758 \uD32C\uD074\uB7FD\\n\uD68C\uC6D0 \uBC88\uD638 1\uBC88\uC744 \uB530\uB0B8 \uAC74\\n\uBA5C\uB860\uC774\uB77C\uB294 \uB4EF\uD558\uB2E4.\\n\uC0AC\uC9C4 \uC18D \uB9C8\uCFE0\uC640\uB294 \uC5B4\uB518\uAC00\\n\uC5B8\uC9E2\uC544 \uBCF4\uC774\uB294 \uD45C\uC815\uC774\uC9C0\uB9CC\\n\uBD84\uBA85\uD788 \uAE30\uBD84 \uD0D3\uC77C \uAC83\uC774\uB2E4...."
  },
  {
    "index": 56,
    "flags": 0,
    "text": "[~ 56]"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "[~ 57]"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "[~ 58]"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "[~ 59]"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC5D0\uB294\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD558\uAE30 \uC704\uD55C\\n\uD30C\uC6CC\uC2A4\uD3FF\uC774 \uC5C6\uC5B4\uC11C\\n\uD32C\uB4E4\uC774 \uB9CE\uC774 \uCC3E\uC544\uC624\uC9C0 \uC54A\uC544\\n\uB9C8\uC744\uC774 \uC1E0\uB77D\uD574\uAC00\uB294 \uAC83\uC5D0\\n\uCC45\uC784\uC744 \uB290\uB07C\uACE0 \uC788\uB2E4.\\n\uC2DC\uD569\uC774 \uC2DC\uC791\uB418\uBA74 \uD765\uBD84\uD574\uC11C\\n\uC790\uC2E0\uC758 \uC804\uB7B5\uC744 \uC2A4\uD3EC\uC77C\uB7EC\uD558\uC9C0\uB9CC\\n\uADF8\uB7F0\uB370\uB3C4 \uC774\uAE38 \uC815\uB3C4\uC758 \uC2E4\uB825\uC744 \uAC16\uCDC4\uB2E4.\\n\uC2F1\uC5B4\uC1A1\uB77C\uC774\uD130\uB85C\uC11C\uC758\\n\uD3C9\uAC00\uB3C4 \uC88B\uACE0 \uBCF8\uC778\uB3C4 \uC74C\uC545\uC5D0\\n\uC815\uC9C4\uD558\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC774 \uC788\uC5B4\\n\uB0B4\uC2EC \uC5EC\uB3D9\uC0DD\uC774 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\\n\uB418\uC5B4\uC8FC\uAE38 \uBC14\uB77C\uACE0 \uC788\uB2E4."
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uAC13 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774 \uB418\uC5C8\uC744 \uB2F9\uC2DC\uC758\\n\uB450\uC1A1 \uC120\uC218\uC758 \uCF54\uBA58\uD2B8\uC785\uB2C8\uB2E4.\\n\u201C\uC74C \uADF8\uB7EC\uB2C8\uAE4C... \uB450\uC1A1\uC785\uB2C8\uB2E4.\\n\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC740 \uC544\uC27D\uAC8C\uB3C4\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\uB9CC\\n\uC5B4\uB5A4 \uC758\uBBF8\uB85C\uB294 \uADF8\uAC8C \uD3EC\uCF13\uBAAC \uC2B9\uBD80\\n\uBCF8\uC5F0\uC758 \uBAA8\uC2B5\uC774\uAE30\uB3C4 \uD558\uB2C8\uAE4C\\n\uADF8 \uC810\uC744 \uC5B4\uD544\uD558\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.\\n\uADF8\uB9AC\uACE0 \uC81C\uAC00 \uC5EC\uB3D9\uC0DD\uC774 \uC788\uB294\uB370\uC694...\\n\uC800\uBCF4\uB2E4 \uB354 \uC18C\uC9C8\uC774 \uC788\uB294 \uC544\uC774\uB77C\\n\uB3D9\uC0DD\uC774 \uB098\uC911\uC5D0 \uCEE4\uC11C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774 \uB420 \uB54C\uAE4C\uC9C0\uB294\\n\uB178\uB798\uD558\uBA74\uC11C \uB2E4 \uAC19\uC774\\n\uB9C8\uC744\uC744 \uD65C\uAE30\uCC28\uAC8C \uB9CC\uB4E4\uC5B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4!\u201D"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "[~ 62]"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "[~ 63]"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "[~ 64]"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "[~ 65]"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29 \uCD5C\uAC15\uC774\uB77C\uACE0\\n\uD3C9\uD310\uC774 \uC790\uC790\uD55C \uCCB4\uC721\uAD00 \uAD00\uC7A5.\\n\uC5B4\uB5A4 \uC870\uAC74\uC5D0\uC11C\uB4E0 \uC2B9\uB9AC\uB97C\\n\uAC70\uBA38\uC950\uAE30 \uC704\uD574 \uB178\uB825\uD55C \uACB0\uACFC\\n\uB0A0\uC528\uB97C \uC790\uC720\uC790\uC7AC\uB85C \uB2E4\uB8E8\uBA70 \uC2F8\uC6B0\uB294\\n\uC2A4\uD0C0\uC77C\uC744 \uC775\uD788\uAC8C \uB418\uC5C8\uB2E4.\\n\uB2E4\uB978 \uC9C0\uBC29\uC5D0 \uAC00\uBA74\\n\uCC54\uD53C\uC5B8\uC774 \uB420 \uC218 \uC788\uC744 \uAC70\uB77C\uB294\\n\uC774\uC57C\uAE30\uB3C4 \uB9CE\uC9C0\uB9CC \uBCF8\uC778\uC5D0\uAC8C\uB294\\n\uB2E8\uB378\uC744 \uC774\uAE30\uB294 \uAC83\uC774\\n\uB354 \uC911\uC694\uD55C \uC77C\uC774\uB77C\uB294 \uB4EF\uD558\uB2E4.\\n\uADF8\uAC00 \uC5C5\uB85C\uB4DC\uD558\uB294 \uC0AC\uC9C4\uC740\\n\uC778\uAE30\uAC00 \uB9CE\uC9C0\uB9CC \uAC00\uB054\uC740\\n\uBAA8\uB798\uBC14\uB78C\uB9CC \uCC0D\uD600 \uC788\uC744 \uB54C\uB3C4 \uC788\uB2E4."
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uC140\uCE74\uB97C \uCC0D\uAE30 \uC2DC\uC791\uD55C \uACC4\uAE30\uB294\\n\uD328\uBC30\uD588\uC744 \uB54C\uC758 \uAE30\uBD84\uC744\\n\uC78A\uC9C0 \uC54A\uAE30 \uC704\uD574\uC11C\uC600\uC9C0\uB9CC\\n\uCD5C\uADFC\uC5D0\uB294 \uD2B8\uB808\uC774\uB2DD\uC774\uB098\\n\uAE08\uB791\uC758 \uD328\uC158 \uB4F1 \uC2B9\uBD80\uC640\uB294 \uBA3C \uB0B4\uC6A9\uC744\\n\uC5C5\uB85C\uB4DC\uD558\uB294 \uD69F\uC218\uAC00 \uC810\uC810 \uB298\uACE0 \uC788\uB2E4.\\n\uADF8\uB798\uC11C\uC778\uC9C0 \uB2E8\uB378\uC5D0\uAC8C \uC9C0\uACE0 \uB098\uBA74\\n\uD5D8\uC545\uD55C \uB313\uAE00\uB3C4 \uB9CE\uC774 \uB2EC\uB9B0\uB2E4.\\n\uD604\uC7AC \uB2E8\uB378\uC5D0\uAC8C\uB294 10\uC5F0\uD328 \uC911\uC774\uB2E4.\\n\uADF8\uB807\uC9C0\uB9CC \uB2E8\uB378\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uAC00\uC7A5 \uB9CE\uC774 \uC4F0\uB7EC\uB728\uB9B0\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uC774\uAE30\uB3C4 \uD558\uB2E4!\\n\uB2E8\uB378\uC744 \uC4F0\uB7EC\uB728\uB9AC\uACE0 \uB09C \uB4A4\uC758\\n\uC140\uCE74\uAC00 \uAE30\uB2E4\uB824\uC9C4\uB2E4."
  },
  {
    "index": 68,
    "flags": 0,
    "text": "[~ 68]"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "[~ 69]"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "[~ 70]"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "[~ 71]"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uACA8\uC6B0 10\uC0B4\uC758 \uB098\uC774\uC5D0\\n\uCC98\uC74C\uC73C\uB85C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uCC38\uAC00\uD574\uC11C\\n\uCC54\uD53C\uC5B8\uCEF5 \uC6B0\uC2B9\uC774\uB77C\uB294\\n\uCF8C\uAC70\uB97C \uC774\uB8E8\uC5C8\uB2E4.\\n\uADF8 \uD6C4\uB85C \uD30C\uD2B8\uB108 \uB9AC\uC790\uBABD\uACFC\\n\uACF5\uC2DD\uC804\uC744 \uD3EC\uD568\uD558\uC5EC\\n\uBB34\uD328 \uAE30\uB85D\uC744 \uACBD\uC2E0 \uC911\uC774\uB2E4.\\n\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC774\uB77C \uBD88\uB9AC\uBA70\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB4E4\uC758\\n\uB3D9\uACBD\uC758 \uB300\uC0C1\uC774\uAE30\uB3C4 \uD558\uB2E4.\\n\uB2E8, \uAE38\uC744 \uC798 \uAE30\uC5B5\uD558\uC9C0 \uBABB\uD55C\uB2E4.\\n\uC790! \uB2F9\uC2E0\uB3C4\\n\uB808\uCE20 \uCC54\uD53C\uC5B8 \uD0C0\uC784!"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uD2B8\uB808\uC774\uB108\uB4E4\uC744\\n\uCD5C\uAC15\uC73C\uB85C \uB9CC\uB4E4\uACA0\uB2E4\uB294\\n\uCC54\uD53C\uC5B8\uC774\uC5C8\uC744 \uB54C\uBD80\uD130\uC758 \uAFC8\uC744 \uC704\uD574\\n\uB85C\uC988\uD0C0\uC6CC\uB97C \uBC30\uD2C0\uD0C0\uC6CC\uB77C\uB294 \uC774\uB984\uC758\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0 \uD2B9\uD654\uB41C\\n\uC2DC\uC124\uB85C \uAC1C\uC870\uD588\uB2E4.\\n\uCC54\uD53C\uC5B8\uC774\uC5C8\uC744 \uB54C\uBCF4\uB2E4\\n\uC624\uD788\uB824 \uB354 \uD65C\uAE30\uAC00 \uB118\uCCD0 \uBCF4\uC778\uB2E4\uBA70\\n\uD56D\uAC04\uC5D0 \uD654\uC81C\uB97C \uBAA8\uC73C\uACE0 \uC788\uB2E4.\\n\uD0C0\uC6CC\uB294 \uD5E4\uB9EC \uC5FC\uB824\uAC00 \uC5C6\uC5B4\uC11C\\n\uB9C8\uC74C\uC5D0 \uB4E4\uC5B4\uD55C\uB2E4\uACE0 \uD55C\uB2E4.\\n\uCD5C\uADFC\uC758 \uACE0\uBBFC\uC740\\n\uCC54\uD53C\uC5B8 \uD0C0\uC784\uC744 \uB300\uC2E0\uD560 \uCE90\uCE58\uD504\uB808\uC774\uC988\uB97C\\n\uC815\uD558\uB294 \uC77C\uC774\uB77C\uB294 \uB4EF\uD558\uB2E4."
  },
  {
    "index": 74,
    "flags": 0,
    "text": "[~ 74]"
  },
  {
