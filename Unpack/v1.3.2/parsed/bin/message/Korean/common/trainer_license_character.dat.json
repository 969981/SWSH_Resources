  },
  {
    "index": 89,
    "flags": 0,
    "text": "[~ 89]"
  },
  {
    "index": 90,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uB9AC\uADF8 \uACF5\uC778\\n\uB9C8\uC2A4\uCF54\uD2B8 \uCE90\uB9AD\uD130\uC758\\n\uD0C8\uC778\uD615\uC744 \uBA4B\uB300\uB85C \uB9CC\uB4E0\\n\uC218\uC218\uAED8\uB07C\uC758 \uC778\uBB3C\uC774\uB2E4.\\n\uC790\uC2E0\uC744 \uBCFC\uAC00\uC774\uB77C\uACE0 \uBD80\uB974\uB294\uB370\\n\uC131\uBCC4\uC740 \uBB3C\uB860\uC774\uACE0 \uB098\uC774\uB3C4\\n\uC218\uC218\uAED8\uB07C\uC758 \uC778\uBB3C\uC774\uB2E4.\\n\uC5EC\uAE30\uC800\uAE30\uC5D0\uC11C \uD76C\uADC0\uD55C \uBCFC\uC744\\n\uB098\uB220\uC8FC\uACE0 \uC788\uB294\uB370\\n\uADF8 \uC774\uC720\uAC00 \uBB34\uC5C7\uC778\uC9C0 \uC54C\uB824\uC9C0\uC9C0 \uC54A\uC740\\n\uC218\uC218\uAED8\uB07C\uC758 \uC778\uBB3C\uC774\uB2E4.\\n\uC560\uCD08\uC5D0 \uBCFC\uC744\\n\uC5B4\uB514\uC5D0\uC11C \uC190\uC5D0 \uB123\uC5C8\uB294\uC9C0\uB3C4 \uC758\uBB38\uC778\\n\uC218\uC218\uAED8\uB07C\uC758 \uC778\uBB3C\uC774\uB2E4."
  },
  {
    "index": 91,
    "flags": 0,
    "text": "[~ 91]"
  },
  {
    "index": 92,
