[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB9CE\uC774 \uC5B4\uD544\uD560 \uC218 \uC788\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC544\uC8FC \uB9CE\uC774 \uC5B4\uD544\uD560 \uC218 \uC788\uC9C0\uB9CC\\n\uC774\uB2E4\uC74C\uC5D0 \uB180\uB77C\uAE30 \uC26C\uC6CC\uC9C4\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5C4\uCCAD\uB09C \uC5B4\uD544\uC774 \uB418\uC9C0\uB9CC \uC774\uD6C4\uBD80\uD130\\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC544\uBB34\uAC83\uB3C4 \uD560 \uC218 \uC5C6\uAC8C \uB41C\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uACC4\uC18D\uD574\uC11C \uC368\uB3C4 \uAD00\uAC1D\uC774\\n\uC2EB\uC99D \uB0B4\uC9C0 \uC54A\uAC8C \uC5B4\uD544\uD560 \uC218 \uC788\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC774 \uB180\uB798\uB3C4\\n\uD55C \uBC88 \uC815\uB3C4\uB294 \uCC38\uC744 \uC218 \uC788\uB2E4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC774 \uB180\uB798\uB3C4\\n\uCC38\uC744 \uC218 \uC788\uB2E4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC790\uC2E0\uC758 \uC55E\uC5D0\uC11C \uC5B4\uD544\uD55C\\n\uD3EC\uCF13\uBAAC\uC744 \uB180\uB77C\uAC8C \uB9CC\uB4E0\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5B4\uD544\uC774 \uB05D\uB09C\\n\uD3EC\uCF13\uBAAC \uBAA8\uB450\uB97C \uB180\uB77C\uAC8C \uB9CC\uB4E0\uB2E4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC790\uC2E0\uC758 \uC55E\uC5D0\uC11C \uC5B4\uD544\uD55C\\n\uD3EC\uCF13\uBAAC\uC744 \uC0C1\uB2F9\uD788 \uB180\uB77C\uAC8C \uB9CC\uB4E0\uB2E4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uD544\uC774 \uB05D\uB09C \uD3EC\uCF13\uBAAC \uBAA8\uB450\uB97C\\n\uC0C1\uB2F9\uD788 \uB180\uB77C\uAC8C \uB9CC\uB4E0\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAD00\uAC1D\uC758 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD55C\\n\uAE30\uB300\uB97C \uC5C6\uC568 \uC218 \uC788\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAD00\uAC1D\uC5D0\uAC8C \uAE30\uB300\uBC1B\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uD2B9\uD788 \uB180\uB77C\uAC8C \uD55C\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBAA8\uB450\uB97C \uBC29\uD574\uD558\uACE0\\n\uB2E4\uC74C \uC5B4\uD544\uC740 \uCC38\uAC00\uD558\uC9C0 \uC54A\uB294\uB2E4"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAC19\uC740 \uD0C0\uC785\uC758 \uC5B4\uD544\uC744 \uD55C\\n\uD3EC\uCF13\uBAAC\uC744 \uD2B9\uD788 \uB180\uB77C\uAC8C \uB9CC\uB4E0\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC774\uB2E4\uC74C \uC5B4\uD544\uC744 \uD558\uB294\\n\uD3EC\uCF13\uBAAC \uBAA8\uB450\uB97C \uAE34\uC7A5\uC2DC\uD0A8\uB2E4"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC5B4\uD544\uC774 \uB05D\uB09C\\n\uD3EC\uCF13\uBAAC\uC758 \uCEE8\uB514\uC158\uC744 \uB5A8\uC5B4\uB728\uB9B0\uB2E4"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC81C\uC77C \uCC98\uC74C\uC73C\uB85C \uC5B4\uD544\uD558\uBA74\\n\uC5B4\uD544\uC774 \uAD49\uC7A5\uD788 \uC798 \uB41C\uB2E4"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC81C\uC77C \uB9C8\uC9C0\uB9C9\uC5D0 \uC5B4\uD544\uD558\uBA74\\n\uC5B4\uD544\uC774 \uAD49\uC7A5\uD788 \uC798 \uB41C\uB2E4"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uADF8 \uD134\uC5D0\uC11C \uC774\uBBF8 \uC5B4\uD544\uD55C \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uACFC\\n\uAC19\uC740 \uC815\uB3C4\uC758 \uC5B4\uD544\uC744 \uBCF4\uC778\uB2E4"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD558\uB098 \uC55E\uC758 \uD3EC\uCF13\uBAAC \uC5B4\uD544\uACFC\\n\uAC19\uC740 \uC815\uB3C4\uB85C \uC798 \uD560 \uC218 \uC788\uB2E4"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB098\uC911\uC5D0 \uC5B4\uD544\uC744 \uD560\uC218\uB85D\\n\uAD49\uC7A5\uD55C \uC5B4\uD544\uC744 \uBCF4\uC5EC\uC904 \uC218 \uC788\uB2E4"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC4F8 \uB54C\uB9C8\uB2E4 \uC5B4\uD544\uC758 \uC644\uC131\uB3C4\uAC00\\n\uC5EC\uB7EC \uAC00\uC9C0\uB85C \uBC14\uB010\uB2E4"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uD558\uB098 \uC55E\uC758 \uD3EC\uCF13\uBAAC \uC5B4\uD544\uACFC\\n\uD0C0\uC785\uC774 \uAC19\uB2E4\uBA74 \uB9C8\uC74C\uC5D0 \uB4E4\uAC8C \uB41C\uB2E4"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uD558\uB098 \uC55E\uC758 \uD3EC\uCF13\uBAAC \uC5B4\uD544\uC774\\n\uC798 \uB41C \uC815\uB3C4\uC5D0 \uB530\uB77C \uC601\uD5A5\uC744 \uBC1B\uB294\uB2E4"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC5B4\uD544 \uCEE8\uB514\uC158\uC774 \uC62C\uB77C\uAC04\uB2E4\\n\uAE34\uC7A5\uB3C4 \uC798 \uD558\uC9C0 \uC54A\uAC8C \uB41C\uB2E4"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uCEE8\uB514\uC158\uC774 \uC88B\uC744 \uB54C \uC4F0\uBA74\\n\uC5B4\uD544\uC774 \uC544\uC8FC \uC798 \uB41C\uB2E4"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC774\uB2E4\uC74C\uC758 \uC5B4\uD544\uC744\\n\uCCAB \uBC88\uC9F8\uB85C \uD560 \uC218 \uC788\uB2E4"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC774\uB2E4\uC74C\uC758 \uC5B4\uD544\uC744\\n\uB9C8\uC9C0\uB9C9\uC5D0 \uC4F8 \uC218 \uC788\uB2E4"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC774\uB2E4\uC74C\uC758 \uC5B4\uD544 \uC21C\uC11C\uB97C\\n\uC5C9\uB9DD\uC73C\uB85C \uD55C\uB2E4"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC5B4\uB290 \uCF58\uD14C\uC2A4\uD2B8\uC5D0\uC11C \uBCF4\uC5EC\uB3C4\\n\uBC18\uB4DC\uC2DC \uC5F4\uAD11\uD558\uB294 \uC5B4\uD544"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC5B4\uD544\uC774 \uC798 \uB41C \uD3EC\uCF13\uBAAC \uBAA8\uB450\uB97C\\n\uC0C1\uB2F9\uD788 \uB180\uB77C\uAC8C \uB9CC\uB4E0\uB2E4"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uAD00\uAC1D\uC774 \uC5F4\uAD11\uD558\uACE0 \uC788\uC744\uC218\uB85D\\n\uC5B4\uD544\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uAC8C \uB41C\uB2E4"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC774 \uC5B4\uD544 \uB2E4\uC74C\uC5D0 \uAD00\uAC1D\uC774\\n\uC7A0\uC2DC \uC5F4\uAD11\uD558\uC9C0 \uC54A\uAC8C \uB41C\uB2E4"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC81C\uC77C \uCC98\uC74C \uC5B4\uD544\uD558\uBA74\\n\uAD00\uAC1D\uC774 \uB9E4\uC6B0 \uC5F4\uAD11\uD55C\uB2E4"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC81C\uC77C \uB9C8\uC9C0\uB9C9\uC5D0 \uC5B4\uD544\uD558\uBA74\\n\uAD00\uAC1D\uC774 \uB9E4\uC6B0 \uC5F4\uAD11\uD55C\uB2E4"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC5F4\uAD11\uD558\uC9C0 \uC54A\uB294 \uC5B4\uD544\uC744 \uD588\uC744 \uB54C\\n\uD68C\uC7A5\uC774 \uC544\uC8FC \uC370\uB801\uD574\uC9C4\uB2E4"
