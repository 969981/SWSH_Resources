[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC774\uAE30\uB4E0 \uC9C0\uB4E0\\n\uC990\uAC81\uAC8C \uD558\uC790!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC544\uC9C1 \uD48B\uB0B4\uAE30\uC785\uB2C8\uB2E4\uB9CC\\n\uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB098\uB294 \uADF8\uC800 \uADF8\uB7F0\\n\uBC18\uBC14\uC9C0 \uAF2C\uB9C8\uAC00 \uC544\uB2C8\uB77C\uACE0!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC2A4\uC74D~ \uD558\uC544~ \uC2A4\uC74D~ \uD558\uC544~\\n\uC544 \uC544\uC9C1 \uB9C8\uC74C\uC758 \uC900\uBE44\uAC00..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD560 \uC218 \uC788\uC5B4! \uC774\uAE38 \uC218 \uC788\uC5B4!\\n\uC5F4\uC2EC\uD788 \uD560 \uAC70\uC57C~!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD750\uC74C~ \uB108\uB77C\uBA74 \uB098\uC758 \uC804\uB825\uC744\\n\uBC1C\uD718\uD574\uB3C4 \uB420 \uAC83 \uAC19\uC544"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uACF5\uBD80\uD55C \uC131\uACFC\uB97C\\n\uC5EC\uAE30\uC11C \uBCF4\uC5EC\uC8FC\uACA0\uC5B4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC2A4\uCFE8\uC5D0\uC11C\uB294 \uD3EC\uCF13\uBAAC\uBD80\\n\uBD80\uC7A5\uC744 \uB9E1\uACE0 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC0C1\uB300\uB97C \uACC4\uC18D\uD574\uC11C \uD480\uC8FD\uAC8C \uD560 \uC218 \uC788\uB2E4\uBA74\\n\uC601\uC6D0\uD788 \uB098\uC758 \uD134\uC774\uC57C!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC6B0\uC640... \uAC15\uD574 \uBCF4\uC778\uB2E4...\\n\uC73C\uC74C... \uBABB \uC774\uAE38 \uAC70 \uAC19\uC544..."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC624~! \uC624\uB79C\uB9CC\uC774\uC57C~!\\n\uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5C8\uC5B4~!?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uADC0\uC5EC\uC6C0\uC73C\uB85C\\n\uC2B9\uBD80\uD558\uC790!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD53C... \uD53C\uCE74..."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD53C\uCE74\uCE04 \uBAA8\uC2B5\uC744 \uD574\uC57C\\n\uB9C8\uC74C\uC774 \uD3B8\uC548\uD574\uC838"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC788\uC796\uC544 \uB09C \uB9D0\uC774\uC57C~!\\n\uD3EC\uCF13\uBAAC\uC774 \uAC15\uD558\uB2E4\uB294 \uC18C\uB9AC\uB97C \uB9CE\uC774 \uB4E4\uC5B4~!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBE0C\uC774\uBE0C\uC774 \uD30C\uC6CC\uB85C\\n\uC6B0\uC789\uC6B0\uC789 \uD558\uACE0 \uC6B8\uAC8C \uD574\uC8FC\uACA0\uC5B4!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB180\uB2E4\uAC00 \uAE38\uC744 \uC783\uC5B4\uC11C~\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC640\uBC84\uB838\uC5B4~"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC7A0\uC637 \uCC28\uB9BC\uC73C\uB85C \uC640\uBC84\uB838\uC73C\uB2C8\uAE4C\\n\uC7A0\uC637 \uCC28\uB9BC\uC73C\uB85C \uC2B9\uBD80\uD560 \uAC70\uC57C!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC0C1\uB300\uAC00 \uC5B4\uB9B0\uC544\uC774\uB77C\uB3C4\\n\uBD10\uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD734\uC2DD \uC2DC\uAC04\uC5D0 \uC7A0\uAE50 \uB098\uC628 \uAC70\uB2C8\uAE4C\\n\uD6C4\uB531 \uB05D\uB0B4\uBCF4\uC2E4\uAE4C!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC800\uB294 \uC774\uB7F0 \uC77C\uC744 \uD558\uB294 \uC0AC\uB78C\uC785\uB2C8\uB2E4...\\n\uC5B4\uB77C? \uB108\uB294 \uBA85\uD568\uC774 \uC5C6\uB2C8?"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC9C1\uC7A5\uC5D0\uC11C\uC758 \uC2A4\uD2B8\uB808\uC2A4\uB97C\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C \uB0A0\uB824\uBC84\uB9AC\uACA0\uC5B4!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC 6\uB9C8\uB9AC\uB97C \uC5B4\uC0AC\uC778\uD574\uC11C\\n\uC5B4\uC820\uB354\uB97C \uCEE4\uBBF8\uD2B8\uBA3C\uD2B8!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB9CC \uD574\uB3C4\\n\uC6D4\uAE09\uC774 \uB098\uC654\uC73C\uBA74 \uC88B\uACA0\uB2E4~"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uCC44 \uCC54\uD53C\uC5B8\uC774\uC8E0!?\\n\uC0AC \uC0AC\uC778\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB0B4 \uBC18\uBC14\uC9C0\uB294\\n\uC81C\uD2B8\uC138\uD130\uB77C\uB294 \uBE0C\uB79C\uB4DC \uAC70\uC57C"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB0B4 \uD3EC\uCF13\uBAAC\uC744\\n\uADC0\uC5EC\uC6CC\uD574 \uC918!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "...\uC88B\uC544 \uACB0\uC2EC\uD588\uC5B4! \uC774\uAE30\uBA74\\n\uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uACE0\uBC31\uD560 \uAC70\uC57C!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uD1B5\uACC4\uC801\uC73C\uB85C \uBCF4\uC558\uC744 \uB54C\\n\uC81C\uAC00 \uC774\uAE38 \uD655\uB960\uC740 95%\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC798\uD574 \uBCF4\uC790! \uC9C0\uAE08 \uC774 \uC2B9\uBD80\uB294\\n\uC2A4\uD2B8\uB9AC\uBC0D\uB418\uACE0 \uC788\uAC70\uB4E0!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "...\uC2DC\uC791\uD560\uAE4C?"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0 \uAC15\uD558\uBA74\\n\uC778\uAE30 \uC2A4\uD0C0\uAC00 \uB420 \uC218 \uC788\uC5B4!"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB180\uC774 \uB530\uC704\uAC00 \uC544\uB2C8\uC57C!\\n\uB098\uB294 \uC9C4\uC9C0\uD558\uB2E4\uACE0...!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC548\uB155 \uD53C\uCE74!\\n\uB098\uB791 \uC2B9\uBD80\uD560 \uD53C\uCE74?"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uBD10\uBD10! \uBCF4\uD1B5 \uBC29\uBC95\uC73C\uB85C\uB294 \uC7A1\uC744 \uC218 \uC5C6\uB294\\n\uC228\uACA8\uC9C4 \uD2B9\uC131\uC758 \uD3EC\uCF13\uBAAC\uC774\uC57C!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB0B4 \uD3EC\uCF13\uBAAC\uC758 \uB9E4\uB825\uC5D0\\n\uD479 \uBE60\uC9C0\uAC8C \uD574\uC8FC\uACA0\uC5B4!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC800\uC758 \uAC15\uD568\uC740\\n\uC911\uD558\uC704\uAD8C\uC785\uB2C8\uB2E4"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC6B4\uB3D9\uC774 \uBD80\uC871\uD574\uC11C\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD569\uB2C8\uB2E4!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC0AC\uC9C4\uC774 \uC798 \uB098\uC624\uB294\\n\uC2B9\uBD80\uB97C \uBD80\uD0C1\uD560\uAC8C!"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uC0AC\uBB34\uC2E4\uC5D0\uC11C\\n\uB0B4\uAC00 \uC5B4\uB5A4 \uC77C\uC744 \uD558\uB294\uC9C0 \uB9DE\uD600\uBCFC\uB798?"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uBE0C\uB9AC\uB354\uC758\\n\uC544\uCE68\uC740 \uBE60\uB974\uC9C0...!"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC54C\uC5D0\uC11C \uD0DC\uC5B4\uB09C \uD3EC\uCF13\uBAAC\uC740\\n\uD2B9\uBCC4\uD55C \uAE30\uC220\uC744 \uBC30\uC6B0\uACE0 \uC788\uC744 \uC218\uB3C4 \uC788\uC5B4"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uD0A4\uC6B0\uB294 \uAC83\uC774 \uC0AC\uB791\uC774\uB77C\uBA74\\n\uC2F8\uC6B0\uAC8C \uD558\uB294 \uAC83\uB3C4 \uC0AC\uB791\uC774\uC57C"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC548\uB155\uD558\uC138\uC694!\\n\uC800\uB294 \uC2E0\uC785 \uBE0C\uB9AC\uB354\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uC548\uC804 OK!\\n\uBCFC \uB358\uC9C0\uAE30\uB3C4 OK!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC815\uBE44\uD55C\\n\uC5F4\uCC28\uC5D0 \uD0C0\uBCF4\uC9C0 \uC54A\uC744\uB798!?"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uB0B4 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uADFC\uC131\uC774 \uB300\uB2E8\uD558\uB2E4\uACE0!"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uC758\uC0AC\uAC00 \uB098\uBCF4\uACE0\\n\uBAAC\uC2A4\uD130\uBCFC\uBCF4\uB2E4 \uBB34\uAC70\uC6B4 \uAC74 \uB4E4\uC9C0 \uB9D0\uB798..."
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uB108 \uB09C\uB2E4 \uAC15\uC790\uC758 \uB0C4\uC0C8...\\n\uB098 \uC6D0\uD55C\uB2E4! \uAC15\uD55C \uC0AC\uB78C!"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC628\uB77C\uC778 \uD0DC\uAD8C\uB3C4 \uAC15\uC758\uB85C\\n\uD2B8\uB808\uC774\uB2DD\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uC0B0\uC18D\uC5D0 \uD2C0\uC5B4\uBC15\uD600\uC11C\\n\uD3EC\uCF13\uBAAC\uC744 \uB2E8\uB828\uD588\uB2E4!"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uBD10\uBD10\\n\uBCF5\uADFC\uC774 \uCA4D\uCA4D \uAC08\uB77C\uC838 \uC788\uC9C0?"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uC751? \uBB50\uC608\uC694 \uBB50\uC608\uC694?\\n\uC2B9\uBD80\uD574\uC57C \uD558\uB294 \uADF8\uB7F0 \uBD84\uC704\uAE30\uC778\uAC00\uC694?"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974 \uC0AC\uB78C\uB4E4\uC740 \uBAA8\uB450 \uCE5C\uC808\uD588\uC5B4!\\n\uB108\uB3C4 \uADF8\uB7EC\uB2C8?"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uC624\uB298\uC740 \uBE44\uBC88\uC774\uC57C!\\n\uC190\uB2D8\uC774\uB77C\uACE0 \uD574\uB3C4 \uBD10\uC8FC\uC9C0 \uC54A\uC544"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uC5B4\uB514\uAE4C\uC9C0 \uAC00\uC2DC\uB098\uC694?"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uB09A\uC2DC\uC758 \uC9C4\uC218\uB294 \uAE30\uB2E4\uB9AC\uB294 \uAC83!\\n\uAE30\uB2E4\uB9AC\uACE0~ \uAE30\uB2E4\uB9AC\uACE0~ \uAE30\uB2E4\uB9AC\uACE0..."
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uB108\uB294 \uB09A\uC2DC \uC88B\uC544\uD574?\\n\uB098\uB294 \uC88B\uC544\uD574~"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uC73C\uC74C! \uB108\uB294 \uC218\uC0C1\uD55C \uB140\uC11D\uC774\uAD70!\\n\uBD88\uC2EC \uAC80\uBB38\uC744 \uC2DC\uC791\uD574\uC57C\uACA0\uB2E4!"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uB561\uB561\uC774\uCE58\uACE0 \uC788\uB294 \uAC8C \uC544\uB2C8\uC57C!\\n\uC21C\uCC30\uC758 \uC77C\uD658\uC774\uB77C\uACE0!"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uC544\uB984\uB2E4\uC6C0\uACFC \uAC15\uD568\uC774 \uC591\uB9BD\uD560 \uC218 \uC788\uB2E4\uB294 \uAC78\\n\uC99D\uBA85\uD574 \uBCF4\uC774\uACA0\uC5B4!"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uB7F0\uC6E8\uC774 \uBC16\uC5D0\uC11C\uB3C4\\n\uB098\uB294 \uBE5B\uB098\uB294 \uC2A4\uD0C0\uC57C"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130\uAC00 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD558\uBA74\\n\uD3EC\uCF13\uBAAC \uB9C8\uC2A4\uD130\uAC00 \uB418\uB294 \uAC74\uAC00!?"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uB4DC\uB9C1\uD06C\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4\\n\uB0B4 \uC190\uC744 \uAC70\uCE58\uBA74 \uD658\uACE8\uD0C8\uD0DC\uB97C \uD558\uC9C0..."
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uC800\uB294 \uAC00\uB77C\uB974\uC758\\n\uC720\uC11C \uAE4A\uC740 \uAC00\uBB38 \uCD9C\uC2E0\uC774\uB78D\uB2C8\uB2E4"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uAC15\uD558\uACE0 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uD3EC\uCF13\uBAAC\uC744\\n\uD3C9\uAC00\uD558\uAE30 \uC704\uD574 \uC654\uB2F5\uB2C8\uB2E4"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uB0B4 \uD3EC\uCF13\uBAAC\uC740 \uAC15\uC790!\\n\uCEF4 \uC628! \uC560\uC1A1\uC774 \uD55C\uD310 \uBD99\uC790!"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uC88B\uC544! \uBD84\uC704\uAE30\uAC00 \uB2EC\uC544\uC62C\uB790\uB2E4 \uC608\uC544!\\n\uBBA4\uC9C1... \uC2A4\uD0C0\uD2B8 \uC640\uC6B0!"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC740 \uBA54\uC778 \uB304\uC11C!\\n\uB098\uB294 \uBC31\uB304\uC11C!"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\uC790! \uB2E4 \uD568\uAED8 \uCDA4\uCDB0\uBCF4\uC790!"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\uC9C0\uAE08\uBD80\uD130 \uC2AC\uC2AC \uAC15\uD55C \uC0C1\uB300\uB9CC \uB098\uC640\uC11C\\n\uC704\uB85C \uBABB \uC62C\uB77C\uAC00\uB294 \uC0AC\uB78C\uB3C4 \uB9CE\uC544"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\uB300\uBC15! \uCC54\uD53C\uC5B8\uC774\uC796\uC544!\\n\uB9CC\uB098\uC11C \uC815\uB9D0 \uC601\uAD11\uC774\uC5D0\uC694!"
  },
  {
    "index": 72,
    "flags": 0,
