    "text": "\uB2EB\uB294\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E4\uC74C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[VAR 0201(0000)]/[VAR 0201(0001)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD0D0\uD5D8\uC218\uCE59"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[~ 5]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR FF00(0006)]X \uBC84\uD2BC[VAR FF00(0000)]\uC744 \uB204\uB974\uBA74 \uBA54\uB274\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4!\\n\\n\uBA54\uB274\uC5D0\uC11C [VAR FF00(0006)]\uB9AC\uD3EC\uD2B8[VAR FF00(0000)]\uB97C \uC120\uD0DD\uD558\uBA74\\n\uAE30\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\n\\n\uB610, [VAR FF00(0006)]\uD0C0\uC6B4\uB9F5[VAR FF00(0000)]\uC744 \uC120\uD0DD\uD558\uBA74\\n\uC9C0\uB3C4\uB098 \uBAA9\uC801\uC9C0\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uD0D0\uD5D8\uC218\uCE59\uC740 \uAC00\uBC29\uC758\\n\uC911\uC694\uD55C \uBB3C\uAC74\uC5D0 \uB4E4\uC5B4 \uC788\uC5B4\\n\uC5B8\uC81C\uB4E0\uC9C0 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR FF00(0006)]X \uBC84\uD2BC[VAR FF00(0000)]\uC744 \uB204\uB974\uBA74 \uBA54\uB274\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4!\\n\\n\uBA54\uB274\uC5D0\uC11C [VAR FF00(0006)]\uB9AC\uD3EC\uD2B8[VAR FF00(0000)]\uB97C \uC120\uD0DD\uD558\uBA74\\n\uAE30\uB85D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\n\\n\uD0D0\uD5D8\uC218\uCE59\uC740 \uAC00\uBC29\uC758\\n\uC911\uC694\uD55C \uBB3C\uAC74\uC5D0 \uB4E4\uC5B4 \uC788\uC5B4\\n\uC5B8\uC81C\uB4E0\uC9C0 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "YY\uD1B5\uC2E0"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "YY\uD1B5\uC2E0\uC740\\n\uBAA8\uD5D8\uC744 \uD558\uBA74\uC11C\\n\uB2E4\uB978 \uC0AC\uB78C\uACFC \uD3EC\uCF13\uBAAC \uAD50\uD658\uC774\uB098\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD560 \uC218 \uC788\uB294 \uB4F1\\n\uB2E4\uC591\uD55C \uD1B5\uC2E0\uC744 \uC990\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC774\uAC83\uC740 \uC2A4\uD2F0\uCEE4\uB77C\uACE0 \uD569\uB2C8\uB2E4.\\n\uC2A4\uD2F0\uCEE4\uB294 YY\uD1B5\uC2E0\uC5D0\uC11C\\n\uD1B5\uC2E0\uD560 \uD56D\uBAA9\uC744 \uC120\uD0DD\uD558\uACE0\\n\uD1B5\uC2E0\uC744 \uC2DC\uC791\uD558\uBA74\\n\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uC804\uB2EC\uB429\uB2C8\uB2E4!\\n\uC2A4\uD2F0\uCEE4\uC5D0\uB294 \uBA54\uC2DC\uC9C0\uB3C4 \uD3EC\uD568\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "YY\uD1B5\uC2E0\uC740\\n\uD3C9\uC18C\uC5D0\uB294 \uAC00\uAE4C\uC774 \uC788\uB294 \uC0AC\uB78C\uACFC\\n\uD1B5\uC2E0\uD569\uB2C8\uB2E4.\\n\u002B \uBC84\uD2BC\uC73C\uB85C \uC778\uD130\uB137\uC5D0 \uC811\uC18D\uD558\uBA74\\n\uC804 \uC138\uACC4\uC758 \uC0AC\uB78C\uB4E4\uACFC\\n\uD1B5\uC2E0\uD560 \uC218 \uC788\uAC8C \uB429\uB2C8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBAA8\uD5D8 \uC911\uC77C \uB54C\\n\uC2A4\uD2F0\uCEE4\uAC00 \uB3C4\uCC29\uD588\uB2E4\uBA74\\n\uD1B5\uC2E0\uC73C\uB85C \uB180 \uC218 \uC788\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4!\\n\\nY \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC11C \uCC3E\uC544\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC2E4\uB8E8\uC5E3\uC774 \uADF8\uB824\uC9C4\\n\uC2A4\uD2F0\uCEE4\uB97C \uC120\uD0DD\uD558\uBA74\\n\uCE5C\uAD6C\uC640 \uD568\uAED8\\n\uD3EC\uCF13\uBAAC\uACFC \uC2F8\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uB9AC\uADF8 \uCE74\uB4DC"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB9AC\uADF8 \uCE74\uB4DC\uB85C \uC790\uC2E0\uC758\\n\uD504\uB85C\uD544\uC744 \uC5B4\uD544\uD569\uC2DC\uB2E4!\\n\uAC01\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0 \uC788\uB294\\n\uCE74\uB4DC \uBA54\uC774\uCEE4\uC5D0\uC11C\\n\uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD558\uBA74\\n\uCD5C\uC2E0 \uC815\uBCF4\uB85C \uC5C5\uB370\uC774\uD2B8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB294 \uC800\uB9C8\uB2E4\\n\uB9AC\uADF8 \uCE74\uB4DC\uB97C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA70\\n\uD1B5\uC2E0\uC73C\uB85C \uAD50\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\nX \uBC84\uD2BC \uBA54\uB274\uC758 \uB9AC\uADF8 \uCE74\uB4DC\uC5D0\uC11C\\n\uC568\uBC94\uC744 \uC120\uD0DD\uD558\uBA74\\n\uBC1B\uC740 \uB9AC\uADF8 \uCE74\uB4DC\uB97C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "X \uBC84\uD2BC \uBA54\uB274\uC758 \uB9AC\uADF8 \uCE74\uB4DC\uC5D0\uC11C\\n\uC568\uBC94\uC744 \uC120\uD0DD\uD558\uBA74\\n\uBC1B\uC740 \uB9AC\uADF8 \uCE74\uB4DC\uB97C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uD1B5\uC2E0\uC73C\uB85C \uBC1B\uC740\\n\uB9AC\uADF8 \uCE74\uB4DC\uB3C4 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBC30\uD2C0\uC2A4\uD0C0\uB514\uC6C0"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uBC30\uD2C0\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\uB294\\n\uC804 \uC138\uACC4\uC758 \uC0AC\uB78C\uB4E4\uACFC\\n\uD1B5\uC2E0\uB300\uC804\uC744 \uD558\uAC70\uB098\\n\uB2E4\uC591\uD55C \uB300\uD68C\uC5D0\\n\uCC38\uAC00\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCE90\uC8FC\uC5BC\uBC30\uD2C0\uC740\\n\uB2E4\uC591\uD55C \uC0AC\uB78C\uB4E4\uACFC \uAC00\uBCCD\uAC8C\\n\uB300\uC804\uC744 \uC990\uAE38 \uC218 \uC788\uB294 \uBAA8\uB4DC\uC785\uB2C8\uB2E4.\\n\uC608\uC0C1 \uBC16\uC758 \uD3EC\uCF13\uBAAC\uC774\uB098\\n\uAE30\uC220\uC744 \uBCFC \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0\uC740\\n\uC9C4\uAC80\uC2B9\uBD80\uB97C \uD1B5\uD574\\n\uB7AD\uD06C\uB97C \uACA8\uB8E8\uB294 \uBAA8\uB4DC\uC785\uB2C8\uB2E4.\\n\uAC15\uD568\uC744 \uB098\uD0C0\uB0B4\uB294 \uB7AD\uD06C\uB294\\n\uB300\uC804 \uACB0\uACFC\uC5D0 \uB530\uB77C\\n\uC624\uB974\uAC70\uB098 \uB0B4\uB824\uAC11\uB2C8\uB2E4."
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC778\uD130\uB137 \uB300\uD68C\uB294\\n\uB808\uC774\uD305\uC774\uB77C\uB294 \uC218\uCE58\uB85C\\n\uAC15\uD568\uC744 \uB098\uD0C0\uB0B4\uBA70\\n\uC77C\uC815 \uAE30\uAC04 \uB300\uC804\uD574\uC11C\\n\uB808\uC774\uD305\uC744 \uACA8\uB8E8\uB294 \uBAA8\uB4DC\uC785\uB2C8\uB2E4.\\n\uB2E4\uB978 \uBAA8\uB4DC\uC640\uB294 \uB2E4\uB974\uAC8C\\n\uC9C1\uC811 \uB300\uD68C\uB97C \uCC3E\uC544\uC11C\\n\uCC38\uAC00\uD574\uC57C \uD569\uB2C8\uB2E4."
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uD3EC\uCF13\uBAAC\uC740\\n\uD2B9\uC815\uD55C \uC7A5\uC18C\uC5D0\uC11C \uAC70\uB300\uD574\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\uC774\uB97C \uB2E4\uC774\uB9E5\uC2A4\uB77C\uACE0 \uBD80\uB985\uB2C8\uB2E4.\\n\uB2E4\uC774\uB9E5\uC2A4 \uBC34\uB4DC\uAC00 \uBE5B\uB0A0 \uB54C\\n[VAR FF00(0006)]\uB2E4\uC774\uB9E5\uC2A4 \uBC84\uD2BC[VAR FF00(0000)]\uC744 \uB204\uB974\uBA74\\n\uD3EC\uCF13\uBAAC\uC774 \uB2E4\uC774\uB9E5\uC2A4\uD569\uB2C8\uB2E4."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC788\uB294 \uAC74 [VAR FF00(0006)]3\uD134[VAR FF00(0000)]\uAE4C\uC9C0\uC785\uB2C8\uB2E4!\\n\\n\uADF8 \uB3D9\uC548 \uB2E4\uC774\uB9E5\uC2A4\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAC15\uB825\uD55C \uAE30\uC220 [VAR FF00(0006)]\uB2E4\uC774\uB9E5\uC2A4\uAE30\uC220[VAR FF00(0000)]\uC744\\n\uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\uAC8C\uB2E4\uAC00 \uB2E4\uC774\uB9E5\uC2A4\uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uBA74\\n\uD2B9\uBCC4\uD55C \uD6A8\uACFC\uAC00 \uBC1C\uC0DD\uD569\uB2C8\uB2E4.\\n\uD6A8\uACFC\uB294 \uD0C0\uC785\uB9C8\uB2E4 \uB2E4\uB985\uB2C8\uB2E4.\\n\\n\uB2E4\uC774\uB9E5\uC2A4\uD560 \uD0C0\uC774\uBC0D\uC744\\n\uC798 \uAC00\uB2A0\uD574\uC11C \uC2B9\uB9AC\uB97C \uAC70\uBA38\uC961\uC2DC\uB2E4!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uCEA0\uD504"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uCEA0\uD504\uC5D0\uC11C\uB294\\n\uD3EC\uCF13\uBAAC\uB4E4\uACFC \uD568\uAED8 \uB180\uAC70\uB098\\n\uC694\uB9AC\uB97C \uBA39\uC73C\uBA70 \uCE5C\uD574\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\n\uB9CE\uC774 \uB180\uC544\uC8FC\uBA74 \uC2B9\uBD80\uC5D0\uC11C\uB3C4\\n\uC5F4\uC2EC\uD788 \uD574\uC904 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "Joy-Con\uC73C\uB85C\uB3C4 \uB180\uC544\uBD05\uC2DC\uB2E4!\\nJoy-Con\uC744 \uBD84\uB9AC\uD574\uC11C \uD754\uB4E4\uBA74\\n\uBCFC\uC744 \uB358\uC9C0\uAC70\uB098 \uD3EC\uCF13\uD480\uC744\\n\uD754\uB4E4\uBA70 \uB180 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\n\uD3EC\uCF13\uD480\uC744 \uC798 \uD754\uB4E4\uBA74\\n\uD3EC\uCF13\uBAAC\uC758 \uC8FC\uC758\uB97C \uB04C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uCEA0\uD504\uB97C \uC5F4\uBA74\\n\uCD5C\uB300 4\uBA85\uC774\\n\uD568\uAED8 \uB180 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\uACBD\uC6B0\uC5D0 \uB530\uB77C\uC11C\uB294 \uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uC774\uB098\\n\uD3EC\uCF13\uBAAC\uC774 \uB4E4\uC5B4\uC624\uB294 \uACBD\uC6B0\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\\n\uD568\uAED8 \uC0AC\uC774\uC88B\uAC8C \uB180\uC544\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC694\uB9AC"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC88B\uC544\uD558\uB294 \uC2DD\uC7AC\uB8CC\uC640 \uB098\uBB34\uC5F4\uB9E4\uB97C\\n\uC120\uD0DD\uD574\uC11C \uC694\uB9AC\uB97C \uB9CC\uB4E4\uC5B4\uBD05\uC2DC\uB2E4!\\n\\n\uADC0\uC911\uD55C \uC7AC\uB8CC\uB97C \uC0AC\uC6A9\uD558\uAC70\uB098\\n\uB098\uBB34\uC5F4\uB9E4\uB97C \uB9CE\uC774 \uB123\uC73C\uBA74\\n\uC694\uB9AC\uAC00 \uB9DB\uC788\uC5B4\uC9D1\uB2C8\uB2E4."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC694\uB9AC\uAC00 \uC2DC\uC791\uB418\uBA74\\n\uBD80\uCC44\uB85C \uBD88\uC744 \uC870\uC808\uD558\uACE0\\n\uAD6D\uC790\uB85C \uB0C4\uBE44\uAC00\\n\uB118\uCE58\uC9C0 \uC54A\uAC8C \uC798 \uC11E\uC5B4\uC90D\uC2DC\uB2E4!\\n\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD3EC\uCF13\uBAAC\uC744 \uC704\uD574\\n\uC801\uC808\uD55C \uD0C0\uC774\uBC0D\uC5D0 \uC815\uC131\uC744 \uB2F4\uC73C\uBA74 \uC644\uC131\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC694\uB9AC\uAC00 \uC644\uC131\uB418\uC5C8\uB2E4\uBA74\\n\uB2E4 \uAC19\uC774 \uBA39\uC74D\uC2DC\uB2E4!\\n\uC694\uB9AC\uB97C \uBA39\uC73C\uBA74 \uCEA0\uD504\uC5D0 \uCC38\uAC00\uD55C\\n\uD3EC\uCF13\uBAAC\uB4E4\uC774 \uAC74\uAC15\uD574\uC9C0\uAC70\uB098\\n\uD3EC\uCF13\uBAAC\uB4E4\uACFC \uC0AC\uC774\uAC00 \uC88B\uC544\uC9C0\uB294 \uB4F1\\n\uB2E4\uC591\uD55C \uD6A8\uACFC\uAC00 \uBC1C\uC0DD\uD569\uB2C8\uB2E4."
  },
  {
    "index": 34,
    "flags": 0,
    "text": "[~ 34]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uAD74"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uBD89\uC740 \uBE5B\uC774 \uC19F\uC544\uB098\uACE0 \uC788\uB294 \uACF3\uC5D0\uB294\\n\uD3EC\uCF13\uBAAC\uAD74\uC774 \uC788\uC2B5\uB2C8\uB2E4.\\n\uAD74\uC5D0\uB294 \uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC774 \uC228\uC5B4\uC788\uC73C\uBA70\\n\uC870\uC0AC\uD558\uBA74 \uD63C\uC790\uC11C \uB610\uB294\\n4\uBA85\uC774 \uD568\uAED8 \uC2F8\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uBE5B\uC758 \uAE30\uB465\uC774 \uC5C6\uB294\\n\uD3EC\uCF13\uBAAC\uAD74\uC5D0\uB294\\n\uC18C\uC6D0\uC758\uC870\uAC01\uC744 \uB358\uC838\uB123\uC73C\uBA74\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC774 \uB098\uD0C0\uB0A9\uB2C8\uB2E4!\\n\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uD3EC\uCF13\uBAAC\uAD74\uC5D0\\n\uC18C\uC6D0\uC758\uC870\uAC01\uC744 \uB358\uC838\uB123\uC5B4 \uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uBE5B\uB098\uB294 \uD3EC\uCF13\uBAAC\uAD74\uC5D0\uC11C\uB294\\nW\uB77C\uB294 \uC5D0\uB108\uC9C0\uB97C \uC190\uC5D0 \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC758 \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C\\nW\uB97C \uC8FC\uBA74 \uB2E4\uC591\uD55C \uB3C4\uAD6C\uB97C\\n\uC190\uC5D0 \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744 \uC774\uAE30\uBA74\\n\uD3EC\uD68D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uADF8\uBC16\uC5D0 \uC774 \uBC29\uBC95\uC73C\uB85C\uB9CC\\n\uBC1C\uACAC\uD560 \uC218 \uC788\uB294 \uD76C\uADC0\uD55C \uB3C4\uAD6C\uB3C4\\n\uC190\uC5D0 \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC57C\uC0DD\uC758 \uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC740\\n\uB9E4\uC6B0 \uAC15\uB825\uD569\uB2C8\uB2E4.\\n\uAE30\uC220\uC744 \uC5F0\uC18D\uC73C\uB85C \uC0AC\uC6A9\uD558\uAC70\uB098\\n\uD2B9\uBCC4\uD55C \uD589\uB3D9\uC744 \uD569\uB2C8\uB2E4.\\n4\uBA85\uC774 \uC11C\uB85C \uD611\uB825\uD574\uC11C\\n\uC2F8\uC6B0\uB294 \uAC83\uC774 \uC911\uC694\uD569\uB2C8\uB2E4."
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB97C \uC774\uC6A9\uD558\uBA74\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uAC00\uACE0 \uC2F6\uC740 \uACF3 \uC5B4\uB514\uB77C\uB3C4\\n\uD3EC\uCF13\uBAAC \uC544\uBA38\uAE4C\uC624\uB97C \uD0C0\uACE0 \uC21C\uC2DD\uAC04\uC5D0 \uB0A0\uC544\uAC11\uB2C8\uB2E4!\\n\\n\uBA54\uB274\uB97C \uC5F4\uACE0 \uD0C0\uC6B4\uB9F5\uC5D0\uC11C\\n\uAC00\uACE0 \uC2F6\uC740 \uC7A5\uC18C\uB97C \uC120\uD0DD\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "[~ 44]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "PC\uC758 \uBC15\uC2A4"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0 \uC788\uB294\\nPC\uC758 \uBC15\uC2A4\uC5D0\\n\uC790\uC2E0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uB9E1\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uB9E1\uAE34 \uD3EC\uCF13\uBAAC\uC740 PC\uAC00 \uC788\uB294 \uACF3\uC774\uB77C\uBA74\\n\uC5B4\uB514\uC11C\uB4E0 \uB370\uB824\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 47,
    "flags": 0,
    "text": "X \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uBAA8\uB4DC\uAC00\\n\uBC15\uC2A4 \uC815\uB9AC\uB85C \uC804\uD658\uB429\uB2C8\uB2E4.\\n\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uACFC \uBC15\uC2A4\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uAD50\uCCB4\uD558\uAC70\uB098 \uC21C\uC11C\uB97C\\n\uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 48,
    "flags": 0,
    "text": "Y \uBC84\uD2BC\uC744 \uB204\uB974\uBA74\\n\uC870\uC791 \uBAA8\uB4DC\uAC00 \uC804\uD658\uB429\uB2C8\uB2E4.\\n\uBE68\uAC04\uC0C9 \uCEE4\uC11C\uB294 \uC77C\uBC18 \uC870\uC791,\\n\uD30C\uB780\uC0C9 \uCEE4\uC11C\uB294 \uC5F0\uC18D\uC73C\uB85C\\n\uD3EC\uCF13\uBAAC\uC744 \uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\uCD08\uB85D\uC0C9 \uCEE4\uC11C\uB294 \uD55C\uAEBC\uBC88\uC5D0 \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 49,
    "flags": 0,
    "text": "[~ 49]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "[~ 50]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "[~ 51]"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC7A1"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29\uC5D0\uC11C\uB294\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uC758\uB8B0\uD558\uAE30\uB3C4 \uD569\uB2C8\uB2E4.\\n\uD3EC\uCF13\uBAAC\uC744 \uBCF4\uB0B4\uC11C \uB3C4\uC640\uC90D\uC2DC\uB2E4.\\n\\n\uBCF4\uB0B8 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uC131\uC7A5\uD574\uC11C \uB3CC\uC544\uC635\uB2C8\uB2E4!"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uB3C4\uC6C0 \uC758\uB8B0\uB294\\n\uD558\uB8E8\uC5D0 \uD55C \uBC88 \uC5C5\uB370\uC774\uD2B8\uB429\uB2C8\uB2E4.\\n\uAFB8\uC900\uD788 \uB3C4\uC6C0\uC744 \uC8FC\uAC70\uB098\\n\uD3EC\uCF13\uBAAC\uC744 \uB9CE\uC774 \uBCF4\uB0BC\uC218\uB85D\\n\uC88B\uC740 \uC77C\uC774 \uC77C\uC5B4\uB098\uAC8C \uB429\uB2C8\uB2E4.\\n\uB2E4\uC591\uD55C \uB3C4\uC6C0 \uC758\uB8B0\uB97C \uD574\uACB0\uD574\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uB3C4\uC6C0 \uC758\uB8B0\uB294\\n\uD558\uB8E8\uC5D0 \uD55C \uBC88\uB9CC \uC5C5\uB370\uC774\uD2B8\uB418\uBA70\\n\uACC4\uC18D\uD574\uC11C \uB192\uC740 \uD3C9\uAC00\uB97C \uBC1B\uC73C\uBA74\\n\uC758\uB8B0 \uC218\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4.\\n\\n\uB3C4\uC6C0\uC774 \uD544\uC694\uD55C \uACF3\uC73C\uB85C\\n\uC6D0\uD558\uB294 \uD3EC\uCF13\uBAAC\uC744 \uB9CE\uC774 \uBCF4\uB0B4\uBA74\\n\uB192\uC740 \uD3C9\uAC00\uB97C \uBC1B\uC744 \uC218 \uC788\uC73C\uB2C8\\n\uC758\uB8B0\uC5D0 \uC54C\uB9DE\uC740\\n\uD3EC\uCF13\uBAAC\uC744 \uC120\uD0DD\uD569\uC2DC\uB2E4!"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "[~ 56]"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB780\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC5D0 \uC788\uB294 8\uAC1C\uC758 \uCCB4\uC721\uAD00\uC744 \uB3CC\uBA70\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBAA8\uC73C\uB294 \uC774\uBCA4\uD2B8\uC785\uB2C8\uB2E4.\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uC190\uC5D0 \uB123\uC73C\uB824\uBA74\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4\uD558\uACE0\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C \uC2B9\uB9AC\uD574\uC57C \uD569\uB2C8\uB2E4."
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uB77C\uC774\uBE0C \uB300\uD68C"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uB77C\uC774\uBE0C \uB300\uD68C\uB294 \uB2E4 \uD568\uAED8 \uBAA8\uC5EC\uC11C\\n\uB300\uD68C\uB97C \uC990\uAE30\uB294 \uBAA8\uB4DC\uC785\uB2C8\uB2E4.\\n\\n\uACF5\uC2DD \uB300\uD68C\uC5D0 \uCC38\uAC00\uD558\uAC70\uB098\\n\uC9C1\uC811 \uB300\uD68C\uB97C\\n\uAC1C\uCD5C\uD560 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uACF5\uC2DD\uC73C\uB85C \uAC1C\uCD5C\uB418\uB294\\n\uB300\uD68C\uC758 \uC815\uBCF4\uB294\\n\uD3EC\uCF13\uBAAC \uACF5\uC2DD \uC0AC\uC774\uD2B8\uB97C\\n\uD655\uC778\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uB300\uD68C\uB97C \uAC1C\uCD5C\uD55C\uB2E4"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uB77C\uC774\uBE0C \uB300\uD68C\uB97C\\n\uC9C1\uC811 \uAC1C\uCD5C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uB300\uC804\uD558\uACE0 \uC2F6\uC740 \uB8F0\uC744 \uB9CC\uB4E4\uC5B4\uC11C\\n\uCC38\uAC00\uC790 \uC804\uC6D0\uC5D0\uAC8C \uD1B5\uC2E0\uC73C\uB85C\\n\uB8F0\uC744 \uC1A1\uC2E0\uD569\uC2DC\uB2E4.\\n\\n\uC790\uC138\uD55C \uB0B4\uC6A9\uC740\\n\uD3EC\uCF13\uBAAC \uACF5\uC2DD \uC0AC\uC774\uD2B8\uB97C\\n\uD655\uC778\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uCE90\uC8FC\uC5BC\uBC30\uD2C0"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uCE90\uC8FC\uC5BC\uBC30\uD2C0\uC5D0\uC11C\uB294\\n\uB2E4\uC74C \uB8F0\uC744 \uC900\uC218\uD574\uC11C\\n\uB300\uC804\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.\\n\\n[VAR FF00(0006)]\uC11C\uB85C \uB2E4\uB978 6\uB9C8\uB9AC\uC758 \uD3EC\uCF13\uBAAC[VAR FF00(0000)]\uC73C\uB85C\\n\uBC30\uD2C0\uD300\uC744 \uB9CC\uB4E0\uB2E4\\n\\n\uAC01\uAC01\uC758 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB294\\n[VAR FF00(0006)]\uC11C\uB85C \uB2E4\uB978 \uB3C4\uAD6C\uB97C \uC9C0\uB2C8\uAC8C \uD55C\uB2E4[VAR FF00(0000)]"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uCE90\uC8FC\uC5BC\uBC30\uD2C0\uC5D0\uC11C\uB294\\n\uD2B9\uBCC4\uD55C \uD3EC\uCF13\uBAAC\uC744\\n\uBC30\uD2C0\uD300\uC5D0 \uB123\uC5B4\uC11C\\n\uB300\uC804\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uC88B\uC544\uD558\uB294 \uD3EC\uCF13\uBAAC\uC73C\uB85C\\n\uB300\uC804\uD574\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0\uC5D0\uC11C\uB294\\n\uB2E4\uC74C \uB8F0\uC744 \uC900\uC218\uD574\uC11C\\n\uB300\uC804\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.\\n\\n[VAR FF00(0006)]\uC11C\uB85C \uB2E4\uB978 6\uB9C8\uB9AC\uC758 \uD3EC\uCF13\uBAAC[VAR FF00(0000)]\uC73C\uB85C\\n\uBC30\uD2C0\uD300\uC744 \uB9CC\uB4E0\uB2E4\\n\\n\uAC01\uAC01\uC758 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB294\\n[VAR FF00(0006)]\uC11C\uB85C \uB2E4\uB978 \uB3C4\uAD6C\uB97C \uC9C0\uB2C8\uAC8C \uD55C\uB2E4[VAR FF00(0000)]\\n\\n[VAR FF00(0006)]\uD2B9\uBCC4\uD55C \uD3EC\uCF13\uBAAC\uC744\\n\uBC30\uD2C0\uD300\uC5D0 \uB123\uC9C0 \uC54A\uB294\uB2E4[VAR FF00(0000)]"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0\uC5D0\uC11C\uB294\\n\uB300\uC804\uC758 \uACB0\uACFC\uC5D0 \uB530\uB77C\\n\uD3EC\uC778\uD2B8\uAC00 \uB298\uAC70\uB098 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\\n\\n\uB300\uC804\uC744 \uAC70\uB4ED\uD574\uC11C\\n\uC77C\uC815 \uD3EC\uC778\uD2B8\uB97C \uB118\uC73C\uBA74\\n\uB7AD\uD06C\uAC00 \uC624\uB974\uBA70\\n\uC77C\uC815 \uD3EC\uC778\uD2B8\uBCF4\uB2E4 \uB0AE\uC544\uC9C0\uBA74\\n\uB7AD\uD06C\uAC00 \uB0B4\uB824\uAC11\uB2C8\uB2E4."
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0\uC5D0\uC11C\uB294\\n\uB300\uC804\uC5D0\uC11C \uC838\uB3C4\\n\uACC4\uAE09\uC774 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\\n\\n\uC608\uB97C \uB4E4\uC5B4\\n\uD558\uC774\uD37C\uBCFC\uAE09\uC778 \uC0AC\uB78C\uC740\\n\uC218\uD37C\uBCFC\uAE09\uC73C\uB85C \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0\uC740\\n\uC77C\uC815 \uAE30\uAC04 \uAC1C\uCD5C\uB429\uB2C8\uB2E4.\\n\uC774 \uAE30\uAC04\uC744 \uC2DC\uC98C\uC774\uB77C\uACE0 \uBD80\uB985\uB2C8\uB2E4.\\n\\n\uC2DC\uC98C\uC774 \uB05D\uB098\uBA74\\n\uB2E4\uC74C \uC2DC\uC98C\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4.\\n\\n\uB2E4\uC74C \uC2DC\uC98C\uC774 \uC2DC\uC791\uB418\uBA74\\n\uCC38\uAC00\uC790 \uC804\uC6D0\uC758 \uB7AD\uD06C\uAC00 \uB0B4\uB824\uAC11\uB2C8\uB2E4.\\n\uC774\uB54C\uB294 \uACC4\uAE09\uB3C4 \uB0B4\uB824\uAC11\uB2C8\uB2E4."
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0\uC5D0\uC11C\\n\uAC00\uC7A5 \uB192\uC740 \uB7AD\uD06C\uC5D0 \uB3C4\uB2EC\uD55C \uC0AC\uB78C\uC740\\n\uB7AD\uD06C\uAC00 \uC624\uB974\uB294 \uB300\uC2E0\\n\uC21C\uC704\uB97C \uACA8\uB8E8\uAC8C \uB429\uB2C8\uB2E4.\\n\\n\uC21C\uC704\uB294 \uB300\uC804 \uACB0\uACFC\uC5D0 \uB530\uB77C\\n\uC624\uB974\uAC70\uB098 \uB0B4\uB824\uAC11\uB2C8\uB2E4."
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uC778\uD130\uB137 \uB300\uD68C"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uC778\uD130\uB137 \uB300\uD68C\uC5D0\uB294\\n\\n\uACF5\uC2DD \uB300\uD68C\uC640\\n\uB3D9\uB8CC \uB300\uD68C\uC758\\n\\n2\uC885\uB958\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uACF5\uC2DD \uB300\uD68C\uB294\\n\uB2E4\uC591\uD55C \uB8F0\uB85C \uC21C\uC704\uB97C \uACA8\uB8E8\uB294\\n\uD2B9\uBCC4\uD55C \uB300\uD68C\uC785\uB2C8\uB2E4.\\n\\n\uAC1C\uCD5C \uC2A4\uCF00\uC904\uC774\uB098\\n\uCC38\uAC00\uD560 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD55C \uC815\uBCF4\uB294\\n\uD3EC\uCF13\uBAAC \uACF5\uC2DD \uC0AC\uC774\uD2B8 \uB4F1\uC5D0\uC11C\\n\uC548\uB0B4\uD569\uB2C8\uB2E4."
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uB3D9\uB8CC \uB300\uD68C\uB294\\n\uD50C\uB808\uC774\uC5B4\uAC00 \uAC1C\uCD5C\uD574\uC11C\\n\uBAA8\uC778 \uC0AC\uB78C\uB4E4\uB07C\uB9AC \uB300\uC804\uD558\uB294\\n\uCE90\uC8FC\uC5BC\uD55C \uB300\uD68C\uC785\uB2C8\uB2E4.\\n\\n\uB2E4\uC591\uD55C \uB3D9\uB8CC \uB300\uD68C\uC5D0\uC11C\\n\uB300\uC804\uD574\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uACF5\uC2DD \uB300\uD68C\uB098 \uB3D9\uB8CC \uB300\uD68C\uB97C\\n\uCC3E\uC544\uC11C \uC5D4\uD2B8\uB9AC\uD558\uBA74\\n\uADF8 \uB300\uD68C\uAC00 \uC2DC\uC791\uB418\uC5C8\uC744 \uB54C\\n\uB300\uC804\uD560 \uC218 \uC788\uAC8C \uB429\uB2C8\uB2E4.\\n\\n\uC790\uC2E0\uC774 \uC88B\uC544\uD558\uB294 \uB8F0\uC774\uB098\\n\uC0AC\uC6A9\uD558\uACE0 \uC2F6\uC740 \uD3EC\uCF13\uBAAC\uC744 \uACE0\uB824\uD574\uC11C\\n\uB300\uD68C\uB97C \uCC3E\uC544\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uBC15\uC2A4"
  },
  {
    "index": 78,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uBC15\uC2A4\uB97C \uC0AC\uC6A9\uD558\uBA74\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uACFC \uD3EC\uCF13\uBAAC\uC13C\uD130\uC758\\nPC\uC5D0 \uB9E1\uAE34 \uD3EC\uCF13\uBAAC\uC744\\n\uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uBA54\uB274\uC758 \uD3EC\uCF13\uBAAC\uB9AC\uC2A4\uD2B8\uC5D0\uC11C\\nR \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  },
  {
    "index": 79,
    "flags": 0,
    "text": "\uB7AD\uD06C\uBC30\uD2C0\uC5D0 \uB300\uD55C \uC548\uB0B4"
  },
  {
    "index": 80,
    "flags": 0,
    "text": "\uBA54\uB274\uC758 VS\uC5D0\uC11C\\n\uBC30\uD2C0\uC2A4\uD0C0\uB514\uC6C0\uC744 \uC120\uD0DD\uD558\uBA74\\n\uB7AD\uD06C\uBC30\uD2C0\uC744 \uD50C\uB808\uC774\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\n\uBC30\uD2C0\uD0C0\uC6CC\uC5D0\uC11C \uC2E4\uB825\uC744 \uAC08\uACE0\uB2E6\uC740 \uB4A4\\n\uB3C4\uC804\uD574\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 81,
    "flags": 0,
    "text": "\uB09A\uC2DC"
  },
  {
    "index": 82,
    "flags": 0,
    "text": "\uC218\uBA74\uC5D0 \uBE44\uCE58\uB294\\n\uD3EC\uCF13\uBAAC\uC758 \uADF8\uB9BC\uC790\uB97C \uD5A5\uD574 A \uBC84\uD2BC\uC744 \uB204\uB974\uBA74\\n\uB09A\uC2DC\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4!\\n\uB09A\uC2EF\uB300\uAC00 \uD754\uB4E4\uB9AC\uBA74 \uB2E4\uC2DC A \uBC84\uD2BC!\\n\uD3EC\uCF13\uBAAC\uC744 \uB09A\uC544 \uC62C\uB9BD\uB2C8\uB2E4.\\n\uB2E4\uC591\uD55C \uACF3\uC5D0\uC11C \uB09A\uC2DC\uD574\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 83,
    "flags": 0,
    "text": "[~ 83]"
  },
  {
    "index": 84,
    "flags": 0,
    "text": "\uB80C\uD0C8\uD300"
  },
  {
    "index": 85,
    "flags": 0,
    "text": "\uB80C\uD0C8\uD300\uC774\uB780 \uC778\uD130\uB137\uC5D0\\n\uACF5\uAC1C \uC911\uC778 \uB2E4\uB978 \uC0AC\uB78C\uC758\\n\uBC30\uD2C0\uD300\uC744 \uBE4C\uB9AC\uAC70\uB098\\n\uC790\uC2E0\uC758 \uBC30\uD2C0\uD300\uC744 \uACF5\uAC1C\uD574\uC11C\\n\uBE4C\uB824\uC904 \uC218 \uC788\uB294 \uC2DC\uC2A4\uD15C\uC785\uB2C8\uB2E4.\\n\\n\uACF5\uAC1C\uD588\uC744 \uB54C \uBC1C\uD589\uB418\uB294\\n\uD300 ID\uB97C \uC785\uB825\uD558\uBA74\\n\uADF8 \uBC30\uD2C0\uD300\uC744\\n\uC0AC\uC6A9\uD560 \uC218 \uC788\uAC8C \uB429\uB2C8\uB2E4."
  },
  {
    "index": 86,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC5D0 \uAC00\uB294 \uBC29\uBC95"
  },
  {
    "index": 87,
    "flags": 0,
    "text": "\uAC11\uC637\uD328\uC2A4\uB97C \uC190\uC5D0 \uB123\uC5C8\uC2B5\uB2C8\uB2E4!\\n\uBE0C\uB798\uC2DC\uB9C8\uC744\uC5ED\uC5D0 \uC788\uB294 \uC5ED\uBB34\uC6D0\uC5D0\uAC8C \uBCF4\uC5EC\uC8FC\uBA74\\n\uAC11\uC637\uC12C\uC5D0 \uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAC70\uB098\\n\uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8 \uC131\uC7A5\uD560 \uC218 \uC788\uB294\\n\uC0C8\uB85C\uC6B4 \uBAA8\uD5D8\uC744 \uB5A0\uB098\uBCF4\uC138\uC694!"
  },
  {
    "index": 88,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uC5D0 \uAC00\uB294 \uBC29\uBC95"
  },
  {
    "index": 89,
    "flags": 0,
    "text": "\uC655\uAD00\uD328\uC2A4\uB97C \uC190\uC5D0 \uB123\uC5C8\uC2B5\uB2C8\uB2E4!\\n\uBE0C\uB798\uC2DC\uB9C8\uC744\uC5ED\uC5D0 \uC788\uB294 \uC5ED\uBB34\uC6D0\uC5D0\uAC8C \uBCF4\uC5EC\uC8FC\uBA74\\n\uC655\uAD00\uC124\uC6D0\uC5D0 \uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\n\uC218\uC218\uAED8\uB07C\uB85C \uAC00\uB4DD\uD55C \uB208 \uB36E\uC778 \uC124\uC6D0\uC5D0\uC11C\\n\uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\uC744 \uCC3E\uAE30 \uC704\uD55C\\n\uC0C8\uB85C\uC6B4 \uBAA8\uD5D8\uC744 \uB5A0\uB098\uBCF4\uC138\uC694!"
  },
  {
    "index": 90,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98"
  },
  {
    "index": 91,
    "flags": 0,
    "text": "4\uC778\uC774 \uD55C \uD300\uC774 \uB418\uC5B4\uC11C\\n\uC218\uC218\uAED8\uB07C\uC5D0 \uB458\uB7EC\uC2F8\uC778\\n\uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74\uC744 \uD0D0\uD5D8\uD569\uB2C8\uB2E4!\\n\\n\uAD74 \uC548\uCABD \uAE4A\uC740 \uACF3\uC5D0\uB294\\n\uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 92,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uB80C\uD0C8\uD574\uC11C \uC9C4\uD589\uD569\uB2C8\uB2E4.\\n\\n\uC6B0\uC120 \uD568\uAED8 \uD0D0\uD5D8\uD560 \uD3EC\uCF13\uBAAC\uC744\\n1\uB9C8\uB9AC\uC529 \uC120\uD0DD\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 93,
    "flags": 0,
    "text": "\uAD74 \uC548\uC5D0\uB294 \uAC08\uB9BC\uAE38\uC774 \uC788\uC2B5\uB2C8\uB2E4.\\n\uB2E4 \uAC19\uC774 \uC0C1\uC758\uD574\uC11C \uB098\uC544\uAC08 \uAE38\uC744 \uC815\uD574\uC8FC\uC138\uC694.\\n\uB3C4\uC911\uC5D0 \uB9CC\uB098\uB294 \uD3EC\uCF13\uBAAC\uACFC\uB294\\n\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uB85C \uBC30\uD2C0\uD569\uB2C8\uB2E4!\\n\uC7A1\uC740 \uD3EC\uCF13\uBAAC\uC744 \uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uACFC \uAD50\uCCB4\uD558\uBA74\uC11C\\n\uC548\uCABD\uAE4C\uC9C0 \uB098\uC544\uAC11\uC2DC\uB2E4!"
  },
  {
    "index": 94,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655 \uC804\uC124"
  },
  {
    "index": 95,
    "flags": 0,
    "text": "\uD504\uB9AC\uC988\uB9C8\uC744\uC5D0\uB294 \uD48D\uC694\uC758 \uC655\uC774\uB77C \uBD88\uB9AC\uB294\\n\uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD55C \uC774\uC57C\uAE30\uAC00 \uC804\uD574\uC838 \uB0B4\uB824\uC628\uB2E4\\n\uADF8 \uC774\uC57C\uAE30\uC5D0 \uB530\uB974\uBA74 \uBA38\uB9AC\uC5D0\\n\uCEE4\uB2E4\uB780 \uC655\uAD00\uC744 \uC4F0\uACE0 \uC788\uB2E4\uB294 \uB4EF\uD558\uB098\\n\uB9C8\uC744 \uC911\uC559\uC5D0 \uC788\uB294 \uB098\uBB34 \uC870\uAC01\uC0C1\uC5D0\uC11C\\n\uC655\uAD00 \uAC19\uC740 \uAC83\uC740 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4"
  },
  {
    "index": 96,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655 \uC870\uAC01\uC0C1\uC5D0 \uC655\uAD00\uC744 \uC50C\uC6B0\uC790\\n\uBC84\uB4DC\uB809\uC2A4\uAC00 \uB098\uD0C0\uB0AC\uB2E4\\n\uD53C\uC624\uB2C8 \uB300\uC7A5\uC758 \uBAB8\uC744 \uC870\uC885\uD558\uC5EC\\n\uC778\uAC04\uC758 \uB9D0\uC744 \uD560 \uC218 \uC788\uB294 \uB4EF\uD558\uB2E4\\n\uB9C8\uC744\uC5D0\uC11C \uD48D\uC694\uC758 \uC655\uC5D0 \uB300\uD55C \uC815\uBCF4\uB97C \uBAA8\uC544\uBCF4\uC790"
  },
  {
    "index": 97,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655\uC758 \uC560\uB9C8\uB97C \uCC3E\uAE30 \uC704\uD574\\n\uADF8 \uD3EC\uCF13\uBAAC\uC774 \uC990\uACA8 \uBA39\uB358\\n\uB2F9\uADFC\uC744 \uCC3E\uAE30\uB85C \uD558\uC600\uB2E4\\n\\n\uD504\uB9AC\uC988\uB9C8\uC744\uC758 \uC0AC\uB78C\uB4E4\uC774\uB77C\uBA74\\n\uBB54\uAC00 \uC54C\uACE0 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4"
  },
  {
    "index": 98,
    "flags": 0,
    "text": "\uB2F9\uADFC\uC528\uB97C \uCC3E\uC558\uB2E4\uACE0\\n\uBC84\uB4DC\uB809\uC2A4\uC5D0\uAC8C \uBCF4\uACE0\uD558\uC790\\n\uB2F9\uADFC\uC774 \uC790\uB784 \uC218 \uC788\uB294\\n\uB450 \uBC2D\uC758 \uC704\uCE58\uB97C \uC54C\uB824 \uC8FC\uC5C8\uB2E4\\n\uB208 \uB36E\uC778 \uBC2D\uACFC \uBB18\uC9C0 \uADFC\uCC98 \uBC2D \uC911\\n\uD55C \uACF3\uC744 \uC815\uD574\uC11C \uC528\uB97C \uBFCC\uB9AC\uB3C4\uB85D \uD558\uC790"
  },
  {
    "index": 99,
    "flags": 0,
    "text": "\uB208 \uB36E\uC778 \uBC2D\uC5D0 \uC528\uB97C \uBFCC\uB838\uB354\uB2C8\\n\uBC84\uB4DC\uB809\uC2A4\uC758 \uD798\uC73C\uB85C\\n\uCC28\uAC00\uC6B4\uB2F9\uADFC\uC774 \uC790\uB790\uB2E4!\\n\uB2F9\uADFC \uB0C4\uC0C8\uB97C \uB9E1\uACE0\\n\uBE14\uB9AC\uC790\uD3EC\uC2A4\uAC00 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C8\uC73C\uB098\\n\uD504\uB9AC\uC988\uB9C8\uC744\uB85C \uB2EC\uB824\uAC00 \uBC84\uB838\uB2E4"
  },
  {
    "index": 100,
    "flags": 0,
    "text": "\uBB18\uC9C0 \uADFC\uCC98\uC758 \uBC2D\uC5D0 \uC528\uB97C \uBFCC\uB838\uB354\uB2C8\\n\uBC84\uB4DC\uB809\uC2A4\uC758 \uD798\uC73C\uB85C\\n\uAC80\uC740\uB2F9\uADFC\uC774 \uC790\uB790\uB2E4!\\n\uB2F9\uADFC \uB0C4\uC0C8\uB97C \uB9E1\uACE0\\n\uB808\uC774\uC2A4\uD3EC\uC2A4\uAC00 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C8\uC73C\uB098\\n\uD504\uB9AC\uC988\uB9C8\uC744\uB85C \uB2EC\uB824\uAC00 \uBC84\uB838\uB2E4"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "\uC655\uC758 \uC560\uB9C8\uC600\uB358 \uD3EC\uCF13\uBAAC\uC744 \uBB3C\uB9AC\uCE58\uACE0\\n\uC190\uC5D0 \uB123\uC740 \uAC08\uAE30\uC640\\n\uBC84\uB4DC\uB809\uC2A4\uC758 \uBE5B\uB098\uB294\uAF43\uC78E\uC744 \uC5EE\uC5B4\uC11C\\n\uB2E4\uC2DC \uC720\uB300\uC758\uACE0\uC090\uB97C \uB9CC\uB4E4\uC5B4\uB0C8\uB2E4!\\n\uC560\uB9C8\uC758 \uADFC\uAC70\uC9C0\uC778 \uC655\uAD00\uC2E0\uC804\uC73C\uB85C \uAC00\uC11C\\n\uBC84\uB4DC\uB809\uC2A4\uC640 \uD569\uB958\uD558\uC790!"
  },
  {
    "index": 102,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655 \uBC84\uB4DC\uB809\uC2A4\uB294\\n\uC0C8\uB85C\uC6B4 \uC720\uB300\uC758\uACE0\uC090\uB97C \uC0AC\uC6A9\uD574\uC11C\\n\uC560\uB9C8\uC640 \uB2E4\uC2DC \uC774\uC5B4\uC9C0\uAC8C \uB418\uC5C8\uB2E4\\n\uC778\uAC04\uC5D0 \uB300\uD55C \uC624\uD574\uB3C4 \uD480\uB9B0 \uBAA8\uC591\uC774\uB2E4\\n\uD798\uC744 \uB418\uCC3E\uC544\uC900 \uBCF4\uB2F5\uC73C\uB85C\\n\uD568\uAED8 \uBAA8\uD5D8\uD558\uAC8C \uB418\uC5C8\uB2E4!"
