    "text": "\uC804\uD658"
  },
  {
    "index": 167,
    "flags": 0,
    "text": "\uD3C9\uAC00"
  },
  {
    "index": 168,
    "flags": 0,
    "text": "\uB9CE\uC740 \uD2B8\uB808\uC774\uB108\uC640\\n\uC2B9\uBD80\uB97C \uD558\uB2E4 \uBCF4\uBA74\\r\\n\uB9CE\uC740 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB0A0 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\c"
  },
  {
    "index": 169,
    "flags": 0,
    "text": "\uB3C4\uB9DD\uCE58\uB294 \uD3EC\uCF13\uBAAC\uC740 \uBAB8\uC744 \uC219\uC774\uACE0\\n\uC811\uADFC\uD558\uB294 \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4\\c\\n\uC790\uC804\uAC70\uC758 \uBCA8\uC744 \uC6B8\uB9AC\uAC70\uB098 \uD718\uD30C\uB78C\uC744 \uBD88\uBA74\\n\uACBD\uACC4\uD558\uB294 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB3C4 \uBAB8\uC744 \uC219\uC774\uACE0\\r\\n\uBAB0\uB798 \uC811\uADFC\uD558\uB294 \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4\\c"
  },
  {
    "index": 170,
    "flags": 0,
    "text": "\uB204\uAD70\uAC00\uC640 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD574\uC11C\\n\uB3C4\uAC10\uC744 \uCC44\uC6B0\uB294 \uAC83\uB3C4 \uCD94\uCC9C\uD569\uB2C8\uB2E4!\\r\\n\uB9E4\uC9C0\uCEEC \uAD50\uD658\uB3C4 \uC88B\uACA0\uB124\uC694\\c"
  },
  {
    "index": 171,
    "flags": 0,
    "text": "\uC54C\uC744 \uBD80\uD654\uC2DC\uCF1C\uC57C\\n\uBC1C\uACAC\uD560 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uC2B5\uB2C8\uB2E4\\c"
  },
  {
    "index": 172,
    "flags": 0,
    "text": "\uB09A\uC2DC\uB294 \uD558\uACE0 \uC788\uB098\uC694?\\c\\n\uB09A\uC2DC\uB85C\uB9CC \uB9CC\uB0A0 \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uB3C4 \uAF64 \uB9CE\uC2B5\uB2C8\uB2E4\\c"
  },
  {
    "index": 173,
    "flags": 0,
    "text": "\uC9C4\uD654\uB97C \uC2DC\uCF1C\uC57C\uB9CC\\n\uBC1C\uACAC\uD560 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uB610, \uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD574\uC57C\uB9CC\\n\uC9C4\uD654\uD558\uB294 \uD3EC\uCF13\uBAAC \uB4F1\\r\\n\uB2E4\uC591\uD55C \uC9C4\uD654 \uBC29\uBC95\uC774 \uC788\uC2B5\uB2C8\uB2E4\\c"
  },
  {
    "index": 174,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB3C4\uAC10 \uC644\uC131\uAE4C\uC9C0\\n\uC5BC\uB9C8 \uB0A8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4! \uD30C\uC774\uD305!\\c"
  },
  {
    "index": 175,
    "flags": 0,
    "text": "\uC774\uB7F4 \uC218\uAC00!\\n\uAC00\uB77C\uB974\uB3C4\uAC10 \uC644\uC131!!\\c\\n\uBAA8\uB4E0 \uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB09C\\n[VAR 0100(0000)]\uB2D8\uC758 \uB178\uACE0\uC5D0\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uBC15\uC218\uB97C \uBCF4\uB0C5\uB2C8\uB2E4!\\c"
