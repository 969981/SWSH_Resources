    "text": "\uC790\uC138\uD788 \uBCF8\uB2E4"
  },
  {
    "index": 165,
    "flags": 0,
    "text": "\uC21C\uC11C\uBC14\uAFB8\uAE30"
  },
  {
    "index": 166,
