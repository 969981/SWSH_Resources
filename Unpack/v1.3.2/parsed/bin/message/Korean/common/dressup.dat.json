  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4!\\c\\n\uAC08\uC544\uC785\uC73C\uC2DC\uACA0\uB2E4\uBA74 \uAC00\uAE4C\uC6B4\\n\uD53C\uD305\uB8F8\uC744 \uC774\uC6A9\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4! \uAD6C\uC785\uD55C \uC544\uC774\uD15C\uC73C\uB85C\\n\uAC08\uC544\uC785\uACA0\uC2B5\uB2C8\uAE4C?"
