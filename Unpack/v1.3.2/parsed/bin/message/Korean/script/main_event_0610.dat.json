[
  {
    "index": 0,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC\\n\uBA4D\uD30C\uCE58![VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC648\uC648\uC648\uC648\uC648\uC648!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB124 \uC0DD\uAC01\uC774 \uB4E3\uACE0 \uC2F6\uC5B4\uC11C\\n\uC77C\uBD80\uB7EC \uC5EC\uAE30\uAE4C\uC9C0 \uBD88\uB800\uC5B4[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC800\uAE30 \uC788\uB294 \uCEE4\uB2E4\uB780 \uC9C0\uC0C1\uD654...\\n\uBB34\uC5C7\uC744 \uB098\uD0C0\uB0B8 \uAC83\uC73C\uB85C \uBCF4\uC774\uB2C8?[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBE14\uB799 \uB098\uC774\uD2B8?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD574!\\n\uC6A9\uCF00 \uC54C\uC544\uBD24\uAD6C\uB098!\\c\\n\uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uAC00 \uADF8\uB824\uC9C4 \uBD80\uBD84\uC740\\n\uAC70\uC758 \uB0A8\uC544 \uC788\uC9C0 \uC54A\uC740\uB370[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB807\uAC8C \uBCF4\uC77C \uC218\uB3C4 \uC788\uACA0\uB124\\n\uAC70\uB300\uD574\uC9C4 \uD3EC\uCF13\uBAAC\uCC98\uB7FC \uBCF4\uC774\uB2C8\uAE4C\\c\\n\uADF8\uB807\uC9C0\uB9CC 3000\uB144 \uC804\uC758 \uC0AC\uB78C\uB4E4\uC774\\n\uC0C1\uC0C1\uB825\uC774 \uD48D\uBD80\uD588\uB354\uB77C\uB3C4\\r\\n\uBCF8 \uC801\uB3C4 \uC5C6\uB294 \uB2E4\uC774\uB9E5\uC2A4\uB97C \uADF8\uB9B4 \uC218 \uC788\uC5C8\uC744\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC61B\uB0A0 \uC61B\uC801\uC5D0... \uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uAC00\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC744 \uB4A4\uB36E\uACE0\\r\\n\uAC70\uB300\uD55C \uD3EC\uCF13\uBAAC\uB4E4\uC774 \uB098\uD0C0\uB098 \uB0A0\uB6F0\uC5C8\uB2E4...\\c\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB77C\uACE0 \uBD88\uB838\uB358\\n\uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uB294 \uB300\uCCB4 \uBB50\uC600\uC744\uAE4C?\\r\\n\uB2E4\uC774\uB9E5\uC2A4\uC640\uB294 \uC5B4\uB5A4 \uAD00\uACC4\uC778 \uAC78\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uAC78 \uC54C\uC544\uB0B4\uC57C \uD558\uB294 \uAC8C \uB098\uB77C\uB2C8...\\n\uD560\uBA38\uB2C8\uC758 \uC219\uC81C\uAC00 \uB108\uBB34 \uC5B4\uB835\uB124[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC18C\uC911\uD55C \uC758\uACAC \uACE0\uB9C8\uC6CC!\\n\uBCF4\uB2F5\uC73C\uB85C \uB9AC\uADF8 \uCE74\uB4DC\uB97C \uC904\uAC8C[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC544\uD0AC\uB2D8\uC740 \uD480\uD0C0\uC785\uC758\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uB2C8\uAE4C\\c\\n\uBD88\uAF43\uC73C\uB85C \uD0DC\uC6B0\uAC70\uB098 \uBC8C\uB808\uB098 \uBE44\uD589\uD0C0\uC785\\n\uAE30\uC220\uB85C \uACF5\uACA9\uD558\uBA74 \uD6A8\uACFC\uC801\uC77C \uAC70\uC57C!\\c\\n\uADF8\uB9AC\uACE0 \uC774\uAC83\uB3C4 \uBC1B\uC544!\\n\uC5ED\uC2DC \uD3EC\uCF13\uBAAC\uC740 \uAC74\uAC15\uD55C \uAC8C \uC81C\uC77C\uC774\uB2C8\uAE4C![VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC790! \uC774\uC81C \uD130\uD504\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\\n\uC788\uB294 \uD798\uAECF \uC2F8\uC6CC \uBD10![VAR 0114(000B)]"
  }
]
