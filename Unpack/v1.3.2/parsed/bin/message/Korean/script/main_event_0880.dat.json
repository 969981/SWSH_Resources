  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uADF8\uB7F0\uB370 \uB124 \uB77C\uC774\uBC8C\uC778\\n\uD638\uBE0C\uD55C\uD14C \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uACBC\uB2C8?\\c\\n\uB0B4 \uC5BC\uAD74\uC744 \uBCF4\uC790\uB9C8\uC790\\n\u201C\uBBF8\uC548\uD574 \uD615!\u201D \uD558\uACE0\\r\\n\uC0AC\uACFC\uB97C \uD574\uC11C \uAE5C\uC9DD \uB180\uB790\uC9C0 \uBB50\uC57C...[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD639\uC2DC... \uADF8 \uB140\uC11D\\n\uB204\uAD70\uAC00\uD55C\uD14C \uC838\uC11C \uD480\uC774 \uC8FD\uC5B4 \uC788\uB294 \uAC70\uC57C?[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBE44\uD2B8 \uC120\uC218\uD55C\uD14C \uC84C\uC5B4\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB7F0\uAC00 \uBD10\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC9C0\uBA74 \uD480\uC774 \uC8FD\uC744 \uC218\uB3C4 \uC788\uC9C0!\\c\\n\uD558\uC9C0\uB9CC \uB2E4\uC2DC \uC77C\uC5B4\uC11C\uC57C \uD574!\\n\uADF8\uB9AC\uACE0 \uC5B4\uC9F8\uC11C \uC84C\uB294\uC9C0 \uC0DD\uAC01\uD574 \uBCF4\uB294 \uAC70\uC57C!\\c\\n\uADF8\uB7F4 \uC218 \uC788\uB2E4\uBA74... \uB140\uC11D\uC740\\n\uC88B\uC740 \uD2B8\uB808\uC774\uB108\uAC00 \uB420 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC544\uBB34\uD2BC \uB10C \uB140\uC11D\uC758 \uB77C\uC774\uBC8C\uC774\uB2C8\uAE4C\\n\uC55E\uC73C\uB85C\uB3C4 \uC798 \uBD80\uD0C1\uD55C\uB2E4![VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC774\uB7F0 \uBC8C\uC368 \uAC00\uC57C \uD560 \uC2DC\uAC04\uC774\uB124!\\c\\n\uC704\uC6D0\uC7A5\uB2D8\uACFC\uC758 \uC57D\uC18D\uC5D0\\n\uB2A6\uC73C\uBA74 \uBE44\uC11C\uD55C\uD14C \uD63C\uB098\uAC70\uB4E0\\c\\n...\uC7A5\uC18C\uAC00 \uC5B4\uB518\uC9C0\uB3C4 \uBAA8\uB974\uB294\uB370[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0! [VAR 0100(0000)]\\n\uB108\uB294 \uAE08\uB791\uC744 \uB9CC\uB098\uBCF4\uB294 \uAC8C \uC88B\uC744 \uAC70\uC57C\\c\\n\uB0B4 \uCD5C\uACE0\uC758 \uB77C\uC774\uBC8C\uC774\uC790\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uCD5C\uD6C4\uC758 \uC218\uBB38\uC7A5\uC774\uB2C8\uAE4C\\c\\n\uC9C0\uAE08\uC740 6\uBC88\uB3C4\uB85C \uC55E\uC5D0 \uC788\uB294\\n\uBCF4\uBB3C\uACE0\uC5D0 \uC788\uC744 \uAC70\uC57C![VAR 0114(0004)]"
  }
