  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uACFC\uC5F0 \uB098\uC058\uC9C4 \uC54A\uAD70\\c\\n\uADF8\uB807\uC9C0\uB9CC \uC624\uB514\uC158\uC740 \uBD88\uD569\uACA9\uC774\uB2E4\\n\uBB54\uAC00 \uB0B4 \uB9C8\uC74C\uC5D0\uB294 \uCC28\uC9C0 \uC54A\uB294\uAD6C\uB098\\c\\n\uADF8\uB807\uB2E4\uACE0 \uB108\uBB34 \uC2E0\uACBD \uC4F0\uC9C0\uB294 \uB9D0\uB824\uBB34\uB098\\n\uC5B4\uB514\uAE4C\uC9C0\uB098 \uB0B4 \uCDE8\uD5A5 \uB54C\uBB38\uC774\uB2C8\uAE4C[VAR 0114(0013)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC740 \uB2E4\uC74C\uC5D0 \uCC3E\uC73C\uBA74 \uB41C\uB2E8\uB2E4\\n\uC0AC\uC2E4 \uC0DD\uAC01\uD574 \uB454 \uC0AC\uB78C\uB3C4 \uC788\uC73C\uB2C8 \uB9D0\uC774\uB2E4[VAR 0114(0013)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uACB0\uACFC\uB294 \uC544\uC27D\uAC8C \uB410\uB2E4\uB9CC\\n\uAE30\uB150\uC73C\uB85C \uD398\uC5B4\uB9AC\uBC30\uC9C0\uB97C \uC8FC\uB9C8[VAR 0114(0013)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB808\uBCA8 45\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
