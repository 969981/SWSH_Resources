[
  {
    "index": 0,
    "flags": 0,
    "text": "...\uC5B4\uB77C?\\n\uBB38\uC5D0 \uBB38\uC790\uAC00 \uC801\uD600 \uC788\uB2E4!\\c\\n\u201C\uCCAB \uBC88\uC9F8 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n \uBCC0\uCE58 \uC54A\uB294 \uB3CC\uC744 \uC950\uAC8C \uD558\uB77C\u201D"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC660\uC9C0 \uBAA8\uB974\uAC8C \uACF5\uAE30\uAC00 \uBC14\uB010 \uB4EF\uD558\uB2E4..."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC11D\uC0C1\uC73C\uB85C\uBD80\uD130\\n\uBC14\uC704\uC758 \uD798\uC774 \uB290\uAEF4\uC9C4\uB2E4...\\r\\n\uC870\uC0AC\uD574\uBCF4\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC790\uC790 \uC790\uB9AC \uC790..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB808\uC9C0\uB77D\uC740 \uB3C4\uB85C\\n\uC6C0\uC9C1\uC774\uC9C0 \uC54A\uAC8C \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB38\uC774 \uAD73\uAC8C \uB2EB\uD600 \uC788\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCEE4\uB2E4\uB780 \uD3EC\uCF13\uBAAC \uC11D\uC0C1\uC774\\n[VAR 0100(0000)][VAR 1900(0002)] \uB0B4\uB824\uB2E4\uBCF4\uACE0 \uC788\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD53C\uC624\uB2C8 \uB300\uC7A5\uC5D0\uAC8C\\n\uBCF4\uACE0\uD558\uB7EC \uAC00\uC790!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC090\uC090\uC090\uC090..."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC544! \uC5EC\uBCF4\uC1FC!\\n\uB098\uC57C \uB098! \uD53C\uC624\uB2C8!\\r\\n\uB300\uC7A5, \uBB34\uB9AC\uD558\uACE0 \uC788\uB294 \uAC70 \uC544\uB2C8\uC9C0!?[VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBB50\uC57C? \uBC14\uC704\uC758 \uAC70\uC778\\n\uB808\uC9C0\uB77D\uC744 \uB9CC\uB0AC\uB2E4\uACE0!?[VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uC544\uD558\uD558! \uADF8\uAC70 \uB300\uB2E8\uD55C\uB370, \uB300\uC7A5!\\c\\n\uC774\uAC70, \uB2E4\uB978 \uAC70\uC778\uB3C4 \uACC4\uC18D\uD574\uC11C\\n\uC870\uC0AC\uD574\uBD10\uC57C\uACA0\uB294\uAC78!\\r\\n...\uADF8\uB7FC \uC5F4\uC2EC\uD788 \uD558\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC544! \uC5EC\uBCF4\uC1FC!\\n\uB098\uC57C \uB098! \uD53C\uC624\uB2C8!\\r\\n\uCEE8\uB514\uC158\uC740 \uC880 \uC5B4\uB54C!?[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC73C\uC74C!? \uC720\uC801\uCC98\uB7FC \uBCF4\uC774\uB294 \uC7A5\uC18C\uB97C\\n\uBC1C\uACAC\uD588\uB2E4\uACE0!?[VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uAC70\uAE30\uAC00 \uAC70\uAE34\uAC00 \uBCF4\uAD70!\\n\uC804\uC124\uC758 \uAC70\uC778\uC774 \uB098\uC628\uB2E4\uACE0\\r\\n\uC18C\uBB38\uC774 \uB3CC\uACE0 \uC788\uB294 \uC7A5\uC18C \uB9D0\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC, \uC218\uC218\uAED8\uB07C\uC758 \uAE00\uC774 \uC801\uD78C \uBB38\uC774\\n\uC5F4\uB9AC\uC9C8 \uC54A\uB294\uB2E4\uACE0 \uD558\uB354\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C...\\n\uC774 \uD0D0\uD5D8\uC5D0 \uC774\uB984\uC744 \uBD99\uC774\uC790\uBA74...[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5B4\uB54C! \uC751? \uADF8\uB7F4\uC2F8\uD558\uC9C0 \uC54A\uC544!?[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC88B\uC544, \uB300\uC7A5!\\n\uC774\uB807\uAC8C \uB41C \uAC70 \uC5F4\uC2EC\uD788 \uC870\uC0AC\uD574\uBCF4\uB77C\uACE0!\\r\\n...\uADF8\uB7FC, \uC774\uB9CC![VAR 0114(0076)]"
  }
]
