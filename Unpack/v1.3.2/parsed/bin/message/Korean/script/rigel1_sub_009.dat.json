[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624\uC624!? \uC774\uB7F0 \uACF3\uC5D0\uC11C \uD2B8\uB808\uC774\uB108\uB97C\\n\uB9CC\uB098\uB2E4\uB2C8 \uBCC4\uC77C\uC774\uB85C\uAD70"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB098\uB294\uC57C \uB4DD\uD15C\uC544\uC800\uC528\\c\\n\uAD6C\uBA4D\uD30C\uAE30\uD615\uC81C\uB77C\uACE0 \uC544\uB2C8?\\n\uB0B4\uAC00 \uB140\uC11D\uB4E4\uC758 \uC544\uBE60\uB780\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB098\uB294\uC57C \uB4DD\uD15C\uC544\uC800\uC528\\c\\n\uAD6C\uBA4D \uD30C\uB294 \uC77C\uC744\\n\uC5C5\uC73C\uB85C \uC0BC\uACE0 \uC788\uC9C0"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD639\uC2DC \uB108 \uAC11\uC637\uAD11\uC11D\uC774\uB77C\uB294 \uAC78 \uAC00\uC9C0\uACE0 \uC788\uB2C8?\\c\\n\uAC11\uC637\uAD11\uC11D\uC740 \uAC11\uC637\uC12C\uC758 \uBA85\uBB3C\uC778\\n\uD76C\uADC0\uD55C \uB3CC\uC774\uB780\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAC11\uC637\uAD11\uC11D\uC744 \uAC00\uC838\uC624\uBA74\\n\uB0B4 \uB6F0\uC5B4\uB09C \uD314\uC2EC\uC73C\uB85C\\r\\nW\uB97C \uB9C8\uAD6C\uB9C8\uAD6C \uD30C\uB0B4\uC8FC\uB9C8"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[~ 5]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB9AC\uD3EC\uD2B8\uB97C \uC791\uC131\uD574\uC57C \uD558\uB294\uB370\\n\uAC11\uC637\uAD11\uC11D [VAR 0201(0003)]\uAC1C\uB97C \uBC1B\uACE0 W\uB97C \uD30C\uC904\uAE4C?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "W\uAC00 \uD544\uC694\uD558\uBA74\\n\uB610 \uC624\uAC70\uB77C"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB098\uB294\uC57C \uB4DD\uD15C\uC544\uC800\uC528\\n\uBB34\uC2A8 \uC77C\uB85C \uC654\uB2C8?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "W\uB97C \uCC44\uAD74\uD55C\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAE30\uB85D\uC744 \uBCF8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC2DC\uC791\uD558\uB9C8"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[VAR 0207(0000,0000)]W\uB97C \uD30C\uB0C8\uC5B4\\n\uC880 \uB354 \uD30C\uBCFC\uAE4C?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD06C\uC73D... \uC774\uAC8C \uCD5C\uC120\uC774\uC57C...!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC74C? \uC790, \uC7A0\uAE50 \uC788\uC5B4\uBD10!\\n\uC544\uC9C1... \uC544\uC9C1 \uB354 \uD30C\uB0BC \uC218 \uC788\uACA0\uC5B4!!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC6B0, \uC6B0\uC624\uC624\uC624\uC624!!!!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD5E4\uD5E4, \uC774\uAC70 \uC624\uB79C\uB9CC\uC5D0\\nW\uB97C \uC794\uB729 \uD30C\uB0BC \uC218 \uC788\uC744 \uAC83 \uAC19\uAD6C\uB098"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uAC04\uB2E4!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "[VAR 0207(0000,0000)]\uC640~\uD2B8~!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC774\uBC88\uC774 \uB9C8\uC9C0\uB9C9\uC774\uB2E4!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAD6C\uBA4D\uD30C\uAE30~ [VAR 0107(0001)]!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uD6C4\uC6B0... \uC774\uC81C \uC880 \uC9C4\uC815\uB418\uB294\uAD70"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D4 \uB2E4 \uD569\uCCD0\uC11C\\n[VAR 0208(0001,0000)]W\uB97C \uD30C\uB0C8\uB2E8\uB2E4"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB108\uC758 \uCD5C\uACE0 \uCC44\uAD74 \uAE30\uB85D\uC740\\n[VAR 0208(0001,0000)]W\uB780\uB2E4"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC624! \uAC11\uC637\uAD11\uC11D\uC744 \uAC00\uC9C0\uACE0 \uC788\uAD6C\uB098\\n\uB0B4\uAC8C [VAR 0201(0003)]\uAC1C\uB9CC \uC8FC\uC9C0 \uC54A\uACA0\uB2C8?"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uAC11\uC637\uAD11\uC11D\uC744 \uC190\uC5D0 \uB123\uC73C\uBA74\\n\uBD80\uB514 \uB0B4\uAC8C \uC0AC\uC6A9\uD574\uC8FC\uB834"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "[VAR 0208(0001,0000)]W\uB97C \uD30C\uB0C8\uC5B4"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774\uB7F0\\n\uAC11\uC637\uAD11\uC11D\uC774 \uBD80\uC871\uD558\uAD6C\uB098\\c\\n\uAC11\uC637\uAD11\uC11D\uC744 [VAR 0201(0003)]\uAC1C \uBAA8\uC740 \uB2E4\uC74C\uC5D0\\n\uB0B4\uAC8C \uB2E4\uC2DC \uC624\uB834"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uB9CC\uB09C \uAC83\uB3C4 \uC778\uC5F0\uC774\uB2C8\uAE4C!\\n\uCCAB \uB9CC\uB0A8\uC744 \uAE30\uB150\uD574\uC11C \uC11C\uBE44\uC2A4\uB97C \uD574\uC8FC\uB9C8!\\c\\n\uB9AC\uD3EC\uD2B8\uB97C \uC791\uC131\uD574\uC57C \uD558\uB294\uB370\\n\uBB34\uB8CC\uB85C W\uB97C \uD30C\uC904\uAE4C?"
  }
