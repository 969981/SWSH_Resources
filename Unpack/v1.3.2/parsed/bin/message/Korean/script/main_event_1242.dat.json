    "text": "\uB9C8\uCFE0\uC640\uB77C\uACE0 \uD569\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAD6C\uBA4D\uC5D0 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uACE0\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uC168\uAD70\uC694...\\c\\n\uBB50 \uADF8 \uC815\uB3C4\uB294 \uB3FC\uC57C\\n\uC800\uB97C \uC0C1\uB300\uD560 \uC218 \uC788\uACA0\uC9C0\uC694[VAR 0114(0014)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC778\\n\uB2F9\uC2E0\uC5D0\uAC8C\uB294 \uBBF8\uC548\uD55C \uC77C\uC774\uC9C0\uB9CC\\c\\n\uC800\uB294 \uC81C \uD3EC\uCF13\uBAAC\uB4E4\uC758 \uAC15\uD568\uC744\\n\uC5B4\uD544\uD558\uB294 \uC2F8\uC6C0\uC744 \uCD94\uAD6C\uD569\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBE68\uB9AC \uB05D\uB0B4\uB3C4\uB85D \uD558\uC8E0[VAR 0114(0014)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD6CC\uB96D...\uD569\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB7FC \uADDC\uCE59\uB300\uB85C\\n\uBC14\uC704\uBC30\uC9C0\uB97C \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0014)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB808\uBCA8 50\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC800\uB294 \uAC71\uC815\uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4\\n\uD2B8\uB808\uC774\uB2DD\uC5D0 \uB354 \uD798\uC4F0\uBA74 \uB418\uB2C8\uAE4C\uC694[VAR 0114(0014)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB9C8\uCFE0\uC640\uB2D8\uC5D0\uAC8C \uC2B9\uB9AC\uD55C \uAC83\uC744\\n\uAE30\uB150\uD558\uB294 \uC758\uBBF8\uB85C \uC774 \uAE30\uC220\uBA38\uC2E0\uC744 \uC904\uAC8C!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB9C8\uCFE0\uC640\uB2D8\uC774 \uC785\uC73C\uBA74\\n\uD6E8\uC52C \uB354 \uBA4B\uC788\uC5B4\uC9C0\uB294 \uB514\uC790\uC778\uC758\\r\\n\uC774 \uC720\uB2C8\uD3FC\uB3C4 \uBC1B\uC544\uC918!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBC14\uC704\uBC30\uC9C0\uAC00 \uC798 \uC5B4\uC6B8\uB824!\\n[VAR 0100(0000)]! \uC55E\uC73C\uB85C\uB3C4 \uD798\uB0B4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  }
