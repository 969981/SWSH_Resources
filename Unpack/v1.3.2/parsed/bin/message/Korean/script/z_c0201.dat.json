[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0\uC758 \uC2A4\uD0C0\uB514\uC6C0 \uBD24\uC5B4?\\n\uBB54\uAC00 \uC5C4\uCCAD\uB098\uAC8C \uAC70\uCE5C \uB290\uB08C\uC774\uC5C8\uC5B4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0\uC758 \uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC740\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uD55C\uAC00\uC6B4\uB370\uC5D0\\r\\n\uC788\uB2E4\uACE0 \uC804\uD574\uC9C0\uACE0 \uC788\uC5B4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC74C\uBC43\uC740 \uACFC\uC77C\uC744 \uC544\uC8FC \uC88B\uC544\uD574!\\n\uADF8\uB798\uC11C \uC5B8\uC81C\uB098 \uCD08\uC74C\uD30C\uB85C \uCC3E\uC544\uB2E4\uB2C8\uACE0 \uC788\uC5B4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD30C\uB77C\uB77C \uD30C\uB77C\uB77C\uB77C"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD2B8\uB808\uC774\uB108\uB2D8\uC740 \uB9AC\uADF8 \uCE74\uB4DC\uB97C\\n\uD3B8\uC9D1\uD558\uACE0 \uC788\uC5B4?\\c\\n\uC18C\uC7AC\uAC00 \uB298\uC5B4\uC11C \uC5B4\uB5A4 \uAC78 \uB123\uC744\uC9C0\\n\uACE0\uBBFC\uD558\uB294 \uAC83\uB3C4 \uC88B\uC740 \uC77C\uC778 \uAC83 \uAC19\uC544!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC544\uB294 \uC0AC\uB78C \uC911\uC5D0 \uB204\uAD70\uAC00\uAC00\\c\\n\uD3EC\uCF13\uBAAC\uC758 \uCF54\uC2A4\uD504\uB808\uB97C \uD558\uACE0\\n\uD3EC\uCF13\uBAAC\uC7A1 \uC77C\uC744 \uD558\uACE0 \uC788\uB2E4\uB294 \uBAA8\uC591\uC774\uC57C\\c\\n...\uC544\uB294 \uC0AC\uB78C\uC774 \uB9D0\uC774\uC57C"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uB9C8\uC744\uC758 \uC720\uC801\uC744 \uBD24\uB294\uB370\\n\uC608\uC220\uC740 \uC5ED\uC2DC \uC5B4\uB824\uC6B4 \uAC83 \uAC19\uC544..."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC608\uC220\uC774\uB2C8 \uBB50\uB2C8 \uD574\uB3C4...\\n\uC790\uC2E0\uC774 \uC88B\uC544\uD558\uB294\uC9C0\uAC00 \uC911\uC694\uD55C \uAC83 \uC544\uB2D0\uAE4C"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC785\uACE0 \uC788\uB294 \uC637\uC740\\n\uB0B4\uAC00 \uD559\uC0DD\uC77C \uB54C \uBC1B\uC740 \uAC70\uB780\uB2E4...\\c\\n\uD3EC\uCF13\uBAAC\uC758 \uC2E4\uC744 \uC0AC\uC6A9\uD55C \uB355\uBD84\uC5D0\\n\uD2BC\uD2BC\uD574\uC11C \uC544\uC9C1\uB3C4 \uC785\uC744 \uC218 \uC788\uB2E8\uB2E4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC5D0\uAC8C\uAE4C\uC9C0 \uB3C4\uB2EC\uD55C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB294 \uC5BC\uB9C8 \uC5C6\uC5B4...\\c\\n\uAE08\uB791\uB2D8\uACFC \uD3EC\uCF13\uBAAC\uC758 \uC2DC\uD569\uC744\\n\uB354 \uB9CE\uC774 \uBCF4\uACE0 \uC2F6\uC740\uB370"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD3EC\uD50C\uB7EC\uB2D8\uB3C4 \uC218\uC2ED \uB144 \uB3D9\uC548\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744 \uB9E1\uC544\uC628\\r\\n\uBCA0\uD14C\uB791 \uC911\uC758 \uBCA0\uD14C\uB791\uC774\uB77C... \uC774\uAE30\uAE30 \uD798\uB4E4 \uAC70\uC57C"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB85C\uC988\uB3C4 \uC61B\uB0A0\uC5D0 \uCC54\uD53C\uC5B8\uCEF5\uC5D0\uC11C\\n\uC900\uC6B0\uC2B9\uD55C \uAC83\uC744 \uBC1C\uD310\uC73C\uB85C\\r\\n\uD06C\uAC8C \uB3C4\uC57D\uC5D0 \uC131\uACF5\uD588\uB2E8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uB098\uC639\uC740\\n\uAD00\uB3D9\uC9C0\uBC29\uC774\uB098 \uC54C\uB85C\uB77C\uC9C0\uBC29\uACFC\uB294\\r\\n\uBAA8\uC2B5\uC774 \uB2E4\uB974\uB300!\\r\\n\uADF8\uB7F0 \uAC78 \uB9AC\uC804\uD3FC\uC774\uB77C\uACE0 \uD574"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB2EC\uCF64\uD55C \uCE74\uB808\uB97C \uC88B\uC544\uD558\uB294\uB370\\n\uC544\uBE60\uB294 \uB9E8\uB0A0 \uC501\uC4F8\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uBC84\uB824!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\uC758 \uB808\uD50C\uB9AC\uCE74 \uC720\uB2C8\uD3FC\uC744\\n\uC0B0 \uC0AC\uB78C\uC740 \uB9CE\uC9C0\uB9CC\\r\\n\uB9DD\uD1A0\uAC00 \uB108\uBB34 \uBB34\uAC70\uC6CC\uC11C \uC785\uC744 \uC218\uAC00 \uC5C6\uC5B4..."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0\uC11C \uB9CC\uB098\uAE30\uB85C \uD588\uB294\uB370\\n\uC880\uCCB4 \uC624\uC9C0\uB97C \uC54A\uC544...\\r\\n\uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0 \uC788\uB294 \uAC74\uAC00?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uAC00\uB77C! \uD2B8\uB9AC\uD1A0\uB3C8!\\n\uD3EC\uC640~\uAD6C\uCD78\uAD6C\uCD78!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCF54\uBFCC\uB9AC\uC640 \uD2B8\uB9AC\uD1A0\uB3C8\\c\\n\uD0C0\uC785\uC758 \uC0C1\uC131\uC740 \uB098\uC058\uC9C0\uB9CC\\n\uACBD\uD5D8\uC758 \uCC28\uC774\uAC00 \uC788\uC9C0!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uD1A0\uB3C8..."
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB3C4\uB3C4\uC628!!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 \uB530\uB77C \uD558\uB824\uACE0\\n\uAF43\uC758 \uAFC0\uC744 \uBE68\uC544\uBD24\uC5B4"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC5F4\uCC28 \uC548\uC5D0\uC11C \uBA39\uB294\\n\uB3C4\uC2DC\uB77D\uC774 \uC788\uB2E4\uBA74 \uC778\uAE30 \uC788\uC744 \uD150\uB370!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC544\uC774\uB4E4\uC740 \uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uB97C\\n\uC9C0\uB098\uAC08 \uC218 \uC5C6\uC5B4\uC11C \uC5F4\uCC28\uB97C \uD0C8 \uAC70\uC608\uC694\\c\\n\uAD1C\uCC2E\uC544\uC694\\n\uC544\uC774\uB4E4\uB07C\uB9AC\uB3C4 \uD0C8 \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC800 \uAC00\uAC8C\uB294 \uD3EC\uCF13\uBAAC\uC774\\n\uC801\uB2F9\uD55C \uD654\uB825\uC73C\uB85C \uAD6C\uC6CC\uC900\uB2E8\uB2E4"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB4DC\uB798\uACE4\uC740 \uBCF4\uBB3C\uC744 \uC9C0\uD0A4\uB294 \uC790\\c\\n\uADF8\uB7F0 \uC758\uBBF8\uB85C \uBCF4\uC790\uBA74 \uAE08\uB791\uB2D8\uC774\\n\uBCF4\uBB3C\uACE0\uB97C \uC9C0\uD0A4\uB294 \uAC83\uC774 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uAC83 \uAC19\uC544!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC5D0\uB294 \uC624\uB798\uB41C \uAC74\uBB3C\uB3C4\\n\uC794\uB729 \uB0A8\uC544 \uC788\uB300!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC758 \uD3EC\uCF13\uBAAC\uC740\\n\uBCF4\uAE08\uC790\uB9AC\uC5D0 \uC774\uAC83\uC800\uAC83\uC744 \uC228\uACA8 \uB193\uB294\uB300\\c\\n\uAE30\uC220\uB808\uCF54\uB4DC\uB97C \uBAA8\uC73C\uB294\\n\uD2B9\uC774\uD55C \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uB2E4\uB098 \uBD10"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC29B\uC2DC\uD2F0\uC5D0 \uAC00\uBCF4\uB294 \uAC8C \uC88B\uC744 \uAC70\uC57C\\c\\n\uC138\uACC4 \uAC01\uC9C0\uC5D0\uC11C\\n\uB2E4\uC591\uD55C \uC0AC\uB78C\uB4E4\uC774 \uB180\uB7EC \uC624\uB2C8\uAE4C"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uAE4C\uC544\uC545!!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC18C\uC6D0\uC758\uBCC4\uC774 \uB5A8\uC5B4\uC9C0\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB294\\n\uD2B9\uBCC4\uD55C \uBB34\uC5B8\uAC00\uAC00 \uC788\uB294 \uAC8C \uC544\uB2D0\uAE4C?"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uCC54\uD53C\uC5B8\uC774 \uB418\uBA74\\n\uC628 \uC138\uC0C1\uC5D0 \uC788\uB294 \uC18C\uC6D0\uC758\uBCC4\uC744\\r\\n\uB108\uC5D0\uAC8C \uC120\uBB3C\uD574\uC904\uAC8C!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uCEA0\uD504\uC5D0\uC11C \uBA39\uB294 \uCE74\uB808\uB294 \uB9DB\uC788\uC5B4! \uADF8\uB807\uC9C0\uB9CC\\n\uC9D1\uC5D0\uC11C \uB9CC\uB4E0 \uCE74\uB808\uB294 \uADF8\uC800 \uADF8\uB807\uB2E8 \uB9D0\uC774\uC9C0\\r\\n\uB300\uCCB4 \uBB50\uAC00 \uB2E4\uB978 \uAC78\uAE4C?"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC624! \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2D8!\\n\uB798\uD130\uB7F4\uB9C8\uC744\uC5D0 \uAC00\uC2DC\uB098\uC694?\\c\\n6\uBC88\uB3C4\uB85C\uB97C \uC9C0\uB098\uBA74\\n\uB798\uD130\uB7F4\uB9C8\uC744\uC774\uAC70\uB4E0\uC694!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC5B4~\uC774\\n\uC5EC\uAE30\uAC00 \uB9C8\uC9C0\uB9C9 \uCCB4\uC721\uAD00\uC774\uC57C!"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uD574\uB0C8\uAD6C\uB098!\\n\uB4DC\uB798\uACE4\uBC30\uC9C0\uB97C \uD68D\uB4DD\uD588\uAD70!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC2A4\uD0C0\uB514\uC6C0\uC774...\\n\uC704\uD5D8\uD558\uB2E4 \uC704\uD5D8\uD574!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC740 \uC29B\uC2DC\uD2F0!\\n\uD1A0\uB108\uBA3C\uD2B8\uC57C!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C \uBCF8\\n\uC2DC\uD569 \uAD49\uC7A5\uD588\uC5B4!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uBA4B\uC9C4 \uC2DC\uD569\uC774\uC5C8\uC5B4!\\n\uC62C\uD574 \uCD5C\uACE0\uC758 \uC2DC\uD569\uC774\uC5C8\uC5B4!"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uACE0 \uACE0!\\n[VAR 0100(0000)]!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC138\uBBF8\uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C\\n\uB108\uB97C \uC751\uC6D0\uD560\uAC8C!"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC654\uB2E4 \uC654\uC5B4!\\n\uADF8 \uD2B8\uB808\uC774\uB108\uC57C!"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC544! \uC800 \uC0AC\uB78C\uC740\\n\uC5C4\uCCAD \uAC15\uD574!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uD5EC\uB85C!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uC774\uAE30\uB294 \uAC83\uB9CC\uC744\\n\uC0DD\uAC01\uD558\uC790!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uB108\uC758 \uC2DC\uD569\uC744 \uBCF4\uACE0\\n\uC6A9\uAE30\uB97C \uC5BB\uC5C8\uC5B4"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uCEE8\uB514\uC158\uC740 \uC5B4\uB54C?"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uBCF4\uB2E4\\n\uAC15\uD558\uB2E4\uB2C8 \uAD49\uC7A5\uD574!"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC758 \uD3EC\uCF13\uBAAC\\n\uBA4B\uC9C4 \uD45C\uC815\uC744 \uD558\uACE0 \uC788\uB124!"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uB0B4 \uD3EC\uCF13\uBAAC\uC774\\n\uC5B4\uB514\uC5D0 \uAC14\uC9C0...?"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uB0A0 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC744\\n\uCC3E\uB294 \uC77C\uC740 \uC27D\uC9C0 \uC54A\uB2E8\uB2E4"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uB0B4 \uD3EC\uCF13\uBAAC\uC740\\n\uCB49 \uC9D1\uC5D0 \uC788\uC5C8\uB354\uAD6C\uB098"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD574!"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uBAA9\uC774 \uB9C8\uB974\uB2E4...\\n\uCC28\uB97C \uB9C8\uC2DC\uACE0 \uC2F6\uC5B4..."
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uACFC \uC5EC\uD589\uC744\\n\uC5B4\uB514\uB85C \uAC00\uBA74 \uC88B\uC744\uAE4C?"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uC2B9\uBD80\uC5D0\uC11C \uC9C0\uBA74\\n\uC815\uB9D0 \uBD84\uD574"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4\\n\uD1A0\uB108\uBA3C\uD2B8\uC57C!"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uBD89\uC740 \uBE5B...\\n\uBB34\uC11C\uC6E0\uC5B4..."
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uBCF4\uBB3C\uACE0\uB294\\n\uC2A4\uD0C0\uB514\uC6C0 \uBC16\uC5D0 \uC788\uC5B4"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uC2A4\uD0C0\uB514\uC6C0 \uC9C0\uD558\uC5D0\uB294\\n\uD50C\uB79C\uD2B8\uAC00 \uC788\uB2E4\uB098 \uBD10"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0...\\n\uC2E0\uAE30\uD55C \uAC74\uBB3C\uC774\uC57C"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uD30C\uD2B8\uB108\uB85C \uC0BC\uB294\uB2E4\uBA74\\n\uBA4B\uC9C4 \uD3EC\uCF13\uBAAC\uC774 \uC88B\uC544"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uC88B\uC544\uD558\uB294 \uAE30\uC220\uC740\\n\uB2E4\uACFC\uD68C!"
  },
  {
