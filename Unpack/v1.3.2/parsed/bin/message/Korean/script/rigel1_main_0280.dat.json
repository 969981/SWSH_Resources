    "index": 18,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uC778 \uCC44\uB85C \uC9C0\uB0BC\uB798\uC694!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uC0DD\uAC01\uD574 \uBCFC\uAC8C\uC694"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB108\uD76C\uC5D0\uAC8C\uB294 \uADF8\uAC8C\\n\uCD5C\uC120\uC758 \uC120\uD0DD\uC778 \uAC8C\uB85C\uAD6C\uB098![VAR 0114(0073)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB098\uC911\uC5D0 \uC9C4\uD654\uC2DC\uD0A4\uACE0 \uC2F6\uC5B4\uC9C0\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uD0D1\uC5D0 \uC62C\uB77C\uC640\uC11C\\r\\n\uC871\uC790\uB97C \uBCF4\uC5EC\uC8FC\uB3C4\uB85D \uD558\uB824\uBB34\uB098![VAR 0114(0073)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uACE0\uBBFC\uD558\uACE0 \uB610 \uC120\uD0DD\uD558\uB294 \uAC83\\n...\uADF8\uAC83\uB3C4 \uD558\uB098\uC758 \uC218\uD589\uC774\uC9C0!\\r\\n\uCDA9\uBD84\uD788 \uACE0\uBBFC\uD574\uBCF4\uB3C4\uB85D \uD574\uB77C![VAR 0114(0073)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "...\uC5B4\uC774\uCFE0\\n\uC774\uAC70 \uD558\uB9C8\uD130\uBA74 \uC78A\uC744 \uBED4\uD588\uAD6C\uB098[VAR 0114(0073)]"
  },
