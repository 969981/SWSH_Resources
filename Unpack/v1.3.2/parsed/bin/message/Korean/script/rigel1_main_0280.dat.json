[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uC5D0\uAC8C \uBB3C\uC758 \uC871\uC790\uB97C \uBCF4\uC5EC\uC8FC\uACE0\\n\uC9C4\uD654\uC2DC\uD0A4\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uC5D0\uAC8C \uC545\uC758 \uC871\uC790\uB97C \uBCF4\uC5EC\uC8FC\uACE0\\n\uC9C4\uD654\uC2DC\uD0A4\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC608"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBCA0\uC544?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBCA0\uC544 \uC544~\uB9C8..."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBCA0\uBCA0\uC544~!!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBCF4\uC544\uB77C!\\n\uC774\uAC83\uC774 \uBC14\uB85C \uC6B0\uB77C\uC624\uC2A4![VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uBB34\uAE30\uB3C4 \uB9C9\uC544\uB0B4\uB294\\n\uD2BC\uD2BC\uD55C \uAC11\uC637\uC5D0...[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBB3C\uC758 \uD0DC\uC138\uAC00 \uADF9\uC5D0 \uB2EC\uD55C \uBAA8\uC2B5\uC774\uC9C0![VAR 0114(0073)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC545\uC758 \uD0DC\uC138\uAC00 \uADF9\uC5D0 \uB2EC\uD55C \uBAA8\uC2B5\uC774\uC9C0![VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBCA0\uC544\uCFE0\uC544!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBCA0\uC544~\uD06C!!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB0B4 \uB4A4\uC5D0 \uC228\uAE30\uB098 \uD558\uB358\\n\uAF2C\uB9F9\uC774\uAC00\\r\\n\uC774\uB807\uAC8C \uB2A0\uB984\uD574\uC9C0\uB2E4\uB2C8...[VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB204\uAD70\uAC00\uAC00 \uC131\uC7A5\uD558\uB294 \uBAA8\uC2B5\uC744\\n\uC9C1\uC811 \uC9C0\uCF1C\uBCF4\uB294 \uAC74\\c\\n\uC544\uBB34\uB9AC \uB098\uC774\uB97C \uBA39\uC5B4\uB3C4\\n\uAE30\uC05C \uC77C\uC774\uB85C\uAD6C\uB098[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[~ 15]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[VAR 0100(0000)]! \uC6B0\uB77C\uC624\uC2A4!\\n\uC815\uB9D0 \uACE0\uB9D9\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB2F9\uBD84\uAC04\uC740 \uCE58\uACE0\uB9C8\uC778 \uCC44\uB85C\\n\uD568\uAED8 \uC9C0\uB0B4\uACE0 \uC2F6\uC740 \uAC8C\uB0D0?[VAR 0114(0073)]"
  },
