[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB458 \uB2E4 \uC5B4\uC11C \uC624\uAC70\uB77C~[VAR 0114(0073)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC624\uC624? \uD081\uD081...\\n\uC5B4\uB514\uC11C \uB2EC\uCF64~\uD55C \uB0C4\uC0C8\uAC00 \uB098\uB294\uB370?[VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD5E4\uD5E4~![VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC6B0\uB77C\uC624\uC2A4\uAC00 \uC88B\uC544\uD558\uB294 \uB2E4\uC774\uAFC0!\\n\uC81C\uB300\uB85C \uAC00\uC838\uC654\uB2E4\uAD6C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uC57C~!\\n\uC774\uB807\uAC8C \uC21C\uC2DD\uAC04\uC5D0 \uAC00\uC838\uC654\uB2E4\uACE0!?[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC800\uC640 [VAR 0100(0000)][VAR 1900(0003)]\\n\uD798\uC744 \uD569\uCE58\uBA74 \uC774 \uC815\uB3C4\uB77C\uAD6C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uD78C\uD2B8 \uC5C6\uC774 \uC798\uB3C4\\n\uB2E4\uC774\uAFC0\uC744 \uCC3E\uC544\uB0C8\uAD6C\uB098![VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC218\uACE0\uD588\uB2E4! [VAR 0100(0000)]!\\n\uADF8\uB9AC\uACE0 \uD638\uBE0C![VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uC5B4\uB5A4 \uC7AC\uB8CC\uAC00 \uBB54\uC9C0\\n\uAE4C\uBA39\uC740 \uAC8C \uC544\uB2C8\uC5C8\uB124\uC694![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB2E4\uC774\uAFC0\uC744 \uB123\uC73C\uBA74\\n\uBD84\uBA85\uD788 \uC6B0\uB77C\uC624\uC2A4\uB3C4\\r\\n\uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC5B4\uC904 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBCA0\uC544\uB9C8!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBCA0\uC544\uC624\uC2A4!!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774\uC81C [VAR 0100(0000)]\uC5D0\uAC8C\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC5D0\uC11C \uAC00\uB974\uCCD0 \uC904 \uAC74\\r\\n\uAC70\uC758 \uB2E4 \uAC00\uB974\uCCD0\uC92C\uB2E4[VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC9C0\uAE08\uC758 \uB108\uB77C\uBA74\\n\uC804\uB825\uC744 \uB2E4\uD574 \uC2B9\uBD80\uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uAD6C\uB098![VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB9C8\uCE68 \uB098\uB3C4 \uD2B8\uB808\uC774\uB2DD\uC774 \uC870\uAE08\\n\uD544\uC694\uD558\uB358 \uCC38\uC774\uB2C8...[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC9C4\uC2EC\uC73C\uB85C \uC804\uB825\uC744 \uB2E4\uD55C \uB098\uC640\\n\uC2B9\uBD80\uD560 \uAC01\uC624\uAC00 \uB418\uC5C8\uB2E4\uBA74\\c\\n\uB3C4\uC7A5 \uB4A4\uD3B8\uC5D0 \uC788\uB294\\n\uBC30\uD2C0\uCF54\uD2B8\uB85C \uC624\uB824\uBB34\uB098![VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC9C4\uC2EC\uC73C\uB85C \uC804\uB825\uC744 \uB2E4\uD55C \uC2A4\uC2B9\uB2D8?\\n\uB300\uCCB4 \uC5BC\uB9C8\uB098 \uAC15\uD55C \uAC81\uB2C8\uAE4C?"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD615\uC758 \uC2A4\uC2B9\uB2D8\uC774\uB2C8\uAE4C...\\n\uBD84\uBA85\uD788 \uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uAC15\uD558\uACA0\uC9C0![VAR 0114(0005)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8!\\n\uB2E8\uB2E8\uD788 \uAC01\uC624\uD558\uACE0 \uB3C4\uC804\uD558\uC138\uC694!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB098\uB294 \uC774\uC81C \uAC11\uC637\uC12C\uC744 \uC870\uC0AC\uD558\uB7EC \uAC00\uC57C \uD574[VAR 0114(0005)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uB108\uB3C4 \uD798\uB0B4!\\n\uD3C9\uC18C \uD558\uB358 \uB300\uB85C \uBA4B\uC9C0\uAC8C \uC2F8\uC6CC\uBD10![VAR 0114(0005)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130\uB4DC \uD560\uC544\uBC84\uC9C0\uC640 \uC2B9\uBD80\uD560 \uB54C\uB294\\n\uB098\uB3C4 \uC751\uC6D0\uD558\uB7EC \uAC08\uAC8C![VAR 0114(0005)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB2E4\uC774\uAFC0\uACFC \uB2E4\uC774\uBC84\uC12F\uC774 \uC788\uC73C\uBA74\\n\uCE58\uACE0\uB9C8\uAC00 \uC9C4\uD654\uD55C \uD3EC\uCF13\uBAAC...\\c\\n\uC6B0\uB77C\uC624\uC2A4\uAC00 \uBA39\uC744 \uC218 \uC788\uB294\\n\uB2E4\uC774\uC218\uD504\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
