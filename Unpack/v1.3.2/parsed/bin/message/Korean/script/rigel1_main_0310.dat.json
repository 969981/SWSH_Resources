  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uD638\uBE0C\uB2D8\uC774\uB77C\uB294 \uBD84,\\n\uADF8 \uC720\uBA85\uD55C \uB2E8\uB378\uB2D8\uC758 \uB3D9\uC0DD\uC778 \uAC81\uB2C8\uAE4C!?\\c\\n\uADF8\uB7F0 \uD638\uBE0C\uB2D8\uACFC \uCE5C\uD55C \uC0AC\uC774\uC778\\n[VAR 0100(0000)]\uB2D8\uC740 \uB300\uCCB4...?"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC2DC\uC6D0\uC2A4\uB7EC\uC6B4 \uBBF8\uC18C\uC5D0\\n\uC21C\uC218\uD558\uACE0 \uC0C1\uB0E5\uD55C \uD638\uBE0C\uB2D8...\\c\\n\uC544\uC544 \uC774\uB7EC\uBA74 \uC548 \uB418\uB294\uB370!\\n\uC81C\uAC8C\uB294 \uC774\uBBF8 \uBC30\uBC30 \uAF2C\uC778 \uB3C4\uC815\uC774\uAC00 \uC788\uB2E4\uAD6C\uC694!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC2DC\uC6D0\uC2A4\uB7EC\uC6B4 \uBBF8\uC18C\uC5D0\\n\uC21C\uC218\uD558\uACE0 \uC0C1\uB0E5\uD55C \uD638\uBE0C\uB2D8...\\c\\n\uC544\uC544 \uC774\uB7EC\uBA74 \uC548 \uB418\uB294\uB370!\\n\uC81C\uAC8C\uB294 \uC774\uBBF8 \uC5C9\uB6B1\uD55C \uC138\uC774\uBC84\uB9AC\uAC00 \uC788\uB2E4\uAD6C\uC694!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC5D0\uB294\\n\uB108\uBB34\uB098\uB3C4 \uC5B4\uB824\uC6B4 \uB098\uBA38\uC9C0\\r\\n\uBD09\uC778\uB41C \uD2B8\uB808\uC774\uB2DD\uC774 \uC788\uB2E4\uB294 \uC18C\uBB38\uC774 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uB97C \uC5B4\uB5A4 \uD0C0\uC785\uC73C\uB85C\\n\uC9C4\uD654\uC2DC\uD0AC\uC9C0 \uC0DD\uAC01\uD558\uB290\uB77C\\r\\n\uD558\uB8E8\uAC00 \uB2E4 \uC9C0\uB098\uAC00 \uBC84\uB838\uC2B5\uB2C8\uB2E4..."
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uBB34\uC11C\uC6B4 \uC774\uC57C\uAE30 \uD558\uB098 \uD574\uC904\uAE4C?\\c\\n\uAC11\uC637\uC12C \uC5B4\uB518\uAC00\uC5D0\\n\uD3EC\uCF13\uBAAC\uC758 \uB178\uB825\uC744\\r\\n\uC0C8\uD558\uC597\uAC8C \uB9CC\uB4E4\uC5B4\uBC84\uB9AC\uB294 \uC544\uAC00\uC528\uAC00 \uC788\uB300..."
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC2AC\uC2AC\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uC2DC\uC98C \uC544\uB2CC\uAC00?\\c\\n\uC2A4\uC2B9\uB2D8\uC774 TV\uB97C \uCC28\uC9C0\uD558\uACE0 \uACC4\uC154\uC11C\\n\uC815\uBCF4\uB97C \uC5BB\uC744 \uC218\uAC00 \uC5C6\uB2E8 \uB9D0\uC774\uC9C0"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uD638\uBE0C\uB2D8\uC740 \uBA4B\uC9C4 \uBD84\uC774\uC57C!\\n\uB0B4 \uD3EC\uCF13\uBAAC\uC774 \uB2E4\uCCE4\uB294\uB370\\r\\n\uCE58\uB8CC\uD574\uC8FC\uC168\uC5B4!"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC5C4\uB9C8\uD55C\uD14C \uD3B8\uC9C0\uB97C \uBC1B\uC558\uB294\uB370\\n\uB2E8\uB378\uC774 \uC740\uD1F4\uD588\uB2E4\uB294 \uAC70 \uC788\uC9C0!\\r\\n\uB18D\uB2F4\uB3C4 \uC815\uB3C4\uAECF \uD558\uC154\uC57C\uC9C0"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC74C! \uC5C4\uCCAD\uB09C \uC2F8\uC6C0\uC774\\n\uC2DC\uC791\uB420 \uAC83 \uAC19\uC740 \uC608\uAC10\uC774 \uB4DC\uB294\uAD70...!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC2A4\uC2B9\uB2D8\uC740 \uB4E4\uB72C \uD45C\uC815\uC73C\uB85C\\n\uBC30\uD2C0\uCF54\uD2B8 \uCABD\uC73C\uB85C \uAC00\uC168\uC5B4"
  }
]
