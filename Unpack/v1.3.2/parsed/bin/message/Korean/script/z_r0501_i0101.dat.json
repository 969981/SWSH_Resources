[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD638\uC624 \uC5B4\uC11C \uC624\uB834\\n\uB0B4\uAC8C \uBB3C\uC5B4\uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uC788\uB2C8?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uADF8 \uBC16\uC5D0 \uBB3C\uC5B4\uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uC788\uB2C8?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uB9E1\uAE30\uBBF8\uC9D1\uC740\\n\uBAA8\uB450\uC758 \uD3EC\uCF13\uBAAC\uC744 \uB9E1\uC544\uC11C\\r\\n\uB3CC\uBCF4\uACE0 \uC788\uB2E8\uB2E4\\c\\n\uB9E1\uAE34 \uD3EC\uCF13\uBAAC\uC774\\n\uAC15\uD574\uC9C0\uAC70\uB098 \uD558\uC9C4 \uC54A\uC9C0\uB9CC\\c\\n2\uB9C8\uB9AC\uB97C \uD568\uAED8 \uB9E1\uAE30\uBA74\\n\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC774\\r\\n\uBC1C\uACAC\uB420 \uB54C\uAC00 \uC788\uC9C0\\c\\n\uD3EC\uCF13\uBAAC\uC744 \uB9E1\uAE30\uACE0 \uC2F6\uB2E4\uBA74\\n\uBC16\uC5D0 \uC788\uB294 \uC190\uB140\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uB824\uBB34\uB098"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC744\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC5D0 \uB123\uACE0 \uAC78\uC5B4 \uB2E4\uB2C8\uBA74\\r\\n\uC548\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC774 \uD0DC\uC5B4\uB09C\uB2E8\uB2E4\\c\\n\uC5B4\uB514\uC11C \uB098\uD0C0\uB0AC\uB294\uC9C0 \uBAA8\uB974\uB294\\n\uC2E0\uBE44\uD55C \uD3EC\uCF13\uBAAC\uC758 \uC54C...\\r\\n\uADF8\uC57C\uB9D0\uB85C \uC0DD\uBA85\uC758 \uC2E0\uBE44\uB85C\uAD6C\uB098"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC774 \uAC16\uACE0 \uC2F6\uB2E4\uBA74\\n\uB9E1\uAE30\uB294 \uD3EC\uCF13\uBAAC\uC758 \uC870\uD569\uC744\\r\\n\uC798 \uC0DD\uAC01\uD574\uC57C \uD55C\uB2E8\uB2E4\\c\\n\uAC19\uC740 \uC885\uB958\uC758 \uD3EC\uCF13\uBAAC\uC758\\n\uC218\uCEF7\uACFC \uC554\uCEF7\uC744 \uB9E1\uAE30\uB294 \uAC78 \uCD94\uCC9C\uD558\uB9C8\\c\\n\uC11C\uB85C \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB3C4\\n\uC885\uB958\uAC00 \uAC00\uAE4C\uC6B4 \uD3EC\uCF13\uBAAC\uC774\uB77C\uBA74\\r\\n\uC54C\uC774 \uBC1C\uACAC\uB420 \uB54C\uAC00 \uC788\uB2E8\uB2E4\\c\\n\uB2E4\uB9CC \uD3EC\uCF13\uBAAC \uC911\uC5D0\uB294 \uC54C\uC774 \uBC1C\uACAC\uB418\uC9C0 \uC54A\uB294\\n\uD3EC\uCF13\uBAAC\uB3C4 \uC788\uB2E4\uB354\uAD6C\uB098..."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uC624\uB824\uBB34\uB098"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB9E1\uAE30\uBBF8\uC9D1\uC774 \uBB50\uC608\uC694?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC5D0 \uB300\uD574\uC11C"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB9E1\uAE38 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  }
]
