[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uC138\uC694\\n\uBC30\uD2C0\uCE74\uD398\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC74C? \uC190\uB2D8\\n\uC624\uB298\uC740 \uC774\uBBF8 \uBC30\uD2C0\uD558\uC168\uC9C0\uC694?\\r\\n\uB0B4\uC77C \uB2E4\uC2DC \uBC29\uBB38\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD558\uB8E8\uC5D0 \uD55C \uBC88!\\n\uC774\uAE30\uC2DC\uBA74 \uB514\uC800\uD2B8\uB97C \uC120\uBB3C\uD569\uB2C8\uB2E4!\\r\\n...\uC2B9\uBD80\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC2DC\uC791\uD574\uBD05\uC2DC\uB2E4!\\n...\uB808\uCE20 \uBE0C\uB808\uC774\uD06C \uD0C0\uC784!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD2BC\uD2BC\uBC00\uD06C\uCC98\uB7FC\\n\uC18D \uC2DC\uC6D0\uD55C \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD6C4\uB974\uCE20\uBC00\uD06C\uCC98\uB7FC\\n\uC12C\uC138\uD55C \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC5D0\uB098\uCF54\uCF54\uC544\uCC98\uB7FC\\n\uC21C\uD55C \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD30C\uC778\uC96C\uC2A4\uCC98\uB7FC\\n\uC790\uADF9\uC801\uC778 \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB85C\uC988\uB808\uC774\uD2F0\uCC98\uB7FC\\n\uC6B0\uC544\uD55C \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB791\uBE14\uB8E8\uB9C8\uC6B4\uD2F4\uCC98\uB7FC\\n\uAE4A\uC740 \uB9DB\uC774 \uC788\uB294 \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC774\uAC74 \uC57D\uC18D\uB4DC\uB9B0\\n\uB514\uC800\uD2B8\uC785\uB2C8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC190\uB2D8... \uBCF8 \uB9E4\uC7A5\uC758 \uB8F0\uC740\\n\uB354\uBE14\uBC30\uD2C0\uC785\uB2C8\uB2E4\\c\\n\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC744 2\uB9C8\uB9AC \uC774\uC0C1\\n\uB370\uB9AC\uACE0 \uB2E4\uC2DC \uBC29\uBB38\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uBC29\uBB38\uD574\uC8FC\uC2DC\uAE38\\n\uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4"
  }
]
