[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBCA0\uC544...?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC774 \uD3EC\uCF13\uBAAC\uC774\uC57C\uB9D0\uB85C\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5 \uBE44\uC804\uC758 \uAC11\uC637!\\r\\n\uC774\uB984\uD558\uC5EC... \uCE58\uACE0\uB9C8![VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBAB8\uC9D1\uC740 \uC791\uC9C0\uB9CC\\n\uB2A0\uB984\uD558\uAC8C \uD0A4\uC6B0\uBA74\\c\\n\uC5B4\uB5A4 \uC0C1\uB300\uB77C\uB3C4 \uB9C9\uC544\uB0BC \uC218 \uC788\uB294\\n\uD2BC\uD2BC\uD55C \uAC11\uC637\uC774 \uB418\uC9C0![VAR 0114(0073)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uC911\uC5D0\uC11C\uB3C4 \uC774 \uC544\uC774\uB294\\n\uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uC7AC\uB2A5\uC744 \uAC00\uC9C0\uACE0 \uC788\uC9C0\uB9CC\\r\\n\uC870\uAE08 \uC18C\uADF9\uC801\uC774\uB77C\uC11C \uB9D0\uC774\uB2E4...[VAR 0114(0073)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC790\uAE30 \uC790\uC2E0\uC5D0 \uB300\uD574\\n\uC790\uC2E0\uAC10\uC774 \uAC70\uC758 \uC5C6\uB294 \uBAA8\uC591\uC774\uB780\uB2E4[VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C [VAR 0100(0000)] \uB108\uC640\\n\uD568\uAED8 \uBAA8\uD5D8\uC744 \uD558\uB2E4 \uBCF4\uBA74\\c\\n\uC790\uC2E0\uC744 \uAC00\uB454 \uAECD\uC9C8\uC5D0\uC11C\\n\uB098\uC62C \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C \uD558\uB294 \uAC8C \uB0B4 \uC0DD\uAC01\uC774\uB780\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB7FC!\\n\uC55E\uC73C\uB85C \uCE58\uACE0\uB9C8\uB97C \uC798 \uBD80\uD0C1\uD55C\uB2E4~![VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBCA0, \uBCA0\uC544\uB9C8..."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uB294\\n[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC\uC774 \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC77C\uB2E8![VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uBA74\uC11C\\n\uC11C\uB85C\uC5D0 \uB300\uD55C \uC2E0\uB8B0\uB97C \uC313\uB3C4\uB85D \uD558\uAC70\uB77C![VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uADF8 \uC544\uC774\uB294 \uB3C4\uC7A5 \uBC16\uC5D0 \uB098\uAC04 \uC801\uC774\\n\uBCC4\uB85C \uC5C6\uC73C\uB2C8\uAE4C[VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC758 [VAR FF00(0006)]\uACBD\uCE58 \uC88B\uC740 \uACF3[VAR FF00(0000)]\uC744\\n\uD568\uAED8 \uB458\uB7EC\uBCF4\uB2E4 \uBCF4\uBA74\\r\\n\uAE08\uBC29 \uCE5C\uD574\uC9C8 \uC218 \uC788\uC744 \uAC8C\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uACF3\uC778\uC9C0 \uC54C\uC544\uBCFC \uC218 \uC788\uAC8C\\n\uBB38\uD558\uC0DD\uC744 \uBCF4\uB0B4\uB193\uB3C4\uB85D \uD558\uB9C8![VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBB3C\uB860 \uD568\uAED8 \uBC30\uD2C0\uD558\uAC70\uB098\\n\uCEA0\uD551\uC744 \uD1B5\uD574\uC11C\uB3C4 \uC720\uB300\uB97C \uC313\uC744 \uC218 \uC788\uC9C0![VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0006)]\uB77C\uBA74 \uAC11\uC637\uC12C\uC5D0\uC11C\\n\uC120\uB450 \uD3EC\uCF13\uBAAC\uC744 \uBCFC\uC5D0\uC11C \uAEBC\uB0B4\uC11C\\r\\n[VAR FF00(0006)]\uB370\uB9AC\uACE0 \uB2E4\uB2C8\uB294 \uAC83\uB3C4[VAR FF00(0000)] \uC88B\uC744 \uAC70\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD568\uAED8 \uAC78\uC73C\uBA74 \uAE08\uBC29 \uCE5C\uD574\uC9C8 \uD14C\uB2C8\\n\uCE58\uACE0\uB9C8\uC640 \uD568\uAED8 \uC5EC\uAE30\uC800\uAE30 \uB2E4\uB140\uBCF4\uB824\uBB34\uB098~![VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uC640 \uB9CE\uC774 \uCE5C\uD574\uC9C0\uBA74\\n\uC218\uD589\uC744 \uC2DC\uC791\uD560 \uD14C\uB2C8\uAE4C\\r\\n\uB0B4\uAC8C \uC54C\uB824 \uC8FC\uAC70\uB77C~![VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uBE44\uC804\uC758 \uAC11\uC637\uC774\\n\uD3EC\uCF13\uBAAC\uC774\uC5C8\uC744 \uC904\uC774\uC57C!\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0\\n\uAD49\uC7A5\uD55C \uBAB8\uB180\uB9BC\uC774\uC5C8\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB3C4\uC815\uC774\uB294\\n\uD480\uC774 \uC8FD\uC740 \uBAA8\uC591\uC774\uC5D0\uC694...\\c\\n\uBB58 \uD558\uBA74\\n\uC81C\uAC00 \uD798\uC774 \uB418\uC5B4\uC904 \uC218 \uC788\uC744\uAE4C\uC694?"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC138\uC774\uBC84\uB9AC\uB294\\n\uD480\uC774 \uC8FD\uC740 \uBAA8\uC591\uC774\uC5D0\uC694...\\c\\n\uBB58 \uD558\uBA74\\n\uC81C\uAC00 \uD798\uC774 \uB418\uC5B4\uC904 \uC218 \uC788\uC744\uAE4C\uC694?"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uAC11\uC790\uAE30 \uB610 \uC218\uD589\uC774 \uC2DC\uC791\uB418\uB354\uB77C\uB3C4\\n\uD6C4\uD68C\uD558\uC9C0 \uC54A\uC744 \uC218 \uC788\uAC8C\\c\\n\uC9C0\uAE08\uBD80\uD130 \uC5F4\uC2EC\uD788 \uC900\uBE44\uD560 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774\uB4E0 \uADF8 \uC758\uBBF8\uB97C\\n\uC0DD\uAC01\uD558\uBA74\uC11C \uD558\uB2E4 \uBCF4\uBA74\\r\\n\uB354 \uC9D1\uC911\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C \uC8FC\uBCC0\uC5D0\uB294\\n\uC791\uC740 \uC12C\uB4E4\uC774 \uC794\uB729 \uC788\uC5B4!\\c\\n\uBB3C \uC704\uB97C \uB2EC\uB9AC\uB294 \uC790\uC804\uAC70\uB85C\\n\uC12C\uC744 \uB3CC\uC544\uBCF4\uB294 \uAC83\uB3C4 \uC88B\uC744 \uAC70\uC57C!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC218\uD589\uB3C4 \uC77C\uB2E8\uB77D\uB410\uC73C\uB2C8\\n\uAC11\uC637\uAD11\uC11D\uC744 \uBAA8\uC544\uC11C\\r\\n\uD55C\uBAAB \uCC59\uACA8\uBCFC\uAE4C?"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC774\uC81C \uC2AC\uC2AC \uC791\uC740 \uC0AC\uC774\uC988\uC758 \uB3C4\uBCF5\uC138\uD2B8\uB97C\\n\uB9CC\uB4E4\uC5B4\uC904 \uB54C\uB3C4 \uB41C \uAC70 \uAC19\uC740\uB370..."
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uB294 \uB9C8\uC2A4\uD130\uB4DC \uC2A4\uC2B9\uB2D8\uC774\\n\uC138\uACC4\uB97C \uC5EC\uD589\uD558\uB358 \uC911\uC5D0\\c\\n\uD574\uC678\uC5D0\uC11C \uBC1C\uACAC\uD558\uC2DC\uACE0\uB294\\n\uB370\uB824\uC628 \uAC70\uB798"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uBE44\uC804\uC758 \uAC11\uC637... \uBAB8\uB180\uB9BC\uC774 \uB300\uB2E8\uD558\uB354\uAD70!\\n\uD06C\uD06D... \uC5B4\uB5BB\uAC8C \uC131\uC7A5\uD560\uC9C0 \uAE30\uB300\uB418\uB294\uAD70"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8 \uADC0\uC5FD\uB354\uB77C~!\\n\uB098\uB3C4 \uC880 \uB354 \uC5F4\uC2EC\uD788 \uD574\uBCFC \uAC78 \uADF8\uB7AC\uC5B4!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "[~ 30]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "[~ 31]"
  }
]
