[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD654\uD654\uD654\uBD10"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC608~! \uBC25\uC758 \uC2A4\uD14C\uC774\uD06C\uD558\uC6B0\uC2A4\uC785\uB2C8\uB2E4!\\n\uB9DB\uC788\uB294 \uC74C\uC2DD\uC744 \uC81C\uACF5\uD574\uB4DC\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC88B\uC544 \uBCF4\uC774\uB294 \uD0DC\uD53C\uC2A4\uD2B8\uB9AC\uC9C0?\\n\uC564\uD2F0\uD06C \uB9C8\uCF13\uC5D0\uC11C \uC0C0\uC5B4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB4E0\uB4E0\uD788 \uBA39\uC9C0 \uC54A\uC73C\uBA74\\n\uC2B9\uBD80\uB97C \uBABB\uD574!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAD81\uADF9\uC758 \uB9DB\uC73C\uB85C\\n\uC544\uBB34\uB9AC \uBA40\uC5B4\uB3C4 \uB2E4\uC2DC \uCC3E\uC544\uC62C\\r\\n\uAC00\uCE58\uAC00 \uC788\uB294 \uBA54\uB274\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC2DD\uC0AC\uD560 \uB54C \uC77C \uC598\uAE30?\\n\uC2A4\uC2A4\uB85C \uBC25\uB9DB\uC744 \uB5A8\uC5B4\uB728\uB9AC\uB294 \uAC70\uC57C?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC798 \uAD6C\uC6CC\uC84C\uB124!\\c\\n\uCD09\uCD09\uD558\uBA74\uC11C\\n\uC2DD\uAC10\uB3C4 \uC88B\uC544!\\r\\n\uCFE1 \uC544\uC800\uC528\uB97C \uCE6D\uCC2C\uD574\uC918\uC57C\uC9C0!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC544\uC774\uAC00 \uB9DB\uC788\uAC8C \uBA39\uB294 \uBAA8\uC2B5\\n\uD589\uBCF5\uD574 \uBCF4\uC5EC\uC11C \uC790\uAFB8 \uBCF4\uAC8C \uB418\uB294\uAD70\uC694!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC815\uB9D0 \uB9DB\uC788\uC5B4\uC694\\c\\n\uC5B4\uB5BB\uAC8C\uB4E0 \uB9DB\uC744 \uC7AC\uD604\uD574\uC11C\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB3C4 \uBA39\uC774\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD0DC\uD53C\uC2A4\uD2B8\uB9AC \uD55C \uC7A5\\n\uADF8\uB824\uC838 \uC788\uB294 \uAC74...\\c\\n\uAC80\uACFC \uBC29\uD328\uB97C \uC783\uC740\\n\uB450 \uBA85\uC758 \uC601\uC6C5..."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC5B4\uB514\uC120\uAC00 \uBCF8 \uB4EF\uD55C\\n\uD0DC\uD53C\uC2A4\uD2B8\uB9AC \uAC19\uC740 \uAC83\uC774 \uAC78\uB824\uC788\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC624\uB108 \uBC25\uC758 \uCD08\uC0C1\uD654\uB2E4!\\n\uC775\uD78C \uC815\uB3C4\uB97C \uC911\uC694\uC2DC\uD558\uB294 \uB0A8\uC790\uC758 \uC5BC\uAD74\uC774\uB2E4!"
  }
]
