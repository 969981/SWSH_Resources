  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5D0\uC5E5!? \uBA85\uC0C9\uC774 \uC218\uD589\uC778\uB370\\n3\uAC1C\uAC00 \uD55C\uAEBC\uBC88\uC5D0 \uC788\uB2E4\uB2C8 \uC774\uAC8C \uB9D0\uC774 \uB3FC!?[VAR 0114(0071)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD6D7! \uC5ED\uC2DC \uB2E4\uC774\uBC84\uC12F\uC740\\n\uD55C \uACF3\uC5D0 \uC5EC\uB7EC \uAC1C\uAC00 \uC790\uB77C\uB294\uAD70\uC694![VAR 0114(0072)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC57C! \uADF8 \uBC84\uC12F\uC740\\n\uB0B4\uAC00 \uBA3C\uC800 \uBC1C\uACAC\uD55C \uAC70\uAC70\uB4E0![VAR 0114(0071)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8 \uB2E4\uC774\uBC84\uC12F\uC758 \uC874\uC7AC\uB294\\n\uC800\uC758 \uC5D0\uC2A4\uD37C \uD30C\uC6CC\uAC00\\r\\n\uBA3C\uC800 \uC54C\uC544\uB0C8\uC2B5\uB2C8\uB2E4![VAR 0114(0072)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uC774 \uC120\uBC30\uD55C\uD14C\\n\uB2E4\uC774\uBC84\uC12F\uC744 \uC591\uBCF4\uD558\uB294 \uAC8C \uC5B4\uB54C?[VAR 0114(0071)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8 \uBA3C\uC800 \uBC1C\uACAC\uD55C \uC0AC\uB78C\uC774 \uC784\uC790\uB77C\uB294\\n\uB8F0\uC5D0 \uB530\uB77C \uC800\uC5D0\uAC8C \uC591\uBCF4\uD558\uB294 \uAC8C \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C![VAR 0114(0072)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC591\uBCF4 \uBABB \uD574\uC694!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC591\uBCF4\uD574\uC904\uAE4C\uC694?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uCCC7! \uB108\uB77C\uBA74\\n\uADF8\uB807\uAC8C \uB098\uC62C \uC904 \uC54C\uC558\uC5B4...[VAR 0114(0071)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD765! \uC5ED\uC2DC\\n\uAC70\uC808\uD558\uB294\uAD70\uC694...[VAR 0114(0072)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBB50\uC57C \uADF8 \uD0DC\uB3C4\uB294! \uC9C0\uAE08 \uC5EC\uC720 \uBD80\uB9AC\uB294 \uAC70\uC57C?\\n\uC9C0\uAE08 \uB098 \uAE54\uBCF4\uB294 \uAC70\uC9C0?[VAR 0114(0071)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC774\uAC74... \uAC15\uC790\uC758 \uC5EC\uC720\uC785\uB2C8\uAE4C?\\n\uC815\uB9D0 \uBD88\uCF8C\uD558\uAE30 \uC9DD\uC774 \uC5C6\uAD70\uC694![VAR 0114(0072)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB108 \uC815\uB9D0 \uAC70\uC2AC\uB824...\\n\uC5B4\uB514\uC11C \uAD74\uB7EC\uB4E4\uC5B4\uC628 \uC8FC\uC81C\uC5D0\\r\\n\uC5B4\uB9B0 \uB370\uB2E4\uAC00 \uC2E4\uB825\uAE4C\uC9C0 \uC88B\uACE0 \uB9D0\uC774\uC57C[VAR 0114(0071)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC804 \uC815\uB9D0 \uB2F9\uC2E0\uC774 \uAC70\uC2AC\uB9BD\uB2C8\uB2E4!\\n\uAC11\uC790\uAE30 \uB098\uD0C0\uB09C \uC8FC\uC81C\uC5D0\\r\\n\uC5B4\uB9AC\uACE0 \uC2E4\uB825\uAE4C\uC9C0 \uC88B\uB2E4\uB2C8[VAR 0114(0072)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uACC4\uC18D \uB098\uB97C \uBC29\uD574\uD560 \uC148\uC774\uB77C\uBA74\\n\uB054~\uCC0D\uD55C \uB3C5\uC73C\uB85C \uD574\uCE58\uC6CC\uC8FC\uACA0\uC5B4![VAR 0114(0071)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uACC4\uC18D \uC800\uC758 \uC55E\uAE38\uC744 \uAC00\uB85C\uB9C9\uC744 \uC148\uC774\uB77C\uBA74\\n\uC5D0\uC2A4\uD37C \uAE30\uC220\uB85C \uB0A0\uB824\uBC84\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0072)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC544\uC559! \uC5B4\uC9F8\uC11C \uBABB \uC774\uAE30\uB294 \uAC70\uC57C!?\\n\uCD5C\uC120\uC744 \uB2E4\uD588\uB294\uB370!\\r\\n\uB300\uCCB4 \uB0B4\uAC8C \uBB50\uAC00 \uBD80\uC871\uD55C \uAC74\uB370!?[VAR 0114(0071)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uD06C\uC73D... \uC5B4\uC9F8\uC11C \uC2B9\uB9AC\uD560 \uC218 \uC5C6\uB294 \uAC70\uC9C0?\\n\uB0B4\uAC8C \uB300\uCCB4 \uBB50\uAC00 \uBD80\uC871\uD55C \uAC70\uC9C0...?[VAR 0114(0072)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D4 \uB108\uC5D0\uAC8C \uC591\uBCF4\uD558\uACA0\uC5B4!\\n\uB09C \uB354 \uC88B\uC740 \uAC78 \uCC3E\uC744 \uD14C\uB2C8\uAE4C![VAR 0114(0071)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D4 \uB2F9\uC2E0\uC5D0\uAC8C \uC591\uBCF4\uD558\uACA0\uC2B5\uB2C8\uB2E4\\n\uC800\uB294 \uD6E8\uC52C \uC5D8\uB808\uAC15\uC2A4\uD55C\\r\\n\uB2E4\uC774\uBC84\uC12F\uC744 \uCC3E\uC744 \uD14C\uB2C8\uAE4C\uC694![VAR 0114(0072)]"
  },
