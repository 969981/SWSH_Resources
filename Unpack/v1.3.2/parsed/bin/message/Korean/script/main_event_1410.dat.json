[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uC774! \uC5EC\uAE30\uC57C \uC5EC\uAE30![VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC557 [VAR 0100(0000)][VAR 1900(0006)]\uB2E4[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB2E8\uB378\uACFC\\n\uD30C\uD2B8\uB108 \uB9AC\uC790\uBABD\uC774\uC57C\\c\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744\\n\uC21C\uC2DD\uAC04\uC5D0 \uC81C\uC555\uD588\uB2E4\uBA70![VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB098\uB294 \uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC774\uB2C8\uAE4C!\\n\uADF8\uAC74 \uB410\uACE0 \uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB358 \uAC70\uC57C?[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBD89\uC740 \uBE5B\uC774 \uB9C8\uAD6C \uD758\uB7EC\uB118\uCCD0\uC11C...\\n\uD30C\uC6CC\uC2A4\uD3FF\uC774 \uC544\uB2CC \uACF3\uC5D0\uC11C\uB3C4\\r\\n\uD3EC\uCF13\uBAAC\uC774 \uB2E4\uC774\uB9E5\uC2A4\uD574\uBC84\uB9B0 \uAC83 \uAC19\uC544...![VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B4\uC9F8\uC11C?[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC74\uC9C0\uB294\\n\uB098\uB3C4 \uC798 \uBAA8\uB974\uACA0\uC5B4...\\c\\n\uC5B4\uCA4C\uBA74 \uB2E4\uC74C\uC5D0\uB3C4 \uB610 \uBD89\uC740 \uBE5B\uC774\\n\uD758\uB7EC\uB118\uCE60\uC9C0\uB3C4 \uBAB0\uB77C[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uAC78 \uC608\uCE21\uD574\uB0B4\uB294 \uAC83\uB3C4\\n\uB6F0\uC5B4\uB09C \uC5F0\uAD6C\uAC00\uC758 \uC77C\uC774\uB780\uB2E4[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD560\uBA38\uB2C8!?[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uD55C\uD14C \uC5F0\uB77D\uC774 \uC654\uC9C0 \uBB50\uB0D0\\c\\n\uB2E4\uC774\uB9E5\uC2A4\uC640 \uAD00\uACC4\uAC00 \uC788\uB294\uC9C0\\n\uC774\uAC83\uC800\uAC83 \uBB3C\uC5B4\uBCF4\uB354\uAD6C\uB098[VAR 0114(000A)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBB54\uAC00 \uC54C\uC544\uB0B4\uC168\uB098\uC694?[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAE00\uC384\uB2E4... \uC704\uC6D0\uC7A5\uC740\\n\uC5D0\uB108\uC9C0\uAC00 \uC911\uC694\uD558\uB2E4\uACE0\\r\\n\uBE44\uC11C\uC5D0\uAC8C \uC804\uBD80 \uB9E1\uACA8\uB193\uC544\uC11C\\r\\n\uB370\uC774\uD130\uAC00 \uBD80\uC871\uD558\uB354\uAD6C\uB098[VAR 0114(000A)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uC18C\uB2C8\uC544\\n\uB108\uB3C4 \uC870\uC0AC\uD574 \uBCF4\uAC70\uB77C\\c\\n\uB108\uB294 \uBE14\uB799 \uB098\uC774\uD2B8\uC5D0 \uB300\uD574\\n\uB204\uAD6C\uBCF4\uB2E4\uB3C4 \uB9CE\uC774 \uC870\uC0AC\uD588\uC73C\uB2C8\uAE4C[VAR 0114(000A)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBD89\uC740 \uBE5B\uC774\\n\uC7AC\uC559\uC77C\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uB294 \uC18C\uB9AC\uC608\uC694!?[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD639\uC2DC \uC6B0\uB9AC\uB3C4\\n\uD560 \uC218 \uC788\uB294 \uC77C\uC774 \uC788\uC744\uAE4C?[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC788\uC5B4!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB3C4\uC640\uB4DC\uB9AC\uC790!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!\\n\uB108\uD76C\uC758 \uB9C8\uC74C\uC740 \uACE0\uB9D9\uAC8C \uBC1B\uC744\uAC8C\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB098\uC758 \uC18C\uC6D0\uC740\\n\uCD5C\uACE0\uC758 \uACB0\uC2B9\uC804\uC744 \uCE58\uB974\uB294 \uAC70\uC57C!\\c\\n\uB108\uD76C\uC758 \uBBF8\uB798\uB294 \uB0B4\uAC00 \uC9C0\uD0AC \uD14C\uB2C8\uAE4C\\n\uB108\uD76C\uB294 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uACC4\uC18D\uD558\uB3C4\uB85D \uD574![VAR 0114(0004)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC54C\uC558\uC5B4! \uB204\uAC00 \uBB50\uB77C \uD574\uB3C4 \uD615\uC740\\n\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC774\uB2C8\uAE4C![VAR 0114(0005)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD560\uBA38\uB2C8\\n\uC2E0\uACBD \uC4F0\uC774\uB294 \uC810\uC774 \uC788\uC5B4\uC694\\r\\n\uB3C4\uC640\uC8FC\uC2E4 \uAC70\uC8E0?[VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uB2E4\uB9C8\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC598\uB4E4\uC544\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD074\uB9AC\uC5B4\uD574\uC11C\\r\\n\uCC54\uD53C\uC5B8\uCEF5\uC5D0\uC11C \uB9CC\uB098\uC790![VAR 0114(0004)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB098\uB3C4 \uD560 \uC218 \uC788\uB294 \uAC78 \uD558\uACA0\uC5B4!\\n\uBA3C\uC800 \uB450\uC1A1\uB2D8\uC744 \uC774\uAE38 \uAC70\uC57C!\\c\\n[VAR 0100(0000)] \uB108\uB294\\n\uB108\uD074\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uAC08 \uAC70\uC9C0?\\r\\n\uAE08\uB791\uB2D8\uC740 \uC5C4\uCCAD\uB098\uAC8C \uAC15\uD558\uB2E4\uACE0![VAR 0114(0005)]"
  }
]
