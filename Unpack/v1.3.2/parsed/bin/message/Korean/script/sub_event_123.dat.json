[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC800\uB294 \uB514\uB809\uD130\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC640\uC6B0! \uD3EC\uCF13\uBAAC \uB3C4\uAC10 \uC644\uC131\uC5D0\\n\uB3C4\uC804\uD574\uC8FC\uACE0 \uACC4\uC2DC\uB294\uAD70\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4!\\n\uD3EC\uCF13\uBAAC\uC744 \uB9CE\uC774 \uB9CE\uC774 \uCC3E\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0! \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC744 \uB54C\\n\uC720\uC6A9\uD55C \uBD80\uC801\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744\\n\uC644\uC131\uD558\uAC8C \uB418\uBA74 \uC81C\uAC8C \uC54C\uB824\uC8FC\uC138\uC694!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uC644\uC131\uD558\uB294 \uAC74\\n\uB9E4\uC6B0 \uD798\uB4E0 \uC77C\uC774\uC9C0\uB9CC \uD798\uB0B4\uC138\uC694!\\c\\n\uB098\uC911\uC5D0 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uC644\uC131\uD558\uBA74\\n\uC81C\uAC8C \uBCF4\uC5EC\uC8FC\uC138\uC694!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "...\uC640\uC6B0! \uAD49\uC7A5\uD569\uB2C8\uB2E4!\\c\\n\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744\\n\uC644\uC131\uD558\uC168\uAD70\uC694!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uCD95\uD558\uD569\uB2C8\uB2E4!\\n\uC815\uB9D0 \uB300\uB2E8\uD55C \uC77C\uC744 \uD574\uB0B4\uC168\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD6CC\uB96D\uD55C \uACF5\uC801\uC744 \uAE30\uB9AC\uB294 \uB73B\uC5D0\uC11C\\r\\n\uB2F9\uC2E0\uC5D0\uAC8C\\r\\n\uC0C1\uC7A5\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0! \uB9AC\uADF8 \uCE74\uB4DC\uC5D0\\n\uD45C\uC2DD\uC744 \uB2EC\uC544\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC790 \uB410\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC774\uAC74 \uC800\uB97C \uAE30\uC058\uAC8C \uD574\uC8FC\uC2E0 \uBCF4\uB2F5\uC785\uB2C8\uB2E4!\\n\uC774 \uBD80\uC801\uC744 \uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC55E\uC73C\uB85C\uB3C4 \uCB49 \uD3EC\uCF13\uBAAC\uC744\\n\uC0AC\uB791\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC758\\n\uC644\uC131\uC744 \uCD95\uD558\uD569\uB2C8\uB2E4!\\c\\n\uD6C4\uD6C4\uD6C4 \uD45C\uCC3D\uC740\\n\uC5BC\uB9C8\uB4E0\uC9C0 \uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uC758 \uB9AC\uADF8 \uCE74\uB4DC\uC5D0\\n\uB3C4\uAC10 \uC644\uC131 \uD45C\uC2DD\uC774 \uCD94\uAC00\uB410\uB2E4!"
  }
]
