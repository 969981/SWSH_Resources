  {
    "index": 20,
    "flags": 0,
    "text": "\uB300\uC7A5?"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC81C\uAC00\uC694?"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uADF8\uB798, \uB108 \uB9D0\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uBD10\uBD10, \uC6B0\uB9AC \uB458\uC774\uC11C \uC990\uAC81\uAC8C\\n\uD0D0\uD5D8\uD558\uB7EC \uB3CC\uC544\uB2E4\uB2CC\uB2E4\uACE0 \uAC00\uC815\uD574\uBCF4\uC790[VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uADF8\uB7EC\uBA74 \uB2C8\uC544\uAC00 \uD569\uB958\uD558\uACE0 \uC2F6\uC5B4\uC11C \uCC3E\uC544\uC640\uB3C4\\n\uC5EC\uAE30\uC5D4 \uC544\uBB34\uB3C4 \uC5C6\uC744 \uAC70 \uC544\uB2C8\uC57C?[VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC544\uBE60\uB3C4 \uC5C6\uB294 \uBC29 \uC548\uC5D0\uC11C\\n\uD640\uB85C \uC678\uB86D\uAC8C \uC788\uB294 \uB538\uC744 \uC0C1\uC0C1\uD558\uBA74...[VAR 0114(0076)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB044\uC544~! \uADF8\uB7EC\uBA74 \uC548 \uB418\uC9C0!\\n\uC808\uB300\uB85C \uC788\uC5B4\uC120 \uC548 \uB418\uB294 \uC77C\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C\\n\uB098\uB294 \uC9C0\uD0A4\uBBF8 \uB300\uC7A5\uC744 \uD560 \uD14C\uB2C8\uAE4C![VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uD0D0\uD5D8 \uB300\uC7A5\uC740\\n\uB108\uC5D0\uAC8C \uC591\uBCF4\uD560\uAC8C! \uADF8\uC544\uD558\uD558![VAR 0114(0076)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uC758\uBBF8\uC5D0\uC11C\\n\uC790! \uC774\uAC78 \uC904\uAC8C[VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR FF00(0008)]\uC11C\uBC14\uC774\uBC8C\uC138\uD2B8[VAR FF00(0000)]\uB97C \uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uADF8\uC544\uD558\uD558!\\n\uC798 \uC5B4\uC6B8\uB9AC\uB294\uB370![VAR 0114(0076)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB2C8\uC544\uD55C\uD14C \uC8FC\uB824\uACE0\\n\uC5EC\uB7EC \uBC8C \uCC59\uACA8\uC628 \uB355\uBD84\uC5D0\\r\\n\uB108\uD55C\uD14C \uC904 \uAC83\uB3C4 \uC788\uC5C8\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC637\uC744 \uAC08\uC544\uC785\uAC70\uB098 \uC26C\uACE0 \uC2F6\uB2E4\uBA74...[VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC548\uCABD\uC5D0 \uC788\uB294 \uBC29\uC744 \uC4F0\uB3C4\uB85D \uD574![VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC7AC\uD0B7\uC758 \uBC34\uB4DC\uB294\\n\uB2E4\uB978 \uC0C9\uB3C4 \uC900\uBE44\uD574\uB480\uC73C\uB2C8\uAE4C\\r\\n\uAE30\uBD84\uC744 \uC804\uD658\uD558\uACE0 \uC2F6\uB2E4\uBA74 \uBC14\uAFD4\uBCF4\uB3C4\uB85D \uD574![VAR 0114(0076)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC774\uAC83\uB3C4 \uC904\uAC8C![VAR 0114(0076)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB0B4\uAC00 TV\uB85C \uC870\uC0AC\uD558\uBA74\uC11C\\n\uC9C1\uC811 \uB9CC\uB4E0 \uC804\uC124\uC758\uBA54\uBAA8\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC6B0\uC120\uC740 \uBA54\uBAA8\uC5D0\uB3C4 \uC801\uD600 \uC788\uB294\\n\uD48D\uC694\uC758 \uC655\uC774\uB77C\uB294 \uB140\uC11D\uC744\\r\\n\uC870\uC0AC\uD574\uBCF4\uB294 \uAC8C \uC5B4\uB54C?[VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uBB50\uB77C\uB354\uB77C? \uC655\uACFC \uC560\uB9C8\uC758 \uC720\uB300\uC640\\n\uAE4A\uC740 \uAD00\uB828\uC774 \uC788\uB2E4\uB354\uB77C\uACE0!\\r\\n\uADF8\uB7EC\uB2C8\uAE4C \uC774 \uD0D0\uD5D8\uC740 \uC774\uB984\uD558\uC5EC...[VAR 0114(0076)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB9C8\uC744 \uD55C\uAC00\uC6B4\uB370\uC5D0 \uC870\uAC01\uC0C1\uB3C4 \uC788\uB2E4\uACE0!\\n\uB0B4\uAC00 \uC801\uC740 \uBA54\uBAA8\uC640\uB294 \uB2E4\uB974\uAC8C\\r\\n\uBA38\uB9AC\uAC00 \uBCC4\uB85C \uD06C\uC9C4 \uC54A\uC558\uC9C0\uB9CC...[VAR 0114(0076)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC6D0\uB798 \uBCF5\uC7A5\uC73C\uB85C \uAC08\uC544\uC785\uC744\uAE4C?"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC900\uBE44 \uC644\uB8CC...!\\c\\n\uC655\uAD00\uC124\uC6D0\uC758\\n\uC804\uC124\uC744 \uC870\uC0AC\uD574\uBCF4\uC790!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uC774\uB300\uB85C\uB3C4 \uAD1C\uCC2E\uC544!\\c\\n\uC655\uAD00\uC124\uC6D0\uC758\\n\uC804\uC124\uC744 \uC870\uC0AC\uD574\uBCF4\uC790!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "...\uADF8\uB807\uC9C0! \uAD1C\uCC2E\uB2E4\uBA74\\n\uC774\uAC78 \uAC00\uC838\uAC00\uB294 \uAC8C \uC5B4\uB54C!?[VAR 0114(0076)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC5C4\uCCAD\uB098\uAC8C \uAD49\uC7A5\uD55C \uBCFC\uC774\uB77C\uB294 \uAC83 \uAC19\uB354\uB77C\uACE0!\\n\uC5B4\uB5A4 \uB140\uC11D\uC5D0\uAC8C \uC0AC\uC6A9\uD560\uC9C0\uB294 \uB124\uAC8C \uB9E1\uAE38\uAC8C![VAR 0114(0076)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC61B\uB0A0\uC5D0 \uC544\uB294 \uC0AC\uB78C\uD55C\uD14C\uC11C \uBC1B\uC558\uB294\uB370\\n\uC880\uCC98\uB7FC \uC4F8 \uC0DD\uAC01\uC774 \uB4E4\uC9C0 \uC54A\uC544\uC11C \uB9D0\uC774\uC57C...[VAR 0114(0076)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uBB54\uAC00 \uBAA8\uB974\uB294 \uC77C\uC774 \uC0DD\uAE30\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uC544\uC9C0\uD2B8\uB85C \uB3CC\uC544\uC624\uB3C4\uB85D \uD574![VAR 0114(0076)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC55E\uC5D0 \uAF42\uC544\uB193\uC740 \uAE43\uBC1C\uC774\\n\uD0D0\uD5D8\uB300\uC758 \uC544\uC9C0\uD2B8\uB77C\uB294 \uD45C\uC2DD\uC774\uC57C!\\r\\n\uB0B4\uAC00 \uC9C1\uC811 \uB9CC\uB4E4\uC5C8\uB2E4\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uADF8\uB7FC, \uAC00\uC2B4 \uB6F0\uB294 \uD0D0\uD5D8\uC744 \uC2DC\uC791\uD574\uBCF4\uC790\uACE0!\\n\uC7AC\uBC0C\uAC8C \uC990\uAE30\uB2E4 \uC640![VAR 0114(0076)]"
  }
]
