[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624! \uC654\uAD6C\uB098![VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC774 \uCD08\uB77C\uD55C \uACF3\uC774\\n\uB0B4\uAC00 \uBB35\uACE0 \uC788\uB294 \uBC29\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD558\uC9C0\uB9CC \uC9C0\uAE08, \uC774 \uC21C\uAC04\uBD80\uD130\uB294\\n\uC6B0\uB9AC\uC758 \uC544\uC9C0\uD2B8\uAC00 \uB410\uC9C0!![VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "...\uD5E4\uD5E4! \uC774\uB7F0 \uAC74\\n\uBD84\uC704\uAE30\uAC00 \uC911\uC694\uD558\uC796\uC544?[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBCF8\uB860\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC11C, [VAR 0100(0000)]!\\n\uC6B0\uB9AC \uD53C\uC624\uB2C8 \uD0D0\uD5D8\uB300\uC758\\r\\n\uBAA9\uD45C\uB97C \uC124\uBA85\uD574\uC904\uAC8C![VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774 \uC9C0\uC5ED\uC5D0\uB294\\n\uC2E0\uAE30\uD55C \uC804\uC124\uC774 \uC5EC\uB7FF \uC788\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC608\uB97C \uB4E4\uBA74![VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655\uC774\uB77C \uBD88\uB9AC\uB294\\n\uBA38\uB9AC\uAC00 \uBB34\uC9C0\uD558\uAC8C \uD070 \uD3EC\uCF13\uBAAC![VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5EC\uAE30\uC5D0![VAR 0114(0076)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD558\uB298\uC744 \uB098\uB294 \uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\uC774 \uBAA8\uC774\uB294\\n\uBD89\uACE0 \uCEE4\uB2E4\uB780 \uB098\uBB34![VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774\uC0C1\uD55C \uC720\uC801 \uAC19\uC740 \uACF3\uC5D0 \uC7A0\uB4E4\uC5B4 \uC788\uB294\\n\uC810 \uBC15\uD78C \uAC70\uC778\uB4E4![VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB4F1\uB4F1![VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD765\uBBF8\uB85C\uC6B4 \uC804\uC124\uB4E4\uC774\\n\uC794\uB729 \uC788\uB2E4\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC774\uAC83\uB4E4\uC774 \uC9C4\uC2E4\uC778\uC9C0 \uC544\uB2CC\uC9C0\\n\uC2E4\uC81C\uB85C \uD655\uC778\uD574\uBCF4\uB294 \uAC83![VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uADF8\uAC8C \uBC14\uB85C \uC6B0\uB9AC\\n\uD53C\uC624\uB2C8 \uD0D0\uD5D8\uB300\uC758...[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC704\uB300\uD558\uACE0\uB3C4 \uC911\uB300\uD55C \uBAA9\uD45C\uC778 \uAC70\uC9C0![VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uBB50 \uC0AC\uC2E4\uC740\\n\uC6B0\uB9AC \uB2C8\uC544\uC640 \uD568\uAED8\uD558\uACE0 \uC2F6\uC5C8\uB358 \uAC70\uC9C0\uB9CC...[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC637\uAE43\uB9CC \uC2A4\uCCD0\uB3C4 \uBB50\uC2DC\uAE30\uB77C\uB294\\n\uC18D\uB2F4\uB3C4 \uC788\uC796\uC544![VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uB300\uC7A5!\\n\uD568\uAED8 \uC990\uACA8\uBCF4\uC790\uACE0![VAR 0114(0076)]"
