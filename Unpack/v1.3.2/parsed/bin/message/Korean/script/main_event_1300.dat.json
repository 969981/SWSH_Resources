[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB204\uAD6C\uB3C4 \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC5D0 \uAC00\uBA74 \uC548 \uB418\uB2C8\uAE4C\\n9\uBC88\uB3C4\uB85C\uB97C \uC9C0\uB098\uAC00\uAC8C \uD574\uC904 \uC21C \uC5C6\uC5B4![VAR 0114(0043)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uC610\uB2E8\uC740\\n\uAC08\uAC00\uBD80\uAE30\uB97C \uC751\uC6D0\uD558\uBA74\uC11C\\c\\n\uB204\uAD70\uAC00\uAC00 \uBB3C \uC704\uB97C\\n\uAC74\uB108\uB294 \uAC83\uC744 \uBC29\uD574\uD560 \uAC70\uB2E4![VAR 0114(0044)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBC14\uBC14\uC774\uD2B8~"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB124...\\n\uADF8\uB798\uC11C \uB85C\uD1A0\uBB34\uC790\uC804\uAC70\uB85C\\r\\n\uBB3C \uC704\uB97C \uAC74\uB110 \uC218 \uC788\uAC8C..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2D8!\\n\uB9C8\uCE68 \uC798 \uB9CC\uB0AC\uC2B5\uB2C8\uB2E4!\\c\\n\uC790\uC804\uAC70\uB97C \uC120\uBB3C\uD574\uC900\\n\uC800\uB97C \uB3C4\uC640\uC8FC\uB294 \uC148 \uCE58\uACE0\\r\\n\uC774\uB4E4\uC744 \uD63C\uB0B4\uC8FC\uC138\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB294 \uAC08\uAC00\uBD80\uAE30\uB97C \uBCF4\uD638\uD560 \uAC70\uC57C!\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uB10C \uC5EC\uAE30\uC11C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD3EC\uAE30\uD574\uC918\uC57C\uACA0\uC5B4\\r\\n\uC2EB\uB2E4\uBA74 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C \uACB0\uD310\uC744 \uB0B4\uBCFC\uAE4C?[VAR 0114(0043)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC800\uB9AC \uAC00\\n\uC6B0\uB9AC\uB294 \uAC08\uAC00\uBD80\uAE30\uB97C \uC751\uC6D0\uD574\uC57C \uD558\uB2C8\uAE4C[VAR 0114(0043)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAC08\uAC00\uBD80\uAE30\uB97C \uC751\uC6D0\uD558\uAE30 \uC704\uD574\\n\uB108\uB97C \uB0A9\uC791\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uACA0\uC5B4![VAR 0114(0043)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC5D0 \uAC00\uB3C4\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\uB294 \uB3C4\uC804\uD560 \uC218 \uC5C6\uB294\uB370\\r\\n\uADF8\uB0E5 \uD3EC\uAE30\uD558\uB294 \uAC8C \uC5B4\uB54C?[VAR 0114(0044)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD06C\uC73D \uC774\uB300\uB85C \uAC00\uB2E4\uAC04...!\\n\uAC08\uAC00\uBD80\uAE30\uB97C \uD0C0 \uBC84\uB9B4\uC9C0 \uBAB0\uB77C[VAR 0114(0043)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC88B\uC740 \uC0DD\uAC01\uC774 \uB0AC\uC5B4!\\n\uC6B0\uB9AC\uAC00 \uAC08\uAC00\uBD80\uAE30\uB97C \uD0C0\uB294 \uAC70\uC57C![VAR 0114(0044)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC88B\uC544! \uD798\uB0B4\uB77C \uAC08\uAC00\uBD80\uAE30!\\n\uADF8\uB7FC \uC548\uB155\uC774\uB2E4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800![VAR 0114(0043)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBC14\uBC14\uC774\uD2B8~"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB610 \uC800\uB97C \uB3C4\uC640\uC8FC\uC168\uAD70\uC694\\c\\n\uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\\n\uC0AC\uC774\uD074 \uB77C\uC774\uD504\uB97C \uC990\uAE30\uACE0 \uC788\uB098\uC694?"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB85C\uD1A0\uBB34\uC790\uC804\uAC70\uB85C \uBB3C \uC704\uC5D0\uC11C\uB3C4\\n\uB2EC\uB9B4 \uC218 \uC788\uB2E4\uBA74 \uCD5C\uACE0\uACA0\uC8E0?!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uD2B9\uBCC4\uD788 \uBB3C \uC704\uC5D0\uC11C\uB3C4\\n\uC774\uB3D9\uD560 \uC218 \uC788\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uB294 \uD30C\uCE20\uB97C\\r\\n\uB2EC\uC544\uB4DC\uB9AC\uB3C4\uB85D \uD558\uC8E0!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC790 \uC790 \uC790!\\c\\n\uC774\uC81C \uB85C\uD1A0\uBB34\uC790\uC804\uAC70 \uC544\uCFE0\uC544\uBAA8\uB4DC\uB85C\\n\uBB3C \uC704\uC5D0\uC11C\uB3C4 \uC4F1\uC4F1 \uB098\uC544\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\c\\n\uCC38\uACE0\uB85C \uC721\uC9C0\uB97C \uB2EC\uB9B4 \uB54C\uB294\\n\uB79C\uB4DC\uBAA8\uB4DC\uB77C\uACE0 \uBD80\uB978\uB2F5\uB2C8\uB2E4"
  }
]
