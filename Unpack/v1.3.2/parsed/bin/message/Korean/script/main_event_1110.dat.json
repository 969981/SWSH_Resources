[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC0AC\uACE0\uB85C \uC778\uD574\\n\uBE5B\uC744 \uBCF4\uAC8C \uB41C \uC720\uC801...[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uC5B4\uB5A4 \uC804\uC124\uC744\\n\uC804\uD558\uB824\uACE0 \uD558\uB294 \uAC78\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAC80\uACFC \uBC29\uD328?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB798 \uB9DE\uC544! \uC601\uC6C5\uC774\uB77C\uAE30\uBCF4\uB2E4\uB294\\n\uD3EC\uCF13\uBAAC\uC73C\uB85C \uBCF4\uC774\uB294 \uC874\uC7AC\uAC00 \uB208\uC5D0 \uB744\uC9C0?\\c\\n\uC2EC\uC9C0\uC5B4 2\uB9C8\uB9AC\uC758 \uD3EC\uCF13\uBAAC\uC740\\n\uC790\uAE30\uAC00 \uC4F0\uB358 \uAC83\uC778 \uAC83\uCC98\uB7FC\\r\\n\uAC80\uACFC \uBC29\uD328\uB97C \uC9C0\uB2C8\uACE0 \uC788\uC5B4![VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8 \uBC16\uC5D0 \uC2E0\uACBD \uC4F0\uC774\uB294 \uC810\uC740 \uC5C6\uC5B4?[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC601\uC6C5\uC740... \uB458\uC774\uC5C8\uB2E4?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD0DC\uD53C\uC2A4\uD2B8\uB9AC\uC640 \uB611\uAC19\uB124\uC694?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB798 \uB9DE\uC544!\\n\uC601\uC6C5\uC740 \uB450 \uBA85\uC774\uC5C8\uB358 \uAC70\uC57C\\c\\n\uADF8\uB807\uB2E4\uBA74 \uAF2C\uBABD\uC6B8\uBE44\uC988\uB2C8\uC2A4\uD638\uD154\uC5D0 \uC788\uB358\\n\uC601\uC6C5\uC758 \uB3D9\uC0C1\uC740\\r\\n\uC5B4\uC9F8\uC11C \uD55C \uBA85\uBFD0\uC774\uC5C8\uB358 \uAC78\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC601\uC6C5\uC758 \uB3D9\uC0C1\uC774\uB098\\n\uC624\uB798\uB41C \uD0DC\uD53C\uC2A4\uD2B8\uB9AC\uBCF4\uB2E4\uB3C4\\r\\n\uB354 \uACFC\uAC70\uC5D0 \uB9CC\uB4E4\uC5B4\uC9C4 \uC720\uC801\uC774\\r\\n\uC9C4\uC2E4\uC744 \uC81C\uB300\uB85C \uC804\uB2EC\uD558\uACE0 \uC788\uC744 \uAC70\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uB294 \uAC83\uC740...[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAC80\uC740 \uD3EC\uCF13\uBAAC!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBC29\uD328\uB3C4 \uD3EC\uCF13\uBAAC!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB098\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD574!\\c\\n\uC5B8\uC81C\uBD80\uD134\uAC00 \uAC80\uACFC \uD3EC\uCF13\uBAAC\\n\uADF8\uB9AC\uACE0 \uBC29\uD328\uC640 \uD3EC\uCF13\uBAAC\uC740...\\c\\n\uAC19\uC740 \uC874\uC7AC\uB85C \uCDE8\uAE09\uB3FC\uC11C...\\n\uC5ED\uC0AC\uC758 \uB4A4\uC548\uAE38\uB85C \uC0AC\uB77C\uC9C4 \uAC70 \uC544\uB2D0\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC601\uC6C5\uC740 \uB450 \uBA85\uC758 \uC80A\uC740\uC774\\c\\n\uAC80\uACFC \uBC29\uD328\uB294\\n\uBAA8\uB450 \uD3EC\uCF13\uBAAC\uC774\uC5C8\uC5B4\\c\\n\uD558\uC9C0\uB9CC \uC9C4\uC2E4\uC744 \uC804\uD558\uB294 \uC720\uC801\uC740\\n\uC608\uC220\uC801\uC778 \uADF8\uB9BC\uC73C\uB85C \uAC10\uCDB0\uC838 \uC788\uC5C8\uB294\uB370\\r\\n\uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358 \uAC78\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC! \uB124 \uB355\uBD84\uC5D0\\n\uD070 \uBC1C\uACAC\uC744 \uD560 \uC218 \uC788\uC5C8\uC5B4\\c\\n\uC774\uAC78 \uB098\uB220\uC904 \uD14C\uB2C8\uAE4C\\n\uB108\uB3C4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uD798\uB0B4!\\r\\n\uB2E4\uC74C\uC740 \uC544\uB77C\uBCA0\uC2A4\uD06C\uB9C8\uC744\uC774\uC9C0?[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB108\uBB34\uB098\uB3C4 \uC608\uC220\uC801\uC778\\n\uADF8\uB9BC \uB4A4\uC5D0 \uAC10\uCDB0\uC838 \uC788\uB358 \uC5ED\uC0AC...\\r\\n\uC870\uAE08 \uB354 \uC870\uC0AC\uD574\uBD10\uC57C\uACA0\uC5B4[VAR 0114(000B)]"
  }
]
