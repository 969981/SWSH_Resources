[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC1E0\uD1F4\uD55C \uB9C8\uC744\uC774\uB77C\uB3C4 \uC0B4\uACE0 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uACFC \uC0AC\uB78C\uC5D0\uAC8C\uB294 \uC18C\uC911\uD558\uB2E8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC610\uB2E8\uC744 \uADF8\uB9CC\uB450\uC9C0 \uC54A\uC744 \uAC70\uC57C!\\n\uB9C8\uB9AC\uB97C \uC751\uC6D0\uD560 \uAC70\uC57C!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB450\uC1A1\uC758 \uD32C\uC774\uC57C\\n\uACC4\uC18D \uC2DC\uD569\uD574\uC8FC\uBA74 \uC88B\uACA0\uC5B4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC774\uB7EC\uB2C8\uC800\uB7EC\uB2C8 \uD574\uB3C4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00\\n\uC624\uB294 \uAC8C \uD65C\uB825\uC774 \uB118\uCE5C\uB2E4\uACE0 \uC0DD\uAC01\uD574"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8\uC740\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD558\uC9C0 \uC54A\uC544!\\c\\n\uC704\uC6D0\uC7A5\uC740 \uC870\uAE08 \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0 \uC788\uB294\\n\uD30C\uC6CC\uC2A4\uD3FF \uADFC\uCC98\uB85C\\r\\n\uB9C8\uC744\uC744 \uD1B5\uC9F8\uB85C \uC62E\uAE30\uB824\uACE0 \uD588\uB294\uB370 \uB9D0\uC774\uC9C0"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uC154\uD130\uB97C \uB0B4\uB9AC\uACE0\\n\uCC4C\uB9B0\uC800\uB97C \uBC29\uD574\uD55C \uAC74\\r\\n\uC2A4\uD3EC\uCE20\uB9E8\uB2F5\uC9C0 \uC54A\uC558\uB098"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uD2B8\uB808\uC774\uB108\uB294 \uADF8\uB807\uB2E4 \uCE58\uACE0\\n\uD3EC\uCF13\uBAAC\uC774 \uC5F4\uC2EC\uD788 \uD574\uC918\uC57C \uD574\\r\\n\uB108\uD76C \uC218\uACE0\uD588\uC5B4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD788\uD788\uC774\uD788~!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAD6C\uBB34\uAD6C\uBB34"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC0E4~!!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[~ 11]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8\\n\uACE0~ \uD30C\uC774\uD305!!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\\n\uB2F9\uC2E0 \uAD49\uC7A5\uD588\uC5B4\uC694"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB450\uC1A1\uB2D8\uC740\\n\uBA4B\uC788\uC5B4!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC774\uC81C\uBD80\uD130\uB294 \uB9C8\uB9AC\uC758 \uC2DC\uB300\uC57C\\n\uB098\uB294 \uC54C \uC218 \uC788\uC5B4"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8\uC744 \uC774\uAE30\uB2E4\uB2C8\\n\uAD49\uC7A5\uD55C \uB140\uC11D\uC774\uC57C!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB354 \uB9CE\uC774\\n\uC751\uC6D0\uD558\uACE0 \uC2F6\uB2E4!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00\\n\uC624\uBA74 \uD65C\uAE30\uAC00 \uC0DD\uACA8~"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8\uC774 \uAD00\uC7A5\uC77C \uB54C\uAC00\\n\uC88B\uC558\uC5C8\uB294\uB370"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[~ 20]"
  },
  {
