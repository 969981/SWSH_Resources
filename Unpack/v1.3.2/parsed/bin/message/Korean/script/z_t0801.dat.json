    "text": "[~ 24]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC0AC\uB791\uD55C\uB2E4\uB294\\n\uC751\uC6D0\uC744 \uBCF4\uB0C5\uB2C8\uB370\uC5D8\u266A"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC751\uC6D0\uC744 \uBCF4\uB0C5\uB2C8\uB370\uC5D8\u266A"
  },
