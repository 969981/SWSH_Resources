[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB3C4\uCC29\uD55C \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uB9CC\uC871\uD558\uB294\uB370\\n\uC720\uC801\uC744 \uBCF4\uBA74 \uC5B4\uB5A4 \uB290\uB08C\uC77C\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBCBD\uD654\uB97C \uBCF4\uBA74 \uB10B\uC744 \uC783\uAC8C \uB3FC...\\n\uC5B4\uB514\uAC00 \uADF8\uB807\uAC8C \uB9E4\uB825\uC801\uC778 \uAC78\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC720\uC801\uC758 \uBCBD\uD654\uB85C \uB9C8\uC744\uC744 \uD65C\uC131\uD654\uD558\uACE0 \uC788\uC5B4!\\n\uC0AC\uC2E4\uC740 \uC608\uC804\uBD80\uD130 \uADF8\uB798\uC654\uB2E8\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB77C\uCE74\uB77C\uCE74\uC544..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD5E4\uC774\uD5E4\uC5D0\uC774"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC544\uC800\uC528\uC758 \uD3EC\uCF13\uBAAC\uC740 \uAC8C\uC73C\uB984\uBC45\uC774\uB77C\\n\uD3EC\uCF13\uBAAC\uC7A1\uC758 \uD3EC\uCF13\uBAAC\uC774 \uCC28\uB77C\uB9AC \uB354 \uC758\uC695\uC801\uC774\uC57C"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC790 \uB3D9\uD0C1\uAD70\uACFC \uB180\uC790!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC9C0\uB2E4\uB2E4\uB2E4\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC800\uAE30 \uC800\uAE30\\n\uC5B4\uB514\uAC00 \uC785\uC774\uC57C?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB3D9\uD0C1\uAD70 \uC548\uC5D0 \uB4E4\uC5B4\uAC00 \uBCF4\uACE0 \uC2F6\uC5B4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB3D9\uD0C1\uAD70\uC774\\n\uBE44\uB97C \uC624\uAC8C \uD558\uB294 \uAC70\uC57C?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB3C4\uB9AC\uB3C4\uB9AC\uB3C4\uB9BF!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAE30\uB150\uC73C\uB85C \uC720\uC801 \uAE30\uB150\uD488\uC744 \uC0AC\uC9C0 \uADF8\uB798?\\n\uC5EC\uAE30\uC5D0\uC11C\uB9CC \uC0B4 \uC218 \uC788\uB294 \uADC0\uD55C \uAC70\uC57C"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC9D0\uC774 \uB298\uC5B4\uB098\uC796\uC544\uC694\\n...\uADF8\uB798\uB3C4 \uBA4B\uC788\uAE34 \uD558\uB124\uC694"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD6C4\uB78F"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB2E8\uB2E8"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB3D7\uB3C4\uB3C4\uC6B0\uB3C4"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uC758 \uC720\uC801\uC744\\n\uB514\uADF8\uB2E4\uC5D0\uAC8C \uBCF4\uC5EC\uC904 \uAC70\uC57C\\c\\n\uC5B4\uCA4C\uBA74 \uC608\uC220\uC5D0\\n\uB208\uB728\uAC8C \uB420\uC9C0 \uBAA8\uB974\uB2C8\uAE4C"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uBB50\uC57C \uBB50\uC57C!?\\n\uC720\uC801\uC5D0\uC11C \uAD49\uC7A5\uD55C \uC18C\uB9AC\uAC00 \uB0AC\uC5B4!\\c\\n\uAD00\uAD11\uAC1D\uC744 \uC704\uD55C\\n\uC11C\uD504\uB77C\uC774\uC988\uC778 \uAC74\uAC00?"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC720\uC801\uC5D0 \uAD00\uD55C \uC774\uC57C\uAE30... \uC544\uB77C\uBCA0\uC2A4\uD06C\\n\uB140\uC11D\uB4E4\uC5D0\uAC8C\uB3C4 \uC54C\uB824\uC918\uC57C\uACA0\uC5B4\\c\\n\uC74C... \uC544\uB77C\uBCA0\uC2A4\uD06C\uB9C8\uC744\uC5D0 \uAC00\uAE30 \uC704\uD574\uC11C\uB294\\n\uBC84\uC12F\uC232\uC744 \uBE60\uC838\uB098\uAC00\uC57C\uACA0\uAD70"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uCE74\uBD80\uCE74\uBD80"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uD560 \uC218 \uC788\uB294 \uC7A5\uC18C\uB97C\\n\uD30C\uC6CC\uC2A4\uD3FF\uC774\uB77C\uACE0 \uD574\\c\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC740\\n\uD30C\uC6CC\uC2A4\uD3FF \uC704\uC5D0 \uC138\uC6CC\uC9C4 \uAC70\uC57C"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC73C\uC73C\uC74C? \uBB34\uC2A8 \uC77C\uC774\uC9C0?\\n\uC720\uC801\uC5D0 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC70\uC9C0?"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC800\uAE30 \uB9D0\uC774\uC57C \uC601\uC6C5\uC774\uB780\\n\uC0AC\uB78C\uACFC \uD3EC\uCF13\uBAAC\uC744 \uB9D0\uD558\uB294 \uAC78\uAE4C?"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uD6CC\uB96D\uD55C \uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC774\uB124\uC694"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uAC11\uC791\uC2A4\uB7FD\uAC8C \uB098\uB294 \uD070 \uC18C\uB9AC\uB294\\n\uC0AC\uB78C\uC744 \uBD88\uC548\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC694"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uBD80\uC11C\uC9C0\uAE30 \uC804\uC774\\n\uB354 \uC608\uC220\uC131\uC774 \uC788\uC5C8\uC5B4\uC694"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uBC14\uB2E4\uB77C...\\n\uC0B0\uC740 \uC544\uB2C8\uAD70..."
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC5B4\uB514\uC120\uAC00 \uBCF8 \uC801 \uC788\uB294\uB370...\\n\uD639\uC2DC \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800...?"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC720\uC801\uC758 \uC9C4\uC2E4\uC744...\\c\\n\uC870\uC0AC\uD558\uACE0 \uC788\uB294 \uC18C\uB2C8\uC544\uB2D8\uC774\\n\uB9E4\uADF8\uB180\uB9AC\uC544\uBC15\uC0AC\uB2D8\uC758 \uC190\uB140\uC57C...?"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC0B0\uC5D0 \uC0AC\uB294 \uD3EC\uCF13\uBAAC\\n\uC232\uC5D0 \uC0AC\uB294 \uD3EC\uCF13\uBAAC\\r\\n\uB2E4\uC591\uD558\uAC8C \uC788\uAD6C\uB098"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uBC29\uAE08 \uADF8 \uC18C\uB9AC...\\n\uCC9C\uB465...\uC740 \uC544\uB2C8\uC9C0?"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC544\uB77C\uBCA0\uC2A4\uD06C\uB9C8\uC744\uC5D0 \uAC00\uB824\uBA74\\n\uB8E8\uBBF8\uB108\uC2A4\uBA54\uC774\uC988\uC232\uC744 \uC9C0\uB098\uAC00\uC57C \uD574\\c\\n\uB8E8\uBBF8\uB108\uC2A4\uBA54\uC774\uC988\uC232\uC744 \uC9C0\uB098\uB294 \uB370\uB294...\\n\uBC84\uC12F\uC744 \uAC74\uB4DC\uB9AC\uB294 \uAC83\uC774 \uC911\uC694\uD574"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uB108\uB294 \uAD00\uAD11\uAC1D\uC774\uB2C8?\\n\uC544\uB2C8\uBA74 \uCC4C\uB9B0\uC800?"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uBA4B\uC9C4 \uC2DC\uD569\uC774\uC5C8\uC5B4\\n\uB098\uC774\uC2A4 \uD30C\uC774\uD2B8!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC720\uC801\uC744 \uBC1C\uACAC\uD55C\\n\uCC54\uD53C\uC5B8\uC774\uB2E4!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\\n\uB208\uC774 \uD551\uD551 \uB3C8\uB300!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uBC30\uC9C0\uB97C \uB530\uBA74\\n\uBAA8\uB450 \uD6C4\uB4E4\uD6C4\uB4E4..."
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\\n\uBA4B\uC788\uC5B4!!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB4DD\uD15C\uD55C \uBB3C\uAC74\uC73C\uB85C\\n\uD55C\uBC11\uCC9C \uC7A1\uC744 \uAC70\uC57C!"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uB4DD\uD15C\uD55C \uBB3C\uAC74\uC73C\uB85C\\n\uD070\uB3C8\uC744 \uBC8C \uAC70\uC57C!"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uB4DD\uD15C...\\n\uC694\uC998\uC740 \uADF8\uC800 \uADF8\uB798..."
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uBCBD\uD654...\\n\uC5B4\uC124\uD508 \uAC83 \uAC19\uC544"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uBE68\uB9AC \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uACE0 \uC2F6\uC5B4!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uBB34\uB108\uC9C4 \uBCBD\uD654...\\n\uC5B4\uC124\uD508 \uC810\uC774 \uC88B\uC558\uC5B4"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uB9C8\uC744\uC758 \uBA85\uBB3C\uC778 \uC720\uC801\\n\uC2EC\uC624\uD55C \uC608\uC220 \uC791\uD488\uC73C\uB85C \uC77C\uCEEC\uC5B4\uC9C0\uACE0 \uC788\uB2E4"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uB9C8\uC744\uC758 \uBA85\uBB3C\uC778 \uC720\uC801\\n\uC548\uCABD\uC5D0 \uC228\uACA8\uC838 \uC788\uB358 \uC601\uC6C5\uC0C1\\c\\n\uB450 \uBA85\uC758 \uC601\uC6C5\uACFC\\n\uB450 \uB9C8\uB9AC\uC758 \uD3EC\uCF13\uBAAC\uC774 \uC11C \uC788\uB2E4"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uB3C4\uC624~\uC639!!"
  }
]
