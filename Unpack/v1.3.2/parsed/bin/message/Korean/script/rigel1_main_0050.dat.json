[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB2E4\uB4E4 \uC8FC\uBAA9~!\\n\uC2E0\uC785\uC774\uB97C \uC18C\uAC1C\uD560\uAC8C![VAR 0114(0074)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC55E\uC73C\uB85C \uB108\uD76C\uC640 \uD568\uAED8 \uC218\uD589\uD560\\n[VAR 0100(0000)][VAR 1900(0006)]\uB780\uB2E4!\\r\\n\uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uB834![VAR 0114(0074)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC544\uC790!\\n\uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uBB38\uD558\uC0DD\uB4E4\uC740\\n\uB2E4\uB4E4 \uC131\uC2E4\uD55C \uB178\uB825\uAC00\uB780\uB2E4[VAR 0114(0074)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBB38\uD558\uC0DD \uB9AC\uC2A4\uD2B8\uC5D0 \uC874\uC7AC\uD558\uC9C0 \uC54A\uB294\\n\uC778\uBB3C\uC774 \uB4F1\uC7A5...[VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B4\uBA38 \uBCC4\uC77C\uC774\uB124!\\n\uB124\uAC00 \uB9C8\uC911\uC744 \uB2E4 \uB098\uC624\uACE0[VAR 0114(0074)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC774 \uC544\uC774\uB294 \uD558\uC774\uB4DC\\n\uB0B4 \uD558\uB098\uBFD0\uC778 \uC544\uB4E4\uC774\uB780\uB2E4![VAR 0114(0074)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB108\uB294 \uC774\uB808\uADE4\uB7EC\uC57C?\\n\uC774\uAC78 \uC368\uBD10[VAR 0114(0075)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uB9CC\uB4E0 \uD14C\uD06C\uB180\uB85C\uC9C0\uAC00\\n\uB2F4\uACA8 \uC788\uC73C\uB2C8\uAE4C\\r\\n\uC5F4\uC5B4\uC11C \uACE0\uC7A5 \uB0B4\uBA74 \uC548 \uB3FC[VAR 0114(0075)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uC560\uB294 \uC190\uC7AC\uC8FC\uAC00 \uB6F0\uC5B4\uB098\uC11C\\n\uC774\uAC83\uC800\uAC83 \uB9CC\uB4DC\uB294\\r\\n\uAE30\uD2B9\uD55C \uC544\uC774\uB780\uB2E4[VAR 0114(0074)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC800\uAE30 \uC788\uB294 \uBA4B\uC9C0\uAC8C \uC0DD\uAE34 \uC0AC\uB78C\uC774\\n\uC6B0\uB9AC \uB2EC\uB9C1\uC774\uC57C\\r\\n\uC774 \uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC758 \uC2A4\uC2B9\uB2D8\uC774\uC9C0[VAR 0114(0074)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "......[VAR 0114(0042)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB0B4 \uC774\uB984\uC740 \uB9C8\uC2A4\uD130\uB4DC!\\n\uB0B4 \uD3EC\uCF13\uBAAC\uC740 \uC5C4~\uCCAD \uAC15\uD558~\uC9C0![VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC55E\uC73C\uB85C \uC798 \uBD80\uD0C1\uD589~![VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4...?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2F9!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4~ \uC608\uC758 \uBC14\uB974\uACE0\\n\uCC29\uD55C \uC544\uC774\uAD6C\uB098~[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4~ \uC0C1\uB0E5\uD558\uACE0\\n\uCC29\uD55C \uC544\uC774\uAD6C\uB098~[VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "[~ 19]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774\uC774\uB294 \uD3C9\uC18C\uC5D0\uB294 \uB9F9\uD574 \uBCF4\uC774\uC9C0\uB9CC\\n\uC9C4\uC9C0\uD560 \uB54C\uB294 \uAD49\uC7A5\uD55C \uC0AC\uB78C\uC774\uB780\uB2E4[VAR 0114(0074)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB2EC\uB9C1~\\n\uC798 \uBD80\uD0C1\uD560\uAC8C![VAR 0114(0074)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC624\uC608~! \uADF8\uB7FC \uC6B0\uC120\\n\uB108\uC758 \uC2E4\uB825\uC744 \uD655\uC778\uD574\uBCF4\uACE0 \uC2F6\uC73C\uB2C8\uAE4C~[VAR 0114(0073)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAC04\uB2E8\uD558\uAC8C \uB098\uB791\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD574\uBCFC\uAE4C![VAR 0114(0073)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC900\uBE44\uAC00 \uB410\uB2E4\uBA74\\n\uB9D0\uC744 \uAC78\uC5B4\uC8FC\uB824\uBB34\uB098[VAR 0114(0073)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uD06C\uC73C~! \uC2A4\uC2B9\uB2D8\uACFC\uC758 \uC2B9\uBD80\uB77C\uB2C8\\n\uB108\uBB34 \uBD80\uB7FD\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC2B9\uBD80\uD558\uAE30 \uC804\uC5D0\uB294 \uB9AC\uD3EC\uD2B8 \uC791\uC131!\\n\uC774\uAC83\uC774\uC57C\uB9D0\uB85C \uBAA8\uD5D8\uC758 \uAE30\uBCF8\uC785\uB2C8\uB2E4! \uC544\uC790!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB3C4\uC7A5\uC774\uB77C\uACE0 \uD558\uBA74\\n\uBB34\uAC70\uC6B4 \uBD84\uC704\uAE30\uC77C \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD558\uACA0\uC9C0\uB9CC\\c\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC740 \uC990\uAC70\uC6CC!\\n\uC0AC\uBAA8\uB2D8\uC774 \uB9CC\uB4E4\uC5B4\uC8FC\uC2DC\uB294 \uBC25\uB3C4 \uB9DB\uC788\uACE0!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC774 \uC5B4\uB5A4 \uBC30\uD2C0\uC744 \uBCF4\uC5EC\uC904\uC9C0\\n\uD765\uBBF8\uC9C4\uC9C4\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC2A4\uC2B9\uB2D8\uC740 \uC0C1\uB0E5\uD558\uC2DC\uB2C8\uAE4C\\n\uAC71\uC815 \uB9D0\uACE0 \uD55C \uC218 \uBC30\uC6CC\uBCF4\uC138\uC694!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD558\uC774\uB4DC\uC758 \uACBD\uD5D8\uBD80\uC801\uC740\\n\uB098\uB3C4 \uC0AC\uC6A9\uD558\uACE0 \uC788\uC5B4\\c\\n\uC9C0\uB2C8\uACE0 \uC788\uAE30\uB9CC \uD574\uB3C4\\n\uB4E4\uC5B4\uC624\uB294 \uACBD\uD5D8\uCE58\uAC00 \uBD80\uCA4D \uB298\uC5B4\uB09C\uB2E4\uAD6C!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB3C4\uBCF5\uC740 \uC785\uC9C0 \uC54A\uC558\uC9C0\uB9CC\\n\uB098\uB3C4 \uBB38\uD558\uC0DD\uC774\uC57C!\\r\\n\uB9DE\uB294 \uC0AC\uC774\uC988\uAC00 \uC5C6\uC5C8\uAC70\uB4E0!"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC740\\n\uC870\uAE08 \uC0C9\uB2E4\uB978 \uB3C4\uC7A5\uC774\uC57C!\\c\\n\uB0AE\uC7A0\uC774\uB098 \uCCAD\uC18C\uAC19\uC774\\n\uD2B9\uC774\uD55C \uC218\uD589\uC774 \uB9CE\uC544"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uADF8\uB300\uC5D0\uAC8C\uC120 \uAC15\uD55C \uC790\uC758\\n\uB0C4\uC0C8\uAC00 \uB098\uB294\uAD70...!"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC798 \uBD80\uD0C1\uD574~"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB3C4\uC7A5\uC5D0 \uB300\uD574\\n\uAD81\uAE08\uD55C \uAC8C \uC788\uC73C\uBA74\\r\\n\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uBB3C\uC5B4\uBD10~[VAR 0114(0071)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uAD81\uAE08\uD55C \uAC8C \uC788\uB2E4\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uBD88\uB7EC\uC8FC\uC138\uC694\\r\\n...\uC800 \uB9D0\uACE0 \uB2E4\uB978 \uC0AC\uB78C\uC744\uC694[VAR 0114(0072)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC5ED\uC5D0\uC11C \uAC78\uC5B4\uC624\uB290\uB77C\\n\uD798\uB4E4\uC5C8\uC9C0?[VAR 0114(0074)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uACFC \uC26C\uACE0 \uC2F6\uB2E4\uBA74\\n\uC800\uCABD\uC5D0 \uC788\uB294 \uBC29\uC744 \uC0AC\uC6A9\uD558\uB3C4\uB85D \uD558\uB834[VAR 0114(0074)]"
  }
