  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBB3C\uB860\uC785\uB2C8\uB2E4\\n\uB2F9\uC2E0\uC758 \uB9D1\uC740 \uB208\uC73C\uB85C \uD655\uC778\uD574\uBCF4\uC2DC\uC8E0[VAR 0114(0042)]"
