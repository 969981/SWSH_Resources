  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD6D7 \uC57C\uB3C8\uC774 \uB9C8\uC911\uC744 \uB098\uC624\uB2E4\uB2C8\\n\uC774\uB807\uAC8C \uC5D8\uB808\uAC15\uC2A4\uD560 \uC218\uAC00[VAR 0114(0042)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC774\uB7F0~ \uAC11\uC637\uC12C\uC5D0\uC11C\\n\uD658\uC2B9\uD574\uC11C \uC628 \uBAA8\uC591\uC774\uAD70"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uC57C\uB3C8\uC740\\n\uCC98\uC74C \uBCF4\uB2C8?\\c\\n\uBA38\uB9AC\uAC00 \uCE74\uB808\uC0C9 \uAC19\uC544\uC11C\\n\uC5C4\uCCAD \uD050\uD2B8\uD558\uC9C0 \uC54A\uB2C8?[VAR 0114(0042)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uC57C\uB3C8\uC740\\n\uCC98\uC74C \uBCF4\uC2DC\uB098 \uBCF4\uC8E0?\\c\\n\uD0DC\uC5B4\uB09C \uACF3\uC740 \uB2EC\uB77C\uB3C4\\n\uC57C\uB3C8\uC758 \uB290\uAE0B\uD568\uC740 \uC5EC\uC804\uD558\uB124\uC694[VAR 0114(0042)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC5D0\uB294 \uC57C\uB3C8\uC774\\n\uC794\uB729 \uC0B4\uACE0 \uC788\uB2E8\uB2E4\\c\\n\uC5EC\uD589\uC774 \uD558\uACE0 \uC2F6\uC740 \uAC74\uC9C0\\n\uAC00\uB054\uC529 \uBA87 \uB9C8\uB9AC\uAC00 \uC62C\uB77C\uD0C0\uACE4 \uD558\uC9C0"
