    "index": 0,
    "flags": 0,
    "text": "\uC624! [VAR 0100(0000)]!\\n\uAE08\uB791\uB2D8\uC5D0\uAC8C \uBA4B\uC9C0\uAC8C \uC2B9\uB9AC\uD55C \uAC83\\r\\n\uADF8\uB9AC\uACE0 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uB3CC\uD30C\uD55C \uAC83\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD574!![VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC81C\uB300\uB85C \uCD95\uD558\uD574\uC8FC\uACE0 \uC2F6\uC9C0\uB9CC\\n\uC6B0\uC120\uC740 \uB108\uB3C4 \uAC19\uC774 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uC918[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0\uC758 \uBE5B...\\c\\n\uBA3C \uC61B\uB0A0\uC5D0 \uAC70\uB300\uD55C \uD3EC\uCF13\uBAAC\uC774\\n\uB9C8\uAD6C \uB0A0\uB6F0\uC5B4\uC11C \uAC00\uB77C\uB974\uC9C0\uBC29\uC744\\r\\n\uBA78\uB9DD\uC2DC\uD0AC \uBED4\uD588\uB2E4\uACE0 \uC804\uD574 \uB0B4\uB824\uC624\uB294\\r\\n\uBE14\uB799 \uB098\uC774\uD2B8\uC640 \uAC19\uC740 \uAC70\uC8E0?[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uAC83 \uAC19\uB354\uAD6C\uB098\\c\\n\uC9C0\uC0C1\uC5D0 \uB5A8\uC5B4\uC9C4 \uC18C\uC6D0\uC758\uBCC4\uC5D0\uC11C\\n\uB098\uC624\uB294 \uC5D0\uB108\uC9C0\uB97C \uC774\uC6A9\uD574\uC11C\\r\\n\uD3EC\uCF13\uBAAC\uC744 \uB2E4\uC774\uB9E5\uC2A4\uC2DC\uD0A4\uACE0 \uC788\uC9C0[VAR 0114(000A)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uC6B0\uB9AC\uB294 \uC5D0\uB108\uC9C0\uB97C\\n\uC81C\uC5B4\uD560 \uBC29\uBC95\uC744 \uBAA8\uB974\uC9C0\\c\\n\uC65C\uB0D0\uD558\uBA74 \uB450 \uBA85\uC758 \uC601\uC6C5\uC774\\n\uBB34\uC5C7\uC778\uC9C0\uB97C \uBAA8\uB974\uAE30 \uB54C\uBB38\uC774\uB780\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC804\uC124\uC758 \uAC80\uACFC \uBC29\uD328...[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB098\uC758 \uC0AC\uB791\uD558\uB294 \uC18C\uB2C8\uC544\\n\uB108\uC5D0\uAC8C \uB0B4 \uAC00\uC6B4\uC744 \uBB3C\uB824\uC8FC\uB9C8[VAR 0114(000A)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB124? \uC544\uC9C1 \uC219\uC81C\uB97C \uB2E4 \uB05D\uB0B4\uC9C0 \uBABB\uD588\uB294\uB370\\n\uC815\uB9D0 \uAD1C\uCC2E\uC740 \uAC70\uC608\uC694 \uD560\uBA38\uB2C8?[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC774\uAC78 \uBB3C\uB824\uC8FC\uB294 \uAC74 \uC219\uC81C\uB97C \uB05D\uB0B4\uAE30 \uC704\uD574\uC11C\uB780\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC18C\uB2C8\uC544\uBC15\uC0AC\uB2D8\uC774\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBA4B\uC838!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC624, \uC624\uC608...![VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBE14\uB799 \uB098\uC774\uD2B8\uB85C\uBD80\uD130\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC744 \uC9C0\uD0A8\\r\\n\uB450 \uBA85\uC758 \uC601\uC6C5...\\c\\n\uBC29\uAE08 \uB124\uAC00 \uB9D0\uD55C\\n\uC804\uC124\uC758 \uAC80\uACFC \uBC29\uD328\uC5D0 \uB300\uD55C \uC9C4\uC2E4\uC744\\r\\n\uBD80\uB514 \uBC1D\uD600\uC8FC\uB824\uBB34\uB098[VAR 0114(000A)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB124![VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB098\uB294 \uB108\uB098 \uD638\uBE0C\uAC00\\n\uB2E8\uB378\uACFC \uC2F8\uC6B0\uB294 \uBAA8\uC2B5\uC744 \uBCF4\uACE0 \uC2F6\uC5B4!\\c\\n\uB098\uBA38\uC9C0\uB294 \uC774 [VAR 1100(00FF,0202)]\uB204\uB098\uC5B8\uB2C8\uC5D0\uAC8C \uB9E1\uAE30\uACE0\\n\uB108\uB294 \uC29B\uC2DC\uD2F0\uC5D0 \uAC00\uB3C4\uB85D \uD574\\r\\n\uC790 \uC5ED\uC5D0 \uAC00\uC11C \uC5F4\uCC28\uB97C \uD0C0\uB294 \uAC70\uC57C![VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC5ED\uC740 7\uBC88\uB3C4\uB85C \uADFC\uCC98\uC5D0 \uC788\uC5B4\\n\uC790 \uC774\uC81C \uAC00\uBD10! \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800![VAR 0114(000B)]"
