[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBC14\uC6B0\uB9C8\uC744 \uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC758\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC740~!\\c\\n\uBBF8\uB85C\uB97C \uD074\uB9AC\uC5B4\uD574\uC11C\\n\uACE8\uC5D0 \uB3C4\uCC29\uD558\uAE30\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2E8 \uBBF8\uB85C\uB294 \uB3C4\uC911\uC5D0\\n\uBB3C\uC5D0 \uC758\uD574 \uAE38\uBAA9\uC774 \uCC28\uB2E8\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uADF8\uB7F4 \uB550 \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD558\uB0D0\uAD6C\uC694?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC800\uCABD\uC5D0 \uC788\uB294 \uBE68\uAC04 \uC2A4\uC704\uCE58\uB97C\\n\uB20C\uB7EC\uBCF4\uBA74 \uC54C \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC! \uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2A4\uD0C0\uD2B8!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBBF8\uC158\uC774 \uBB50\uC600\uC8E0?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC2A4\uC704\uCE58\uB97C \uB20C\uB7EC\uC11C\\n\uBB3C\uC744 \uB0B4\uBCF4\uB0C8\uB2E4\uAC00 \uBA48\uCDC4\uB2E4\uAC00 \uD558\uBA74\uC11C\\r\\n\uACE8\uC5D0 \uB3C4\uCC29\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uBA74 \uCC98\uC74C\uBD80\uD130\\n\uB2E4\uC2DC \uD558\uAC8C \uB429\uB2C8\uB2E4\uB9CC\\r\\n\uC815\uB9D0 \uAE30\uAD8C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCD9C\uBC1C\uD558\uC2DC\uC8E0!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
