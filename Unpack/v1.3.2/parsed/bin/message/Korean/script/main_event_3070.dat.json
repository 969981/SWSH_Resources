  {
    "index": 21,
    "flags": 0,
    "text": "\uBC14\uB85C \uC2A4\uD0C0\uB514\uC6C0\uC73C\uB85C \uAC00\uC790!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB450 \uC0AC\uB78C\uC744 \uCAD3\uC790!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uD638\uC624... \uADF8\uB807\uAC8C \uB098\uC640\uC57C\\n\uCC54\uD53C\uC5B8\uC774\uB77C \uD560 \uC218 \uC788\uC9C0[VAR 0114(0016)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB4A4\uCAD3\uACE0 \uC2F6\uC5B4\uB3C4\\n\uADF8\uB4E4\uC774 \uC5B4\uB514\uB85C \uAC14\uC744\uC9C0...[VAR 0114(0016)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC2E4\uC18C\uCF64\uBE44\uB294\\n\uB0B4\uAC8C \uB9E1\uACA8\uC918![VAR 0114(000B)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC778\uD130\uB137\uC758 \uBAA9\uACA9 \uC815\uBCF4\uB85C\\n\uC704\uCE58\uB97C \uC54C\uB824 \uC904\uAC8C![VAR 0114(000B)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC815\uBCF4 \uC218\uC9D1\uC740\\n\uC18C\uB2C8\uC544\uB2D8...? \uC5D0\uAC8C \uB9E1\uAE30\uACE0\\c\\n\uC6B0\uB9AC\uB294 \uB2E4\uB978 \uC2A4\uD0C0\uB514\uC6C0\uC744\\n\uB3C4\uC640\uC8FC\uB7EC \uAC00\uBCFC\uAE4C?[VAR 0114(0016)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB4A4\uCAD3\uC544 \uAC08 \uD14C\uB2C8\uAE4C \uBA3C\uC800 \uAC00\uBCF4\uB3C4\uB85D \uD574\\n\uC5B4\uB290 \uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uAC08\uC9C0\uB294\\r\\n\uB108\uC5D0\uAC8C \uB9E1\uAE38\uAC8C[VAR 0114(0016)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB09C \uB204\uAD70\uAC00\uAC00 \uACE4\uACBD\uC5D0 \uCC98\uD558\uBA74\\n\uD798\uC774 \uB418\uC5B4\uC8FC\uACE0 \uC2F6\uC5B4...!\\c\\n\uADF8\uB7EC\uB2C8\uAE4C [VAR 0100(0000)]...\\n\uD568\uAED8 \uD798\uB0B4\uC790![VAR 0114(0005)]"
  },
  {
    "index": 30,
