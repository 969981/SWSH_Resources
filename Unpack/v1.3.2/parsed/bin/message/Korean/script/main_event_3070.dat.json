    "text": "\uC557! \uCC3E\uC558\uB2E4!\\n[VAR 0100(0000)]! \uD070\uC77C\uC774\uC57C![VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD130\uD504\uC758 \uAC00\uB77C\uB974\uD30C\uD2F0\uD074 \uBC18\uC751\uC774\\n\uC548\uC815\uB418\uB294\uAC00 \uC2F6\uC5C8\uB354\uB2C8...[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D0\uB294 \uBC14\uC6B0\uC2A4\uD0C0\uB514\uC6C0\uACFC\\n\uC5D4\uC9C4\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\\c\\n\uB9C9\uB300\uD55C \uC591\uC758 \uAC00\uB77C\uB974\uD30C\uD2F0\uD074\uC774\\n\uAD00\uCE21\uB410\uC5B4![VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uD130\uD504\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\uB294\\n\uACB0\uAD6D \uBB34\uC2A8 \uC77C\uC774 \uC788\uB358 \uAC70\uC57C?[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC788\uB294 \uADF8\uB300\uB85C \uC124\uBA85\uD55C\uB2E4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uACFC\uC7A5\uD574\uC11C \uC124\uBA85\uD55C\uB2E4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBB50\uC5B4~!? \uB2E4\uC774\uB9E5\uC2A4\uD55C\\n\uD3EC\uCF13\uBAAC\uC774 \uB0A0\uB6F0\uC5C8\uB2E4\uACE0!?[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBB50\uC5B4~!? \uB2E4\uC774\uB9E5\uC2A4\uD55C\\n\uD3EC\uCF13\uBAAC \uB54C\uBB38\uC5D0\\r\\n\uC2A4\uD0C0\uB514\uC6C0\uC774 \uC0B0\uC0B0\uC870\uAC01 \uB0AC\uB2E4\uACE0!?[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "...\uC7A0\uAE50\\n\uC800\uAE30 \uBA40\uCA61\uD788 \uC788\uC796\uC544 \uD130\uD504\uC2A4\uD0C0\uB514\uC6C0[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBB50? \uC774\uBC88 \uC77C\uC774 \uC2E4\uC18C\uCF64\uBE44\uAC00\\n\uD55C \uC9D3\uC774\uB77C\uACE0!?[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC557! \uC18C\uB2C8\uC544 \uB204\uB098![VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC751? \uD638\uBE0C...\\n\uADF8\uB9AC\uACE0 \uB450\uC1A1\uB2D8\uAE4C\uC9C0!?[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5B4\uC9F8\uC11C \uD130\uD504\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C \uB098\uC624\uB294 \uAC70\uC608\uC694?\\n\uC5EC\uAE34 \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC774 \uC544\uB2C8\uC5D0\uC694[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC800\uB294 \uC774\uC81C \uC804\uC9C1 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uB2C8\uAE4C\\n\uC5B4\uB514\uC5D0 \uC788\uC5B4\uB3C4 \uC774\uC0C1\uD560 \uAC74 \uC5C6\uC8E0[VAR 0114(0016)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uADF8\uBCF4\uB2E4\uB3C4 \uB2E4\uB978 \uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC774 \uB0A0\uB6F0\uACE0 \uC788\uB2E4\uACE0 \uD588\uC2B5\uB2C8\uAE4C?[VAR 0114(0016)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB124, \uD130\uD504\uC2A4\uD0C0\uB514\uC6C0\uACFC \uAC19\uC740 \uBC18\uC751\uC774\\n\uB2E4\uB978 \uB9C8\uC744\uC5D0\uC11C\uB3C4 \uAD00\uCE21\uB418\uACE0 \uC788\uC5B4\uC694...![VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB9C8\uB9AC\uAC00 \uAC71\uC815\uB418\uB294\uAD70...![VAR 0114(0016)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC544 \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC740\\n\uAD1C\uCC2E\uC740 \uBAA8\uC591\uC774\uC5D0\uC694\\c\\n\uBC18\uC751\uC744 \uBCF4\uC774\uB294 \uAC74 \uBC14\uC6B0\uC2A4\uD0C0\uB514\uC6C0\uACFC\\n\uC5D4\uC9C4\uC2A4\uD0C0\uB514\uC6C0\uBFD0\uC774\uC5D0\uC694[VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "...\uADF8\uB807\uAD70\uC694[VAR 0114(0016)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 \uC81C\uBA4B\uB300\uB85C\\n\uB2E4\uC774\uB9E5\uC2A4\uC2DC\uD0A4\uB2E4\uB2C8\\r\\n\uC774\uB300\uB85C \uAC00\uB9CC\uD788 \uB0B4\uBC84\uB824 \uB458 \uC218 \uC5C6\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB3C4\\n\uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC9C0!?[VAR 0114(0005)]"
