[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB098\uB294 \uBCFC\uAC00\uC774\uC57C\uBCFC!\\n\uB0B4 \uB9D8\uB300\uB85C \uBAA8\uB450\uB97C \uC751\uC6D0\uD558\uACE0 \uC788\uBCFC!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC640\uC544! \uBCFC! \uBCFC! \uBCFC\uAC00\uC774\uB2E4!\\n\uC548\uC5D0 \uB204\uAC00 \uB4E4\uC5B4\uAC00 \uC788\uB294 \uAC78\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC640~\\n\uBAAC\uC2A4\uD130\uBCFC \uC720\uB839\uC774\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218\uB294\\n\uBC38\uB7F0\uC2A4\uB294 \uC88B\uC740\uB370 \uBC18\uB300\uB85C\\r\\n\uACB0\uC815\uB825\uC774 \uBD80\uC871\uD55C \uB290\uB08C?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218!\\n\uC774\uB984\uC744 \uC678\uC6E0\uC5B4!\\r\\n\uACB0\uC815\uC801\uC778 \uD55C \uBC29\uC774 \uC788\uB294 \uC120\uC218\uC57C!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D0\uB3C4 \uCC54\uD53C\uC5B8\uC774\\n\uC5F0\uC2B9 \uAE30\uB85D\uC744 \uACBD\uC2E0\uD558\uACA0\uC9C0?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC774 \uC9C0\uACE0\\n\uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC774 \uD0C4\uC0DD\uD558\uB294\\r\\n\uC5ED\uC0AC\uAC00 \uBC14\uB00C\uB294 \uC21C\uAC04\uC774\uC5C8\uC5B4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218!\\n\uD1A0\uB108\uBA3C\uD2B8\uB294 \uC2DC\uC791\uC5D0 \uBD88\uACFC\uD574!\\r\\n\uAF2D \uC774\uACA8\uC11C \uC62C\uB77C\uAC00\uC57C \uB3FC!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uCEF5 \uCD9C\uC804!\\c\\n\uAD49\uC7A5\uD574! \uAC00\uB77C\uB974\uC5D0 \uC788\uB294 \uBAA8\uB450\uAC00\\n\uC8FC\uBAA9\uD558\uB294 \uAD49\uC7A5\uD788 \uAC15\uD55C\\r\\n\uC120\uC218\uAC00 \uB418\uC5C8\uAD6C\uB098 [VAR 0100(0000)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4! \uACB0\uC2B9\uC804!\\c\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC774\uC0C1 \uC774\uAE30\uB294 \uAC70\uC57C!\\n\uC774\uAE38 \uC218\uBC16\uC5D0 \uC5C6\uC5B4 [VAR 0100(0000)]!\\c\\n\uBB34\uC801\uC758 \uB2E8\uB378\uC744 \uC4F0\uB7EC\uB728\uB9AC\uACE0\\n\uC0C8\uB85C\uC6B4 \uC2DC\uB300\uB97C \uC5F4\uC5B4\uC918!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB808\uC774\uD2B8 \uCC54\uD53C\uC5B8\\n[VAR 0100(0000)]!\\c\\n\uCC54\uD53C\uC5B8\uC774 \uB41C \uADF8\uC758 \uC7AC\uB2A5\uC744\\n\uC77C\uCC0D\uC774 \uC54C\uC544\uBCF8 \uB098\uB294\\r\\n\uC774 \uC7AC\uB2A5\uC744 \uC0B4\uB824\\r\\n\uB9CE\uC740 \uD2B8\uB808\uC774\uB108\uB4E4\uC744 \uC721\uC131\uD558\uAC8C \uB418\uB294\uB370...\\c\\n\uB0B4 \uAFC8\uC774 \uC5B4\uB54C?\\n\uC544\uBB34\uD2BC \uC815\uB9D0 \uCD95\uD558\uD574! \uB108\uBB34 \uAE30\uBED0!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBE44\uBC14\uBC14\uADF8!!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC800, \uC800\uAE30...\\n\uC545\uC218\uD574 \uC8FC\uC138\uC694"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uB798 \uC88B\uC544!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uACE0, \uACE0\uB9D9\uC2B5\uB2C8\uB2E4!\\n\uC545\uC218\uD55C \uC190\uC740 \uC808\uB300\uB85C \uC548 \uC53B\uC744 \uAC70\uC608\uC694!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218\uB294\\n\uC800\uC758 \uB864 \uBAA8\uB378\uC774\uC5D0\uC694!\\r\\n\uC5B8\uC820\uAC00 \uB2F9\uC2E0\uCC98\uB7FC \uAC15\uD574\uC9C8 \uAC70\uC608\uC694!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC800 \uB140\uC11D\uC774 \uB0A8\uC558\uB098 \uBD10"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB204\uAC00 \uC774\uAE38\uAE4C?"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB204\uAC00 \uC774\uAE38\uC9C0\\n\uC804\uD600 \uBAA8\uB974\uACA0\uC5B4"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC624! [VAR 0100(0000)]!\\n\uBA4B\uC788\uC5B4!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218\uB2E4"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC798 \uC2F8\uC6CC!\\n\uD6C4\uD68C\uB97C \uB0A8\uAE30\uC9C0 \uB9C8!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC804 \uC138\uACC4\uAC00 \uC9C0\uCF1C\uBCF4\uB294\\n\uACB0\uC2B9\uC804!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8!\\n\uAC10\uB3D9\uBC1B\uC558\uC5B4!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uAE84\uC544!\\n[VAR 0100(0000)]!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uD30C\uC774\uD305!\\n[VAR 0100(0000)]!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uD798\uB0B4~!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB2E8\uB378\uC744 \uC774\uACA8!\\n\uC5B4\uCC0C \uB410\uB4E0 \uC774\uAE30\uB294 \uAC70\uC57C!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "[VAR 0100(0000)]!!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8! \uB354 \uD070 \uD65C\uC57D\uC73C\uB85C\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC744 \uD658\uD638\uD558\uAC8C \uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0\uC758 \uBE44\uC0C1\uC0AC\uD0DC\uAC00\\n\uD574\uACB0\uB418\uAE30 \uC804\uAE4C\uC9C4... \uC544\uBB34\uAC83\uB3C4 \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4"
  }
]
