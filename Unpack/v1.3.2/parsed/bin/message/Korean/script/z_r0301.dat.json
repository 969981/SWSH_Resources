    "index": 0,
    "flags": 0,
    "text": "\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB97C \uC774\uC6A9\uD558\uBA74\\n\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0 \uAC00\uB294 \uAC83\uB3C4 \uD3B8\uD574"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uCEA0\uD504\uC5D0\uC11C \uC694\uB9AC\uB97C \uB9CC\uB4E4\uC5B4\uC11C\\n\uD3EC\uCF13\uBAAC\uC744 \uAC74\uAC15\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uBCF4\uB834!\\c\\n\uC694\uB9AC\uB97C \uB9CC\uB4E4 \uB54C\\n\uC774 \uB098\uBB34\uC5F4\uB9E4\uB97C \uC0AC\uC6A9\uD574\uC918"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD150\uD2B8\uB97C \uC870\uC0AC\uD558\uBA74 \uB2E4\uB978 \uC0AC\uB78C\uC758\\n\uCEA0\uD504\uC5D0 \uCC38\uAC00\uD560 \uC218 \uC788\uC5B4\\c\\n\uC2DC\uAC04 \uC788\uC73C\uBA74 \uC606\uC5D0 \uC788\uB294\\n\uB0B4 \uD150\uD2B8\uC5D0\uB3C4 \uB4E4\uC5B4\uAC00 \uBCF4\uB834!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC18C\uC911\uD55C \uD3EC\uCF13\uBAAC\uC758\\nHP\uAC00 \uC904\uC5C8\uB2E4\uBA74 \uC0C1\uCC98\uC57D!\\r\\n\uB3C5\uC774 \uD37C\uC84C\uB2E4\uBA74 \uD574\uB3C5\uC81C!\\c\\n\uB3C4\uAD6C\uB97C \uC0AC\uB450\uBA74 \uC548\uC2EC\uC774 \uB3FC!\\n\uD3EC\uCF13\uBAAC\uC13C\uD130\uB85C \uB3CC\uC544\uAC00\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB2C8\uAE4C!"
  }
]
