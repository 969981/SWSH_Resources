[
  {
    "index": 0,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8!\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC77C \uAC81\uB2C8\uAE4C!?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC778\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC124\uBA85\uC744 \uB4E3\uB294\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB2E4\uC774\uC218\uD504\uC5D0 \uB300\uD574\\n\uC5B4\uB5A4 \uAC78 \uC124\uBA85\uD574\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8 \uBC16\uC5D0 \uAD81\uAE08\uD55C \uAC74\\n\uC5C6\uC73C\uC2E0\uAC00\uC694?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB2E4\uC774\uC218\uD504\uC758 \uD6A8\uACFC"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBA39\uC744 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB3CC\uC544\uAC04\uB2E4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uB290 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uBA39\uC77C \uAC81\uB2C8\uAE4C?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAC00\uB2A5\uC131\uC744 \uC9C0\uB2CC\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uBA39\uC774\uBA74\\c\\n\uD2B9\uBCC4\uD55C \uB2E4\uC774\uB9E5\uC2A4...\\n\uAC70\uB2E4\uC774\uB9E5\uC2A4\uAC00 \uB429\uB2C8\uB2E4!\\c\\n\uC774\uBBF8 \uAC70\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC774 \uBA39\uC73C\uBA74\\c\\n\uBC18\uB300\uB85C \uC77C\uBC18 \uB2E4\uC774\uB9E5\uC2A4\uB85C\\n\uB3CC\uC544\uAC04\uB2E4\uACE0 \uD569\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uC758 \uAC00\uB2A5\uC131\uC744 \uC9C0\uB2CC\\n\uD3EC\uCF13\uBAAC\uB4E4...\\c\\n\uC8C4\uC1A1\uD558\uC9C0\uB9CC \uC790\uC138\uD55C \uAC74\\n\uBD80\uC5CC \uC120\uBC18\uC5D0 \uC788\uB294 \uCC45\uC744 \uC77D\uC5B4\uBCF4\uC138\uC694"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0101(0001)][VAR 1900(0003)] \uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC73C\uBA74\\n\uAC70\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0101(0001)][VAR 1900(0003)] \uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC73C\uBA74\\n\uC77C\uBC18 \uB2E4\uC774\uB9E5\uC2A4\uB85C \uB3CC\uC544\uAC08 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB2E4\uC774\uBC84\uC12F 3\uAC1C\uB97C \uC0AC\uC6A9\uD574\uC11C\\n\uB2E4\uC774\uC218\uD504\uB97C \uB9CC\uB4E4\uAE4C\uC694!?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB2E4\uC774\uBC84\uC12F 3\uAC1C\uC640 \uB2E4\uC774\uAFC0 1\uAC1C\uB85C\\n\uB2E4\uC774\uC218\uD504\uB97C \uB9CC\uB4E4\uAE4C\uC694!?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC88B\uC544\uC694!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uADF8\uB9CC\uB450\uC2DC\uB294 \uAC74\uAC00\uC694?\\n\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uB9D0\uC500\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB2E4\uC774\uC218\uD504\uB97C \uB9CC\uB4E4\uB824\uBA74\\n\uB2E4\uC774\uBC84\uC12F 3\uAC1C\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4!\\c\\n\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uC5D0\uC11C \uBC30\uD2C0\uD558\uBA74\\n\uB2E4\uC774\uB9E5\uC2A4\uC758 \uC785\uC790\uAC00 \uD37C\uC838\uC11C\\c\\n\uAC11\uC637\uC12C\uC758 \uC232\uC774\uB098 \uB3D9\uAD74\uC5D0\\n\uC464\uC6B1 \uD558\uACE0 \uB2E4\uC774\uBC84\uC12F\uC774 \uC790\uB77C\uAC8C \uB429\uB2C8\uB2E4!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBCA0\uC544\uC774\uC544!!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC6B0\uB77C\uC624\uC2A4\uB294 \uB2E4\uC774\uC218\uD504\uC758 \uB9DB\uC744\\n\uC2EB\uC5B4\uD558\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4...\\c\\n\uAC70\uB2E4\uC774\uB9E5\uC2A4\uC758 \uAC00\uB2A5\uC131\uC740\\n\uC9C0\uB2C8\uACE0 \uC788\uB294\uB370... \uC5B4\uC9F8\uC11C\uC77C\uAE4C\uC694?"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC6B0\uB77C\uC624\uC2A4\uB294 \uB2E4\uC774\uAFC0\uC774 \uB4E4\uC5B4 \uC788\uC9C0 \uC54A\uC740\\n\uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC9C0 \uBABB\uD569\uB2C8\uB2E4!\\c\\n\uB2E4\uC774\uBC84\uC12F 3\uAC1C\uC640\\n\uB2E4\uC774\uAFC0 1\uAC1C\uB97C \uC900\uBE44\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB2E4\uC774\uC218\uD504\uB294 \uD55C \uBA85\uB2F9\\n\uD558\uB8E8\uC5D0 \uD55C \uBC88\uB9CC \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\\r\\n\uC0AC\uBAA8\uB2D8\uACFC \uC57D\uC18D\uD588\uAC70\uB4E0\uC694!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "[VAR 0102(0001)][VAR 1900(0001)]\\n\uAC70\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "[VAR 0102(0001)][VAR 1900(0001)]\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uC758 \uAC00\uB2A5\uC131\uC744 \uC9C0\uB2CC\\n\uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC744 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC774\uC0C1\uD574\uAF43, \uB9AC\uC790\uBABD, \uAC70\uBD81\uC655\\n\uACE0\uB9B4\uD0C0, \uC5D0\uC774\uC2A4\uBC88, \uC778\uD154\uB9AC\uB808\uC628\\n\uBC84\uD130\uD50C, \uD53C\uCE74\uCE04, \uB098\uC639\\n\uAD34\uB825\uBAAC, \uD32C\uD140, \uB77C\uD504\uB77C\uC2A4\\n\uC774\uBE0C\uC774, \uC7A0\uB9CC\uBCF4, \uB354\uC2A4\uD2B8\uB098"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uAC08\uAC00\uBD80\uAE30, \uC544\uBA38\uAE4C\uC624, \uC2A4\uD2B8\uB9B0\uB354\\n\uB9C8\uD718\uD551, \uB450\uB784\uB8E8\uB3C8, \uC774\uC62C\uBE0C\\n\uC11D\uD0C4\uC0B0, \uC0AC\uB2E4\uC774\uC0AC, \uC624\uB871\uD138\\n\uC560\uD504\uB8E1, \uB2E8\uC9C0\uB798\uD50C, \uBE0C\uB9AC\uBB34\uC74C\\n\uB300\uC655\uB07C\uB9AC\uB3D9, \uD0B9\uD06C\uB7A9, \uB2E4\uD0DC\uC6B0\uC9C0\uB124"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB9C8\uC9C0\uB9C9\uC73C\uB85C\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5 \uBE44\uC804\uC758...\\n\\n\\n...\uCC45\uC774 \uC544\uC9C1 \uC644\uC131\uB418\uC9C0 \uC54A\uC740 \uBAA8\uC591\uC774\uB2E4!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB9C8\uC9C0\uB9C9\uC73C\uB85C\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5 \uBE44\uC804\uC758 \uD3EC\uCF13\uBAAC \uC6B0\uB77C\uC624\uC2A4!\\n\\n\\n...\uC774\uC0C1!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC694\uB9AC\uCC45\uC774 \uB098\uC5F4\uB418\uC5B4 \uC788\uB2E4!"
  }
]
