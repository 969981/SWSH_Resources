    "text": "\uC7A0\uAE50![VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB204\uAD6C\uC9C0?[VAR 0114(006B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5EC\uB7EC\uBD84 \uC81C \uC598\uAE30\uB97C \uB4E4\uC5B4\uC8FC\uC138\uC694\\n\uC800\uB97C \uAE30\uC5B5\uD558\uC2DC\uB294\uC9C0\uC694\\c\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\uC11C\\n\uC5B5\uC6B8\uD558\uAC8C \uC2E4\uACA9\uB2F9\uD55C \uBE44\uD2B8\uC785\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBE44\uD2B8\uB2E4! \uB85C\uC988 \uC704\uC6D0\uC7A5\uC774\\n\uCD94\uCC9C\uD588\uB358 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2E4![VAR 0114(006B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218\uC640\uB294\\n\uD480\uC5B4\uC57C \uD560 \uB9E4\uB4ED\uC774 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uADDC\uC815 \uC704\uBC18\uC778 \uAC83\uC740 \uC798 \uC555\uB2C8\uB2E4\uB9CC\\n\uC774\uB97C \uBB34\uB985\uC4F0\uACE0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\\c\\n\uC81C \uC120\uC218 \uC0DD\uBA85\uC744 \uAC78\uACE0\\n\uC2B9\uBD80\uD558\uAC8C \uD574\uC8FC\uC2ED\uC2DC\uC624!\\r\\n\uC81C\uAC00 \uC9C4\uB2E4\uBA74 \uD2B8\uB808\uC774\uB108\uB97C \uC740\uD1F4\uD558\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC138\uC0C1\uC5D0 \uC774\uB7F0 \uC77C\uC774!\\c\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC600\uB358\\n\uBE44\uD2B8 \uC120\uC218\uAC00 \uB09C\uC785\uD588\uC2B5\uB2C8\uB2E4![VAR 0114(0018)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBE44\uD2B8 \uC120\uC218\uC5D0 \uB300\uD574\\n\uC2EC\uC758 \uC911\uC785\uB2C8\uB2E4\\c\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uACC4\uC2E0 \uC5EC\uB7EC\uBD84\\n\uADF8\uB9AC\uACE0 TV \uC55E\uC5D0 \uACC4\uC2E0 \uC5EC\uB7EC\uBD84\\r\\n\uC7A0\uC2DC \uAE30\uB2E4\uB824\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4![VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5B5\uC9C0\uB77C\uB294 \uAC74\\n\uC800 \uC790\uC2E0\uC774 \uAC00\uC7A5 \uC798 \uC555\uB2C8\uB2E4\\c\\n\uD558\uC9C0\uB9CC \uBB50\uB77C\uB3C4 \uB9D0\uD574\uC57C...\\n\uBB50\uB77C\uB3C4 \uD574\uC57C \uD588\uC73C\uB2C8\uAE4C![VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB2F9\uC2E0 \uB54C\uBB38\uC5D0\\n\uBAA8\uB4E0 \uAC8C \uB2E4 \uC5C9\uB9DD\uC774\uC57C!\\c\\n\uC62C\uB9AC\uBE0C\uB2D8\uC758 \uBD80\uD0C1\uC744 \uBC1B\uC544\\n\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC744 \uC704\uD574\\r\\n\uC18C\uC6D0\uC758\uBCC4\uC744 \uBAA8\uC558\uC744 \uBFD0\uC778\uB370\\r\\n\uC704\uC6D0\uC7A5\uB2D8\uC5D0\uAC8C \uBC84\uB9BC\uBC1B\uC9C8 \uC54A\uB098[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC774\uC0C1\uD55C \uD560\uBA38\uB2C8\uC5D0\uAC8C \uB04C\uB824\uAC00\uC11C\uB294\\n\uD398\uC5B4\uB9AC\uD0C0\uC785\uC5D0 \uB300\uD574\\r\\n\uBC24\uB0AE\uC73C\uB85C \uC8FC\uC785\uB2F9\uD558\uC9C8 \uC54A\uB098!\\c\\n\uB2F9\uC2E0\uC774 \uC774\uD574\uD560 \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?\\n\uB9E4\uC77C\uAC19\uC774 \uD551\uD06C\uC0C9\uC5D0 \uB458\uB7EC\uC2F8\uC5EC\uC11C\\c\\n\uD398\uC5B4\uB9AC\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC73C\uB85C\\n\uD034\uC988\uC640 \uC2B9\uBD80\uB97C \uD574\uC57C \uD558\uB294 \uC81C \uCC98\uC9C0\uB97C![VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC544\uC544! \uC774\uB807\uAC8C \uD558\uB098\uD558\uB098\\n\uB9C8\uC74C\uC18D\uC744 \uD138\uC5B4\uB193\uB294 \uAC74\\r\\n\uB0B4 \uC131\uACA9\uC5D0 \uB9DE\uC9C0 \uC54A\uB294\uB370![VAR 0114(000C)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774\uB7F4 \uC218\uAC00! \uCC54\uD53C\uC5B8\uC774\\n\uB09C\uC785\uC744 \uC778\uC815\uD588\uC2B5\uB2C8\uB2E4!\\c\\n\uAC00\uB77C\uB974\uC758 \uD2B8\uB808\uC774\uB108\uB97C \uAC15\uD558\uAC8C \uB9CC\uB4E4\uACE0 \uC2F6\uB2E4\uB294\\n\uCC54\uD53C\uC5B8\uC758 \uBC14\uB78C \uB54C\uBB38\uC774\uC5C8\uC744\uAE4C\uC694?!\\c\\n\uC544\uB2C8\uBA74 [VAR 0100(0000)] \uC120\uC218\uC5D0\uAC8C \uB0B4\uB9AC\uB294\\n\uC2DC\uB828\uC778 \uAC83\uC77C\uAE4C\uC694!?[VAR 0114(0018)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC800\uC758 \uD558\uD2B8\uB294\\n\uC544\uC9C1 \uBD80\uC11C\uC9C0\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC84C\uB2E4...[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC624\uC624! [VAR 0100(0000)] \uC120\uC218\uC640\\n\uADF8\uC758 \uC790\uB791\uC2A4\uB7EC\uC6B4 \uD300 \uBA64\uBC84\uAC00\\c\\n\uBE44\uD2B8 \uC120\uC218\uC758\\n\uB3C4\uC804\uC5D0\uC11C \uC2B9\uB9AC\uD569\uB2C8\uB2E4![VAR 0114(0018)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC5B4\uC774! \uBE44\uD2B8 \uC120\uC218!\\n\uB098\uC058\uC9C0 \uC54A\uC740 \uC2DC\uD569\uC774\uC5C8\uC5B4![VAR 0114(006B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC740\uD1F4\uD558\uBA74\\n\uB2E4\uC2DC \uD55C\uBC88 \uB370\uBDD4\uD574\uBD10![VAR 0114(006B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC774\uAC8C \uBB34\uC2A8 \uC77C\uC774\uC9C0...\\c\\n\uB2F9\uC2E0\uC5D0\uAC8C \uBCF5\uC218\uB9CC \uD560 \uC218 \uC788\uC73C\uBA74 \uB410\uB294\uB370!\\c\\n\uC9C0\uB354\uB77C\uB3C4 \uC740\uD1F4\uD574\uC11C\\n\uD560\uBA38\uB2C8\uB85C\uBD80\uD130 \uBC97\uC5B4\uB0A0 \uC0DD\uAC01\uC774\uC5C8\uB294\uB370...[VAR 0114(000C)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB2F9\uC2E0\uC740 \uC81C \uC778\uC0DD\uC758 \uAC78\uB9BC\uB3CC\uC785\uB2C8\uB2E4!\\c\\n\uBAA8\uB450\uC5D0\uAC8C \uC778\uC815\uBC1B\uC558\uC73C\uB2C8\\n\uD398\uC5B4\uB9AC\uD0C0\uC785 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744\\r\\n\uACC4\uC18D\uD574\uC57C\uB9CC \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C![VAR 0114(000C)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uBB50 \uC800\uC758 \uC7AC\uB2A5\uC774\uB77C\uBA74\\n\uD3EC\uD50C\uB7EC\uB2D8 \uC815\uB3C4\uB294\\r\\n\uC21C\uC2DD\uAC04\uC5D0 \uB6F0\uC5B4\uB118\uC744 \uC218 \uC788\uC9C0\uB9CC \uB9D0\uC774\uC8E0[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC2A4\uD0C0\uB514\uC6C0\uC740 \uB450 \uC80A\uC740\uC774\uC5D0\uAC8C \uBCF4\uB0B4\uB294\\n\uD658\uD638\uC131\uC73C\uB85C \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4!\\c\\n\uC790 [VAR 0100(0000)] \uC120\uC218\\n\uC608\uC0C1 \uBC16\uC758 \uC2DC\uD569\uC5D0\uC11C \uC785\uC740 \uB370\uBBF8\uC9C0\uB97C\\r\\n\uD68C\uBCF5\uD558\uAE30 \uC704\uD574 \uB300\uAE30\uC2E4\uB85C \uAC00\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4[VAR 0114(0018)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBE44\uD2B8 \uC120\uC218\uAC00 \uB09C\uC785\uD574\uC11C\\n\uD070\uC77C\uC774\uC168\uACA0\uB124\uC694\\c\\n\uC900\uBE44\uB97C \uB9C8\uCE58\uC168\uB2E4\uBA74\\n\uCF54\uD2B8\uB85C \uAC00\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4\\r\\n\uB4DC\uB514\uC5B4 \uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\uC785\uB2C8\uB2E4!"
  }
]
