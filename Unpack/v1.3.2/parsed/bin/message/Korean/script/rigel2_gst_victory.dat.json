[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB3C4\uC7A5\uC5D0\uC11C\uB294 \uB2F9\uC2E0\uC774\\n\uB208\uC5E3\uAC00\uC2DC\uC600\uC2B5\uB2C8\uB2E4\uB9CC\\c\\n\uD568\uAED8 \uD1B1\uC5D0 \uAD70\uB9BC\uD558\uAC8C \uB41C \uC9C0\uAE08\uC740\\n\uB2F9\uC2E0\uC774 \uB9E4\uC6B0 \uC790\uB791\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4[VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC758 \uC2E4\uB825\uC5D0\\n\uC800\uC758 \uC5D0\uC2A4\uD37C \uD30C\uC6CC\uAC00 \uD569\uCCD0\uC9C4 \uC774\uC0C1\\c\\n\uB2E4\uB978 \uB204\uAD70\uAC00\uAC00 \uC774\uAE30\uB294 \uC77C \uB530\uC708\\n\uB9D0\uB3C4 \uC548 \uB418\uB294 \uC77C\uC774\uC8E0[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC544\uD558\uD558! \uCC98\uC74C\uC5D0\uB294\\n\uB124\uAC00 \uC815\uB9D0 \uBCC4\uB85C\uC600\uC9C0\uB9CC!\\c\\n\uD568\uAED8 \uC6B0\uC2B9\uD558\uAC8C \uB41C \uC9C0\uAE08\uC740\\n\uB108\uBB34\uB098\uB3C4 \uAE30\uBED0![VAR 0114(0071)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC2E0\uB09C\uB2E4! \uC6B0\uB9AC\uAC00 \uD574\uB0C8\uC5B4~!\\n\uB300\uBC15 \uAE30\uBED0~!\\c\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uC788\uB294 \uBAA8\uB450\\n\uD2C0\uB9BC\uC5C6\uC774 \uC6B0\uB9AC\uC5D0\uAC8C\\r\\n\uC911\uB3C5\uB410\uC744 \uAC70\uC57C![VAR 0114(0071)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC624\uC608~! [VAR 0100(0000)]!\\n\uC6B0\uB9AC\uC758 \uC2B9\uB9AC\uB85C\uAD6C\uB098!\\c\\n\uC778\uC0DD\uC740 \uC990\uAE30\uB294 \uC790\uAC00 \uC6B0\uC2B9!\\n\uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uC9C0\uC9C0 \uC54A\uB294 \uBC95\uC778 \uAC8C\uC57C![VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBA87 \uBC88\uC744 \uC6B0\uC2B9\uD574\uB3C4\\n\uAE30\uC05C \uC77C\uC740 \uAE30\uC05C \uC77C\uC774\uAD6C\uB098~\\c\\n\uB9CE\uC774 \uC774\uAE30\uBA74\\n\uBB38\uD558\uC0DD\uB3C4 \uB354 \uB298\uC5B4\uB098\uC9C0 \uC54A\uC744\uAE4C~?[VAR 0114(0073)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD53C\uC624\uB2C8 \uD0D0\uD5D8\uB300\uC758\\n\uD06C\uB098\uD070 \uC2B9\uB9AC\uB85C\uAD70!\\c\\n\uAC15\uD55C \uAE30\uC220\uC744 \uB9C8\uAD6C \uB0A0\uB9B4 \uC218 \uC788\uC5B4\uC11C\\n\uC815\uB9D0 \uAE30\uBD84 \uC88B\uC558\uB2E4\uACE0 \uB300\uC7A5![VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC624! \uB610 \uC774\uACA8\uBC84\uB838\uAD70!\\c\\n\uB098\uC640 \uB300\uC7A5\uC774 \uD798\uC744 \uD569\uCE58\uBA74\\n\uC815\uB9D0 \uAD49\uC7A5\uD558\uB2E4\uB2C8\uAE4C![VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC [VAR 0100(0000)]!\\n\uAC00\uC2B4 \uB6F0\uB294 \uB728\uAC70\uC6B4 \uC2B9\uBD80\uC600\uC5B4!\\c\\n\uB108\uC640 \uC6B0\uC2B9\uD560 \uC218 \uC788\uC5B4\uC11C\\n\uC815\uB9D0 \uC601\uAD11\uC774\uC57C![VAR 0114(0004)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0006)]\uC57C!\\c\\n\uC2F8\uC6B8\uC218\uB85D \uB354 \uAC15\uD574\uC9C0\uB294 \uB108\uB97C \uBCF4\uACE0\\n\uB098\uB3C4 \uC790\uADF9\uC744 \uBC1B\uACE0 \uC788\uC5B4!\\c\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uD2B8\uB808\uC774\uB108\uB4E4\uACFC \uD568\uAED8\\n\uB354 \uAC15\uD574\uC9C0\uB3C4\uB85D \uD558\uC790![VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uACFC \uB458\uC774 \uB9CC\uB4E0 \uACB0\uACFC\uB77C\uB294 \uAC8C\\n\uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC9C0\uB9CC\\r\\n\uC6B0\uC2B9\uC740 \uC6B0\uC2B9\uC774\uB2C8\uAE4C\uC694[VAR 0114(000C)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBB50, \uC800\uC640 \uD30C\uD2B8\uB108\uAC00 \uB418\uC5C8\uC73C\uB2C8\\n\uB2F9\uC5F0\uD55C \uACB0\uACFC\uC9C0\uB9CC\\r\\n\uCD95\uD558\uD569\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0100(0000)]! \uD574\uB0C8\uC5B4!\\n\uC6B0\uB9AC\uAC00 \uC6B0\uC2B9\uD588\uC5B4![VAR 0114(000D)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD574\uB0C8\uC5B4! \uBA87 \uBC88\uC774\uB4E0 \uC774\uAE38 \uAC70\uC57C!\\n\uCD5C\uAC15\uC758 \uCF64\uBE44\uB294 \uC774\uBBF8\\r\\n\uC6B0\uB9AC\uB85C \uC815\uD574\uC838 \uC788\uC73C\uB2C8\uAE4C![VAR 0114(000D)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5ED\uC2DC [VAR 0100(0000)]\uB2D8!\\n\uC6B0\uB9AC\uAC00 1\uB4F1\uC744 \uD574\uC11C\\r\\n\uD480\uD3EC\uCF13\uBAAC\uB4E4\uB3C4 \uAE30\uBED0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4![VAR 0114(000E)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uAC00 \uD574\uB0C8\uC5B4\uC694 [VAR 0100(0000)]\uB2D8!\\n\uC5ED\uC2DC \uCC54\uD53C\uC5B8\uC785\uB2C8\uB2E4!\\c\\n\uD56D\uC0C1 \uC606\uC5D0 \uC788\uC5B4 \uC8FC\uC2DC\uB2C8\\n\uB108\uBB34\uB098\uB3C4 \uB4E0\uB4E0\uD558\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uBAA8\uB450 \uB5A0\uB0B4\uB824\uAC00\uACE0\\n\uB0A8\uC740 \uAC74 \uC6B0\uB9AC\uBFD0...\\c\\n\uC6B0\uC2B9 \uCD95\uD558\uD574 [VAR 0100(0000)]\\n\uADF8\uB9AC\uACE0 \uACE0\uB9C8\uC6CC[VAR 0114(000F)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uBA87 \uBC88\uC774\uB4E0\\n\uB808\uC774\uC9D5 \uC6E8\uC774\uBE0C!\\c\\n\uB108\uC640 \uD568\uAED8\uB77C\uBA74\\n\uB118\uC9C0 \uBABB\uD560 \uD30C\uB3C4\uB294 \uC5C6\uC744 \uAC83 \uAC19\uC544[VAR 0114(000F)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)], \uC218\uACE0\uD588\uB2E4!\\n\uC774 \uC2B9\uB9AC\uB294 \uC6B0\uB9AC \uB458\uC774 \uD568\uAED8 \uC7C1\uCDE8\uD55C \uAC70\uB780\uB2E4!\\c\\n\uAE30\uC05C \uB098\uBA38\uC9C0 \uB2E4 \uD0C0\uBC84\uB9B4 \uAC83 \uAC19\uC9C0\uB9CC\\n\uB2E4\uC74C \uC2DC\uD569\uB3C4 \uC5F4\uC2EC\uD788 \uD558\uB9C8![VAR 0114(0010)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D0\uB3C4 \uD65C\uD65C \uD0C0\uC624\uB974\uB294\\n\uB728\uAC70\uC6B4 \uC2B9\uBD80\uC9C0 \uC54A\uC558\uB2C8!?\\c\\n[VAR 0100(0000)]!\\n\uC774\uBC88\uC5D0\uB3C4 \uB098\uC640 \uD55C \uD300\uC774 \uB418\uC5B4\uC918\uC11C \uACE0\uB9D9\uB2E4![VAR 0114(0010)]"
