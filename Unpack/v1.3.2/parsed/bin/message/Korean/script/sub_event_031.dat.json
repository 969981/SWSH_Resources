[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC73C\uC544\uC544\uC544...\\c\\n\uBC30\uB2EC \uC544\uB974\uBC14\uC774\uD2B8\uB97C \uD558\uB294 \uC9C1\uC6D0\uC774\\n\uAC10\uAE30 \uB54C\uBB38\uC5D0 \uBABB \uB098\uC624\uAC8C \uB410\uC5B4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB108\uB294 \uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uACFC\\n\uAC19\uC774 \uC2DD\uC0AC\uD588\uB358 \uC544\uC774\uC9C0?\\c\\n\uAD1C\uCC2E\uB2E4\uBA74 \uC694\uB9AC \uBC30\uB2EC\uC744\\n\uBD80\uD0C1\uD574\uB3C4 \uB420\uAE4C...?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB798...\\n\uC774\uC0C1\uD55C \uBD80\uD0C1\uC744 \uD574\uC11C \uBBF8\uC548\uD574"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!\\n\uB355\uBD84\uC5D0 \uC0B4\uC558\uC5B4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC694\uB9AC\uB97C \uBC30\uB2EC\uD560\\n\uC8FC\uC18C \uB9D0\uC778\uB370...\\c\\n\uC8FC\uC18C\uB97C \uBB3C\uC5B4\uBCF4\uB294 \uAC78\\n\uAE5C\uBE61\uD588\uC9C0 \uBB50\uC57C"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC218\uD654\uAE30\uC5D0\uC11C \uB35C\uCEF9\uB35C\uCEF9\uD558\uB294\\n\uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uAE34 \uD588\uB294\uB370...\\r\\n\uC5B4\uB514\uC778\uC9C0 \uC54C\uACA0\uB2C8?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBC30\uB2EC\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC!\\n\uC5BC\uB9C8 \uC548 \uB418\uC9C0\uB9CC \uC2EC\uBD80\uB984 \uAC12\uC774\uC57C"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uBD80\uD0C1\uD560\uAC8C!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC624 \uB108\uAD6C\uB098!\\c\\n\uB610 \uC694\uB9AC \uBC30\uB2EC\uC744\\n\uBD80\uD0C1\uD558\uACE0 \uC2F6\uC740\uB370 \uAD1C\uCC2E\uACA0\uB2C8?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC218\uD654\uAE30\uC5D0\uC11C \uC774\uB7F0\\n\uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uC5C8\uB294\uB370\\r\\n\uC5B4\uB514\uC778\uC9C0 \uC54C\uACA0\uB2C8?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB179\uC0C9 \uC9C0\uBD95\uC744 \uBCF4\uACE0\\n\uCC3E\uC544\uC624\uB77C\uACE0 \uD588\uB294\uB370\\c\\n\uADF8\uB7F0 \uC9D1\uC774\\n\uBC14\uC6B0\uB9C8\uC744\uC5D0 \uC788\uB358\uAC00?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBC30\uB2EC\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC!\\n\uB124\uAC00 \uC774\uAC83\uC800\uAC83 \uB3C4\uC640\uC900 \uB355\uBD84\uC5D0\\r\\n\uB9CE\uC774 \uB3C4\uC6C0\uC774 \uB410\uC5B4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774\uAC74 \uB0B4 \uAC10\uC0AC\uC758 \uB9C8\uC74C\uC774\uC57C\\n\uC0AC\uC591\uD558\uC9C0 \uB9D0\uACE0 \uBC1B\uC544\uC918"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uC138\uC694!\\c\\n...\uC624 \uB108\uAD6C\uB098!\\n\uCC9C\uCC9C\uD788 \uC788\uB2E4 \uAC00\uB834"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC624! \uC694\uB9AC\uB97C \uAC16\uB2E4\uC8FC\uB7EC \uC628 \uAC70\uC57C?\\n\uC815\uB9D0 \uACE0\uB9C8\uC6CC~!\\c\\n\uC774 \uAC00\uAC8C \uC694\uB9AC\uB294 \uD574\uC0B0\uBB3C\uC774\\n\uB4EC~\uBFCD \uB4E4\uC5B4\uAC00\uC11C \uB9DB\uC788\uAC70\uB4E0!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB3C8\uC740 \uC774\uBBF8 \uAC00\uAC8C\uC5D0 \uB0C8\uC73C\uB2C8\uAE4C\\n\uB108\uC5D0\uAC8C\uB294 \uC0AC\uD0D5\uC744 \uC904\uAC8C"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uAF64 \uC5B4\uB824 \uBCF4\uC774\uB294\uB370\\n\uC544\uB974\uBC14\uC774\uD2B8\uB97C \uD558\uB294\uAD6C\uB098!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD6C4~! \uBC30\uACE0\uD504\uB2E4!\\c\\n\uC5B4\uB77C? \uC774 \uC775\uC219\uD55C \uBC14\uB2E4\uC758 \uD5A5\uAE30\uB294...\\n\uB808\uC2A4\uD1A0\uB791\uC5D0\uC11C \uBC30\uB2EC\uD558\uB7EC \uC628 \uAC70\uB2C8!?\\c\\n\uAD70\uCE68\uC744 \uD758\uB9AC\uBA74\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4\uACE0!\\n\uADF8\uB7FC \uC218\uACE0\uD558\uB834!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uD558\uB8E8\uC758 \uD65C\uB825\uC740\\n\uBA39\uB294 \uAC83\uC5D0\uC11C \uB098\uC624\uC9C0!\\r\\n\uB108\uB3C4 \uBC25\uC744 \uC798 \uCC59\uACA8 \uBA39\uC73C\uB834"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC694\uB9AC\uB97C \uBC30\uB2EC\uD558\uB7EC \uC654\uB2C8?\\n\uB0B4\uAC00 \uC8FC\uBB38\uD588\uC5B4!\\c\\n\uC774 \uAC00\uAC8C\uC758 \uAF2C\uB9AC \uCE74\uB808\uB294\\n\uC911\uB3C5\uC131\uC774 \uAC15\uD574\uC11C \uCD5C\uACE0\uAC70\uB4E0!\\r\\n\uADF8\uB7FC \uC810\uC7A5\uB2D8\uAED8 \uC548\uBD80 \uC804\uD574\uC8FC\uB834!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB179\uC0C9 \uC9C0\uBD95\uC774\uB77C\uACE0 \uB9D0\uD574\uC11C\\n\uCC3E\uAE30 \uC26C\uC6E0\uC9C0?"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB0A0\uB984\uB0A0\uB984"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC8FC\uBB38\uBC1B\uC740 \uC694\uB9AC\uB97C\\n\uBC1B\uC558\uB2E4!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC8FC\uBB38\uBC1B\uC740 \uC694\uB9AC\uB97C\\n\uC804\uB2EC\uD588\uB2E4!"
  }
]
