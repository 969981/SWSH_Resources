  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uBE44\uB85D \uBC29\uC2DD\uC774 \uC880 \uC798\uBABB\uB418\uAE34 \uD588\uC9C0\uB9CC[VAR 0114(0073)]"
