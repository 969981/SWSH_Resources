    "text": "[VAR 0100(0000)]...[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uC5D0... \uB0B4\uAC00 \uC57D\uD558\uBA74\\n\uD615\uC774 \uBC14\uBCF4 \uCDE8\uAE09 \uB2F9\uD560 \uAC70\uB77C\uACE0 \uD55C \uB9D0\\r\\n\uC5B4\uB5BB\uAC8C \uD558\uBA74 \uC88B\uC744\uC9C0 \uBAA8\uB974\uACA0\uC5B4...[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBAA8\uB974\uACA0\uC9C0\uB9CC...\\n\uC5B4\uCA0C\uB4E0 \uB098\uB294 \uAC15\uD574\uC838\uC57C\uB9CC \uD574!\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uC774\uAC83\uC800\uAC83 \uC2DC\uB3C4\uD574\uBCFC \uAC70\uC57C!\\n\uB108\uC640\uC758 \uC2B9\uBD80\uB85C \uD655\uC778\uD558\uAC8C \uD574\uC918![VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC54C\uC558\uC5B4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC7A0\uAE50 \uAE30\uB2E4\uB824"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB77C\uC774\uBC8C\uC778 \uB108\uC640\\n\uC2F8\uC6CC\uBCF4\uBA74 \uBB54\uAC00 \uAE68\uB2EC\uC744 \uC218 \uC788\uC744 \uAC70\uC57C...\\c\\n\uC88B\uC544! \uADF8\uB7FC \uC2B9\uBD80\uD558\uC790!\\n\uAE30\uD569 \uB123\uACE0 \uAC04\uB2E4!![VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB77C\uC774\uBC8C\uC774 \uD480 \uC8FD\uC5B4 \uC788\uB294\uB370\\n\uB3C4\uC640\uC8FC\uC9C0 \uC54A\uC744 \uAC70\uC57C?[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD750\uC74C...\\c\\n\uD300 \uBA64\uBC84\uB3C4 \uBC14\uAFD4\uBCF4\uBA74\uC11C\\n\uB098\uC758 \uAC00\uB2A5\uC131\uC744 \uC2DC\uD5D8\uD574\uBCF8 \uAC74\uB370\\c\\n\uBB54\uAC00 \uB290\uB08C\uC774 \uD30D \uC624\uC9C8 \uC54A\uC544...\\n\uADF8\uB798\uC11C \uB0B4\uAC00 \uC57D\uD55C \uAC78\uAE4C...[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB0B4\uAC8C \uD615\uC740 \uBA4B\uC9C4 \uC874\uC7AC\uACE0\\n\uD2B8\uB808\uC774\uB108\uB85C\uC11C\uB3C4 \uB3D9\uACBD\uD558\uACE0 \uC788\uC5B4!\\c\\n\uC57D\uD55C \uB098 \uB54C\uBB38\uC5D0\\n\uD615\uC774 \uBC14\uBCF4 \uCDE8\uAE09\uBC1B\uB294 \uAC74 \uC2EB\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uC55E\uC73C\uB85C \uB354 \uB354\\n\uB354 \uB9CE\uC774 \uC2DC\uB3C4\uD560 \uAC70\uC57C!\\c\\n\uADF8\uB798\uC11C \uB098\uC758 \uC2E4\uB825\uC744 \uC81C\uB300\uB85C \uBC1C\uD718\uD560 \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uB4E4\uC744 \uCC3E\uC744 \uAC70\uC57C...![VAR 0114(0005)]"
  }
]
