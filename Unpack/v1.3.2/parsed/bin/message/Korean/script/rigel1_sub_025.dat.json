    "index": 81,
    "flags": 0,
    "text": "\uD06D! \uBA38\uB9AC\uC5D0 \uBAA8\uB798\uAC00...!\\n\uAF3C\uAF3C\uD788 \uC53B\uC9C0 \uC54A\uC73C\uBA74\\r\\n\uBA70\uCE60 \uB3D9\uC548\uC740 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uC744 \uAC81\uB2C8\uB2E4...![VAR 0114(000C)]"
  },
  {
    "index": 82,
    "flags": 0,
    "text": "\uC544\uBB34\uB9AC \uCAD3\uC544\uAC00\uB3C4\\n\uC7A1\uC744 \uC218 \uC5C6\uB294 \uC774 \uC548\uAC1C...\\r\\n\uB9C8\uCE58 \uB2F9\uC2E0 \uAC19\uC544\uC11C \uAE30\uBD84\uC774 \uC88B\uC9C0 \uC54A\uB124\uC694[VAR 0114(000C)]"
  },
  {
    "index": 83,
    "flags": 0,
    "text": "\uD6C4~\uC6B0?"
  },
  {
    "index": 84,
    "flags": 0,
    "text": "\uC774\uB7F0 \uACF3\uC5D0\uC11C \uCC54\uD53C\uC5B8\uC744 \uB9CC\uB0A0 \uC904\uC774\uC57C\\n\uBCC4\uC77C\uC774 \uB2E4 \uC788\uB124\uC694[VAR 0114(0014)]"
  },
  {
    "index": 85,
    "flags": 0,
    "text": "\uC11D\uD0C4\uC0B0\uC758 \uD798\uC744 \uBAA8\uB450 \uB04C\uC5B4\uB0BC \uC218 \uC788\uB294\\n\uAE30\uBC1C\uD55C \uC6C0\uC9C1\uC784\uC744 \uC5F0\uAD6C \uC911\uC774\uB2C8\uAE4C\\c\\n\uB2E8\uB2E8\uD788 \uAC01\uC624\uD558\uACE0 \uAE30\uB2E4\uB9AC\uC2ED\uC1FC[VAR 0114(0014)]"
  },
  {
    "index": 86,
    "flags": 0,
    "text": "\uC9C0\uC778\uC5D0\uAC8C\uC11C\\n\uAC11\uC637\uD328\uC2A4\uB97C \uBC1B\uC558\uC2B5\uB2C8\uB2E4\\c\\n\uD3C9\uC18C\uC640 \uB2E4\uB978 \uC7A5\uC18C\uC5D0\uC11C\\n\uC721\uC131\uD558\uB294 \uAC83\uB3C4 \uAC00\uB054\uC740 \uC88B\uC740 \uAC83 \uAC19\uB124\uC694[VAR 0114(0014)]"
  },
  {
    "index": 87,
    "flags": 0,
    "text": "\uAF64 \uC2B5\uD574\uC11C\\n\uD479\uD479 \uCC0C\uB124\uC694\\c\\n\uC800\uD76C \uC5B4\uBA38\uB2C8\uAC00 \uACC4\uC168\uC73C\uBA74\\n\uBD88\uB9CC\uC744 \uC3DF\uC544\uB0B4\uC168\uC744 \uAC8C \uD2C0\uB9BC\uC5C6\uC2B5\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 88,
    "flags": 0,
    "text": "\uBA40\uB9AC\uAE4C\uC9C0 \uB0B4\uB2E4\uBCFC \uC218 \uC788\uACE0\\n\uC804\uB9DD\uC774 \uC88B\uB124\uC694\\c\\n\uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744\uAE4C\uC9C0\uB294\\n\uBCF4\uC774\uC9C0 \uC54A\uC9C0\uB9CC \uB9D0\uC774\uC8E0[VAR 0114(0014)]"
  },
  {
    "index": 89,
    "flags": 0,
    "text": "\uB3D9\uAD74\uC5D0 \uB4E4\uC5B4\uAC00\uBA74\\n\uC11D\uD0C4\uC0B0\uC774 \uAE30\uBED0\uD558\uB354\uAD70\uC694\\c\\n\uACE0\uD5A5\uC778 \uAC00\uB77C\uB974\uAD11\uC0B0\uC774\\n\uB5A0\uC62C\uB77C\uC11C \uADF8\uB7F0 \uAC78\uAE4C\uC694?[VAR 0114(0014)]"
  },
  {
    "index": 90,
    "flags": 0,
    "text": "\uBB3C\uC5D0 \uC57D\uD55C \uC11D\uD0C4\uC0B0\uC774\uC9C0\uB9CC\\n\uBB3C\uD0C0\uC785 \uACF5\uACA9\uC744 \uBC1B\uC73C\uBA74 \uC7AC\uBE68\uB77C\uC9C0\uB294\\r\\n\uD2B9\uC131\uC758 \uC18C\uC720\uC790\uC774\uAE30\uB3C4 \uD569\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 91,
    "flags": 0,
    "text": "\uC774\uB7F0, \uC11D\uD0C4\uC0B0\uC774\\n\uB118\uC5B4\uC9C8 \uC218\uB3C4 \uC788\uACA0\uC5B4\uC694\\c\\n\uC800\uBCF4\uB2E4 3\uBC30\uB294 \uBB34\uAC70\uC6B0\uB2C8\uAE4C\\n\uC870\uC2EC\uD558\uC138\uC694[VAR 0114(0014)]"
  },
  {
    "index": 92,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC758 \uB0AE\uC740\\n\uB540\uBC94\uBC85\uC774 \uB420 \uC815\uB3C4\uB85C \uB365\uB124\uC694\\c\\n\uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744\uC774\uC5C8\uB2E4\uBA74\\n\uC11D\uD0C4\uC0B0\uC774 \uB0B4\uB294 \uC5F4\uC774\\r\\n\uACE0\uB9C8\uC6E0\uC744 \uD150\uB370 \uB9D0\uC774\uC8E0...[VAR 0114(0014)]"
  },
  {
    "index": 93,
    "flags": 0,
    "text": "\uAD6C\uB984\uCE35\uC774 \uB450\uAEBC\uC6B4 \uAC78 \uBCF4\uB2C8...\\n\uBE44\uAC00 \uD55C\uBC14\uD0D5 \uC3DF\uC544\uC9C8 \uAC83 \uAC19\uB124\uC694\\c\\n...\uC544, \uC11D\uD0C4\uC0B0\uC758 \uC5F0\uAE30\uAC00\\n\uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 94,
    "flags": 0,
    "text": "\uB545\uC774 \uC9C8\uD37D\uAC70\uB824\uC11C\\n\uB118\uC5B4\uC9C8 \uBED4\uD588\uC2B5\uB2C8\uB2E4\uB9CC\\c\\n\uBC31 \uD140\uBE14\uB9C1 \uB3D9\uC791\uC73C\uB85C \uC5F0\uACB0\uD574\uC11C\\n\uBB34\uC0AC\uD788 \uCC29\uC9C0\uD588\uC2B5\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 95,
    "flags": 0,
    "text": "\uC774\uB7F0 \uBAA8\uB798\uBC14\uB78C \uC18D\uC5D0\uC11C\uB3C4\\n\uBB38\uC81C\uC5C6\uC774 \uAC78\uC744 \uC218 \uC788\uB2E4\uB294 \uAC8C\\r\\n\uC120\uAE00\uB77C\uC2A4\uC758 \uC7A5\uC810\uC774\uC8E0[VAR 0114(0014)]"
  },
  {
    "index": 96,
    "flags": 0,
    "text": "\uC120\uAE00\uB77C\uC2A4\uB97C \uC544\uBB34\uB9AC \uB2E6\uC544\uB3C4\\n\uAE08\uBC29 \uAE40\uC774 \uC11C\uB824\uC11C\\r\\n\uC544\uBB34\uAC83\uB3C4 \uC548 \uBCF4\uC785\uB2C8\uB2E4...\\c\\n\uC548\uAC1C\uAC00 \uAC77\uD790 \uB54C\uAE4C\uC9C0\\n\uD2B8\uB808\uC774\uB2DD\uC740 \uC911\uC9C0\uD574\uC57C\uACA0\uC5B4\uC694[VAR 0114(0014)]"
  },
  {
    "index": 97,
    "flags": 0,
    "text": "\uC288\uBCF4~"
  },
  {
    "index": 98,
    "flags": 0,
    "text": "\uC5B4\uBA38! \uC774\uB7F0 \uACF3\uC5D0\uC11C \uB9CC\uB0A0 \uC904\uC774\uC57C\\n\uBCC4\uC77C\uC774 \uB2E4 \uC788\uAD6C\uB098\\c\\n\uD639\uC2DC \uC774 \uBA5C\uB860\uB2D8\uC758\\n\uBE44\uBC00 \uD2B9\uD6C8\uC5D0 \uAD00\uC2EC\uC774 \uC788\uB294 \uAC70\uB2C8?[VAR 0114(0015)]"
  },
  {
