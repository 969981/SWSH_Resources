[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uB77C? [VAR 0100(0000)]\uB2D8!\\c\\n[VAR 0100(0000)]\uB2D8\uB3C4\\n\uAC11\uC637\uC12C\uC758 \uC790\uC5F0\uC744 \uB9CC\uB07D\uD558\uB7EC \uC624\uC2E0 \uAC74\uAC00\uC694?[VAR 0114(000E)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC800\uB3C4 \uAC00\uB054 \uC624\uACE4 \uD558\uB294\uB370\\n\uB290\uAE0B\uD558\uAC8C \uC9C0\uB0BC \uC218 \uC788\uC5B4\uC11C \uC88B\uC740 \uAC83 \uAC19\uC544\uC694[VAR 0114(000E)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC790\uC5F0\uC758 \uBAA8\uC2B5 \uADF8\uB300\uB85C\uAC00 \uC798 \uBCF4\uC874\uB41C\\n\uBA4B\uC9C4 \uC12C\uC774\uC9C0 \uC54A\uB098\uC694?\\r\\n\uB2EC\uCF54\uD038\uB3C4 \uAE30\uBD84\uC774 \uC88B\uC740 \uBAA8\uC591\uC774\uC5D0\uC694[VAR 0114(000E)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC232\uC774 \uC6B8\uCC3D\uD55C \uAC8C\\n\uC0BC\uB9BC\uC695 \uD558\uAE30 \uC88B\uC744 \uAC83 \uAC19\uB124\uC694\\r\\n\uB3C4\uC2DC\uB77D\uC744 \uCC59\uACA8\uC62C \uAC78 \uADF8\uB7AC\uC5B4\uC694[VAR 0114(000E)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC6B0\uB974\uB294 \uD479\uC2E0\uD479\uC2E0\uD55C \uD138\uB85C\\n\uB4A4\uB36E\uC5EC \uC788\uC5B4\uC11C\\c\\n\uC774\uB807\uAC8C \uB192\uC740 \uC808\uBCBD\uC5D0\uC11C \uB5A8\uC5B4\uC838\uB3C4\\n\uC544\uBB34\uB807\uC9C0\uB3C4 \uC54A\uC544\uC694[VAR 0114(000E)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC640\uC544! \uC640\uC544! \uC640\uC544! \uC640...!\\c\\n\uB3D9\uAD74 \uC548\uC740 \uC18C\uB9AC\uAC00 \uC6B8\uB824\uC11C\\n\uC800\uB3C4 \uBAA8\uB974\uAC8C \uC18C\uB9AC\uCE58\uAC8C \uB41C\uB2E8 \uB9D0\uC774\uC8E0[VAR 0114(000E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB4DC\uB113\uACE0\uB3C4 \uD478\uB978 \uBC14\uB2E4!\\n\uC57C\uCCAD\uB2D8\uC774 \uACC4\uC168\uB2E4\uBA74\\r\\n\uB0B4\uC2EC \uB4E4\uB5A0 \uD558\uC168\uC744 \uAC83 \uAC19\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD480\uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB294\\n\uAC00\uD639\uD55C \uD658\uACBD\uC774\uC9C0\uB9CC\\c\\n\uC774\uB7F0 \uACF3\uC5D0\uC11C\\n\uC2F9\uC744 \uD2D4\uC6B0\uB294 \uC2DD\uBB3C\uB3C4 \uC788\uB2F5\uB2C8\uB2E4[VAR 0114(000E)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD587\uC0B4\uC774 \uAC15\uD558\uBA74\\n\uC77C\uBD80 \uD480\uD3EC\uCF13\uBAAC\uC740 \uAE30\uC6B4\uC774 \uB118\uCE58\uAC8C \uB429\uB2C8\uB2E4!\\c\\n\uADF8\uB807\uC9C0\uB9CC, \uC57D\uC810\uC778 \uBD88\uAF43\uD3EC\uCF13\uBAAC\uB4E4\uAE4C\uC9C0\\n\uAC15\uD574\uC838 \uBC84\uB9B0\uB2E8 \uB9D0\uC774\uC8E0...[VAR 0114(000E)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC12C\uC758 \uB0A0\uC528\uB294 \uC218\uC2DC\uB85C \uBC14\uB00C\uB294 \uBC95!\\n\uAE08\uB791\uB2D8\uC758 \uC804\uBC95\uACFC \uBE44\uC2B7\uD574\uC11C\\r\\n\uC5B4\uCA50\uC9C0 \uAE34\uC7A5\uB418\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC740\uD61C\uB85C\uC6B4 \uBE44\uAC00 \uB0B4\uB9AC\uB124\uC694!\\n\uC774\uB807\uAC8C \uC12C\uC758 \uC2DD\uBB3C\uB4E4\uC5D0\uAC8C\\r\\n\uBB3C\uC774 \uC804\uD574\uC9C0\uACE0 \uC788\uB098 \uBCF4\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC81C \uBAA8\uC790\uB294 \uB18D\uC5C5\uC6A9\uC774\uC9C0\uB9CC\\n\uC774\uB7F0 \uB0A0\uC528\uC77C \uB54C\uB098\\r\\n\uC2DC\uD569\uC5D0\uC11C\uB3C4 \uC720\uC6A9\uD558\uAC8C \uC4F0\uC778\uB2F5\uB2C8\uB2E4[VAR 0114(000E)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774\uB7F0! [VAR 0100(0000)]\uB2D8!\\n\uC2DC\uC57C\uAC00 \uC88B\uC9C0 \uC54A\uC744 \uB54C \uB6F0\uC5B4\uB2E4\uB2C8\uBA74\\r\\n\uC800\uC640 \uBD80\uB52A\uD600\uC11C \uB0A0\uC544\uAC00 \uBC84\uB9B4 \uD14C\uB2C8 \uC870\uC2EC\uD558\uC138\uC694[VAR 0114(000E)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC0E4\uB77C\uB791~"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5B4\uBA38 \uCC54\uD53C\uC5B8\uC774\uAD6C\uB098\\n\uB098\uB97C \uBCF4\uB7EC \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC70\uC57C?[VAR 0114(000F)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD6C4\uD6C4, \uB18D\uB2F4\uC774\uC57C\\c\\n\uCCB4\uC721\uAD00 \uC77C\uB3C4 \uBAA8\uB378 \uC77C\uB3C4 \uC5C6\uC5B4\uC11C\\n\uAE30\uC220\uC744 \uC5F0\uB9C8\uD558\uACE0 \uC788\uC5C8\uC5B4[VAR 0114(000F)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB05D\uC5C6\uC774 \uD3BC\uCCD0\uC9C4 \uB300\uC790\uC5F0...\\n\uC544\uD0AC\uC774 \uC88B\uC544\uD560 \uAC83 \uAC19\uB124[VAR 0114(000F)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC774 \uC232\uC5D0\uC11C \uB4E3\uB294 \uBE57\uC18C\uB9AC\uB294\\n\uC815\uB9D0 \uAE30\uBD84 \uC88B\uC544\\c\\n\uC2DC\uD569\uC5D0\uC11C \uC84C\uC744 \uB54C\\n\uAE30\uBD84 \uC804\uD658\uC774 \uB418\uAE30\uB3C4 \uD574[VAR 0114(000F)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC120\uC120\uD55C \uBC14\uB78C\uC774 \uBD88\uC5B4\uC11C\\n\uAE30\uBD84\uC774 \uC88B\uB124\\c\\n\uC774\uB7F0 \uB0A0\uC5D0 \uAC08\uBAA8\uB9E4\uAC00\\n\uD3B8\uC9C0\uB97C \uC804\uD574\uC8FC\uBA74 \uBA4B\uC9C8 \uAC83 \uAC19\uC544[VAR 0114(000F)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC774 \uB3D9\uAD74\uC740 \uBC14\uB2E4\uC640 \uC774\uC5B4\uC838 \uC788\uC5B4\\c\\n\uC791\uC740 \uC12C\uB3C4 \uC788\uB294\uB370\\n\uAC70\uAE30\uB294 \uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uC7A5\uC18C\uC57C[VAR 0114(000F)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uAE30\uBD84\uC774 \uC808\uB85C \uC88B\uC544\uC9C0\uB294 \uBC14\uB2E4\uB124...\\n\uC800\uCABD\uC5D0 \uC788\uB294 \uC12C\uAE4C\uC9C0 \uD5E4\uC5C4\uCE58\uBA74\\r\\n\uBA87 \uCD08\uB098 \uAC78\uB9B4\uAE4C?[VAR 0114(000F)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uAC08\uAC00\uBD80\uAE30\uC640 \uD2B9\uD6C8 \uC911\uC774\uC57C\\n\uBC14\uC2F9 \uB9C8\uB978 \uC0AC\uB9C9\uC870\uCC28\uB3C4\\r\\n\uCD09\uCD09\uD558\uAC8C \uB9CC\uB4DC\uB294 \uAE30\uC220\uC744 \uC5F0\uC2B5 \uC911\uC774\uC9C0![VAR 0114(000F)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC218\uC601\uD558\uAE30 \uC815\uB9D0 \uC88B\uC740 \uB0A0\uC774\uC57C!\\c\\n\uBC14\uC6B0\uC2A4\uD0C0\uB514\uC6C0\uC758 \uC720\uB2C8\uD3FC\uC740\\n\uC218\uC601\uBCF5 \uACB8\uC6A9\uC774\uB77C\uC11C\\r\\n\uC774\uB300\uB85C\uB3C4 \uD5E4\uC5C4\uCE60 \uC218 \uC788\uC5B4[VAR 0114(000F)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAD6C\uB984\uC774 \uD558\uB298\uC744 \uCC28\uC9C0\uD558\uACE0 \uC788\uB294\\n\uBE44\uC728\uC5D0 \uB530\uB77C\\r\\n\uB9D1\uC740\uC9C0 \uD750\uB9B0\uC9C0\uAC00 \uC815\uD574\uC9C0\uB294 \uAC70\uC57C\\c\\n\uC624\uB298\uC740 9\uD560 \uC774\uC0C1\uC774\\n\uAD6C\uB984\uC73C\uB85C \uB36E\uC5EC \uC788\uC73C\uB2C8 \uD750\uB9AC\uACA0\uB124[VAR 0114(000F)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uBBF8\uC6C0\uBC1B\uAE30 \uC2ED\uC0C1\uC778 \uBE44\uC9C0\uB9CC\\n\uBB3C\uD3EC\uCF13\uBAAC\uB4E4\uC740 \uBE44\uAC00 \uC624\uBA74 \uAE30\uBED0\uD574\\c\\n\uB0A0\uC528\uAC00 \uC88B\uB2E4\uB294 \uB9D0\uC758 \uC815\uC758\uB294\\n\uC0AC\uB78C\uC774\uB4E0 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC800\uB9C8\uB2E4 \uB2E4\uB974\uB2E8 \uAC70\uC9C0[VAR 0114(000F)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uAC08\uAC00\uBD80\uAE30\uB294\\n\uBC14\uC704\uD0C0\uC785\uB3C4 \uAC00\uC9C0\uACE0 \uC788\uC5B4\uC11C\\c\\n\uBAA8\uB798\uBC14\uB78C\uC774 \uBD88\uBA74\\n\uD2B9\uC218\uD55C \uAE30\uC220\uC5D0 \uAC15\uD574\uC9C4\uB2E8\uB2E4[VAR 0114(000F)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC9D9\uC740 \uC548\uAC1C\uC5D0 \uAC07\uD600\uC11C\\n\uBC30\uAC00 \uAE38\uC744 \uD5E4\uB9E4\uC9C0 \uC54A\uB3C4\uB85D\\c\\n\uC5B4\uB450\uC6B4 \uBC14\uB2E4\uB97C\\n\uB4F1\uB300\uC758 \uBE5B\uC73C\uB85C \uBC1D\uD600\uC8FC\uB294 \uAC70\uC57C\\r\\n\uBC14\uC6B0\uB9C8\uC744\uC5D0\uC11C\uB3C4 \uBD24\uC9C0?[VAR 0114(000F)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uAC08\uAC00\uAC08\uAC00..."
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8 [VAR 0100(0000)][VAR 1900(0006)]\uB85C\uAD70!\\c\\n\uAC11\uC637\uC12C\uAE4C\uC9C0 \uC640\uC11C \uD2B8\uB808\uC774\uB2DD\uC774\uB77C\uB2C8\\n\uCC38\uC73C\uB85C \uB728\uAC70\uC6B4 \uC5F4\uC815\uC774\uAD6C\uB098![VAR 0114(0010)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB124\uAC8C \uB4A4\uCC98\uC9C0\uC9C0 \uC54A\uAC8C\\n\uB098\uB3C4 \uACC4\uC18D\uD574\uC11C \uB2EC\uB9AC\uB3C4\uB85D \uD558\uB9C8![VAR 0114(0010)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB2E4\uD0DC\uC6B0\uC9C0\uB124\uC758 \uD0C0\uC624\uB974\uB294 \uBAB8\uC740\\n\uD480\uC232\uC5D0 \uBD88\uC744 \uC62E\uACA8\uBC84\uB9B4 \uB54C\uB3C4 \uC788\uC9C0!\\c\\n\uADF8\uB7F4 \uB550 \uBBF8\uB9AC \uC900\uBE44\uD574\uB454\\n\uC218\uD1B5 \uC548\uC758 \uBB3C\uC744 \uBFCC\uB9B0\uB2E8\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC77C\uBC18\uC801\uC73C\uB85C \uC232\uC5D0\uB294\\n\uD480\uD0C0\uC785\uC774\uB098 \uBC8C\uB808\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774 \uB9CE\uC9C0!\\c\\n\uC774\uB7F4 \uB54C \uBD88\uAF43\uD0C0\uC785\uC778\\n\uB2E4\uD0DC\uC6B0\uC9C0\uB124\uAC00 \uC788\uC73C\uBA74 \uB4E0\uB4E0\uD558\uB2E8\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uAE34 \uACC4\uB2E8\uC740\\n\uB2EC\uB9AC\uAE30 \uC5F0\uC2B5\uC5D0 \uCD5C\uC801\uC758 \uC7A5\uC18C\uC9C0!\\c\\n100\uBC88 \uC655\uBCF5\uD558\uAE30\uB97C \uB9C8\uCE58\uACE0\\n\uC7A0\uC2DC \uD734\uC2DD \uC911\uC774\uB780\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC774\uACF3\uC740 \uC81C2\uAD11\uC0B0\uCC98\uB7FC\\n\uBB3C\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774 \uB9CE\uAD6C\uB098!\\r\\n\uC88B\uC740 \uD2B8\uB808\uC774\uB2DD \uC7A5\uC18C\uAC00 \uB418\uACA0\uC5B4![VAR 0114(0010)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uBC14\uB2E4\uC5D0\uC11C \uD558\uB294 \uD2B8\uB808\uC774\uB2DD\uC740\\n\uB0B4 \uD3EC\uCF13\uBAAC\uB4E4\uC5D0\uAC8C\uB294 \uD798\uB4E4\uB2E8\uB2E4!\\c\\n\uADF8\uB798\uC11C \uB0B4\uAC00 \uB2E4\uD0DC\uC6B0\uC9C0\uB124\uC758 \uBAAB\uAE4C\uC9C0\\n\uD5E4\uC5C4\uCE58\uBA74\uC11C \uB2E8\uB828\uD560 \uAC70\uB780\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB098\uC640 \uCF54\uD130\uC2A4\uB294\\n\uB0C4\uBE44\uBC14\uB2E5\uC0AC\uB9C9\uC5D0\uC11C \uB9CC\uB09C \uC0AC\uC774\uB780\uB2E4!\\c\\n\uD2B9\uC131\uC73C\uB85C \uB0A0\uC528\uB97C \uBC14\uAFC0 \uC218 \uC788\uB2E4\uACE0\\n\uAE08\uB791\uC5D0\uAC8C \uCD94\uCC9C\uD588\uB354\uB2C8 \uAE00\uC384\\r\\n\uC0AC\uC6A9\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774 \uACB9\uCCD0\uBC84\uB9AC\uACE0 \uB9D0\uC558\uC9C0![VAR 0114(0010)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uC628\uD654\uD55C \uB0A0\uC528\uB294\\n\uD2B8\uB808\uC774\uB2DD\uD558\uAE30 \uD3B8\uD558\uB2E8\uB2E4!\\r\\n\uD558\uB098! \uB458! \uD558\uB098! \uB458![VAR 0114(0010)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB0A0\uC528\uAC00 \uD750\uB9AC\uB2E4\uACE0 \uD574\uC11C\\n\uC790\uC678\uC120\uC774 \uC804\uD600 \uC5C6\uB294 \uAC74 \uC544\uB2C8\uB780\uB2E4!\\c\\n\uBAA8\uC790\uC640 \uC120\uD06C\uB9BC\uC740 \uBB3C\uB860\uC774\uACE0\\n\uD2C8\uD2C8\uC774 \uC218\uBD84\uC744 \uBCF4\uCDA9\uD558\uB3C4\uB85D![VAR 0114(0010)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uBE44\uAC00 \uB0B4\uB9AC\uBA74 \uBD88\uD0C0\uB294 \uAE30\uC220\uC758\\n\uC704\uB825\uC774 \uB5A8\uC5B4\uC838 \uBC84\uB9AC\uC9C0\\c\\n\uCF8C\uCCAD\uC774\uB098 \uB2E4\uC774\uBC88\uC73C\uB85C\\n\uBE44\uAD6C\uB984\uC744 \uB0A0\uB824\uBC84\uB9AC\uB3C4\uB85D![VAR 0114(0010)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uBAA8\uB798\uBC14\uB78C\uC744 \uADF9\uBCF5\uD574\uB0B4\uC9C0 \uBABB\uD558\uBA74\\n\uAE08\uB791\uC5D0\uAC8C \uACE0\uC804\uD558\uAC8C \uB418\uC9C0!\\r\\n\uB300\uCC45\uC744 \uB9C8\uB828\uD558\uB824\uBA74 \uBC14\uB85C \uC9C0\uAE08\uC774\uB780\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB0A0\uC528\uC5D0 \uB530\uB77C\\n\uB098\uD0C0\uB098\uB294 \uD3EC\uCF13\uBAAC\uC774 \uB2EC\uB77C\uC9C0\uC9C0!\\c\\n\uC774\uB807\uAC8C \uC548\uAC1C\uAC00 \uB080 \uB0A0\uC5D0\uB294\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB098\uAC8C \uB420\uAE4C?[VAR 0114(0010)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uB2E4\uD0DC\uC6B0\uC9C0!"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "...[VAR 0100(0000)]\uB2D8!\\c\\n\uB0A8\uBAB0\uB798 \uB2E8\uB828 \uC911\uC774\uC168\uB098\uC694?[VAR 0114(0011)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC774 \uB418\uC5B4\uC11C\uB3C4\\n\uB178\uB825\uD558\uACE0 \uACC4\uC2DC\uB294\uAD70\uC694\\c\\n...\uC800\uB3C4 \uB4A4\uCC98\uC9C0\uC9C0 \uC54A\uAC8C\\n\uAD34\uB825\uBAAC\uACFC \uC5F4\uC2EC\uD788 \uD574\uC57C\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uC774 \uC12C\uC5D0\uB294 \uC804\uC124\uC758\\n\uACA9\uD22C\uD0C0\uC785 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uB2D8\uC774 \uACC4\uC2ED\uB2C8\uB2E4\\c\\n\uB9CC\uB098 \uBD59\uAE30 \uD669\uC1A1\uD574\uC11C\\n\uCC3E\uC544\uAC00 \uBCF8 \uC801\uC740 \uC5C6\uC2B5\uB2C8\uB2E4\uB9CC...[VAR 0114(0011)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC5D0\uBABD\uAC00\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uC5B8\uC81C \uC5B4\uB514\uC11C \uB098\uD0C0\uB0A0\uC9C0\\r\\n\uC608\uCE21\uD560 \uC218\uAC00 \uC5C6\uC5B4\uC11C \uAE4C\uB2E4\uB86D\uB124\uC694...[VAR 0114(0011)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC774 \uC8FC\uBCC0\uC740 \uB798\uD130\uB7F4\uB9C8\uC744\uACFC \uBE44\uC2B7\uD558\uB124\uC694\\c\\n\uCCB4\uC721\uAD00 \uC0AC\uB78C\uB4E4\uC774 \uB5A0\uC62C\uB77C\uC11C\\n\uB354 \uC5F4\uC2EC\uD788 \uB2E8\uB828\uD558\uAC8C \uB418\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uB9E8\uBC1C\uB85C \uC9C0\uB0B4\uBA74 \uC720\uC0AC\uC2DC\uC5D0\uB3C4\\n\uB4B7\uC2EC\uC744 \uBC1C\uD718\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uAD34\uB825\uBAAC\uB3C4\\n\uC5B8\uC81C\uB098 \uB9E8\uBC1C\uC778 \uAC83 \uC544\uB2D0\uAE4C\uC694?[VAR 0114(0011)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC218\uC601\uC740 \uADFC\uC721\uC744 \uAC15\uD654\uD558\uB294 \uB370\\n\uB9E4\uC6B0 \uC801\uC808\uD55C \uC6B4\uB3D9\uC785\uB2C8\uB2E4\\c\\n\uC57C\uCCAD\uB2D8\uC758 \uBAB8\uB3C4\\n\uC0C1\uB2F9\uD788 \uB2E8\uB828\uB418\uC5B4 \uC788\uC744 \uAC70\uC608\uC694[VAR 0114(0011)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC774 \uC9C0\uD615... \uAD00\uAC1D\uC11D\uC5D0 \uB458\uB7EC\uC2F8\uC778\\n\uBC30\uD2C0\uCF54\uD2B8\uCC98\uB7FC \uBCF4\uC774\uC9C0 \uC54A\uB098\uC694?\\r\\n\uC774\uBBF8\uC9C0 \uD2B8\uB808\uC774\uB2DD\uC5D0 \uB3C4\uC6C0\uC774 \uB418\uACA0\uC5B4\uC694[VAR 0114(0011)]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uB0A0\uC528\uAC00 \uAC70\uCE60\uC218\uB85D\\n\uB354 \uD6A8\uACFC\uC801\uC73C\uB85C \uB2E8\uB828\uB418\uB294 \uAE30\uBD84\uC774 \uB4ED\uB2C8\uB2E4\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB0A0\uC528\uAC00 \uC628\uD654\uD558\uBA74\\n\uB9E8\uBC1C\uB85C \uC9C0\uB0B4\uB3C4 \uBC1C\uC774 \uB354\uB7EC\uC6CC\uC9C0\uC9C0 \uC54A\uC8E0[VAR 0114(0011)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uD0DC\uC591\uB3C4 \uB2EC\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC774 \uD558\uB298\uCC98\uB7FC\\n\uAC00\uC2B4\uC774 \uB2F5\uB2F5\uD560 \uB54C\\c\\n\uAD34\uB825\uBAAC\uACFC \uB300\uB828\uC744 \uD558\uBA74\\n\uAE30\uBD84\uC774 \uB9D1\uAC8C \uAC2D\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uBE44\uAC00 \uB0B4\uB9AC\uB4E0 \uCC3D\uC774 \uC3DF\uC544\uC9C0\uB4E0\\n\uADF8\uC800 \uC8FC\uBA39\uC744 \uB0B4\uC9C0\uB97C \uBFD0\uC785\uB2C8\uB2E4!\\c\\n\uC8FC\uBA39\uC744 \uB0B4\uC9C0\uB978 \uD69F\uC218\uB9CC\uD07C\\n\uC2B9\uB9AC\uC5D0 \uAC00\uAE4C\uC6CC\uC9C4\uB2E4\uACE0 \uBBFF\uC73C\uB2C8\uAE4C\uC694[VAR 0114(0011)]"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uC774\uB530\uC704 \uBAA8\uB798\uBC14\uB78C\uC5D0\uB294\\n\uCF67\uBC29\uADC0\uB3C4 \uB098\uC624\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!\\c\\n...\uC57C\uCCAD\uB2D8 \uC55E\uC5D0\uC11C \uC774\uB7F0 \uB9D0\uC744 \uD558\uBA74\\n\uC8FC\uC758\uBC1B\uC744 \uAC70\uC608\uC694[VAR 0114(0011)]"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uC0C1\uB300\uAC00 \uBCF4\uC774\uC9C0 \uC54A\uC544\uB3C4\\n\uB9C8\uC74C\uC758 \uB208\uC73C\uB85C \uAE30\uCC99\uC744 \uAC10\uC9C0\uD558\uB77C!\\c\\n\uC548\uAC1C\uC758 \uB208\uC18D\uC784\uC740\\n\uC774\uB97C \uC218\uB828\uD558\uB294 \uB370 \uC548\uC131\uB9DE\uCDA4\uC785\uB2C8\uB2E4[VAR 0114(0011)]"
  },
