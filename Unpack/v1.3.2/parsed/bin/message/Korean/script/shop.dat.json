  },
  {
    "index": 100,
    "flags": 0,
    "text": "\uB2E4\uB978 \uD5A5\uB85C\uB294\\n\uC5B4\uB5A0\uC2E0\uAC00\uC694?"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0006)]\uAD70\uC694\\n\uBA87 \uAC1C \uAD6C\uB9E4\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 102,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0001)]\\n[VAR 0202(0001)]\uAC1C\uC5D0 [VAR 0206(0002,0000)]\uC6D0\uC785\uB2C8\uB2E4"
  },
  {
    "index": 103,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0001)]\\n[VAR 0202(0001)]\uAC1C\uC5D0 [VAR 0206(0002,0000)]\uC6D0\uC785\uB2C8\uB2E4"
  },
  {
    "index": 104,
    "flags": 0,
    "text": "\uC790 \uBC1B\uC544\uC8FC\uC138\uC694\\n\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uC774\uC6A9\uD574\uC8FC\uC138\uC694\\c"
  },
  {
    "index": 105,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uADF8 \uC774\uC0C1\uC740\\n\uAC00\uC9C0\uACE0 \uB2E4\uB2D0 \uC218 \uC5C6\uB294 \uAC83 \uAC19\uB124\uC694...\\c"
  },
  {
    "index": 106,
    "flags": 0,
    "text": "\uC8C4\uC1A1\uD569\uB2C8\uB2E4...\\n\uB3C8\uC774 \uBD80\uC871\uD558\uC2DC\uB124\uC694\\c"
  },
  {
    "index": 107,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0006)]\uB77C\uBA74\\n[VAR 0202(0001)]\uAC1C\uC5D0 [VAR 0206(0002,0000)]BP\uC785\uB2C8\uB2E4"
  },
  {
    "index": 108,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0006)]\uB77C\uBA74\\n[VAR 0202(0001)]\uAC1C\uC5D0 [VAR 0206(0002,0000)]BP\uC785\uB2C8\uB2E4"
  },
  {
    "index": 109,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uC138\uC694! \uD55C\uBC29\uC57D\uC20D\uC785\uB2C8\uB2E4!\\n\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 110,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4!\\n\uB2E4\uC74C\uC5D0 \uB610 \uB4E4\uB7EC\uC8FC\uC138\uC694!"
  },
  {
    "index": 111,
    "flags": 0,
    "text": "\uB2E4\uB978 \uC6A9\uAC74\uC740 \uC5C6\uB098\uC694?"
  },
  {
    "index": 112,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0002)]\\n\uBA87 \uAC1C \uAD6C\uB9E4\uD558\uC2E4 \uAC74\uAC00\uC694?"
  },
  {
    "index": 113,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0001)]\\n[VAR 0202(0001)]\uAC1C\uC5D0 [VAR 0206(0002,0000)]\uC6D0\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 114,
    "flags": 0,
    "text": "[VAR 0109(0000)][VAR 1900(0001)]\\n[VAR 0202(0001)]\uAC1C\uC5D0 [VAR 0206(0002,0000)]\uC6D0\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 115,
    "flags": 0,
    "text": "\uC790! \uC0C1\uD488\uC744 \uBC1B\uC544\uC8FC\uC138\uC694!\\n\uD6A8\uACFC\uB294 \uD655\uC2E4\uD560 \uAC81\uB2C8\uB2E4!\\c"
  },
  {
    "index": 116,
    "flags": 0,
    "text": "\uC774\uB7F0!\\n\uB354 \uAC00\uC9C0\uACE0 \uB2E4\uB2D0 \uC218 \uC5C6\uB294 \uBAA8\uC591\uC774\uB124\uC694\\c"
  },
  {
