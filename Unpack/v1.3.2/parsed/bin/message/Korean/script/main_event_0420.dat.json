    "flags": 0,
    "text": "\uBB50\uC57C \uC800 \uB140\uC11D...[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC544\uBB34\uD2BC\\n\uC5D4\uD2B8\uB9AC \uD558\uB7EC \uAC00\uC790![VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uCC38\uAC00\uD558\uC2E4 \uAC74\uAC00\uC694?\\n\uCD94\uCC9C\uC7A5\uC744 \uBCF4\uC5EC\uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC6B0\uC640... \uCC54\uD53C\uC5B8\uC758\\n\uCD94\uCC9C\uC7A5\uC740 \uCC98\uC74C \uBCF4\uB124\uC694!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC800\uB3C4 \uBC1B\uC558\uC5B4\uC694![VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB124\uC5D0?! \uB450 \uBD84 \uBAA8\uB450\\n\uB2E8\uB378\uB2D8\uC5D0\uAC8C \uC778\uC815\uC744 \uBC1B\uC558\uB2E4\uAD6C\uC694!?\\r\\n\uB2F9\uC2E0\uB4E4\uC740 \uB300\uCCB4..."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB098\uB294 \uD638\uBE0C!\\c\\n\uB2E8\uB378\uC758 \uB3D9\uC0DD\uC774\uC790\\n\uBBF8\uB798\uC758 \uCC54\uD53C\uC5B8\uC774\uC5D0\uC694![VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB124? \uC544, \uB124...\\n\uC7A0\uC2DC \uAE30\uB2E4\uB824\uC8FC\uC138\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB450 \uBD84 \uBAA8\uB450\\n\uC5D4\uD2B8\uB9AC \uB418\uC168\uC2B5\uB2C8\uB2E4\\c\\n\uADF8\uB7FC \uC6D0\uD558\uC2DC\uB294 \uBC88\uD638\uB97C\\n\uC120\uD0DD\uD574 \uC8FC\uC138\uC694\\c\\n\uC120\uD0DD\uD55C \uBC88\uD638\uB294 \uC720\uB2C8\uD3FC\uC758\\n\uB4F1\uBC88\uD638\uB85C \uC0AC\uC6A9\uB429\uB2C8\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 01C4(0001)]\uBC88\uC774\uC2DC\uAD70\uC694!\\n\uC54C\uACA0\uC2B5\uB2C8\uB2E4\\c\\n\uB2E4\uC74C\uC73C\uB85C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uCC38\uAC00\uD558\uB294\uB370 \uD544\uC694\uD55C\\n\uCC4C\uB9B0\uC9C0\uBC34\uB4DC\uB3C4 \uCC29\uC6A9\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB0B4\uC77C \uC774\uACF3\uC5D0\uC11C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC758\\n\uAC1C\uD68C\uC2DD\uC774 \uC5F4\uB9B4 \uC608\uC815\uC785\uB2C8\uB2E4\\c\\n\uCC38\uAC00\uD558\uC2DC\uB294 \uBD84\uB4E4\uC740 \uBAA8\uB450\\n\uAF2C\uBABD\uC6B8\uBE44\uC988\uB2C8\uC2A4\uD638\uD154\uC5D0 \uBB35\uAC8C \uB429\uB2C8\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uB2D8 \uAD49\uC7A5\uD558\uB2E4~!\\c\\n\uC88B\uC544! \uADF8\uB7FC \uBC14\uB85C\\n\uAF2C\uBABD\uC6B8\uBE44\uC988\uB2C8\uC2A4\uD638\uD154\uC5D0 \uAC00\uBCF4\uC790![VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5EC\uAE30\uC800\uAE30 \uB450\uB9AC\uBC88\uAC70\uB9AC\uB294 \uAC78 \uBCF4\uB2C8\\c\\n\uB108\uD76C\uB4E4 \uC2DC\uACE8\uC5D0\uC11C \uC654\uB098 \uBCF4\uAD6C\uB098?\\n\uB098\uB3C4 \uADF8\uB807\uAC70\uB4E0[VAR 0114(0042)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC800\uB294 \uB9AC\uADF8 \uC704\uC6D0\uC7A5\uB2D8\uC5D0\uAC8C\\n\uCD94\uCC9C\uC7A5\uC744 \uBC1B\uC740 \uBAB8...\\r\\n\uB9D0\uD558\uC790\uBA74 \uC5D8\uB9AC\uD2B8 \uC911\uC758 \uC5D8\uB9AC\uD2B8\\c\\n\uADF8\uB7F0 \uC81C\uAC8C \uC2DC\uAC04\uC744\\n\uB0AD\uBE44\uD558\uAC8C \uD558\uB294 \uAC74 \uD06C\uB098\uD070 \uC8C4\uC785\uB2C8\uB2E4[VAR 0114(0042)]"
