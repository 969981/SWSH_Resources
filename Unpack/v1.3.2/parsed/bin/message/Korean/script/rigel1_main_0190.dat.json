[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624\uC624?\\c\\n\uD604\uC7AC \uB108\uC640 \uCE58\uACE0\uB9C8\uC758 \uC0AC\uC774\uB294...[VAR 0114(0073)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC804\uD600 \uAC00\uAE4C\uC6CC\uC9C0\uC9C0 \uC54A\uC558\uAD6C\uB098\\c\\n\uC77C\uB2E8 \uD568\uAED8 \uC774\uAC83\uC800\uAC83 \uB9CE\uC774 \uD558\uBA74\uC11C\\n\uC720\uB300\uAC10\uC744 \uB9CC\uB4E4\uB3C4\uB85D \uD558\uB824\uBB34\uB098[VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC88B\uC9C0\uB3C4 \uC54A\uACE0\\n\uB098\uC058\uC9C0\uB3C4 \uC54A\uC740 \uB290\uB08C\uC774\uAD6C\uB098!\\c\\n\uBC30\uD2C0\uC744 \uD558\uBA74\uC11C \uAC15\uD574\uC9C0\uBA74\\n\uC800\uC808\uB85C \uC720\uB300\uAC00 \uAE4A\uC5B4\uC9C8 \uAC8C\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC810\uC810 \uC0AC\uC774\uAC00\\n\uAC00\uAE4C\uC6CC\uC9C0\uACE0 \uC788\uB294 \uAC83 \uAC19\uAD6C\uB098!\\c\\n\uD3C9\uC628\uC758\uBC29\uC6B8\uC744 \uC9C0\uB2C8\uAC8C \uD558\uBA74\\n\uC870\uAE08 \uB354 \uBE68\uB9AC\\r\\n\uCE5C\uD55C \uC0AC\uC774\uAC00 \uB420 \uC218 \uC788\uC744 \uAC8C\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAF64 \uC0AC\uC774\uAC00 \uC88B\uC544\uC9C4 \uBAA8\uC591\uC774\uAD6C\uB098!\\c\\n\uCEA0\uD504\uC5D0\uC11C \uB180\uC544\uC8FC\uAE30\uB9CC \uD574\uB3C4\\n\uCE5C\uD574\uC9C8 \uC218 \uC788\uB2E8\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[~ 5]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC758 \uBA85\uC18C!\\n\uD0C0\uC6B4\uB9F5\uC5D0 \uD45C\uC2DC\uD574\uB480\uC73C\uB2C8\uAE4C\\r\\n\uD568\uAED8 \uACBD\uCE58\uB97C \uBCF4\uB7EC \uAC00\uBCF4\uB824\uBB34\uB098![VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB108\uD76C \uB458\uC758 \uC0AC\uC774\uAC00 \uC88B\uC544\uC9C0\uBA74\\n\uCE58\uACE0\uB9C8\uC758 \uC218\uD589\uC744 \uC2DC\uC791\uD558\uC790\uAFB8\uB098[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBCA0\uC544\uB9C8!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC74C\uC74C! \uAD49~\uC7A5\uD788\\n\uCE5C\uD55C \uC0AC\uC774\uAC00 \uB410\uAD6C\uB098![VAR 0114(0073)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uC62C\uACE7\uACE0 \uAC15\uD558\uAC8C \uD0A4\uC6CC\uB0B4\uB2E4\uB2C8\\n\uCC38\uC73C\uB85C \uD6CC\uB96D\uD574~![VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC9C0\uAE08\uC758 \uB108\uD76C\uB77C\uBA74... \uC74C![VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "...\uB458 \uB2E4\\n\uB098\uB97C \uB530\uB77C\uC624\uAC70\uB77C[VAR 0114(0073)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC624\uC624? [VAR 0100(0000)]\\n\uB108\uC758 \uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uACFC \uBC15\uC2A4 \uC5B4\uB514\uC5D0\uB3C4\\r\\n\uCE58\uACE0\uB9C8\uAC00 \uC5C6\uB294 \uAC83 \uAC19\uAD6C\uB098...?[VAR 0114(0073)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uAC00 \uC5C6\uC73C\uBA74\\n\uC218\uD589\uC744 \uD558\uB294 \uC758\uBBF8\uAC00 \uC5C6\uB294\uB370\\r\\n\uC815\uB9D0\uB85C \uACC4\uC18D\uD560 \uAC8C\uB0D0?[VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8 \uC5C6\uC774 \uC218\uD589\uC744 \uACC4\uC18D\uD574\uB3C4\\n\uD6C4\uD68C\uD558\uC9C0 \uC54A\uC744 \uAC70\uC9C0?[VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "...\uADF8\uB7FC \uB530\uB77C\uC624\uAC70\uB77C[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uADF8\uB798!\\n\uCE58\uACE0\uB9C8\uB97C \uB370\uB824\uC624\uBA74\\r\\n\uADF8\uB54C \uB2E4\uC2DC \uC218\uD589\uC744 \uC2DC\uC791\uD558\uC790\uAFB8\uB098~![VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC624\uC624? \uCE58\uACE0\uB9C8\uB97C\\n\uB9E1\uAE30\uBBF8\uC9D1\uC5D0 \uB9E1\uACA8\uB193\uC740 \uBAA8\uC591\uC774\uAD6C\uB098\\c\\n\uB108\uD76C\uAC00 \uC5BC\uB9C8\uB098 \uCE5C\uD574\uC84C\uB294\uC9C0\uB294\\n\uCE58\uACE0\uB9C8\uAC00 \uB3CC\uC544\uC624\uAC70\uB4E0 \uBCF4\uC5EC\uC8FC\uB824\uBB34\uB098~[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC624\uC624? \uCE58\uACE0\uB9C8\uB97C\\n\uD3EC\uCF13\uBAAC\uC7A1\uC5D0 \uBCF4\uB0B8 \uBAA8\uC591\uC774\uAD6C\uB098\\c\\n\uB108\uD76C\uAC00 \uC5BC\uB9C8\uB098 \uCE5C\uD574\uC84C\uB294\uC9C0\uB294\\n\uCE58\uACE0\uB9C8\uAC00 \uB3CC\uC544\uC624\uAC70\uB4E0 \uBCF4\uC5EC\uC8FC\uB824\uBB34\uB098~[VAR 0114(0073)]"
  }
