    "flags": 0,
    "text": "\uC7A0\uAE50!\\n\uC5EC\uAE30\uC57C [VAR 0100(0000)]![VAR 0114(000D)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB09C \uC774\uACF3\uC5D0\uC11C \uD0DC\uC5B4\uB098\uC11C\\n\uB2E4\uB978 \uC785\uAD6C\uB97C \uC54C\uACE0 \uC788\uC5B4[VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB108\uB3C4 \uB9C8\uC744\uC5D0 \uB4E4\uC5B4\uAC00\uACE0 \uC2F6\uB2E4\uBA74\\n\uB0B4\uAC00 \uC548\uB0B4\uD574\uC904\uAC8C\\c\\n\uB2E8... \uB108\uB294 \uB0B4 \uB77C\uC774\uBC8C\uC774\uB2C8\uAE4C\\n\uB098\uB97C \uC774\uACA8\uC57C\uB9CC \uC548\uB0B4\uD574\uC904 \uAC70\uC57C[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC88B\uC544!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC0DD\uAC01 \uC880 \uD574\uBCFC\uAC8C"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774\uB7F0! \uB0B4\uAC00 \uC798\uBABB \uC9DA\uC5C8\uB098...?\\n\uC544 \uC900\uBE44\uAC00 \uD544\uC694\uD55C \uAC70\uAD6C\uB098\\r\\n\uC88B\uC544! \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C[VAR 0114(000D)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB108\uB3C4 \uC5EC\uAE30\uAE4C\uC9C0 \uC628\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2C8\uAE4C\\c\\n\uC9C0\uB09C\uBC88\uC5D0 \uB9D0\uD588\uB358 \uAC83\uCC98\uB7FC\\n\uB77C\uC774\uBC8C\uB85C\uC11C \uC874\uACBD\uD558\uACE0 \uC788\uC5B4!\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB098\uB3C4 \uC5EC\uB7EC\uBAA8\uB85C\\n\uC9CA\uC5B4\uC9C0\uACE0 \uC788\uB294 \uAC8C \uB9CE\uC544\uC11C\\r\\n\uAC04\uB2E8\uD558\uAC8C \uC9C8 \uC218\uB294 \uC5C6\uC5B4![VAR 0114(000D)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB0B4 \uD30C\uD2B8\uB108\uC778\uB370\uB3C4\\n\uBAA8\uB974\uD398\uCF54\uAC00 \uAC15\uD55C \uB108\uB97C\\r\\n\uB9C8\uC74C\uC5D0 \uB4E4\uC5B4 \uD558\uB294 \uC774\uC720\uB97C \uC54C \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\\c\\n\uADF8\uB807\uC9C0\uB9CC! \uB09C \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC758\\n\uC0AC\uB78C\uB4E4\uC744 \uAE30\uC058\uAC8C \uD574\uC918\uC57C \uD574![VAR 0114(000D)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC78A\uC9C0 \uB9C8! \uB2E4\uC2DC \uD55C\uBC88\\n\uB108\uC640 \uC2F8\uC6B0\uAE30 \uC704\uD574\uC11C\uB77C\uB3C4 \uBC18\uB4DC\uC2DC\\r\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uBAA8\uC73C\uACE0 \uB9D0 \uD14C\uB2C8\uAE4C!\\r\\n\uCC54\uD53C\uC5B8\uCEF5\uC5D0\uC11C \uB9AC\uBCA4\uC9C0\uD558\uACE0 \uB9D0\uACA0\uC5B4![VAR 0114(000D)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC57D\uC18D\uC744 \uC9C0\uCF1C\uC57C\uACA0\uC9C0!\\n\uB098\uB97C \uB530\uB77C\uC640[VAR 0114(000D)]"
  }
]
