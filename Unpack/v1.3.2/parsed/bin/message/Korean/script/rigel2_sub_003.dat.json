[
  {
    "index": 0,
    "flags": 0,
    "text": "[~ 0]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uB97C\\n\uC2DC\uC791\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC2DC\uC791\uD55C\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC124\uBA85\uC744 \uB4E3\uB294\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC704\uCE58 \uAE30\uB85D\uC744\\n\uAC00\uC9C0\uACE0 \uACC4\uC2E0 \uBAA8\uC591\uC774\uB124\uC694\\c\\n\uC5B4\uB290 \uD3EC\uCF13\uBAAC\uC744 \uBAA9\uD45C\uB85C\\n\uCD9C\uBC1C\uD558\uC2E4 \uAC74\uAC00\uC694?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 0100(0001)]\uB2D8\uC740 [VAR 0101(0000)][VAR 1900(0001)]\\n\uC7A1\uC740 \uC801\uC774 \uC788\uC73C\uC2DC\uB124\uC694\\c\\n\uB9CC\uB098\uB354\uB77C\uB3C4 [VAR FF00(0001)]\uC7A1\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\uB9CC[VAR FF00(0000)]\\n\uC815\uB9D0 \uAD1C\uCC2E\uC73C\uC2E0\uAC00\uC694?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC9C0\uB09C \uD0D0\uD5D8\uC5D0\uC11C [VAR 0101(0000)][VAR 1900(0002)]\\n\uBC1C\uACAC\uD558\uC168\uAD70\uC694!\\c\\n\uC704\uCE58\uB97C \uAE30\uB85D\uD574\uB46C\uC11C\\n\uB2E4\uC2DC \uD55C\uBC88 [VAR 0101(0000)]\uC5D0\uAC8C\\r\\n\uB3C4\uC804\uD558\uC2E4 \uC218 \uC788\uB294\uB370, \uC5B4\uB5BB\uAC8C \uD558\uC2E4 \uAC74\uAC00\uC694?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0101(0000)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC9C0\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uB294\\n\uB80C\uD0C8 \uD3EC\uCF13\uBAAC\uC744 \uC0AC\uC6A9\uD574\uC11C\\c\\n\uC774\uACF3 \uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74\uC744\\n\uC870\uC0AC\uD558\uB294 \uC5B4\uB4DC\uBCA4\uCC98\uC785\uB2C8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "4\uC778 1\uC870\uAC00 \uB418\uC5B4\\n\uC0C1\uC758\uD558\uBA74\uC11C \uAC08 \uAE38\uC744 \uC815\uD558\uACE0\\c\\n\uAC00\uC7A5 \uC548\uCABD\uC5D0 \uC704\uCE58\uD55C\\n\uC804\uC124\uC758 \uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744\\r\\n\uBAA9\uD45C\uB85C \uB098\uC544\uAC00\uC8FC\uC2DC\uBA74 \uB429\uB2C8\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD0D0\uD5D8\uC774 \uB05D\uB098\uBA74 \uBCF4\uC0C1\uC73C\uB85C\\n\uB9E5\uC2A4\uAD11\uC11D\uC744 \uB4DC\uB9BD\uB2C8\uB2E4\\c\\n\uB3C4\uC911\uC5D0 \uC7A1\uC740 \uD3EC\uCF13\uBAAC\uC740\\n\uC870\uC0AC\uB97C \uC704\uD574 \uC800\uD76C\uAC00 \uD68C\uC218\uD560 \uC608\uC815\uC785\uB2C8\uB2E4\uB9CC\\c\\n1\uB9C8\uB9AC \uC815\uB3C4\uB294 \uB370\uB824\uAC00\uC154\uB3C4 \uB429\uB2C8\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC9C0\uB09C \uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uB97C\\n\uB3C4\uC911\uC5D0 \uADF8\uB9CC\uB450\uC168\uC8E0?\\c\\n\uAC19\uC774 \uCC38\uAC00\uD55C \uBD84\uB4E4\uAED8\\n\uBBFC\uD3D0\uAC00 \uB418\uB2C8\uAE4C\\r\\n\uB2E4\uC74C\uBD80\uD130\uB294 \uC8FC\uC758\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uB97C\\n\uB3C4\uC911\uC5D0 \uADF8\uB9CC\uB450\uB294 \uD589\uC704\uB97C\\r\\n\uC5EC\uB7EC \uBC88 \uBC18\uBCF5 \uC911\uC774\uC2DC\uAD70\uC694...\\c\\n\uD398\uB110\uD2F0\uB85C \uB9E5\uC2A4\uAD11\uC11D\uC744\\n[VAR 0201(0000)]\uAC1C \uBC1B\uACA0\uC2B5\uB2C8\uB2E4\\r\\n\uAD1C\uCC2E\uC73C\uC2DC\uC8E0?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD398\uB110\uD2F0\uC778 \uB9E5\uC2A4\uAD11\uC11D\uC744\\n\uC8FC\uC2DC\uAE30 \uC804\uAE4C\uC9C0\uB294\\c\\n\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98 \uCC38\uAC00\uB97C\\n\uD5C8\uAC00\uD574\uB4DC\uB9B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uAD11\uC11D\uC758 \uC218\uAC00 \uBD80\uC871\uD558\uB124\uC694"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uAD11\uC11D\uC740 \uC655\uAD00\uC124\uC6D0\uC758\\n\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uC5D0\uC11C\uB3C4 \uC5BB\uC73C\uC2E4 \uC218 \uC788\uC73C\uB2C8\uAE4C\\r\\n\uBAA8\uC740 \uB2E4\uC74C\uC5D0 \uB2E4\uC2DC \uC640\uC8FC\uC138\uC694"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB2E4\uC74C\uBD80\uD130\uB294 \uAF2D \uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uC5D0\\n\uB05D\uAE4C\uC9C0 \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4!\\n\uB2E4\uC74C\uC5D0\uB3C4 \uD611\uB825\uC744 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4\\n\uC870\uAE08\uB9CC \uB354 \uD558\uBA74 \uB410\uC744 \uAC83 \uAC19\uC558\uB294\uB370 \uC544\uC27D\uB124\uC694"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB2E4\uC2DC \uB3C4\uC804\uD560 \uC218 \uC788\uAC8C\\n[VAR 0101(0000)]\uC758 \uC704\uCE58\uB97C\\r\\n\uAE30\uB85D\uD574\uB450\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC704\uCE58 \uAE30\uB85D\uC774\\n\uAC00\uB4DD \uCC2C \uBAA8\uC591\uC774\uB124\uC694...\\c\\n\uC0AD\uC81C\uD574\uB3C4 \uAD1C\uCC2E\uC740\\n\uC704\uCE58 \uAE30\uB85D\uC740 \uC5C6\uC73C\uC2E0\uAC00\uC694?"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC774\uBC88\uC5D0 \uB9CC\uB09C\\n[VAR 0101(0000)]\uC758 \uC704\uCE58\uB294\\r\\n\uAE30\uB85D\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uADF8\uB7FC [VAR 0101(0001)]\uC758\\n\uC704\uCE58 \uAE30\uB85D\uC744 \uC0AD\uC81C\uD558\uACE0\\c\\n[VAR 0101(0000)]\uC758 \uC704\uCE58\uB97C\\n\uC0C8\uB85C \uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "...\uC790!\\n\uC704\uCE58 \uAE30\uB85D\uC744 \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0\uB3C4 \uD611\uB825\uC744 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC544\uC26C\uC6E0\uB124\uC694\\n\uB2E4\uC74C\uC5D0\uB3C4 \uD611\uB825\uC744 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4\\c\\n[VAR 0101(0000)]\uC758 \uC704\uCE58 \uAE30\uB85D\uC740\\n\uADF8\uB300\uB85C \uB0A8\uACA8\uB458\uAE4C\uC694?"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!\\n\uADF8\uB7FC \uAE30\uB85D\uC744 \uB0A8\uACA8\uB450\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uADF8\uB7FC, [VAR 0101(0000)]\uC758\\n\uC704\uCE58 \uAE30\uB85D\uC740 \uC9C0\uC6CC\uB450\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "...\uC751?\\n\uC544~ \uB108\uAD6C\uB098?\\c\\n\uC880 \uB354 \uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uC5D0\\n\uC775\uC219\uD574\uC9C0\uBA74 \uB098\uB97C \uCC3E\uC544\uC640 \uC918"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "...\uB108\\n\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98 \uC88B\uC544\uD558\uB2C8?"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uADF8\uB798? \uADF8\uB807\uACA0\uC9C0!\\n\uD0D0\uD5D8\uD558\uB7EC \uAC00\uB294 \uAC78 \uC790\uC8FC \uBD24\uAC70\uB4E0!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uADF8\uB798...? \uADF8\uB807\uAD6C\uB098..."
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uB124\uAC00 \uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uC758\\n\uD504\uB85C\uD398\uC154\uB110\uC774\uB77C\uC11C \uD558\uB294 \uB9D0\uC778\uB370...!\\c\\n\uB0B4\uAC00 \uACE0\uC548\uD574\uB0B8\\n\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\\r\\n\uC5D4\uB4DC\uB9AC\uC2A4 \uBAA8\uB4DC\uC5D0 \uB3C4\uC804\uD574\uBCF4\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\\n\uC5D4\uB4DC\uB9AC\uC2A4 \uBAA8\uB4DC\uC5D0 \uB3C4\uC804\uD574\uBCF4\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uAE30\uB85D\uC744 \uBCF8\uB2E4"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC5D4\uB4DC\uB9AC\uC2A4 \uBAA8\uB4DC\uB294\\n\uC774\uB984 \uADF8\uB300\uB85C \uC5D4\uB4DC\uB9AC\uC2A4!\\c\\n\uC548\uCABD\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC4F0\uB7EC\uB728\uB9B0 \uB2E4\uC74C\uC5D0\uB3C4\\n\uB354 \uAE4A\uC740 \uACF3\uAE4C\uC9C0 \uB4E4\uC5B4\uAC00\uC11C\\r\\n\uC5B4\uB514\uAE4C\uC9C0 \uAC08 \uC218 \uC788\uB098 \uB3C4\uC804\uD558\uB294 \uAC70\uC57C!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB3C4\uC911\uC5D0 \uC7A1\uC740 \uD3EC\uCF13\uBAAC\uC740\\n\uC804\uBD80 \uC870\uC0AC\uC5D0 \uBCF4\uB0B4\uC57C \uD574\uC11C\\r\\n\uB124\uAC00 \uB370\uB824\uAC08 \uC218\uB294 \uC5C6\uC9C0\uB9CC\\c\\n\uB300\uC2E0 \uD3C9\uC18C\uBCF4\uB2E4 \uB9CE\uC740\\n\uB9E5\uC2A4\uAD11\uC11D\uC744 \uBCF4\uC0C1\uC73C\uB85C \uC904\uAC8C!"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC5B4\uB514\uAE4C\uC9C0 \uAC14\uB294\uC9C0 \uAE30\uB85D\uB3C4 \uB0A8\uACA8\uB458 \uD14C\uB2C8\uAE4C\\n\uCE5C\uAD6C\uB4E4\uACFC \uD568\uAED8 \uD55C\uACC4\uAE4C\uC9C0 \uB3C4\uC804\uD574 \uBD10!"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0\uB3C4 \uB3C4\uC804\uD560 \uAC70\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB9D0\uC744 \uAC78\uC5B4\uC918"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC815\uB9D0 \uAD49\uC7A5\uD574! \uC2E0\uAE30\uB85D\uC774\uC57C!\\n\uC81C\uB300\uB85C \uAE30\uB85D\uD574\uB458\uAC8C!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D0 \uC5B4\uB514\uAE4C\uC9C0 \uB4E4\uC5B4\uAC14\uB294\uC9C0\\n\uAE30\uB85D\uD574\uB480\uC73C\uB2C8\uAE4C\\c\\n\uB2E4\uC74C\uC5D0\uB3C4 \uB3C4\uC804\uD560 \uAC70\uBA74\\n\uB9D0\uC744 \uAC78\uC5B4\uC918"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC9C0\uAE08\uAE4C\uC9C0\uC758 \uCD5C\uACE0 \uAE30\uB85D\uC740 \uC774\uAC70\uC57C!"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uAE30\uB85D \uACBD\uC2E0\uC744 \uBAA9\uD45C\uB85C\\n\uC5F4\uC2EC\uD788 \uD574 \uBD10!"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "[~ 47]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC557! [VAR 0100(0000)][VAR 1900(0006)]\uC796\uC544!\\c\\n\uB0B4\uAC00 \uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74\uC5D0\uC11C\\n[VAR 0101(0001)][VAR 1900(0002)] \uBC1C\uACAC\uD588\uAC70\uB4E0![VAR 0114(0078)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uAD11\uC11D [VAR 0202(0002)]\uAC1C\uB97C \uC8FC\uBA74\\n[VAR 0101(0001)]\uC758 \uC704\uCE58\uB97C\\r\\n\uAC00\uB974\uCCD0\uC904 \uC218 \uC788\uB294\uB370, \uC5B4\uB54C?[VAR 0114(0078)]"
