[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC6B8\uD241\uBD88\uD241\uD55C \uAC8C \uADC0\uC5FD\uB124~\\n\uD0C4\uCC28\uACE4 \uAE30\uBD84 \uC88B\uC9C0?[VAR 0114(0043)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uACE4?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB098\uB294 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uD0C4\uCC28\uACE4\uACFC\\n\uC990\uAC81\uAC8C \uB178\uB294 \uC911\uC774\uC57C\\c\\n\uC6B0\uB9AC \uB458\uB9CC\uC758 \uC138\uACC4\uC5D0 \uB4E4\uC5B4\uC624\uB824\uB294\\n\uB140\uC11D\uB4E4\uC740 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5B4\uB3C4 \uCAD3\uC544\uB0B4 \uC8FC\uACA0\uC5B4![VAR 0114(0043)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC81C2\uAD11\uC0B0\uC5D0\uC11C \uCD5C\uAC15\uC774\uC5C8\uB358\\n\uB098\uC758 \uC124 \uC790\uB9AC\uAC00 \uC5C6\uC5B4\uC84C\uB2E4...![VAR 0114(0043)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBB50\uC57C \uB108! \uD0C4\uCC28\uACE4\uC744\\n\uADC0\uC5EC\uC6CC\uD574 \uC8FC\uBA74\uC11C \uAE38\uB3C4 \uB9C9\uC744 \uC218 \uC788\uB294\\r\\n\uBA4B\uC9C4 \uC544\uC774\uB514\uC5B4\uC600\uB294\uB370![VAR 0114(0044)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uCCA0\uC218\uD558\uC790! \uD3EC\uCF13\uBAAC\uC740 \uB0B4\uBC84\uB824 \uB450\uACE0\\n\uB3C4\uB9DD\uAC00\uC790![VAR 0114(005E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD574\uB0C8\uAD6C\uB098\\n[VAR 0100(0000)]![VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC800 \uB140\uC11D\uB4E4...\\c\\n\uD0C4\uCC28\uACE4\uC744 \uADC0\uC5EC\uC6CC\uD574 \uC8FC\uACE0 \uC2F6\uC5B4\uC11C\\n\uAE38\uC744 \uB9C9\uACE0 \uC788\uB358 \uAC74\uAC00...?[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD765\\c\\n\uC2DC\uC2DC\uD55C \uB140\uC11D\uB4E4\uC744 \uC0C1\uB300\uD558\uB294 \uC77C\uC740\\n\uC57D\uD55C \uD2B8\uB808\uC774\uB108\uB4E4\uC5D0\uAC8C \uB9E1\uAE30\uB294\\r\\n\uC800\uC758 \uD310\uB2E8\uC740 \uC633\uC558\uB358 \uBAA8\uC591\uC774\uAD70\uC694[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB9CE\uC774 \uD798\uB4E4\uC5C8\uACA0\uAD6C\uB098 \uD0C4\uCC28\uACE4\\n\uB108\uB294 \uD3EC\uCF13\uBAAC\uC7A1\uC744 \uD558\uB358 \uC911\uC774\uC5C8\uB2C8?\\c\\n\uC790 \uAC00\uC11C \uBC14\uC704\uB97C \uBD80\uC218\uACE0\\n\uD2B8\uB808\uC774\uB108\uC758 \uACC1\uC73C\uB85C \uB3CC\uC544\uAC00\uB834[VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uACE0\uC628~!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uAE38\uAE4C\uC9C0 \uB9CC\uB4E4\uC5B4\uC8FC\uB2E4\uB2C8...\\n\uB2F9\uC2E0\uB4E4\uBCF4\uB2E4 \uD3EC\uCF13\uBAAC\uC774 \uB354 \uB3C4\uC6C0\uC774 \uB418\uB124\uC694\\c\\n\uBB50 \uADF8\uB807\uC9C0\uB9CC \uC610\uB2E8\uC744 \uC815\uB9AC\uD574\uC900\\n\uC0C1\uC73C\uB85C \uC774\uAC78 \uB4DC\uB9AC\uB3C4\uB85D \uD558\uC8E0[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB50\uC57C \uC800 \uB140\uC11D...![VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uC5D0 \uADF8 \uD0C4\uCC28\uACE4...\\n\uBB34\uC0AC\uD788 \uD2B8\uB808\uC774\uB108\uB97C \uB9CC\uB0AC\uC744\uAE4C?[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0...\\n\uC21C\uBB34\uB2D8\uC740 \uC5B4\uB514\uC5D0 \uC788\uB294 \uAC70\uC9C0?[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC610\uB2E8! \uD2B8\uB808\uC774\uB2DD\uC5D0\\n\uC5B4\uC6B8\uB824\uC918\uC11C \uACE0\uB9D9\uB2E4!\\c\\n\uB2E4\uB9CC... \uC77C\uD558\uB294 \uD0C4\uCC28\uACE4\uC744\\n\uBC29\uD574\uD558\uB294 \uAC74 \uC6A9\uC11C\uD560 \uC218 \uC5C6\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uBC29\uD574\uB77C\uB1E8 \uADF8\uB7F4 \uB9AC\uAC00\uC694!\\n\uC774\uAC74 \uD0C4\uCC28\uACE4\uC744 \uC751\uC6D0\uD558\uB294 \uAC70\uB77C\uAD6C\uC694...[VAR 0114(0043)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5B4\uCA0C\uB4E0 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0\uC11C\\n\uCC98\uCC38\uD558\uAC8C \uB2F9\uD588\uC73C\uB2C8\uAE4C\\r\\n\uC6B0\uB9AC \uC610\uB2E8\uC740 \uC774\uB9CC \uC0AC\uB77C\uC9C0\uACA0\uC2B5\uB2C8\uB370\uC5D8...[VAR 0114(0044)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uACE0\uC628~!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC751\uC6D0\uD558\uB294 \uAC74 \uC88B\uC9C0\uB9CC\\n\uBC29\uD574\uAC00 \uB418\uBA74 \uC548 \uB41C\uB2E4\uB294 \uAC78 \uBA85\uC2EC\uD558\uB3C4\uB85D![VAR 0114(0010)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8... \uBA4B\uC9C0\uB2E4!\\n\uC5ED\uC2DC \uBD88\uAF43\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB108\uD76C\uB294 \uB2E8\uB378\uC774 \uCD94\uCC9C\uD55C\\n\uD638\uBE0C\uC640 [VAR 0100(0000)][VAR 1900(0006)]\uAD6C\uB098!\\c\\n\uB098\uB294 \uC9C0\uAE08 \uB108\uD76C\uB4E4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC640\\n\uCD5C\uACE0\uC758 \uC2B9\uBD80\uB97C \uD558\uAE30 \uC704\uD574\\r\\n\uD55C\uACC4\uAE4C\uC9C0 \uB2E8\uB828\uD558\uB294 \uC911\uC774\uB780\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uBD88\uAF43\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC73C\uB85C\\n\uC2F8\uC6B0\uB294 \uB0B4\uAC8C\\c\\n\uBB3C\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774 \uC788\uB294 \uC81C2\uAD11\uC0B0\uC740\\n\uCD5C\uC801\uC758 \uC218\uD589\uC7A5\uC18C\uC9C0![VAR 0114(0010)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uC2DC\uAC04\uC774 \uB2A6\uC5C8\uAD6C\uB098\\c\\n\uC81C2\uAD11\uC0B0\uC744 \uBE60\uC838\uB098\uAC00\uC11C\\n\uC9C1\uC9C4\uD558\uBA74 \uC5D4\uC9C4\uC2DC\uD2F0\uB780\uB2E4\\c\\n\uD638\uD154\uB85C \uB3CC\uC544\uAC00\uC11C \uD479 \uC26C\uACE0\\n\uCEE8\uB514\uC158\uC744 \uC815\uBE44\uD558\uB824\uBB34\uB098![VAR 0114(0010)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC790 \uD0C4\uCC28\uACE4\uB3C4 \uB3CC\uC544\uAC00\uC790\uAFB8\uB098\\n\uB0B4\uAC00 \uBC14\uB798\uB2E4\uC904 \uD14C\uB2C8 \uB9D0\uC774\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uACE0\uACE0\uC628~!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB0B4\uC77C\uC740 \uD65C\uD65C \uD0C0\uC624\uB97C \uAC70\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uD615\uC774 \uB9D0\uD55C \uC801\uC774 \uC788\uC5B4\\c\\n\uC21C\uBB34\uB2D8\uC744 \uC774\uAE30\uC9C0 \uBABB\uD574\uC11C \uD3EC\uAE30\uD558\uB294\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00 \uB9CE\uB2E4\uACE0 \uB9D0\uC774\uC57C[VAR 0114(0005)]"
  },
