    "index": 0,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 \uB370\uB9AC\uACE0 \uC788\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294\\n\uD2B8\uB808\uC774\uB108\uB77C\uACE0 \uD560 \uC218 \uC5C6\uC5B4!\\c\\n\uD3EC\uCF13\uBAAC\uC744 \uD0A4\uC6B0\uACE0 \uC2F8\uC6B0\uAC8C \uD574\uC57C\\n\uC9C4\uC9DC \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB77C \uD560 \uC218 \uC788\uC9C0![VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB108\uD76C\uAC00 \uC9C4\uC9DC \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uC778\uC9C0\\n\uB0B4\uAC00 \uC9C0\uCF1C\uBD10 \uC904\uAC8C\\c\\n\uB458\uC774\uC11C \uC2B9\uBD80\uD574\uBCF4\uB834!\\n\uC900\uBE44\uB410\uC73C\uBA74 \uB0B4\uAC8C \uC54C\uB824\uC918[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB124 \uC778\uC0DD \uCD5C\uCD08\uC758\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uC2DC\uC791\uD560 \uC900\uBE44\uB294 \uB410\uB2C8?[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC870\uC5B8 \uD558\uB098 \uD560\uAC8C!\\c\\n\uC9C0\uAE08\uAE4C\uC9C0 \uC788\uC5C8\uB358 \uC77C\uC744 \uC78A\uC9C0 \uC54A\uB3C4\uB85D\\n\uB9AC\uD3EC\uD2B8\uB97C \uC368\uB450\uB294 \uAC8C \uC88B\uC744 \uAC70\uC57C[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD30C\uD2B8\uB108 \uD3EC\uCF13\uBAAC\uC744 \uBBFF\uACE0!\\n\uC9C4\uC2EC\uC73C\uB85C \uC18C\uC911\uD788 \uB300\uD558\uB294 \uAC70\uC57C!\\c\\n\uADF8\uB807\uAC8C \uD558\uBA74 \uD3EC\uCF13\uBAAC\uC758\\n\uAC15\uD568\uC744 \uBCF4\uC5EC\uC904 \uAE30\uC220\uC744 \uC120\uD0DD\uD560 \uC218 \uC788\uC744 \uAC70\uACE0\\r\\n\uBB34\uC5C7\uBCF4\uB2E4\uB3C4 \uC2B9\uBD80\uB97C \uC990\uAE38 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC88B\uC544! \uD3EC\uCF13\uBAAC\uB3C4 \uD2B8\uB808\uC774\uB108\uB3C4\\n\uB2E4\uB4E4 \uC900\uBE44\uB410\uC9C0? \uADF8\uB7FC \uC2DC\uC791\uD574\uBCF4\uC790!![VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD615\uC758 \uC2DC\uD569\uC740 \uC804\uBD80 \uBD24\uC5B4!\\c\\n\uADF8\uB9AC\uACE0 \uD615\uC774 \uBC29\uC5D0 \uB450\uACE0 \uAC04\\n\uCC45\uC774\uB791 \uC7A1\uC9C0\uB3C4 \uBAA8\uB450 \uC77D\uC5B4\uC11C\\r\\n\uC5B4\uB5BB\uAC8C \uD558\uBA74 \uC774\uAE38 \uC218 \uC788\uC744\uC9C0 \uC798 \uC54C\uC544![VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB108 \uC815\uB9D0 \uAD49\uC7A5\uD558\uB2E4!\\n\uD615\uC774 \uD3EC\uCF13\uBAAC\uC744 \uC900 \uC774\uC720\uB97C \uC54C\uACA0\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD615\uC774 \uB124\uAC8C \uD3EC\uCF13\uBAAC\uC744 \uC92C\uC9C0\uB9CC\\n\uCD5C\uAC15\uC740 \uC5ED\uC2DC \uB098\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB450 \uC0AC\uB78C\uC758 \uD3EC\uCF13\uBAAC\uB4E4 \uBAA8\uB450\\n\uB098\uC774\uC2A4 \uD30C\uC774\uD2B8! \uAD7F \uD30C\uC774\uD2B8!\\c\\n\uB098\uB3C4 \uBAA8\uB974\uAC8C \uB9AC\uC790\uBABD\uC744 \uAEBC\uB0B4\uC11C\\n\uB07C\uC5B4\uB4E4 \uBED4\uD588\uC5B4...\\c\\n[VAR 0101(0001)]\uB3C4 \uC218\uACE0\uD588\uC5B4!\\n\uC790 \uAC74\uAC15\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC904\uAC8C[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uB108\uC5D0\uAC8C \uC7A5\uB798\uC131\uC774 \uBCF4\uC5EC\uC11C \uD558\uB294 \uBD80\uD0C1\uC774\uC57C!\\c\\n\uD638\uBE0C\uC758 \uB77C\uC774\uBC8C\uC774 \uB3FC\uC11C\\n\uB458\uC774 \uD568\uAED8 \uAC15\uD574\uC9C0\uB3C4\uB85D \uD574!![VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[VAR 0101(0002)]\uB3C4 \uB098\uB3C4\\n\uC758\uC695\uC774 \uB118\uCE58\uACE0 \uC788\uC5B4![VAR 0114(0005)]"
  }
