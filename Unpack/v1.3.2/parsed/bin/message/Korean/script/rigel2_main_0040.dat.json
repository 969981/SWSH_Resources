    "text": "[~ 1]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uC5D0 \uB300\uD55C\\n\uC124\uBA85\uC744 \uB4E4\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7EC\uC9C0 \uB9D0\uACE0 \uC880 \uB3C4\uC640\uC8FC\uB77C!\\n\uBD80\uD0C1\uD560\uAC8C \uCE5C\uAD6C\uC57C~!![VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC800\uBD84\uC740 \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8\uC2DC\uACE0\\n\uC81C\uB300\uB85C \uC900\uBE44\uAC00 \uB41C \uB2E4\uC74C\uC5D0\\r\\n\uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC138\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC624\uC624! \uADF8\uB798\uC57C \uB0B4 \uCE5C\uAD6C\uC9C0!\\n\uC815\uB9D0 \uACE0\uB9D9\uB2E4!![VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "...\uADF8\uB7FC\\n\uC124\uBA85\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74\uC740\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC5D0\uC11C \uBCF8 \uC801 \uC5C6\uB294\\c\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uB3C4\\n\uC11C\uC2DD\uD558\uACE0 \uC788\uB294 \uC9C0\uD558 \uBBF8\uAD81..."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC5EC\uB7EC\uBD84\uC774 \uB370\uB9AC\uACE0 \uACC4\uC2E0 \uD3EC\uCF13\uBAAC\uC740\\n\uAC00\uB77C\uB974\uD30C\uD2F0\uD074\uC5D0 \uBC18\uC751\uD574\uC11C\\r\\n\uD3ED\uC8FC\uD560 \uAC00\uB2A5\uC131\uC774 \uC788\uAE30 \uB54C\uBB38\uC5D0"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD30C\uD2F0\uD074\uB85C \uC778\uD55C \uC601\uD5A5\uC744 \uC5B5\uC81C\uD560 \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uC800\uD76C \uCABD\uC5D0\uC11C \uC900\uBE44\uD574\uB450\uC5C8\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC74C? \uB2E4\uC2DC \uB9D0\uD574 \uC774\uB7F0 \uC774\uC57C\uAE30\uC9C0?\\c\\n4\uBA85\uC758 \uB0B4\uAC00 \uD3ED\uC8FC\uD558\uBA74\\n\uC548\uC804\uD558\uAC8C \uB80C\uD0C8\uB3FC\uC11C\\r\\n\uB108\uD76C\uB4E4\uC758 \uD76C\uADC0\uD55C \uAC00\uB2A5\uC131\uC744 \uC54C \uC218 \uC788\uB2E4!?[VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC644\uC804\uD788 \uD2C0\uB838\uC2B5\uB2C8\uB2E4\uB9CC..."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC704\uD5D8\uD55C \uC7A5\uC18C\uB2C8\uAE4C\\n\uB8F0\uC744 \uC798 \uAE30\uC5B5\uD574\uB450\uC2DC\uB77C\uAD6C\uC694!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBB50\uAC00 \uBB54\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uC544\uBB34\uD2BC \uADF8\uB7F0 \uC7A5\uC18C\uB77C\uB294 \uAC70\uC9C0![VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC5D0\uC787!\\n\uB098\uD55C\uD14C\uB294 \uB108\uBB34 \uC5B4\uB824\uC6B4 \uC774\uC57C\uAE30\uC57C!\\r\\n\uADF8\uB0E5 \uB4E4\uC5B4\uAC08 \uD14C\uB2E4![VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB2C8\uC544\uC544\uC544\uC544~!!\\n\uC9C0\uAE08 \uB2F9\uC7A5 \uAC04\uB2E4\uC544\uC544\uC544~!![VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC557! \uC800\uAE30\uC694!!\\n\uC704\uD5D8\uD558\uB2E4\uB2C8\uAE4C\uC694!!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC800\uBD84\uC740 \uB300\uCCB4\\n\uBB50 \uD558\uB294 \uC0AC\uB78C\uC774\uC8E0?\\c\\n\uC0DD\uAE34 \uAC74 \uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC774\uB791\\n\uB611\uAC19\uC774 \uC0DD\uACBC\uB294\uB370..."
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBC29\uAE08 \uADF8\uBD84\uC744 \uCAD3\uC544\uAC00\uAE30 \uC704\uD574\uC11C\\n...\uAC00 \uC544\uB2C8\uACE0\\c\\n\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uB97C \uD558\uC2E4 \uAC70\uB77C\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC138\uC694"
  }
]
