[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624? \uB108\uB294...[VAR 0114(0016)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC624\uC624~ \uCC54\uD53C\uC5B8!\\n\uC640\uC8FC\uC168\uAD70\uC694[VAR 0114(000E)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774\uC5D0\uC694?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC624\uB79C\uB9CC\uC774\uC5D0\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAF64 \uC5EC\uC720\uB85C\uC6B4\uAC78\\c\\n\uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC740\\n\uB2E4\uC774\uB9E5\uC2A4\uBCF4\uB2E4\uB3C4 \uD070 \uAC70\uBB3C\uC774\uAD70[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC2E4\uC740 \uB9D0\uC774\uC8E0 \uB450\uC1A1\uB2D8\uACFC\\n\uC2DC\uBC94 \uACBD\uAE30\uB97C \uD558\uB358 \uC911\uC5D0\\c\\n\uD2B8\uB808\uC774\uB108\uB97C \uC54C \uC218 \uC5C6\uB294\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uB09C\uC785\uD55C \uAC70 \uC788\uC8E0[VAR 0114(000E)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAD00\uAC1D\uACFC \uC2A4\uD0DC\uD504\uB4E4\uC740\\n\uBAA8\uB450 \uD53C\uB09C\uC2DC\uCF30\uC5B4[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAC38~\uC559!!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBD81\uCABD\uC5D0 \uC788\uB294 \uAD00\uAC1D\uB4E4\\n\uBAA8\uB450 \uD53C\uB09C\uC744 \uB9C8\uCCE4\uC5B4\uC694!\\c\\n...\uB4E4\uB9AC\uC2DC\uACA0\uC9C0\uB9CC\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC740 \uC544\uC9C1 \uB0A0\uB6F0\uACE0 \uC788\uC5B4\uC694![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB3C4\uC640\uC8FC\uC154\uC11C \uACE0\uB9D9\uC2B5\uB2C8\uB2E4 \uD638\uBE0C\uB2D8\\n\uC5ED\uC2DC \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\\r\\n\uBBFF\uC74C\uC9C1\uC2A4\uB7FD\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC804 \uC138\uBBF8\uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C\\n\uC84C\uC9C0\uB9CC\uC694...[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC544! [VAR 0100(0000)]![VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBE68\uAC04 \uB140\uC11D\uC774\uB791 \uD30C\uB780 \uB140\uC11D\uC744\\n\uB4A4\uCAD3\uB2E4\uAC00 \uD130\uD504\uC2A4\uD0C0\uB514\uC6C0\uC5D0\\r\\n\uB140\uC11D\uB4E4\uC774 \uB4E4\uC5B4\uAC00\uB294 \uAC78 \uBD24\uAC70\uB4E0[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uB798\uC11C \uB4A4\uB97C \uBC1F\uACE0 \uC788\uC5C8\uB294\uB370\\n\uAC11\uC790\uAE30 \uC774\uB7F0 \uB09C\uB9AC\uAC00 \uB098\uC11C\\c\\n\uBB34\uC2DC\uD560 \uC218\uB3C4 \uC5C6\uACE0 \uD574\uC11C\\n\uB3D5\uACE0 \uC788\uC5C8\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uADF8\uB798\uC11C \uB9D0\uC778\uB370... \uBBF8\uC548!\\n\uB140\uC11D\uB4E4\uC744 \uB193\uCE58\uACE0 \uB9D0\uC558\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD750\uC74C \uD638\uBE0C\uB2D8\uC774 \uBC1C\uACAC\uD55C\\n\uC218\uC0C1\uD55C \uC778\uBB3C\uB3C4 \uC2E0\uACBD \uC4F0\uC774\uC9C0\uB9CC[VAR 0114(000E)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC77C\uB2E8\uC740 \uC9C0\uAE08\uB3C4 \uB0A0\uB6F0\uACE0 \uC788\uB294\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744\\r\\n\uC58C\uC804\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC57C \uD574\uC694[VAR 0114(000E)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB9E4\uC6B0 \uBC84\uAC70\uC6B4\\n\uC0C1\uB300\uB77C\uC11C\uC694\\c\\n\uCC54\uD53C\uC5B8\uC778 [VAR 0100(0000)]\uB2D8\uB3C4\\n\uB3C4\uC640\uC8FC\uC2DC\uBA74 \uAC10\uC0AC\uD558\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(000E)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC8E0!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC7A0\uAE50\uB9CC\uC694"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBC30\uD2C0\uCF54\uD2B8\uB85C \uAC00\uC8E0[VAR 0114(000E)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB098\uB3C4 \uB3C4\uC640\uC904\uAC8C[VAR 0114(0016)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC8C4\uB294 \uC5C6\uC9C0\uB9CC\\n\uC2A4\uD14C\uC774\uC9C0\uB97C \uBC29\uD574\uD55C \uAC83\uC740\\r\\n\uC870\uAE08 \uC6A9\uC11C\uD558\uAE30 \uD798\uB4DC\uB2C8\uAE4C[VAR 0114(0016)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC790, \uC804 \uCC54\uD53C\uC5B8\uC758 \uB3D9\uC0DD\uC544\\n\uB108\uB3C4 \uB530\uB77C\uC624\uB834[VAR 0114(0016)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uB530\uB77C\uAC04\uB2E4\uACE0\\n\uB3C4\uC6C0\uC774 \uB420\uAE4C\uC694...[VAR 0114(0005)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uBAA8\uB450\uC758 \uBC1C\uBAA9\uC744\\n\uBD99\uC7A1\uC744\uC9C0\uB3C4 \uBAA8\uB974\uB294\uB370...[VAR 0114(0005)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB0B4 \uC0DD\uAC01\uC774\uAE34 \uD558\uC9C0\uB9CC\\n\uB2E8\uB378\uC774\uB77C\uBA74 \uB9DD\uC124\uC774\uC9C0 \uC54A\uC558\uC744 \uAC70\uC57C\\c\\n...\uAE38 \uCC3E\uB294 \uC77C\uC5D0\uB294 \uC790\uC8FC \uB9DD\uC124\uC774\uAE34 \uD558\uC9C0\uB9CC[VAR 0114(0016)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uAC08 \uAC70\uC9C0?[VAR 0114(0016)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC544... \uC54C\uC558\uC5B4\uC694![VAR 0114(0005)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8\uC740 \uC624\uBE60\uB77C\uC11C \uADF8\uB7F0\uC9C0\\n\uC5EC\uB7EC\uBAA8\uB85C \uB0A8\uB4E4\uC744 \uC798 \uCC59\uACA8\uC8FC\uC2DC\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC790 \uADF8\uB7FC \uC800\uD76C\uB3C4 \uAC00\uBCFC\uAE4C\uC694?[VAR 0114(000E)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB124! \uC900\uBE44\uB294 \uD655\uC2E4\uD558\uACE0\\n\uB4E0\uB4E0\uD558\uAC8C \uD574\uB46C\uC57C \uD558\uB2C8\uAE4C\uC694[VAR 0114(000E)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uACFC \uC2F8\uC6B8\\n\uC900\uBE44\uB294 \uB418\uC5C8\uB098\uC694?[VAR 0114(000E)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 \uC774\uC6A9\uD574\uC11C \uC2A4\uD14C\uC774\uC9C0\uB97C\\n\uC5C9\uB9DD\uC73C\uB85C \uB9CC\uB4E0 \uD2B8\uB808\uC774\uB108\\r\\n\uC7A1\uD788\uBA74 \uAC00\uB9CC\uB450\uC9C0 \uC54A\uACA0\uC5B4[VAR 0114(0016)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC774\uAC83 \uB9D0\uACE0 \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uAC8C\\n\uBB50\uAC00 \uC788\uC744\uAE4C...?[VAR 0114(0005)]"
  }
]
