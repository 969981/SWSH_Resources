  {
    "index": 5,
    "flags": 0,
    "text": "\uC5BC\uAE30\uC124\uAE30...\\n\uC5BC\uAE30\uC124\uAE30..."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC790, \uB2E4 \uB410\uB2E4!\\n\uAE08\uBC29 \uB9CC\uB4E4\uC5C8\uC9C0?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC57C\uB3C8\uC5D0\uAC8C \uC815\uB9D0 \uC798 \uC5B4\uC6B8\uB9B4 \uAC8C\uB2E4\\c\\n\uB354 \uAC00\uC9C0\uACE0 \uC2F6\uC73C\uBA74\\n\uAC00\uB77C\uB450\uAD6C\uAC00\uC9C0\uB97C \uAC00\uC838\uC624\uB824\uBB34\uB098"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC624\uC624! \uADF8 \uBAA8\uC2B5\uC740 \uC57C\uB3C4\uD0B9!\\c\\n\uAC00\uB77C\uB450\uAD6C\uBA38\uB9AC\uC7A5\uC2DD\uC744 \uC50C\uC6CC\uC92C\uB098 \uBCF4\uAD6C\uB098\\n\uADF8\uB7FC \uC774 \uC154\uCE20\uB3C4 \uBC1B\uC544\uC8FC\uAC70\uB77C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD638\uC624~ \uADF8 \uBAA8\uC2B5\uC740 \uC57C\uB3C4\uD0B9 \uC544\uB2C8\uB0D0!\\c\\n\uB2E4\uB978 \uC9C0\uBC29\uC758 \uC57C\uB3C4\uD0B9\uB3C4\\n\uC704\uC5C4\uC774 \uCCA0\uCCA0 \uD750\uB974\uB294\uAD6C\uBA3C"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD30C\uD2F0\uC5D0 \uC798 \uC5B4\uC6B8\uB9AC\uB294\\n\uBA4B\uC9C4 \uB514\uC790\uC778\uC774\uB780\uB2E4"
