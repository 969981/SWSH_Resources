    "text": "\uC870\uAE08 \uAC10\uB3D9\uD588\uC5B4[VAR 0114(000D)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBCF4\uACE0 \uC788\uC5C8\uAD6C\uB098 \uB3D9\uC0DD\uC544... \uADF8\uB807\uC9C0\uB9CC\\n\uC774\uB807\uAC8C \uC9C4 \uC774\uC0C1 \uB124\uAC00 \uBC30\uC6B8 \uAC74 \uC5C6\uC744 \uAC70\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB09C \uC5EC\uD0DC\uAE4C\uC9C0 \uC624\uBE60\uC758 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uBCF4\uBA74\uC11C\\n\uC2F8\uC6B0\uB294 \uBC95\uC744 \uBC30\uC6E0\uC5C8\uAC70\uB4E0?[VAR 0114(000D)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7AC\uC5C8\uB098?\\c\\n\uADF8\uB807\uC9C0 \uB9C8\uB9AC\\n\uB108\uC5D0\uAC8C \uD574\uC904 \uB9D0\uC774 \uC788\uB2E8\uB2E4[VAR 0114(0016)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744\\n\uB108\uC5D0\uAC8C \uBB3C\uB824\uC8FC\uACE0 \uC2F6\uC5B4[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC751 \uC774\uBBF8 \uC54C\uACE0 \uC788\uC5B4\\c\\n\uC624\uBE60\uAC00 \uC774\uBC88 \uB300\uD68C\uC5D0\uC11C\\n\uC740\uD1F4\uD560 \uC0DD\uAC01\uC774\uB77C\uB294 \uAC83\uCBE4\uC740 \uB9D0\uC774\uC57C[VAR 0114(000D)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC624\uAE30\uB85C\uB77C\uB3C4 \uB2E4\uC774\uB9E5\uC2A4\uB97C \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uACE0\\n\uC9C0\uAE08\uAE4C\uC9C0 \uC798 \uC2F8\uC6CC\uC654\uC796\uC544[VAR 0114(000D)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uC624\uBE60\uB97C \uC88B\uC544\uD558\uC9C0\uB9CC\\n\uB300\uB2F5\uC740 NO! \uC57C[VAR 0114(000D)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC65C\uB0D0\uD558\uBA74 \uB098\uB294\\n\uCC54\uD53C\uC5B8\uC774 \uB420 \uAC70\uB2C8\uAE4C!\\r\\n\uADF8\uB7EC\uBA74 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC740 \uD560 \uC218 \uC5C6\uC796\uC544[VAR 0114(000D)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB798 \uADF8\uB807\uC9C0\\c\\n\uADF8\uB7FC \uB124\uAC00 \uCC54\uD53C\uC5B8\uC774 \uB420 \uC218 \uC788\uC744\uC9C0\\n\uC774 \uC624\uBE60\uB294 \uC9C0\uCF1C\uBCF4\uB3C4\uB85D \uD560\uAC8C[VAR 0114(0016)]"
  },
  {
    "index": 10,
