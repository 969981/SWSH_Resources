    "text": "\uC18C\uC911\uD558\uAC8C \uD0A4\uC6CC\uC918!"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 \uAC00\uB4DD\uD558\uAD6C\uB098...\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774\uB098 \uBC15\uC2A4\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC815\uB9AC\uD558\uACE0 \uB2E4\uC2DC \uC640 \uC918"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uAC00\uC838\uB3C4 \uB41C\uB2E4\uB294 \uAC70\uC57C?\\n\uC0AC\uC2E4\uC740 \uAC16\uACE0 \uC2F6\uC9C0?"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB0B4\uAC00 \uAC00\uC9C8\uAC8C\\n\uACE0\uB9C8\uC6CC"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\uC5EC\uAE30\uB294 \uB9E1\uAE30\uBBF8\uC9D1\\c\\n\uD3EC\uCF13\uBAAC\uC744 2\uB9C8\uB9AC\uAE4C\uC9C0\\n\uB9E1\uAE38 \uC218 \uC788\uC5B4"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\uC5EC\uAE30\uB294 \uB9E1\uAE30\uBBF8\uC9D1\\n\uC5B4\uB5BB\uAC8C \uD560\uB798?"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\uC5EC\uAE30\uB294 \uB9E1\uAE30\uBBF8\uC9D1\\n\uCC54\uD53C\uC5B8 \uC5B4\uB5BB\uAC8C \uD560\uB798?"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB610 \uC640\uC918"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uC5EC\uB3D9\uC0DD\uC774 \uB108\uB97C \uCC3E\uACE0 \uC788\uC5B4!"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uADF8 \uD3EC\uCF13\uBAAC\uC744 \uB9E1\uAE30\uBA74\\n\uC2F8\uC6B8 \uC218 \uC5C6\uAC8C \uB3FC\\c\\n\uB2E4\uC74C\uC5D0 \uB2E4\uC2DC \uC640"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uC5B4\uB290 \uC544\uC774\uB97C \uB9E1\uAE38\uB798?"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uC5B4\uBA38 \uC5B4\uBA38!\\n\uADF8\uAC83\uC740 \uC54C\uC774\uC57C!"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uADF8\uB7FC [VAR 0101(0000)][VAR 1900(0002)]\\n\uB2F9\uBD84\uAC04 \uB9E1\uC544\uC904\uAC8C"
  },
  {
    "index": 78,
    "flags": 0,
    "text": "\uC801\uB2F9\uD788 \uC2DC\uAC04\uC774\\n\uC9C0\uB098\uBA74 \uB2E4\uC2DC \uC640\uC918"
  },
  {
    "index": 79,
    "flags": 0,
    "text": "2\uB9C8\uB9AC\uAE4C\uC9C0 \uB9E1\uC744 \uC218 \uC788\uB294\uB370\\n1\uB9C8\uB9AC \uB354 \uB9E1\uACA8 \uBCFC\uB798?"
  },
  {
    "index": 80,
    "flags": 0,
    "text": "\uB124 \uD3EC\uCF13\uBAAC\uC740 \uC798 \uC788\uC5B4\\n\uC5B4\uB5BB\uAC8C \uD560\uB798? \uB370\uB9AC\uACE0 \uAC08 \uAC70\uC57C?"
