  },
  {
    "index": 84,
    "flags": 0,
    "text": "[VAR 0100(0001)][VAR 1900(0001)] \uB9E1\uAE30\uBBF8\uC9D1\uC5D0\uC11C\\n[VAR 0101(0000)][VAR 1900(0002)] \uB370\uB9AC\uACE0 \uC654\uB2E4!"
  },
  {
    "index": 85,
    "flags": 0,
    "text": "\uB2E4\uB978 1\uB9C8\uB9AC\uB3C4 \uB370\uB9AC\uACE0 \uAC08\uB798?"
  },
  {
    "index": 86,
    "flags": 0,
    "text": "\uC5B4\uBA38? \uB108\\n\uADF8 \uD3EC\uCF13\uBAAC\uC744 \uB9E1\uAE30\uBA74\\c\\n\uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBC16\uC5D0\\n\uB0A8\uC9C0 \uC54A\uAC8C \uB3FC\\c\\n\uC880 \uB354 \uB9CE\uC774 \uC7A1\uC740 \uB4A4\uC5D0\\n\uC640\uC918"
  },
  {
    "index": 87,
    "flags": 0,
