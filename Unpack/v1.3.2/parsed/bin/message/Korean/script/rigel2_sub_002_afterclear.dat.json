    "text": "[VAR 0101(0006)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC74C? \uC804\uC124\uC744 \uBCF4\uC5EC\uC8FC\uAE30\\n\uC2EB\uC5B4\uC9C4 \uAC70\uC57C?\\r\\n\uADF8\uC544\uD558\uD558! \uADF8\uB7F4 \uB54C\uB3C4 \uC788\uB294 \uAC70\uC9C0 \uBB50![VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC720\uC804\uC790 \uC870\uC791\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC9C4\\n\uB09C\uD3ED\uD55C \uD3EC\uCF13\uBAAC \uBBA4\uCE20\uB77C\uACE0?\\c\\n\uC548\uC0C9\uC774 \uC57D\uAC04 \uCC3D\uBC31\uD55C \uB370\uB2E4\uAC00\\n\uC5B4\uC9F8 \uC58C\uC804\uD574 \uBCF4\uC774\uB294\uB370!\\c\\n\uD45C\uC815\uC740 \uC880 \uAE4C\uD0C8\uC2A4\uB7EC\uC6CC \uBCF4\uC774\uC9C0\uB9CC\\n\uBD84\uBA85\uD788 \uC18D\uC740 \uCC29\uD55C \uB140\uC11D\uC77C \uAC70\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC654\uAD6C\uB098!\\n\uC774\uC0C1\uD55C \uD504\uB9AC\uC838 \uB140\uC11D!\\c\\n\uC774\uC0C1\uD55C \uB9C8\uC2A4\uD06C\uB97C \uC4F0\uACE0 \uC788\uC5B4\uC11C\\n\uC5EC\uC804\uD788 \uBB58 \uC0DD\uAC01\uD558\uACE0 \uC788\uB294\uC9C0 \uBAA8\uB974\uACA0\uC5B4...\\c\\n\uC5B4\uC9F8 \uC880 \uC595\uBCF4\uC774\uACE0 \uC788\uB294 \uB4EF\uD55C\\n\uB290\uB08C\uC774 \uB4DC\uB294 \uAC74 \uAE30\uBD84 \uD0D3\uC774\uACA0\uC9C0?[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC6B0\uC653!? \uC774\uC0C1\uD55C \uD504\uB9AC\uC838 \uB140\uC11D\\n\uB4DC\uB514\uC5B4 \uC774\uC0C1\uD55C \uB9C8\uC2A4\uD06C\uB97C \uBC97\uC5C8\uAD6C\uB098!\\c\\n\uC57C\uBB34\uC9C4 \uB208\uB9E4\uAC00 \uBCF4\uC774\uB2C8\uAE4C\\n\uC774\uCABD\uC774 \uD6E8\uC52C \uB354 \uC778\uAE30\uAC00 \uB9CE\uC744 \uAC83 \uAC19\uC544!\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uAC11\uC790\uAE30 \uCD94\uC6CC\uC84C\uB124...\\n\uBC16\uC5D0 \uB208\uC774\uB77C\uB3C4 \uB0B4\uB9AC\uB098?[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC654\uAD6C\uB098!\\n\uC774\uC0C1\uD55C \uC36C\uB354 \uB140\uC11D!\\c\\n\uBFB0\uC871\uBFB0\uC871\uD55C \uBAB8\uC5D0\\n\uBD80\uB9AC\uAE4C\uC9C0 \uBFB0\uC871\uD558\uAC8C \uAC08\uC544\uC11C\\c\\n\uC5B4\uB5BB\uAC8C\uB4E0 \uC36C\uB354\uAC00 \uB418\uACE0 \uC2F6\uC5B4\uD558\uB294\\n\uADF8 \uB178\uB825\uB9CC\uD07C\uC740 \uC778\uC815\uD558\uACA0\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC6B0\uC653!? \uC774 \uB140\uC11D\\n\uB9CC\uC9C0\uB2C8\uAE4C \uCC0C\uB9BF\uCC0C\uB9BF\uD558\uC796\uC544!\\c\\n\uC774\uC0C1\uD55C \uC36C\uB354 \uB140\uC11D\uD55C\uD14C\\n\uC815\uC804\uAE30\uB77C\uB3C4 \uC77C\uC5B4\uB09C \uAC74\uAC00!?\\c\\n\uCDA5\uACE0 \uAC74\uC870\uD574\uC11C \uADF8\uB7F0\uC9C0\\n\uC815\uC804\uAE30\uAC00 \uC5C4\uCCAD\uB098\uAC8C \uC138\uB124...[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC654\uAD6C\uB098!\\n\uC774\uC0C1\uD55C \uD30C\uC774\uC5B4 \uB140\uC11D!\\c\\n\uC5B4\uB834\uD48B\uC774 \uD0C0\uACE0 \uC788\uB294 \uAC83 \uAC19\uC9C0\uB9CC\\n\uC804\uD600 \uB728\uAC81\uC9C0 \uC54A\uB2E4\uACE0!\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB208\uBE5B\uC774 \uC5C4\uCCAD \uC0AC\uB098\uC6CC \uBCF4\uC774\uB294 \uAC8C\\n\uC5B4\uC9F8 \uCE5C\uADFC\uAC10\uC774 \uB4E4\uC5B4\uC11C \uBBF8\uC6CC\uD560 \uC218\uAC00 \uC5C6\uB124[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC6B0\uC653!? \uC774 \uB140\uC11D \uBAB8\uC774\\n\uD65C\uD65C \uD0C0\uACE0 \uC788\uC796\uC544!?\\c\\n\uC774\uC0C1\uD55C \uD30C\uC774\uC5B4 \uB108...\\n\uC5B4\uB514 \uC5F4\uC774\uB77C\uB3C4 \uC788\uB294 \uAC70\uC57C?\\c\\n\uC624\uB298\uC740 \uB530\uB73B\uD558\uAC8C \uD558\uACE0 \uD479 \uC790\uB77C\uACE0!\\n...\uC544\uBB34\uD2BC \uBAB8\uC870\uC2EC\uD574![VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC77C\uACF1 \uC0C9\uC758 \uB0A0\uAC1C\uB97C \uAC00\uC9C4\\n\uC804\uC124\uC758 \uD3EC\uCF13\uBAAC \uCE60\uC0C9\uC870\uB77C\uACE0?\\r\\n\uBE68\uAC15, \uD558\uC591, \uB178\uB791...\\c\\n\uC77C\uACF1 \uC0C9\uC774\uB77C\uAE30\uC5D4 \uC5B4\uC9F8 \uC870\uAE08\\n\uC0C9\uC774 \uBD80\uC871\uD55C \uAC83 \uAC19\uC740\uB370...\\c\\n\uB300\uC7A5\uC758 \uD658\uC0C1\uC744 \uAE68\uBC84\uB9AC\uBA74\\n\uBD88\uC30D\uD558\uB2C8\uAE4C \uBBFF\uC5B4\uC904\uAC8C![VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uBC14\uB2E4\uC758 \uC2E0\uC774\uB77C\uACE0 \uBD88\uB9AC\uB294\\n\uC804\uC124\uC758 \uD3EC\uCF13\uBAAC \uB8E8\uAE30\uC544\uB77C\uACE0?\\c\\n\uADF8\uB7F0 \uAC83 \uCE58\uACE0\uB294 \uBE44\uD589\uD0C0\uC785\uC774\uC796\uC544?\\n\uD5E4\uC5C4\uB3C4 \uCE58\uACE0 \uD558\uB298\uB3C4 \uB0A0\uACE0\\r\\n\uBB50\uB4E0\uC9C0 \uD560 \uC218 \uC788\uB2E4\uB2C8 \uAD49\uC7A5\uD558\uB124!\\c\\n\uBA38\uB098\uBA3C \uC9C0\uBC29\uC5D0 \uD3EC\uCF13\uC2AC\uB860\uC774\uB77C\uB294\\n\uC2A4\uD3EC\uCE20 \uC2DC\uC124\uC774 \uC788\uB294\uB370\\r\\n\uAC70\uAE30\uC11C\uB77C\uBA74 \uD06C\uAC8C \uD65C\uC57D\uD560 \uC218 \uC788\uACA0\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uBC88\uAC1C\uC640 \uD568\uAED8 \uB5A8\uC5B4\uC84C\uB2E4\uACE0\\n\uC804\uD574\uC9C0\uB294 \uD3EC\uCF13\uBAAC... \uB77C\uC774\uCF54\uB77C\uACE0?\\c\\n\uB108 \uC815\uB9D0 \uD070\uC77C\uC744 \uB2F9\uD588\uC5C8\uAD6C\uB098\\c\\n\uADF8\uB7AC\uC73C\uB2C8 \uB4F1\uC5D0 \uB2EC\uB9B0 \uD138\uB3C4\\n\uB3CC\uB3CC \uB9D0\uB9B4 \uC218\uBC16\uC5D0 \uC5C6\uC9C0[VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uD654\uC0B0\uC758 \uBD84\uD654\uB85C\uBD80\uD130 \uD0DC\uC5B4\uB0AC\uB2E4\uACE0\\n\uC804\uD574\uC9C0\uB294 \uD3EC\uCF13\uBAAC... \uC564\uD14C\uC774?\\c\\n\uC5D0\uC774, \uADF8\uB7F4 \uB9AC\uAC00 \uC788\uACA0\uC5B4!\\n\uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uBBFF\uC73C\uB77C\uB294 \uAC70\uC57C!\\c\\n\uADF8\uB807\uB2E4\uB294 \uAC74 \uB9D0\uC774\uC57C\\n\uC544\uBE60\uAC00 \uD654\uC0B0\uC774\uB77C\uB294 \uAC70\uC57C?\\c\\n\uC544\uB2C8\uBA74 \uC5C4\uB9C8\uAC00 \uD654\uC0B0\uC778 \uAC74\uAC00?[VAR 0114(0076)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC624! \uC544\uB984\uB2E4\uC6B4 \uD3EC\uCF13\uBAAC\uC774\uAD70!\\n\uC774 \uB140\uC11D\uC774 \uC2A4\uC774\uCFE4\uC774\uC57C?\\c\\n\uBA38\uB9AC\uC5D0 \uB2EC\uB9B0 \uACE0\uB9AC\uD615 \uBFD4\uC774\\n\uC644\uC804 \uBA4B\uC9C4\uB370!\\c\\n...\uADFC\uB370 \uBA38\uB9AC\uAC00 \uADF8\uB7EC\uBA74\\n\uC790\uB2E4\uAC00 \uBAB8\uC744 \uB4A4\uC9D1\uACE0 \uC2F6\uC744 \uB550 \uC5B4\uB5BB\uAC8C \uD558\uC9C0?\\c\\n\uC798 \uB54C \uC5C4\uCCAD \uBD88\uD3B8\uD558\uACA0\uB294\uB370?\\n\uC5B4\uC774 \uC2A4\uC774\uCFE4, \uB108 \uC7A0\uC740 \uC81C\uB300\uB85C \uC790\uACE0 \uC788\uB0D0?[VAR 0114(0076)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB300\uC9C0\uC758 \uD654\uC2E0\uC774\uB77C \uC804\uD574\uC9C0\uB294 \uD3EC\uCF13\uBAAC\\n\uADF8\uB780\uB3C8\uC774\uB77C\uACE0!?\\c\\n\uB9C8\uADF8\uB9C8 \uC18D\uC5D0\uC11C \uC794\uB2E4\uB294 \uC774\uC57C\uAE30\uB3C4\\n\uC0AC\uC2E4\uC774\uB77C\uBA74 \uB300\uBC15\uC774\uACA0\uC5B4!\\c\\n\uB098\uB3C4 \uC790\uC8FC \uC0AC\uC6B0\uB098\uC5D0 \uAC00\uB2C8\uAE4C\\n\uADF8 \uC2EC\uC815 \uC798 \uC54C\uAC70\uB4E0!\\c\\n\uBD84\uBA85\uD788 \uB9C8\uADF8\uB9C8\uC5D0\uC11C \uB098\uC62C \uB54C\\n\uC5C4\uCCAD\uB098\uAC8C \uAE30\uBD84 \uC88B\uC744 \uAC70\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uBC14\uB2E4\uB97C \uB9CC\uB4E4\uC5C8\uB2E4\uACE0 \uC804\uD574\uC9C0\uB294 \uD3EC\uCF13\uBAAC\\n\uAC00\uC774\uC624\uAC00\uB77C\uACE0!?\\c\\n\uADF8\uB807\uB2E4\uB294 \uAC74... \uBAA8\uB4E0 \uC0DD\uBA85\uC758 \uC5B4\uBA38\uB2C8\uC778\\n\uBC14\uB2E4\uC758 \uC5B4\uBA38\uB2C8\uB77C\uB294 \uAC70 \uC544\uB0D0!?\\c\\n\uADF8\uB7FC \uC6B0\uB9AC\uC5D0\uAC8C\uB294\\n\uD560\uBA38\uB2C8 \uAC19\uC740 \uC874\uC7AC\uC778 \uAC74\uAC00...?\\c\\n\uC774\uBD10 \uB300\uC7A5...\\n\uAC00\uC774\uC624\uAC00\uC5D0\uAC8C\uB294 \uBAA8\uCABC\uB85D \uC798 \uB300\uD574\uC8FC\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uBB50? \uB808\uCFE0\uC7C8?\\n\uC544\uB4DD\uD788 \uBA3C \uC0C1\uACF5\uC5D0 \uC788\uB294 \uC624\uC874\uCE35\uC5D0\\r\\n\uC11C\uC2DD\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774\uB77C\uACE0?\\c\\n\uADF8\uB807\uAC8C \uACF5\uAE30\uAC00 \uD76C\uBC15\uD55C \uACF3\uC5D0\uC11C\\n\uC0B4\uB2E4\uB2C8 \uC6B4\uB3D9\uC120\uC218\uB77C\uB3C4 \uB418\uB098?!\\c\\n\uBB50, \uD655\uC2E4\uD788 \uC5BC\uAD74\uC744 \uBCF4\uB2C8\uAE4C\\n\uD3C9\uBC94\uD558\uAC8C \uC0DD\uAE30\uC9C4 \uC54A\uC558\uB124!\\c\\n\uC885\uBAA9\uC774 \uBB54\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uC544\uBB34\uD2BC \uC5F4\uC2EC\uD788 \uD558\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD154\uB808\uD30C\uC2DC\uB85C \uC0AC\uB78C\uC758 \uB9C8\uC74C\uC744\\n\uAC10\uC9C0\uD558\uB294 \uD3EC\uCF13\uBAAC \uB77C\uD2F0\uC544\uC2A4\uB77C...\\c\\n\uC5BC\uAD74\uC740 \uC5B4\uC9F8 \uADC0\uC5EC\uC6CC \uBCF4\uC774\uB294\uB370\\n\uAD49\uC7A5\uD55C \uB140\uC11D\uC774\uAD6C\uB098!\\c\\n\uC88B\uC558\uC5B4! \uC9C0\uAE08 \uB0B4\uAC00\\n\uBB34\uC2A8 \uC0DD\uAC01 \uD558\uACE0 \uC788\uB294\uC9C0\\r\\n\uD55C\uBC88 \uB9DE\uD600\uBD10!\\c\\n...\uC544\uB2C8\uB2E4, \uC9C4\uC9DC\uBA74 \uB108\uBB34 \uBB34\uC11C\uC6B0\uB2C8\uAE4C\\n\uBC29\uAE08 \uAC74 \uCDE8\uC18C\uC57C \uCDE8\uC18C![VAR 0114(0076)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB192\uC740 \uC9C0\uB2A5\uC73C\uB85C \uC778\uAC04\uC758 \uB9D0\uC744\\n\uC774\uD574\uD558\uB294 \uD3EC\uCF13\uBAAC \uB77C\uD2F0\uC624\uC2A4\uB77C\uACE0...?\\c\\n\uC9C4\uC9DC\uB77C\uBA74 \uAD49\uC7A5\uD55C \uC77C\uC774\uC9C0\uB9CC\\n\uC27D\uAC8C \uBBFF\uC74C\uC774 \uAC00\uC9C0\uB294 \uC54A\uB294\uAC78\\c\\n\uB108, \uB77C\uD2F0\uC544\uC2A4\uB77C\uB294 \uB140\uC11D\uC758\\n\uC624\uBE60\uB77C\uACE0 \uD558\uB358\uB370?\\c\\n\uADF8\uB807\uAD6C\uB098... \uB0A8\uB9E4\uAD6C\uB098...\\n\uC624\uBE60\uB77C\uBA74 \uB3D9\uC0DD\uD55C\uD14C \uC798 \uB300\uD574\uC8FC\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC654\uAD6C\uB098! \uCABC\uADF8\uB9C8\uD55C\\n\uBC14\uC704\uC758 \uAC70\uC778!\\c\\n...\uADF8\uC544\uD558\uD558!\\n\uB180\uB824\uC11C \uBBF8\uC548!\\c\\n\uADF8\uB798\uB3C4 \uB124 \uB4EC\uC9C1\uD55C \uC5B4\uAE68\uB9CC\uD07C\uC740\\n\uB9AC\uC2A4\uD399\uD2B8\uD558\uACE0 \uC788\uB2E4\uACE0!\\c\\n\uC55E\uC73C\uB85C\uB3C4 \uADF8 \uC6B8\uD241\uBD88\uD241\uD55C \uBAB8\uC73C\uB85C\\n\uC5F4\uC2EC\uD788 \uD574\uBCF4\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC654\uAD6C\uB098! \uCABC\uADF8\uB9C8\uD55C\\n\uC5BC\uC74C\uC758 \uAC70\uC778!\\c\\n...\uADF8\uC544\uD558\uD558!\\n\uB180\uB824\uC11C \uBBF8\uC548!\\c\\n\uADF8\uB798\uB3C4 \uB124 \uAD75\uC9C1\uD55C \uD314\uB69D\uB9CC\uD07C\uC740\\n\uC778\uC815\uD558\uACE0 \uC788\uB2E4\uACE0!\\c\\n\uC55E\uC73C\uB85C\uB3C4 \uADF8 \uAF5D\uAF5D \uC5B8 \uBAB8\uC73C\uB85C\\n\uC5F4\uC2EC\uD788 \uD574\uBCF4\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC654\uAD6C\uB098! \uCABC\uADF8\uB9C8\uD55C\\n\uAC15\uCCA0\uC758 \uAC70\uC778!\\c\\n...\uADF8\uC544\uD558\uD558!\\n\uB180\uB824\uC11C \uBBF8\uC548!\\c\\n\uADF8\uB798\uB3C4 \uB124 \uBCFC\uB9C1\uACF5 \uAC19\uC740 \uBAB8\uD1B5\uC740\\n\uC815\uB9D0 \uBA4B\uC9C0\uB2E4\uB2C8\uAE4C!\\c\\n\uC55E\uC73C\uB85C\uB3C4 \uADF8 \uBC18\uC9C8\uBC18\uC9C8\uD55C \uBAB8\uC73C\uB85C\\n\uC5F4\uC2EC\uD788 \uD574\uBCF4\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC2DC\uAC04\uC744 \uC870\uC885\uD558\uB294 \uD3EC\uCF13\uBAAC\\n\uB514\uC544\uB8E8\uAC00\uB77C\uACE0?\\c\\n\uADF8\uAC8C \uC0AC\uC2E4\uC774\uB77C\uBA74 \uB9D0\uC774\uC57C\\n\uC6B0\uB9AC \uB538\uC744 \uD654\uB098\uAC8C \uD558\uAE30 \uC804\uC73C\uB85C\\r\\n\uC2DC\uAC04\uC744 \uB3CC\uB824\uC904 \uC218 \uC788\uC5B4?\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uB140\uC11D\\n\uC6B8\uC74C\uC18C\uB9AC\uAC00 \uC544\uC8FC \uAC1C\uC131\uC801\uC774\uACE0 \uBA4B\uC9C4\uB370!?[VAR 0114(0076)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uACF5\uAC04\uC744 \uC870\uC885\uD558\uB294 \uD3EC\uCF13\uBAAC\\n\uD384\uAE30\uC544\uB77C\uACE0?\\c\\n\uADF8\uAC8C \uC0AC\uC2E4\uC774\uB77C\uBA74 \uB9D0\uC774\uC57C\\n\uC6B0\uB9AC \uB538\uC774 \uB3C4\uB9DD\uAC00\uB354\uB77C\uB3C4\\r\\n\uC21C\uC2DD\uAC04\uC5D0 \uB530\uB77C\uC7A1\uC744 \uC218 \uC788\uC73C\uB2C8\uAE4C \uD3B8\uB9AC\uD558\uACA0\uC5B4!\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uB140\uC11D\\n\uC6B8\uC74C\uC18C\uB9AC\uAC00 \uC544\uC8FC \uAC1C\uC131\uC801\uC774\uACE0 \uBA4B\uC9C4\uB370!?[VAR 0114(0076)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC774 \uC138\uC0C1\uC758 \uC774\uBA74\uC5D0 \uC788\uB294 \uC138\uACC4\uC5D0 \uC0B0\uB2E4\uACE0\\n\uC804\uD574\uC9C0\uB294 \uD3EC\uCF13\uBAAC \uAE30\uB77C\uD2F0\uB098\uB77C\uACE0?\\c\\n\uC774\uBA74\uC774\uB77C\uB294 \uAC74 \uC774 \uBCC4\uC758\\n\uBC18\uB300\uD3B8\uC744 \uB9D0\uD558\uB294 \uAC74\uAC00!?\\c\\n\uB108 \uAF64 \uBA40\uB9AC\uC11C\uB3C4 \uC654\uAD6C\uB098!\\n\uBA3C \uAE38 \uC624\uB290\uB77C \uC218\uACE0\uD588\uC5B4!\\c\\n\uADFC\uB370 \uC29D\uC29D \uB0A0\uC544\uB2E4\uB2D0 \uAC83 \uAC19\uC774 \uC0DD\uAE34 \uAC8C\\n\uC758\uC678\uB85C \uD3B8\uD558\uAC8C \uC654\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC9C0\uD61C\uB97C \uAD00\uC7A5\uD558\uB294 \uD3EC\uCF13\uBAAC\\n\uC720\uD06C\uC2DC\uB77C\uACE0?\\c\\n\uC798\uB410\uB124! \uB0B4\uAC00 \uC880\\n\uBAA8\uC790\uB780 \uAD6C\uC11D\uC774 \uC788\uC73C\uB2C8\uAE4C\\r\\n\uC0B4\uC9DD \uB3C4\uC6C0\uC744 \uBC1B\uC544\uBCFC\uAE4C!\\c\\n\uC720\uD06C\uC2DC\uB2D8 \uC720\uD06C\uC2DC\uB2D8\\n\uB3C4\uC640\uC8FC\uC2ED\uC1FC~ \uB77C\uACE0 \uB9D0\uC774\uC57C!\\c\\n\uC624! \uC5B4\uCA50\uC9C0 \uC544\uAE4C\uBCF4\uB2E4 \uB611\uB611\uD574\uC9C4 \uAC83 \uAC19\uC740\\n\uAE30\uBD84\uC774 \uB4DC\uB294\uB370! \uADF8\uC544\uD558\uD558![VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uAC10\uC815\uC744 \uAC00\uC838\uB2E4\uC8FC\uC5C8\uB2E4\uB294 \uD3EC\uCF13\uBAAC\\n\uC5E0\uB77C\uC774\uD2B8\uB77C\uACE0?\\c\\n\uB0B4\uAC00 \uAC00\uB054 \uC9C0\uB098\uCE58\uAC8C\\n\uAC10\uC815\uC5D0 \uD718\uB458\uB9B4 \uB54C\uAC00 \uC788\uB294\uB370 \uB9D0\uC774\uC57C\\c\\n\uC774 \uB140\uC11D\uC774 \uB098\uD55C\uD14C\\n\uAC10\uC815\uC744 \uB108\uBB34 \uB9CE\uC774 \uAC00\uC838\uB2E4\uC900 \uAC70 \uC544\uB2C8\uC57C!?\\r\\n...\uBB3C\uB860 \uB18D\uB2F4\uC774\uC9C0\uB9CC!\\c\\n\uBB50! \uB0A8\uB4E4\uBCF4\uB2E4 \uD06C\uAC8C\\n\uAE30\uBED0\uD558\uACE0 \uC2AC\uD37C\uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C...\\r\\n\uC774\uB4DD\uC774\uB77C\uACE0 \uBD10\uC57C\uACA0\uC9C0![VAR 0114(0076)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uACE0\uB09C\uC5D0 \uB9DE\uC124 \uAC15\uD55C \uC758\uC9C0\uB97C\\n\uAC00\uC838\uB2E4\uC900\uB2E4\uB294 \uD3EC\uCF13\uBAAC \uC544\uADF8\uB188\uC774\uB77C\uACE0?\\c\\n\uC77C\uC5B4\uB098\uAE30 \uADC0\uCC2E\uC744 \uB54C\uB098\\n\uCCAD\uC18C\uD558\uAE30 \uADC0\uCC2E\uC744 \uB54C\\c\\n\uC774 \uB140\uC11D\uC774 \uC788\uC73C\uBA74\\n\uC758\uC9C0\uAC00 \uBD88\uB048 \uC19F\uC544\uC624\uB974\uC9C0 \uC54A\uC744\uAE4C!?\\c\\n\uC9D1\uC9D1\uB9C8\uB2E4 \uC544\uADF8\uB188 \uD55C \uB9C8\uB9AC!\\n\uB098\uB3C4 \uC7A1\uACE0 \uC2F6\uC5B4\uC84C\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uD654\uAD6C\uD3EC\uCF13\uBAAC \uD788\uB4DC\uB7F0\uC774\uB77C\uACE0...?\\c\\n\uB545\uB538\uB9C9\uD558\uACE0\uB3C4 \uD1B5\uD1B5\uD55C \uBAB8\uB9E4...!\\n\uAC70\uAE30\uC5D0 \uBC18\uD56D\uC801\uC778 \uC5BC\uAD74...!\\c\\n\uC774\uB807\uAC8C \uC0AC\uB791\uC2A4\uB7EC\uC6B4\\n\uD3EC\uCF13\uBAAC\uC774 \uB2E4 \uC788\uB2E4\uB2C8!!\\c\\n\uB300\uCCB4 \uC5B4\uB514\uC11C \uC7A1\uC740 \uAC70\uC57C?\\n\uC804\uC124\uC774\uB4E0 \uC544\uB2C8\uB4E0 \uAC04\uC5D0\\r\\n\uB0B4\uAC00 \uB370\uB9AC\uACE0 \uB2E4\uB2C8\uACE0 \uC2F6\uC744 \uC815\uB3C4\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC6B0\uC653!? \uC124\uB9C8 \uADF8 \uB140\uC11D\uC774\\n\uC804\uC124\uC758 \uAC70\uC778\uB4E4\uC758 \uB450\uBAA9\uC778 \uAC70\uC57C?\\c\\n\uD655\uC2E4\uD788 \uC774 \uC815\uB3C4\uB85C \uD06C\uBA74\\n\uAC70\uC778\uC774\uB77C\uACE0 \uBD80\uB97C \uB9CC\uD558\uACA0\uB124!\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uC810\uC774 \uC794\uB729 \uBC15\uD600 \uC788\uC5B4\uC11C\\n\uC5B4\uB514\uAC00 \uB208\uC778\uC9C0 \uBAA8\uB974\uACA0\uC5B4\\c\\n\uC774 \uB140\uC11D\uC774\uB791 \uC598\uAE30\uD560 \uB550\\n\uC5B4\uB514\uB97C \uBD10\uC57C \uD558\uB294 \uAC70\uC57C?[VAR 0114(0076)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uCD08\uC2B9\uB2EC\uC758 \uD654\uC2E0 \uD06C\uB808\uC138\uB9AC\uC544!\\n\uC815\uB9D0 \uC544\uB984\uB2E4\uC6B4 \uD3EC\uCF13\uBAAC\uC774\uB124!\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uC774 \uB140\uC11D, \uB4F1\uC5D0 \uB2EC\uB9B0 \uACE0\uB9AC\uAC00\\n\uC5C4\uCCAD \uB2E8\uB2E8\uD574 \uBCF4\uC774\uB294\uB370\\c\\n\uC81C\uB300\uB85C \uB204\uC6CC\uC11C \uC798 \uC218\uB294 \uC788\uB294 \uAC70\uC57C?\\n\uC790\uB2E4 \uB4A4\uCC99\uC77C \uC218 \uC788\uAE30\uB294 \uD55C\uAC00?\\r\\n\uC74C... \uAC71\uC815\uB418\uB124[VAR 0114(0076)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uC6B0\uC624!? \uADF8 \uD3EC\uCF13\uBAAC\\n\uAF2C\uB9AC\uAC00 \uBD88\uD0C0\uACE0 \uC788\uB294\uB370!?\\c\\n\uBB50? \uBD88\uAF43\uC73C\uB85C \uC138\uACC4\uB97C\\n\uBD88\uD0DC\uC6CC\uBC84\uB9AC\uB294 \uD3EC\uCF13\uBAAC\uC774\uB77C\uACE0?\\c\\n\uADF8\uB7F0 \uC704\uD5D8\uD55C \uB140\uC11D\uC744 \uB370\uB9AC\uACE0 \uC624\uBA74\uC11C\\n\uC544\uBB34\uB807\uC9C0\uB3C4 \uC54A\uB2E4\uB2C8\\r\\n\uB300\uC7A5\uC740 \uB108\uBB34 \uB2F4\uB825\uC774 \uC13C \uAC70 \uC544\uB2C8\uC57C?\\c\\n\uBAA8\uCABC\uB85D \uD654\uC0C1 \uC785\uC9C0 \uC54A\uAC8C\\n\uC870\uC2EC\uD558\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC6B0\uC624!? \uADF8 \uD3EC\uCF13\uBAAC\\n\uC804\uAE30\uAC00 \uB9C8\uAD6C \uD280\uC796\uC544!?\\c\\n\uBB50? \uCC9C\uB465\uBC88\uAC1C\uB85C \uC138\uACC4\uB97C\\n\uD0DC\uC6CC\uBC84\uB9AC\uB294 \uD3EC\uCF13\uBAAC\uC774\uB77C\uACE0?\\c\\n\uADF8\uB7F0 \uC704\uD5D8\uD55C \uB140\uC11D\uC744 \uB370\uB9AC\uACE0 \uC624\uBA74\uC11C\\n\uC544\uBB34\uB807\uC9C0\uB3C4 \uC54A\uB2E4\uB2C8\\r\\n\uB300\uC7A5\uC740 \uB108\uBB34 \uB2F4\uB825\uC774 \uC13C \uAC70 \uC544\uB2C8\uC57C?\\c\\n\uBAA8\uCABC\uB85D \uAC10\uC804\uB418\uC9C0 \uC54A\uAC8C\\n\uC870\uC2EC\uD558\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC73C~ \uCDA5\uB2E4 \uCD94\uC6CC!\\n\uC5B4\uC9F8 \uCDA5\uB2E4 \uD588\uB354\uB2C8\\r\\n\uADF8 \uD050\uB808\uBB34\uB77C\uB294 \uB140\uC11D \uB54C\uBB38\uC774\uC5C8\uAD6C\uB098!\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uC774 \uB140\uC11D\\n\uB0C9\uAE30\uB85C \uC5BC\uC5B4\uBD99\uC5B4 \uC788\uB2E4\uB2C8 \uAD49\uC7A5\uD55C\uB370!\\c\\n\uC5B4\uC9F8 \uADF8 \uBAB8\uC5D0 \uBD99\uC5C8\uB2E4 \uB5A8\uC5B4\uC84C\uB2E4\\n\uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0...\\c\\n\uC774\uB7F0, \uC2E4\uB840\uB418\uB294 \uB9D0\uC744 \uD588\uB098?\\n\uBBF8\uC548\uD558\uB2E4, \uD050\uB808\uBB34![VAR 0114(0076)]"
