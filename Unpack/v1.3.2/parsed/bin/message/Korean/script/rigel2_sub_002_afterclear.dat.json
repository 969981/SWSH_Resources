[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624! \uB300\uC7A5!\\n\uC804\uC124\uC744 \uBCF4\uC5EC\uC8FC\uB7EC \uC628 \uAC70\uC57C?[VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBCF4\uC5EC\uC900\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC2B9\uBD80\uD55C\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC624, \uADF8\uB9CC\uB450\uACA0\uB2E4\uACE0?\\n\uADF8\uB7F4 \uB54C\uB3C4 \uC788\uB294 \uAC70\uC9C0 \uBB50![VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uB140\uC11D\uC744 \uBCF4\uC5EC\uC904 \uAC74\uB370?[VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC74C? \uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\uC774\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC5D0 \uC5C6\uB294 \uAC83 \uAC19\uC740\uB370!\\r\\n\uADF8\uC544\uD558\uD558! \uADF8\uB7F4 \uB54C\uB3C4 \uC788\uB294 \uAC70\uC9C0 \uBB50![VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0101(0001)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0101(0002)]"
  },
