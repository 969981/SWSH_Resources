[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uB77C...?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC18C\uB2C8\uC544\uBC15\uC0AC\uB2D8\\n\uC190\uB2D8\uC774 \uC624\uC168\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uC5B4\uC11C \uC640[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC774\uBD84\uC740?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC870\uC218?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB0B4 \uC870\uC218\uC57C!\\c\\n\uC5F0\uAD6C\uAC00 \uBC14\uBE60\uC838\uC11C\\n\uB3C4\uC6C0\uC744 \uBC1B\uACE0 \uC788\uC5B4[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC815\uB2F5!\\c\\n\uC5F0\uAD6C\uAC00 \uBC14\uBE60\uC838\uC11C\\n\uB3C4\uC6C0\uC744 \uBC1B\uACE0 \uC788\uC5B4[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC774 \uBAA8\uC73C\uB358\\n\uB300\uB7C9\uC758 \uC18C\uC6D0\uC758\uBCC4...\\c\\n\uC9C0\uAE08 \uC6B0\uB9AC \uC5F0\uAD6C\uC18C\uC5D0\uC11C\\n\uB2E4\uB8E8\uACE0 \uC788\uB294\uB370[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB140\uAC00 \uCC99\uCC99\\n\uC815\uB9AC\uD574\uC8FC\uACE0 \uC788\uAC70\uB4E0\\c\\n\uC544\uC8FC \uC720\uB2A5\uD55C \uC0AC\uB78C\uC774\uB77C\\n\uC815\uB9D0 \uB3C4\uC6C0\uC774 \uB418\uACE0 \uC788\uC5B4[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC544\uB1E8 \uB2F9\uCE58\uB3C4 \uC54A\uC2B5\uB2C8\uB2E4..."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\\n[VAR 0100(0000)]\uB2D8\uC774\uC2DC\uC8E0?\\c\\n\uB9CC\uB098\uC11C \uAE30\uBED0\uC694\\n\uC798 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC7A0\uAE50 \uC774\uCABD\uC73C\uB85C \uC640\uBD10!\\n\uBD10\uC92C\uC73C\uBA74 \uD558\uB294 \uBB3C\uAC74\uC774 \uC788\uC5B4[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD30C\uC6CC\uC2A4\uD3FF\uD0D0\uC0C9\uBA38\uC2E0\uC5D0 \uB300\uD574\\n\uAE30\uC5B5\uD558\uACE0 \uC788\uC9C0?\\c\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC788\uB294 \uC7A5\uC18C...\\n\uAC00\uB77C\uB974\uD30C\uD2F0\uD074\uC774 \uB9CE\uC740 \uACF3\uC5D0\\r\\n\uBC18\uC751\uD558\uB294 \uC7A5\uCE58\uC778\uB370...[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBE59\uACE0![VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB140\uC11D\uB4E4\uACFC \uAC00\uAE4C\uC774\uC5D0 \uC788\uC5C8\uC744 \uB54C\\n\uC5B4\uC9F8\uC120\uC9C0 \uBA38\uC2E0\uC774 \uBC18\uC751\uD588\uAC70\uB4E0![VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC124\uB9C8..."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uB9D0\uD558\uC790\uBA74...?"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uADF8\uB798 \uB9DE\uC544![VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uB9D0\uD558\uC790\uBA74...[VAR 0114(000B)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD30C\uC6CC\uC2A4\uD3FF\uD0D0\uC0C9\uBA38\uC2E0\uC758\\n\uBC18\uC751\uC744 \uCAD3\uC544\uAC00\uBA74\\c\\n\uC2E4\uC18C\uCF64\uBE44\uAC00\\n\uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uB294 \uAC70\uC57C![VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC2E4\uB514\uC640 \uC18C\uB3C4\uC758\\n\uC55E\uAE00\uC790\uB97C \uB530\uC11C \uC2E4\uC18C\uC57C\\r\\n...\uBD80\uB974\uAE30 \uC26C\uC6CC\uC84C\uC9C0?[VAR 0114(000B)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBCF8\uB860\uC73C\uB85C \uB3CC\uC544\uAC00\uC11C![VAR 0114(000B)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29 \uC5EC\uAE30\uC800\uAE30\uC5D0 \uC124\uCE58\uD55C\\n\uD30C\uC6CC\uC2A4\uD3FF\uD0D0\uC0C9\uBA38\uC2E0\uC5D0...[VAR 0114(000B)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC811\uC18D~![VAR 0114(000B)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC6B0\uC640 \uC608\uC0C1 \uC774\uC0C1\uC758 \uBC18\uC751\uC774\uC57C!\\n\uC7A5\uC18C\uB294... \uD130\uD504\uC2A4\uD0C0\uB514\uC6C0!?[VAR 0114(000B)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\uB294 \uB2E4\uC774\uB9E5\uC2A4\uB97C \uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C\\n\uBC18\uC751\uC744 \uBCF4\uC5EC\uB3C4 \uC774\uC0C1\uD558\uC9C4 \uC54A\uC9C0\uB9CC\\r\\n\uC774 \uC815\uB3C4\uB85C \uB192\uC740 \uC218\uCE58\uB294 \uBE44\uC815\uC0C1\uC801\uC774\uC57C...![VAR 0114(000B)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uBB34\uD55C\uB2E4\uC774\uB178... \uB54C\uBB38\uC77C \uB9AC\uB294 \uC5C6\uACA0\uC9C0\\n[VAR 0100(0000)][VAR 1900(0003)] \uC7A1\uC558\uC73C\uB2C8\uAE4C\\c\\n\uC5B4\uCA4C\uBA74 \uC2E4\uC18C\uCF64\uBE44\uC640\\n\uBB34\uC2A8 \uAD00\uACC4\uAC00 \uC788\uB294 \uAC83 \uC544\uB2D0\uAE4C...?[VAR 0114(000B)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[VAR 0100(0000)]! \uC774\uB7F0 \uC18C\uB780\uC744...\\n\uCC54\uD53C\uC5B8\uC73C\uB85C\uC11C \uAC00\uB9CC\uD788 \uB450\uACE0 \uBCFC \uC218\uB294 \uC5C6\uACA0\uC9C0?[VAR 0114(000B)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uC758 \uD0C0\uC6B4\uB9F5\uC5D0\uC11C\uB3C4\\n\uD30C\uD2F0\uD074\uC758 \uBC18\uC751\uC744 \uBCFC \uC218 \uC788\uB3C4\uB85D\\r\\n\uD574\uB450\uC5C8\uC73C\uB2C8\uAE4C \uD5F7\uAC08\uB9B4 \uB54C\uB294 \uD655\uC778\uD574\uBD10[VAR 0114(000B)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uD130\uD504\uC2A4\uD0C0\uB514\uC6C0 \uC870\uC0AC\uB97C\\n\uBD80\uD0C1\uD560\uAC8C\\c\\n\uB098\uB3C4 \uB0B4 \uB098\uB984\uB300\uB85C\\n\uB140\uC11D\uB4E4\uC5D0 \uB300\uD574 \uC870\uC0AC\uD574\uBCFC \uD14C\uB2C8\uAE4C[VAR 0114(000B)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC18C\uB2C8\uC544\uBC15\uC0AC\uB2D8 \uBC11\uC5D0\uC11C\\n\uC77C\uD560 \uC218 \uC788\uC5B4\uC11C \uAE30\uBED0\uC694\\c\\n\uC80A\uC740 \uB098\uC774\uC5D0 \uBC15\uC0AC \uCE6D\uD638\uB97C\\n\uC5BB\uC740 \uB300\uB2E8\uD55C \uBD84\uC774\uC2DC\uB2C8\uAE4C\uC694"
  }
]
