[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC0AC\uB78C\uB4E4\uC740 \uB098\uB97C\\n\uB4DD\uD15C\uBD80\uC778\uC774\uB77C \uBD80\uB974\uC9C0...\\c\\n\uB4DD\uD15C\uC544\uC800\uC528\uB294 \uB9CC\uB0AC\uB2C8?\\n\uADF8\uB294 \uB0B4 \uD30C\uD2B8\uB108\uB780\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB098\uB294 \uB098\uC758 \uC0BD... \uC774\uB984\uD558\uC5EC \uB9C8\uC774 \uC2A4\uD47C\uC73C\uB85C\\n\uAD6C\uBA4D\uD30C\uAE30\uC758 \uC2A4\uB9B4\uC744 \uB290\uB07C\uACE0 \uC788\uC5B4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uB9CC\uB0A8\uC744 \uAE30\uB150\uD574\uC11C\\n\uAC11\uC637\uAD11\uC11D\uC744 \uD558\uB098 \uC904\uAE4C..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "...\uADF8 \uC804\uC5D0 \uC774 \uC598\uAE30\uB97C \uB4E4\uC5B4\uBCF4\uB834!\\c\\n\uB108\uB294 \uAC11\uC637\uAD11\uC11D\uC744\\n\uC774\uB300\uB85C \uBC1B\uC744 \uC218\uB3C4 \uC788\uACE0\\c\\n\uADF8\uAC78 \uAC00\uC9C0\uACE0 \uAD6C\uBA4D\uD30C\uAE30\uB97C \uD574\uC11C\\n\uB354 \uB9CE\uC740 \uAD11\uC11D\uC744 \uC5BB\uC744 \uC218\uB3C4 \uC788\uB294\uB370, \uC5B4\uB5A0\uB2C8?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB2E8! \uAD6C\uBA4D\uC744 \uD30C\uB2E4\uAC00\\n\uB9C8\uC774 \uC2A4\uD47C\uC774 \uBD80\uB7EC\uC9C0\uBA74\\r\\n\uC544\uBB34\uAC83\uB3C4 \uC5BB\uC744 \uC218 \uC5C6\uC5B4..."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB9AC\uD3EC\uD2B8\uB97C \uC791\uC131\uD574\uC57C \uD558\uC9C0\uB9CC\\n\uC2A4\uB9B4\uC744 \uB290\uB07C\uACE0 \uC2F6\uB2E4\uBA74\\r\\n\uB0B4\uAC8C \uC778\uC0DD\uC744 \uAC78\uC5B4\uBCF4\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[~ 7]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAD6C\uBA4D\uD30C\uAE30\uC5D0\uB294 \uB9AC\uC2A4\uD06C\uAC00 \uB530\uB974\uB294 \uBC95\\n\uC774\uC655 \uB9DE\uB2E5\uB728\uB9AC\uAC8C \uB41C \uAC70\\r\\n\uC778\uC0DD\uC744 \uAC78\uACE0 \uB3C4\uC804\uD558\uB3C4\uB85D \uD558\uB834..."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB124\uAC00 \uC77C\uC0DD\uC77C\uB300\uC758 \uD070 \uC2B9\uBD80\uC5D0\\n\uB3C4\uC804\uD558\uB294 \uADF8\uB0A0\uC744 \uAE30\uB300\uD558\uACE0 \uC788\uC744\uAC8C"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC790, \uADF8\uB7FC \uC2DC\uC791\uD55C\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC544\uC559... \uBBF8\uC548!\\n\uB2E8\uB2E8\uD55C \uBC14\uC704\uC5D0 \uBD80\uB52A\uD600\uC11C\\r\\n\uB9C8\uC774 \uC2A4\uD47C\uC774 \uBD80\uB7EC\uC838\uBC84\uB838\uC5B4"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAC8C\uB2E4\uAC00 \uB124 \uBAAB\uC758 \uAC11\uC637\uAD11\uC11D\uB3C4\\n\uC804\uBD80 \uC0AC\uB77C\uC838\uBC84\uB838\uC5B4..."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC778\uC0DD\uC774 \uB2E4 \uADF8\uB7F0 \uAC70\uC9C0 \uBB50!\\n\uADF8\uB7FC... \uB2E4\uC74C\uC5D0 \uB610 \uB9CC\uB098\uC790!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uAC11\uC637\uAD11\uC11D\uC744 [VAR 0203(0001,0000)]\uAC1C \uD30C\uB0C8\uC5B4"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[~ 16]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74\\n\uAC11\uC637\uAD11\uC11D [VAR 0203(0002,0000)]\uAC1C\uB97C \uC190\uC5D0 \uB123\uC744 \uC218 \uC788\uC5B4!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "[~ 19]"
  },
