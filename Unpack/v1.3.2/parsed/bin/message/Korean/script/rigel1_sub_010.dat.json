    "text": "[~ 24]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uACC4\uC18D\uD574\uC11C \uD30C\uBCFC\uAE4C?"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uD6C4\uD6C4! \uD3EC\uAE30\uD558\uB294 \uB370\uB3C4 \uC6A9\uAE30\uAC00 \uD544\uC694\uD55C \uBC95\uC774\uC9C0!\\n\uD604\uBA85\uD55C \uD310\uB2E8\uC77C\uC9C0\uB3C4 \uBAB0\uB77C!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[~ 27]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC73C\uC74C!?\\n\uC7A0\uAE50 \uAE30\uB2E4\uB824 \uBD10!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB9C8\uC774 \uC2A4\uD47C\uC774\\n\uC880 \uB354 \uD30C\uACE0 \uC2F6\uB2E4\uACE0 \uC18D\uC0AD\uC774\uACE0 \uC788\uC5B4!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uADF8\uB7FC \uD55C \uBC88 \uB354! \uAC04\uB2E4~!!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC5D0\uC787~!"
  },
