[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB0A0\uC528\uAC00 \uBC14\uB00C\uC5B4\uB3C4\\n\uAD1C\uCC2E\uC740 \uD3EC\uCF13\uBAAC\uC774 \uC788\uC5C8\uC9C0?\\c\\n\uC544\uB2C8\uBA74 \uB0B4 \uCABD\uC5D0\uC11C\\n\uB0A0\uC528\uB97C \uBC14\uAFD4\uBC84\uB9B4\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC740\\n\uC5BC\uB9C8\uB4E0\uC9C0 \uB364\uBCBC!\\c\\n\uB77C\uACE0 \uD558\uC2DC\uC9C0\uB9CC \uB098\uB294 \uB3C4\uBB34\uC9C0\\n\uC774\uAE38 \uC218 \uC788\uC744 \uAC83 \uAC19\uC9C0 \uC54A\uC544..."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD480\uD0C0\uC785\uC740 \uBE44\uAD50\uC801 \uB0A0\uC528 \uBCC0\uD654\uC5D0\\n\uC88C\uC6B0\uB418\uB294 \uD3B8\uC774\uC9C0..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB0A0\uC528\uC758 \uD6A8\uACFC\uB97C\\n\uC624\uB798 \uC720\uC9C0\uC2DC\uD0A4\uB294 \uB3C4\uAD6C\uB77C..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB098\uB294 \uAC15\uCCA0\uD0C0\uC785\uC758 \uC804\uBB38\uAC00\uC57C!\\c\\n\uBAA8\uB798\uBC14\uB78C\uC5D0\uB3C4 \uB044\uB5A1\uC5C6\uC9C0\uB9CC\\n\uC5EC\uC804\uD788 \uAE08\uB791\uB2D8\uC744 \uC774\uAE30\uC9C0 \uBABB\uD558\uACE0 \uC788\uC5B4..."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC758 \uB450\uB784\uB8E8\uB3C8\uB3C4\\n\uAC15\uCCA0\uD0C0\uC785\uC778\uB370... \uBB50\uAC00 \uB2E4\uB978 \uAC70\uC9C0!?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4 \uB9C8\uC9C0\uB9C9 \uCCB4\uC721\uAD00\uC774\uB124!\\n[VAR 0100(0000)] \uC120\uC218 \uD798\uB0B4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4 \uD1A0\uB108\uBA3C\uD2B8!\\n[VAR 0100(0000)] \uC120\uC218 \uC774\uACA8\uC57C \uD574!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBE0C\uAE30~\uBE0C!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uB77C \uC704\uC6D0\uC7A5\uB2D8\uC774\uB124?\\n\uB610 \uC77C \uB54C\uBB38\uC5D0 \uC624\uC168\uB098?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uD798\uB0B4~!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB098\uC774\uC2A4 \uD30C\uC774\uD2B8!\\n\uBA4B\uC9C4 \uC2DC\uD569\uC774\uC5C8\uC5B4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uB2E8\uB378\uC744 \uBD80\uD0C1\uD574!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5EC\uC5B4! \uCC54\uD53C\uC5B8!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB85C\uC988\uB2D8 \uBA4B\uC838!\\n\uC5B4\uCA5C \uC800\uB807\uAC8C \uC138\uB828\uB418\uC168\uC744\uAE4C?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC740 \uB108\uBB34 \uAC15\uD574!\\n\uC774\uAE38 \uC0AC\uB78C\uC774 \uC788\uAE34 \uD560\uAE4C?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC744 \uC774\uACBC\uB2E4\uACE0!?\\n\uB2E8\uB378\uB2D8\uCC98\uB7FC!?"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218!\\n\uC5EC\uAE30\uC5D4 \uBB34\uC2A8 \uC77C\uB85C!?"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uC6B0\uB9AC\uC758 \uCC54\uD53C\uC5B8\uC774\uB2E4!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC62C\uB9AC\uBE0C\uB2D8\uC740 \uBB50\uB784\uAE4C\\n\uC9C4\uC9DC\uB85C \uBB34\uC11C\uC6B4 \uAC83 \uAC19\uC544"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4! \uAE30\uB2E4\uB9AC\uACE0 \uAE30\uB2E4\uB9AC\uB358!\\n\uAE08\uB791\uB2D8\uC758 \uC2DC\uD569\uC774\uB2E4!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBAA8\uB2C8\uD130\uB85C \uBD24\uC5B4!\\n\uC815\uB9D0 \uBA4B\uC84C\uC5B4!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC774 \uC788\uAE34 \uD558\uC9C0\uB9CC\\n\uC55E\uC73C\uB85C \uC5B4\uB5BB\uAC8C \uB418\uB294 \uAC78\uAE4C..."
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC624~ [VAR 0100(0000)]!\\n\uC6B0\uB9AC\uC758 \uCC54\uD53C\uC5B8!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218\\c\\n\uC704\uC5D0\uC11C\uB294 \uCC54\uD53C\uC5B8\uC774\\n\uBE14\uB799 \uB098\uC774\uD2B8\uC640 \uC2F8\uC6B0\uACE0 \uC788\uC2B5\uB2C8\uB2E4...\\c\\n\uB124, \uC5D8\uB9AC\uBCA0\uC774\uD130\uB85C\\n\uC9C0\uD558 \uD50C\uB79C\uD2B8\uC5D0 \uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4..."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC9C0\uD558 \uD50C\uB79C\uD2B8\uB85C \uAC00\uB294 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB294\\n\uAD00\uACC4\uC790\uB9CC \uD0C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC9C0\uD558 \uD50C\uB79C\uD2B8\uB85C \uAC00\uB294 \uC5D8\uB9AC\uBCA0\uC774\uD130...\\n\uC9C0\uAE08\uC740 \uC704\uD5D8\uD574\uC11C \uD0C8 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4..."
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC774 \uB0A0\uB6F0\uB294 \uB370\uB2E4\uAC00\\n\uC62C\uB9AC\uBE0C\uB2D8\uC774 \uC774\uC131\uC744 \uC783\uB2E4\uB2C8...\\c\\n\uAFC8\uC778\uC9C0 \uC0DD\uC2DC\uC778\uC9C0 \uBAA8\uB974\uACA0\uC5B4\\n\uB85C\uC988\uB2D8\uC744 \uBD80\uD0C1\uD574"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB4DC\uB798\uACE4\uD0C0\uC785 \uC804\uBB38\uAC00\\n\uAE08\uB791\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uB824\uBA74\\r\\n7\uAC1C\uC758 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uAC00 \uD544\uC694\uD574"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC774\uB77C\uBA74 \uB2E4\uC774\uB9E5\uC2A4\uD55C\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC744 \uC9C4\uC815\uC2DC\uD0A4\uAE30 \uC704\uD574\\r\\n\uD130\uB110\uC5D0 \uAC00\uC168\uC5B4\\c\\n\uD130\uB110\uC740 7\uBC88\uB3C4\uB85C \uC55E\uC5D0 \uC788\uC5B4"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8...\\c\\n\uCC54\uD53C\uC5B8\uB9E4\uCE58\uB97C \uBC29\uD574\uD558\uBA74\uC11C\uAE4C\uC9C0\\n\uBB34\uC2A8 \uC77C\uC744 \uD558\uB824\uB294 \uAC70\uC9C0!?"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC774 \uB41C \uAC78 \uCD95\uD558\uD574!\\c\\n\uAE08\uB791\uB2D8\uC740 \uB2E8\uB378\uB2D8 \uB9D0\uACE0\uB3C4\\n\uC4F0\uB7EC\uB728\uB824\uC57C \uD560 \uD2B8\uB808\uC774\uB108\uAC00 \uB298\uC5B4\uC11C\\r\\n\uAE30\uC058\uC2E0 \uBAA8\uC591\uC774\uC57C"
  }
]
