    "text": "\uD560\uBA38\uB2C8[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uB294 \uC0AC\uB78C\uACFC\\n\uD3EC\uCF13\uBAAC\uC758 \uC2E0\uB8B0\uAC00 \uC788\uC5B4\uC57C\uB9CC\\r\\n\uC9C4\uC815\uD55C \uD798\uC744 \uB0BC \uC218 \uC788\uB2E8\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uADF8\uC790\uB4E4\uC740 \uD544\uC2DC\\n\uC18C\uC6D0\uC758\uBCC4\uC774 \uAC00\uC9C4 \uAC00\uB77C\uB974\uD30C\uD2F0\uD074\uC744\\r\\n\uAC15\uC81C\uB85C \uC8FC\uC785\uD574\uC11C\\r\\n\uD3EC\uCF13\uBAAC\uC744 \uB2E4\uC774\uB9E5\uC2A4\uC2DC\uD0A4\uACE0 \uC788\uC744 \uAC8C\uB2E4[VAR 0114(000A)]"
