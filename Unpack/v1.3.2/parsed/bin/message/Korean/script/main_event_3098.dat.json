  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC5ED\uC2DC\\n\uCC54\uD53C\uC5B8 [VAR 0100(0000)]\\r\\n\uC88B\uC740 \uAC10\uC744 \uC9C0\uB154\uAD6C\uB098[VAR 0114(000A)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC18C\uC6D0\uC758\uBCC4\uC744 \uBE7C\uC557\uAE34 \uC774\uC0C1\\n\uD53C\uD574\uAC00 \uD6E8\uC52C\\r\\n\uCEE4\uC9C8 \uC218\uB3C4 \uC788\uB2E4\uB294 \uAC70\uB780\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uAC15\uC81C\uB85C \uD3EC\uCF13\uBAAC\uC744\\n\uB2E4\uC774\uB9E5\uC2A4\uC2DC\uD0A4\uB2E4\uB2C8...\\r\\n\uB300\uCCB4 \uBB58 \uC704\uD574\uC11C...?[VAR 0114(000B)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB140\uC11D\uB4E4\\n\uC790\uC2DC\uC548\uACFC \uC790\uB9C8\uC820\uD0C0\uC758\\r\\n\uBCF8\uC131\uC744 \uD3ED\uB85C\uD55C\uB2E4\uACE0 \uD588\uC5C8\uC5B4[VAR 0114(0005)]"
