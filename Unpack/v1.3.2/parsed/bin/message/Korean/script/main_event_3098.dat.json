  {
    "index": 20,
    "flags": 0,
    "text": "\uC870\uC218\uAC00 \uB9D0\uD588\uB358\\n\uC655\uC758 \uD6C4\uC608\uB77C\uB294 \uB9D0\uB3C4 \uC2E0\uACBD \uC4F0\uC5EC\\c\\n\uC124\uB9C8\\n\uADF8 \uB9D0 \uADF8\uB300\uB85C\uC758 \uB73B\uC740 \uC544\uB2C8\uACA0\uC9C0...?[VAR 0114(000B)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "...\uC7A0\uAE50 [VAR 0100(0000)]!\\n\uD0C0\uC6B4\uB9F5\uC744 \uBD10\uBD10![VAR 0114(000B)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC774\uBC88\uC5D0\uB294 \uC2A4\uD0C0\uB514\uC6C0 4\uACF3\uC5D0\uC11C\\n\uB3D9\uC2DC\uC5D0 \uD070 \uBC18\uC751\uC774 \uC77C\uC5B4\uB0AC\uC5B4![VAR 0114(000B)]"
