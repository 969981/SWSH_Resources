[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC800\uC758 \uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC740\\n\uCCAB \uBC88\uC9F8 \uCCB4\uC721\uAD00\uC774\uB77C \uACC4\uC18D\uD574\uC11C\\r\\n\uCC4C\uB9B0\uC800\uAC00 \uCC3E\uC544\uC635\uB2C8\uB2E4\\c\\n\uADF8\uB798\uC11C \uCCB4\uC721\uAD00 \uBBF8\uC158\uB3C4 \uBE44\uAD50\uC801\\n\uC5B4\uB835\uAC8C \uB0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4\uB9CC...[VAR 0114(000E)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8\uC740 \uD6CC\uB96D\uD558\uAC8C\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4\uD558\uC168\uAD70\uC694!\\r\\n\uC5ED\uC2DC \uB300\uB2E8\uD558\uC2DC\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uB294 \uAC74 \uB2F9\uC2E0\uC774 \uD3EC\uCF13\uBAAC\uC744\\n\uC544\uC8FC \uAE4A\uAC8C \uC774\uD574\uD558\uACE0 \uC788\uB2E4\uB294 \uB73B\uC774\uACA0\uC8E0?\\c\\n\uC774\uAC70 \uB9CC\uB9CC\uCE58 \uC54A\uC740 \uC2B9\uBD80\uAC00 \uB418\uACA0\uB124\uC694!\\n\uC800\uB3C4 [VAR FF00(0001)]\uB2E4\uC774\uB9E5\uC2A4[VAR FF00(0000)]\uB97C \uC0AC\uC6A9\uD574\uC57C\uACA0\uC5B4\uC694[VAR 0114(000E)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC5D0\uAC8C\uB294 \uB9CE\uC740 \uACB0\uC2E4\uC744 \uC5BB\uC740\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC600\uACA0\uB124\uC694![VAR 0114(000E)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\uC11C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744 \uC774\uAE34 \uC99D\uD45C\uB85C\\r\\n\uD480\uBC30\uC9C0\uB97C \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(000E)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB808\uBCA8 25\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uBAA8\uC73C\uB294 \uAC83\uC774\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC758 \uB3CC\uD30C \uC870\uAC74\uC785\uB2C8\uB2E4\\c\\n\uB2E4\uB978 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C\uB3C4 \uB3C4\uC804\uD574\uC11C\\n\uBA4B\uC9C0\uAC8C \uC2B9\uB9AC\uB97C \uC7C1\uCDE8\uD558\uC138\uC694![VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8! \uCCB4\uC721\uAD00 \uAD00\uC7A5\\n\uC544\uD0AC\uB2D8\uC5D0\uAC8C \uC2B9\uB9AC\uD558\uC2E0 \uAC83\uC744\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD569\uB2C8\uB2E4!\\c\\n\uAE30\uB150\uC73C\uB85C\\n\uC774 \uAE30\uC220\uBA38\uC2E0\uC744 \uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC544\uD0AC\uB2D8\uC758\\n\uC720\uB2C8\uD3FC\uB3C4 \uC120\uBB3C\uD558\uACA0\uC2B5\uB2C8\uB2E4!\\r\\n...\uB2F9\uC5F0\uD788 \uB808\uD50C\uB9AC\uCE74\uC785\uB2C8\uB2E4\uB9CC"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD480\uBC30\uC9C0\uAC00 \uC798 \uC5B4\uC6B8\uB9AC\uC2DC\uB124\uC694!\\n[VAR 0100(0000)]\uB2D8! \uC55E\uC73C\uB85C\uB3C4 \uD798\uB0B4\uC138\uC694!"
  }
]
