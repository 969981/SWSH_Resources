[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB098\uBB34 \uC704\uC5D0\uC11C \uC9C4\uD558\uACE0\\n\uB2EC\uCF64\uD55C \uD5A5\uAE30\uAC00 \uB09C\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB098\uBB34\uB97C \uD754\uB4E4\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC704\uC774\uC774\uC774\uC774\uC774\uC774\uC774\uC774\uC774\uC774\uC789"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB300, \uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774\uC9C0!?[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC704\uC789~! \uC704\uC789~!\\n\uC704\uC789~! \uC704\uC789~!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB728\uC544\uC544~!?[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBD80\uC6C5 \uBD80\uC6C5 \uBD80\uC6C5!!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB098\uBB34\uC5D0\uC11C \uD280\uC5B4\uB098\uC628 \uBB34\uC5B8\uAC00\uC5D0 \uC758\uD574\\n\uD3EC\uCF13\uBAAC\uAD74\uB85C \uB04C\uB824\uB4E4\uC5B4 \uAC14\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC2B9\uBD80\uC758 \uCDA9\uACA9\uC73C\uB85C\\n\uC774\uC0C1\uD55C \uAFC0\uC774 \uB5A8\uC5B4\uC84C\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uD55C \uBE44\uD038\uC774\\n\uAC11\uC790\uAE30 \uD280\uC5B4\uB098\uC62C \uC904\uC774\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB108\uBB34 \uAE5C\uC9DD \uB180\uB77C\uC11C\\n\uC2F8\uC6B8 \uC0DD\uAC01\uC870\uCC28 \uBABB\uD588\uC5B4...[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8 \uAFC0, \uC5C4\uCCAD\uB098\uAC8C \uB048\uC801\uC774\uB294 \uAC70 \uBCF4\uB2C8\uAE4C\\n\uC6B0\uB77C\uC624\uC2A4\uAC00 \uC88B\uC544\uD55C\uB2E4\uB294\\r\\n[VAR FF00(0006)]\uC5B4\uB5A4 \uC7AC\uB8CC[VAR FF00(0000)]\uC784\uC5D0 \uD2C0\uB9BC\uC5C6\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uADF8 \uAFC0\uC5D0 \uD30C\uC6CC\uC2A4\uD3FF\uD0D0\uC0C9\uBA38\uC2E0\uC774\\n\uBC18\uC751\uD558\uACE0 \uC788\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC5D0\uC11C \uB098\uB294\\n\uB2E4\uC774\uB9E5\uC2A4\uC758 \uBC84\uC12F\uACFC \uAFC0\uC774\uB77C...[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uBAB0\uB790\uB358 \uAC83\uB4E4\uC774 \uC794\uB729 \uC788\uC5B4\uC11C\\n\uC5F0\uAD6C\uD558\uB7EC \uC624\uAE38 \uC798\uD588\uB2E8 \uAE30\uBD84\uC774 \uB4E4\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC88B\uC544! \uCC3E\uB358 \uC7AC\uB8CC\uB3C4 \uC190\uC5D0 \uB123\uC5C8\uC73C\uB2C8\uAE4C\\n\uB3C4\uC7A5\uC73C\uB85C \uB3CC\uC544\uAC00\uC790![VAR 0114(0005)]"
  }
