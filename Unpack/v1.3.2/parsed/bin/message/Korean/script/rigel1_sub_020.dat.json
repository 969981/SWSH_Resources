    "flags": 0,
    "text": "\uADF8 \uC544\uC774\uAC00 \uC2E0\uACBD \uC4F0\uC5EC?[VAR 0114(0075)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBB50\uC57C \uC2DC\uC2DC\uD558\uAC8C[VAR 0114(0075)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4\\n\uB108 \uBB58 \uC880 \uC544\uB294\uAD6C\uB098[VAR 0114(0075)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8 \uC544\uC774\uB294\\n\uAC00\uC0C1\uD3EC\uCF13\uBAAC \uD3F4\uB9AC\uACE4\uC774\uC57C[VAR 0114(0075)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uCD5C\uACE0\uC758 \uACFC\uD559\uB825\uC744 \uB3D9\uC6D0\uD574\uC11C\\n\uC778\uACF5\uC801\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC9C4 \uC874\uC7AC...[VAR 0114(0075)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uB9D0\uD574, \uACFC\uD559 \uAE30\uC220\uC758 \uACB0\uC815\uCCB4\uC9C0[VAR 0114(0075)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uB9CC\uB4E4\uC5B4\uC9C4 \uC9C0 \uAF64 \uC624\uB798\uB3FC\uC11C\\n\uAC01\uC9C0\uACE0 \uC9C1\uC120\uC801\uC778 \uB514\uC790\uC778\uC778\uB370[VAR 0114(0075)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uAC8C \uC624\uD788\uB824 \uB808\uD2B8\uB85C\uD55C \uBA4B\uC774 \uB09C\uB2E4\uBA74\uC11C\\n\uB9C8\uB2C8\uC544\uB4E4\uC740 \uB354\uD560 \uB098\uC704 \uC5C6\uC774 \uC88B\uC544\uD558\uC9C0[VAR 0114(0075)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uC9C0\uB2C8\uAC8C \uD558\uACE0\\n\uD1B5\uC2E0\uAD50\uD658\uC744 \uD558\uBA74[VAR 0114(0075)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD3F4\uB9AC\uACE42\uB85C \uC9C4\uD654\uD558\uB294\uB370\\n\uB9E4\uB048\uD55C \uC720\uC120\uD615 \uB514\uC790\uC778\uC774 \uC815\uB9D0 \uCD5C\uACE0\uC57C[VAR 0114(0075)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC544\uC544! \uC778\uB958\uC758 \uC9C4\uD654\uB9C8\uC800 \uB290\uB084 \uC218 \uC788\uB294\\n\uC815\uB9D0 \uBA4B\uC9C4 \uD3EC\uCF13\uBAAC\uC774\uC57C!![VAR 0114(0075)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "...\uC804\uB825\uC744 \uB2E4\uD55C \uB300\uB514\uB97C \uC774\uAE34 \uC0AC\uB78C\uC740\\n\uC815\uB9D0 \uB4DC\uBB34\uB2C8\uAE4C \uAE30\uB150\uC73C\uB85C \uC904\uAC8C[VAR 0114(0075)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD3F4\uB9AC\uACE4\uB3C4 \uC544\uAEF4\uC8FC\uACE0\\n\uC778\uB958\uC758 \uC9C0\uD61C\uC5D0\uB3C4 \uAC10\uD0C4\uD574\uBCF4\uB3C4\uB85D \uD574[VAR 0114(0075)]"
  }
]
