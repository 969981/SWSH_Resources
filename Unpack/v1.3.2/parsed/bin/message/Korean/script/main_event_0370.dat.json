[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBD10\uBD10![VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC800\uCABD\uC5D0 \uBCF4\uC774\uB294 \uAC8C\\n\uC5D4\uC9C4\uC2DC\uD2F0\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC800\uAE30\uC5D0 \uB3C4\uCC29\uD560 \uB54C\uAE4C\uC9C0 \uC5BC\uB9C8\uB098 \uB9CE\uC740\\n\uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB098\uAC8C \uB418\uB294 \uAC78\uAE4C?[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBB50\uC57C\\n\uC18C\uB2C8\uC544 \uB204\uB098\uB124?[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD560\uBA38\uB2C8\uD55C\uD14C \uD55C \uC18C\uB9AC \uB4E4\uC5C8\uAC70\uB4E0...\\c\\n\uC544\uC774\uB4E4\uC740 \uC5EC\uD589\uC744 \uB5A0\uB0AC\uB294\uB370\\n\uB108\uB294 \uC5B4\uB5BB\uAC8C \uD560 \uAC70\uB0D0\uACE0 \uB9D0\uC774\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uAC70 \uD070\uC77C\uC774\uB124\uC694"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBC15\uC0AC\uB2D8\uB3C4 \uCC38..."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBB50...\\n\uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uC544\uB3C4 \uB3FC\\c\\n\uADF8\uB9AC\uACE0 \uB108\uD76C\uAC00 \uC232\uC5D0\uC11C \uB9CC\uB0AC\uB2E4\uB294\\n\uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574\uC11C\uB3C4 \uAD81\uAE08\uD558\uB2C8\uAE4C\\r\\n\uC7A0\uAE50 \uC870\uC0AC\uD574\uBCFC \uC0DD\uAC01\uC774\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBB54\uAC00 \uC54C\uC544\uB0B4\uBA74 \uBD84\uBA85\uD788\\n\uD560\uBA38\uB2C8\uB3C4 \uB098\uB97C \uC778\uC815\uD574\uC8FC\uC2E4 \uAC70\uC57C...![VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uC5B4\uB978\uC73C\uB85C \uC9C0\uB0B4\uB294 \uAC74\\n\uD798\uB4E0 \uC77C\uC778\uAC00 \uBD10[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C\\n\uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uC544\uB3C4 \uB41C\uB2E4\uB2C8\uAE4C!\\c\\n\uB098\uB3C4 \uC624\uB79C\uB9CC\uC5D0 \uB5A0\uB098\uB294 \uC5EC\uD589\uC774\uB2C8\uAE4C\\n\uB09A\uC2DC\uB791 \uCEA0\uD551\uC744 \uC990\uAE38 \uC0DD\uAC01\uC774\uAE30\uB3C4 \uD558\uACE0![VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[~ 11]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC88B\uC544! \uBD89\uAC8C \uBE5B\uB098\uB294\\n\uAD74\uC744 \uB9CE\uC774 \uB9CE\uC774 \uC870\uC0AC\uD558\uACE0!\\c\\n\uB2E4\uC774\uB9E5\uC2A4\uD55C \uD3EC\uCF13\uBAAC\uACFC\\n\uB9CE\uC774 \uB9CE\uC774 \uC2F8\uC6CC\uC11C!\\r\\n\uB0B4 \uC804\uC124\uC758 \uD55C \uD398\uC774\uC9C0\uB85C \uB9CC\uB4E4\uC5B4\uC57C\uC9C0![VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC815\uB9D0 \uBABB \uB9D0\uB9B0\uB2E4\uB2C8\uAE4C! \uB2E4\uC774\uB9E5\uC2A4\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uC9C4\uC9DC \uAC15\uD558\uB2C8\uAE4C \uC870\uC2EC\uD574!\\c\\n\uC78A\uC9C0 \uB9D0\uACE0 \uC790\uC2E0\uC758 \uD30C\uD2B8\uB108\uB97C\\n\uB2E4\uC774\uB9E5\uC2A4\uC2DC\uCF1C\uC57C \uD574![VAR 0114(000B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4 \uC5EC\uAE30\uC800\uAE30\uC5D0\uC11C\\n\uBD89\uC740 \uC624\uB77C\uB97C \uBC1C\uACAC\uD560 \uC218 \uC788\uC744 \uAC70\uC57C\\c\\n\uC790\uC2E0 \uC788\uB2E4\uBA74 \uC870\uC0AC\uD574 \uBD10\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC774 \uC788\uC744 \uD14C\uB2C8\uAE4C\\c\\n\uC88B\uC544! \uC774 \uC120\uBC30\uB2D8\uAED8\uC11C\\n\uBA4B\uC9C4 \uC120\uBB3C\uC744 \uC904\uAC8C![VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uBC15\uC2A4\uB97C \uC0AC\uC6A9\uD558\uBA74\\n\uBC15\uC2A4\uC5D0 \uD3EC\uCF13\uBAAC\uC744 \uB9E1\uAE30\uAC70\uB098\\r\\n\uB9E1\uAE34 \uD3EC\uCF13\uBAAC\uC744 \uB370\uB824\uC62C \uC218 \uC788\uC5B4\\c\\n\uD3EC\uCF13\uBAAC\uC744 \uC794\uB729 \uC7A1\uC544\uC11C\\n\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uCC44\uC6CC\uBD10![VAR 0114(000B)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC790! \uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5B4!\\n\uC774\uC81C\uBD80\uD130 \uB108\uC758 \uBAA8\uD5D8\uC774 \uC2DC\uC791\uB418\uB294 \uAC70\uC57C![VAR 0114(000B)]"
