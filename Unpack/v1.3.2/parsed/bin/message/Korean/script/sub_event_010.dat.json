[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uBC34\uB4DC \uB9E5\uC2DC\uB9C8\uC774\uC800\uC988\uC758\\n\uB77C\uC774\uBE0C \uC601\uC0C1\uC740 \uC815\uB9D0 \uCD5C\uACE0\uC57C! \uD55C\uBC88 \uBCFC\uB798?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBCFC\uB798\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC548 \uBCFC\uB798\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBE44\uAD50\uC801... \uC544\uB2C8 \uAF64 \uAE38\uB2E4\uACE0!\\n\uC5F4\uC815\uC774 \uB2F4\uACA8 \uC788\uC5B4\uC11C \uADF8\uB798!\\r\\n\uADF8\uB798\uB3C4 \uB77C\uC774\uBE0C \uC601\uC0C1\uC744 \uBCFC \uAC70\uC57C?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB798\uB3C4 \uBCFC\uB798\uC694!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB0E5 \uC548 \uBCFC\uB798\uC694"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC5B4\uB54C? \uCD5C\uACE0 \uC911\uC5D0 \uCD5C\uACE0\uC9C0?\\n\uB9E5\uC2DC\uB9C8\uC774\uC800\uC988\uB294 \uC815\uB9D0 \uCD5C\uACE0\uC57C!!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB798! \uCD5C\uACE0\uC758 \uB77C\uC774\uBE0C\uAC00 \uBCF4\uACE0 \uC2F6\uB2E4\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uBCF4\uC5EC\uC904 \uD14C\uB2C8\uAE4C \uB610 \uC640!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD0A4\uC774\uC774\uC789"
  },
