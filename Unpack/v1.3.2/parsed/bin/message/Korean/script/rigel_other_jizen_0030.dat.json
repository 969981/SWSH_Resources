[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC57C\uC559?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB108 \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uC9C0?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB0E5 \uB480\uB2E4\uAC04 \uC57C\uB3C8\uC774\\n\uAC1C\uCC30\uAD6C\uB97C \uAC00\uB85C\uB9C9\uC544\uC11C\\r\\n\uB2E4\uB978 \uC2B9\uAC1D\uB4E4\uC774 \uBD88\uD3B8\uD574\uD560 \uAC70\uC57C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBB34\uAC70\uC6CC\uC11C \uC62E\uAE38 \uC218\uB3C4 \uC5C6\uC73C\uB2C8\\n\uB124\uAC00 \uC7A1\uC544\uC8FC\uC9C0 \uC54A\uACA0\uB2C8?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC57C\uC559~"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC57C\uB3C8\uC744 \uC7A1\uAE30 \uC704\uD574\\n\uC2B9\uBD80\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB3C4\uC57C\uC559!?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[~ 7]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC544\uC557! \uC57C\uB3C8 \uC774 \uB140\uC11D\\n\uC544\uC9C1\uB3C4 \uBE44\uD0AC \uC0DD\uAC01\uC774 \uC5C6\uB294 \uAC74\uAC00!?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uC4F0\uB7EC\uB728\uB9AC\uC9C0 \uC54A\uACE0\\n\uC7A1\uB294 \uBC29\uBC95\uBC16\uC5D4 \uC5C6\uACA0\uC5B4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uB3C4\uB9DD\uCCD0\uBC84\uB9AC\uBA74\\n\uC7A1\uC744 \uC218 \uC5C6\uB2E4\uACE0!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC73C\uB824\uBA74\\n\uCD5C\uB300\uD55C \uC57D\uD558\uAC8C \uB9CC\uB4E0 \uB2E4\uC74C\uC5D0\\r\\n\uBAAC\uC2A4\uD130\uBCFC\uC744 \uB358\uC838\uC57C \uD574!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC57C...!?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uACE0\uB9D9\uB2E4! \uB355\uBD84\uC5D0\\n\uCF8C\uC801\uD55C \uACF5\uAC04\uC744 \uC720\uC9C0\uD560 \uC218 \uC788\uAC8C \uB410\uC5B4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uAE84\uD56B! \uAD49\uC7A5\uD558\uB2E4~![VAR 0114(0042)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD638\uC624, \uC81C\uBC95 \uD558\uB294\uAD70\uC694...[VAR 0114(0042)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC57C\uB3C8\uC744 \uC7A1\uB294 \uB108\uC758 \uBAA8\uC2B5\\n\uC815\uB9D0 \uBA4B\uC788\uC5C8\uC5B4![VAR 0114(0042)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC815\uB9D0 \uC5D8\uB808\uAC15\uC2A4\uD558\uAC8C\\n\uC7A1\uB354\uAD70\uC694[VAR 0114(0042)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC544, \uAE30\uB2E4\uB9AC\uAC8C \uD574\uC11C \uC8C4\uC1A1\uD569\uB2C8\uB2E4\\n\uC190\uB2D8\uC758 \uAC11\uC637\uD328\uC2A4\uB97C\\r\\n\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uD589 \uC5F4\uCC28\uC5D0\\n\uD0D1\uC2B9\uD574 \uC8FC\uC2ED\uC2DC\uC624\\c\\n\uB3C4\uC911\uC5D0 \uD658\uC2B9\uD574\uC57C \uD558\uB2C8\\n\uC8FC\uC758\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB124\uC5D0~![VAR 0114(0042)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0042)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB098\uB294 \uC774\uC81C\\n\uAC11\uC637\uC12C\uC774\uB77C\uB294 \uACF3\uC5D0 \uAC00\uC11C\\c\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAC70\uB098\\n\uC2E4\uB825\uC744 \uC313\uC744 \uC0DD\uAC01\uC774\uC57C[VAR 0114(0042)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC800\uB294 \uC774\uC81C\\n\uAC11\uC637\uC12C\uC774\uB77C\uB294 \uACF3\uC5D0\uC11C\\c\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAC70\uB098\\n\uC2E4\uB825\uC744 \uC313\uC744 \uC608\uC815\uC785\uB2C8\uB2E4[VAR 0114(0042)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uAE30\uD68C\uAC00 \uB418\uBA74 \uB610 \uBCF4\uC790!\\n...\uADF8\uB7FC \uBC14\uC774\uBC14\uC774~[VAR 0114(0042)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uAE30\uD68C\uAC00 \uB418\uBA74 \uB2E4\uC74C\uC5D0 \uB610 \uBD59\uACA0\uC2B5\uB2C8\uB2E4\\n...\uADF8\uB7FC \uC2E4\uB840\uD558\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0042)]"
  }
]
