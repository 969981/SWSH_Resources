[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744 \uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC758\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB124!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAD1C\uCC2E\uC544\uC694..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uB4E4\uACE0 \uACC4\uC2E0\\n\uD568\uC815\uD0D0\uC9C0\uBA38\uC2E0\uC5D0 \uB300\uD574\\r\\n\uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uACF3\uC5D0\uB294 \uC5EC\uAE30\uC800\uAE30\uC5D0\\n\uBCF4\uC774\uC9C0 \uC54A\uB294 \uD568\uC815\uC774 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD568\uC815\uC5D0 \uBE60\uC9C0\uBA74 \uC9C0\uAE08 \uC788\uB294 \uACF3\uC5D0\uC11C\uBD80\uD130\\n\uB2E4\uC2DC \uC2DC\uC791\uD574\uC57C \uD569\uB2C8\uB2E4\\c\\n\uD568\uC815\uC774 \uB208\uC55E\uC5D0 \uC788\uAC70\uB098\\n\uAC00\uAE4C\uC774\uC5D0 \uC788\uC744\uC218\uB85D\\r\\n\uBA38\uC2E0\uC774 \uAC15\uD558\uAC8C \uC9C4\uB3D9\uD569\uB2C8\uB2E4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCD9C\uBC1C\uD558\uC2DC\uC8E0!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBBF8\uC158\uC774 \uBB50\uC600\uC8E0?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBCF4\uC774\uC9C0 \uC54A\uB294 \uAD6C\uBA4D\uC5D0 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uACE0\\n\uACE8\uC744 \uD5A5\uD574 \uAC00 \uC8FC\uC2ED\uC2DC\uC624!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uBA74 \uCC98\uC74C\uBD80\uD130\\n\uB2E4\uC2DC \uD558\uAC8C \uB429\uB2C8\uB2E4\uB9CC\\r\\n\uC815\uB9D0 \uAE30\uAD8C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC740\\n\uC990\uAC70\uC6B0\uC2E0\uAC00\uC694?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\n\uD6CC\uB96D\uD558\uAC8C \uD074\uB9AC\uC5B4\uD558\uC168\uAD70\uC694!\\c\\n[VAR 0100(0000)]\uB2D8, \uACC4\uC18D\uD574\uC11C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB124!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC544\uB2C8\uC694..."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC74C! \uADF8\uB7FC \uAC00\uC2DC\uC8E0!\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uACFC \uACA8\uB8E8\uB294 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB9AC\uD3EC\uD2B8\uB97C \uC4F4\uB2E4\uB4E0\uC9C0\\n\uC5EC\uB7EC \uC900\uBE44\uAC00 \uD544\uC694\uD558\uACA0\uC8E0"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2A4\uD0C0\uD2B8!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uD074\uB9AC\uC5B4!!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC5B4\uC774\uCFE0! [VAR 0100(0000)] \uC120\uC218\\n\uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4!? \uC774\uAC70 \uC544\uD504\uACA0\uB124\uC694"
  }
]
