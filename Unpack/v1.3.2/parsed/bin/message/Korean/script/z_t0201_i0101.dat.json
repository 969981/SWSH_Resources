[
  {
    "index": 0,
    "flags": 0,
    "text": "\uAD00\uB9AC\uD558\uAE30 \uC5B4\uB824\uC6B4\\n\uC2DD\uBB3C\uC774 \uC798 \uC790\uB77C\uACE0 \uC788\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD654\uC774\uD2B8\uBCF4\uB4DC\uC5D0 \uBB34\uC5B8\uAC00\uC758\\n\uBA54\uBAA8\uAC00 \uBE7D\uBE7D\uC774 \uC801\uD600 \uC788\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBB54\uAC00\uB97C \uCE21\uC815\uD558\uACE0 \uC788\uB294\uC9C0\\n\uCE21\uC815\uAE30\uC758 \uB370\uC774\uD130\uAC00 \uC6C0\uC9C1\uC774\uACE0 \uC788\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[~ 3]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC648\uC648\uC648\uC648!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\u201C\uD3EC\uCF13\uBAAC\uC758 \uBCC0\uD654\uC5D0 \uB300\uD574\u201D\\n\uD3EC\uCF13\uBAAC\uC740 \uB808\uBCA8\uC5C5 \uC678\uC5D0\uB3C4\\n\uB3C4\uAD6C\uB098 \uC7A5\uC18C\uC758\\n\uC601\uD5A5\uC744 \uBC1B\uC544\uC11C\\n\uBAA8\uC2B5\uC774 \uBC14\uB00C\uB294 \uACBD\uC6B0\uAC00 \uC788\uB2E4.\\c\\n\uD3EC\uCF13\uBAAC\uC758 \uCCB4\uB0B4\uC5D0 \uC7A0\uC7AC\uB41C\\n\uC5B4\uB5A0\uD55C \uC694\uC18C\uC5D0 \uC758\uD574\\n\uBAA8\uC2B5\uC774\uB098 \uC131\uC9C8\uC774\\n\uBCC0\uD558\uB294 \uAC83\uC73C\uB85C \uCD94\uCE21\uB418\uB098\\n\uC544\uC9C1 \uC815\uD655\uD55C \uC6D0\uC778\uC740 \uBC1D\uD600\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\u201C\uD3EC\uCF13\uBAAC\uC758 \uB2E4\uC774\uB9E5\uC2A4\uB780?\u201D\\n\uD3EC\uCF13\uBAAC\uC774 \uAC70\uB300\uD574\uC9C0\uB294 \uD604\uC0C1\uC744\\n\uB2E4\uC774\uB9E5\uC2A4\uB77C\uACE0 \uBD80\uB978\uB2E4.\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uD2B9\uC815\uD55C \uC7A5\uC18C\uC640\\n\uD2B9\uC815 \uC870\uAC74 \uC544\uB798\uC5D0\uC11C\uB9CC \uAD00\uCE21\uD560 \uC218 \uC788\uB2E4."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\u201C\uD3EC\uCF13\uBAAC\uC758 \uAC70\uB300\uD654\u201D\\n\uD3EC\uCF13\uBAAC\uC740 \uAE30\uBCF8\uC801\uC73C\uB85C\\n\uC9C4\uD654\uD558\uBA74 \uD06C\uACE0 \uAC15\uD574\uC9C4\uB2E4.\\n\uBAB8\uC9D1\uC744 \uD06C\uAC8C \uBCF4\uC774\uAC8C \uD558\uB294 \uD589\uB3D9\uC740\\n\uC0DD\uC874\uBCF8\uB2A5\uC758 \uC77C\uC885\uC774\uB2E4."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8 [VAR 0100(0000)]\uB2D8\\n\uC624\uB79C\uB9CC\uC774\uAD70\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[VAR 0101(0001)][VAR 1900(0002)] \uD3ED\uC8FC\uD558\uAC8C \uB9CC\uB4E0 \uAC83\uC740\\n\uC9C4\uC2EC\uC73C\uB85C \uC8C4\uC1A1\uD558\uAC8C \uC0DD\uAC01\uD569\uB2C8\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC18C\uB3C4\uB2D8\uACFC \uC2E4\uB514\uB2D8, \uADF8\uB9AC\uACE0 \uC800\uB294\\n\uC800\uC9C0\uB978 \uC77C\uC5D0 \uB300\uD574 \uC18D\uC8C4\uD558\uAE30 \uC704\uD574\\r\\n\uBD09\uC0AC \uD65C\uB3D9\uC744 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD55C\uB54C \uC790\uC2E0\uC744 \uC18D\uC778 \uC0AC\uB78C\uC5D0\uAC8C\\n\uC5F0\uAD6C\uC18C\uB97C \uC9C0\uD0A4\uAC8C \uD558\uB2E4\uB2C8...\\c\\n\uC18C\uB2C8\uC544\uBC15\uC0AC\uB2D8\uC740 \uCC38\\n\uB9C8\uC74C\uC774 \uB113\uC740 \uBD84\uC774\uC9C0 \uC54A\uB098\uC694?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5B4\uCA4C\uB2E4 \uBCF4\uB2C8 \uB2E4\uC2DC \uC774\uACF3\uC5D0\uC11C\\n\uC77C\uD558\uAC8C \uB410\uC2B5\uB2C8\uB2E4\\c\\n\uC774\uBC88\uC5D0\uB294 \uC131\uC2E4\uD558\uAC8C\\n\uB3C4\uC640\uB4DC\uB9B4 \uC0DD\uAC01\uC774\uB78D\uB2C8\uB2E4... \uC6B0\uD6C4\uD6C4"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uC655\uAD00\uC124\uC6D0\uC5D0\uC11C\uB294 \uACE0\uB9C8\uC6E0\uC5B4\\c\\n\uC9C0\uAE08\uC740 \uB17C\uBB38\uC73C\uB85C \uC815\uB9AC\uD558\uB294 \uC911\uC774\uC57C\\n\uC4F0\uACE0 \uC2F6\uC740 \uB0B4\uC6A9\uC774 \uB9CE\uC544\uC11C \uB108\uBB34 \uACE0\uBBFC\uB3FC![VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5E5~!? \uCF54\uBC14\uB974\uC628, \uD14C\uB77C\uD0A4\uC628\\n\uBE44\uB9AC\uB514\uC628 \uB9D0\uACE0\uB3C4\\r\\n\uB124 \uBC88\uC9F8 \uC804\uC124\uC774 \uC788\uC5C8\uB358 \uAC70\uC57C!?[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC73C\uC73C\uC73C... \uC880 \uB354 \uB048\uAE30 \uC788\uAC8C\\n\uC870\uC0AC\uD574\uBCFC \uAC78 \uADF8\uB7AC\uC5B4...[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD6C4\uC6C5..."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0001)] \uB300\uB2E8\uD574!\\n\uBCF4\uACE0\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC![VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974 \uC2A4\uD0C0 \uD1A0\uB108\uBA3C\uD2B8\uB77C\uB2C8\\n\uD615\uB3C4 \uCC38 \uC5C4\uCCAD\uB09C \uAC78 \uC0DD\uAC01\uD574\uB0B8\uB2E4\uB2C8\uAE4C!\\c\\n\uACF5\uBD80\uAC00 \uBA3C\uC800\uAE34 \uD558\uC9C0\uB9CC\\n\uC774\uB807\uAC8C \uB41C \uC774\uC0C1 \uC5F4\uC2EC\uD788 \uD560 \uAC70\uC57C![VAR 0114(0005)]"
  }
]
