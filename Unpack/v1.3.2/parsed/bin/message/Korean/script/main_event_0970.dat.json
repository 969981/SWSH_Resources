[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uB9C8\uC744 \uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC758\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\r\\n\uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBD80\uD0C1\uB4DC\uB824\uC694"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAD1C\uCC2E\uC544\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC774\uACF3\uC5D0\uC11C\uB294 \uCEF5\uC744 \uD0C0\uACE0\\n\uC7A5\uC560\uBB3C\uC744 \uD53C\uD558\uBA74\uC11C\\r\\n\uACE8\uC744 \uD5A5\uD574 \uB098\uC544\uAC00\uC57C \uD569\uB2C8\uB2E4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC5B4\uD2B8\uB799\uC158\uC5D0 \uB300\uD55C\\n\uB9E4\uB274\uC5BC\uC744 \uC77D\uC5B4\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4\\c\\n\uC2A4\uD2F1\uC744 \uC624\uB978\uCABD\uC73C\uB85C \uB3CC\uB9AC\uBA74\\n\uCEF5\uC774 \uC624\uB978\uCABD\uC73C\uB85C \uD68C\uC804\uD558\uACE0\\c\\n\uC67C\uCABD\uC73C\uB85C \uBE59\uBE59 \uB3CC\uB9AC\uBA74\\n\uCEF5\uC774 \uC67C\uCABD\uC73C\uB85C \uD68C\uC804\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBCBD\uC5D0 \uBD80\uB52A\uD614\uC744 \uB54C\uB294\\n\uC2A4\uD2F1\uC744 \uC7AC\uBE60\uB974\uAC8C\\r\\n\uBE59\uBE59 \uB3CC\uB824\uC11C \uBE60\uC838\uB098\uC640 \uC8FC\uC2ED\uC2DC\uC624\\c\\n\uD0C0\uC774\uBC0D\uC5D0 \uB9DE\uAC8C \uBE59\uBE59 \uB3CC\uBA74\uC11C\\n\uACE8\uC744 \uD5A5\uD574 \uAC00\uC8FC\uC2ED\uC2DC\uC624!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBE59\uBE59 \uB3CC\uBA74\uC11C\\n\uCD9C\uBC1C\uD558\uC2DC\uC8E0!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBBF8\uC158\uC774 \uBB50\uC600\uC8E0?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC2A4\uD2F1\uC73C\uB85C \uCEF5\uC744 \uC870\uC885\uD574\uC11C\\n\uACE8\uC744 \uD5A5\uD574 \uAC00\uC8FC\uC138\uC694!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uBA74 \uCC98\uC74C\uBD80\uD130\\n\uB2E4\uC2DC \uD558\uAC8C \uB429\uB2C8\uB2E4\uB9CC\\r\\n\uC815\uB9D0 \uAE30\uAD8C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\n\uD6CC\uB96D\uD558\uAC8C \uD074\uB9AC\uC5B4\uD558\uC168\uAD70\uC694!\\c\\n[VAR 0100(0000)]\uB2D8, \uACC4\uC18D\uD574\uC11C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[~ 16]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[~ 17]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC74C! \uADF8\uB7FC \uAC00\uC2DC\uC8E0!\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uACFC \uACA8\uB8E8\uB294 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB9AC\uD3EC\uD2B8\uB97C \uC4F4\uB2E4\uB4E0\uC9C0\\n\uC5EC\uB7EC \uC900\uBE44\uAC00 \uD544\uC694\uD558\uACA0\uC8E0"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2A4\uD0C0\uD2B8!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uACE8\uC778!\\n\uCCB4\uC721\uAD00 \uBBF8\uC158 \uD074\uB9AC\uC5B4!!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "[~ 22]"
  }
]
