[
  {
    "index": 0,
    "flags": 0,
    "text": "[~ 0]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC1FC\uD551\uC758 \uBCF8\uC9C8\uC774\uB780\\n\uB9DD\uC124\uC774\uACE0 \uACE0\uBBFC\uD558\uB294 \uAC83\uC774\uC9C0"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC9C0\uAE08\uBD80\uD130 \uB2E8\uB828\uD558\uBA74\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB3C4 \uAC70\uB72C\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB0D0\uB0E5\uBD80\uC6B0"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC57C\uCCAD\uB2D8\uC740\\n\uC65C \uB4F1\uB300\uB97C \uC88B\uC544\uD558\uC9C0?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uB294 \uCEE4\uB2E4\uB780 \uC12C\uC774\uC5B4\uC11C\\c\\n\uBC30\uB97C \uC778\uB3C4\uD558\uB294 \uB4F1\uB300\uB294\\n\uC61B\uB0A0\uC774\uB098 \uC9C0\uAE08\uC774\uB098 \uC911\uC694\uD574"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uB09A\uC2DC\uD558\uB2E4\uAC00\\n\uCEE4\uB2E4\uB780 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB0AC\uC744 \uB54C\\r\\n\uC7A1\uC9C0 \uBABB\uD558\uBA74 \uB2F9\uD560 \uAC83 \uAC19\uC740 \uB290\uB08C\uC774 \uB4E4 \uAC70\uC57C"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC57C\uCCAD\uB2D8\uC740 \uC5C4\uACA9\uD55C \uC0AC\uB78C\uC774\uC5B4\uC11C\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uB3C4 \uBB34\uC9C0 \uC5B4\uB824\uC6CC!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0... \uC61B\uB0A0 \uC0DD\uAC01\uC774 \uB098\uB124...\\n\uB098\uB294 \uBB3C\uBC30\uC9C0\uB97C \uBABB \uBC1B\uC558\uC5C8\uC9C0"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB108\uD55C\uD14C \uAC70\uB294 \uAE30\uB300\uAC00 \uCEE4!\\n\uC0AC\uC2E4 \uBAA8\uB450\uD55C\uD14C \uD558\uB294 \uB9D0\uC774\uC57C"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAC13 \uC218\uD655\uD55C \uCC44\uC18C! \uB9DB\uC788\uACA0\uC9C0?\\n\uAC13 \uB534 \uB098\uBB34\uC5F4\uB9E4! \uB9DB\uC788\uC744\uAE4C?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD568\uAED8 \uB9CC\uB4E0 \uC694\uB9AC\uB294\\n\uC2E4\uD328\uD574\uB3C4 \uC774\uC57C\uAE43\uAC70\uB9AC\uAC00 \uB418\uC9C0"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC81C2\uAD11\uC0B0\uC740 \uC88B\uC740 \uACF3\uC774\uC57C\\n\uB531\uB531\uD55C \uD3EC\uCF13\uBAAC\uC774 \uB9CE\uC544"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB3C4\uC624~\uC639!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC0AC\uC778\uD574 \uC8FC\uC138\uC694!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC57C\uCCAD\uB2D8\uC744 \uC774\uAE30\uB294 \uAC74\\n\uC5B4\uB824\uC6B4 \uC77C\uC774\uC57C"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC57C\uCCAD\uB2D8\uC744 \uC774\uAE30\uB2E4\uB2C8\\n\uC2E4\uB825 \uC788\uB294 \uD2B8\uB808\uC774\uB108\uAD6C\uB098"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBB34\uD55C\uB2E4\uC774\uB178...\\n\uBB50\uC600\uB358 \uAC78\uAE4C!?"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB098\uB294 \uC804\uC9C4\uD560 \uAC70\uC57C\\n\uC55E\uC73C\uB85C \uC55E\uC73C\uB85C"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC57C\uCCAD\uB2D8\uC774 \uBAA8\uC740\\n\uC2DD\uC7AC\uB8CC\uB294 \uC88B\uC544"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB098\uB3C4 \uB418\uACA0\uC5B4\\n\uCC54\uD53C\uC5B8!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB09A\uC774\uC9C0 \uC54A\uB124..."
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uB85C\\n\uB09A\uC2DC\uD558\uB7EC \uAC08\uAE4C..."
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC88B\uC740 \uB09A\uC2DC \uD3EC\uC778\uD2B8\\n\uC5B4\uB514 \uC5C6\uC744\uAE4C?"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uB2D8\uC758\\n\uC0AC\uC778\uC744 \uBC1B\uC558\uC5B4!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC2DC\uD478\uB4DC \uB808\uC2A4\uD1A0\uB791\\n\uBC29\uD30C\uC815\uC5D0 \uB4E4\uB7EC\uBCFC\uAE4C?"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uBC14\uB2F7\uBC14\uB78C...\\n\uB9DE\uC73C\uB2C8\uAE4C \uC88B\uB2E4"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uBC14\uC6B0\uB9C8\uC744\uC758\\n\uBA85\uBB3C\uC740 \uC74C..."
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC2DC\uD478\uB4DC \uB9DB\uC788\uC5C8\uC5B4\\n\uD1A0\uD551\uAE4C\uC9C0 \uCD94\uAC00\uD574\uC11C \uBA39\uC5C8\uC5B4"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uACC4\uC18D \uC5EC\uAE30\uC11C\\n\uC0B4\uAE4C?"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC548\uB155\uD558\uC138\uC694\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uBB3C\uBC30\uC9C0\uB124\uC694! \uCD95\uD558\uD574\uC694!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC548\uB155\uD558\uC138\uC694\\n\uCC54\uD53C\uC5B8\uB2D8!"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC57C\uCCAD\uB2D8 \uD558\uBA74\\n\uB4F1\uB300\uC9C0"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uBB50\uC57C!\\n\uC610\uB2E8\uC774?"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uBA85\uD0D0\uC815\uC778\\n\uD3EC\uCF13\uBAAC\uC774 \uC788\uB2E4\uB358\uB370?"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uD76C\uADC0\uD55C \uBB3C\uAC74\uC774 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uB294\\n\uB808\uCF54\uB4DC\uC20D\uC774\uB77C\uB294 \uB4EF\uD558\uB2E4"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "[~ 38]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uB4F1\uB300\uB97C \uC9C0\uCF30\uB2E4\uACE0 \uC804\uD574\uC9C0\uB294\\n\uD3EC\uCF13\uBAAC\uC758 \uC11D\uC0C1\uC774 \uC788\uB2E4"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uD0A4\uC774\uC774\uC789"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uBCA0\uC789\uBCA0\uC789"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC0E4\uC6C3!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uB4DC\uB7EC\uB7FC"
  }
]
