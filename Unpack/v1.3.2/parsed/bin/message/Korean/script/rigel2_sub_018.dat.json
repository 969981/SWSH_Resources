[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBCA0\uBCA0~"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uADF8 \uD3EC\uCF13\uBAAC\uC740 \uC544\uB9C8\\n\uBCA0\uBCA0\uB188\uC774\uB77C\uB294 \uAC1C\uCCB4\uC77C \uAC81\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uC5D0 \uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74 \uC548\uC5D0\uC11C\\n\uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4\uB9CC..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC870\uC0AC\uB97C \uD558\uBA74 \uD560\uC218\uB85D\\n\uC2E0\uAE30\uD55C \uD3EC\uCF13\uBAAC\uC774\uB354\uAD70\uC694..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uBC88 \uC18C\uB3D9\uACFC\uB3C4\\n\uAD00\uACC4\uAC00 \uC788\uC744 \uAC83 \uAC19\uB124\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74 \uC5F0\uAD6C\uC5D0\\n\uD55C\uCE35 \uB354 \uBC15\uCC28\uB97C \uAC00\uD574\uC57C\uACA0\uC5B4\uC694!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uBCA0\uBCA0\uB188\uC740 \uC7A0\uC2DC \uD55C\uB208\uC744 \uD314\uBA74\\n\uAE08\uBC29 \uC5B4\uB514\uB860\uAC00 \uAC00\uB824\uACE0 \uD574\uC11C\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC2E4\uB825 \uC788\uB294 \uD2B8\uB808\uC774\uB108\uBD84\uAED8\\n\uBCA0\uBCA0\uB188\uC744 \uB9E1\uAE38\uAE4C \uD558\uB294\uB370\\r\\n[VAR 0100(0000)]\uB2D8\uC740 \uC5B4\uB5A0\uC2E0\uAC00\uC694?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBCA0\uBCA0\uB188\uC744 \uB9E1\uAE38 \uB9CC\uD55C \uC0AC\uB78C\uC73C\uB85C\\n[VAR 0100(0000)]\uB2D8\uBC16\uC5D0\\r\\n\uB5A0\uC624\uB974\uC9C0 \uC54A\uB294\uB370 \uC5B4\uB5A0\uC2E0\uAC00\uC694?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC74C... \uADF8\uAC70 \uC544\uC27D\uB124\uC694!\\n\uB9C8\uC74C\uC774 \uBC14\uB00C\uC2DC\uAC70\uB4E0 \uC5B8\uC81C\uB4E0 \uB9D0\uC500\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4!\\n\uADF8\uB7FC \uBCA0\uBCA0\uB188\uC744\\r\\n\uC798 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBCA0\uB9AC\uBCA0\uB9BC~!"
  }
]
