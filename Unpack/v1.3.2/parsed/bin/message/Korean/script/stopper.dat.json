[
  {
    "index": 0,
    "flags": 0,
    "text": "\u30B9\u30C8\u30C3\u30D1\u30FC\u30E1\u30C3\u30BB\u30FC\u30B8\uFF08\u304B\u308A\uFF09"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uAC1C\uD68C\uC2DD!\\n\uC81C \uAC00\uC2B4\uB3C4 \uB450\uADFC\uAC70\uB9AC\uB294 \uAC83 \uAC19\uC544\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAE4C\uC544\uC544~"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5D4\uC9C4\uC2DC\uD2F0\uB294 \uAD49\uC7A5\uD574!\\c\\n\uC704\uC640 \uC544\uB798\uC758 \uC5D0\uB9AC\uC5B4\uB97C\\n\uC2B9\uAC15\uAE30\uB85C \uC624\uAC08 \uC218 \uC788\uB2E4\uACE0!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uAC01\uC9C0\uC5D0 \uC788\uB294\\n8\uBA85\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5...\\c\\n\uD558\uB098\uAC19\uC774 \uAC15\uC790\uB4E4\uBFD0\uC774\uC57C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB4E4\uC774 \uC774\uAE38 \uC218 \uC788\uC744\uAE4C?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[~ 5]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB3D9\uB8CC \uD3EC\uCF13\uBAAC\uC774 \uC5C6\uC73C\uB2C8\uAE4C\\n\uC544\uC9C1 \uD480\uC232\uC5D0 \uB4E4\uC5B4\uAC00\uBA74 \uC548 \uB3FC![VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC6B0\uB974\uAC00 \uAE38\uC744 \uB9C9\uACE0 \uC788\uC5B4\uC11C\\n\uC55E\uC73C\uB85C \uC9C0\uB098\uAC08 \uC218 \uC5C6\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5B4\uC774! \uC5B4\uB514 \uAC00\uB294 \uAC70\uC57C?\\n\uB098\uC640 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD574\uC57C\uC9C0![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uC774! \uBB50 \uD558\uACE0 \uC788\uB294 \uAC70\uC57C?\\n\uD3EC\uCF13\uBAAC\uC744 \uCC3E\uC73C\uB7EC \uAC00\uC57C\uC9C0![VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[~ 11]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBBF8\uC548\uD558\uAD6C\uB098! \uC610\uB2E8 \uB140\uC11D\uB4E4 \uB54C\uBB38\uC5D0\\n\uB2E4\uB9AC\uAC00 \uC9C0\uC800\uBD84\uD574\uC838\uC11C \uB9D0\uC774\uB2E4...\\c\\n\uC870\uAE08 \uC788\uC73C\uBA74 \uCCAD\uC18C\uAC00 \uB05D\uB098\uB2C8\uAE4C\\n\uADF8\uB54C\uAE4C\uC9C0 \uC7A0\uAE50 \uAE30\uB2E4\uB824\uC8FC\uC9C0 \uC54A\uACA0\uB2C8?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD638\uBE0C\uAC00 \uAC00\uBC29 \uAC00\uC838\uC624\uB294 \uAC70\\n\uC78A\uC9C0 \uB9D0\uB77C\uACE0 \uB9D0\uD588\uC5C8\uC9C0?\\c\\n\uAC00\uBC29\uACFC \uBAA8\uC790\uB77C\uBA74\\n\uB124 \uBC29\uC5D0 \uC788\uC744 \uAC70\uC57C[VAR 0114(0008)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5B4\uB77C? [VAR 0100(0000)]\\n\uD638\uBE0C\uAC00 \uB110 \uCC3E\uACE0 \uC788\uC5C8\uC5B4\\c\\n\uBC14\uB85C \uC606\uC9D1\uC778\uB370\\n\uC5B4\uC9F8\uC11C \uB9C8\uC744 \uBC16\uC73C\uB85C \uAC00\uB824\uB294 \uAC70\uC57C?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[~ 15]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uBE0C\uB798\uC2DC\uB9C8\uC744\uC5D0 \uAC04\uB2E4\uACE0\\n\uC544\uC90C\uB9C8\uD55C\uD14C \uB9D0\uC500\uB4DC\uB9B0 \uAC70\uC9C0?\\r\\n\uB9D0\uB3C4 \uC5C6\uC774 \uAC14\uB2E4\uAC04 \uD63C\uB0A0 \uAC70\uC57C[VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCFE0\uC6B8 \uCFE0\uC6B0\uC6B8..."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC6B0\uB974\uB4E4\uC774 \uC790\uACE0 \uC788\uB2E4\\n\uAE68\uC9C0 \uC54A\uAC8C \uB3CC\uC544\uC11C \uAC00\uB3C4\uB85D \uD558\uC790"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD615\uC744 \uB9C8\uC911\uD558\uB7EC \uAC00\uC790!\\n\uC774 \uAE38\uC744 \uCB49 \uB530\uB77C\uAC00\uBA74 \uC5ED\uC774\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB0B4 \uC6B0\uB974\uAC00 \uD3EC\uCF13\uBAAC\uC13C\uD130\uB97C \uB108\uBB34 \uC88B\uC544\uD574\uC11C\\n\uC6C0\uC9C1\uC77C \uC0DD\uAC01\uC774 \uC5C6\uB294 \uBAA8\uC591\uC774\uC57C...\\c\\n\uC790! \uC6B0\uB974!\\n\uB108\uB294 \uC774\uBBF8 \uAE30\uC6B4\uC774 \uB118\uCE58\uB2C8\uAE4C \uB3CC\uC544\uAC00\uC790"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC6B0\uB974\uB974\uB974..."
  },
  {
    "index": 22,
    "flags": 0,
    "text": "2\uBC88\uB3C4\uB85C\uC5D0\uC11C \uB2E8\uB828\uD558\uACE0 \uC788\uB294\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB4E4\uC5D0\uAC8C \uC84C\uC5B4...\\c\\n\uB108\uBB34 \uCDA9\uACA9\uC801\uC774\uB77C \uC6C0\uC9C1\uC774\uC9C0 \uBABB\uD558\uACA0\uC73C\uB2C8\uAE4C...\\n\uC7A0\uC2DC \uC774\uB7EC\uACE0 \uC788\uAC8C \uD574\uC918..."
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAFB8\uBC85\uC878\uC74C\uC232\uC740 \uC774\uCABD\uC774\uC57C!\\n\uC6B0\uB974\uB97C \uCC3E\uC73C\uB7EC \uAC00\uC790![VAR 0114(0005)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uB2D8\uAED8\uC11C \uB9D0\uC500\uD558\uC2DC\uC9C0 \uC54A\uC73C\uC168\uB098\uC694?\\n\uBE68\uB9AC \uAC00\uC11C \uBB3C\uBC30\uC9C0\uB97C \uD68D\uB4DD\uD574\uC8FC\uC138\uC694[VAR 0114(0007)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC2DC\uAD70\uC694\\c\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC778 \uC57C\uCCAD\uB2D8\uC740\\n\uB4F1\uB300\uC5D0 \uACC4\uC138\uC694\\c\\n\uB4F1\uB300\uB294... \uC5EC\uAE30\uC11C\\n\uBC14\uB2F7\uAC00 \uCABD\uC73C\uB85C \uAC00\uBA74 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB97C \uBC29\uD574\uD558\uAE30 \uC704\uD574\\n\uC774\uACF3\uC744 \uBABB \uC9C0\uB098\uAC00\uAC8C \uB9C9\uACE0 \uC788\uC2B5\uB2C8\uB2E4~"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC610\uB2E8\uC740 \uC81C2\uAD11\uC0B0\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uC744 \uB2E8\uB828\uD560 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC610! \uC610! \uC751\uC6D0 \uC5F0\uC2B5\uC744 \uD569\uC2DC\uB370\uC5D8!\\n\uB9C8\uB9AC\uB97C \uC751\uC6D0\uD569\uC2DC\uB370\uC5D8!!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC610! \uC610! \uC751\uC6D0 \uC5F0\uC2B5\uC744 \uD569\uC2DC\uB370\uC5D8!\\n\uB9C8\uB9AC\uB97C \uC751\uC6D0\uD569\uC2DC\uB370\uC5D8!!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC610\uB2E8\uC740 \uC678\uCE69\uB2C8\uB370\uC5D8!\\n\uD798\uB0B4\uB77C \uD798\uB0B4\uB77C \uB9C8\uB9AC!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC610\uB2E8\uC740 \uC678\uCE69\uB2C8\uB370\uC5D8!\\n\uD798\uB0B4\uB77C \uD798\uB0B4\uB77C \uB9C8\uB9AC!"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0\uC758 \uBCF4\uBB3C\uACE0\uB294\\n\uD5C8\uAC00 \uC5C6\uC774 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC610! \uC610!\\n\uB9C8\uB9AC \uC0AC\uB791\uD55C\uB370\uC5D8!"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "[~ 34]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC544\uBA38\uAE4C\uC624\uB294\\n\uD558\uB298\uC744 \uB0A0\uC544\uC11C \uC0AC\uB78C\uC744 \uC774\uB3D9\uC2DC\uCF1C\uC918\\r\\n\uB2E4\uB9CC \uC9C0\uAE08\uC740 \uC9C0\uCE5C \uBAA8\uC591\uC774\uC57C..."
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uC120\uC218\uBD84\uC740\\n\uC544\uC9C1 \uBD88\uAF43\uBC30\uC9C0\uB97C \uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uC73C\uC2DC\uB124\uC694\\c\\n\uC774\uB300\uB85C\uB294 \uB4E4\uC5B4\uAC00\uC2E4 \uC218 \uC5C6\uB294\uB370\\n\uB2E4\uB9AC \uC785\uAD6C\uAE4C\uC9C0\\r\\n\uBAA8\uC154\uB2E4\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!\\n\uADF8\uB7FC \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC624\uC624! \uB108\uBB34 \uBB34\uB9AC\uD558\uC9C0 \uB9C8\uC2DC\uACE0\\n\uCEA0\uD551\uB3C4 \uC990\uACA8\uC8FC\uC138\uC694"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uAC74\uAC15\uD574\uC9C4 \uC544\uBA38\uAE4C\uC624\uB294\\n\uB2E4\uC74C \uD3EC\uCF13\uBAAC\uC7A1\uC744 \uD558\uB7EC \uAC14\uC5B4!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "[~ 40]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "[~ 41]"
  }
]
