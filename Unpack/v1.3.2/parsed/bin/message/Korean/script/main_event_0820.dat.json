    "text": "\uAC00\uC790 [VAR 0100(0000)]![VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC751?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\\n\uC77C\uBD80\uB7EC \uBC30\uC6C5\uD558\uB7EC \uC624\uC2E0 \uAC70\uC608\uC694?\\c\\n\uC21C\uBB34\uB2D8\uB3C4 \uC81C\uAC00 \uCC54\uD53C\uC5B8\uC774\\n\uB420 \uAC70\uB77C\uB294 \uAC78 \uC544\uC2DC\uB098 \uBCF4\uB124\uC694![VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 3\uAC1C\uB3C4 \uBAA8\uC73C\uC9C0 \uBABB\uD558\uACE0\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD3EC\uAE30\uD558\uB294\\r\\n\uD2B8\uB808\uC774\uB108\uB294 \uC218\uC5C6\uC774 \uB9CE\uC9C0...\\c\\n\uADF8\uB798\uC11C \uB098\uB97C \uC774\uAE34 \uC0C1\uB300\uB294\\n\uBAA8\uB450 \uBC30\uC6C5\uD574\uC8FC\uACE0 \uC788\uB2E8\uB2E4[VAR 0114(0010)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD734 \uB2A6\uC9C0 \uC54A\uC558\uB124...\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB97C \uD0C0\uAE38 \uC798 \uD588\uC5B4[VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uADF8\uB9AC\uACE0 \uD638\uBE0C \uCD95\uD558\uD574!\\n\uC21C\uBB34\uB2D8\uC744 \uC774\uAE30\uB2E4\uB2C8 \uAD49\uC7A5\uD55C\uAC78?[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC5D0\uAC8C\uC11C \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBC1B\uC744 \uC218 \uC788\uB294\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB294 \uC5BC\uB9C8 \uC5C6\uC5B4\uC694\\c\\n\uADF8\uB798\uC11C \uC751\uC6D0\uD558\uB294 \uC758\uBBF8\uB85C\\n\uB2E4 \uAC19\uC774 \uBC30\uC6C5\uD574\uC8FC\uACE0 \uC788\uC2B5\uB2C8\uB2E4[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC774\uC81C\\n\uB108\uD76C\uC5D0\uAC8C \uC131\uC6D0\uC744 \uBCF4\uB0B4\uC8FC\uB9C8![VAR 0114(0010)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD798\uB0B4\uB77C \uD798\uB0B4\uB77C \uD638\uBE0C!\\n\uC774\uACA8\uB77C \uC774\uACA8\uB77C [VAR 0100(0000)]![VAR 0114(0010)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB108\uD76C\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB294\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC740 \uD558\uB098\uAC19\uC774 \uAC15\uC790\uB4E4\uBFD0\uC774\uB2E4\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB108\uD76C\uB77C\uBA74 \uC774\uAE38 \uC218 \uC788\uB2E4!\\n\uADF8\uB7EC\uB2C8 \uD3EC\uCF13\uBAAC\uC744 \uBBFF\uACE0 \uB098\uC544\uAC00\uAC70\uB77C![VAR 0114(0010)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB2E4\uB4E4 \uACE0\uB9C8\uC6CC\uC694!\\c\\n\uC6B0\uB9AC \uB458\uC774 \uACB0\uC2B9\uC804\uC744 \uCE58\uB97C \uB54C\uAE4C\uC9C0\\n\uACC4\uC18D\uD574\uC11C \uC774\uAE38\uAC8C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBAA9\uC801\uC9C0\uB294 \uB108\uD074\uC2DC\uD2F0!\\n\uD798\uB0B4\uC790 [VAR 0100(0000)]![VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC790\uC2E0\uC5D0\uAC8C\\n\uBD80\uC871\uD55C \uC810\uC744 \uCC3E\uC544\uB77C!\\c\\n\uADF8\uAC83\uC744 \uC544\uB294 \uC790\uC57C\uB9D0\uB85C\\n\uB354 \uB9CE\uC774 \uBC30\uC6B0\uACE0 \uC131\uC7A5\uD560 \uC218 \uC788\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB18D\uC0AC\uC77C\uC744 \uD558\uB2E4 \uBCF4\uBA74\\n\uC608\uC0C1\uD558\uC9C0 \uBABB\uD55C \uC77C\uC774 \uB9CE\uC774 \uC77C\uC5B4\uB098\uC8E0\\c\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC608\uC694\\n\uD3EC\uAE30\uD558\uC9C0\uB9CC \uC54A\uC73C\uBA74 \uC5B4\uB5BB\uAC8C\uB4E0 \uB420 \uAC70\uC608\uC694[VAR 0114(000E)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC790\uC2E0\uC5D0\uAC8C \uC5C4\uACA9\uD55C \uAC83\uB3C4 \uC88B\uC9C0\uB9CC\\n\uB108\uBB34 \uACFC\uD558\uAC8C \uC870\uC774\uBA74 \uD130\uC838 \uBC84\uB824\\c\\n\uADF8\uB7F4 \uB54C\uB294\\n\uC2DC\uD478\uB4DC \uB808\uC2A4\uD1A0\uB791\uC5D0 \uB4E4\uB7EC\uC918[VAR 0114(000F)]"
  }
]
