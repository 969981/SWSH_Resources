[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB9C8\uC744\uC744 \uC9C0\uCF1C\uC918\uC11C \uACE0\uB9D9\uB124[VAR 0114(0079)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC6D0\uB798\uB294 \uB0B4\uAC00\\n\uB140\uC11D\uC744 \uC81C\uC5B4\uD588\uC5B4\uC57C \uD588\uB294\uB370[VAR 0114(0079)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD798\uC774 \uC57D\uD574\uC9C4 \uD0D3\uC5D0\\n\uBB3C\uB7EC\uB098\uAC8C \uD558\uB294 \uAC83\uC774 \uACE0\uC791\uC774\uC5C8\uB124[VAR 0114(0079)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC720\uB300\uC758\uACE0\uC090\uB9CC \uC788\uC5C8\uC5B4\uB3C4\\n\uC190\uC27D\uAC8C \uC81C\uC5B4\uD560 \uC218 \uC788\uC5C8\uC744 \uD150\uB370...[VAR 0114(0079)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uAC00 \uB9CC\uB4E4\uC790!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAF43\uC774 \uD544\uC694\uD574!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBB63\uC774? \uC720\uB300\uC758\uACE0\uC090\uB294\\n\uB0B4\uAC00 \uD53C\uC6CC\uB0B4\uB294 \uBE5B\uB098\uB294 \uAF43\uACFC\\r\\n\uC560\uB9C8\uC758 \uAC08\uAE30\uB85C \uB9CC\uB4DC\uB294 \uAC83\uC774\uB77C\uACE0!?[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAF43\uC774\uB77C... \uAF43...\\n\uADF8\uB798... \uADF8\uB7F0 \uAC70\uC600\uAD70![VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC778\uAC04\uB4E4\uC774 \uC720\uB300\uC758\uACE0\uC090\uB97C\\n\uBC14\uCE58\uC9C0 \uC54A\uAC8C \uB41C \uAC83\uC740\\c\\n\uB098\uB97C \uD5A5\uD55C \uBBFF\uC74C\uC774\\n\uC0AC\uB77C\uC84C\uAE30 \uB54C\uBB38\uC774\uB77C \uC0DD\uAC01\uD588\uB294\uB370...[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uADF8 \uC7AC\uB8CC\uB97C \uB9CC\uB4E4\uC9C0 \uBABB\uD558\uAC8C \uB41C \uAC83\uC774\\n\uC6D0\uC778\uC774\uC5C8\uC744 \uC904\uC774\uC57C![VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC624\uB79C \uC138\uC6D4 \uB3D9\uC548 \uADF8\uB4E4\uC744 \uC624\uD574\uD574\uC654\uAD70...[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBE5B\uB098\uB294 \uAF43\uC740 \uB9CE\uC740 \uD798\uC744 \uC0AC\uC6A9\uD574\uC57C\\n\uACA8\uC6B0 \uD53C\uC6CC\uB0BC \uC218 \uC788\uC5B4\uC11C\\r\\n\uC218\uBC31 \uB144\uAC04 \uD53C\uC6CC\uB0B4\uC9C0 \uBABB\uD588\uB294\uB370[VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uBD80\uD130 \uC870\uAE08\uC529\\n\uD798\uC774 \uB3CC\uC544\uC624\uACE0 \uC788\uB2E4\uB124[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uB7FC, \uC624\uB79C\uB9CC\uC5D0\\n\uBE5B\uB098\uB294 \uAF43\uC744 \uD53C\uC6CC\uBCF4\uACA0\uB124![VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD06C\uB77C\uC6B0\uC2A4 \uBE14\uB8E8\uBB34\uC2A4![VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC, \uC774\uAC83\uC744 \uBC1B\uAC8C[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD6C4\uC6B0... \uD6C4\uC6B0...[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uAF43 \uD55C \uC1A1\uC774\uB97C \uD53C\uC6CC\uB0B4\uB294 \uAC74\\n\uD798\uB4E4\uC5C8\uB358 \uBAA8\uC591\uC774\uAD70...[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCDA9\uBD84\uD560\uC9C0 \uBAA8\uB974\uACA0\uB124\uB9CC\\n\uADF8 \uAF43\uC78E\uC744 \uAC00\uC9C0\uACE0\\r\\n\uC720\uB300\uC758\uACE0\uC090\uB97C \uB9CC\uB4E4\uC5B4\uC8FC\uAC8C[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uACE0\uC090\uB97C \uB9CC\uB4E4\uB358 \uC77C\uC871\uC758 \uC790\uC190\uC774\\n\uB9C8\uC744\uC5D0 \uC0B4\uACE0 \uC788\uC744 \uAC83\uC774\uB124[VAR 0114(0079)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBD80\uD0C1\uD558\uACA0\uB124[VAR 0114(0079)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC720\uB300\uC758\uACE0\uC090?\\n\uCD0C\uC7A5\uB2D8\uB124 \uC9D1\uC5D0\uC11C\\r\\n\uB300\uB300\uB85C \uB9CC\uB4E4\uB358 \uB048\uC744 \uB9D0\uD558\uB294 \uAC74\uAC00?"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uAD81\uAE08\uD55C \uAC8C \uC788\uB2E4\uBA74\\n\uCD0C\uC7A5\uB2D8 \uB301\uC5D0 \uC788\uB294\\r\\n\uCC45\uC774\uB77C\uB3C4 \uC77D\uC5B4\uBCF4\uB294 \uAC8C \uC5B4\uB5A0\uB0D0?"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uACE0\uC090\uB97C \uB9CC\uB4E4\uACE0 \uC2F6\uB2E4\uACE0?\\c\\n\uCD0C\uC7A5\uB2D8\uC774 T\uC154\uCE20\uB294 \uC798 \uB9CC\uB4DC\uC2DC\uB358\uB370\\n\uACE0\uC090\uB294 \uBAA8\uB974\uACA0\uB124"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uBB50? \uC720\uB300\uC758\uACE0\uC090?\\n\uC74C~ \uBAA8\uB974\uACA0\uAD6C\uBA3C..."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uACFC \uC774\uC57C\uAE30\uB97C \uC798 \uB098\uB204\uB294 \uAC78 \uBCF4\uB2C8\\n\uB108\uB294 \uBAA8\uB450\uC640 \uCE5C\uD558\uAC8C \uC9C0\uB0B4\uB294 \uBAA8\uC591\uC774\uAD6C\uB098"
  }
]
