[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC557! \uB108\uB77C\uBA74\\n\uAD1C\uCC2E\uC744 \uAC83 \uAC19\uB2E4..."
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB0B4\uAC00... \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC5D0\uAC8C\\n\uD3B8\uC9C0\uB97C \uC37C\uB294\uB370 \uB9D0\uC774\uC57C..."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAD1C\uCC2E\uB2E4\uBA74\\n\uB098 \uB300\uC2E0 \uC804\uB2EC\uD574\uC8FC\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC88B\uC544!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC2EB\uC5B4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098...\\n\uC774\uC0C1\uD55C \uAC78 \uBB3C\uC5B4\uBD10\uC11C \uBBF8\uC548\uD574"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC557 \uD639\uC2DC \uD3B8\uC9C0\uB97C\\n\uC804\uB2EC\uD574\uC904 \uB9C8\uC74C\uC774 \uC0DD\uAE34 \uAC70\uC57C?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAE30\uBED0...\\n\uC815\uB9D0 \uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB098\uB294 \uD3F4\uB77C\uB77C\uACE0 \uD574\\n\uADF8\uB7FC \uD3B8\uC9C0\uB97C \uBD80\uD0C1\uD560\uAC8C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC544\uB77C\uBCA0\uC2A4\uD06C\uB9C8\uC744\uC758\\n\uD504\uB7AD\uD06C\uC5D0\uAC8C \uC804\uB2EC\uD574\uC918"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD3B8\uC9C0\uB97C \uBD80\uD0C1\uD560\uAC8C\\c\\n\uC544\uB77C\uBCA0\uC2A4\uD06C\uB9C8\uC744\uC758\\n\uD504\uB7AD\uD06C\uC5D0\uAC8C \uC804\uB2EC\uD574\uC918"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD504\uB7AD\uD06C?\\n\uADF8\uAC74 \uC6B0\uB9AC \uD560\uC544\uBC84\uC9C0 \uC774\uB984\uC778\uB370?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC73C\uC751?\\n\uB0B4\uAC00 \uD504\uB7AD\uD06C\uB2E4\uB9CC..."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBB50\uC57C? \uB0B4 \uC55E\uC73C\uB85C\\n\uD3B8\uC9C0\uAC00 \uC654\uB2E4\uACE0?"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n\uB0A1\uC740\uD3B8\uC9C0\uB97C \uC804\uB2EC\uD588\uB2E4"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBCF4\uB0B8 \uC0AC\uB78C\uC740...\\n\uC624\uC624 \uD3F4\uB77C\uB85C\uAD70!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC774\uC57C~ \uC61B\uB0A0 \uC0DD\uAC01\uC774 \uB098\uB294\uAD6C\uB098\\c\\n\uC5B4\uB838\uC744 \uB54C\\n\uC790\uC8FC \uD568\uAED8 \uB180\uACE4 \uD588\uC9C0"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5B4\uB290 \uB0A0 \uADF8\uB140\uAC00 \uBCD1\uC5D0 \uAC78\uB838\uB294\uB370\\n\uADF8 \uC0AC\uC2E4\uC744 \uB098\uC5D0\uAC8C \uC228\uAE34 \uC801\uC774 \uC788\uC5C8\uC9C0"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uADF8\uAC83 \uB54C\uBB38\uC5D0 \uB2E4\uD22C\uACE0 \uC5BC\uB9C8 \uB418\uC9C0 \uC54A\uC544\\n\uB0B4\uAC00 \uC774\uC0AC\uB97C \uAC00\uAC8C \uB3FC\uC11C...\\r\\n\uADF8 \uB4A4\uB85C\uB294 \uB9CC\uB098\uC9C0 \uBABB\uD588\uB2E8\uB2E4..."
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uADF8\uB798, \uD3F4\uB77C\uB294\\n\uAC74\uAC15\uD558\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uB354\uB0D0?"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB124"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "... ... ..."
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uBA74 \uB2E4\uD589\uC774\uAD6C\uB098"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uD750\uC74C...?\\n\uB108\uB294 \uCC38 \uB9D0\uC218\uAC00 \uC801\uC740 \uC544\uC774\uAD6C\uB098"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uCD94\uC5B5\uC744 \uC804\uB2EC\uD574\uC900 \uBCF4\uB2F5\uC774\uB2E4\\n\uC774\uAC78 \uAC00\uC838\uAC00\uB824\uBB34\uB098"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB108\uC5D0\uAC90\\n\uCE5C\uAD6C\uAC00 \uC788\uB2C8?\\c\\n\uC18C\uC911\uD55C \uCE5C\uAD6C\uB294\\n\uD56D\uC0C1 \uC18C\uC911\uD788 \uB300\uD574 \uC8FC\uAC70\uB77C"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC5B4\uB77C?\\n\uBB54\uAC00 \uB5A8\uC5B4\uC838 \uC788\uB2E4...!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB8E8\uBBF8\uB108\uC2A4\uBA54\uC774\uC988\uC232\uC740\\n\uBC84\uC12F\uC744 \uBE5B\uB098\uAC8C \uD558\uBA74\\r\\n\uAC78\uC5B4 \uB2E4\uB2C8\uAE30 \uD3B8\uD574\uC9C4\uB2E8\uB2E4"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uD3EC\uD50C\uB7EC \uD560\uBA38\uB2C8\uB294 \uB9CC\uB0A0 \uB54C\uB9C8\uB2E4\\n\uD551\uD06C\uC0C9 \uC637\uC744 \uCD94\uCC9C\uD574\uC8FC\uC154"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC774\uC720\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uC694\uC998 \uD560\uC544\uBC84\uC9C0\uAC00 \uAE30\uBD84\uC774 \uC88B\uC73C\uC2E0 \uAC83 \uAC19\uC544!\\r\\n\uD3B8\uC9C0 \uC804\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD3B8\uC9C0...\\n\uC804\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC..."
  }
]
