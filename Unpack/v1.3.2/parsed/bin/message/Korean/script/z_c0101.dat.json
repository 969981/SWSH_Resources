    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774 \uD3B8\uC9C0\uB97C \uAC00\uC838\uAC00\uB294\\n\uC6B0\uD3B8\uD568\uC774\uB2E4!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB2E4\uC591\uD55C \uCC45\uC774 \uB193\uC5EC \uC788\uB2E4\\c\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uD2B9\uC9D1\uC758 \uC7A1\uC9C0\uAC00\\n\uC778\uAE30\uB77C\uACE0 \uAD11\uACE0\uD558\uACE0 \uC788\uB2E4"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD76C\uADC0\uD55C \uBB3C\uAC74\uC774 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uB294\\n\uB808\uCF54\uB4DC\uC20D\uC774\uB77C\uB294 \uB4EF\uD558\uB2E4"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "[~ 22]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "[~ 23]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "[~ 24]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "[~ 25]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC815\uB9D0 \uD070 \uB9C8\uC744\uC774\uAD6C\uB098!\\c\\n\uB098\uB77C\uBA74 \uBCF4\uB098 \uB9C8\uB098 \uAE38\uC744 \uC783\uC744 \uD14C\uB2C8\uAE4C\\n\uD2C8\uD2C8\uC774 \uD0C0\uC6B4\uB9F5\uC744 \uBD10\uC57C\uACA0\uC5B4"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC5D0\uC11C \uCC54\uD53C\uC5B8\uC740\\n\uADF8\uC57C\uB9D0\uB85C \uC601\uC6C5\uACFC\uB3C4 \uAC19\uC740 \uC874\uC7AC\uB780\uB2E4\\r\\n\uBAA8\uB450\uAC00 \uADF8\uC758 \uC5B8\uB3D9\uC5D0 \uC8FC\uBAA9\uD558\uACE0 \uC788\uC9C0"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uBAAC\uC2A4\uD130\uBCFC\uC744 \uB358\uC9C4\uB2E4!\\c\\n\uBA87 \uBC88\uC774\uACE0 \uB358\uC838\uC11C\\n\uD3FC\uC744 \uC77C\uC815\uD558\uAC8C \uB9CC\uB4DC\uB294 \uAC70\uC57C!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\uC774 \uB358\uC9C0\uB294 \uBCFC\uC740\\n\uB108\uBB34 \uAE30\uC138\uAC00 \uAC15\uD574\uC11C\\r\\n\uC548\uC5D0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC758 \uB208\uC774 \uD551\uD551 \uB3CC \uAC83 \uAC19\uC544"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uCE04\uB8E8\uCE04\uB8E8~"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "[~ 31]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB2EC\uBB34\uB9AC\uB098\uAC00 \uD3B8\uD788 \uC274 \uC218 \uC788\uB294\\n\uACF5\uAC04\uC774 \uC788\uC5B4\uC11C \uC815\uB9D0 \uCD5C\uACE0\uC57C!\\c\\n\uB098\uB3C4 \uBB34\uC2EC\uACB0\uC5D0\\n\uBAA9\uC744 \uCD95\uC774\uB824\uACE0 \uD588\uC744 \uC815\uB3C4\uC57C"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220\uC778 \uC131\uC7A5\uC73C\uB85C\\n\uAF43\uC744 \uD0A4\uC6B0\uACE0 \uC788\uC5B4\uC11C \uD06C\uAC8C \uC790\uB780\uB2E8\uB2E4"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uD2B9\uBCC4\uD55C \uB0A0\uC5D0\uB3C4 \uADF8\uB807\uC9C0 \uC54A\uC740 \uB0A0\uC5D0\uB3C4\\n\uB9E4\uC77C\uAC19\uC774 \uAF43\uC744 \uC0AC\uC11C \uC9D1\uC5D0 \uAC04\uB2E8\uB2E4\\c\\n\uB0B4 \uD3EC\uCF13\uBAAC\uC774\\n\uAF43\uD5A5\uAE30\uB97C \uC88B\uC544\uD574\uC11C \uB9D0\uC774\uB2E4"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB09C \uAF43\uCC98\uB7FC \uC0DD\uAE34 \uD3EC\uCF13\uBAAC\uC774 \uC88B\uC544!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uB4E4\uC740 \uC815\uB9D0 \uD798\uB4E4 \uAC83 \uAC19\uC544!\\c\\n\uC791\uC544\uC838\uC11C \uBCFC\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4\uAC00\\n\uB2E4\uC774\uB9E5\uC2A4\uB85C \uCEE4\uC84C\uB2E4\uAC00 \uD558\uB2C8\uAE4C \uB9D0\uC774\uC57C!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "...\uC2F9\uC2F9\uC2F9!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uCE58\uB77C\uBBF8\uB294 \uAE54\uB054\uD55C \uAC78 \uC88B\uC544\uD574\uC11C\\n\uAF2C\uB9AC\uB85C \uBA3C\uC9C0\uB97C \uD138\uC5B4\uB0B8\uB2E8\uB2E4"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uCC44\uC6B0\uACE0 \uC788\uAD6C\uB098?\\c\\n\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0 \uAC00\uBA74\\n\uB2E4\uC591\uD55C \uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB0A0 \uC218 \uC788\uC5B4"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uBB3C\uAC74\uC740 \uC9C1\uC811 \uBCF4\uACE0 \uB098\uC11C \uC0AC\uB294 \uAC8C\\n\uC2E4\uAC10 \uB098\uACE0 \uC88B\uB2E8 \uB9D0\uC774\uC9C0\\c\\n\uC778\uD130\uB137\uC73C\uB85C \uC0AC\uC11C \uD3EC\uCF13\uBAAC\uC774\\n\uBC30\uB2EC\uD574\uC8FC\uB294 \uAC83\uB3C4 \uC88B\uC544\uD558\uC9C0\uB9CC"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC1FC\uD551\uD558\uB294 \uAC78 \uBCF4\uBA74 \uC5B4\uB5A4 \uC0AC\uB78C\uC778\uC9C0 \uC54C \uC218 \uC788\uC5B4\\c\\n\uC6B0\uB9AC \uB0A8\uD3B8\uC740 \uC74C...\\n\uAE4A\uC774 \uC0DD\uAC01\uD558\uC9C0 \uC54A\uACE0 \uC0AC\uBC84\uB9AC\uB294 \uD3B8\uC774\uB780\uB2E4"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uAD6C\uAD6C\uC640\uC544!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uCEE4\uB2E4\uB780 \uB871\uC2A4\uD1A4\uB3C4\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uD558\uBA74 \uB354 \uAC70\uB300\uD574\uC9C8 \uC218 \uC788\uC5B4!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uBCF4\uAE30 \uC704\uD574\\n\uBA38\uB098\uBA3C \uC54C\uB85C\uB77C\uC5D0\uC11C \uC654\uB2F5\uB2C8\uB2E4!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uB0B4\uAC8C \uB4F1\uBC88\uD638\uB97C \uBD99\uC778\uB2E4\uBA74\\n\uBA87 \uBC88\uC73C\uB85C \uD558\uB294 \uAC8C \uC88B\uC744\uAE4C? \uD750\uC74C \uACE0\uBBFC\uB3FC~"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC88B\uC544\uD558\uB294 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uACFC \uAC19\uC740\\n\uC720\uB2C8\uD3FC\uC744 \uC785\uC73C\uBA74 \uAE30\uBD84 \uC88B\uC9C0 \uC54A\uB2C8?"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uB4E4\uC744 \uC218 \uC5C6\uAC8C \uB41C\\n\uAC00\uC218\uC758 \uB178\uB798\uB3C4\\r\\n\uB808\uCF54\uB4DC\uB97C \uD1B5\uD574 \uBD80\uD65C\uD558\uAC8C \uB418\uB294\uAD70..."
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uB85C\uC988\uB2D8\uC740 \uAC00\uB77C\uB974\uB97C \uC0AC\uB791\uD574\uC11C\\n\uC5D0\uB108\uC9C0 \uC0AC\uC5C5\uC744 \uD558\uBA74\uC11C\\r\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB85C \uC9C0\uBC29 \uBD80\uD765\uC5D0 \uD798\uC4F0\uACE0 \uC788\uB2E8\uB2E4"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uCEE4\uB2E4\uB780 \uC2B9\uAC15\uAE30\uAC00 \uC6C0\uC9C1\uC778\uB2E4!\\n\uC99D\uAE30\uB294 \uC815\uB9D0 \uB300\uB2E8\uD574~!"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uB098\uB294 \uBE44\uD589\uAE30\uB77C\uB4E0\uC9C0 \uCEE4\uB2E4\uB780 \uC1F3\uB369\uC774\uAC00\\n\uC6C0\uC9C1\uC774\uB294 \uAC78 \uBCF4\uB294 \uAC8C \uB108\uBB34 \uBB34\uC11C\uC6CC\\r\\n\uD3EC\uCF13\uBAAC\uC774\uB77C\uBA74 \uAD1C\uCC2E\uC9C0\uB9CC"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uC99D\uAE30\uC758 \uD798\uC73C\uB85C \uB3CC\uC544\uAC00\uB294\\n\uD1B1\uB2C8\uBC14\uD034\uB97C \uAC00\uB9CC\uD788 \uBCF4\uB294 \uC911\uC774\uC57C!"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uB0B4 \uC77C\uB808\uC98C\uC740\\n\uD1B5\uC870\uB9BC\uC744 \uB108\uBB34 \uC88B\uC544\uD55C\uB2E8 \uB9D0\uC774\uC9C0"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC911\uC5D0\uB294\\n\uC2B9\uBD80\uB97C \uC88B\uC544\uD558\uB294 \uC544\uC774\uB3C4 \uC788\uACE0\\r\\n\uCE5C\uD574\uC9C0\uAE30 \uC704\uD55C \uB2E4\uC591\uD55C \uBC29\uBC95\uC774 \uC788\uC5B4"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uBC84\uB79C\uC9C0\uB098\uC640 \uB180\uACE0 \uC788\uB294\uB370\\n\uC0AC\uC2E4\uC740 \uD568\uAED8 \uB0A0\uC544\uBCF4\uACE0 \uC2F6\uC5B4"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uBC84\uC5B4\uC5B4\uD6C4!"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uBF40\uC5E5\uBF40\uC5E5"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uC2AC\uC2AC \uB3CC\uC544\uAC00\uC790\\n\uB3D9\uCC59\uC774"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC5D0\uC11C\uB294 \uC11C\uB85C \uB3D5\uB294 \uAC8C \uB2F9\uC5F0\uD55C \uC77C\uC774\uC9C0\\n\uCCAD\uC18C\uB3C4 \uC790\uC6D0\uBD09\uC0AC\uB85C \uD558\uACE0 \uC788\uB2E8\uB2E4"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uBCC4 \uC758\uBBF8 \uC5C6\uB294 \uC774\uC57C\uAE30\uB77C\uB3C4\\n\uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744 \uC218 \uC788\uB2E4\uBA74\\r\\n\uADF8\uBCF4\uB2E4 \uD589\uBCF5\uD55C \uC77C\uC740 \uC5C6\uC744 \uAC70\uC57C!"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uC0AC\uB78C\uC740 \uBCC0\uD558\uACE0 \uC2F6\uB2E4\uACE0 \uC0DD\uAC01\uD558\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uBCC0\uD560 \uC218 \uC788\uC9C0...\\r\\n\uBD84\uBA85\uD788 \uC774 \uB299\uC740\uC774\uB3C4 \uBB54\uAC00 \uD560 \uC218 \uC788\uC744 \uAC8C\uB2E4"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uB824\uBA74\\n\uD30C\uC6CC\uD3EC\uC778\uD2B8 \uB2E4\uC2DC \uB9D0\uD574 PP\uAC00 \uD544\uC694\uD558\uB2E8\uB2E4"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uB9C8\uC744 \uD55C\uBCF5\uD310\uC5D0\uC11C \uC2B9\uBD80\uB97C \uD560 \uB54C\uB294\\n\uC8FC\uC704\uC5D0 \uD53C\uD574\uB97C \uC918\uC120 \uC548 \uB3FC"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uB9C8\uC790\uB791 \uC5EC\uB3D9\uC0DD\uC774\uB791\\n\uB2E4 \uAC19\uC774 \uC0AC\uBC29\uCE58\uAE30\uB97C \uD558\uACE0 \uC788\uC5B4\\r\\n\uBB54\uC9C0 \uC54C\uC544? \uC678\uBC1C\uB85C \uB6F0\uB294 \uAC70\uC57C"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774\uB791 \uB180\uACE0 \uC788\uC5B4!"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uB9C8\uC790 \uB9C8\uC790\uC790!"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uD5E4\uC5B4\uC2A4\uD0C0\uC77C\uC744 \uBC14\uAFB8\uACE0 \uB098\uBA74\\n\uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0 \uC788\uB294 \uB85C\uD1A0\uBBF8\uB85C\\r\\n\uB9AC\uADF8 \uCE74\uB4DC\uB3C4 \uBC14\uAFB8\uB294 \uAC70\uC57C!"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uD558\uB8E8 \uC885\uC77C \uC5F4\uC2EC\uD788...\\c\\n\uC88B\uC544\uD558\uB294 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758\\n\uC2DC\uD569\uC744 \uC751\uC6D0\uD558\uACE0 \uC788\uC5B4...\\r\\n\uC88B\uC544\uC11C \uD558\uB294 \uC77C\uC740 \uC9C8\uB9AC\uC9C0 \uC54A\uB294\uB2E8 \uB9D0\uC774\uC9C0"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\uAC15\uD55C \uAC83\uC774 \uD3EC\uCF13\uBAAC\uC758 \uB9E4\uB825\uC774\uB77C\uBA74\\n\uADC0\uC5EC\uC6B4 \uAC83\uB3C4 \uD3EC\uCF13\uBAAC\uC758 \uB9E4\uB825\uC774\uB780\uB2E4"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB294 \uC5EC\uD589\uACFC\uB3C4 \uAC19\uB2E8\uB2E4\\c\\n\uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8\\n\uC5EC\uAE30\uC800\uAE30\uB97C \uB3CC\uC544\uB2E4\uB2C8\uAC8C \uB418\uB2C8\uAE4C \uB9D0\uC774\uB2E4\\c\\n\uC798 \uB4E4\uC73C\uB834, \uC77C\uB2E8 \uCCAB\uAC78\uC74C\uC744 \uB0B4\uB51B\uACE0 \uB098\uBA74\\n\uB450 \uBC88\uC9F8\uB294 \uC5B4\uB835\uC9C0 \uC54A\uC744 \uAC70\uB780\uB2E4"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\uB178\uC778\uB4E4\uC774 \uAC70\uCC3D\uD558\uAC8C \uC774\uC57C\uAE30\uD558\uB354\uB77C\uB3C4\\n\uC80A\uC740\uC774\uB4E4\uC740 \uC790\uC2E0\uC774 \uC6D0\uD558\uB294 \uB300\uB85C \uC0B4\uC544\uAC00\uAC70\uB77C"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\uD4E8\uAC8C~!!"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uBE44\uBC00\uAE30\uC9C0\uB97C \uBCF4\uB2C8\uAE4C \uC5B4\uB54C?\\n\uC5EC\uAE30\uC5D0 \uC0C8\uB85C\uC6B4 \uCCB4\uC721\uAD00\uC744 \uB9CC\uB4E4\uACE0 \uC2F6\uB2E4!"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB77C\uBA74 2\uB144 \uC548\uC5D0 \uAC00\uB77C\uB974 \uCD5C\uACE0\uC758\\n\uCCB4\uC721\uAD00\uC73C\uB85C \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC70\uC57C!"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC640\uB294 \uBCC4\uB3C4\uB85C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uB4E4\uB07C\uB9AC \uC2F8\uC6CC\uC11C\\r\\n\uC5BC\uB9C8\uB098 \uAC15\uD55C\uC9C0 \uC21C\uC704\uB97C \uC815\uD558\uACE0 \uC788\uC5B4"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uC0AC\uB78C\uB3C4 \uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220\uC744\\n\uC4F8 \uC218 \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370...\\c\\n\uD30C\uAD34\uAD11\uC120 \uC815\uB3C4\uB294\\n\uB098\uB3C4 \uC4F8 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C?"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC5D0 \uC788\uB294 \uB300\uBD80\uBD84\uC758 \uD68C\uC0AC\uB294\\n\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC774 \uC18C\uC720\uD558\uACE0 \uC788\uB2E8\uB2E4!"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC740 \uCC54\uD53C\uC5B8!\\n\uC88B\uC544\uD558\uB294 \uB9D0\uC740 \uCD5C\uAC15\uC774\uC57C!"
  },
  {
    "index": 78,
    "flags": 0,
    "text": "\uC5D4\uC9C4\uC2A4\uD0C0\uB514\uC6C0!\\n\uAC1C\uD68C\uC2DD\uC774 \uC5F4\uB9AC\uB294 \uC7A5\uC18C\uC57C!\\r\\n\uC2DC\uBC94 \uACBD\uAE30\uB3C4 \uAE30\uB300\uB41C\uB2E4!"
  },
  {
    "index": 79,
    "flags": 0,
    "text": "\uB108\uB3C4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uCC38\uAC00\uD558\uB294 \uAC70\uC9C0?\\n\uBBFF\uC74C\uC9C1\uD55C \uD3EC\uCF13\uBAAC\uC774 \uC788\uB098 \uBCF4\uAD6C\uB098"
  },
  {
    "index": 80,
    "flags": 0,
    "text": "\uBA4B\uC9C4 \uBD88\uAF43\uBC30\uC9C0\uB97C \uAC00\uC9C0\uACE0 \uC788\uB294\\n\uC0AC\uB78C\uB4E4\uC740 \uC815\uB9D0 \uBA4B\uC9C4 \uAC83 \uAC19\uC544!"
  },
  {
    "index": 81,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uAC1C\uD68C\uC2DD\uC5D0\uB294\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uB4E4\uB3C4 \uC628\uB2E8\uB2E4"
  },
  {
    "index": 82,
    "flags": 0,
    "text": "\uB108\uB3C4 \uCC38\uAC00\uC790\uC9C0?\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uB4E4\uC5D0\uAC8C \uC9C0\uBA74 \uC548 \uB3FC!"
  },
  {
    "index": 83,
    "flags": 0,
    "text": "\uB108\uC758 \uC2DC\uD569 \uC798 \uBD24\uC5B4!\\c\\n\uC21C\uBB34\uB2D8\uC744 \uC774\uAE30\uB294 \uC21C\uAC04\uC5D0\\n\uB9CC\uC138~! \uD558\uACE0 \uC18C\uB9AC \uC9C8\uB7EC\uBC84\uB838\uC5B4!"
  },
  {
    "index": 84,
    "flags": 0,
    "text": "\uC9C4\uC9DC \uD070 \uC2A4\uD0C0\uB514\uC6C0\uC774\uB2E4!\\n\uC9D1\uC774 \uBA87 \uAC1C\uB098 \uB4E4\uC5B4\uAC08\uAE4C?"
  },
  {
    "index": 85,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uD55C \uD3EC\uCF13\uBAAC\uC774\\n\uC2F8\uC6CC\uB3C4 \uB044\uB5A1\uC5C6\uB294 \uC2A4\uD0C0\uB514\uC6C0!\\c\\n\uBA3C \uC61B\uB0A0\uC5D0\uB294 \uB3CC\uB85C \uB9CC\uB4E0\\n\uAC70\uB300 \uC2A4\uD0C0\uB514\uC6C0\uC774 \uC788\uC5C8\uB2E4\uB354\uAD6C\uB098"
  },
  {
    "index": 86,
    "flags": 0,
    "text": "[~ 86]"
  },
  {
    "index": 87,
    "flags": 0,
    "text": "\uBE44\uD2B8\uB77C\uB294 \uC120\uC218\uC5D0\uAC8C\uC11C\\n\uC7A5\uB798\uC131\uC774 \uB290\uAEF4\uC84C\uC5C8\uC5B4!\\r\\n\uBD84\uBA85\uD788 \uBB54\uAC00 \uD574\uB0BC \uAC83 \uAC19\uC544!"
  },
  {
    "index": 88,
    "flags": 0,
    "text": "\uB098\uB294 \uB2E8\uB378\uC758 \uB9AC\uC790\uBABD\uC774\\n\uC81C\uC77C \uC88B\uC544!"
  },
  {
    "index": 89,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uCC38\uAC00\uD558\uC2DC\uB294 \uBD84\uB4E4\uC740\\n\uBAA8\uB450 \uAF2C\uBABD\uC6B8\uBE44\uC988\uB2C8\uC2A4\uD638\uD154\uC5D0 \uBB35\uAC8C \uB429\uB2C8\uB2E4"
  },
  {
    "index": 90,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB85C \uD3BC\uCCD0\uC9C0\uB294\\n\uB2E4\uC591\uD55C \uC2DC\uD569\uC740\\r\\n\uC6B0\uB9AC \uB9AC\uADF8 \uC2A4\uD0DC\uD504\uB4E4\uC774 \uC11C\uD3EC\uD2B8\uD569\uB2C8\uB2E4"
  },
  {
    "index": 91,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800!\\n\uBA4B\uC9C4 \uC2DC\uD569 \uAE30\uB300\uD558\uACE0 \uC788\uC744\uAC8C!"
  },
  {
    "index": 92,
    "flags": 0,
    "text": "\uD798\uB0B4~!"
  },
  {
    "index": 93,
    "flags": 0,
    "text": "\uC751\uC6D0\uD558\uACE0 \uC788\uC5B4\uC694!"
  },
  {
    "index": 94,
    "flags": 0,
    "text": "\uD30C\uC774\uD305!"
  },
  {
    "index": 95,
    "flags": 0,
    "text": "\uAE84~!\\n\uBA4B\uC838~!"
  },
  {
    "index": 96,
    "flags": 0,
    "text": "\uD798\uCC28\uAC8C \uAC00\uB77C!\\n\uC798 \uB2E4\uB140\uC640\uB77C!"
  },
  {
    "index": 97,
    "flags": 0,
    "text": "\uC557! \uC18C\uBB38\uC758\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2E4!"
  },
  {
    "index": 98,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD55C\uB2E4\uACE0?\\n\uADF8\uB807\uB2E4\uBA74 \uD798\uB0B4\uB834!"
  },
  {
    "index": 99,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC740\\n\uAC15\uD558\uB2C8\uAE4C!"
  },
  {
    "index": 100,
    "flags": 0,
    "text": "\uD798\uB0B4\uC138\uC694!"
  },
  {
    "index": 101,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uB4E4\uC774\\n\uBAA8\uB450 \uBAA8\uC600\uB2E4!"
  },
  {
    "index": 102,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC744 \uC774\uAE30\uB2E4\uB2C8\\n\uB300\uB2E8\uD55C \uD2B8\uB808\uC774\uB108\uAD6C\uB098!"
  },
  {
    "index": 103,
    "flags": 0,
    "text": "[~ 103]"
  },
  {
    "index": 104,
    "flags": 0,
    "text": "\uB0A0\uC528\uAC00 \uC88B\uB124"
  },
  {
    "index": 105,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC774 \uC9C0\uB2E4\uB2C8!\\n\uAD49\uC7A5\uD55C \uC2DC\uD569\uC774\uC5C8\uC5B4"
  },
  {
    "index": 106,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8!\\n\uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 107,
    "flags": 0,
    "text": "\uC5EC\uC5B4 \uC798 \uC9C0\uB0B4\uB2C8?"
  },
  {
    "index": 108,
    "flags": 0,
    "text": "\uC5EC\uC5B4! \uBA4B\uC9C4\\n\uC2DC\uD569\uC774\uC5C8\uC5B4"
  },
  {
    "index": 109,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC740 \uCC98\uC74C\uBD80\uD130\\n\uB2E4\uC2DC \uB2E8\uB828\uD558\uC2DC\uACA0\uB300"
  },
  {
    "index": 110,
    "flags": 0,
    "text": "\uC88B\uC740 \uC77C \uC788\uC5C8\uB2C8?"
  },
  {
    "index": 111,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC88B\uC740 \uC77C \uC5C6\uC744\uAE4C?"
  },
  {
    "index": 112,
    "flags": 0,
    "text": "\uC88B\uC740 \uC77C\uC744 \uCC3E\uC73C\uB7EC\\n\uC5B4\uB514\uB4E0 \uAC00\uBCFC\uAE4C"
  },
  {
    "index": 113,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uC5D0 \uBA39\uC740 \uAC70\\n\uC815\uB9D0 \uB9DB\uC788\uC5C8\uC5B4"
  },
  {
    "index": 114,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uC744 \uD574\uC57C\uC9C0!"
  },
  {
    "index": 115,
    "flags": 0,
    "text": "\uAE30\uC220\uB808\uCF54\uB4DC\\n\uBCF4\uC774\uC9C8 \uC54A\uB124..."
  },
  {
    "index": 116,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0!\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0!"
  },
  {
    "index": 117,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\uACFC\\n\uC2B9\uBD80\uD558\uACE0 \uC2F6\uC5B4!"
  },
  {
    "index": 118,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\\n\uC5B4\uB514\uB85C \uAC04 \uAC78\uAE4C?"
  },
  {
    "index": 119,
    "flags": 0,
    "text": "\uCEA0\uD504\uC5D0\uC11C \uBA39\uB294 \uC694\uB9AC\uB294\\n\uD310\uD0C0\uC2A4\uD2F1!"
  },
  {
    "index": 120,
    "flags": 0,
    "text": "\uCE74\uB808\uB294 \uC57D\uAC04\\n\uC2A4\uD29C\uC640 \uBE44\uC2B7\uD55C \uAC83 \uAC19\uC544"
  },
  {
    "index": 121,
    "flags": 0,
    "text": "\uAD00\uB3D9 \uAC19\uC740 \uACF3\uC5D0\uC11C\uB294\\n\uCE74\uB808\uAC00 \uC778\uAE30\uAC00 \uB9CE\uB300"
  },
  {
    "index": 122,
    "flags": 0,
    "text": "\uB9C8\uC744\uC5D0\uC11C \uB180\uACE0 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uBCF4\uBA74 \uD790\uB9C1\uC774 \uB3FC"
  },
  {
    "index": 123,
    "flags": 0,
    "text": "\uB0B4 \uCDE8\uBBF8\uB294 \uCEA0\uD504\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uB4E4\uACFC \uB178\uB294 \uAC70\uC57C"
  },
  {
    "index": 124,
    "flags": 0,
    "text": "\uB098\uB77C\uBA74 \uCEA0\uD504\uB9C8\uC2A4\uD130\uAC00\\n\uB420 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C"
  },
  {
    "index": 125,
    "flags": 0,
    "text": "\uC557! \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB124!"
  },
  {
    "index": 126,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758\\n\uC720\uB2C8\uD3FC\uC744 \uC0B4 \uAC70\uC57C"
  },
  {
    "index": 127,
    "flags": 0,
    "text": "\uB108\uC758 \uB4F1\uBC88\uD638\\n\uC5C4\uCCAD \uC778\uAE30\uAC00 \uB9CE\uB354\uB77C!"
  },
  {
    "index": 128,
    "flags": 0,
    "text": "\uC3D8\uB9AC~"
  },
  {
    "index": 129,
    "flags": 0,
    "text": "\uC544~ \uACFC\uC5F0 \uADF8\uB807\uAD70"
  },
  {
    "index": 130,
    "flags": 0,
    "text": "\uBB50 \uADF8\uB7F0 \uAC74\uAC00"
  },
  {
    "index": 131,
    "flags": 0,
    "text": "\uC2A4\uD53C\uB4DC\uAC00 \uC911\uC694\uD574!\\n\uBA3C\uC800 \uACF5\uACA9\uD558\uACE0 \uC2F6\uC73C\uB2C8\uAE4C"
  },
  {
    "index": 132,
    "flags": 0,
    "text": "\uAE30\uC220\uBA38\uC2E0\uC740 \uAD49\uC7A5\uD574!\\n\uBA87 \uBC88\uC774\uB4E0 \uC4F8 \uC218 \uC788\uC5B4"
  },
  {
    "index": 133,
    "flags": 0,
    "text": "\uB85C\uD1A0\uBB34 \uB7A0\uB9AC~!\\n\uB85C\uD1A0\uBB34 \uB7A0\uB9AC~!"
  },
  {
    "index": 134,
    "flags": 0,
    "text": "\uBAAC\uC2A4\uD130\uBCFC!\\n\uC218\uD37C\uBCFC!"
  },
  {
    "index": 135,
    "flags": 0,
    "text": "\uD558\uC774\uD37C\uBCFC\uC740\\n\uD558\uC774\uD37C\uB85C \uAD49\uC7A5\uD574!"
  },
  {
    "index": 136,
    "flags": 0,
    "text": "\uBC18\uB4DC\uC2DC \uC7A1\uB294\\n\uB9C8\uC2A4\uD130\uBCFC!"
  },
  {
    "index": 137,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uB294\\n\uD3EC\uCF13\uBAAC\uC774 \uAC70\uB300\uD574\uC9C0\uB294 \uAC70\uC57C"
  },
  {
    "index": 138,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uB294\\n\uBAA8\uC2B5\uB3C4 \uBC14\uB00C\uAC8C \uB3FC!"
  },
  {
    "index": 139,
    "flags": 0,
    "text": "ID \uCD94\uCCA8\uC5D0\uC11C\\n\uB9C8\uC2A4\uD130\uBCFC!"
  },
  {
    "index": 140,
    "flags": 0,
    "text": "\uD4E8\uAC8C~"
  },
