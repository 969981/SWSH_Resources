  {
    "index": 47,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC, \uB4E4\uCB49\uB0A0\uCB49\uD55C \uBAB8\uCCB4\uB97C\\n\uC9C0\uC9C0\uD558\uACE0 \uC788\uB294 \uAD49\uC7A5\uD55C \uADE0\uD615 \uAC10\uAC01\uC744 \uBCF4\uB2C8\uAE4C\\r\\n\uC9DC\uB9BF\uD574\uC9C0\uB294 \uAC83 \uAC19\uC544![VAR 0114(0076)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC804\uAE30\uC758 \uAC70\uC778 \uAC19\uAE34 \uD558\uB2C8\uAE4C\\n\uD0D0\uD5D8 \uD074\uB9AC\uC5B4\uB85C \uD558\uC9C0 \uBB50!![VAR 0114(0076)]"
