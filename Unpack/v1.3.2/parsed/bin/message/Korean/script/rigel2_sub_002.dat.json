  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uC30D\uB465\uC774 \uAC70\uC778"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uC77C\uB2E8 \uAC70\uC778\uC774 \uC7A0\uB4E4\uC5B4 \uC788\uB294\\n\uC720\uC801\uC744 \uCC3E\uC544\uBD10\uC57C\uACA0\uC9C0!\\c\\n\uB0B4\uAC00 \uBA54\uBAA8\uC5D0 \uC801\uC5B4\uB454 \uAC74\uBB3C\uC744\\n\uD55C\uBC88 \uCC3E\uC544\uBD10![VAR 0114(0076)]"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uBC14\uC704\uC758 \uAC70\uC778 \uC720\uC801\uC758 \uBB38\uC774\\n\uC5F4\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uACE0?\\c\\n[VAR FF00(0006)]\uCCAB \uBC88\uC9F8 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uBCC0\uCE58 \uC54A\uB294 \uB3CC\uC744 \uC950\uAC8C \uD558\uB77C[VAR FF00(0000)]\uB77C...\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC \uC911 \uC120\uB450\uC5D0 \uC788\uB294 \uB140\uC11D\uC5D0\uAC8C\\n\uADF8... \uB3CC\uC778\uC9C0 \uBB54\uC9C0\uB97C\\r\\n\uC9C0\uB2C8\uAC8C \uD574\uBCF4\uB294 \uAC74 \uC5B4\uB54C?\\c\\n\uC5B4\uB514 \uADF8\uB7F0 \uAC70 \uC5C6\uC5B4?\\n\uBCC0\uD558\uC9C0 \uC54A\uB294 \uB3CC? \uAC19\uC740 \uAC83 \uB9D0\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uC5BC\uC74C\uC758 \uAC70\uC778 \uC720\uC801\uC758 \uBB38\uC774\\n\uC5F4\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uACE0?\\c\\n[VAR FF00(0006)]\uC0B4\uC544 \uC788\uB294 \uB208\uC758 \uACB0\uC815\uACFC\\n\uD568\uAED8 \uAC78\uC5B4\uB77C[VAR FF00(0000)]\uB77C...\\c\\n\uC0B4\uC544 \uC788\uB2E4\uB294 \uAC74 \uC5ED\uC2DC\\n\uD3EC\uCF13\uBAAC\uC744 \uB9D0\uD558\uB294 \uAC70\uACA0\uC9C0?\\c\\n\uB208\uC758 \uACB0\uC815\uCC98\uB7FC \uC0DD\uAE34\\n\uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8 \uAC78\uC5B4 \uB2E4\uB2C8\uBA74\\c\\n\uC0AC\uC774\uC88B\uC544 \uBCF4\uC5EC\uC11C\\n\uBB38\uB3C4 \uD65C\uC9DD \uC5F4\uB9AC\uB294 \uAC70 \uC544\uB2C8\uC57C?![VAR 0114(0076)]"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uAC15\uCCA0\uC758 \uAC70\uC778 \uC720\uC801\uC758 \uBB38\uC774\\n\uC5F4\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uACE0?\\c\\n[VAR FF00(0006)]\uAC15\uCCA0\uC758 \uAC70\uC778\uC744 \uAE68\uC6B8 \uC815\uB3C4\uC758\\n\uC18C\uB9AC\uB97C \uB0B4\uC5B4\uB77C[VAR FF00(0000)]\uB77C...\\c\\n\uBB50, \uAC70\uC778\uC774\uB77C\uACE0 \uBD88\uB824\uB3C4\\n\uD3EC\uCF13\uBAAC\uC740 \uD3EC\uCF13\uBAAC\uC774\uB2C8\uAE4C!\\c\\n\uB140\uC11D\uB4E4\uC758 \uAD00\uC2EC\uC744 \uB04C \uB9CC\uD55C\\n\uC18C\uB9AC\uB97C \uB0B4\uBA74\\r\\n\uC548\uC5D0\uC11C \uBB38\uC744 \uC5F4\uC5B4\uC8FC\uC9C0 \uC54A\uC744\uAE4C?[VAR 0114(0076)]"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uC30D\uB465\uC774 \uAC70\uC778 \uC720\uC801\uC758 \uBB38\uC774\\n\uC5F4\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uACE0?\\c\\n[VAR FF00(0006)]\uC138 \uAC70\uC778\uC774 \uBAA8\uC600\uC744 \uB54C\\n\uC6B4\uBA85\uC758 \uBB38\uC774 \uC5F4\uB9AC\uB9AC\uB77C[VAR FF00(0000)]\uB77C...\\c\\n\uB300\uC7A5...\\n\uB9D0\uD558\uAE30 \uC880 \uBBF8\uC548\uD558\uC9C0\uB9CC, \uC801\uD78C \uADF8\uB300\uB85C\uC796\uC544!\\c\\n\uBA3C\uC800 \uB2E4\uB978 \uAC70\uC778 \uC14B\uC744 \uC7A1\uACE0\\n\uC774 \uB140\uC11D\uC740 \uB098\uC911\uC5D0 \uCC3E\uC544\uBCF4\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 78,
    "flags": 0,
    "text": "\uC720\uC801\uC758 \uBB38\uC740 \uC5F4\uB838\uB294\uB370\\n\uAC70\uC778\uACFC \uB9CC\uB098\uC9C0 \uBABB\uD588\uB2E4\uACE0?\\c\\n\uC548\uC774 \uC5B4\uB450\uC6B0\uB2C8\uAE4C\\n\uAC70\uC778\uB3C4 \uC790\uACE0 \uC788\uB294 \uAC70 \uC544\uB0D0?\\c\\n\uBC29\uC5D0 \uC788\uB294 \uC2A4\uC704\uCE58\uB97C \uB20C\uB7EC\uC11C\\n\uBD88\uC774\uB77C\uB3C4 \uBC1D\uD600\uBCF4\uB294 \uAC74 \uC5B4\uB54C?[VAR 0114(0076)]"
  },
  {
    "index": 79,
    "flags": 0,
    "text": "\uC0C8\uD3EC\uCF13\uBAAC \uC804\uC124 \uB9D0\uC774\uC9C0!\\c\\n\uC77C\uB2E8 \uC124\uC6D0\uC5D0\uC11C \uCB49~\\n\uB0A8\uCABD\uC73C\uB85C \uAC00\uBA74 \uC788\uB294\\r\\n\uBE68\uAC1B\uACE0 \uCEE4\uB2E4\uB780 \uB098\uBB34\uB97C\\r\\n\uC870\uC0AC\uD558\uB7EC \uAC00\uBCF4\uB294 \uAC74 \uC5B4\uB54C?[VAR 0114(0076)]"
  },
  {
    "index": 80,
    "flags": 0,
    "text": "\uC0C8\uD3EC\uCF13\uBAAC \uC804\uC124 \uB9D0\uC774\uC9C0!\\n\uC5B4\uB5A4 \uB140\uC11D\uC774 \uBB38\uC81C\uC778\uB370?[VAR 0114(0076)]"
  },
  {
    "index": 81,
