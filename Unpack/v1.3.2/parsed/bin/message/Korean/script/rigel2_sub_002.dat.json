  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uD760\uD760...?\\n\uADF8 \uAF5D\uAF5D \uC5BC\uC5B4 \uC788\uB294 \uB140\uC11D\uC774\\r\\n\uC5BC\uC74C\uC758 \uAC70\uC778 \uB808\uC9C0\uC544\uC774\uC2A4\uC57C?[VAR 0114(0076)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "...\uADF8\uBCF4\uB2E4\uB294 \uC5B4\uC9F8\\n\uC5C4\uCCAD \uD654\uB824\uD55C \uBB34\uB4DC\uB4F1\uCC98\uB7FC \uC0DD\uAE30\uC9C0 \uC54A\uC558\uC5B4?\\r\\n\uBE5B\uB098\uAC8C \uD574\uC11C \uB2C8\uC544\uD55C\uD14C \uBCF4\uC5EC\uC8FC\uACE0 \uC2F6\uC744 \uC815\uB3C4\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0, \uC800 \uAD75\uC740 \uD314\uB69D\uC744 \uBCF4\uB2C8\uAE4C\\n\uB098\uB3C4 \uBAA8\uB974\uAC8C \uB35C\uB35C \uB5A8\uB9AC\uB294 \uAC8C...[VAR 0114(0076)]"
