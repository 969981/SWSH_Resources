  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB300\uCDA9 \uD30C\uC774\uC5B4\uB77C\uACE0 \uCE58\uACE0\\n\uD0D0\uD5D8 \uD074\uB9AC\uC5B4\uB85C \uD558\uC9C0 \uBB50!![VAR 0114(0076)]"
