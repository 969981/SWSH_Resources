  {
    "index": 17,
    "flags": 0,
    "text": "\uB0B4\uAC8C \uAC10\uB3D9\uC744 \uC120\uC0AC\uD574\uC92C\uC73C\uB2C8\\n\uBCF4\uC0C1\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uC138\uC694 \uCC54\uD53C\uC5B8!\\n\uB2E8\uB378\uB2D8\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uACC4\uC2ED\uB2C8\uB2E4"
