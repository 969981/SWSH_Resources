[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD638\uBE0C!\\n[VAR 0100(0000)]!![VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uB77C... \uD615?\\n\uAE38\uCE58\uBA74\uC11C \uC5EC\uAE34 \uC5B4\uB5BB\uAC8C \uC628 \uAC70\uC57C?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC0AC\uB78C\uC744 \uAC71\uC815\uD558\uAC8C \uD574\uB193\uACE0\\n\uBB34\uC2A8 \uC18C\uB9AC\uB97C \uD558\uB294 \uAC70\uC57C!\\c\\n\uC544\uBB34\uB9AC \uAE30\uB2E4\uB824\uB3C4 \uC624\uC9C0 \uC54A\uC73C\uB2C8\uAE4C\\n\uB108\uD76C\uB97C \uCC3E\uC73C\uB7EC \uC628 \uAC70\uB77C\uACE0[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC544! \uC6B0\uB974\uB294...!?\\n\uC6B0\uB974\uB97C \uAD6C\uD574\uC57C \uD558\uB294\uB370[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBA54\uC5D0!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB34\uC0AC\uD558\uB2C8\uAE4C \uAC71\uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB3FC\\c\\n\uB0B4\uAC00 \uC5EC\uAE30\uC5D0 \uC654\uC744 \uB54C\uB294\\n\uB2E4\uB4E4 \uAE30\uC808 \uC0C1\uD0DC\uC774\uAE34 \uD588\uC9C0\uB9CC\\c\\n\uC0AC\uC815\uC740 \uC798 \uC54C\uC558\uC5B4... \uB9D0\uB3C4 \uC548 \uD558\uACE0\\n\uC232\uC5D0 \uB4E4\uC5B4\uAC04 \uAC74 \uC798\uBABB\uB410\uC9C0\uB9CC\\c\\n\uB108\uD76C\uC758 \uC6A9\uAE30\uB294 \uC778\uC815\uD560\uAC8C!\\n\uC798\uD588\uC5B4![VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB2E4\uD589\uC774\uC57C [VAR 0100(0000)]\\c\\n\uC9D9\uC740 \uC548\uAC1C\uC5D0 \uB458\uB7EC\uC2F8\uC5EC\uC11C\\n\uC774\uC0C1\uD55C \uD3EC\uCF13\uBAAC\uACFC \uC2F8\uC6E0\uB358 \uAC83\uB3C4\\r\\n\uD5DB\uC218\uACE0\uB294 \uC544\uB2C8\uC5C8\uB358 \uBAA8\uC591\uC774\uC57C[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC774\uC0C1\uD55C \uD3EC\uCF13\uBAAC...?\\n\uBB58 \uBD24\uB2E4\uB294 \uAC70\uC57C?[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBB54\uAC00 \uC5C4\uCCAD\uB098\uAC8C \uAC15\uD574 \uBCF4\uC600\uACE0\\n\uAD49\uC7A5\uD55C \uC874\uC7AC\uAC10\uC774 \uB290\uAEF4\uC84C\uB294\uB370\\r\\n\uAE30\uC220\uC774 \uD1B5\uD558\uC9C8 \uC54A\uC558\uC5B4... \uC544\uB2C8 \uADF8\uBCF4\uB2E4\uB3C4\\r\\n\uAE30\uC220\uC774 \uADF8\uB0E5 \uD1B5\uACFC\uD558\uB294 \uB290\uB08C\uC774\uC5C8\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE30\uC220\uC774 \uADF8\uB0E5 \uD1B5\uACFC\uD588\uB2E4\uACE0...?\\n\uAFB8\uBC85\uC878\uC74C\uC232\uC5D0 \uB098\uD0C0\uB09C\uB2E4\uACE0 \uC804\uD574\uC9C0\uB294\\r\\n\uD3EC\uCF13\uBAAC\uC740 \uD658\uC601\uC774\uC5C8\uB358 \uAC74\uAC00?[VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB108\uD76C\uAC00 \uB2E8\uB828\uD574\uC11C \uB354 \uAC15\uD574\uC9C4\uB2E4\uBA74\\n\uC5B8\uC820\uAC00 \uBE44\uBC00\uC744 \uBC1D\uD600\uB0BC \uC218 \uC788\uC744 \uAC70\uC57C[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC77C\uB2E8 \uC232\uC5D0\uC11C \uB098\uAC00\uB3C4\uB85D \uD560\uAE4C?\\n\uB0B4\uAC00 \uC788\uC73C\uB2C8\uAE4C \uC548\uC2EC\uD574\uB3C4 \uC88B\uC544![VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "...\uD615\uC5D0\uAC8C \uD63C\uB098\uAE34 \uD588\uC9C0\uB9CC[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD55C \uCCB4\uD5D8\uC774\uC5C8\uC5B4!\\n\uB0B4 \uC804\uC124\uC758 \uD55C \uD398\uC774\uC9C0\uAC00 \uB420 \uAC70\uC57C[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  }
]
