[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC774\uB7EC\uC2DC\uBA74 \uACE4\uB780\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB50\uAC00 \uBB38\uC820\uB370! \uC6B0\uB9AC \uADC0\uC5EC\uC6B4 \uB2C8\uC544\uAC00\\n\uC548\uC5D0 \uC788\uB294 \uAC70 \uC544\uB2C8\uC57C!?[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uC2B5\uB2C8\uB2E4\uB9CC..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uB098\uB3C4\\n\uADF8 \uC5B4\uB4DC\uBCA4\uCC98\uC778\uAC00 \uBB54\uAC00 \uD558\uACA0\uB2E4\uB2C8\uAE4C!\\r\\n\uBC14\uB85C \uC9C0\uAE08! \uB2F9\uC7A5 \uB9D0\uC774\uC57C!![VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C!\\n\uD5C8\uAC00\uD574\uB4DC\uB9B4 \uC218 \uC5C6\uB2E4\uAD6C\uC694!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD06C... \uD06C\uC73D...!![VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC74C!? \uC640\uC8FC\uC5C8\uAD6C\uB098, \uAF2C\uB9F9\uC544![VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC74C!? \uC640\uC8FC\uC5C8\uAD6C\uB098, \uAF2C\uB9F9\uC544![VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC548\uB155\uD558\uC138\uC694!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774\uC5D0\uC694?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB0B4 \uB9D0 \uC880 \uB4E4\uC5B4\uBD10\uB77C![VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774 \uC2DC\uB044\uB7EC\uC6B4 \uC5F0\uAD6C\uC6D0\uC774\\n\uACC4\uC18D \uBC29\uD574\uB97C \uD574\uC11C \uB9D0\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB204\uAC00 \uC2DC\uB044\uB7EC\uC6B4 \uC5F0\uAD6C\uC6D0\uC774\uB77C\uB294 \uAC70\uC608\uC694!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uCABD\uC774 \uC124\uBA85\uC744 \uB4E4\uC5B4\uC8FC\uC9C0 \uC54A\uC544\uC11C\\n\uC774\uB7EC\uB294 \uAC70\uC796\uC544\uC694!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC5B4\uB4DC\uBCA4\uCC98\uC5D0\uB294\\n\uB9CE\uC740 \uC704\uD5D8\uC774 \uB3C4\uC0AC\uB9AC\uACE0 \uC788\uB2E4\uAD6C\uC694!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC73C\uC73C! \uB530\uBD84\uD55C \uC124\uBA85 \uB530\uC704\uB294\\n\uB4E3\uACE0 \uC2F6\uC9C0 \uC54A\uB2E8 \uB9D0\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD558\uC544... \uC544\uAE4C\uBD80\uD130 \uACC4\uC18D\\n\uC774\uB7F0 \uC2DD\uC73C\uB85C \uBC18\uBCF5 \uC911\uC774\uC5D0\uC694..."
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD639\uC2DC \uC544\uB294 \uC0AC\uC774\uC2DC\uB77C\uBA74\\n\uB2F9\uC2E0\uC774 \uB300\uC2E0 \uC124\uBA85\uC744 \uB4E4\uC5B4\uC8FC\uC2DC\uACE0"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uAC19\uC774 \uB4E4\uC5B4\uAC04\uB2E4\uB294 \uC870\uAC74 \uC544\uB798\\n\uD5C8\uAC00\uD574\uB4DC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC624! \uADF8\uAC70 \uC798 \uB410\uAD70![VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBD80\uD0C1\uD560\uAC8C! \uB098 \uB300\uC2E0\\n\uC800 \uC0AC\uB78C\uC758 \uC124\uBA85\uC744 \uB4E3\uACE0\\c\\n\uAC19\uC774 \uB2C8\uC544\uB97C \uCC3E\uC73C\uB7EC \uAC00\uC8FC\uB77C!\\n\uC751!?[VAR 0114(0076)]"
  },
