  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4 \uC2DC\uC791\uC774\uAD6C\uB098\\n\uD638\uBE0C! \uADF8\uB9AC\uACE0 [VAR 0100(0000)]![VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uC57C! \uB108\uD76C\uAC00 \uCC54\uD53C\uC5B8\uC5D0\uAC8C\\n\uCD94\uCC9C\uBC1B\uC740 \uD2B8\uB808\uC774\uB108\uB85C\uAD70!\\c\\n\uD658\uC601\uD55C\uB2E4! \uADF8\uB9AC\uACE0 \uBC18\uAC11\uAD6C\uB098!\\n\uB098\uB294 \uB85C\uC988\uB77C\uACE0 \uD55C\uB2E4![VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC7A0\uAE50! \uBC8C\uC368\\n\uB2E4\uC774\uB9E5\uC2A4 \uBC34\uB4DC\uB97C \uC9C0\uB2C8\uACE0 \uC788\uB2E4\uB2C8!\\c\\n\uC774\uAC70 \uBA4B\uC9C0\uAD6C\uB098! \uC5B4\uCA4C\uBA74 \uB108\uD76C\uB294 \uC18C\uC6D0\uC758\uBCC4\uC5D0\\n\uC774\uB04C\uB824 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC78\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uAD6C\uB098\\c\\n\uCC38\uACE0\uB85C \uB2E4\uC774\uB9E5\uC2A4 \uBC34\uB4DC\uB294\\n\uB098\uC758 \uD6CC\uB96D\uD55C \uD68C\uC0AC\uC5D0\uC11C\\r\\n\uAC1C\uBC1C\uD588\uB2E8\uB2E4![VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC62C\uD574\uC758 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB294\\n\uD2B9\uD788 \uB354 \uC7AC\uBBF8\uC788\uC744 \uAC83 \uAC19\uAD6C\uB098!\\c\\n\uC88B\uC544! \uD6CC\uB96D\uD574!\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC774 \uD65C\uAE30\uCC28\uC9C8 \uAC70\uC57C![VAR 0114(0006)]"
