[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC2DC\uD569\uC774 \uC2DC\uC791\uB420 \uB54C\uAE4C\uC9C0 \uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uC744 \uD558\uACE0 \uC62C\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744 \uC774\uAE30\uAE30 \uC704\uD574\\n\uC800\uB3C4 \uAC70\uB300\uD574\uC9C8 \uC0DD\uAC01\uC785\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC800\uB294 \uD3EC\uCF13\uBAAC\uC774 \uD560 \uC218 \uC5C6\uB294 \uC77C...\\n\uC608\uB97C \uB4E4\uBA74... \uBB50\uAC00 \uC788\uC744\uAE4C\uC694?\\r\\n\uBD84\uBA85 \uBB34\uC5B8\uAC00\uB97C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uD638\uD154\uC740\\n\uD3EC\uCF13\uBAAC\uC7A1\uC73C\uB85C \uBD80\uB978\\r\\n\uD3EC\uCF13\uBAAC\uB4E4\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uBC1B\uACE0 \uC788\uB2E8\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB450\uAE4C\uBE44 \uB108\uBB34 \uB9CE\uC774 \uBA39\uC5C8\uB294\uB370\\n\uAD1C\uCC2E\uC740 \uAC70\uC57C...?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAE4C\uBE44\uAE4C~\uBE44"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC0AC\uB78C\uC774 \uC815\uB9D0 \uB9CE\uB124! \uAE38\uC744 \uC783\uAE34 \uD588\uC9C0\uB9CC\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uAC00 \uC788\uC73C\uB2C8\uAE4C \uC548\uC2EC\uC774\uC57C!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAE38\uC744 \uC783\uC5B4\uB3C4 \uD0C0\uC6B4\uB9F5\uC744 \uBCF4\uBA74\uC11C\\n\uBAA9\uC801\uC9C0\uC5D0 \uAC00\uB294 \uAC74 \uC815\uB9D0 \uC7AC\uBBF8\uC788\uC5B4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uCCB4\uCCB4\uBE44~"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB85C\uD1A0\uC640\uC6B0~"
  }
]
