    "text": "\uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC74\uC9C0 \uC54C\uC544!?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\uC740?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCDA9\uACA9\uC74C?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC544\uAE4C \uCF70\uAD11! \uD558\uACE0 \uC18C\uB9AC\uAC00 \uB0AC\uC5C8\uC796\uC544!\\n\uD615\uC740 \uAC70\uAE30\uB85C \uAC04 \uAC83 \uAC19\uC544!\\c\\n\uBD89\uC740 \uBE5B\uC774 \uB098\uB354\uB2C8\\n\uADFC\uCC98\uC5D0 \uC788\uB358 \uC57C\uC0DD \uD3EC\uCF13\uBAAC\uB4E4\uC774\\r\\n\uB2E4\uC774\uB9E5\uC2A4\uD55C \uAC70 \uC788\uC9C0![VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774 \uB274\uC2A4\uB97C \uBD10\uBD10![VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC774\uAC83 \uBD10! \uD615\uC774\uC57C!\\n\uC5ED\uC2DC \uC6B0\uB9AC \uD615\uC774 \uCD5C\uACE0\uB85C \uAC15\uD558\uACE0 \uBA4B\uC9C0\uC9C0?![VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB0A0\uB6F0\uB294 \uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744\\n\uD615\uACFC \uB9AC\uC790\uBABD\uC774\\r\\n\uC21C\uC2DD\uAC04\uC5D0 \uC81C\uC555\uD588\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD615\uC774 \uC5BC\uB9C8\uB098 \uAC15\uD55C\uC9C0\\n\uB2E4\uC2DC\uAE08 \uC2E4\uAC10\uD560 \uC218 \uC788\uC5C8\uC5B4...\\c\\n\uC88B\uC544 [VAR 0100(0000)]!\\n\uD615\uC744 \uB9CC\uB098\uB7EC\\r\\n\uB108\uD074\uC2A4\uD0C0\uB514\uC6C0\uC73C\uB85C \uBE68\uB9AC \uAC00\uC790![VAR 0114(0005)]"
  }
