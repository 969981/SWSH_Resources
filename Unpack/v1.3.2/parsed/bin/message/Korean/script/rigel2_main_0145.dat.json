[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB2F9\uADFC\uC744 \uBF51\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC601\uCC28... \uC601\uCC28!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC\\n\uC544\uC8FC \uC798\uD588\uB2E4[VAR 0114(0079)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8 \uB2F9\uADFC\uC774 \uC788\uC73C\uBA74\\n\uB098\uC758 \uC560\uB9C8\uB97C\\r\\n\uBD88\uB7EC\uB0BC \uC218 \uC788\uC744 \uD130![VAR 0114(0079)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774\uC81C \uB098\uC758 \uD798\uC744 \uC99D\uD3ED\uC2DC\uD0A4\uB294\\n\uC720\uB300\uC758\uACE0\uC090\uB9CC \uC788\uC73C\uBA74\\r\\n\uC190\uC27D\uAC8C \uC560\uB9C8\uB97C \uD0C8 \uC218 \uC788\uC744 \uD14C\uC9C0\uB9CC...[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB354\uB294 \uC778\uAC04\uC73C\uB85C\uBD80\uD130\\n\uADF8\uAC83\uC744 \uBC1B\uC744 \uC77C\uC740 \uC5C6\uACA0\uC9C0[VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBC14\uC2DC\uB85C~\uC2A4!![VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBC14\uCFE0\uB85C~\uC2A4!![VAR 0114(0042)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC800\uAC74, \uB098\uC758 \uC560\uB9C8\\n...\uBE14\uB9AC\uC790\uD3EC\uC2A4!?[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC800\uAC74, \uB098\uC758 \uC560\uB9C8\\n...\uB808\uC774\uC2A4\uD3EC\uC2A4!?[VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC800 \uD558\uC597\uAC8C \uBE5B\uB098\uB294 \uD138!\\n\uAC70\uCE60\uACE0 \uB09C\uD3ED\uD558\uAC8C \uB2EC\uB9AC\uB294 \uC790\uD0DC![VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC800 \uAC80\uAC8C \uBE5B\uB098\uB294 \uD138!\\n\uAC70\uCE60\uACE0 \uB09C\uD3ED\uD558\uAC8C \uB2EC\uB9AC\uB294 \uC790\uD0DC![VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uCC98\uC74C \uB9CC\uB0AC\uC744 \uB54C\uC640 \uC870\uAE08\uB3C4 \uB2EC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uAD70!\\n\uC544\uC544, \uCC38\uC73C\uB85C \uADF8\uB9BD\uB3C4\uB2E4...[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC2DC\uB85C~\uC2A4..."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uCFE0\uB85C~\uC2A4..."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB140\uC11D\uC740 \uC9C0\uAE08\\n\uB2F9\uADFC\uC758 \uB0C4\uC0C8\uB294 \uB9E1\uC558\uC9C0\uB9CC\\r\\n\uC790\uC138\uD55C \uC704\uCE58\uAE4C\uC9C0\uB294 \uC54C\uC544\uB0B4\uC9C0 \uBABB\uD55C \uBAA8\uC591\uC774\uB124[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB2EC\uB824\uAC04 \uBC29\uD5A5\uC73C\uB85C \uBBF8\uB8E8\uC5B4 \uBCF4\uAC74\uB370\\n\uB2F9\uADFC\uC744 \uBE7C\uC557\uC73C\uB7EC \uB9C8\uC744\uB85C \uD5A5\uD588\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uAD70![VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uB294 \uAC83\uC740... \uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC!\\n\uD504\uB9AC\uC988\uB9C8\uC744\uC774 \uC704\uD5D8\uD558\uB124!\\r\\n\uC11C\uB458\uB7EC \uAC00\uC138![VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC6B0... \uC6B0\uB9AC \uBC2D\uC744\\n\uB108 \uAC19\uC740 \uB140\uC11D\uC774 \uC5B4\uC9C0\uB7FD\uD788\uAC8C \uB450\uC9C0 \uC54A\uACA0\uB2E4!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uD06C, \uD070\uC77C\uC774\uC57C!\\n\uD3EC\uCF13\uBAAC\uC774 \uB9C8\uC744\uC5D0\uC11C \uB0A0\uB6F0\uACE0 \uC788\uB2E4\uB124!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC800 \uD3EC\uCF13\uBAAC\uC740...\\n\uC124\uB9C8 \uB3D9\uD654 \uC18D\uC5D0 \uB098\uC654\uB358...!?"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC800\uB807\uAC8C \uD070 \uD3EC\uCF13\uBAAC\uC774 \uB0A0\uB6F0\uAC8C \uB0B4\uBC84\uB824 \uB450\uC5C8\uB2E4\uAC04\\n\uD070\uC77C\uC774 \uB0A0 \uAC70\uC57C!\\c\\n\uC800 \uB140\uC11D\uC744 \uC58C\uC804\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC904 \uC0AC\uB78C\\n\uC5B4\uB514 \uC5C6\uC18C!?"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uBB54\uAC00 \uC18C\uB780\uC2A4\uB7FD\uAD6C\uBA3C\\n\uCD95\uC81C \uC2DC\uC98C\uC774\uB77C\uB3C4 \uB410\uB098?"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC560\uB9C8\uAC00... \uC778\uAC04\uC774...\\n\uD558\uC9C0\uB9CC \uC9C0\uAE08\uC758 \uB098\uB85C\uC11C\uB294...\\c\\n\uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC! \uBD80\uD0C1\uC774\uB124!\\n\uB9C8\uC744\uC744 \uC9C0\uCF1C\uB2E4\uC624![VAR 0114(0079)]"
  },
