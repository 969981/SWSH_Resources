  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAC15\uD574\uC9C0\uAE30 \uC704\uD574\uC11C \uC774\uAC83\uC800\uAC83 \uC2DC\uB3C4\uD574\uBCFC \uAC70\uC57C!\\n\uADF8\uB807\uC9C0 \uC54A\uC73C\uBA74 \uD615\uC744 \uB530\uB77C\uC7A1\uC744... \uC544\uB2C8\uC9C0\\r\\n\uB6F0\uC5B4\uB118\uC744 \uC218 \uC5C6\uC73C\uB2C8\uAE4C![VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uB9D0\uC774\uC57C!\\n\uB098\uC640 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uD574\uC918![VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5EC\uD589\uC744 \uB5A0\uB098\uAE30 \uC804...\\nTV \uC18D\uC758 \uD615\uC740\\r\\n\uADF8\uC800 \uAC15\uD558\uACE0 \uB208\uBD80\uC2DC\uAC8C\uB9CC \uBCF4\uC600\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD558\uC9C0\uB9CC \uC9C0\uAE08\uC740 \uD615\uC774 \uC5BC\uB9C8\uB098 \uAC15\uD55C\uC9C0...\\n\uB0B4\uAC8C \uBD80\uC871\uD55C \uAC83\uC774 \uBB34\uC5C7\uC778\uC9C0 \uC798 \uC54C\uC544![VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uBE44\uB85D \uB108\uBCF4\uB2E4 \uC18D\uB3C4\uB294 \uB290\uB9B4\uC9C4 \uBAB0\uB77C\uB3C4\\n\uB098\uB3C4 \uCC29\uC2E4\uD558\uAC8C \uAC15\uD574\uC9C0\uACE0 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD574!\\c\\n\uC0C1\uB300\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC!\\n\uD3EC\uCF13\uBAAC\uC744 \uAC74\uAC15\uD558\uAC8C \uD574\uC904\uAC8C[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC774\uC81C \uB0B4 \uC18C\uC6D0\uC774 \uBB54\uC9C0 \uC54C \uAC83 \uAC19\uC544...\\n\uB098\uB294 \uD615\uACFC \uC2F8\uC6B0\uACE0 \uC2F6\uC5B4...!\\c\\n...\uC544\uB2C8, \uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC778\\n\uD615\uC744 \uC774\uAE30\uACE0 \uC2F6\uC5B4! \uC774\uAE38 \uAC70\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC88B\uC544 \uACB0\uC815\uD588\uC5B4! \uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744\uC5D0\uC11C\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uC5BB\uC73C\uBA74\\r\\n\uB2E4\uC2DC \uB108\uC5D0\uAC8C \uB3C4\uC804\uD558\uACA0\uC5B4![VAR 0114(0005)]"
  }
]
