[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC7A0\uAE50, [VAR 0101(0001)]\uC758\\n\uAE30\uC6B4\uC774 \uB9C8\uC774\uB108\uC2A4\uC778 \uAC83 \uAC19\uC740\uB370?\\r\\n\uC7A0\uAE50 \uC26C\uC5C8\uB2E4 \uAC00\uB834[VAR 0114(0008)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774 \uACC1\uC5D0 \uC788\uACE0\\n\uC5B4\uB514\uB4E0 \uAC08 \uC218 \uC788\uB294 \uAE30\uC6B4\uC774 \uC788\uB2E4\uBA74\\r\\n\uC790\uC5F0\uC2A4\uB808 \uBBF8\uC18C\uAC00 \uC9C0\uC5B4\uC9C0\uC9C0 \uC54A\uB2C8?[VAR 0114(0008)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5C4\uCCAD\uB09C \uC77C\uC774 \uBC8C\uC5B4\uC84C\uAD6C\uB098...\\c\\n\uBB50 \uB2E8\uB378\uC774 \uC788\uC73C\uB2C8\uAE4C \uAD1C\uCC2E\uC73C\uB824\uB098...\\n\uB108\uB3C4 \uBB54\uAC00 \uD558\uB824\uB294 \uAC70\uC9C0?\\r\\n\uC5C4\uB9C8\uB294 \uC751\uC6D0\uD558\uACE0 \uC788\uB2E8\uB2E4![VAR 0114(0008)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC5D0\uAC8C\uB294\\n\uC5EC\uB7EC\uBAA8\uB85C \uD560 \uC77C\uC774 \uC788\uC9C0?\\c\\n\uADF8\uB807\uC9C0\uB9CC \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74\\n\uB108\uB2F5\uAC8C \uD589\uB3D9\uD558\uB294 \uAC83 \uC544\uB2D0\uAE4C?[VAR 0114(0008)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130\uBCFC\uC740\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC7A1\uC744 \uC218 \uC788\uB294\\r\\n\uAD49\uC7A5\uD55C \uBCFC\uC744 \uB9D0\uD558\uB294 \uAC70\uC9C0!?\\c\\n\uC5B8\uC820\uAC04 \uB108\uB3C4 \uADF8\uB7F0 \uBCFC\uC744 \uC4F0\uACE0 \uC2F6\uC744 \uB9CC\uD07C\\n\uAD49\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB098\uAC8C \uB418\uACA0\uAD6C\uB098![VAR 0114(0008)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB9E4\uADF8\uB180\uB9AC\uC544\uBC15\uC0AC\uB2D8\uC774\\n\uC5C4\uCCAD\uB09C \uC0AC\uC2E4\uC744 \uC54C\uB824\uC8FC\uC168\uC5B4\\c\\n\uB2E4\uC774\uB9E5\uC2A4\uB294 \uC0AC\uC2E4 \uD3EC\uCF13\uBAAC \uADF8 \uC790\uCCB4\uAC00\\n\uAC70\uB300\uD574\uC9C0\uB294 \uAC8C \uC544\uB2C8\uB798!\\c\\n\uADF8\uB7F0\uB370\uB3C4 \uC0C1\uB300\uC640 \uC811\uCD09\uD560 \uC218 \uC788\uB2E4\uB294 \uAC74\\n\uADF8\uB9CC\uD07C \uAD49\uC7A5\uD55C \uD30C\uC6CC\uB97C \uB0B4\uBCF4\uB0B8\uB2E4\uB294 \uB73B\uC774\uACA0\uC9C0?[VAR 0114(0008)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC29B\uC2DC\uD2F0\uC5D0 \uC788\uB294\\n\uBC30\uD2C0\uD0C0\uC6CC\uC5D0\uB294 \uAC00\uBD24\uB2C8?\\c\\n\uB2E8\uB378\uC774 \uB9E4\uC6B0 \uC990\uAC70\uC6CC \uBCF4\uC778\uB2E4\uACE0\\n\uD638\uBE0C\uB124 \uC5C4\uB9C8\uAC00 \uB9D0\uD558\uB354\uB77C[VAR 0114(0008)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBA39\uACE0\uC624?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uC559"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uACE0\uC624~\uC639!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uCFE8\uCFE8..."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uACE0\uC624!?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5C4\uB9C8\uAC00 \uCF54\uBBF8\uB514 \uB4DC\uB77C\uB9C8\uB97C\\n\uC990\uACA8 \uBCF4\uB294 TV\uB2E4"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBD99\uBC15\uC774 \uB09C\uB85C\\n\uC544\uBB34\uB9AC \uCD94\uC6B4 \uACA8\uC6B8\uC774\uB77C\uB3C4 \uC548\uC2EC\uC774\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uBA39\uACE0\uC790\uC758 \uC7A0\uC790\uB9AC\uC5D0\uB294\\n\uAC00\uB054 \uBA39\uB2E4\uB0A8\uC740\uC74C\uC2DD\uC774 \uB5A8\uC5B4\uC838 \uC788\uB2E4"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB0C9\uC7A5\uACE0 \uC548\uC5D0\uB294 \uAC00\uC871\uB4E4\uC774\\n\uC88B\uC544\uD558\uB294 \uC74C\uC2DD\uC774 \uAC00\uB4DD\uD558\uB2E4"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB0A8\uC740 \uC74C\uC2DD\uC740 \uBA39\uACE0\uC790\uAC00 \uBA39\uC5B4\uBC84\uB9AC\uAE30\\n\uB54C\uBB38\uC5D0 \uC2F1\uD06C\uB300\uB294 \uD56D\uC0C1 \uBC18\uC9DD\uBC18\uC9DD\uD558\uB2E4!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5C4\uB9C8\uAC00 \uAF2D \uC0AC\uC57C\uACA0\uB2E4\uACE0 \uD574\uC11C \uC0B0\\n\uCD5C\uC2E0\uD615 \uC624\uBE10\uB808\uC778\uC9C0"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uAC00\uC871\uACFC \uD568\uAED8 \uC0AC\uB7EC \uAC14\uB358 \uCE68\uB300\\n\uD3B8\uC548\uD574\uC11C \uBC14\uB85C \uC7A0\uB4E0\uB2E4"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "TV \uC606\uC5D0\uB294\\n\uCD5C\uC2E0 \uAC8C\uC784\uAE30\uAC00 \uB193\uC5EC \uC788\uB2E4"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC5B4\uB978\uC774 \uB3FC\uC11C\uB3C4 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294\\n\uC2EC\uD50C\uD55C \uB514\uC790\uC778\uC758 \uCC45\uC0C1"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574\uC11C \uC4F0\uC5EC\uC9C4\\n\uCC45\uACFC \uC7A1\uC9C0\uAC00 \uB098\uC5F4\uB418\uC5B4 \uC788\uB2E4"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC774\uBE0C\uC774\uC758 \uBD09\uC81C\uC778\uD615\\n\uAC10\uCD09\uC774 \uC815\uB9D0 \uC88B\uB2E4!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uD53C\uCE74\uCE04\uC758 \uBD09\uC81C\uC778\uD615\\n\uAC10\uCD09\uC774 \uC815\uB9D0 \uC88B\uB2E4!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uAC8C\uC784\uAE30\uC5D0 \uB9DE\uCDB0 \uC0AC\uC8FC\uC2E0\\n\uCD5C\uC2E0\uD615 TV"
  }
]
