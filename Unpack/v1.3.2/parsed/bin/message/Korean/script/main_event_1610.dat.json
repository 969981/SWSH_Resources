[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624\uB798\uB3C4 \uC62C\uB77C\uAC00\uB124...[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uC544\uC9C1 \uC62C\uB77C\uAC00\uB294 \uB3C4\uC911\uC778\uB370\\n\uC5B4\uC9F8\uC11C \uBA48\uCD98 \uAC70\uC9C0!?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uB4E4\uC740 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAD70\uC694\\n\uCC38\uAC00\uD574\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4!\\c\\n\uD558\uC9C0\uB9CC \uC6B0\uB9AC\uB97C \uBC29\uD574\uD558\uB294 \uAC74 \uC6A9\uB0A9 \uBABB \uD569\uB2C8\uB2E4!\\c\\n\uB85C\uC988\uD0C0\uC6CC\uC5D0 \uC785\uC8FC\uD574 \uC788\uB294\\n\uC218\uB9CE\uC740 \uAD00\uB828 \uD68C\uC0AC\uB97C \uC704\uD574\uC11C\uB77C\uB3C4\\r\\n\uCAD3\uC544\uB0B4\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB3C4 \uD560 \uC218 \uC788\uB294\\n\uB85C\uC988\uD0C0\uC6CC\uC758 \uC5D8\uB9AC\uBCA0\uC774\uD130!\\c\\n\uC774 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB97C \uB9CC\uB4E0 \uACF3\uC740\\n\uAD00\uB828 \uD68C\uC0AC\uC778\\r\\n\uB9E4\uD06C\uB85C\uCF54\uC2A4\uBAA8\uC2A4 \uCEE8\uC2A4\uD2B8\uB7ED\uC158\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC81C\uAC00 \uC84C\uC73C\uB2C8\\n\uC21C\uC21C\uD788 \uBB3C\uB7EC\uB098\uB3C4\uB85D \uD558\uC8E0\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC744\\n\uBC29\uD574\uD558\uC9C0\uB294 \uB9D0\uC544\uC8FC\uC138\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB85C\uC988\uD0C0\uC6CC\uC758 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB294\\n\uBC14\uB2E5\uB9CC\uC774 \uC6C0\uC9C1\uC785\uB2C8\uB2E4\\c\\n\uBB3C\uB860 \uADF8\uAC83\uB9CC\uC73C\uB85C\uB294 \uC704\uD5D8\uD558\uAE30 \uB54C\uBB38\uC5D0\\n\uBE5B\uB098\uB294 \uBCBD\uC744 \uBC1C\uC0DD\uC2DC\uD0A4\uC8E0\\c\\n\uADF8\uB7FC \uB9E4\uD06C\uB85C\uCF54\uC2A4\uBAA8\uC2A4 \uCEE8\uC2A4\uD2B8\uB7ED\uC158\uC744\\n\uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD0C0\uC6CC\uC5D0\uC11C \uC77C\uD558\uB294 \uC0AC\uB78C\uB4E4\uC774\\n\uBC16\uC5D0\uC11C \uC5D8\uB9AC\uBCA0\uC774\uD130\uB97C \uC138\uC6B0\uB294 \uAC70\uC600\uAD6C\uB098\\r\\n\uBE68\uB9AC \uAF2D\uB300\uAE30\uC5D0 \uAC00\uACE0 \uC2F6\uC740\uB370![VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5F4\uC2EC\uD788 \uD574\uC900 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uB0B4\uAC00 \uAC74\uAC15\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC904\uAC8C![VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "300m\uC758 \uB85C\uC988\uD0C0\uC6CC!\\n\uC9C0\uAE08\uC740 150m \uC9C0\uC810\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB9E4\uD06C\uB85C\uCF54\uC2A4\uBAA8\uC2A4 \uC0DD\uBA85\uC785\uB2C8\uB2E4!\\n\uAC00\uC785\uD558\uC2E0 \uBCF4\uD5D8\uC740 \uC788\uC73C\uC2E0\uAC00\uC694?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC804 \uB192\uC740 \uACF3\uC774 \uBB34\uC11C\uC6CC\uC694..."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0\uC11C \uC838\uB3C4\\n\uBCF4\uD5D8\uAE08\uC740 \uB098\uC624\uC9C0 \uC54A\uC544\uC694..."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAF2D\uB300\uAE30\uAE4C\uC9C0 \uAC70\uC758 \uB2E4 \uC654\uB2E4!\\n\uD558\uC9C0\uB9CC \uC704\uC6D0\uC7A5\uB2D8\uC744 \uB9CC\uB098\uAC8C \uD560 \uC21C \uC5C6\uC9C0!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC800\uB294 \uB192\uC740 \uACF3\uC5D0 \uC788\uC5B4\uB3C4 \uC544\uBB34\uB807\uC9C0 \uC54A\uB2F5\uB2C8\uB2E4!\\c\\n\uB9E4\uD06C\uB85C\uCF54\uC2A4\uBAA8\uC2A4 \uC5D0\uC5B4\uB77C\uC778\uC988\uC5D0\uC11C\\n\uD558\uB298\uACFC \uAD00\uB828\uB41C \uC77C\uC744 \uD558\uACE0 \uC788\uAC70\uB4E0\uC694!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uB2D8\uC744 \uB9CC\uB0A0 \uC21C \uC5C6\uC744 \uAC70\uB2E4\\n\uB108\uD76C\uB294 \uADF8\uBD84\uC744 \uB3CC\uD30C\uD560 \uC218 \uC5C6\uC744 \uD14C\uB2C8\uAE4C...!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB192\uC740 \uBE4C\uB529\uC740 \uB300\uCCB4\uB85C\\n\uC704\uB85C \uC62C\uB77C\uAC08\uC218\uB85D \uB192\uC740 \uC0AC\uB78C\uC774 \uC788\uB2F5\uB2C8\uB2E4\\c\\n\uD0C0\uC6CC\uC758 \uAF2D\uB300\uAE30\uC5D0 \uACC4\uC2E0\\n\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC740\\r\\n\uADF8\uC57C\uB9D0\uB85C \uD0D1 \uC624\uBE0C \uD0D1\uC774\uC8E0!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC544\uBB34\uB798\uB3C4 \uAC70\uC758 \uB2E4 \uC628 \uAC83 \uAC19\uC544\\n\uC815\uC2E0 \uBC14\uC9DD \uCC28\uB9AC\uACE0 \uAC00\uC790![VAR 0114(0005)]"
  }
]
