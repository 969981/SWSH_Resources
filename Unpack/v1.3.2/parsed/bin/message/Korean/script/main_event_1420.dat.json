[
  {
    "index": 0,
    "flags": 0,
    "text": "\uAE38\uACE0 \uAE38\uC5C8\uB358 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB3C4\\n\uC774\uC81C \uB9C9\uBC14\uC9C0\uC5D0 \uB2E4\uB2E4\uB974\uACE0 \uC788\uAD6C\uB098\\c\\n\uB4DC\uB798\uACE4 \uC870\uB828\uC0AC \uAE08\uB791\uC774 \uC774\uB044\uB294\\n\uB108\uD074\uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD558\uACA0\uB2C8?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC8E0!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uC62C\uAC8C\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB2E4\uC18C \uBB34\uB9AC\uB97C \uD574\uC57C\uB9CC\\n\uB3CC\uD30C\uD560 \uC218 \uC788\uB294 \uAC83\uB3C4 \uC788\uB294 \uBC95\uC774\uC9C0"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uBA74 \uC6B0\uC120 \uD0C8\uC758\uC2E4\uC5D0\uC11C\\n\uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uACE0 \uC624\uB834!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774\uACF3\uC5D0\uC11C \uC720\uB2C8\uD3FC\uC744 \uC785\uACE0 \uC788\uB2E4\uB294 \uAC83\uC740\\n\uB124\uAC00 \uC9C0\uAE08\uAE4C\uC9C0 \uC2B9\uB9AC\uD574\uC654\uB2E4\uB294 \uC99D\uAC70\uC9C0\\r\\n\uADF8 \uAE30\uD569\uC774 \uC5EC\uAE30\uAE4C\uC9C0 \uC804\uD574\uC9C0\uB294 \uAC83 \uAC19\uC544\\c\\n\uADF8\uB7FC \uCCB4\uC721\uAD00 \uD2B8\uB808\uC774\uB108\uB4E4\uC774\\n\uC2A4\uD0C0\uB514\uC6C0...\uC774 \uC544\uB2C8\uB77C\\r\\n\uBCF4\uBB3C\uACE0\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC73C\uB2C8\uAE4C \uAC00\uBCF4\uB834!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC7A0\uAE50 \uAE30\uB2E4\uB824!\\c\\n\uAE08\uB791\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uB824\uBA74\\n\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774 2\uB9C8\uB9AC\uB294 \uC788\uC5B4\uC57C \uD574!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD558\uB7EC \uC654\uAD6C\uB098!\\n\uD30C\uD2B8\uB108\uC640 \uD568\uAED8 \uC774\uAE30\uB3C4\uB85D \uD558\uB834!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC720\uB2C8\uD3FC\uC774 \uC798 \uC5B4\uC6B8\uB9AC\uB294\uAD6C\uB098!\\n\uADF8\uB7FC \uAC00\uB77C! \uB4F1\uBC88\uD638 [VAR 01C4(0001)]!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uC774\uCFE0! \uAE08\uB791\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uB824\uBA74\\n\uBA3C\uC800 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 7\uAC1C \uBAA8\uC544\uC57C \uD574!\\c\\n\uBC30\uC9C0\uB97C \uBAA8\uC544\uC624\uBA74 \uAE08\uB791\uB2D8\uC774 \uC790\uC2E0\uACFC\\n\uC2F8\uC6B8\uB9CC\uD55C \uC0C1\uB300\uB85C \uC778\uC815\uD574\uC8FC\uC2E4 \uAC70\uC57C!"
  }
]
