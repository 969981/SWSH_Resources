[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC548\uB155! \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\\n\uAC1C\uD68C\uC2DD \uBA4B\uC84C\uC5C8\uC5B4![VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uD638\uBE0C\uB294?[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBA3C\uC800 \uAC00\uBC84\uB838\uC5B4\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB530\uB85C \uB2E4\uB2C8\uB294 \uC911\uC774\uC5D0\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD765\uBD84\uB3FC\uC11C \uAC00\uB9CC\uD788 \uC788\uC9C8 \uBABB\uD558\uB098 \uBCF4\uB124?\\n\uC5ED\uC2DC \uD615\uC744 \uB530\uB77C\uC7A1\uACE0 \uC2F6\uACA0\uC9C0[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB50 \uB77C\uC774\uBC8C\uC774\uB2C8\uAE4C\\n\uB2E8\uB828\uD560 \uB54C\uB294 \uB530\uB85C \uB2E4\uB140\uC57C\uACA0\uC9C0?[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0! \uC7AC\uBBF8\uC788\uB294 \uC0AC\uC2E4\uC744\\n\uC0B4\uC9DD \uAC00\uB974\uCCD0 \uC904\uAC8C[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC800\uCABD\uC5D0 \uAC74\uBB3C\uC774 \uBCF4\uC774\uC9C0?\\n\uC800\uAE30\uB294 \uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC758 \uD68C\uC0AC\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "3\uBC88\uB3C4\uB85C \uB05D\uC5D0\uB294\\n\uAD11\uC0B0\uC774 \uC788\uB294\uB370\\c\\n\uAC70\uAE30\uC11C \uCC44\uAD74\uD55C \uAD11\uC11D\uC744\\n\uC5D0\uB108\uC9C0\uB85C \uBCC0\uD658\uD558\uACE0 \uC788\uC5B4[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uB9D0\uD574 \uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uC5D0\uB108\uC9C0\uB3C4\\n\uC704\uC6D0\uC7A5\uB2D8\uC774 \uACF5\uAE09\uD558\uACE0 \uC788\uB2E4\uB294 \uAC70\uC9C0[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC18D\uC744 \uC798 \uC54C \uC218 \uC5C6\uB294 \uC0AC\uB78C\uC774\uAE34 \uD558\uC9C0\uB9CC\\n\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8 \uAD49\uC7A5\uD558\uC9C0 \uC54A\uB2C8?[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uC900 \uBCF4\uB2F5\uC774\uC57C!\\n\uB3D9\uAD74\uD0C8\uCD9C\uB85C\uD504\uB97C \uC904\uAC8C[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uD3EC\uCF13\uBAAC\uC744\\n\uAC74\uAC15\uD558\uAC8C \uD574\uC904\uAC8C![VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD130\uD504\uB9C8\uC744\uAE4C\uC9C0 \uAC00\uB294 \uAE38\uC740\\n\uBA40\uC9C0\uB9CC \uADF8\uAC83\uB3C4 \uD558\uB098\uC758 \uCC4C\uB9B0\uC9C0\uC57C\\r\\n\uADF8\uB7FC \uC5F4\uC2EC\uD788 \uD574 \uBD10! \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800![VAR 0114(000B)]"
  }
]
