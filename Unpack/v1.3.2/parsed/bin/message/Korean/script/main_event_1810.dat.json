  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBC29\uAE08 \uADF8\uAC74...\\n\uB108\uD074\uC2DC\uD2F0\uC758 \uC2A4\uD0C0\uB514\uC6C0\uC774\uC5C8\uC9C0?\\r\\n\uB85C\uC988\uB2D8 \uB300\uCCB4 \uBB34\uC2A8 \uC9D3\uC744 \uD55C \uAC70\uC57C?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBB50\uAC00 \uBB54\uC9C0 \uC804\uD600 \uBAA8\uB974\uACA0\uC5B4!\\c\\n\uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC \uC5B4\uC81C \uD588\uB358 \uC774\uC57C\uAE30...\\n1000\uB144 \uB4A4\uC5D0 \uC788\uC744 \uBB38\uC81C\uB97C\\r\\n\uD574\uACB0\uD558\uAE30 \uC704\uD574 \uC6C0\uC9C1\uC778 \uAC83 \uAC19\uC544!\\c\\n\uC544\uBB34\uD2BC \uB0B4\uAC00...\\n\uCC54\uD53C\uC5B8\uC778 \uB0B4\uAC00 \uAC00\uACA0\uC5B4![VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB9AC\uADF8 \uC704\uC6D0\uC7A5\uB2D8\uC758 \uB9D0\uC500\uC744\\n\uC81C\uB300\uB85C \uC774\uD574\uD558\uC9C0 \uBABB\uD55C\\r\\n\uB0B4 \uCC45\uC784\uC774\uC57C... \uADF8\uB7EC\uB2C8\uAE4C\\r\\n\uB0B4\uAC00 \uCC45\uC784\uC744 \uC9C0\uACA0\uC5B4![VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB0B4\uAC8C \uB9E1\uAE30\uACE0 \uB108\uD76C\uB294 \uC548\uC804\uD55C \uACF3\uC5D0 \uC788\uC5B4\\n\uC9C0\uAE08\uBD80\uD130 \uCC54\uD53C\uC5B8 \uD0C0\uC784\uC774\uB2E4![VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD615! \uAE38\uCE58\uBA74\uC11C\\n\uB108\uD074\uC2DC\uD2F0\uC5D0\uB294 \uC5B4\uB5BB\uAC8C \uAC00\uB824\uACE0...[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB09C \uD615\uC5D0\uAC8C\\n\uD798\uC774 \uB418\uACE0 \uC2F6\uC5B4!\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB108\uB97C \uC774\uAE30\uC9C0 \uBABB\uD55C\\n\uB0B4\uAC00 \uB3C4\uC6C0\uC744 \uC904 \uC218 \uC788\uC744\uAE4C...?[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC904 \uC218 \uC788\uC5B4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD574\uBCF4\uC790!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC904 \uC218 \uC788\uB2E4\uB2C8...[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uBB58 \uD574\uC57C \uD560\uC9C0...[VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC774 \uB9D0\uD588\uB358\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB77C\uB294 \uAC74 \uBA3C \uC61B\uB0A0\uC5D0\\r\\n\uD558\uB298\uC774 \uAC80\uAC8C \uBCC0\uD588\uB358 \uAC78 \uB9D0\uD558\uB294 \uAC70\uC9C0?\\c\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB97C \uC77C\uC73C\uD0A8\uB2E4\uB2C8 \uBB34\uC2A8 \uB73B\uC774\uC9C0?\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uC5B4\uB514\uC5D0\uC11C \uB4E4\uC5C8\uC5C8\uB354\uB77C?[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5D4\uC9C4\uC2DC\uD2F0"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC601\uC6C5\uC0C1"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5D4\uC9C4\uC2DC\uD2F0\uC758 \uC601\uC6C5\uC0C1!\\n\uC18C\uB2C8\uC544 \uB204\uB098\uAC00 \uC774\uB7F0 \uB9D0\uC744 \uD588\uC5C8\uC9C0?\\c\\n\uC0AC\uC2E4 \uC601\uC6C5\uC740 \uB450 \uBA85\uC774\uACE0\\n\uAC80\uACFC \uBC29\uD328\uC758 \uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8\\r\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB97C \uC9C4\uC815\uC2DC\uCF30\uB2E4\uACE0 \uB9D0\uC774\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC88B\uC544! \uADF8\uB7FC \uC7A0\uB4E4\uC5C8\uB2E4\uB294\\n2\uB9C8\uB9AC\uC758 \uD3EC\uCF13\uBAAC\uC744 \uCC3E\uC544\uBCF4\uC790!\\r\\n[VAR 0100(0000)], \uC5B4\uB514\uB85C \uAC00\uBD10\uC57C \uD560\uAE4C?[VAR 0114(0005)]"
  },
