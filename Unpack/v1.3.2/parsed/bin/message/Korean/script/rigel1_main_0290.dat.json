[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624! [VAR 0100(0000)]!\\n\uC5B4\uC11C \uC640![VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB3C4\uC7A5\uC5D0\uC11C \uC5F4\uC2EC\uD788\\n\uC218\uD589\uD558\uACE0 \uC788\uB098 \uBCF4\uB124![VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD638\uBE0C!? \uB124\uAC00 \uC65C \uC5EC\uAE30 \uC788\uC5B4!?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBB50\uC57C, \uD638\uBE0C\uC796\uC544"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD5E4\uD5E4~ \uB9AC\uC561\uC158 \uC88B\uC740\uB370!\\n\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0006)]\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B4\uC774... \uC880 \uB354 \uD06C\uAC8C\\n\uB180\uB784 \uC21C \uC5C6\uB294 \uAC70\uC57C!?[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB098, \uB2E4\uC774\uB9E5\uC2A4\uC5D0 \uB300\uD574 \uC870\uC0AC\uD558\uB7EC\\n\uB2F9\uBD84\uAC04 \uAC11\uC637\uC12C\uC5D0 \uC788\uAE30\uB85C \uD588\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4...\\n\uB458\uC774 \uCE5C\uAD6C\uB77C\uC9C0?[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD638\uBE0C\uB294 \uAC11\uC637\uC12C\uC5D0\uC11C \uCEA0\uD551\uC744 \uD558\uACA0\uB2E4\uACE0\\n\uD5C8\uAC00\uB97C \uBC1B\uC73C\uB7EC \uC5EC\uAE30\uC5D0 \uC628 \uAC74\uB370\\c\\n\uBC16\uC5D0\uC11C \uC9C0\uB0BC \uBC14\uC5D0\uC57C \uB3C4\uC7A5\uC5D0 \uBA38\uBB34\uB294 \uAC8C\\n\uC5B4\uB5BB\uACA0\uB0D0\uACE0 \uC598\uAE30\uD558\uB358 \uC911\uC774\uB780\uB2E4[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC815\uB9D0 \uC88B\uAE34 \uD55C\uB370\uC694\\n\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uD55C\uD14C \uC2E4\uB840\uAC00 \uB418\uC9C4 \uC54A\uC744\uAE4C\uC694?[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC740 \uC5B8\uC81C\uB098\\n\uB204\uAD6C\uB77C\uB3C4 \uD658\uC601\uC774\uB780\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAC8C\uB2E4\uAC00 \uB2E8\uB378\uC758 \uB3D9\uC0DD\uC774\uB77C\uBA74\\n\uB0B4\uAC90 \uAC00\uC871\uC774\uB098 \uB2E4\uB984\uC5C6\uC73C\uB2C8\uAE4C \uB9D0\uC774\uB2E4~[VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098... \uD615\uB3C4 \uC5B4\uB838\uC744 \uB54C\\n\uC774 \uB3C4\uC7A5\uC5D0\uC11C...[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130\uB4DC \uD560\uC544\uBC84\uC9C0!\\n\uC5ED\uC2DC \uC800...\\r\\n\uC5EC\uAE30\uC11C \uC7A0\uAE50 \uC2E0\uC138 \uC880 \uC9C8\uAC8C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC624\uC608~! \uBB3C\uB860 \uC624\uCF00\uC774\uB2E4!\\n\uB3C4\uC7A5\uC774 \uB354 \uD65C\uAE30\uCC28\uC9C0\uACA0\uAD6C\uB098![VAR 0114(0073)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 [VAR 0100(0000)][VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uAC00 \uC9C4\uD654\uD55C \uD3EC\uCF13\uBAAC\\n\uC6B0\uB77C\uC624\uC2A4\uC5D0 \uB300\uD574 \uAC00\uB974\uCCD0 \uC904 \uAC8C \uC788\uB2E4[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC6B0\uB77C\uC624\uC2A4\uB294 \uAC70\uB2E4\uC774\uB9E5\uC2A4\uC758\\n\uAC00\uB2A5\uC131\uC744 \uC9C0\uB2C8\uACE0 \uC788\uC9C0\uB9CC[VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB2E4\uC774\uBC84\uC12F\uC758 \uB0C4\uC0C8\uB97C \uC2EB\uC5B4\uD574\uC11C\\n\uB2E4\uC774\uC218\uD504\uB97C \uBA39\uC9C0 \uBABB\uD55C\uB2E8\uB2E4[VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uADF8\uB7F0\uB370, \uAC11\uC637\uC12C\uC5D0\uC11C \uC5BB\uC744 \uC218 \uC788\uB294\\n[VAR FF00(0006)]\uC5B4\uB5A4 \uC7AC\uB8CC[VAR FF00(0000)]\uB97C \uC218\uD504\uC5D0 \uB123\uC73C\uBA74\\r\\n\uBA39\uC744 \uC218 \uC788\uAC8C \uB41C\uB2E4\uACE0 \uD558\uB354\uAD6C\uB098...[VAR 0114(0073)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uADF8 [VAR FF00(0006)]\uC5B4\uB5A4 \uC7AC\uB8CC[VAR FF00(0000)]\uB294 \uBC14\uB85C...[VAR 0114(0073)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uC7AC\uB8CC\uB294...!?[VAR 0114(0005)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uC7AC\uB8CC\uB294...[VAR 0114(0073)]"
  },
  {
    "index": 23,
