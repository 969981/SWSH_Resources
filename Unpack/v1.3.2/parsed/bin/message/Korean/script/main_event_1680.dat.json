[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCF54\uD2B8\uC5D0 \uAC00\uC2E4 \uAC74\uAC00\uC694?\\n\uC2AC\uC2AC \uAC1C\uD68C\uC2DD\uC774 \uC2DC\uC791\uB420 \uAC81\uB2C8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB124!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC \uAC00\uC2DC\uC8E0!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB2E4\uB978 \uBD84\uB4E4\uACFC\\n\uD558\uC2E4 \uB9D0\uC500\uC774 \uC788\uB294 \uBAA8\uC591\uC774\uAD70\uC694?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB85C\uC11C\\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uB0A8\uAE30 \uC704\uD574\\r\\n\uB098\uB294 \uACC4\uC18D\uD574\uC11C \uB3C4\uC804\uD560 \uAC83\uC774\uB2E4!\\c\\n\uACC4\uC18D\uD574\uC11C \uB3C4\uC804\uD558\uBA74\\n\uC601\uC6D0\uD788 \uBE5B\uB0A0 \uC218 \uC788\uC744 \uD14C\uB2C8\uAE4C[VAR 0114(0010)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "1\uD68C\uC804 \uC0C1\uB300\uAC00 \uAE08\uB791\uB2D8\uC774\uB77C\uB2C8\\n\uC6B4\uC774 \uC5C6\uB124\uC694\\c\\n\uB0A0\uC528\uB97C \uC774\uB807\uAC8C \uC800\uB807\uAC8C \uBC14\uAFB8\uB354\uB77C\uB3C4\\n\uB048\uAE30 \uC788\uAC8C \uD574\uBD10\uC57C\uACA0\uC5B4\uC694[VAR 0114(000E)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC624\uB79C\uB9CC\uC774\uC57C! \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\uC11C\uCC98\uB7FC\\n\uC2DC\uD5D8\uD558\uB294 \uB4EF\uD55C \uC2DC\uD569\uACFC\uB294 \uB2E4\uB974\uAC8C\\r\\n\uC774\uBC88\uC5D0\uB294 \uC9C4\uAC80\uC2B9\uBD80\uB2C8\uAE4C \uAC01\uC624\uD574![VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC2E0\uAE30\uD574\uC694...\\n\uD655\uC2E4\uD788 \uC2EC\uC7A5\uC740 \uB9C8\uAD6C \uB450\uADFC\uAC70\uB9AC\uB294\uB370\\r\\n\uADF8\uC800 \uC2DC\uD569\uC774 \uAE30\uB2E4\uB824\uC9C0\uAE30\uB9CC \uD574\uC694[VAR 0114(0011)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBE60\uB974\uAC8C \uB05D\uB0B4\uACA0\uC2B5\uB2C8\uB2E4\\c\\n\uC6B0\uB9AC\uC758 \uC778\uC0C1\uC744\\n\uAC15\uD558\uAC8C \uB0A8\uACA8\uC57C \uD558\uB2C8\uAE4C\uC694[VAR 0114(0014)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uACC4\uC18D \uC774\uACA8\uC11C \uB2E8\uB378\uC5D0\uAC8C \uB3C4\uC804\uD558\uB294 \uAC83!\\n\uB098\uB294 \uC9C0\uAE08 \uADF8 \uC0DD\uAC01\uBFD0\uC774\uC57C!\\c\\n\uADF8\uB807\uC9C0 \uC54A\uC73C\uBA74 \uB450\uB784\uB8E8\uB3C8\uACFC \uD300 \uBA64\uBC84\uB4E4\uC758\\n\uB178\uB825\uC5D0 \uBCF4\uB2F5\uD560 \uC218 \uC5C6\uC73C\uB2C8\uAE4C![VAR 0114(0017)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB0B4 \uBAA9\uD45C\uB294 \uC6B0\uC2B9\uC774\uC57C\\c\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uACE0 \uC774\uACA8\uC11C\\n\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC5D0 \uC0AC\uB294 \uBAA8\uB450\uC758 \uC790\uAE0D\uC2EC\uACFC\\r\\n\uC6C3\uC74C\uC744 \uB418\uCC3E\uC544\uC8FC\uACE0 \uC2F6\uC73C\uB2C8\uAE4C[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uACE7 \uAC1C\uD68C\uC2DD\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4\\n\uCF54\uD2B8\uB85C \uC774\uB3D9\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4"
  }
]
