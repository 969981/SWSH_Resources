[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2D8!\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0 \uB3C4\uC804\uD558\uAE30 \uC704\uD55C\\r\\n\uC808\uCC28\uB97C \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB3C4\uC804\uD560\uAC8C\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4! \uC900\uBE44\uAC00 \uB418\uBA74\\n\uB2E4\uC2DC \uB3C4\uC804\uD558\uB7EC \uC640\uC8FC\uC138\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB124! \uADF8\uB7FC \uC6B0\uC120\\n\uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uC5B4 \uC8FC\uC138\uC694!\\r\\n\uD0C8\uC758\uC2E4\uC740 \uC800\uCABD\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC720\uB2C8\uD3FC\uC774 \uBA4B\uC9C0\uC2DC\uB124\uC694!\\n\uADF8\uB7FC \uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0 \uB3C4\uC804\uD574\uC8FC\uC138\uC694!\\c\\n\uC544! \uCC38\uACE0\uB85C \uBBF8\uC158 \uB3C4\uC911\uC5D0\uB294\\n\uD3EC\uCF13\uBAAC \uBC15\uC2A4\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB2F5\uB2C8\uB2E4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC544~ \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC778 \uC57C\uCCAD\uB2D8\uC740\\n\uC9C0\uAE08 \uB4F1\uB300\uC5D0 \uACC4\uC138\uC694\\c\\n\uC7A0\uAE50 \uAC00\uC11C \uBD88\uB7EC\uC8FC\uC2DC\uACA0\uC5B4\uC694?\\n\uB4F1\uB300\uB294 \uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C \uB098\uAC00\uC11C\\r\\n\uBC14\uB2F7\uAC00 \uCABD\uC73C\uB85C \uAC00\uBA74 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD558\uB7EC \uC624\uC168\uAD70\uC694!\\c\\n\uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uB9D0\uC740\\n\uB099\uC22B\uBB3C\uC774 \uB313\uB3CC\uC744 \uB6AB\uB294\uB2E4\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4\uD558\uC2E0\\n[VAR 0100(0000)] \uC120\uC218\uC758 \uB2E4\uC74C \uB3C4\uC804\uC740\\r\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC57C\uCCAD\uACFC\uC758 \uC2DC\uD569\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4! \uB2E4\uC74C \uB3C4\uC804\uC744\\n\uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4!"
  }
]
