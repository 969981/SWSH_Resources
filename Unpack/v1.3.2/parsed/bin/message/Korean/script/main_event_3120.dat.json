[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uB4E4\uC740...[VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBE44\uD2B8!?\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC740!?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC124\uB9C8 \uC81C\uAC00 \uACE0\uC804\uD560 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD558\uC168\uB098\uC694?\\c\\n\uC5D8\uB9AC\uD2B8\uC774\uC790 \uD398\uC5B4\uB9AC\uD0C0\uC785\uC758\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC778 \uC81C\uAC00\uC694?[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC544 \uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC5C8\uC9C0!\\n...\uC5D8\uB9AC\uD2B8\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD639\uC2DC... \uD639\uC2DC \uBAB0\uB77C\uC11C \uB9D0\uC778\uB370\\n\uC774\uC81C \uC640\uC11C \uB3C4\uC640\uC8FC\uB7EC \uC628 \uAC74 \uC544\uB2C8\uACA0\uC8E0?\\c\\n\uC560\uCD08\uC5D0 \uC5D8\uB9AC\uD2B8\uC778 \uC81C\uAC8C\\n\uB3C4\uC6C0 \uB530\uC708 \uD544\uC694 \uC5C6\uC9C0\uB9CC \uB9D0\uC774\uC8E0[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8 \uC131\uACA9\uC740 \uC5EC\uC804\uD558\uAD6C\uB098...\\n\uC6B0\uB9B0 \uB124\uAC00 \uAC71\uC815\uB3FC\uC11C \uC654\uB2E4\uACE0![VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAE4C\uB2E4\uB85C\uC6B4 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uAD70\\c\\n\uC774\uAC70 \uB2E4\uC74C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB3C4\\n\uD070\uC77C\uC774\uACA0\uC5B4...[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC804 \uC5EC\uD0DC\uAE4C\uC9C0 \uC62C\uB9AC\uBE0C\uB2D8\uC5D0\uAC8C \uC18D\uC544\uC11C\\n\uBA4B\uB300\uB85C \uC774\uC6A9\uB2F9\uD574\uC654\uC2B5\uB2C8\uB2E4...\\c\\n\uC55E\uC73C\uB85C \uC81C \uC778\uC0DD\uC740\\n\uC81C\uAC00 \uACB0\uC815\uD560 \uAC81\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uC6B0\uC120 [VAR 0100(0000)]\uB2D8\uC740\\n\uC800\uC640 \uC2B9\uBD80\uD574\uC57C \uD569\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC800\uAE30...\\n\uC9C0\uAE08\uC740 \uADF8\uB7F4 \uB54C\uAC00 \uC544\uB2C8\uB77C\uACE0![VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD034\uC988\uB97C \uBAA8\uB450 \uB9DE\uD78C \uC544\uAC00\uC57C\\n\uB108\uBB34 \uC11C\uB450\uB97C \uAC83 \uC5C6\uB2E8\uB2E4[VAR 0114(0013)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBE44\uD2B8\uB294 3\uB9C8\uB9AC\uB098 \uB418\uB294\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744 \uD63C\uC790\uC11C \uC9C4\uC815\uC2DC\uCF30\uB2E4...\\c\\n\uADF8\uAC74 \uB108\uD76C\uC5D0\uAC8C \uC2DC\uAC04\uC744\\n\uC120\uBB3C\uD574\uC900 \uAC83\uC774\uB098 \uB9C8\uCC2C\uAC00\uC9C0\uC9C0[VAR 0114(0013)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC560\uCD08\uC5D0 \uBE44\uD2B8\uC758 \uC778\uC0DD\uC5D0\\n\uB0A8\uC774 \uC774\uB798\uB77C\uC800\uB798\uB77C \uD560 \uC218\uB294 \uC5C6\uB294 \uAC70\uB2E4\\c\\n\uBB3C\uB860 \uB098\uB294 \uC5C4\uCCAD\uB098\uAC8C\\n\uB9CE\uC740 \uC601\uD5A5\uC744 \uB07C\uCCE4\uC9C0\uB9CC![VAR 0114(0013)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "...\uB4E3\uACE0 \uBCF4\uB2C8 \uADF8\uB807\uB124\uC694[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774\uB7F0 \uC774\uB7F0\\n\uC774\uAC8C \uBC14\uB85C 88\uC138\uC758 \uC5F0\uB95C\uC774\uB77C\uB294 \uAC74\uAC00\uC694?[VAR 0114(0016)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD3EC\uD50C\uB7EC\uB2D8\uC740 \uC0C1\uAD00\uC5C6\uC2B5\uB2C8\uB2E4\\n\uC774\uAC74 \uC800\uB97C \uC704\uD55C \uC2B9\uBD80\uB2C8\uAE4C\uC694!!\\c\\n\uC790! \uC120\uD0DD\uC9C0\uB294 \uC624\uB85C\uC9C0\\n\uC608\uC2A4 \uD558\uB098\uBFD0\uC785\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC2F8\uC6B0\uC790"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC54C\uC558\uC5B4!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uD0DC\uC5B4\uB09C \uC800\uC640\\n\uD3EC\uCF13\uBAAC\uB4E4\uC758 \uAD49\uC7A5\uD568\uC744...\\r\\n\uC0B4\uC9DD \uBCF4\uC5EC\uB4DC\uB9AC\uB3C4\uB85D \uD558\uC8E0[VAR 0114(000C)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4\\c\\n\uC774\uC81C\uC57C \uB2F9\uC2E0\uC744\\n\uCC54\uD53C\uC5B8\uC73C\uB85C \uC778\uC815\uD560 \uC218 \uC788\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBD84\uD558\uC9C0\uB9CC \uC800\uC5D0\uAC8C\\n\uBB50\uAC00 \uBD80\uC871\uD55C\uC9C0 \uAE68\uB2EC\uC558\uC2B5\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC800\uB294 \uD398\uC5B4\uB9AC\uD0C0\uC785\uC744 \uAC08\uACE0\uB2E6\uC544\\n\uC880 \uB354 \uAC15\uD574\uC9C8 \uAC81\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C\uC11C\\n\uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC744 \uC815\uB9AC\uD558\uB7EC \uAC00\uBCF4\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uC758 \uD3EC\uCF13\uBAAC \uC2B9\uBD80...\\n\uD551\uD06C\uAC00 \uAC00\uB4DD\uD558\uB354\uAD6C\uB098[VAR 0114(0013)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC758\\n\uAD8C\uB9AC\uB97C \uBC15\uD0C8\uB2F9\uD558\uACE0\uB3C4\\c\\n\uD1A0\uB108\uBA3C\uD2B8\uC5D0 \uB09C\uC785\uD558\uC9C8 \uC54A\uB098...\\n\uC800 \uB140\uC11D... \uC815\uB9D0 \uAC15\uC778\uD558\uAD6C\uB098[VAR 0114(0005)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C \uC778\uC815\uBC1B\uC740 \uAC83\uB3C4\\n\uC5B4\uCC0C\uC5B4\uCC0C \uC774\uD574\uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544![VAR 0114(0005)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uBE44\uD2B8 \uB140\uC11D... \uC194\uC9C1\uD788 \uC7AC\uC218 \uC5C6\uC9C0\uB9CC\\n\uD2B8\uB808\uC774\uB108\uB85C\uC11C\uB294 \uAD49\uC7A5\uD55C \uAC83 \uAC19\uC544[VAR 0114(0005)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC131\uC2E4\uD558\uB2C8\uAE4C"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uAC15\uD558\uB2C8\uAE4C"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uADF8\uB798 \uC870\uAE08 \uC804\uC758 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uBCF4\uACE0\\n\uB178\uB825\uD558\uACE0 \uC788\uB2E4\uB294 \uAC78 \uC54C \uC218 \uC788\uC5C8\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC778 \uB124\uAC00\\n\uAC15\uD558\uB2E4\uACE0 \uC778\uC815\uD560 \uC815\uB3C4\uB77C\uB2C8...[VAR 0114(0005)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB108\uD76C\uB4E4... \uACC4\uC18D \uB5A0\uB4E4 \uAC70\uBA74\\n\uD64D\uCC28\uB77C\uB3C4 \uB9CC\uB4E4\uC5B4\uC904\uAE4C?[VAR 0114(0016)]"
  },
  {
