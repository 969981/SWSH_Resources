[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5EC\uC5B4! \uC80A\uC740\uC774\uB4E4\\n\uC5D4\uD2B8\uB9AC\uB294 \uBB34\uC0AC\uD788 \uB9C8\uCE5C \uBAA8\uC591\uC774\uB124?[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC18C\uB2C8\uC544 \uB204\uB098!\\n\uD638\uD154\uC5D0\uB294 \uBB34\uC2A8 \uC77C\uB85C \uC788\uB294 \uAC70\uC57C?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAFB8\uBC85\uC878\uC74C\uC232\uC5D0 \uC788\uB2E4\uACE0 \uC804\uD574\uC9C0\uB294\\n\uC774\uC0C1\uD55C \uD3EC\uCF13\uBAAC\uC744 \uC870\uC0AC\uD558\uB7EC \uC654\uC5B4\\c\\n\uAC00\uB77C\uB974\uC758 \uC804\uC124\uC744 \uC870\uC0AC\uD558\uBA74\\n\uBB54\uAC00 \uC54C\uC544\uB0BC \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C \uD574\uC11C \uB9D0\uC774\uC57C\\c\\n\uBAA8\uCC98\uB7FC\uC778\uB370 \uAC19\uC774 \uBCFC\uB798?[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC774\uAC8C \uBB54\uB370?[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29\uC744 \uAD6C\uC6D0\uD588\uB2E4\uACE0\\n\uC804\uD574 \uB0B4\uB824\uC624\uB294 \uC601\uC6C5\uC758 \uB3D9\uC0C1\uC774\uC57C\\r\\n\uAD81\uAE08\uD558\uB2E4\uBA74 \uC124\uBA85\uD574\uC904\uAC8C[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAC04\uB2E8\uD558\uAC8C \uC54C\uB824\uC8FC\uC138\uC694!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC790\uC138\uD558\uAC8C \uC54C\uB824\uC8FC\uC138\uC694!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC61B\uB0A0 \uC61B\uC801\uC5D0... \uAC00\uB77C\uB974\uC9C0\uBC29\uC758\\n\uD558\uB298\uC5D0 \uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774...\\r\\n\uC77C\uBA85 \uBE14\uB799 \uB098\uC774\uD2B8\uAC00 \uB098\uD0C0\uB098\\c\\n\uC5EC\uAE30\uC800\uAE30\uC5D0\uC11C \uAC70\uB300\uD55C\\n\uD3EC\uCF13\uBAAC\uB4E4\uC774 \uB098\uD0C0\uB098 \uB0A0\uB6F0\uC5C8\uC73C\uB098\\c\\n\uAC80\uACFC \uBC29\uD328\uB97C \uAC00\uC9C4\\n\uD55C \uC80A\uC740\uC774\uC5D0 \uC758\uD574 \uC9C4\uC815\uB418\uC5C8\uB2E4...\\c\\n\uC774 \uC804\uC124\uC5D0 \uB098\uC628 \uC80A\uC740\uC774\\n\uB2E4\uC2DC \uB9D0\uD574 \uC601\uC6C5\uC744 \uBAA8\uD2F0\uBE0C\uB85C \uD55C \uB3D9\uC0C1\uC774\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB2E4\uB9CC \uC601\uC6C5\uC774\\n\uC5B4\uB5A4 \uAC80\uACFC \uBC29\uD328\uB97C\\r\\n\uAC00\uC9C0\uACE0 \uC788\uC5C8\uB294\uC9C0\uB294 \uC54C\uB824\uC9C4 \uAC8C \uC5C6\uACE0\\c\\n\uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uC758\\n\uC815\uCCB4\uC5D0 \uB300\uD55C \uAC83\uB3C4 \uC218\uC218\uAED8\uB07C\uC57C...\\c\\n\uAC00\uB77C\uB974\uC758 \uD558\uB298\uC744 \uB4A4\uB36E\uC5C8\uB2E4\uB294 \uB73B\uC5D0\uC11C\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB77C\uACE0 \uBD88\uB800\uB2E4\uB294 \uAC83 \uAC19\uC740\uB370...[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD750~\uC74C... \uC601\uC6C5\uC774\uB77C\uBA74\\n\uC6B0\uB9AC \uD615\uCC98\uB7FC \uAC15\uD588\uACA0\uB124!\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0 \uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uB2C8\\n\uAC80\uC774\uB2C8 \uBC29\uD328\uB2C8 \uC870\uC0AC\uD574\uC57C \uD560 \uAC8C\\r\\n\uB9CE\uC544\uC11C \uD070\uC77C\uC774\uACA0\uB124 \uB204\uB098[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAD1C\uCC2E\uC744 \uAC70\uC608\uC694!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAD1C\uCC2E\uC544\uC694?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!\\n\uBB50 \uC5B4\uB5BB\uAC8C\uB4E0 \uB418\uACA0\uC9C0![VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC751...\\n\uBB50 \uC5B4\uB5BB\uAC8C\uB4E0 \uD574 \uBD10\uC57C\uC9C0[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB108\uD76C\uB4E4 \uD638\uD154\uC5D0 \uBB35\uC744 \uAC70\uB77C\uBA74\\n\uCCB4\uD06C\uC778 \uD574\uB450\uB294 \uAC8C \uC5B4\uB54C?\\c\\n\uC811\uC218\uCC98\uAC00 \uC870\uAE08\\n\uC2DC\uB044\uB7EC\uC6B4 \uAC83 \uAC19\uC9C0\uB9CC[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC624\uCF00\uC774! \uBB54\uAC00 \uC54C\uC544\uB0B4\uBA74\\n\uB204\uB098\uD55C\uD14C\uB3C4 \uAC00\uB974\uCCD0 \uC904\uAC8C![VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCCB4\uD06C\uC778\uD560 \uAC70\uBA74\\n\uCE74\uC6B4\uD130\uC5D0 \uB9D0\uC744 \uAC78\uC5B4\uBD10![VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD638\uBE0C\uB97C \uBD80\uD0C1\uD560\uAC8C\\c\\n\uB2E8\uB378\uB3C4 \uC544\uBE60 \uC5ED\uD560\uC744 \uB300\uC2E0 \uD588\uC5B4\uC11C \uADF8\uB7F0\uC9C0\\n\uC800 \uC544\uC774\uAC00 \uB9CE\uC774 \uAC71\uC815\uB418\uB098 \uBCF4\uB354\uB77C\uAD6C[VAR 0114(000B)]"
  }
]
