[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758 \uC2DC\uD569\uC744 \uBCF4\uACE0 \uC788\uC73C\uBA74\\n\uB098\uB3C4 \uD3EC\uCF13\uBAAC\uC774 \uAC16\uACE0 \uC2F6\uC5B4\uC838"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC2DC\uD569\uC744 \uBCF4\uBA74\uC11C \uC990\uAE30\uB294 \uC2DD\uC0AC...\\n\uAC00\uB77C\uB974 \uB9C8\uB2F4\uB4E4\uC758 \uC6B0\uC544\uD55C \uC77C\uACFC\uB78D\uB2C8\uB2E4!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC090?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC74C \uADF8\uB7EC\uB2C8\uAE4C~\\nXL\uC0AC\uC774\uC988\uB85C \uD560\uB798!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB0B4 \uB3D9\uC0DD\uC740 \uB300\uC2DD\uAC00\uB77C\uC11C \uB9D0\uC774\uC57C\\c\\n\uC5B8\uC820\uAC00 \uC7A0\uB9CC\uBCF4\uC640 \uB300\uACB0\uD558\uACA0\uB2E4\uB294\\n\uB9D0\uB3C4 \uC548 \uB418\uB294 \uAFC8\uC744 \uAFB8\uACE0 \uC788\uC5B4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB9C8\uC790\uC6A9\uC744 \uC0B4\uC9DD \uCC0C\uB974\uBA74\\n\uB760\uC6A9! \uD558\uACE0 \uD280\uB294 \uAC8C \uAE30\uBD84\uC774 \uC88B\uB2E8\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB760\uC694\uC6A9~"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uD2B9\uC131\uC740\\n200\uAC00\uC9C0\uAC00 \uB118\uB294\uB2E4\uACE0 \uD569\uB2C8\uB2E4\\c\\n\uC81C\uB300\uB85C \uACF5\uBD80\uD574\uB450\uBA74\\n\uC2B9\uBD80\uC5D0\uC11C\uB3C4 \uB2F9\uD669\uD558\uC9C0 \uC54A\uC744 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC74C\uD1A0\uB9AC"
  }
]
