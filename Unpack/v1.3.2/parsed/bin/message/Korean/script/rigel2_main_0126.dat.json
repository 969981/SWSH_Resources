[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD504\uB9AC\uC988\uB9C8\uC744\uC5D0 \uC628 \uAC78 \uD658\uC601\uD55C\uB2E4\\n\uBA3C \uAE38 \uC624\uB290\uB77C \uC218\uACE0\uAC00 \uB9CE\uAD6C\uB098"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uB9CC\uB09C \uAC83\uB3C4 \uC778\uC5F0\uC778\uB370\\n\uD639\uC2DC \uC655\uAD00\uC124\uC6D0\uC758 \uBA85\uBB3C\uC778\\r\\n\uB2F9\uADFC\uC528\uB294 \uD544\uC694 \uC5C6\uB2C8?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC8FC\uC138\uC694!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD544\uC694 \uC5C6\uC5B4\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD638\uD638! \uC529\uC529\uD558\uB2C8 \uBCF4\uAE30 \uC88B\uAD6C\uB098!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5D0\uC774, \uADF8\uB807\uAC8C \uC12D\uC12D\uD55C \uB9D0 \uD558\uC9C0 \uB9D0\uACE0!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB7F0\uB370, \uBE44\uB85D \uC528\uC557\uC774\uAE34 \uD558\uC9C0\uB9CC\\n\uC774\uAC8C \uB098\uB984 \uADC0\uD55C \uBB3C\uAC74\uC774\uB77C\uC11C \uB9D0\uC774\uB2E4..."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uAD11\uC11D [VAR 0200(0001)]\uAC1C\uC640\\n\uAD50\uD658\uD558\uACA0\uB2E4\uBA74 \uB118\uACA8\uC8FC\uB9C8!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD638\uD638! \uC0B6\uC740 \uAE30\uBE0C \uC564 \uD14C\uC774\uD06C\uC758 \uC5F0\uC18D\uC778 \uAC8C\uC9C0!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uAD11\uC11D [VAR 0200(0001)]\uAC1C\uC640\\n\uB2F9\uADFC\uC528\uB97C \uAD50\uD658\uD574\uC904\uAE4C?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC528\uB294 \uC5B4\uB514 \uAC00\uC9C0 \uC54A\uC73C\uB2C8\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB610 \uC624\uAC70\uB77C"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB300\uB2F5\uC740 \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4\uB9CC\\n\uB9E5\uC2A4\uAD11\uC11D\uC774 \uBD80\uC871\uD558\uAD6C\uB098"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)] \uD560\uC544\uBC84\uC9C0\uC5D0\uAC8C\\n\uB9E5\uC2A4\uAD11\uC11D\uC744 [VAR 0200(0001)]\uAC1C \uAC74\uB138\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC624\uC624! \uC774 \uC815\uB3C4 \uC591\uC774\uBA74\\n\uBC2D\uC5D0 \uC774\uAC83\uC800\uAC83 \uC794\uB729 \uC2EC\uC5B4\uC11C\\r\\n\uCC44\uC18C\uB97C \uD06C\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uACA0\uAD70!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC790, \uADF8\uB7FC\\n\uC57D\uC18D\uB300\uB85C \uC528\uB97C \uC8FC\uB9C8!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB9C8\uC744 \uBC2D\uC5D0 \uBA4B\uB300\uB85C \uC2EC\uC73C\uBA74 \uC548 \uB41C\uB2E4!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC624? \uB2F9\uADFC\uC744 \uCC3E\uACE0 \uC788\uB294 \uAC90\uAC00?\\c\\n\uC774 \uACC4\uC808\uC5D0\uB294\\n\uC5B4\uB514\uB97C \uAC00\uB3C4 \uB2F9\uADFC\uC740 \uC5C6\uC744 \uAC8C\uB2E4\\r\\n\uC528\uB77C\uBA74 \uC5EC\uAE30 \uC788\uB2E4\uB9CC..."
  }
]
