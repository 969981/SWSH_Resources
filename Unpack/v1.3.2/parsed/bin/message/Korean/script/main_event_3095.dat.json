[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uC774 \uBAA8\uC544\uB454 \uC18C\uC6D0\uC758\uBCC4\uC774\\n\uC9C0\uAE08 \uC774\uACF3\uC5D0 \uC788\uAD70\uC694\\r\\n\uC140\uB7EC\uBE0C\uB9AC\uD2F0\uC758 \uB208\uC5D0\uB294 \uBAA8\uB450 \uBCF4\uC785\uB2C8\uB2E4![VAR 0114(0068)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC140\uB7EC\uBE0C\uB9AC\uD2F0\uAC00 \uC544\uB2CC \uB2F9\uC2E0\uB4E4\uC5D0\uAC8C\uB294\\n\uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uB294 \uBB3C\uAC74\uC785\uB2C8\uB2E4\\r\\n\uC6B0\uB9AC\uC5D0\uAC8C \uB118\uAE30\uC2DC\uC8E0[VAR 0114(0069)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC18C\uC6D0\uC758\uBCC4\uACFC \uC140\uB7EC\uBE0C\uB9AC\uD2F0\uB294\\n\uC544\uBB34 \uAD00\uACC4 \uC5C6\uC796\uC544\uC694![VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5B4\uB5BB\uAC8C \uC54C\uC544\uB0C8\uB294\uC9C0\uB294\\n\uBAA8\uB974\uACA0\uC9C0\uB9CC!\\c\\n\uB2F9\uC2E0\uB4E4\uC5D0\uAC8C\\n\uB118\uACA8\uC904 \uC218\uB294 \uC5C6\uC5B4\uC694![VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB140 \uB9D0\uC774 \uB9DE\uC2B5\uB2C8\uB2E4\\c\\n\uC18C\uC6D0\uC758\uBCC4\uC758 \uAC00\uCE58\uB97C \uBAA8\uB974\uB294\\n\uB2F9\uC2E0\uB4E4\uC5D0\uAC8C\uB294 \uB118\uACA8\uC904 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774\uB7F0...\\n\uC5B4\uB5BB\uAC8C \uD560\uAE4C, \uC544\uC6B0\uC57C?[VAR 0114(0068)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD750\uC74C...\\n\uACE8\uCE58 \uC544\uD504\uB124\uC694, \uD615\uB2D8[VAR 0114(0069)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD558~\uD558\uD558\uD558!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uACE8\uCE58\uAC00 \uC544\uD508 \uAC74\\n\uC18C\uB2C8\uC544 \uB204\uB098\uC640 \uBC15\uC0AC\uB2D8\uC774\uC57C![VAR 0114(0005)]"
