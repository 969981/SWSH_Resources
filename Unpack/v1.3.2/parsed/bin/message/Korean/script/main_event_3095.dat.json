  {
    "index": 9,
    "flags": 0,
    "text": "\uD638\uBE0C![VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 \uAC15\uC81C\uB85C\\n\uB2E4\uC774\uB9E5\uC2A4\uC2DC\uD0A4\uB2E4\uB2C8 \uC6A9\uC11C \uBABB \uD574![VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0!\\n[VAR 0109(0001)]\uB3C4 \uB3CC\uB824\uC918![VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774~\uB7F0!\\c\\n\uCC54\uD53C\uC5B8\uC774 \uC62C \uC904\\n\uC54C\uC558\uB294\uB370...\\c\\n\uC124\uB9C8 \uD328\uBC30\uC790\uAC00\\n\uC624\uC2E4 \uC904\uC774\uC57C![VAR 0114(0068)]"
