[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC154\uD130\uB97C \uB0B4\uB824\uB193\uC73C\uBA74\\n\uC544\uBB34\uB3C4 \uB3C4\uC804\uD560 \uC218 \uC5C6\uB294\uB370...\\r\\n\uC5B4\uB5BB\uAC8C \uB41C \uAC74\uC9C0 \uC54C\uC544\uBD10\uC57C\uACA0\uC5B4[VAR 0114(000D)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC774\uAC70 \uB0A8\uC740 \uAC70\uC9C0\uB9CC \uB108\uC5D0\uAC8C \uC904\uAC8C\\n\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790![VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5B4\uC774! \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC5D0 \uC798 \uC654\uC5B4!\\n\uADF8\uB7FC \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uC2DC\uC791\uC774\uB2E4![VAR 0114(0045)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uB3C4\uC804\uD558\uB824\uBA74\\n\uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uACE0 \uC640![VAR 0114(0045)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB611\uBC14\uB85C \uAC00\uBA74 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744\\n\uB9CC\uB0A0 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0045)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB300\uB85C \uB3CC\uC544\uAC00\uBA74 \uAE30\uAD8C\uC774\uC57C\\n\uAE30\uAD8C\uD560 \uC0DD\uAC01\uC778 \uAC70\uC57C?[VAR 0114(0045)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAC70\uAE38 \uB118\uC5B4\uAC00\uBA74 \uAE30\uAD8C\uC774\uB2C8\uAE4C \uC870\uC2EC\uD574![VAR 0114(0045)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAC74\uAC15\uD55C \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uB77C\uACE0?\\n\uADF8\uB7FC \uB3CC\uC544\uAC00\uC57C\uACA0\uB294\uAC78?[VAR 0114(0045)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8\uC744 \uC774\uAE34 \uAC70\uC57C!?\\n\uC790 \uAE30\uB150\uC73C\uB85C \uAE30\uC220\uBA38\uC2E0\uC744 \uC904\uAC8C![VAR 0114(0045)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uC774! 9\uBC88\uB3C4\uB85C\uC5D0 \uD070\uC77C\uC774 \uB0AC\uC5B4!\\n\uCC54\uD53C\uC5B8\uC774 \uC654\uC744 \uC815\uB3C4\uB85C \uD070\uC77C\uC774\uC57C!\\c\\n\uC624! \uB108\uB294 \uB450\uC1A1\uC744 \uC774\uACBC\uC5C8\uC9C0?\\n\uB3C4\uC6B0\uB7EC \uAC00\uBCF4\uB294 \uAC8C \uC5B4\uB54C!\\r\\n\uC790 \uB0B4\uAC00 \uC548\uB0B4\uD574\uC904\uAC8C!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC7A0\uAE50 \uC544\uB974\uBC14\uC774\uD2B8\uB85C\\n\uB9AC\uADF8 \uC2A4\uD0DC\uD504 \uB300\uC5ED\uC744 \uD558\uB294 \uC911\uC774\uC608\uC5D8[VAR 0114(0045)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC73C\uB2C8\uAE4C\\n\uBE68\uB9AC \uAC00\uC11C \uB2F9\uD558\uACE0 \uC624\uB77C\uACE0![VAR 0114(0045)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC\\n\uB108\uB294 \uC5EC\uAE30\uB97C \uC9C0\uB098\uAC00\uACE0 \uC2F6\uACA0\uC9C0?\\r\\n\uD558\uC9C0\uB9CC \uB098\uB294 \uC9C0\uB098\uAC00\uAC8C \uD558\uACE0 \uC2F6\uC9C0 \uC54A\uC544\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uC774\uAC74 \uC9C0\uB098\uAC00\uACE0 \uC2F6\uC740 \uB108\uC640\\n\uC9C0\uB098\uAC00\uAC8C \uD558\uACE0 \uC2F6\uC9C0 \uC54A\uC740 \uB098\uC758 \uC2B9\uBD80\uB2E4![VAR 0114(0045)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB108\uB97C \uC9C0\uB098\uAC00\uAC8C \uD558\uACE0 \uC2F6\uC9C0 \uC54A\uC544!\\c\\n\uADF8\uB798\uC11C \uC77C\uBD80\uB7EC \uAC74\uBB3C \uD2C8\uC5D0\\n\uC228\uC5B4\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB294\uB370\\r\\n\uC838\uBC84\uB838\uC73C\uB2C8 \uC758\uBBF8\uAC00 \uC5C6\uC5B4\uC84C\uC5B4\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uC2B9\uBD80\uC5D0\uC11C \uC9C4 \uB098\uB294 \uBB3C\uB7EC\uB0A0\uAC8C\\n\uB108\uB294 \uC9C0\uB098\uAC00\uB3C4\uB85D \uD574![VAR 0114(0045)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB108 \uBE5B\uC758\uC7A5\uB9C9\uC774\uB77C\uB294\\n\uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220\uC774 \uBB54\uC9C0 \uC54C\uC544?[VAR 0114(0045)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC774\uAC70 \uC774\uAC70\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00 \uB0A9\uC168\uAD70\\c\\n\uADF8\uB807\uC9C0\uB9CC \uC610\uB2E8\uC758 \uAD6C\uC5ED\uC744\\n\uC21C\uC21C\uD788 \uC9C0\uB098\uAC00\uAC8C \uD574\uC904 \uC218\uB294 \uC5C6\uC9C0[VAR 0114(0045)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC778\uC0AC\uAC00 \uC880 \uAC70\uCE60\uC5C8\uC9C0\uB9CC\\c\\n\uB0B4 \uD3EC\uCF13\uBAAC\uB4E4\uB3C4\\n\uB108\uC758 \uAC15\uD568\uC5D0 \uD5E4\uB871\uD5E4\uB871\uD574\uC84C\uC5B4\\c\\n\uC790 \uC9C0\uB098\uAC00\uAC8C \uD574\uC904 \uD14C\uB2C8\uAE4C\\n\uB124\uC628 \uAC04\uD310\uC774\uB77C\uB3C4 \uBCF4\uACE0 \uC788\uC5B4[VAR 0114(0045)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB304\uC2A4\uD3EC\uCF13\uBAAC \uB9C8\uC784\uB9E8...\\n\uC6B0\uB9AC\uC758 \uC720\uCF8C\uD55C \uBA64\uBC84\uC57C[VAR 0114(0045)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC758\uBBF8 \uC5C6\uB294 \uC751\uC6D0\uC774\uB2E4![VAR 0114(0045)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uAE5C\uC9DD \uB180\uB790\uC9C0!?\\c\\n\uB098\uB3C4 \uCC29\uC9C0\uC758 \uCDA9\uACA9\uC73C\uB85C\\n\uB2E4\uB9AC\uAC00 \uC544\uD30C\uC11C \uAE5C\uC9DD \uB180\uB790\uC5B4!\\c\\n\uC774\uB300\uB85C \uAC00\uB9CC\uD788 \uC788\uB2E4\uAC04\\n\uC544\uD30C\uC11C \uC6B8\uC5B4\uBC84\uB9B4 \uAC83 \uAC19\uC73C\uB2C8\uAE4C \uC2B9\uBD80\uB2E4![VAR 0114(0045)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uBD84\uBA85\uD788 \uB0B4\uAC00 \uC84C\uC9C0\uB9CC!\\c\\n\uC544\uD514\uC744 \uACAC\uB514\uBA74\uC11C \uC5F4\uC2EC\uD788 \uD588\uC73C\uB2C8\uAE4C\\n\uADF8 \uC810\uC740 \uCE6D\uCC2C\uD574\uC918!\\c\\n\uC88B\uC544! \uADF8\uB7FC \uC774\uC81C \uC544\uD514\uC744 \uACAC\uB514\uBA70\\n\uD3C9\uBC94\uD558\uAC8C \uD1F4\uC7A5\uD574\uC8FC\uC9C0![VAR 0114(0045)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC2AC\uC2AC \uD3EC\uCF13\uBAAC\uC758 HP \uB4F1\uC774\\n\uC704\uD5D8\uD558\uC9C0 \uC54A\uC544?[VAR 0114(0045)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC544\uC774\uB3CC\uC744 \uB3D9\uACBD\uD574\uC11C\\n\uD55C\uACB0\uAC19\uC774 \uC5F0\uC2B5\uD588\uB358 \uBC31 \uD140\uBE14\uB9C1!\\r\\n\uC5B4\uB54C? \uAE5C\uC9DD \uB180\uB790\uC9C0! \uB180\uB77C\uB780 \uB9D0\uC774\uC57C!\\c\\n\uB124\uAC00 \uAE5C\uC9DD \uB180\uB780 \uC0AC\uC774\uC5D0\\n\uBAB0\uB798\uBAB0\uB798 \uC774\uAE38 \uD14C\uB2C8\uAE4C![VAR 0114(0045)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC5F0\uC2B5\uC774 \uD544\uC694\uD588\uB358 \uAC74\\n\uBC31 \uD140\uBE14\uB9C1\uC774 \uC544\uB2C8\uB77C\\r\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC600\uB358 \uBAA8\uC591\uC774\uC57C...\\c\\n\uAE68\uB2EB\uAC8C \uD574\uC918\uC11C \uACE0\uB9C8\uC6CC\\n\uB108\uB97C \uC751\uC6D0\uD560\uAC8C[VAR 0114(0045)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC610\uB2E8 \uB4F1\uC7A5!\\c\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD551\uACC4\uB85C\\n\uC6B0\uB9AC\uC758 \uC544\uC9C0\uD2B8\uB97C \uC5B4\uC9C0\uB7FD\uD788\uC9C0 \uB9C8\uB77C![VAR 0114(0045)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uBB50\uC57C!? \uC2F8\uC6B8 \uC218 \uC788\uB294\\n\uAC74\uAC15\uD55C \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uB77C\uACE0?\\c\\n\uAE30\uB825\uC758\uC870\uAC01 \uAC19\uC740 \uB3C4\uAD6C\uB97C\\n\uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uB2E4\uBA74 \uB3CC\uC544\uAC00![VAR 0114(0045)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC88B\uC558\uC5B4! \uD611\uACF5\uC774\uB2E4!\\n\uCCB4\uBA74\uC744 \uCC28\uB9B4 \uB54C\uAC00 \uC544\uB2C8\uC57C![VAR 0114(0045)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC6B0\uC640~!\\n\uBCC0\uC7A5\uC774 \uB2A6\uC5B4\uBC84\uB838\uB2E4\\c\\n\uADF8\uB807\uC2B5\uB2C8\uB2E4! \uC610\uB2E8\uC758 \uC815\uCCB4\uB294 \uBC14\uB85C\\n\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC758 \uCCB4\uC721\uAD00 \uD2B8\uB808\uC774\uB108\uC600\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC774\uC820 \uB098\uB3C4 \uBAB0\uB77C!\\n\uB2E4\uC74C\uC740 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC57C\\r\\n\uC5C4\uCCAD\uB098\uAC8C \uAC15\uD558\uB2E4\uACE0![VAR 0114(0045)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC610\uB2E8\uC758 \uC815\uCCB4\uB97C\\n\uB4E4\uCF1C\uBC84\uB9B0 \uB370\uB2E4\uAC00...\\r\\n\uC81C\uB54C \uBCC0\uC7A5\uD558\uC9C0 \uBABB\uD55C \uAC83\uB3C4\\r\\n\uD63C\uB098\uACA0\uC9C0... \uADF8\uB7FC \uC548\uB155"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB9C8\uC784\uB9C8\uC784...!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uBCF4\uC774\uC9C0 \uC54A\uB294 \uBCBD\uC774 \uC788\uB2E4!?\\n\uC55E\uC73C\uB85C \uB098\uC544\uAC08 \uC218 \uC5C6\uB2E4!"
  }
]
