  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC751!? \uC18C\uB2C8\uC544 \uB204\uB098\uB3C4 \uBD24\uC9C0?\\n\uAC80\uACFC \uBC29\uD328\uC758 \uD3EC\uCF13\uBAAC\uC774 \uC788\uC5C8\uB294\uB370!\\r\\n\uC232\uC18D \uAE4A\uC740 \uACF3\uC73C\uB85C \uC0AC\uB77C\uC838\uBC84\uB838\uC5B4...[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uAC8C \uBB34\uC2A8 \uC18C\uB9AC\uC57C? \uC774\uACF3\uC5D4\\n\uB108\uD76C \uB9D0\uACE0\uB294 \uC544\uBB34\uB3C4 \uC5C6\uC5C8\uB294\uB370...[VAR 0114(000B)]"
