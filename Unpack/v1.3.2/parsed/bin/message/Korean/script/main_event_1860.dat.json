  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC678\uAD6D\uC758 \uCC45\uB3C4 \uC870\uC0AC\uD574\uC11C\\n\uACA8\uC6B0 \uCC3E\uC544\uB0C8\uC5B4\\c\\n\uAC80\uC758 \uD3EC\uCF13\uBAAC \uC790\uC2DC\uC548\\n\uBC29\uD328\uC758 \uD3EC\uCF13\uBAAC \uC790\uB9C8\uC820\uD0C0\\c\\n\uC544\uB4DD\uD788 \uBA3C... \uAFB8\uBC85\uC878\uC74C\uC232\uC758 \uC800\uD3B8\uC5D0\uC11C\\n\uD0DC\uC5B4\uB09C \uAC83\uC73C\uB85C \uCD94\uC815\uB418\uB294 \uD3EC\uCF13\uBAAC\uC774\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 6,
