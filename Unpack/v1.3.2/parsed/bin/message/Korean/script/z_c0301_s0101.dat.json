[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC29B\uC2DC\uD2F0\uB294 \uB113\uC5B4\uC11C\\n\uBAA8\uB178\uB808\uC77C\uC744 \uC774\uC6A9\uD558\uAC70\uB098\\r\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB97C \uD0C0\uB294 \uAC8C \uD3B8\uD558\uB2F5\uB2C8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "[~ 1]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "[~ 2]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC29B\uC2DC\uD2F0\uB294 \uAD00\uAD11\uAC1D\uB4E4\uC774 \uB9CE\uC544\uC11C\\n\uB9DB\uB3C4 \uB2E4\uB974\uAC8C \uB0B4\uC57C \uD55C\uB2E8\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC2DC\uD569\uC5D0 \uC9D1\uC911\uD558\uB290\uB77C \uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\uB294\\n\uBC25\uC744 \uBABB \uBA39\uAC8C \uB41C\uB2E8 \uB9D0\uC774\uC9C0"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29\uC744 \uB458\uB7EC\uBCF4\uACE0 \uC2F6\uC5B4!\\n\uADF8\uB7F4 \uB550 \uAD00\uB78C\uCC28\uAC00 \uC801\uB2F9\uD558\uC9C0 \uC54A\uC744\uAE4C?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAD00\uB78C\uCC28\uB77C...\\n\uB192\uC740 \uACF3\uC740 \uBB34\uC11C\uC6B4\uB370..."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098, \uBAA8\uB178\uB808\uC77C\uC744 \uD0C0\uC9C0 \uC54A\uC73C\uBA74\\n\uB85C\uC988\uD0C0\uC6CC\uC5D0 \uAC08 \uC218 \uC5C6\uAD6C\uB098"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC120\uB85C\uB97C \uC88B\uC544\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774 \uC788\uC5B4\uC11C\\n\uC7AC\uBBF8\uC788\uB294 \uD2B8\uB7EC\uBE14\uC774 \uC77C\uC5B4\uB0A0 \uB54C\uB3C4 \uC788\uB2F5\uB2C8\uB2E4..."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC29B\uC2DC\uD2F0\uC758 \uBA85\uBB3C\\n\uBAA8\uB178\uB808\uC77C \uD0C0\uB294 \uACF3\uC740 \uC774\uCABD\uC785\uB2C8\uB2E4!\\c\\n\uBAA8\uB178\uB808\uC77C\uC740 \uC29B\uC2DC\uD2F0\uB97C\\n\uBE59\uAE00\uBE59\uAE00 \uB3C8\uB2F5\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAE4C\uC544\uC544!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB0B4 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uC74C\uC545\uC744 \uC88B\uC544\uD574\uC11C \uB9D0\uC774\uC57C!\\c\\n\uB098\uC774\uC2A4\uD55C \uC0AC\uC6B4\uB4DC\uB97C \uB4E4\uC73C\uBA74\\n\uC3DC\uC0B4\uAC19\uC774 \uB2EC\uB824\uB098\uAC00\uACE4 \uD574!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC9C0\uADF8~!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC7AC\uADF8~!"
  }
]
