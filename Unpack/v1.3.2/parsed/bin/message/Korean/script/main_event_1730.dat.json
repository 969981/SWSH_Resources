[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\\n\uB300\uB9DD\uC758 \uACB0\uC2B9\uC804!\\c\\n\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\\n\uB2E8\uB378\uC5D0 \uB9DE\uC124 \uB3C4\uC804\uC790\uB294[VAR 0114(0018)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBE5B\uB098\uB294 \uCD08\uC2E0\uC131\\n[VAR 0100(0000)] \uC120\uC218\uAC00 \uB420 \uAC83\uC778\uAC00![VAR 0114(0018)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8 \uB2E8\uB378\uC774\\n\uB77C\uC774\uBC8C\uB85C \uC778\uC815\uD55C \uC0AC\uB098\uC774\\r\\n\uB4DC\uB798\uACE4\uC2A4\uD1B0! \uAE08\uB791\uC774 \uB420 \uAC83\uC778\uAC00!?[VAR 0114(0018)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB2E4\uB2C8\\n\uB108 \uC815\uB9D0 \uB300\uB2E8\uD558\uAD6C\uB098!\\c\\n\uC5ED\uC2DC \uCC54\uD53C\uC5B8 \uB2E8\uB378\uC774\\n\uCD94\uCC9C\uD55C \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uC57C![VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB77C\uC774\uBC8C \uB2E8\uB378\uC744 \uB6F0\uC5B4\uB118\uAE30 \uC704\uD574\\n\uB140\uC11D\uC774 \uC120\uD0DD\uD55C \uB108\uB97C \uC774\uAE30\uACA0\uC5B4!\\c\\n\uD300 \uBA64\uBC84\uB3C4\\n1\uB3001\uC5D0 \uB9DE\uCDB0\uC11C \uC900\uBE44\uD574\uC654\uC9C0![VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD55C \uBC88 \uC9C4 \uC8FC\uC81C\uC5D0 \uAD1C\uD788 \uD070\uC18C\uB9AC\uCE5C\uB2E4\uACE0 \\n\uC0DD\uAC01\uD560 \uC218\uB3C4 \uC788\uACA0\uC9C0\uB9CC\\c\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\uC11C\uC758\\n\uB098\uC640\uB294 \uB2E4\uB974\uB2C8\uAE4C \uC595\uBCF4\uC9C0 \uB9D0\uB77C\uACE0![VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC2B9\uC790\uB294 [VAR 0100(0000)] \uC120\uC218![VAR 0114(0018)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB098\uC640 \uB098\uC758 \uC0AC\uB791\uC2A4\uB7EC\uC6B4\\n\uD3EC\uCF13\uBAAC\uB4E4\uC774\\r\\n\uAC15\uD574\uC9C4 \uAC83\uBCF4\uB2E4\uB3C4 \uD6E8\uC52C \uB354\\r\\n\uB9D0\uB3C4 \uC548 \uB418\uAC8C \uAC15\uD574\uC9C0\uB2E4\uB2C8![VAR 0114(0017)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB098\uB3C4 \uB098\uB984 \uC80A\uC740 \uD3B8\uC778\uB370\\n\uB098\uBCF4\uB2E4 \uB354 \uC80A\uC740 \uB140\uC11D\uB4E4\uC758 \uC131\uC7A5\uC740\\r\\n\uC815\uB9D0 \uB180\uB77C\uC6B4\uAC78! \uBBF8\uB798\uAC00 \uAE30\uB300\uB3FC![VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8 \uAE30\uC138 \uADF8\uB300\uB85C\\n\uB2E8\uB378\uC744 \uB0A0\uB824\uBC84\uB9AC\uB294 \uAC70\uC57C![VAR 0114(0017)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBE5B\uB098\uB294 \uB4F1\uBC88\uD638 [VAR 01C4(0001)]\uBC88\uC744 \uB2E8\\n[VAR 0100(0000)] \uC120\uC218\uAC00 \uC2B9\uB9AC\uD588\uC2B5\uB2C8\uB2E4\\c\\n\uC774\uC81C \uCD94\uCC9C\uC7A5\uC744 \uBC1B\uC740\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uAC00\\c\\n\uCD94\uCC9C\uC7A5\uC744 \uC900\\n\uCC54\uD53C\uC5B8\uC5D0\uAC8C \uB3C4\uC804\uD569\uB2C8\uB2E4!![VAR 0114(0018)]"
  }
