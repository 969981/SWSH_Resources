[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC601\uC6C5\uC758 \uD0D5...\\c\\n\uBA3C \uC61B\uB0A0\uC5D0 \uB450 \uC0AC\uB78C\uC758 \uC601\uC6C5\uC774\\n\uC545\uD55C \uC874\uC7AC\uB97C \uBB3C\uB9AC\uCE58\uACE0\\r\\n\uC2F8\uC6C0\uC758 \uC0C1\uCC98\uB97C \uCE58\uC720\uD55C \uC7A5\uC18C\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uC624\uB298\uB0A0 \uC601\uC6C5\uC758 \uD0D5\uC5D0\\n\uB4E4\uC5B4\uAC08 \uC218 \uC788\uB294 \uAC74 \uD3EC\uCF13\uBAAC\uBFD0\uC778\uB370...\\c\\n\uC73C\uC74C... \uBA3C \uC61B\uB0A0\uC5D0 \uC628\uCC9C\uC5D0\\n\uB4E4\uC5B4\uAC14\uB2E4\uB294 \uC601\uC6C5\uC740 \uB300\uCCB4 \uBB58\uAE4C?\\c\\n...\uB098\uC911\uC5D0 \uC870\uC0AC\uD574\uBD10\uC57C\uC9C0[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAFB8\uBC85\uC878\uC74C\uC232\uC5D0\uC11C \uC774\uC0C1\uD55C\\n\uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB09C \uB108\uD76C\uB77C\uBA74...\\c\\n\uB450 \uBA85\uC758 \uC601\uC6C5\uC774\\n\uB420 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAC80\uACFC \uBC29\uD328\uC758 \uC601\uC6C5 \uB9D0\uD558\uB294 \uAC70\uC57C...?\\n\uADF8\uB807\uB2E4\uBA74 \uB098\uB294 \uBC29\uD328\uAC00 \uC88B\uC740\uB370[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAC80\uACFC \uBC29\uD328\uC758 \uC601\uC6C5 \uB9D0\uD558\uB294 \uAC70\uC57C...?\\n\uADF8\uB807\uB2E4\uBA74 \uB098\uB294 \uAC80\uC774 \uC88B\uC740\uB370[VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBA3C \uC61B\uB0A0\uC758 \uC601\uC6C5\uC740\\n\uC5B4\uB5A4 \uC2F8\uC6C0\uC744 \uCE58\uB800\uB358 \uAC78\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC5B4\uC774 [VAR 0100(0000)]!\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uD558\uC790[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC54C\uC558\uC5B4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824..."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB098\uB294 \uACC4\uC18D\uD574\uC11C \uAC15\uD574\uC9C8 \uAC70\uC57C!\\c\\n\uADF8\uB798\uC11C \uCC54\uD53C\uC5B8\uC774\uB098 \uC601\uC6C5\uC740 \uBB3C\uB860\uC774\uACE0\\n[VAR 0100(0000)]! \uB108\uB3C4 \uC774\uAE38 \uAC70\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "...\uC54C\uC558\uC5B4\\n\uD655\uC2E4\uD558\uAC8C \uC900\uBE44\uD574\uC11C \uC640![VAR 0114(0005)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC18C\uB2C8\uC544 \uB204\uB098\uAC00 \uC0AC\uC900\\n\uB9DB\uC788\uB294 \uCE74\uB808\uB77C\uC774\uC2A4\uB97C \uBA39\uC5C8\uB354\uB2C8\\r\\n\uC758\uC695\uC774 \uB9C8\uAD6C\uB9C8\uAD6C \uC0D8\uC19F\uB294 \uAC83 \uAC19\uC544!![VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC18C\uB9B0\uC9C0 \uC804\uD600 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uBAA8\uCC98\uB7FC\uC774\uB2C8\uAE4C \uB098\uB3C4 \uBD10\uC904\uAC8C\\c\\n[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uAC74\uAC15\uD558\uAC8C \uB9CC\uB4E4\uC5B4 \uC904 \uD14C\uB2C8\uAE4C \uC798 \uBD80\uD0C1\uD574![VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBBF8\uB798\uC758 \uCC54\uD53C\uC5B8\uC774 \uC120\uBCF4\uC774\uB294\\n\uC2DC\uBC94 \uACBD\uAE30\uB97C \uC2DC\uC791\uD558\uC790![VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB450 \uC0AC\uB78C \uBAA8\uB450 \uACE0\uB9C8\uC6CC!\\n\uBA4B\uC9C4 \uC2B9\uBD80\uC600\uC5B4... \uC774\uB300\uB85C \uACC4\uC18D\uD574\uC11C\\r\\n\uBB34\uC801\uC758 \uB2E8\uB378\uC744 \uC4F0\uB7EC\uB728\uB9AC\uB294 \uAC70\uC57C![VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC774\uC81C \uB108\uD76C\uB294 \uC5B4\uB5BB\uAC8C \uD560 \uAC70\uB2C8?\\c\\n\uB098\uB294 \uAFB8\uBC85\uC878\uC74C\uC232\uC5D0 \uB300\uD574\uC11C\uB3C4\\n\uC870\uC0AC\uD574 \uBCFC \uC0DD\uAC01\uC778\uB370[VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB09C \uB2E4\uC2DC \uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD560 \uAC70\uC57C!\\c\\n\uADF8\uB9AC\uACE0 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBC1B\uC73C\uBA74\\n\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC5D0 \uAC08 \uAC70\uC57C!\\r\\n9\uBC88\uB3C4\uB85C\uB97C \uC9C0\uB098\uC11C \uB9D0\uC774\uC57C! \uADF8\uB7FC \uC548\uB155![VAR 0114(0005)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB9C8\uC74C\uC744 \uB2E4\uC2DC \uB2E4\uC7A1\uC740 \uBAA8\uC591\uC774\uB77C \uB2E4\uD589\uC774\uC57C\\c\\n\uD638\uBE0C\uAC00 \uAE30\uC6B4\uC774 \uC5C6\uC73C\uBA74\\n\uB2E8\uB378\uC774 \uAC71\uC815\uD558\uB294 \uB370\uB2E4\uAC00\\c\\n\uB77C\uC774\uBC8C\uC778 \uB108\uB3C4 \uB9CC\uC871\uC2A4\uB7FD\uC9C0 \uBABB\uD560 \uD14C\uB2C8\uAE4C!\\n\uADF8\uB7FC \uB610 \uBCF4\uC790![VAR 0114(000B)]"
  }
]
