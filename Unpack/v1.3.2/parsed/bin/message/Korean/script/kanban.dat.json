[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD384\uB871\uB9C8\uC744\\n\uC61B\uB0A0\uBD80\uD130 \uBAA9\uC7A5\uC744 \uC6B4\uC601\uD558\uBA70\\r\\n\uD3EC\uCF13\uBAAC\uB4E4\uACFC \uD568\uAED8 \uC0AC\uB294 \uB9C8\uC744"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "[~ 1]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "1\uBC88\uB3C4\uB85C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBE0C\uB798\uC2DC\uB9C8\uC744\\n\uD3EC\uCF13\uBAAC \uC5F0\uAD6C\uC18C\uAC00 \uC788\uB294\\r\\n\uAD50\uC678\uC758 \uC870\uC6A9\uD55C \uB9C8\uC744"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "2\uBC88\uB3C4\uB85C"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uD3EC\uCF13\uBAAC\uC740 \uC2B9\uBD80\uB97C \uD558\uBA74\\n\uACBD\uD5D8\uCE58\uB97C \uC5BB\uACE0 \uAC15\uD574\uC9D1\uB2C8\uB2E4!\\c\\n\uB610\uD55C \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC544\uB3C4\\n\uACBD\uD5D8\uCE58\uB97C \uC5BB\uACE0 \uAC15\uD574\uC9D1\uB2C8\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uB0A8\uC758 \uD3EC\uCF13\uBAAC\uC5D0\\n\uC190\uB300\uBA74 \uB3C4\uB451!\\c\\n\uBAAC\uC2A4\uD130\uBCFC\uC740\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB9CC \uB358\uC9C0\uC790!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC774 \uBC1C\uACAC\uB418\uB294\\n\uB9E1\uAE30\uBBF8\uC9D1"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5D4\uC9C4\uC2DC\uD2F0\\n\uC99D\uAE30 \uAE30\uAD00\uC744 \uC774\uC6A9\uD574\uC11C\\r\\n\uADFC\uB300\uD654\uB97C \uC774\uB8EC \uACF5\uC5C5 \uB3C4\uC2DC"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "3\uBC88\uB3C4\uB85C"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uB3C4\uB85C\uC5D0\uC11C\uB3C4 \uCEA0\uD504\uB97C \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uCEA0\uD551\uC744 \uD558\uBA74\\n\uD3EC\uCF13\uBAAC\uC774 \uACBD\uD5D8\uCE58\uB97C \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uCEA0\uD551 \uC2A4\uD3FF\uC5D0\uC11C \uB2E4\uB978 \uC0AC\uB78C\uC774 \uC5F0\\n\uD150\uD2B8\uB97C \uBC29\uBB38\uD558\uB294 \uAC83\uB3C4 \uAC00\uB2A5\uD569\uB2C8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[~ 11]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774 \uC55E\uC740\\n\uAC00\uB77C\uB974\uAD11\uC0B0"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "4\uBC88\uB3C4\uB85C"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220\uC740\\n\uBB3C\uB9AC\uC640 \uD2B9\uC218\uC758\\r\\n2\uAC00\uC9C0\uB85C \uBD84\uB958\uB429\uB2C8\uB2E4!\\c\\n\uD3EC\uCF13\uBAAC\uC758 \uACF5\uACA9\uC774 \uB192\uC73C\uBA74\\n\uBB3C\uB9AC \uAE30\uC220\uC774 \uAC15\uD574\uC9D1\uB2C8\uB2E4!\\c\\n\uD3EC\uCF13\uBAAC\uC758 \uD2B9\uC218\uACF5\uACA9\uC774 \uB192\uC73C\uBA74\\n\uD2B9\uC218 \uAE30\uC220\uC774 \uAC15\uD574\uC9D1\uB2C8\uB2E4!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD130\uD504\uB9C8\uC744\\n\uACC4\uB2E8\uC2DD \uBC2D \uC0AC\uC774\uC5D0 \uC9D1\uB4E4\uC774 \uC704\uCE58\uD55C\\r\\n\uBD84\uC9C0 \uC9C0\uD615\uC758 \uB9C8\uC744"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD130\uD504\uB9C8\uC744\\n\uB9C8\uC744 \uC678\uACFD\uC5D0 \uC788\uB294 \uC5B8\uB355\uC5D0\uC11C\\r\\n\uC624\uB798\uB41C \uC9C0\uC0C1\uD654\uB97C \uBCFC \uC218 \uC788\uB2E4"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD130\uD504\uC2A4\uD0C0\uB514\uC6C0"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "5\uBC88\uB3C4\uB85C"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC774 \uBC1C\uACAC\uB418\uB294\\n\uB9E1\uAE30\uBBF8\uC9D1"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[~ 20]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uC624\uB77C\uB97C \uB450\uB974\uACE0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uC870\uAE08 \uB354 \uAC15\uD558\uAC70\uB098 \uC4F0\uB7EC\uB728\uB9AC\uBA74\\r\\nW... \uC640\uD2B8\uB97C \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4\\r\\n\uC774\uB7F0 \uD3EC\uCF13\uBAAC\uC744 \uC624\uB77C \uD3EC\uCF13\uBAAC\uC774\uB77C\uACE0 \uBD80\uB985\uB2C8\uB2E4!\\c\\n\uD3EC\uCF13\uBAAC\uC744 \uB9CE\uC774 \uC7A1\uC744\uC218\uB85D\\n\uC624\uB77C\uB97C \uB450\uB978 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uCD9C\uD604\uD558\uAE30 \uC26C\uC6CC\uC9C4\uB2E4\uACE0 \uD569\uB2C8\uB2E4!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uBC14\uC6B0\uB9C8\uC744\\n\uC2DC\uC7A5\uACFC \uB808\uC2A4\uD1A0\uB791\uC5D0 \uC218\uB9CE\uC740\\r\\n\uC0AC\uB78C\uB4E4\uC774 \uBAA8\uC5EC\uB4DC\uB294 \uD56D\uAD6C \uB9C8\uC744"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uBC14\uC6B0\uC2A4\uD0C0\uB514\uC6C0"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC5EC\uAE30\uB294 \uC5D4\uC9C4\uC2DC\uD2F0 \uBCC0\uB450\uB9AC"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\u2192 \uC81C2\uAD11\uC0B0\\n\u2190 \uC5D4\uC9C4\uC2DC\uD2F0"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0\\n\uC911\uC138\uC758 \uC131\uBCBD\uC774 \uBCF4\uC874\uB41C\\r\\n\uC5ED\uC0AC \uAE4A\uC740 \uB9C8\uC744"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "6\uBC88\uB3C4\uB85C"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uAE30\uC220\uBA38\uC2E0\uC740 \uBA87 \uBC88\uC774\uACE0 \uACC4\uC18D \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uB2E4\uC591\uD55C \uD0C0\uC785\uC758\\n\uAE30\uC220\uC744 \uBC30\uC6B0\uAC8C \uD558\uBA74\\c\\n\uC5EC\uB7EC \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC720\uB9AC\uD55C\\n\uACF5\uACA9\uC744 \uD3BC\uCE60 \uC218 \uC788\uAC8C \uB429\uB2C8\uB2E4!\\c\\n\uAE30\uC220\uB808\uCF54\uB4DC\uB294 \uD55C\uBC88 \uC0AC\uC6A9\uD558\uBA74\\n\uBD80\uC11C\uC9C0\uBBC0\uB85C \uC8FC\uC758\uD574\uC57C \uD569\uB2C8\uB2E4"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uB9C8\uC744\\n\uACE0\uB300 \uC608\uC220\uC744 \uC911\uC2EC\uC73C\uB85C\\r\\n\uBC88\uC601\uD574\uC628 \uC0B0\uAC04 \uB9C8\uC744"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\u2191 \uC544\uB77C\uBCA0\uC2A4\uD06C\uB9C8\uC744\\n\u2193 \uB798\uD130\uB7F4\uB9C8\uC744"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uB9C8\uC744\uC758 \uBA85\uBB3C!\\n\uAC00\uB77C\uB974\uC758 \uC5ED\uC0AC \uB300\uBC1C\uACAC!"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "[~ 32]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uB798\uD130\uB7F4\uC2A4\uD0C0\uB514\uC6C0"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC544\uB77C\uBCA0\uC2A4\uD06C\uB9C8\uC744\\n\uAC70\uBAA9\uC758 \uB0B4\uBD80\uC5D0 \uAD6C\uBA4D\uC744 \uB0B8 \uD615\uD0DC\uC758\\r\\n\uC9D1\uC774 \uC788\uB294 \uB9C8\uC744"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC544\uB77C\uBCA0\uC2A4\uD06C\uC2A4\uD0C0\uB514\uC6C0"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "7\uBC88\uB3C4\uB85C"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uD3EC\uCF13\uBAAC\uC774 \uC9C4\uD654\uD560 \uAC83 \uAC19\uC744 \uB54C\\nB \uBC84\uD2BC\uC744 \uB204\uB974\uBA74\\r\\n\uB180\uB77C\uC11C \uC9C4\uD654\uB97C \uBA48\uCDB0\uBC84\uB9BD\uB2C8\uB2E4\\c\\n\uC774\uB97C \uC9C4\uD654\uCE94\uC2AC\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744\\n\uC624\uB798\uB41C \uAC74\uBB3C\uC774 \uB298\uC5B4\uC11C \uC788\uB294\\r\\n\uC628\uCC9C \uB9C8\uC744"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC5D0\\n\uD45C\uC2DC\uB418\uB294\\r\\n\uCD94\uCC9C \uD3EC\uCF13\uBAAC\uC740\\c\\n\uBAA8\uB450 \uC7A1\uAC70\uB098\\n\uD558\uB8E8\uAC00 \uACBD\uACFC\uD558\uBA74\\r\\n\uC5C5\uB370\uC774\uD2B8\uB429\uB2C8\uB2E4"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uD0A4\uB974\uCFE0\uC2A4\uC2A4\uD0C0\uB514\uC6C0"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "8\uBC88\uB3C4\uB85C"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uBE5B\uB098\uB294 \uD3EC\uCF13\uBAAC\uAD74\uC744 \uC870\uC0AC\uD558\uBA74\\r\\nW=\uC640\uD2B8\uAC00 \uC810\uC810 \uC313\uC785\uB2C8\uB2E4!\\c\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC5F4\uC2EC\uD788 \uAC78\uC5B4\uC628 \uBD84\uB4E4\uC740\\n\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C\uB3C4 \uBD80\uC9C0\uB7F0\uD788 \uAC78\uC5B4 \uB2E4\uB2C8\uBA74\uC11C\\r\\n\uD3EC\uCF13\uBAAC\uAD74\uC744 \uCC3E\uC544\uBCF4\uC138\uC694!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\\n\uB2E4\uC591\uD55C \uAC00\uAC8C\uAC00 \uC5B4\uC218\uC120\uD558\uAC8C \uC790\uB9AC \uC7A1\uC740\\r\\n\uC5B4\uB518\uAC00 \uD391\uD06C\uD55C \uBD84\uC704\uAE30\uC758 \uB9C8\uC744"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "9\uBC88\uB3C4\uB85C"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\u2191 9\uBC88\uB3C4\uB85C\\n\u2192 \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uD0A4\uB974\uCFE0\uC2A4\uB9CC"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\u2193 \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC73C\uB824\uACE0 \uD560 \uB54C\\n\uB358\uC9C4 \uBAAC\uC2A4\uD130\uBCFC\uC774\\r\\n\uD55C \uBC88\uB9CC \uD754\uB4E4\uB9AC\uB294 \uACBD\uC6B0\uAC00 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uD3EC\uCF13\uBAAC\uC744 \uB9CE\uC774 \uC7A1\uC744\uC218\uB85D\\n\uBC1C\uC0DD\uD558\uAE30 \uC26C\uC6B4 \uD604\uC0C1\uC73C\uB85C\\c\\n\uC5EC\uB290 \uB54C\uBCF4\uB2E4 \uD3EC\uCF13\uBAAC\uC774 \uC798 \uC7A1\uD788\uAE30 \uB54C\uBB38\uC5D0\\n\uD3EC\uD68D \uD06C\uB9AC\uD2F0\uCEEC\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4!"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "10\uBC88\uB3C4\uB85C"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uC815\uBCF4 \uB098\uB214 \uAC8C\uC2DC\uD310!\\c\\n\uD3EC\uCF13\uBAAC\uC758 \uBAB8\uC5D0\uC11C \uBC1C\uC0B0\uB418\uB294\\n\uD2B9\uC218\uD55C \uD30C\uC6CC\uB294\\r\\n\uC8FC\uC704\uC758 \uACF5\uAC04\uC744 \uC65C\uACE1\uD574\uC11C\\c\\n\uC2E4\uC81C \uD06C\uAE30\uBCF4\uB2E4\uB3C4\\n\uD3EC\uCF13\uBAAC\uC744 \uAC70\uB300\uD574 \uBCF4\uC774\uAC8C \uD569\uB2C8\uB2E4\\r\\n\uC774\uB97C \uB2E4\uC774\uB9E5\uC2A4\uB77C\uACE0 \uD569\uB2C8\uB2E4\\c\\n\uAC1C\uC911\uC5D0\uB294 \uB2E4\uC774\uB9E5\uC2A4\uB97C \uD1B5\uD574\\n\uBAA8\uC2B5\uC774 \uBC14\uB00C\uB294 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uC2B5\uB2C8\uB2E4\\r\\n\uC774\uB97C \uAC70\uB2E4\uC774\uB9E5\uC2A4\uB77C\uACE0 \uD569\uB2C8\uB2E4"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uC29B\uC2DC\uD2F0\\n\uB85C\uC988 \uC704\uC6D0\uC7A5\uC5D0 \uC758\uD574\\r\\n\uACC4\uD68D\uC801\uC73C\uB85C \uC138\uC6CC\uC9C4 \uB300\uB3C4\uC2DC"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uB113\uC740 \uC29B\uC2DC\uD2F0\uC5D0\uC11C \uC774\uB3D9\uD558\uC2E4 \uB54C\uB294\\n\uC29B\uC2DC\uD2F0 \uC804\uBB38\\r\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB098\\r\\n\uBAA8\uB178\uB808\uC77C\uC744 \uC774\uC6A9\uD574 \uC8FC\uC2ED\uC2DC\uC624"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uC29B\uC2A4\uD0C0\uB514\uC6C0"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC774 \uBC1C\uACAC\uB418\uB294\\n\uB9E1\uAE30\uBBF8\uC9D1"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "[~ 55]"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "[~ 56]"
