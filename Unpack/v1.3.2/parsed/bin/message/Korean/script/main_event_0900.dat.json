[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC654\uAD6C\uB098[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC815\uB9D0 \uAD49\uC7A5\uD55C \uBCF4\uBB3C\uACE0\uC774\uC9C0 \uC54A\uB2C8?!\\c\\n\uAC00\uB77C\uB974\uC758 \uC5ED\uC0AC\uB97C \uC804\uD558\uAE30 \uC704\uD55C\\n\uD0DC\uD53C\uC2A4\uD2B8\uB9AC\uAC00 \uB0A8\uC544 \uC788\uB2E4\uB2C8[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC18C\uC6D0\uC758\uBCC4\uC744 \uBCF4\uB294 \uB450 \uC80A\uC740\uC774[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC7AC\uC559\uC758 \uB3C4\uB798...\\n\uB2F9\uD669\uD558\uB294 \uC80A\uC740\uC774\uB4E4[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC7AC\uC559\uC744 \uBB3C\uB9AC\uCE58\uB294\\n\uAC80\uACFC \uBC29\uD328\uB97C \uBCF4\uB294 \uC80A\uC740\uC774\uB4E4[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC655\uAD00\uC744 \uC4F4 \uC80A\uC740\uC774\uB4E4[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC5D0 \uC655\uAD6D\uC774 \uB9CC\uB4E4\uC5B4\uC84C\uC744 \uB54C\uC758\\n\uC774\uC57C\uAE30\uAC00 \uB2F4\uAE34 \uD0DC\uD53C\uC2A4\uD2B8\uB9AC\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC790, \uC80A\uC740 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\\n\uBB54\uAC00 \uB208\uCE58\uCC48 \uAC83\uC740 \uC5C6\uC5C8\uB2C8?[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC601\uC6C5\uC774 \uB450 \uC0AC\uB78C\uC774\uB124\uC694?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBE14\uB799 \uB098\uC774\uD2B8?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBC14\uB85C \uB9DE\uD614\uC5B4!\\c\\n\uC5D4\uC9C4\uC2DC\uD2F0\uC758 \uD638\uD154\uC5D0 \uC788\uB358\\n\uC601\uC6C5\uC758 \uB3D9\uC0C1\uC740 \uB204\uAC00 \uBD10\uB3C4 \uD55C \uBA85\uBFD0\uC774\uC5C8\uC5B4\\c\\n\uADF8\uB7F0\uB370 \uC5EC\uAE30 \uC788\uB294 \uD0DC\uD53C\uC2A4\uD2B8\uB9AC\uC5D0\uB294\\n\uC80A\uC740\uC774\uAC00 \uB450 \uBA85\uC778 \uAC83\uC73C\uB85C \uB098\uC640 \uC788\uC9C0[VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB798 \uB9DE\uC544!\\c\\n\uD558\uB298\uC744 \uB4A4\uB36E\uC740 \uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uB97C\\n\uC7AC\uC559\uC774\uB77C \uC804\uD558\uACE0 \uC788\uC5B4...\\r\\n\uADF8\uAC8C \uBC14\uB85C \uBE14\uB799 \uB098\uC774\uD2B8\uC57C![VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC601\uC6C5\uC740 \uD55C \uBA85\uC774\uC5C8\uC744\uAE4C\\n\uC544\uB2C8\uBA74 \uB450 \uBA85\uC774\uC5C8\uC744\uAE4C...?\\r\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB294 \uB300\uCCB4 \uBB50\uC600\uB358 \uAC78\uAE4C?[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uC918\uC11C \uACE0\uB9C8\uC6CC\\n\uC0DD\uAC01\uC774 \uC5B4\uB290 \uC815\uB3C4 \uC815\uB9AC\uB410\uC5B4\\c\\n\uB09C \uD0DC\uD53C\uC2A4\uD2B8\uB9AC\uB97C \uB354 \uC870\uC0AC\uD574\uBCFC \uAC74\uB370\\n\uB108\uB294 \uC774\uC81C \uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD574\uC57C\uACA0\uC9C0?\\c\\n\uC751\uC6D0\uD558\uB294 \uC758\uBBF8\uB85C \uC774\uAC78 \uC904\uAC8C\\n\uADF8\uB7FC \uB108\uC758 \uC2B9\uB9AC\uB97C \uAE30\uB300\uD558\uACE0 \uC788\uC744\uAC8C![VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC7AC\uC559\uC744 \uBB3C\uB9AC\uCE5C\\n\uAC80\uACFC \uBC29\uD328\uB294 \uC9C0\uAE08 \uC5B4\uB514\uC5D0 \uC788\uC744\uAE4C?[VAR 0114(000B)]"
  }
]
