[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD06D! \uCCAB \uC2DC\uD569\uBD80\uD130 \uC9C0\uB2E4\uB2C8...\\n\uCD5C\uBA74\uC220\uC774\uB77C\uB3C4 \uC4F4 \uAC74\uAC00...?[VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC81C\uAC00 \uC5C6\uB294 \uACB0\uC2B9\uC804 \uB530\uC704\\n\uAC74\uB354\uAE30 \uC5C6\uB294 \uCE74\uB808\uB098 \uB2E4\uB984\uC5C6\uC2B5\uB2C8\uB2E4[VAR 0114(0072)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB97C \uC81C\uCE58\uACE0 \uC6B0\uC2B9\uD558\uB2E4\uB2C8...\\n\uBD84\uD558\uC9C0\uB9CC, \uD6CC\uB96D\uD569\uB2C8\uB2E4[VAR 0114(0072)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC804\uD600 \uD65C\uC57D\uD558\uC9C0 \uBABB\uD588\uC796\uC544!\\n\uC544\uC559~ \uCD5C\uC545\uC774\uC57C...[VAR 0114(0071)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uACB0\uC2B9\uC804... \uBD80\uB7FD\uB2E4...\\c\\n\uB098\uB3C4 \uAC19\uC774 \uD300 \uD558\uBA74 \uC548 \uB3FC...?\\n\uC751~?[VAR 0114(0071)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC900\uC6B0\uC2B9\uB3C4 \uCDA9\uBD84\uD788 \uB300\uB2E8\uD55C \uAC70\uB2C8\uAE4C \uB9CC\uC871\uD574![VAR 0114(0071)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB798\uB3C4 \uBA85\uC0C9\uC774 \uC2A4\uC2B9\uC778\uB370\\n\uC774\uB7F0 \uACB0\uACFC\uB294 \uC880 \uBA74\uBAA9 \uC5C6\uAD6C\uB098[VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uAC15\uD558\uB354\uAD6C\uB098~\\n\uACB0\uC2B9\uB3C4 \uC5F4\uC2EC\uD788 \uD558\uAC70\uB77C![VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uBA4B\uC9C4 \uC2DC\uD569\uC774\uC5C8\uB2E4!\\n\uB108\uD76C\uC758 \uC6B0\uC2B9\uC744 \uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD558\uB9C8![VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCCAB\uD310\uBD80\uD130 \uB300\uC7A5\uC744 \uC0C1\uB300\uD55C \uAC8C\\n\uC6B4\uC774 \uC5C6\uC5C8\uB358 \uAC70\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uC544~\uD558\uD558! \uC88B\uC740 \uC2B9\uBD80\uC600\uC5B4!\\n\uACB0\uC2B9\uC804\uB3C4 \uC5F4\uC2EC\uD788 \uD558\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC815\uB9D0 \uB728\uAC70\uC6B4 \uACB0\uC2B9\uC804\uC774\uC5C8\uC5B4!\\n\uC6B0\uC2B9 \uCD95\uD558\uD574, \uB300\uC7A5![VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uCCAB \uC2DC\uD569\uBD80\uD130 \uC9C8 \uC904\uC774\uC57C!\\c\\n\uC218\uC900 \uB192\uC740 \uACBD\uAE30\uC5D0\\n\uAD00\uAC1D\uB4E4\uC774 \uC544\uC8FC \uD765\uBD84\uD558\uACE0 \uC788\uC5B4![VAR 0114(0004)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uAC00 \uC804\uB825\uC744 \uB2E4\uD588\uC9C0\uB9CC\\n\uB108\uD76C \uD300\uC774 \uB354 \uAC15\uD588\uC5B4!\\c\\n\uC790! \uACB0\uC2B9\uC804\uC5D0\uC11C\\n\uB354 \uBA4B\uC9C4 \uC2B9\uBD80\uB97C \uBCF4\uC5EC\uC918![VAR 0114(0004)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uCEF5\uC5D0 \uD544\uC801\uD560 \uB9CC\uD07C\\n\uBA4B\uC9C4 \uC2DC\uD569\uC774\uC5C8\uC5B4!\\c\\n\uAC00\uB77C\uB974 \uC2A4\uD0C0 \uD1A0\uB108\uBA3C\uD2B8\uB97C \uAE30\uD68D\uD558\uAE38\\n\uC815\uB9D0 \uC798\uD55C \uAC83 \uAC19\uC544! \uACE0\uB9D9\uB2E4![VAR 0114(0004)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uAC00\\n1\uC2B9\uB3C4 \uAC70\uB450\uC9C0 \uBABB\uD558\uB2E4\uB2C8...\\c\\n\uC608\uC0C1 \uBC16\uC758 \uACB0\uACFC\uC5D0\\n\uAD00\uAC1D\uB4E4\uB3C4 \uB3D9\uC694\uD558\uACE0 \uC788\uB294 \uBAA8\uC591\uC774\uB124\uC694[VAR 0114(000C)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB97C \uC774\uACBC\uC73C\uB2C8\\n\uACB0\uC2B9\uC5D0\uC11C \uC9C0\uBA74 \uC6A9\uC11C\uD558\uC9C0 \uC54A\uC744 \uAC81\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
