  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uC644\uD328\uC600\uC2B5\uB2C8\uB2E4!\\n\uC6B0\uC2B9 \uCD95\uD558\uB4DC\uB824\uC694[VAR 0114(000E)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uD729\uC4F8\uC5B4\uBC84\uB9AC\uAE30 \uC804\uC5D0 \uB9C9\uC544\uB0B4\uB2E4\uB2C8\\n\uC774\uAC8C \uCC54\uD53C\uC5B8\uC758 \uC2E4\uB825\uC778\uAC00...[VAR 0114(000F)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB108\uD76C \uD300\uC758 \uCF64\uBE44\uB124\uC774\uC158...\\n\uD638\uD761\uC774 \uCC99\uCC99 \uB9DE\uB354\uB77C\\c\\n\uAD1C\uD788 \uB098\uAE4C\uC9C0 \uC9C8\uD22C\uAC00 \uB0A0 \uC815\uB3C4\uC600\uC5B4[VAR 0114(000F)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uCD5C\uACE0\uC758 \uACB0\uC2B9\uC804\uC774\uC5C8\uC5B4\\n\uC790, \uB458 \uB2E4 \uAC00\uC11C\\r\\n\uAD00\uAC1D\uB4E4\uC5D0 \uC131\uC6D0\uC5D0 \uBCF4\uB2F5\uD574\uC8FC\uB3C4\uB85D \uD574[VAR 0114(000F)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC774\uBC88 \uD328\uBC30\uB97C \uBC1C\uD310 \uC0BC\uC544 \uB2E4\uC74C\uC5D0\uB294 \uAF2D...!\\n\uC5B8\uC820\uAC00 \uB610 \uC2B9\uBD80\uD558\uC790\uAFB8\uB098![VAR 0114(0010)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uB728\uAC70\uC6B4 \uC5F4\uC815\uC744\\n\uB450 \uC0AC\uB78C\uC5D0\uAC8C \uBCF4\uB0B4\uB9C8!\\r\\n\uACB0\uC2B9\uC5D0\uC11C\uB3C4 \uD798\uB0B4\uAC70\uB77C![VAR 0114(0010)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uACB0\uC2B9\uC804\uC5D0 \uAC78\uB9DE\uC740\\n\uB728\uAC70\uC6B4 \uC2B9\uBD80\uC600\uB2E4\\r\\n\uCD95\uD558\uD55C\uB2E4! [VAR 0100(0000)]![VAR 0114(0010)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB108\uBB34 \uBE68\uB9AC \uB5A8\uC5B4\uC838\uC11C...\\n\uB098\uC911\uC5D0 \uB9C8\uB9AC\uD55C\uD14C \uD63C\uB098\uACA0\uAD70...[VAR 0114(0016)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uB97C \uC4F0\uC9C0 \uC54A\uC544\uC11C \uC84C\uB2E4\uACE0\uB294\\n\uBCC0\uBA85\uD558\uC9C0 \uC54A\uACA0\uC5B4\\r\\n\uADF8\uC800 \uB108\uD76C \uD300\uC774 \uAC15\uD588\uC744 \uBFD0\uC774\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC758 \uAD00\uB85D\uC744\\n\uC5EC\uC2E4\uD788 \uB290\uB084 \uC218 \uC788\uC5C8\uC5B4\\c\\n...\uAD00\uAC1D\uB4E4\uC774\\n\uB450 \uC0AC\uB78C\uC744 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC73C\uB2C8\uAE4C \uAC00\uBD10[VAR 0114(0016)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC9C4 \uB2E4\uC74C\uC5D0\uB3C4 \uBA4B\uC788\uB2E4\uC9C0\uB9CC\\n\uADF8\uB798\uB3C4 1\uD68C\uC804 \uD0C8\uB77D\uC740 \uB108\uBB34 \uAF34\uC0AC\uB0A9\uC796\uC544\\r\\n\uC774\uAC70 \uC140\uCE74\uC5D0 \uB313\uAE00\uC774 \uC5C4\uCCAD\uB098\uACA0\uC5B4...[VAR 0114(0017)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC774 \uAE08\uB791\uB2D8\uC758 \uD300\uC744 \uC774\uAE34 \uC774\uC0C1\\n\uC6B0\uC2B9\uAE4C\uC9C0 \uD574\uBC84\uB9AC\uB77C\uACE0![VAR 0114(0017)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uBA4B\uC9C4 \uC2B9\uBD80\uC600\uC5B4!\\n\uC774\uBC88\uB9CC\uD07C\uC740 \uB450 \uC0AC\uB78C\uC5D0\uAC8C\\r\\n\uCD5C\uAC15\uC758 \uC790\uB9B4 \uC591\uBCF4\uD558\uACA0\uC5B4[VAR 0114(0017)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uBD84\uD558\uC9C0\uB9CC\\n\uACC4\uC18D \uB9C8\uC74C\uC5D0 \uB2F4\uC744 \uC21C \uC5C6\uC8E0...\\c\\n\uC5EC\uB7EC\uBD84\uC758 \uAC74\uD22C\uB97C \uBE4C\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uACB0\uC2B9\uC804\uC5D0\uC11C\uB3C4\\n\uC800\uD76C \uBAAB\uAE4C\uC9C0 \uC5F4\uC2EC\uD788 \uD574\uC8FC\uC138\uC694[VAR 0114(0011)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uB450 \uBD84\uC758 \uC5F0\uACC4\uAC00\\n\uC815\uB9D0 \uD6CC\uB96D\uD588\uC2B5\uB2C8\uB2E4\\r\\n\uC6B0\uC2B9 \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC774 \uC0C8\uB85C\uC6B4 \uD1A0\uB108\uBA3C\uD2B8\uB294\\n\uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0A0\uC9C0 \uBAA8\uB974\uACA0\uB2E4\uB294 \uC810\uC774\\r\\n\uC815\uB9D0 \uD765\uBBF8\uB86D\uAD70\uC694[VAR 0114(0014)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uBABB\uD574\uB3C4 \uACB0\uC2B9\uAE4C\uC9C0\uB294\\n\uC9C4\uCD9C\uD558\uACE0 \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4\uB9CC\\c\\n\uC5EC\uB7EC\uBD84\uC758 \uC5F0\uACC4\uC5D0\\n\uAF3C\uC9DD\uC5C6\uC774 \uB2F9\uD558\uACE0 \uB9D0\uC558\uB124\uC694[VAR 0114(0014)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC774\uAE38 \uC218 \uC788\uC744 \uAC83 \uAC19\uC558\uB294\uB370 \uB9D0\uC774\uC8E0\\c\\n\uC6B0\uB9AC \uB9C8\uCFE0\uC640\uD300\uC744 \uC4F0\uB7EC\uB728\uB9AC\uACE0 \uAC70\uB454 \uC6B0\uC2B9\uC774\uB2C8\\n\uC790\uB791\uC2A4\uB7FD\uAC8C \uC0DD\uAC01\uD558\uC154\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uB108, \uB108\uBB34 \uAC15\uD574...\\n\uB2E4, \uB2E4\uC74C\uC5D0\uB3C4 \uC774\uAE38 \uC218 \uC788\uC744 \uAC70\uC57C...![VAR 0114(0012)]"
  },
  {
