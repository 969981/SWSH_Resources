  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uC544\uB4E4\uC5D0\uAC8C \uC6B0\uC2B9\uD558\uB294 \uBAA8\uC2B5\uC744\\n\uBCF4\uC5EC\uC8FC\uACE0 \uC2F6\uC5C8\uB294\uB370...\\c\\n\uB450 \uC0AC\uB78C\uC774\uB2C8\uAE4C\\n\uAE30\uAEBC\uC774 \uC591\uBCF4\uD560\uAC8C[VAR 0114(0015)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC774~\uB7F0! \uC774\uB7F0 \uC774~\uB7F0!\\n\uC5ED\uC2DC [VAR 0100(0000)]\uB2D8\uC774\uC2ED\uB2C8\uB2E4!\\c\\n\uADF8 \uD6CC\uB96D\uD55C \uC655\uC758 \uD488\uACA9\uC73C\uB85C\\n\uC815\uC810\uAE4C\uC9C0 \uC624\uB974\uC2DC\uB294 \uAC81\uB2C8\uB2E4![VAR 0114(0068)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uB108\uBB34\uB098\uB3C4 \uAC15\uB82C\uD55C \uD798\uC5D0\\n\uC2B9\uB9AC\uB97C \uC591\uBCF4\uD560 \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4!\\c\\n\uC800\uB294 \uC5EC\uB7EC\uBD84\uC758 \uC6B0\uC2B9\uC744 \uD655\uC2E0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4![VAR 0114(0068)]"
