[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC0C8\uD558\uC580 \uBAA8\uB798\uB97C \uB9CC\uC9C0\uB2E4 \uBCF4\uBA74\\n\uC9C0\uAE08\uAE4C\uC9C0\uC758 \uBAA8\uB4E0 \uB178\uB825\uC774\\r\\n\uC0C8\uD558\uC597\uAC8C \uC9C0\uC6CC\uC838 \uBC84\uB824"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAE30\uCD08 \uD3EC\uC778\uD2B8\uB97C \uC0C8\uD558\uC597\uAC8C \uB9CC\uB4E4\uC5B4\uC11C\\n\uCC98\uC74C\uBD80\uD130 \uB2E8\uB828\uC2DC\uD0A4\uACE0 \uC2F6\uC740 \uD3EC\uCF13\uBAAC\uC774 \uC788\uB2E4\uBA74\\c\\n\uAC11\uC637\uAD11\uC11D [VAR 0201(0000)]\uAC1C\uC5D0\\n\uBAA8\uB798\uC758 \uC8FC\uBB38\uC744 \uAC78\uC5B4\uC904 \uC218 \uC788\uB294\uB370, \uC5B4\uB5A0\uB2C8?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC11\uC637\uAD11\uC11D\uC774 \uBD80\uC871\uD574...\\c\\n\uAC11\uC637\uC12C\uC758 \uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uC5D0\uC11C\\n\uC5BB\uC744 \uC218 \uC788\uC73C\uB2C8\uAE4C \uBAA8\uC544\uC624\uB3C4\uB85D \uD574"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5B4\uB290 \uD3EC\uCF13\uBAAC\uC744\\n\uC0C8\uD558\uC597\uAC8C \uB9CC\uB4E4 \uAC70\uB2C8?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[VAR 0102(0000)][VAR 1900(0005)]\uB85C \uC815\uD588\uB2C8?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBAA8\uB798\uC758 \uC8FC\uBB38\uC744..."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC0C8\uD558\uC580 \uBAA8\uB798\uC5EC\\n\uC138\uCC2C \uD30C\uB3C4\uC5D0 \uD729\uC4F8\uB824\uAC00\uB4EF...\\r\\n\uBAA8\uB4E0 \uB178\uB825\uC744 \uC0C8\uD558\uC597\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uC18C\uC11C~!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0102(0000)]\uC758\\n\uAE30\uCD08 \uD3EC\uC778\uD2B8\uAC00 \uC0C8\uD558\uC597\uAC8C \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBAA8\uB4E0 \uAE30\uCD08 \uD3EC\uC778\uD2B8\uAC00\\n\uC0C8\uD558\uC580 \uC0C1\uD0DC\uAC00 \uB410\uC5B4...\\c\\n\uBAA8\uB798\uB294 \uC5B8\uC81C\uB098\\n\uB108\uD76C\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC73C\uB2C8\uAE4C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC0C8\uD558\uC597\uAC8C \uB418\uACE0 \uC2F6\uB2E4\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB9D0\uC744 \uAC78\uC5B4\uC918"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8 \uD3EC\uCF13\uBAAC\uC740\\n\uC774\uBBF8 \uC0C8\uD558\uC580 \uC0C1\uD0DC\uB77C\\r\\n\uC8FC\uBB38\uC774 \uD544\uC694 \uC5C6\uC5B4"
  }
]
