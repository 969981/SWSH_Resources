[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBC14\uC6B0\uB9C8\uC744"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC8C4\uC1A1\uD569\uB2C8\uB2E4!\\n\uC704\uC6D0\uC7A5\uB2D8\uC740 \uC9C0\uAE08 \uBC14\uC058\uC154\uC11C...\\c\\n\uC5EC\uB7EC\uBD84\uB4E4 \uBE44\uCF1C\uC8FC\uC138\uC694!\\n\uC790 \uC790 \uBE44\uCF1C\uC8FC\uC138\uC694!![VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB124~\\n\uC704\uC6D0\uC7A5\uB2D8 \uB610 \uBD10\uC694\u266A"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC557 \uC5EC\uB7EC\uBD84...\\n\uC544\uC9C1 \uB354 \uC0AC\uC778\uD574\uB4DC\uB9B4 \uC218 \uC788\uB294\uB370...\\c\\n\uC81C \uD3EC\uCF13\uBAAC\uB9AC\uADF8 \uCE74\uB4DC\uB3C4\\n\uC5EC\uB7EC\uBD84\uAED8 \uC120\uBB3C\uD574 \uB4DC\uB9B4\uAC8C\uC694![VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD32C\uBD84\uB4E4\uC758 \uC9C0\uC6D0\uC774 \uC788\uAE30\uC5D0\\n\uC6B0\uB9AC\uAC00 \uC874\uC7AC\uD558\uB294 \uAC74\uB370\\c\\n\uC774\uB807\uAC8C \uB9E4\uC815\uD558\uAC8C \uAD74\uB2E4\uB2C8...\\n\uC62C\uB9AC\uBE0C\uAD70 \uB108\uBB34 \uC5C4\uACA9\uD55C \uAC70 \uC544\uB2CC\uAC00?[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB3C\uB860 \uD32C\uBD84\uB4E4\uB3C4 \uC18C\uC911\uD558\uC8E0\\n\uC704\uC6D0\uC7A5\uB2D8\uC740 \uADF8\uB4E4\uC744 \uC704\uD574\uC11C\uB77C\uB3C4\\r\\n\uC5C5\uBB34\uC5D0 \uD798\uC368\uC8FC\uC154\uC57C \uD569\uB2C8\uB2E4...[VAR 0114(0007)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC800\uB3C4 \uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC744 \uC704\uD574\\n\uC804\uB825\uC73C\uB85C \uC5F4\uC2EC\uD788 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC74C~ \uADF8\uB7EC\uB2C8\uAE4C\\n\uB124 \uC774\uB984\uC774...[VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBE44\uD2B8\uC785\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB798! \uBE44\uD2B8\uAD70\uC774\uC5C8\uC9C0!\\n\uCC98\uC74C \uB124\uAC8C \uD3EC\uCF13\uBAAC\uC744 \uC8FC\uC5C8\uC744 \uB54C\uC5D0 \uBE44\uD558\uBA74\\r\\n\uAF64 \uD6CC\uB96D\uD558\uAC8C \uC790\uB790\uAD6C\uB098[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\uC11C \uC2B9\uB9AC\uD560 \uC790\uB294\\n\uBE44\uD2B8\uAD70 \uC790\uB124\uAC70\uB098...\\r\\n\uCC54\uD53C\uC5B8\uC774 \uCD94\uCC9C\uD55C \uD2B8\uB808\uC774\uB108\uAC00 \uB418\uACA0\uAD70[VAR 0114(0006)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uB2D8\uC5D0\uAC8C \uC120\uD0DD\uBC1B\uC740\\n\uC800\uB294 \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!\\r\\n\uADF8\uB7FC \uC2E4\uB840\uD558\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB108\uB294... [VAR 0100(0000)]\uAD70\uC774\uB85C\uAD70!\\c\\n\uB2E8\uB378\uAD70\uC774 \uC5B4\uC9F8\uC11C \uC790\uB124\uB97C \uCD94\uCC9C\uD588\uB294\uC9C0\\n\uB098\uB3C4 \uAD81\uAE08\uD558\uB358 \uCC38\uC774\uB780\uB2E4[VAR 0114(0006)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0! \uC5ED\uC2DC \uB098\uC57C\\n\uC88B\uC740 \uC0DD\uAC01\uC774 \uB5A0\uC62C\uB790\uC5B4[VAR 0114(0006)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB108\uB294 \uC9C0\uAE08\uBD80\uD130 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC778\\n\uC57C\uCCAD\uAD70\uC5D0\uAC8C \uB3C4\uC804\uD560 \uACC4\uD68D\uC774\uACA0\uC9C0?\\c\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uD68D\uB4DD\uD558\uBA74\\n\uB0B4\uAC00 \uCD95\uD558\uD574\uC8FC\uB3C4\uB85D \uD558\uB9C8!\\r\\n\uB108\uC5D0 \uB300\uD574 \uC5EC\uB7EC\uBAA8\uB85C \uC54C\uACE0 \uC2F6\uC73C\uB2C8\uAE4C \uB9D0\uC774\uC57C[VAR 0114(0006)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uB2D8\\n\uC2AC\uC2AC...[VAR 0114(0007)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uADF8\uB7FC! \uAC00\uB77C\uB974\uC758 \uBBF8\uB798\uB97C \uC704\uD574\\n\uACC4\uC18D\uD574\uC11C \uBD84\uBC1C\uD574\uB2E4\uC624![VAR 0114(0006)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC704\uC6D0\uC7A5\uB2D8\uC740 \uC774 \uB9C8\uC744\uC5D0 \uC788\uB294\\n\uC2DC\uD478\uB4DC \uB808\uC2A4\uD1A0\uB791\uC5D0 \uAC00\uC2E4 \uC608\uC815\uC785\uB2C8\uB2E4\\c\\n\uADF8\uB7EC\uB2C8 \uB2F9\uC2E0\uB3C4 \uADF8\uB54C\uAE4C\uC9C0\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uD68D\uB4DD\uD574\uC8FC\uC138\uC694[VAR 0114(0007)]"
  }
]
