  {
    "index": 25,
    "flags": 0,
    "text": "\uC5B4\uC9F8 \uC694\uC998 \uBC2D\uC758 \uC0C1\uD0DC\uAC00 \uC88B\uB2E8 \uB9D0\uC774\uC9C0\\n\uD48D\uC694\uC758 \uC655\uB2D8 \uB355\uBD84\uC774\uB824\uB098?"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC5EC\uAE30\uC11C \uB0A8\uCABD\uC73C\uB85C \uCB49 \uB0B4\uB824\uAC00\uBA74 \uC788\uB294\\n\uCEE4\uB2E4\uB780 \uB098\uBB34\uB294 \uBCF4\uC558\uB290\uB0D0?"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uBBFC\uBC15\uC5D0 \uBA38\uBB34\uB294 \uB369\uCE58 \uD070 \uC0AC\uB78C\\n\uB108\uB791 \uC544\uB294 \uC0AC\uC774\uB2C8?\\c\\n\uD070 \uC18C\uB9AC\uB85C \uC778\uC0AC\uD558\uB294 \uD1B5\uC5D0\\n\uB180\uB77C \uC790\uBE60\uC9C8 \uBED4\uD588\uC9C0 \uBB50\uB0D0!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uC9D1\uC5D0\uB3C4 \uC80A\uC740 \uBC15\uC0AC \uC591\uBC18\uC774\\n\uD648\uC2A4\uD14C\uC774 \uC911\uC774\uB780\uB2E4\\r\\n\uC0AC\uC778\uB3C4 \uBC1B\uC558\uC9C0"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC80A\uC740 \uBC15\uC0AC \uC591\uBC18\uC740\\n\uC9D1\uC5D0 \uB3CC\uC544\uAC14\uB2E8\uB2E4\\c\\n\uBA4D\uD30C\uCE58\uAC00 \uC5C6\uC5B4\uC838\uC11C\\n\uC6B0\uB9AC \uBA54\uD0D5\uC774 \uC678\uB85C\uC6B4 \uBAA8\uC591\uC774\uB354\uAD6C\uB098"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB294 \uC55E\uC73C\uB85C\uB3C4\\n\uC655\uAD00\uC124\uC6D0\uC5D0\uC11C \uC0B4\uC544\uAC08 \uAC70\uB780\uB2E4\\r\\n\uC774\uACF3\uC5D0 \uB354 \uC774\uC0C1 \uC655\uC774 \uC5C6\uB354\uB77C\uB3C4 \uB9D0\uC774\uC57C"
