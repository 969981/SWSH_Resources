  {
    "index": 18,
    "flags": 0,
    "text": "\uADF8\uB7ED\uC800\uB7ED\uC694!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC624! \uADF8\uB807\uAD6C\uB098!\\n\uADF8\uAC70 \uB2E4\uD589\uC774\uC57C! \uADF8\uC544~\uD558\uD558![VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC548\uC804\uD558\uACE0 \uC548\uC2EC\uD560 \uC218 \uC788\uB294 \uD0D0\uD5D8\uC774\\n\uC6B0\uB9AC \uD53C\uC624\uB2C8 \uD0D0\uD5D8\uB300\uC758 \uBAA8\uD1A0\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C\\n\uC870\uC2EC\uD574\uC11C \uB3CC\uC544\uC624\uB3C4\uB85D \uD558\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC9D1\uC5D0 \uB3C4\uCC29\uD558\uAE30\uAE4C\uC9C0\uAC00\\n\uD0D0\uD5D8\uC774\uB2C8\uAE4C \uB9D0\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uADF8\uC544~\uD558\uD558\uD558\uD558!![VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uD53C\uC624\uB2C8 \uB300\uC7A5\uC5D0\uAC8C\\n\uBCF4\uACE0\uD558\uB7EC \uAC00\uC790!"
