[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC790\uC804\uAC70\uB97C \uD0C0\uBA74\\n\uCD5C\uB2E8 \uB8E8\uD2B8\uB85C \uB2EC\uB9AC\uACE0 \uC2F6\uC5B4\uC9C0\uC796\uC544!\\r\\n\uADF8\uB798\uC11C \uB808\uC774\uC2A4\uB97C \uD558\uB294 \uAC70\uC57C!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC610\uB2E8\uC740 \uB300\uCCB4 \uBB50 \uD558\uB294 \uB140\uC11D\uB4E4\uC774\uC57C!?\\c\\n\uB204\uAD70\uAC00\uB97C \uC751\uC6D0\uD558\uAE30 \uC704\uD574\uC11C\\n\uB2E4\uB978 \uC0AC\uB78C\uC744 \uBC29\uD574\uD558\uB2E4\uB2C8\\r\\n\uC11C\uD3EC\uD130\uB85C\uC11C \uC218\uC900\uC774 \uB0AE\uC740 \uAC83 \uAC19\uC544"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBA40\uB9AC \uBCF4\uC774\uB294\\n\uB108\uD074\uC2DC\uD2F0\uC758 \uC2A4\uD0C0\uB514\uC6C0!\\r\\n\uB108\uB3C4 \uC800\uAE30\uC5D0\uC11C \uC2F8\uC6B0\uACA0\uAD6C\uB098"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB9DB\uC788\uB294 \uC694\uB9AC\uB97C \uB9CC\uB4DC\uB294 \uBE44\uACB0\uC740\\n\uC801\uC808\uD55C \uD654\uB825\uACFC \uB18D\uB3C4\uB97C \uC720\uC9C0\uD558\uB294 \uAC83\uC774\uC57C\\c\\n\uB0C4\uBE44 \uC704\uAC00 \uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uBA74\\n\uBC38\uB7F0\uC2A4\uAC00 \uC798 \uB9DE\uB2E4\uB294 \uB73B\uC774\uC57C!\\c\\n\uC2DC\uAC04 \uB418\uBA74 \uB0B4 \uCEA0\uD504\uC5D0\uC11C\uB3C4\\n\uC694\uB9AC\uB97C \uD574\uBCF4\uB834!"
  }
]
