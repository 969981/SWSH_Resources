[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uACFC\uC758 \uACB0\uC2B9\uC804...\\n\uCC54\uD53C\uC5B8\uB9E4\uCE58\uC785\uB2C8\uB2E4\\r\\n\uB2E8\uB378\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC774\uAE38 \uAC70\uC608\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC900\uBE44\uD560\uAC8C\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uACE0\\n\uBC30\uD2C0\uCF54\uD2B8\uB85C \uAC00\uC8FC\uC2ED\uC2DC\uC624"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB3CC\uC544\uAC08 \uC218 \uC5C6\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB0B4 \uC2DC\uD569\uC740\\n\uC5B8\uC81C\uB098 \uB9CC\uC6D0\uC744 \uC774\uB8E8\uC9C0\\c\\n\uD558\uC9C0\uB9CC \uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uC788\uB294 \uBAA8\uB450\uAC00\\n\uC774\uB807\uAC8C \uC5F4\uAD11\uC801\uC778 \uAC74 \uC774\uBC88\uC774 \uCC98\uC74C\uC774\uC57C[VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB2E4\uB4E4 3\uC77C \uC804\uC5D0 \uC788\uC5C8\uB358\\n\uB108\uC758 \uB300\uD65C\uC57D...\\c\\n\uBB34\uD55C\uB2E4\uC774\uB178\uB97C \uC7A1\uC544\uC11C\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uBBF8\uB798\uB97C\\r\\n\uC9C0\uCF1C\uB0B8 \uAC83\uC744 \uC54C \uD14C\uB2C8\uAE4C \uADF8\uB807\uACA0\uC9C0[VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\\n\uC790\uC2DC\uC548\uACFC \uC790\uB9C8\uC820\uD0C0\uC640\\r\\n\uD568\uAED8 \uC2F8\uC6B4 \uC601\uC6C5...\\c\\n\uB098\uC758 \uBB34\uD328 \uAE30\uB85D\uC744 \uC774\uC5B4\uAC00\uB294\uB370\\n\uB354\uD560 \uB098\uC704 \uC5C6\uC774 \uC88B\uC740 \uCC4C\uB9B0\uC800\uC57C![VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD638\uC624...\\n\uBB34\uD55C\uB2E4\uC774\uB178\uB3C4 \uBA64\uBC84\uC5D0 \uB4E4\uC5B4\uAC14\uAD6C\uB098\\c\\n\uCD5C\uACE0\uC758 \uCC4C\uB9B0\uC800\uC640\\n\uCD5C\uAC15\uC758 \uD3EC\uCF13\uBAAC\uC758 \uC870\uD569\\r\\n\uBC8C\uC368\uBD80\uD130 \uB450\uADFC\uAC70\uB9AC\uB294\uAC78...![VAR 0114(0004)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCD5C\uAC15\uC758 \uCC4C\uB9B0\uC800\uC758\\n\uC2E4\uB825\uC744 \uBAA8\uB450 \uB04C\uC5B4\uB0B8 \uC0C1\uD0DC\uC5D0\uC11C\\c\\n\uC555\uB3C4\uC801\uC73C\uB85C \uC4F0\uB7EC\uB728\uB824\uC57C \uBE44\uB85C\uC18C\\n\uCC54\uD53C\uC5B8\uC758 \uAC15\uD568\uC774 \uB3CB\uBCF4\uC774\uAC8C \uB418\uC9C0![VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC790 [VAR 0100(0000)]!\\c\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uC5ED\uC0AC\uC5D0 \uB0A8\uC744...\\n\uC544\uB2C8 \uAC00\uB77C\uB974\uC758 \uBBF8\uB798\uB97C \uBC14\uAFC0\\r\\n\uCD5C\uACE0\uC758 \uACB0\uC2B9\uC804\uC774 \uB420...[VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8 \uD0C0\uC784\uC744 \uC990\uACA8\uBCF4\uC790![VAR 0114(0004)]"
  }
]
