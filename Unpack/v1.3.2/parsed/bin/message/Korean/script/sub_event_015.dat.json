[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uACFC \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C \uC788\uC5B4\uC11C\\n\uC9C4\uD654\uB294 \uD558\uB098\uC758 \uACE0\uBBFC\uAC70\uB9AC\uC9C0...\\c\\n\uC9C4\uD654\uD558\uBA74 \uAC15\uD574\uC9C0\uC9C0\uB9CC\\n\uBAA8\uC2B5\uB3C4 \uBCC0\uD558\uAC8C \uB418\uB2C8\uAE4C \uB9D0\uC774\uC57C\\c\\n...\uC9C4\uD654\uC2DC\uD0A4\uC9C0 \uC54A\uACE0\\n\uAC15\uD558\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uB294 \uBC29\uBC95\uC744 \uC54C\uACE0 \uC2F6\uB2C8?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uBA38\uB098 \uADF8\uAC70 \uC544\uC27D\uB124...\\n\uC54C\uACE0 \uC2F6\uB2E4\uBA74 \uB610 \uBB3C\uC5B4\uBD10 \uC918!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBC30\uD2C0\uD558\uBA74\uC11C \uAC00\uB974\uCCD0 \uC904\uAC8C!\\n\uB808\uCE20 \uD3EC\uCF13\uBAAC \uD30C\uC774\uD2B8!!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC544\uC9C1 \uB354 \uC9C4\uD654\uD560 \uC218 \uC788\uB294\uB370\uB3C4\\n\uB808\uB3D4\uBC8C\uB808\uAC00 \uAF64 \uB2E8\uB2E8\uD558\uC9C0 \uC54A\uC558\uB2C8?\\r\\n\uBE44\uACB0\uC740 \uBC14\uB85C \uC9C4\uD654\uC758\uD718\uC11D\uC5D0 \uC788\uB2E8\uB2E4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC9C4\uD654\uD558\uAE30 \uC804\uC758 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uC9C4\uD654\uC758\uD718\uC11D\uC744 \uC9C0\uB2C8\uAC8C \uD558\uBA74\\r\\n\uBC29\uC5B4\uC640 \uD2B9\uC218\uBC29\uC5B4\uAC00 \uD30C\uC6CC\uC5C5!"
  }
]
