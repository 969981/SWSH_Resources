[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB098\uB294 \uBA5C\uB860\uC774\uB780\uB2E4\\c\\n\uBCF4\uB2E4\uC2DC\uD53C \uC5BC\uC74C\uD0C0\uC785\uC758\\n\uD3EC\uCF13\uBAAC\uC73C\uB85C \uD300\uC744 \uC774\uB8E8\uACE0 \uC788\uC9C0[VAR 0114(0015)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD55C\uB370?\\c\\n\uAD6C\uBA4D\uC5D0 \uD55C \uBC88\uB3C4 \uBE60\uC9C0\uC9C0 \uC54A\uACE0\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB2E4\uB2C8\\c\\n\uC774\uAC70 \uC815\uC2E0 \uBC14\uC9DD \uCC28\uB9AC\uC9C0 \uC54A\uC73C\uBA74\\n\uB2F9\uD560 \uC218\uB3C4 \uC788\uACA0\uC5B4[VAR 0114(0015)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5B4\uBA38! \uAD6C\uBA4D\uC5D0 \uBE60\uC838\uC11C\\n\uC5EC\uAE30\uC800\uAE30 \uC544\uD504\uC9C0 \uC54A\uB2C8?\\r\\n\uADF8\uB807\uB2E4\uACE0 \uBD10\uC8FC\uC9C0\uB294 \uC54A\uC744 \uAC70\uC9C0\uB9CC![VAR 0114(0015)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC2DC\uC791\uD574\uBCFC\uAE4C?\\c\\n\uC5BC\uB824\uC11C \uB3C4\uB9DD\uAC00\uC9C0 \uBABB\uD558\uAC8C \uD558\uACE0\\n\uADF8\uB2E4\uC74C\uC740... \uAE30\uB300\uD574\uB3C4 \uC88B\uC544\\c\\n\uADF8\uB798! \uC6B0\uB9AC\uC758 \uBC30\uD2C0 \uBC29\uC2DD\uC740\\n\uB9E4\uC6B0 \uD639\uB3C5\uD558\uB2E8\uB2E4[VAR 0114(0015)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB108...\\n\uAF64 \uD558\uB294\uAD6C\uB098!\\c\\n\uB0B4 \uD3EC\uCF13\uBAAC\uB4E4\uC774\\n\uC9C4 \uAC74 \uBB3C\uB860 \uBD84\uD558\uC9C0\uB9CC\\c\\n\uC7AC\uB2A5 \uC788\uB294 \uC80A\uC740\uC774\uB97C\\n\uB9CC\uB09C \uAE30\uC068\uB3C4 \uB9CC\uB9CC\uCE58 \uC54A\uC544[VAR 0114(0015)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC790! \uBC18\uC9DD\uBC18\uC9DD\uD55C\\n\uC5BC\uC74C\uBC30\uC9C0\uB97C \uAC00\uC838\uAC00\uB834![VAR 0114(0015)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB808\uBCA8 50\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5B8\uC820\uAC00 \uCC54\uD53C\uC5B8\uC774 \uB41C \uB108\uC5D0\uAC8C\\n\uB0B4 \uC544\uB4E4\uC774 \uB3C4\uC804\uD558\uB294 \uBAA8\uC2B5\uC744\\r\\n\uC0C1\uC0C1\uD574\uBC84\uB838\uC5B4\\c\\n\uADF8\uB54C\uB294 \uB530\uB054\uD55C \uB9DB\uC744 \uBCF4\uC5EC\uC8FC\uB3C4\uB85D \uD558\uB834![VAR 0114(0015)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8! \uCCB4\uC721\uAD00 \uAD00\uC7A5\\n\uBA5C\uB860\uB2D8\uC5D0\uAC8C \uC2B9\uB9AC\uD558\uC2E0 \uAC83\uC744\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD569\uB2C8\uB2E4!\\c\\n\uAE30\uB150\uC73C\uB85C\\n\uC774 \uAE30\uC220\uBA38\uC2E0\uC744 \uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBA5C\uB860\uB2D8\uC774 \uC785\uC5B4\uC11C\\n\uC778\uAE30 \uC788\uB294 \uC720\uB2C8\uD3FC\uB3C4 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC5BC\uC74C\uBC30\uC9C0\uAC00 \uC798 \uC5B4\uC6B8\uB9AC\uC2DC\uB124\uC694!\\n[VAR 0100(0000)]\uB2D8! \uC55E\uC73C\uB85C\uB3C4 \uD798\uB0B4\uC138\uC694!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  }
]
