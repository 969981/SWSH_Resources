[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC774~\uD788\uD788\uD79D!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC640\uC544...\\n\uD070 \uD3EC\uCF13\uBAAC\uC774\uB2E4!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uD070 \uD3EC\uCF13\uBAAC\uACFC\\n\uD568\uAED8 \uC0B4 \uC218 \uC788\uB294 \uC138\uC0C1\uC774\uB77C \uCC38 \uB2E4\uD589\uC774\uC57C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[~ 3]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "[~ 4]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC549\uC558\uC73C\uBA74 \uC77C\uC5B4\uB098\uC57C \uD558\uB4EF\uC774\\n\uC9C0\uB354\uB77C\uB3C4 \uC5B8\uC820\uAC00\uB294 \uB2E4\uC2DC \uC77C\uC5B4\uC11C\uC57C \uD558\uC9C0"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB9C8\uC784\uB9C8\uC784"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\uC740 \uC2B9\uBD80\uD558\uB294 \uAC83\uC744\\n\uB108\uBB34 \uC88B\uC544\uD574\uC11C \uC6C3\uACE0 \uC788\uB294 \uAC70\uC57C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB294 \uAD49\uC7A5\uD574!\\n\uC138\uACC4\uB97C \uBB34\uB300\uB85C \uC2F8\uC6B0\uB2C8\uAE4C \uB9D0\uC774\uC57C!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB85C\uC988\uB2D8\uC740 \uD68C\uC0AC\uC758 \uD798\uC73C\uB85C\\n\uC61B\uB0A0\uC758 \uAC70\uB9AC \uBAA8\uC2B5\uC744 \uC0B4\uB9AC\uBA74\uC11C\\r\\n\uC774\uACF3\uC744 \uAD00\uAD11 \uB3C4\uC2DC\uB85C \uD0C8\uBC14\uAFC8\uC2DC\uCF30\uC5B4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB85C\uC988\uB2D8\uC740 \uD68C\uC0AC\uB97C\\n\uBA87 \uAC1C\uB098 \uAC00\uC9C0\uACE0 \uC788\uC5C8\uB354\uB77C?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB9C8\uC784\uB9E8 \uB9C8\uC774\uBBF8\uB294\\n\uC815\uB9D0 \uAD49\uC7A5\uD574!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC11C\uD3EC\uD130\uB77C\uB294 \uAC74 \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C\\n\uD479 \uBE60\uC9C8 \uC218 \uC788\uB294 \uBA4B\uC9C4 \uC0AC\uB78C\uC744 \uB9D0\uD558\uB294 \uAC78\uAE4C?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC751\uC6D0\uD558\uB294\\n\uD2B8\uB808\uC774\uB108\uAC00 \uC9C0\uBA74\\r\\n\uC790\uAE30 \uC77C\uCC98\uB7FC \uC544\uC26C\uC6CC\uD558\uB294 \uAC83\\c\\n\uC790\uC2E0\uACFC\uB294 \uC0C1\uAD00\uC5C6\uB294 \uC77C\uC774\uB354\uB77C\uB3C4\\n\uADF8\uB7F4 \uC218 \uC788\uB294 \uC0AC\uB78C\uC774 \uBC14\uB85C \uC11C\uD3EC\uD130\uC57C"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD30C\uC774\uB9AC \uB54C\uBD80\uD130 \uD0A4\uC6B0\uBA74\\n\uB354 \uAC15\uD55C \uC720\uB300\uAC10\uC744 \uD615\uC131\uD560 \uC218 \uC788\uC5B4"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB098\uB3C4 \uB9AC\uC790\uBABD\uC744 \uB370\uB9AC\uACE0\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uB098\uAC08 \uAC70\uC57C!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC5EC\uBCF4\uC138\uC694? \uC2A4\uD0C0\uB514\uC6C0 \uD2F0\uCF13\uC744\\n\uAD6C\uD588\uC73C\uB2C8\uAE4C \uBE68\uB9AC \uC640!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uD615\uC81C\uC5D0\uAC8C \uD718\uB458\uB824 \uC0AC\uB294 \uB0B4\uAC00\\n\uD3EC\uCF13\uBAAC\uC744 6\uB9C8\uB9AC\uB098 \uD0A4\uC6B0\uB294 \uAC74\\r\\n\uC870\uAE08 \uBB34\uB9AC\uB77C\uACE0 \uC0DD\uAC01\uD574"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB098\uB294 \uB300\uC5EC\uB974\uB97C \uD749\uB0B4 \uB0B4\uB294 \uC911\uC774\uC57C!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB098\uB3C4 \uB300\uC5EC\uB974\uB97C \uD749\uB0B4 \uB0B4\uB294 \uC911\uC774\uC57C!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB098\uB294 \uB2E8\uB378\uAD70\uC774\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uC5D4\uD2B8\uB9AC\uD558\uB358\\r\\n\uC2DC\uC808\uBD80\uD130 \uCB49 \uD32C\uC774\uC5C8\uC5B4!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC61B\uB0A0\uBD80\uD130 \uC88B\uC544\uD588\uC5B4! \uB77C\uB358\uAC00\\n\uC5F4\uC2EC\uD788 \uBCF4\uACE0 \uC788\uC5B4! \uAC19\uC740 \uC774\uC57C\uAE30\uB294\\r\\n\uD32C\uC774\uB77C\uB294 \uC5B4\uD544\uB85C\uB294 \uBCC4\uB85C\uC778 \uAC83 \uAC19\uC544"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uC5D0 \uB9C8\uB9AC\uD55C\uD14C\\n\uC0AC\uC778\uC744 \uBC1B\uC558\uC5B4! \uB0B4 \uBCF4\uBB3C\uB85C \uC0BC\uC744 \uAC70\uC57C!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uAD00\uB78C\uCC28 \uC9C4\uC9DC \uD06C\uC9C0?\\n\uBCC4\uBA85\uC774 \uAC00\uB77C\uB974\uC758 \uC9C0\uC625\uC758\uBC14\uD034\uC57C!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC5B8\uB2C8\uB294 \uB9E8\uB0A0 \uAC70\uC9D3\uB9D0\uB9CC \uD574"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB2E4\uB9AC\uB77C\uB294 \uAC83\uC740\\n\uC11C\uB85C \uB2E4\uB978 \uAC83\uC744 \uC774\uC5B4\uC8FC\uB294\\r\\n\uC6B0\uC815\uC758 \uC0C1\uC9D5\uC774\uAE30\uB3C4 \uD558\uB2E8\uB2E4"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD55C \uC2DC\uD569\uC744 \uBCF4\uACE0 \uB098\uBA74\\n\uC628\uBAB8\uC5D0 \uC5D0\uB108\uC9C0\uAC00 \uC19F\uAD6C\uCE58\uB294 \uAC83 \uAC19\uC544!\\c\\n\uADF8\uB7F0 \uC2DC\uD569\uC744 \uD560 \uC218 \uC788\uB294\\n\uD2B8\uB808\uC774\uB108\uB294 \uC815\uB9D0 \uC874\uACBD\uC2A4\uB7EC\uC6CC!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD638\uD154\uC5D0\uC11C \uC77C\uD558\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\n\uC2DC\uD569\uC5D0\uC11C \uC2F8\uC6B0\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\r\\n\uC5B4\uB518\uAC00 \uC57C\uBB34\uC9C0\uAC8C \uC0DD\uAE34 \uAC83 \uAC19\uC544..."
  },
  {
    "index": 31,
    "flags": 0,
    "text": "[~ 31]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB9C8\uD788\uC774\uC774\uC789!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774 \uD638\uD154\uAE4C\uC9C0\\n\uB370\uB824\uB2E4\uC8FC\uC5C8\uB2E8\uB2E4"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB9CC\uB9C8\uB4DC\uB85C\uAD70\\n\uC5EC\uB7EC \uBA85\uC774 \uD0C0\uB3C4 \uB044\uB5A1\uC5C6\uB2E4\uB2C8!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC9C1\uC5C5\uB3C4 \uC9D1\uB3C4 \uBC14\uAFC0 \uC218 \uC788\uC9C0\uB9CC\\c\\n\uC88B\uC544\uD558\uB294 \uC120\uC218\uC640\\n\uC88B\uC544\uD558\uB294 \uD3EC\uCF13\uBAAC\uC740 \uBC14\uAFC0 \uC218 \uC5C6\uC5B4"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uAC00\uB514!\\n\uC2A4\uD0C0\uB514\uC6C0\uAE4C\uC9C0 \uACBD\uC8FC\uD560\uB798?"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uAE08\uB791\uB2D8\uC774\uB77C\uBA74\\n\uC6B0\uC120 \uBAA8\uB798\uBC14\uB78C\uC774\uC9C0!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uB0A0\uC528\uB97C \uBC14\uAFB8\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uBE60\uB978 \uD3EC\uCF13\uBAAC\uC73C\uB85C \uC4F0\uB7EC\uB728\uB9B4 \uAC70\uC57C!"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC640\uC639!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "[~ 40]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uADF8\uB798 \uB9DE\uC544! \uB0B4 \uAC00\uB514\uAC00\\n\uC0B4\uC774 \uC3D9 \uBE60\uC838\uBC84\uB9B0 \uAC70 \uC788\uC9C0!"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC29B\uC2DC\uD2F0 \uC77C\uC8FC \uB9C8\uB77C\uD1A4\uC740\\n\uCE7C\uB85C\uB9AC\uAC00 \uAF64 \uC18C\uBAA8\uB41C\uB2E8\uB2E4"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uAF43\uC758 \uC544\uB984\uB2E4\uC6C0\uC744 \uC81C\uB300\uB85C\\n\uC54C\uAE30 \uC704\uD574 \uCCAD\uC18C\uD558\uB294 \uC911\uC774\uB780\uB2E4"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8 \uD53C\uD06C\uB2C9!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uC2DC\uD569\uC774 \uB420\uAE4C? \uD558\uACE0\\n\uB450\uADFC\uAC70\uB9AC\uBA74\uC11C \uB2E4\uB9AC\uB97C \uAC74\uB11C\uB2E4\uAC00\\c\\n\uBA4B\uC9C4 \uC2DC\uD569\uC774\uC5C8\uC5B4! \uD558\uACE0\\n\uCF69\uB2E5\uAC70\uB9AC\uBA74\uC11C \uB2E4\uB9AC\uB97C \uAC74\uB110 \uAC70\uC57C"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB294 \uADF8\uB0E5 \uAC78\uC5B4\uC11C\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uAC00\uC9C0\uB9CC...\\c\\n\uC120\uC218\uB4E4\uC740 \uC774\uACA8\uC57C\uB9CC\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uAC08 \uC218 \uC788\uB294 \uAC70\uAD6C\uB098"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uC29B\uC2A4\uD0C0\uB514\uC6C0\uC740\\n\uC548\uC5D0 \uC9D1\uC774 \uBA87 \uAC1C\uB098 \uB4E4\uC5B4\uAC08\uAE4C!?"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC77C\uC5B4\uB098\uAE30 \uC804\uAE4C\uC9C0 \uB0A0\uC528\uB97C \uC54C \uC218 \uC5C6\uB4EF\\n\uB05D\uB098\uAE30 \uC804\uAE4C\uC9C0\uB294 \uC2B9\uD328\uB97C \uC54C \uC218 \uC5C6\uC5B4"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC804 \uC138\uACC4\uC758 \uBAA8\uB4E0 \uC0AC\uB78C\uC774\\n\uAC19\uC740 \uC2DC\uD569\uC744 \uBCF4\uB294 \uAC70\uC57C\\c\\n\uADF8\uB7EC\uBA74 \uC804 \uC138\uACC4\uC758 \uBAA8\uB4E0 \uC0AC\uB78C\uACFC\\n\uAC19\uC740 \uC2DC\uD569\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30 \uD560 \uC218 \uC788\uC9C0"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uBA4B\uC9C4 \uBA85\uC2B9\uBD80\uB294\\n\uBAA8\uB450\uC758 \uAE30\uC5B5\uC5D0 \uB0A8\uAC8C \uB418\uC9C0!"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uAD00\uB3D9\uC758 \uC0AC\uB78C\uB4E4\uACFC\\n\uAC00\uB77C\uB974\uC758 \uC0AC\uB78C\uB4E4\uC740 \uC904\uC744 \uC798 \uC11C\uB294 \uAC83 \uAC19\uC544"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uACF5\uC2DD \uAD7F\uC988\uC785\uB2C8\uB2E4~!\\n\uB9AC\uADF8 \uCE74\uB4DC\uB3C4 \uC788\uC2B5\uB2C8\uB2E4~!"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uB9AC\uADF8 \uCE74\uB4DC...\\n\uB808\uC5B4\uAC00 \uAC16\uACE0 \uC2F6\uC740\uB370 \uB2E4 \uD314\uB838\uC5B4!"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uC624\uB298\uC740 \uC2DC\uD569\uD558\uAE30\\n\uB531 \uC88B\uC740 \uB0A0\uC774\uC57C!\\c\\n\uC5B4\uB5A4 \uB0A0\uC528\uB77C\uB3C4\\n\uAC19\uC740 \uB9D0\uC744 \uD560 \uAC70\uACE0 \uC560\uCD08\uC5D0\\r\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0\uB294 \uC9C0\uBD95\uC774 \uC788\uC9C0\uB9CC \uB9D0\uC774\uC57C"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC6A9 \uACFC\uC790\\n\uD3EC\uCF13\uBAAC\uC6A9 \uB4DC\uB9C1\uD06C\uB294 \uC5B4\uB5A0\uC2E0\uAC00\uC694?"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uAE4C\uC9C0\uB294 \uBAA9\uC774 \uC548 \uB9D0\uB790\uB294\uB370\\n\uC96C\uC2A4\uB97C \uBCF4\uB2C8\uAE4C \uBAA9\uC774 \uB9D0\uB77C"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uC120\uC218\uB4E4\uC740 \uC815\uB9D0 \uAD49\uC7A5\uD55C \uAC83 \uAC19\uC544\\c\\n\uC218\uB9CC \uBA85\uC758 \uD32C\uB4E4 \uC55E\uC5D0\uC11C\\n\uC2E4\uC218\uB97C \uD574\uB3C4 \uB2F9\uD669\uD558\uC9C0 \uC54A\uACE0 \uC2F8\uC6B8 \uC218 \uC788\uB294...\\r\\n\uAC15\uD55C \uC815\uC2E0\uC774 \uD544\uC694\uD558\uB2C8\uAE4C \uB9D0\uC774\uC57C"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uD3C9\uBC94\uD55C \uBC25\uC744 \uBA39\uC5B4\uB3C4\\n\uC990\uAC70\uC6B4 \uC0AC\uB78C\uC774 \uC88B\uC740 \uAC70\uB798"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uBC16\uC5D0 \uC788\uB294 \uAC00\uAC8C\uC5D0\uC11C \uC0B0 \uC74C\uC2DD\uC774\\n\uD3C9\uC18C\uBCF4\uB2E4 \uB9DB\uC788\uAC8C \uB290\uAEF4\uC9C0\uB294 \uAC74\\c\\n\uBE44\uC77C\uC0C1\uC774\uB77C\uB294\\n\uD5A5\uC2E0\uB8CC \uB355\uBD84\uC774\uB77C\uACE0 \uC0DD\uAC01\uD574"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uC610\uB2E8\uC758 \uD300\uC6CC\uD06C\uB97C\\n\uBCF4\uC5EC\uC8FC\uACA0\uC5B4!"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB3C4 \uC2DC\uD569\uC774 \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\uAE4C\\n\uBBFC\uD3D0\uB97C \uB07C\uCE58\uC9C0\uB294 \uC54A\uC744 \uAC70\uC57C!"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "[~ 62]"
  },
  {
    "index": 63,
    "flags": 0,
