[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB9E4\uADF8\uB180\uB9AC\uC544\uBC15\uC0AC\uB2D8\uC774\uC57C\\n\uD765\uBBF8\uB85C\uC6B4 \uC790\uB8CC\uB4E4\uBFD0\uC774\uB85C\uAD70![VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC648\uC648\uC648\uC648\uC648!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC624\uB298\uC740 \uBB50\uD558\uB7EC \uC628 \uAC70\uC57C \uB2E8\uB378?\\c\\n\uBCF8 \uC801 \uC5C6\uB294 \uCD5C\uAC15\uC758\\n\uD3EC\uCF13\uBAAC\uC744 \uAC00\uB974\uCCD0\uB2EC\uB77C\uB4E0\uAC00 \uD558\uB294\\r\\n\uC5C9\uB6B1\uD55C \uC9C8\uBB38\uC740 \uC0AC\uC808\uC774\uC57C[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC548\uB155 \uBA4D\uD30C\uCE58\\n\uB9E4\uBC88 \uC548\uB0B4\uD574\uC918\uC11C \uACE0\uB9D9\uB2E4![VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uC6B0\uB9AC\uB97C \uB9C8\uC911 \uB098\uC640\uC900 \uAC74\\n\uBA4D\uD30C\uCE58\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC774\uC57C!\\c\\n\uB0B4\uAC00 \uAE38\uC744 \uC783\uC5B4\uBC84\uB9B4 \uB54C\uB9C8\uB2E4\\n\uBA87 \uBC88\uC774\uACE0 \uB3C4\uC640\uC92C\uC5B4\\c\\n\uCC38\uACE0\uB85C \uD2B8\uB808\uC774\uB108\uB294 \uC18C\uB2C8\uC544!\\n\uADF8\uB140\uAC00 \uB9CC\uB4E0 \uC694\uB9AC\uB294\\r\\n\uC7AC\uBE68\uB9AC \uBA39\uC744 \uC218 \uC788\uC5B4\uC11C \uC88B\uC544[VAR 0114(0004)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC815\uB9D0! \uC608\uC804\uC5D0 \uD568\uAED8 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\\n\uB3C4\uC804\uD55C \uC0AC\uC774\uB77C\uACE0\\r\\n\uB108\uBB34 \uB9C9 \uC18C\uAC1C\uD558\uB294 \uAC70 \uC544\uB2C8\uC57C?\\c\\n\uADF8\uB9AC\uACE0 \uBA4D\uD30C\uCE58\uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uB098\uB3C4 \uB108\uB97C \uB3C4\uC640\uC92C\uC5C8\uC796\uC544[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC! \uB098\uB294 \uC18C\uB2C8\uC544\\n\uBC15\uC0AC\uB2D8\uC758 \uC870\uC218\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC774\uCABD\uC740 [VAR 0100(0000)]\\c\\n\uC2E0\uC778 \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uC57C\\n\uC18C\uB2C8\uC544! \uADF8\uB7FC \uC5B4\uB4DC\uBC14\uC774\uC2A4\uB97C \uBD80\uD0C1\uD560\uAC8C![VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD558\uC544... \uC0AC\uB78C\uC744 \uB300\uCCB4 \uBB58\uB85C \uBCF4\uB294 \uAC70\uC57C?\\n\uC800\uB807\uAC8C \uC81C\uBA4B\uB300\uB85C\uB2C8\uAE4C \uAE38\uC744 \uC783\uC5B4\uBC84\uB9AC\uC9C0...[VAR 0114(000B)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC624! \uB108\uB3C4\\n\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uB97C \uAC00\uC9C0\uACE0 \uC788\uAD6C\uB098?[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD5E4\uC774 \uB85C\uD1A0\uBB34![VAR 0114(000B)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uCF00\uD14C~!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34 \uC815\uB9D0 \uD3B8\uB9AC\uD558\uC9C0 \uC54A\uB2C8?\\n\uB9F5\uB3C4 \uB0B4\uBE44\uAC8C\uC774\uC158\uB3C4 \uB418\uC5B4\uC8FC\uB2C8\uAE4C \uB9D0\uC774\uC57C\\c\\n\uB2E8\uB378\uCC98\uB7FC \uC5EC\uC804\uD788 \uAE38\uCE58\uC778 \uC0AC\uB78C\uB3C4 \uC788\uC9C0\uB9CC...[VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uB108\\n\uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574\uC11C\uB294 \uC798 \uC544\uB2C8?[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB124!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBCC4\uB85C\uC694..."
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC624 \uADF8\uB798? \uADF8\uB807\uB2E4\uBA74\\n[VAR FF00(0001)]\uD3EC\uCF13\uBAAC \uB3C4\uAC10[VAR FF00(0000)]\uC744 \uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uB85C\\r\\n\uC0AC\uC6A9\uD560 \uC218 \uC788\uAC8C \uD574\uC904\uAC8C![VAR 0114(000B)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uAC71\uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB3FC!\\n[VAR FF00(0001)]\uD3EC\uCF13\uBAAC \uB3C4\uAC10[VAR FF00(0000)]\uC744 \uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uB85C\\r\\n\uC0AC\uC6A9\uD560 \uC218 \uC788\uAC8C \uD574\uC904 \uD14C\uB2C8\uAE4C![VAR 0114(000B)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR FF00(0008)]\uD3EC\uCF13\uBAAC \uB3C4\uAC10[VAR FF00(0000)]\uC744 \uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uCC38\uACE0\uB85C \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC740\\n\uC6B0\uB9AC \uD560\uBA38\uB2C8\uAC00 \uC8FC\uB294\\r\\n\uC120\uBB3C\uC774\uC57C![VAR 0114(000B)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uBC1B\uC558\uB2E4\uACE0\\n\uD560\uBA38\uB2C8\uC5D0\uAC8C \uB9D0\uD558\uB294 \uAC83\uB3C4 \uC78A\uC9C0 \uB9C8\\c\\n\uD560\uBA38\uB2C8\uB124 \uC9D1\uC740\\n2\uBC88\uB3C4\uB85C\uB97C \uC9C0\uB098\uBA74 \uC788\uC5B4[VAR 0114(000B)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB2E8\uB378\uC740 \uC5B4\uC5FF\uD55C \uCC54\uD53C\uC5B8\uC778\uB370\\n\uB098\uB294... \uADF8\uB0E5 \uC870\uC218...\\r\\n\uADF8\uAC83\uB3C4 \uC790\uCE6D \uC870\uC218\uB77C\uB2C8...\\r\\n\uBB54\uAC00 \uB2F5\uB2F5\uD55C \uAE30\uBD84\uC774\uC57C[VAR 0114(000B)]"
  },
