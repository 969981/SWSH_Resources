[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2D8\\n\uB3C4\uC804\uD558\uC2E4 \uAC74\uAC00\uC694?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC8E0!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uBA74 \uD0C8\uC758\uC2E4\uC5D0\uC11C\\n\uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uC5B4 \uC8FC\uC138\uC694\\c\\n\uBBF8\uC158\uC774\uB77C\uAE30\uBCF4\uB2E4\uB294\\n\uB2F9\uC2E0\uC758 \uC790\uC9C8\uC744 \uC2DC\uD5D8\uD560\\r\\n\uC911\uC694\uD55C \uC2DC\uD5D8\uC774\uB2C8\uAE4C\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC720\uB2C8\uD3FC\uC774 \uC798 \uC5B4\uC6B8\uB9AC\uC2DC\uB124\uC694\\n\uADF8\uB7FC \uCC28\uBD84\uD558\uAC8C \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B4\uBA38\uB098\\n\uADF8\uAC70 \uC544\uC27D\uAD70\uC694"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBBF8\uC158\uC774\uB77C\uB294 \uC774\uB984\uC758\\n\uC2DC\uD5D8\uC744 \uC990\uACA8\uC8FC\uC138\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD3EC\uD50C\uB7EC\uB2D8\uC5D0\uAC8C\uC11C\\n\uAE30\uC220\uBA38\uC2E0\uC744 \uBC1B\uC73C\uC168\uAD70\uC694\\c\\n\uB2E4\uC74C \uCCB4\uC721\uAD00\uC740\\n\uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744\uC5D0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD398\uC5B4\uB9AC\uBC30\uC9C0\uAC00 \uC798 \uC5B4\uC6B8\uB9AC\uB124\uC694\\n[VAR 0100(0000)]\uB2D8 \uC55E\uC73C\uB85C\uB3C4 \uD798\uB0B4\uC138\uC694!"
  }
]
