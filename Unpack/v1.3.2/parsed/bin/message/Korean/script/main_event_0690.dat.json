[
  {
    "index": 0,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uAD70!\\n\uC57D\uC18D\uB300\uB85C \uB108\uC758 \uC2B9\uB9AC\uB97C \uCD95\uD558\uD558\uC790\uAFB8\uB098![VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uB77C?\\n\uB108\uB3C4 \uCD08\uB300\uBC1B\uC740 \uAC70\uC57C?[VAR 0114(000B)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB458\uC774 \uC11C\uB85C \uC544\uB294 \uC0AC\uC774\uC778\uAC00 \uBCF4\uC8E0?\\n\uADF8\uAC70 \uC798 \uB410\uAD70\uC694! \uC790 \uC790 \uC5B4\uC11C \uC549\uC73C\uC138\uC694[VAR 0114(0006)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBC14\uC6B0\uB9C8\uC744\uC740 \uD574\uC0B0\uBB3C\uC758 \uB9C8\uC744\\c\\n\uC5ED\uC2DC \uC74C\uC2DD\uC740 \uD604\uC9C0\uC5D0\uC11C \uC7A1\uC740 \uAC78\\n\uBA39\uC5B4\uC57C \uC81C\uB9DB\uC774\uC8E0?\\r\\n\uADF8\uB798\uC11C \uADF8\uB7F0\uC9C0 \uBAA8\uB4E0 \uBA54\uB274\uAC00 \uB9DB\uC788\uB2F5\uB2C8\uB2E4[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uB9E4\uADF8\uB180\uB9AC\uC544\uBC15\uC0AC\uB2D8\uC740\\n\uAC74\uAC15\uD558\uAC8C \uC9C0\uB0B4\uACE0 \uACC4\uC2DC\uB098\uC694?[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBC15\uC0AC\uB2D8\uAED8\uB294 \uC2E0\uC138 \uB9CE\uC774 \uC84C\uC2B5\uB2C8\uB2E4\\c\\n\uC18C\uC6D0\uC758\uBCC4\uC5D0 \uB2F4\uAE34 \uD30C\uC6CC\uB85C\\n\uD3EC\uCF13\uBAAC\uC744 \uAC70\uB300\uD558\uAC8C \uB9CC\uB4DC\uB294\\r\\n\uB2E4\uC774\uB9E5\uC2A4 \uBC34\uB4DC\uB97C \uB9CC\uB4E4 \uC218 \uC788\uB358 \uAC83\uB3C4\\r\\n\uADF8\uBD84\uC758 \uC5F0\uAD6C \uB355\uBD84\uC774\uC5C8\uC8E0[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD558\uC544... \uBC15\uC0AC\uB2D8\uAED8\uC11C\uB294 \uB2E4\uC774\uB9E5\uC2A4\uB294\\n\uC544\uC9C1 \uBD88\uBD84\uBA85\uD55C \uC810\uC774 \uB9CE\uC544\uC11C\\r\\n\uBD88\uC548\uD55C \uBD80\uBD84\uB3C4 \uC788\uB2E4\uACE0 \uB9D0\uC500\uD558\uC168\uC5C8\uC5B4\uC694[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC81C\uAC00 \uC5EC\uD589\uC744 \uB5A0\uB098\uB824\uACE0 \uD560 \uB54C\uB3C4\\n\uD30C\uC6CC\uC2A4\uD3FF\uD0D0\uC0C9\uBA38\uC2E0\uAE4C\uC9C0\\r\\n\uB4E4\uACE0 \uAC00\uAC8C \uD560 \uC815\uB3C4\uC600\uC73C\uB2C8\uAE4C\uC694...[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD30C\uC6CC\uC2A4\uD3FF\uD0D0\uC0C9\uBA38\uC2E0!\\c\\n\uADF8 \uC7A5\uCE58 \uB355\uBD84\uC5D0 \uD30C\uC6CC\uC2A4\uD3FF...\\n\uAC00\uB77C\uB974\uD30C\uD2F0\uD074\uC774 \uBC1C\uC0DD\uD574\uC11C\\r\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uC7A5\uC18C\uB3C4\\r\\n\uC54C\uC544\uB0BC \uC218 \uC788\uC5C8\uC8E0![VAR 0114(0006)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uB9E4\uADF8\uB180\uB9AC\uC544\uBC15\uC0AC\uB2D8\uC774\\n\uBD88\uC548\uC744 \uB290\uB07C\uC2E0\uB2E4\uB294 \uAC74 \uC88B\uC9C0 \uC54A\uAD70\uC694\\c\\n\uC81C\uAC00 \uBB54\uAC00 \uD560 \uC218 \uC788\uB294 \uC77C\uC774 \uC5C6\uC744\uC9C0...[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC18C\uB2C8\uC544\uAD70 \uB108\uD074\uC2DC\uD2F0\uC5D0 \uC788\uB294\\n\uBCF4\uBB3C\uACE0\uC5D0 \uAC00\uBCF4\uC2DC\uB294 \uAC74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\\c\\n\uC800\uB294 \uC5ED\uC0AC \uC18D\uC5D0\uC11C\\n\uB2E4\uC774\uB9E5\uC2A4\uC758 \uBE44\uBC00\uC744 \uD480\uC5B4\uB0BC\\r\\n\uC5F4\uC1E0\uAC00 \uC788\uC73C\uB9AC\uB77C \uC0DD\uAC01\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4[VAR 0114(0006)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4\\n\uACAC\uD559\uD558\uC2E4 \uC218 \uC788\uAC8C \uC900\uBE44\uD574\uB450\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0007)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "...\uADF8\uAC74 \uADF8\uB807\uACE0 \uC704\uC6D0\uC7A5\uB2D8\\n\uC2AC\uC2AC \uAC00\uC2E4 \uC2DC\uAC04\uC785\uB2C8\uB2E4[VAR 0114(0007)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5E5~? \uC544\uC9C1 [VAR 0100(0000)]\uAD70\uC758\\n\uC774\uC57C\uAE30\uB97C \uB4E3\uC9C0 \uBABB\uD588\uB294\uB370...\\c\\n\uD6C4\uC6B0 \uC544\uC27D\uC9C0\uB9CC \uC5B4\uCA54 \uC218 \uC5C6\uAD70\uC694\\n\uD574\uC57C \uD560 \uC77C\uC740 \uBC14\uB85C\uBC14\uB85C \uD574\uC57C \uD558\uB2C8\uAE4C\uC694!\\r\\n\uADF8\uB7FC \uC5EC\uB7EC\uBD84! \uAC74\uD22C\uB97C \uBE4C\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0006)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD558\uC544...\\n\uCE5C\uC808\uD55C \uAC74\uC9C0 \uC544\uB2CC\uC9C0 \uC54C \uC218\uAC00 \uC5C6\uB124...\\c\\n\uD655\uC2E4\uD788 \uC804\uC124\uC744 \uC870\uC0AC\uD558\uB294\uB370\\n\uBCF4\uBB3C\uACE0\uB9CC \uD55C \uACF3\uB3C4 \uC5C6\uC9C0\uB9CC...[VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBB3C\uBC30\uC9C0\uB97C \uBC1B\uC558\uAD6C\uB098\\n\uC57C\uCCAD\uC744 \uC774\uAE30\uB2E4\uB2C8 \uB300\uB2E8\uD558\uB124\\r\\n\uC0C1\uC73C\uB85C \uAE30\uC220\uBA38\uC2E0\uC744 \uC904\uAC8C![VAR 0114(000B)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC57C\uCCAD\uC740 \uB0B4 \uCE5C\uAD6C\uC57C\\n\uC628 \uAE40\uC5D0 \uC7A0\uAE50 \uB9CC\uB098\uB7EC \uAC00\uBD10\uC57C\uACA0\uB2E4\\c\\n\uADF8\uB7FC \uB610 \uBCF4\uC790 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800![VAR 0114(000B)]"
  }
]
