[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD130\uD504\uB9C8\uC744 \uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC758\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC740~!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC6B0\uB974\uB4E4\uC744!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC74\uB108\uD3B8\uC5D0 \uC788\uB294 \uAC74\uCD08\uB354\uBBF8...\\n\uC774\uB984\uD558\uC5EC \uAC74\uCD08\uB864\uAE4C\uC9C0 \uBAB0\uC544\uB123\uAE30\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCC38\uACE0\uB85C\\n\uC800\uB294 \uB2E8\uC815\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4\\c\\n\uC2EC\uD310\uACFC \uC2DC\uD569 \uACB0\uACFC\uC758\\n\uBCF4\uACE0\uB97C \uB2F4\uB2F9\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB7FC! \uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2A4\uD0C0\uD2B8!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBBF8\uC158\uC774 \uBB50\uC600\uC8E0?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCD9C\uBC1C\uD558\uC2DC\uC8E0!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC6B0\uB974\uB97C \uBAB0\uC544\uC11C\\n\uAC74\uCD08 \uC55E\uC5D0 \uBAA8\uC544\uC8FC\uC138\uC694!\\c\\n\uADF8\uB7EC\uBA74 \uC6B0\uB974\uB4E4\uC774\\n\uAC74\uCD08\uB354\uBBF8\uB97C \uB0A0\uB824\uBC84\uB824\uC11C\\r\\n\uB2E4\uC74C \uB2E8\uACC4\uB85C \uB118\uC5B4\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uBA74 \uCC98\uC74C\uBD80\uD130\\n\uB2E4\uC2DC \uD558\uAC8C \uB429\uB2C8\uB2E4\uB9CC\\r\\n\uC815\uB9D0 \uAE30\uAD8C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8!\\n\uCCB4\uC721\uAD00 \uBBF8\uC158 \uD074\uB9AC\uC5B4\uB97C\\r\\n\uCD95\uD558\uD569\uB2C8\uB2E4~!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC774\uC81C \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC544\uD0AC\uB2D8\uACFC\uC758\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB9CC\uC774 \uB0A8\uC558\uAD70\uC694!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD480\uBC30\uC9C0\uB97C \uBCFC \uB54C\uB9C8\uB2E4 \uC544\uD0AC\uB2D8\uACFC\uC758\\n\uC2DC\uD569\uC744 \uB5A0\uC62C\uB824\uC8FC\uC138\uC694!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2A4\uD0C0\uD2B8!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uD074\uB9AC\uC5B4!!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCCAB \uBC88\uC9F8 \uAC74\uCD08\uB864 \uB3CC\uD30C!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB450 \uBC88\uC9F8 \uAC74\uCD08\uB864 \uB3CC\uD30C! \uB0A8\uC740 \uAC74\uCD08\uB864\uC740\\n\uC55E\uC73C\uB85C 2\uAC1C! \uC774\uC81C \uC808\uBC18 \uB0A8\uC558\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC544\uB2C8!? \uD2B8\uB808\uC774\uB108\uB97C \uC774\uACBC\uB354\uB2C8\\n\uBA4D\uD30C\uCE58\uB3C4 \uAC00\uB9CC\uD788 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD569\uB2C8\uB2E4! \uC138 \uBC88\uC9F8 \uB3CC\uD30C!\\n\uB0A8\uC740 \uAC74\uCD08\uB864\uC740 \uC55E\uC73C\uB85C \uD558\uB098!"
  }
]
