  {
    "index": 47,
    "flags": 0,
    "text": "\uC58C\uB0E0..."
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC73C\uC751? \uD0D0\uB9AC\uC2A4\uAC00 \uBC94\uC778?[VAR 0114(006D)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC74C\uB0D0~?"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uC557! \uC9C4\uC9DC\uB2E4!\\n\uC785\uAC00\uC5D0 \uACFC\uC999\uC774 \uBB3B\uC5B4 \uC788\uC5B4!"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uC5B4\uBA38 \uC815\uB9D0\uC774\uB124?\\n\uACFC\uC999\uC774 \uC794\uB729 \uBB3B\uC5B4 \uC788\uC5B4"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uC74C... \uC774\uAC74 \uBA39\uC5C8\uAD70 \uBA39\uC5C8\uC5B4\\n...\uB098\uBB34\uC5F4\uB9E4\uB97C \uBA39\uC740 \uAC8C \uD655\uC2E4\uD574"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uC58C\uB0E0"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uC5EC...[VAR 0114(006D)]"
  },
  {
    "index": 55,
