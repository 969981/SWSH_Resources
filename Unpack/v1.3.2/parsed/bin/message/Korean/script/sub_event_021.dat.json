    "flags": 0,
    "text": "\uC5E5~! \uB0B4\uAC00 \uBC94\uC778\uC778 \uAC70\uC57C?"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC544\uB2C8\uC57C \uC544\uB2C8\uC57C!\\n\uC880 \uB354 \uC798 \uC0DD\uAC01\uD574\uBD10!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uD734... \uAE5C\uC9DD \uB180\uB790\uC796\uC544!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uCC60\uD478~?"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC774 \uC544\uC774\uAC00 \uBC94\uC778\uC778 \uAC78\uAE4C?"
