    "flags": 0,
    "text": "\uC774\uBD10\uC694! \uAC70\uAE30 \uC11C\uC694~!"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uD558\uD558\uD558!\\n\uC774\uAC70 \uB098\uB3C4 \uCAD3\uC544\uAC00 \uBD10\uC57C\uACA0\uAD6C\uBA3C"
  },
  {
