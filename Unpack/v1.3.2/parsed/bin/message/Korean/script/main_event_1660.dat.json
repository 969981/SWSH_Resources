    "index": 0,
    "flags": 0,
    "text": "\uB2E8\uB378\uAD70\\n\uC774\uBBF8 \uBC31\uBC88\uC740 \uB354 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB098\\c\\n\uADF8\uB7F0\uB370\uB3C4 \uC774\uD574\uD574\uC8FC\uC9C0 \uC54A\uB294 \uAC74\uAC00...\\n\uCC54\uD53C\uC5B8\uC529\uC774\uB098 \uB418\uB294 \uC790\uAC00...[VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uB9D0\uC500\uC774\uC2E0\uC9C0 \uC774\uD574\uB294 \uD569\uB2C8\uB2E4\uB9CC...[VAR 0114(0004)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "1000\uB144 \uB4A4\uC5D0 \uC788\uC744 \uBB38\uC81C\uB97C\\n\uC9C0\uAE08 \uBC14\uB85C \uD574\uACB0\uD558\uB824\uACE0\\c\\n\uB0B4\uC77C \uC788\uC744 \uD1A0\uB108\uBA3C\uD2B8\uB97C\\n\uC911\uC9C0\uD574\uC57C \uD55C\uB2E4\uB294 \uAC83\uC740 \uC774\uD574\uAC00 \uAC00\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!\\r\\n\uADF8\uC800 \uB2E8 \uD558\uB8E8\uC77C \uBFD0\uC778\uB370 \uBB50\uAC00 \uBB38\uC81C\uC778 \uAC70\uC8E0?[VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC73C\uB85C\uC11C\uC758 \uCC45\uC784\uAC10 \uB54C\uBB38\uC5D0\uB77C\uB3C4\\n\uBC18\uB4DC\uC2DC \uC2DC\uD569\uC740 \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uB2E4!\\c\\n\uAC00\uB77C\uB974\uC5D0 \uC0AC\uB294 \uBAA8\uB450\uAC00 \uAE30\uB300\uD558\uACE0 \uC788\uC73C\uB2C8\uAE4C\uC694!\\n\uC800\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uAD6C\uC694[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uD574\uD558\uC9C0 \uBABB\uD588\uC5B4...\\n\uD558\uB098\uB3C4 \uC774\uD574\uD558\uC9C0 \uBABB\uD588\uC5B4![VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC800 \uB4DC\uB113\uAC8C \uD3BC\uCCD0\uC9C4\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC744 \uBCF4\uAC8C\uB098 \uB2E8\uB378\uAD70\\c\\n\uC774\uB9CC\uD07C\uC758 \uBE5B\uC744\\n\uC720\uC9C0\uD558\uAE30 \uC704\uD55C \uC5D0\uB108\uC9C0\uB3C4\\r\\n1000\uB144 \uB4A4\uC5D0\uB294 \uC0AC\uB77C\uC9C0\uACE0 \uC5C6\uC744 \uAC83\uC774\uB124!\\c\\n\uAC00\uB77C\uB974\uC5D0 \uC0AC\uB294 \uC0AC\uB78C\uB4E4 \uBAA8\uB450\\n\uADF8\uB54C\uB294 \uC0B4\uC544\uB0A8\uC744 \uC218 \uC5C6\uC744 \uAC70\uB780 \uB9D0\uC774\uB124![VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uBA74 \uB2E8 \uD558\uB8E8\uC5D0 \uBD88\uACFC\uD558\uB354\uB77C\uB3C4\\n\uD55C\uC2DC\uB77C\uB3C4 \uBE68\uB9AC!\\r\\n\uBB38\uC81C\uB97C \uD574\uACB0\uD558\uAE30 \uC704\uD574 \uC6C0\uC9C1\uC5EC\uC57C \uD55C\uB2E4\uB124!\\r\\n\uBCF4\uB2E4 \uB098\uC740 \uBBF8\uB798\uB97C \uB9CC\uB4E4\uAE30 \uC704\uD574\uC11C \uB9D0\uC774\uC57C![VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "1000\uB144 \uB4A4...!?\\c\\n\uC704\uC6D0\uC7A5\uB2D8\uC774 \uBB34\uC5C7\uC744 \uAC71\uC815\uD558\uC2DC\uB294\uC9C0\uB294\\n\uC5B4\uB290 \uC815\uB3C4 \uC774\uD574\uD588\uC2B5\uB2C8\uB2E4\\c\\n\uB0B4\uC77C \uACB0\uC2B9\uC804\uC774 \uB05D\uB098\uBA74\\n\uC800\uB3C4 \uC704\uC6D0\uC7A5\uB2D8\uC744 \uB3D5\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0004)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "...\uD615\\c\\n\uC2DC\uAC04\uC774 \uB3FC\uB3C4 \uC624\uC9C0 \uC54A\uAE38\uB798\\n\uAC71\uC815\uC774 \uB3FC\uC11C...\\c\\n\uB450\uC1A1\uB2D8\uC774\uB791 \uB9C8\uB9AC\uB791 \uC610\uB2E8\uC774\\n\uB3C4\uC640\uC918\uC11C \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC5B4[VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB108\uB97C \uBD88\uC548\uD558\uAC8C \uB9CC\uB4E0 \uAC83\uC740\\n\uC9C4\uC2EC\uC73C\uB85C \uC0AC\uACFC\uD558\uB9C8 \uD638\uBE0C\\c\\n\uC5B4\uB978\uB4E4\uC740 \uB9D0\uC774\uC9C0 \uC790\uC874\uC2EC \uB54C\uBB38\uC5D0\\n\uC9C4\uC194\uD558\uAC8C \uC774\uC57C\uAE30\uD558\uAE30\uAC00 \uD798\uB4E0 \uC874\uC7AC\uB780\uB2E4[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD638\uBE0C, [VAR 0100(0000)]\\n\uD638\uD154\uC5D0 \uAC00\uBA74 \uBA39\uACE0 \uC2F6\uC740 \uAC70 \uB2E4 \uBA39\uC790\\r\\n\uB0B4\uAC00 \uB2E4 \uC0AC\uC904 \uD14C\uB2C8\uAE4C![VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\\n\uB0B4\uC77C \uC2DC\uD569\uC744 \uC9C0\uCF1C\uBD10 \uC8FC\uC138\uC694!\\r\\n\uAC00\uB77C\uB974\uC758 \uC5ED\uC0AC\uC5D0 \uB0A8\uC744 \uD14C\uB2C8\uAE4C\uC694![VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uC5ED\uC0AC\uC5D0 \uB0A8\uB294\uB2E4\uB77C...\\c\\n\uC544\uC9C1 \uBB34\uB974\uAD70 \uCC54\uD53C\uC5B8...\\n\uAC00\uB77C\uB974\uC758 \uC5ED\uC0AC\uB294 \uBC14\uB014 \uAC83\uC774\uB124!\\r\\n\uC774 \uB098\uC758 \uC190\uC5D0 \uC758\uD574\uC11C \uB9D0\uC774\uC9C0![VAR 0114(0006)]"
  }
