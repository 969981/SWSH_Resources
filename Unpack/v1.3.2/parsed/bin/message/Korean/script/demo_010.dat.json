    "text": "[~ 0]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5EC\uB7EC\uBD84!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC2A4\uD130\uC758 \uC138\uACC4\uC5D0\\n\uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC774\uACF3 \uAC00\uB77C\uB974\uC9C0\uBC29\uC740\\n\uD48D\uC694\uB85C\uC6B4 \uC790\uC5F0\uACFC \uC544\uB984\uB2E4\uC6B4 \uB9C8\uC744"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC218\uB9CE\uC740 \uD3EC\uCF13\uBAAC\uACFC\\n\uD568\uAED8 \uC9C0\uB0B4\uB294 \uBA4B\uC9C4 \uACF3\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC544\uC2DC\uB2E4\uC2DC\uD53C \uC6B0\uB9AC\uB294\\n\uD3EC\uCF13\uBAAC\uC2A4\uD130! \uC904\uC5EC\uC11C"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774\uB77C \uBD88\uB9AC\uB294 \uC2E0\uBE44\uD55C \uC0DD\uBA85\uCCB4\uC640\\n\uD798\uC744 \uD569\uCCD0 \uC0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uB4E4\uC740 \uBC14\uB2E4\uB098 \uD558\uB298\\n\uADF8\uB9AC\uACE0 \uB9C8\uC744\uC744 \uBE44\uB86F\uD55C \uB3C4\uCC98\uC5D0 \uC0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uD3EC\uCF13\uBAAC\uC744 \uC131\uC7A5\uC2DC\uD0A4\uACE0\\n\uC2F8\uC6B0\uAC8C \uD558\uC5EC \uACBD\uC7C1\uD558\uB294 \uC0AC\uB78C\uB4E4\uC744"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB77C\uACE0 \uBD80\uB985\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC624! \uC778\uC0AC\uAC00 \uB2A6\uC5C8\uAD70\uC694\\n\uC800\uB294 \uB85C\uC988\uB77C\uACE0 \uD569\uB2C8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB7FC \uAC00\uB77C\uB974\uC9C0\uBC29\\n\uCD5C\uAC15\uC758 \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108..."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8 \uB2E8\uB378\uC758 \uBC30\uD2C0\uC744\\n\uC5EC\uB7EC\uBD84\uAED8 \uBCF4\uC5EC\uB4DC\uB9AC\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4!!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB2E8\uB378! \uC2DC\uBC94 \uACBD\uAE30\uB77C\uC9C0\uB9CC\\n\uB108\uC758 \uBB34\uD328 \uD589\uC9C4\uC744 \uB05D\uB0B4\uC8FC\uACA0\uC5B4!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uC2DC\uD569\uC774\uB4E0 \uB09C \uC9C0\uC9C0 \uC54A\uC544!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB9AC\uC790\uBABD! \uB2E4\uC774\uB9E5\uC2A4\uB2E4!!"
  }
]
