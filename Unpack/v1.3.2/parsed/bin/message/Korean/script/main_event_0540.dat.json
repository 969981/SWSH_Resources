[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC774\uCABD\uC73C\uB85C \uC9C0\uB098\uAC00\uB824\uB294 \uAC81\uB2C8\uAE4C?\\c\\n\uCDA9\uACE0\uD574\uB450\uACA0\uB294\uB370\\n\uD3EC\uAE30\uD558\uB294 \uAC8C \uC88B\uC744 \uAC81\uB2C8\uB2E4\\c\\n\uC18C\uC6D0\uC758\uBCC4\uC744 \uAC00\uC9C4 \uD2B8\uB808\uC774\uB108\uB294\\n\uC81C\uAC00 \uB530\uB054\uD55C \uB9DB\uC744 \uBCF4\uC5EC\uC904 \uAC70\uB2C8\uAE4C\uC694![VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "...\uB2F9\uC2E0\\c\\n\uCC54\uD53C\uC5B8\uC5D0\uAC8C \uCD94\uCC9C\uBC1B\uC740\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC600\uB358\uAC00\uC694?[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC2DC\uC2DC\uD558\uB124\uC694\\c\\n\uADF8\uAC70 \uC544\uC138\uC694? \uCC54\uD53C\uC5B8\uBCF4\uB2E4\uB3C4\\n\uB9AC\uADF8 \uC704\uC6D0\uC7A5\uC774 \uB354 \uB300\uB2E8\uD55C \uC0AC\uB78C\uC774\uC8E0?\\c\\n\uB2E4\uC2DC \uB9D0\uD574 \uC704\uC6D0\uC7A5\uB2D8\uC5D0\uAC8C \uC120\uD0DD\uBC1B\uC740\\n\uC81C\uAC00 \uB354 \uB300\uB2E8\uD558\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC \uBD88\uC30D\uD55C \uB2F9\uC2E0\uC5D0\uAC8C\\n\uC800\uC758 \uAC15\uD568\uC744 \uBCF4\uC5EC\uB4DC\uB9AC\uC8E0[VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "...\uD638\uC624 \uC774\uAC70 \uB180\uB78D\uAD70\uC694\\n\uC870\uAE08\uC740 \uD558\uB294 \uBAA8\uC591\uC774\uB124\uC694[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD558\uC9C0\uB9CC \uB2F9\uC2E0\uC758 \uBC30\uD2C0 \uBC29\uC2DD\uC740\\n\uB611\uB611\uD788 \uAE30\uC5B5\uD574 \uB450\uC5C8\uC73C\uB2C8\uAE4C\\r\\n\uC2E4\uC81C \uC2DC\uD569\uC5D0\uC11C\uB294 \uC81C\uAC00 \uC774\uAE38 \uAC81\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC2E4\uB840\uD558\uB3C4\uB85D \uD558\uC8E0\\c\\n\uC5EC\uAE30\uC5D0\uC11C \uBAA8\uC744 \uC218 \uC788\uB294 \uC18C\uC6D0\uC758\uBCC4\uC740\\n\uBAA8\uB450 \uC190\uC5D0 \uB123\uC5C8\uC73C\uB2C8\uAE4C\uC694"
  }
]
