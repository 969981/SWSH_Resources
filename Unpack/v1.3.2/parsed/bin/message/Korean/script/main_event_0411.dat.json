    "index": 0,
    "flags": 0,
    "text": "\uC790 \uD6CC\uB96D\uD558\uAC8C \uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uB97C\\n\uB3CC\uD30C\uD55C \uD2B8\uB808\uC774\uB108\uC5EC!\\c\\n\uC5D4\uC9C4\uC2DC\uD2F0\uC5D0 \uC628\\n\uBAA9\uC801\uC740 \uAE30\uC5B5\uD558\uACE0 \uC788\uACA0\uC9C0?[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC694"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBB50\uC600\uB354\uB77C...?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB798 \uB9DE\uC544!\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC758 \uAC1C\uD68C\uC2DD \uB54C\uBB38\uC774\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBABB \uB9D0\uB824...\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC758 \uAC1C\uD68C\uC2DD \uB54C\uBB38\uC774\uC5C8\uC796\uC544[VAR 0114(000B)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uCC38\uACE0\uB85C \uB0B4\uC77C \uC788\uC744 \uAC1C\uD68C\uC2DD\uC774\\n\uC5F4\uB9AC\uB294 \uACF3\uC740 \uC5D4\uC9C4\uC2A4\uD0C0\uB514\uC6C0\uC774\uC57C[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uAC00\uB824\uBA74\\n\uC800\uCABD\uC5D0 \uC788\uB294 \uC2B9\uAC15\uAE30\uB97C \uD0C0\uBA74 \uB3FC[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790! \uB098\uB294 \uBAA8\uCC98\uB7FC \uC628 \uAE40\uC5D0\\n\uBD80\uD2F0\uD06C \uAC19\uC740 \uACF3\uC5D0 \uB4E4\uB97C \uC0DD\uAC01\uC774\uC57C\\c\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uAC00\uC11C\\n\uC811\uC218\uD558\uB294 \uAC70 \uC78A\uC73C\uBA74 \uC548 \uB41C\uB2E4![VAR 0114(000B)]"
  }
]
