[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBD80\uC6B0\uBD80\uB294 \uC4F4\uB9DB\uC744 \uC88B\uC544\uD558\uC9C0\uB9CC\\n\uB098\uB294 \uB2E8\uB9DB\uC744 \uC88B\uC544\uD55C\uB2E8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBD80\uC6B0\uBD80\uC6B0~"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB0B4 \uCE5C\uAD6C... \uC21C\uBB34\uB2D8\uC744 \uB108\uBB34 \uC88B\uC544\uD574\uC11C\\n\uB9AC\uADF8 \uCE74\uB4DC\uB97C \uBAA8\uC73C\uACE0 \uC788\uC5B4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC21C\uBB34 \uC120\uC218\uB294 \uC815\uB9D0 \uAD49\uC7A5\uD574!\\c\\n\uC6B0\uB9AC \uC544\uBE60\uBCF4\uB2E4\uB3C4\\n\uB098\uC774\uAC00 \uB9CE\uC740\uB370\\r\\n\uD314\uD314\uD55C \uD604\uC5ED\uC73C\uB85C \uB6F0\uACE0 \uC788\uB2E4\uACE0!\\c\\n\uB0B4\uAC00 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD560 \uB54C\uB3C4\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC168\uC73C\uBA74 \uC88B\uACA0\uB2E4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC6B0\uC640\uC624!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB07C \uB07C\uB07C!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC624\uB298\uC758 \uCEE4\uD53C\uB294 \uB9DB\uC774 \uC88B\uB124\\n\uC11C\uD3EC\uD2B8\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774 \uC798\uD558\uB098 \uBD10"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\uC758 \uB9DD\uD1A0...\\n\uC2A4\uD3F0\uC11C\uAC00 \uC794\uB729 \uC788\uC5B4\uC11C \uBA4B\uC9C0\uAE34 \uD55C\uB370\\r\\n\uC13C\uC2A4\uB294 \uC870\uAE08 \uC560\uB9E4\uD574 \uBCF4\uC774\uC9C0 \uC54A\uC544?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\uC11C \uD65C\uC57D\uD558\uBA74\\n\uAC00\uB77C\uB974\uC758 \uC2A4\uD0C0\uAC00 \uB420 \uC218 \uC788\uC5B4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD06C\uB9AC\uD06C\uB8FD~"
  }
]
