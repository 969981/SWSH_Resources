    "index": 0,
    "flags": 0,
    "text": "\uBE0C\uB798\uC2DC\uB9C8\uC744 \uC5EC\uB7EC\uBD84!\\n\uCC54\uD53C\uC5B8 \uB2E8\uB378\uC785\uB2C8\uB2E4\\c\\n\uC5EC\uB7EC\uBD84\uC744 \uC704\uD574\uC11C \uC55E\uC73C\uB85C\uB3C4\\n\uCD5C\uACE0\uC758 \uC2B9\uBD80\uB97C \uBCF4\uC5EC\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0004)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uBB34\uC801\uC758 \uCC54\uD53C\uC5B8!\\n\uB108\uC640 \uB9AC\uC790\uBABD\uC740 \uC815\uB9D0 \uCD5C\uACE0\uC57C!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4!\\c\\n\uC5EC\uB7EC\uBD84\uB3C4 \uD3EC\uCF13\uBAAC\uC744 \uD0A4\uC6CC\uC11C\\n\uC2B9\uBD80\uB97C \uB9CE\uC774 \uC990\uACA8\uC8FC\uC138\uC694!\\c\\n\uADF8\uB9AC\uACE0 \uCC54\uD53C\uC5B8\uC778\\n\uC81C\uAC8C \uB3C4\uC804\uD574\uC8FC\uC138\uC694![VAR 0114(0004)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB124~! \uC800\uD76C\uB3C4\\n\uB2E8\uB378\uB2D8\uC744 \uB3D9\uACBD\uD574\uC11C\\r\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD558\uACE0 \uC788\uC5B4\uC694!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB798\uB3C4 \uCC54\uD53C\uC5B8\uC758 \uB9AC\uC790\uBABD\uC740\\n\uB108\uBB34 \uAC15\uD55C \uAC83 \uAC19\uC544!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD655\uC2E4\uD788 \uC81C \uB9AC\uC790\uBABD\uC740 \uAC15\uD569\uB2C8\uB2E4!\\n\uB2E4\uB978 \uD3EC\uCF13\uBAAC\uB4E4\uB3C4 \uAC15\uD558\uC8E0!\\c\\n\uADF8\uB807\uAE30\uC5D0 \uC800\uB294 \uCD5C\uAC15\uC758\\n\uCC4C\uB9B0\uC800\uC640 \uC2F8\uC6B0\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4![VAR 0114(0004)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC81C \uC18C\uC6D0\uC740\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\\r\\n\uBAA8\uB450\uAC00 \uAC15\uD574\uC9C0\uB294 \uAC83\uC774\uB2C8\uAE4C\uC694![VAR 0114(0004)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB9AC\uC790\uC544!!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD615~![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD638\uBE0C![VAR 0114(0004)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC138\uACC4 \uC81C\uC77C\uC758 \uCC54\uD53C\uC5B8 \uD32C\uC774\\n\uC774\uB807\uAC8C \uC9C1\uC811 \uB9C8\uC911\uC744 \uB098\uC640\uC8FC\uB2E4\uB2C8![VAR 0114(0004)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774\uC57C! \uB108 \uD0A4\uAC00 \uCEF8\uAD6C\uB098!\\n\uC5B4\uB514 \uBCF4\uC790... \uC815\uD655\uD788 3cm![VAR 0114(0004)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC815\uB2F5! \uC5ED\uC2DC \uD615\uC774\uC57C\\n\uBB34\uC801\uC774\uB77C \uBD88\uB9B4 \uB9CC\uD55C \uAD00\uCC30\uB825\uC774\uB124![VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB208\uB3D9\uC790\uC758 \uC0C9\uC744 \uBCF4\uC544\uD558\uB2C8...\\c\\n\uC54C\uC558\uB2E4!\\n\uB124\uAC00 [VAR 0100(0000)]\uC778\uAC00 \uBCF4\uAD6C\uB098!\\r\\n\uB3D9\uC0DD\uC5D0\uAC8C \uC598\uAE30\uB294 \uB9CE\uC774 \uB4E4\uC5C8\uC5B4[VAR 0114(0004)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB098\uB294 \uAC00\uB77C\uB974\uC9C0\uBC29 \uCD5C\uAC15\uC774\uC790\\n\uB9AC\uC790\uBABD \uC560\uD638\uAC00\uC778\\r\\n\uD3EC\uCF13\uBAAC \uCC54\uD53C\uC5B8\\r\\n\uC774\uB984\uD558\uC5EC \uBB34\uC801\uC758 \uB2E8\uB378\uC774\uC57C![VAR 0114(0004)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD615! [VAR 0100(0000)]!\\n\uC9D1\uAE4C\uC9C0 \uACBD\uC8FC\uD558\uC790![VAR 0114(0005)]"
