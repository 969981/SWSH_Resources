[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD639\uC2DC \uB108\\n\uAC11\uC637\uC12C\uC740 \uCC98\uC74C\uC774\uB2C8?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB098\uB294 \uC774 \uC12C\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uC758 \uC0DD\uD0DC\uB97C \uC5F0\uAD6C\uD558\uACE0 \uC788\uC5B4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC774 \uC12C\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uB4F1\uB85D\uD560 \uC218 \uC788\uAC8C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB108\uC758 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744\\n\uC5C5\uB370\uC774\uD2B8\uD574\uC904\uAC8C!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\\n\uC5C5\uB370\uC774\uD2B8 \uC911...\\c\\n...... ...... ......\\n...... ...... ......"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC5D0\\n\uAC11\uC637\uC12C\uB3C4\uAC10 \uD56D\uBAA9\uC774\\r\\n\uCD94\uAC00\uB418\uC5C8\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC73C\uBA74 \uB0B4\uAC8C \uBCF4\uC5EC\uC918"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uB3C4\uAC10\uC744\\n\uBCF4\uC5EC\uC904 \uAC70\uB2C8?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC644\uC131\uD55C \uAC11\uC637\uC12C\uB3C4\uAC10\uC744\\n\uB610 \uBCF4\uC5EC\uC904 \uAC70\uB2C8?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC544~ \uADF8\uAC70 \uC544\uC27D\uB124"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD6C4\uD6C4 \uADF8\uB7FC\\n\uB0B4\uAC8C \uBCF4\uC5EC\uC918"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uB3C4\uAC10\uC758\\n\uD604\uC7AC \uC0C1\uD0DC\uB294..."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBC1C\uACAC\uD55C \uD3EC\uCF13\uBAAC [VAR 0202(0000)]!\\n\uC7A1\uC740 \uD3EC\uCF13\uBAAC [VAR 0202(0001)]!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD6C4\uD6C4 \uAC11\uC637\uC12C\uB3C4\uAC10\uC744\\n\uC5C5\uB370\uC774\uD2B8\uD55C \uC9C0 \uC5BC\uB9C8 \uC548 \uB410\uAD6C\uB098!\\c\\n\uC9C0\uAE08\uBD80\uD130\uAC00 \uBAA8\uD5D8\uC758 \uC2DC\uC791\uC774\uC57C!\\n\uC5F4\uC2EC\uD788 \uD558\uB834!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD6C4\uD6C4! \uC544\uC9C1 \uBBF8\uC219\uD558\uC9C0\uB9CC\\n\uC5F4\uC2EC\uD788 \uD558\uACE0 \uC788\uAD6C\uB098!\\c\\n\uD480\uC232\uC774 \uBD80\uC2A4\uB7ED\uAC70\uB9AC\uBA74\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC774 \uB098\uC62C \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C!\\r\\n\uB9CE\uC774 \uB9CE\uC774 \uC870\uC0AC\uD574\uBCF4\uB834!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC5B4\uBA38, 30\uB9C8\uB9AC \uC774\uC0C1 \uC7A1\uC558\uB2E4\uB2C8!?\\n\uB108\uC5D0\uAC90 \uC18C\uC9C8\uC774 \uC788\uAD6C\uB098!\\c\\n\uBB3C\uB860 \uD3EC\uCF13\uBAAC\uC744 \uCC29\uC2E4\uD788 \uD0A4\uC6CC\uC11C\\n\uC9C4\uD654\uC2DC\uD0A4\uACE0 \uC788\uACA0\uC9C0?\\r\\n\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uC794\uB729 \uCC44\uC6CC \uBD10!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 50\uB9C8\uB9AC\uB098 \uC7A1\uC740 \uAC70\uC57C!?\\n\uB300\uB2E8\uD558\uB2E4!\\c\\n\uC774, \uC774 \uC815\uB3C4\uBA74 \uC804\uCCB4\uC758\\n4\uBD84\uC758 1\uC740 \uB118\uC740 \uAC83 \uAC19\uC740\uB370...?\\c\\n\uC9C0\uAE08\uBCF4\uB2E4\uB3C4 \uC5F4\uC2EC\uD788\\n\uAC11\uC637\uC12C\uC744 \uB3CC\uC544\uB2E4\uB140 \uBCF4\uB834!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC774\uB7F4 \uC218\uAC00! \uB10C \uC815\uB9D0 \uB300\uB2E8\uD55C \uC778\uC7AC\uAD6C\uB098!\\n100\uB9C8\uB9AC \uC774\uC0C1 \uC7A1\uB294 \uAC83\uB3C4 \uAFC8\uC774 \uC544\uB2C8\uACA0\uC5B4!\\c\\n\uC774 \uC815\uB3C4 \uC778\uC7AC\uB77C\uBA74 \uB2F9\uC5F0\uD788\\n\uD3EC\uCF13\uBAAC\uAD74\uB3C4 \uC870\uC0AC\uD558\uACE0 \uC788\uACA0\uC9C0?\\r\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB0A0 \uC218 \uC788\uC73C\uB2C8\uAE4C \uB9D0\uC774\uC57C"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC640\uC6B0! \uAFC8\uC5D0 \uADF8\uB9AC\uB358\\n100\uB9C8\uB9AC \uC774\uC0C1 \uD3EC\uD68D\uC744 \uB2EC\uC131\uD558\uB2E4\uB2C8!\\c\\n\uC5EC\uC815\uC758 \uC808\uBC18\uCBE4\uC740\\n\uB3C4\uB2EC\uD55C \uAC83 \uAC19\uC740\uB370!?\\c\\n\uB124 \uB355\uBD84\uC5D0\\n\uC21C\uC870\uB86D\uAC8C \uC5F0\uAD6C\uD558\uACE0 \uC788\uC5B4!\\r\\n\uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "...... ...... ......\\n...... ...... ......\\c\\n\uC557! \uBBF8\uC548!\\n\uBE48\uCE78\uC774 \uAC70\uC758 \uC5C6\uB294 \uB3C4\uAC10\uC744 \uBD24\uB354\uB2C8\\r\\n\uB098\uB3C4 \uBAA8\uB974\uAC8C \uB10B\uC774 \uB098\uAC14\uC5C8\uC5B4\\c\\n\uB108~ \uC774\uB7EC\uB2E4 \uC815\uB9D0\uB85C\\n\uB3C4\uAC10\uC744 \uC644\uC131\uD574\uBC84\uB9AC\uB294 \uAC70 \uC544\uB2C8\uC57C?\\c\\n\uB0A0\uC528\uC5D0 \uB530\uB77C \uCD9C\uD604\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774\\n\uB2E4\uB974\uB2E4\uB294 \uAC83\uB3C4 \uC544\uB294 \uAC83 \uAC19\uACE0 \uB9D0\uC774\uC57C"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB098 \uC774\uB807\uAC8C\uAE4C\uC9C0 \uC644\uC131\uB41C\\n\uAC11\uC637\uC12C\uB3C4\uAC10\uC740\\r\\n\uC9C0\uAE08\uAECF \uBCF8 \uC801\uC774 \uC5C6\uC5B4!\\c\\n\uB9E4\uC9C0\uCEEC \uAD50\uD658\uC740\\n\uC81C\uB300\uB85C \uD65C\uC6A9\uD558\uACE0 \uC788\uB2C8?\\c\\n\uB204\uAD70\uAC00\uC640 \uD611\uB825\uD558\uBA74 \uC5BB\uAE30 \uD798\uB4E0 \uD3EC\uCF13\uBAAC\uC744\\n\uBAA8\uC73C\uB294 \uB370 \uB3C4\uC6C0\uC774 \uB420 \uAC70\uC57C"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC640\uC544! \uC870\uAE08\uB9CC \uB354! \uC870\uAE08\uB9CC \uB354!\\n\uAC11\uC637\uC12C\uB3C4\uAC10 \uC644\uC131\uAE4C\uC9C0\\r\\n\uC5BC\uB9C8 \uC548 \uB0A8\uC558\uC5B4!\\c\\n\uC774 \uC815\uB3C4\uBA74 \uB0B4 \uC5B4\uB4DC\uBC14\uC774\uC2A4\uB294\\n\uB354 \uD544\uC694 \uC5C6\uACA0\uC5B4!\\c\\n\uB108\uB77C\uBA74 \uD574\uB0BC \uC218 \uC788\uC744 \uD14C\uB2C8\uAE4C\\n\uBBFF\uACE0 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uCD95\uD558\uD574!\\n\uB4DC\uB514\uC5B4... \uB4DC\uB514\uC5B4...!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uB3C4\uAC10\\n\uC644\uC131\uC774\uC57C!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB108\uC758 \uB178\uACE0 \uB355\uBD84\uC5D0\\n\uD3EC\uCF13\uBAAC \uC5F0\uAD6C\uB97C \uCC29\uCC29 \uC9C4\uD589\uD560 \uC218 \uC788\uC5C8\uC5B4"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB108\uC5D0\uAC8C \uBD80\uD0C1\uD558\uAE38\\n\uC815\uB9D0 \uC798\uD55C \uAC83 \uAC19\uC544!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB108\uC758 \uD6CC\uB96D\uD55C \uACF5\uC801\uC744\\n\uAE30\uB9AC\uB294 \uB73B\uC5D0\uC11C\\r\\n\uB9AC\uADF8 \uCE74\uB4DC\uC5D0 \uD45C\uC2DD\uC744 \uBD99\uC5EC\uC904\uAC8C!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC790, \uB410\uB2E4!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uCD5C\uACE0\uB85C \uD589\uBCF5\uD55C\\n\uB0B4 \uB9C8\uC74C\uB3C4...\\r\\n\uAC19\uC774 \uBC1B\uC544\uC92C\uC73C\uBA74 \uC88B\uACA0\uC5B4"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC774\uAC74 \uC544\uBB34\uB098 \uD560 \uC218 \uC788\uB294 \uC77C\uC774 \uC544\uB2C8\uC57C!\\n\uC815\uB9D0 \uCD95\uD558\uD574!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uBA87 \uBC88\uC744 \uBD10\uB3C4\\n\uD6CC\uB96D\uD55C \uAC11\uC637\uC12C\uB3C4\uAC10\uC774\uC57C\\r\\n\uC815\uB9D0 \uCD95\uD558\uD574!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uADF8 \uD3EC\uCF13\uBAAC\uC740..."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB098\uC05C\uC6D0\uC22D\uC774\uD3EC\uCF13\uBAAC\\n\uC790\uB8E8\uB3C4!?"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uAC11\uC637\uC12C\uC740 \uACE0\uC0AC\uD558\uACE0\\n\uAC00\uB77C\uB974\uC9C0\uBC29 \uC5B4\uB514\uC5D0\uB3C4 \uC5C6\uB294 \uD3EC\uCF13\uBAAC\uC774\uC57C"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC790\uB8E8\uB3C4\uB97C \uB9CC\uB098\uAC8C \uD574\uC900 \uBCF4\uB2F5\uC774\uC57C\\n\uC774\uAC78 \uBC1B\uC544\uC918"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC218\uB9CE\uC740 \uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB09C\\n\uC18C\uB144\uC758 \uBAA8\uC790\uC57C\\r\\n\uB108\uC640 \uC798 \uC5B4\uC6B8\uB9B4 \uAC83 \uAC19\uC544\uC11C \uB9D0\uC774\uC57C"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR 01C2(0001)] \uB514\uC790\uC778\uC758\\r\\n[VAR FF00(0008)][VAR 01C1(0002)][VAR FF00(0000)][VAR 1900(0002)]\\r\\n\uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  }
]
