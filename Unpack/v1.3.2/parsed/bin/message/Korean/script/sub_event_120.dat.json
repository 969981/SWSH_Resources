[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC74C?\\n\uB0B4\uAC8C \uC6A9\uAC74\uC774 \uC788\uB2C8?\\r\\n...\uC73C\uC74C~\\c\\n\uCC54\uD53C\uC5B8\uC774 \uB420 \uC815\uB3C4\uB85C\\n\uAC15\uD574\uC9C0\uBA74 \uB2E4\uC2DC \uC624\uB834[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC624 \uCC54\uD53C\uC5B8\uC774 \uB41C \uAC70\uC57C?\\n\uADF8\uAC70 \uC815\uB9D0 \uAD49\uC7A5\uD55C\uB370![VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB0B4 \uC774\uB984\uC740 \uBAA8\uB9AC\uBAA8\uD1A0\\c\\n\uB108\uCC98\uB7FC \uAC15\uD55C \uD2B8\uB808\uC774\uB108\uB97C\\n\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC2E4\uB825\uC5D0 \uC790\uC2E0\uC774 \uC788\uB2E4\uBA74\\n\uB098\uC640 \uC2B9\uBD80\uD574\uBCF4\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB798?\\n\uADF8\uAC70 \uC544\uC27D\uAD6C\uB098"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC74C? \uAC74\uAC15\uD55C \uD3EC\uCF13\uBAAC\uC774\\n2\uB9C8\uB9AC\uB294 \uC788\uC5B4\uC57C \uC2F8\uC6B8 \uC218 \uC788\uC5B4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC88B\uC558\uC5B4!\\n\uADF8\uB7FC \uC790\uADF9\uC801\uC778 \uC2B9\uBD80\uB97C \uBCF4\uC5EC\uC904\uAC8C!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB108 \uAC15\uD558\uAD6C\uB098!\\n\uC815\uB9D0 \uB300\uB2E8\uD574!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB098\uB97C \uC774\uAE34 \uAE30\uB150\uC73C\uB85C\\n\uC88B\uC740 \uAC83\uC744 \uC904\uAC8C!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uC2B9\uBD80\uD558\uC790!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC2F8\uC6B8 \uB54C\uB9C8\uB2E4 \uC815\uB9D0 \uC790\uADF9\uC801\uC774\uC57C\\n\uB2E4\uC74C\uC5D0\uB3C4 \uBD80\uD0C1\uD55C\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC624\uB298\uC740 \uC9C0\uCCE4\uC73C\uB2C8\uAE4C\\n\uB0B4\uC77C \uB610 \uBCF4\uC790"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC624! \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4\\n\uADF8\uB7FC \uC774\uC81C \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD560\uAE4C?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "...\uC5D0\uC787! ...\uC5D0\uC787!\\n\uC880\uCC98\uB7FC \uC7A1\uD788\uC9C8 \uC54A\uB124\\c\\n\uC5B4\uB77C? \uB108\uB294...\\n\uBCFC\uC744 \uC798 \uB358\uC9C8 \uAC83 \uAC19\uB124!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB098\uB294 \uD50C\uB798\uB108\uC57C!\\c\\n\uB180\uC774\uB97C \uC0DD\uAC01\uD558\uB294 \uAC8C \uC77C\uC774\uB2C8\uAE4C\\n\uB178\uB294 \uAC83\uB3C4 \uC5C5\uBB34\uC758 \uC77C\uBD80\uC9C0!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBC29\uC5D0 \uD750\uB974\uACE0 \uC788\uB294 BGM\uC740\\n\uB0B4\uAC00 \uB9CC\uB4E0 \uAC70\uC57C!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCDE8\uC7AC\uD558\uB7EC \uC774\uACF3\uC5D0 \uC654\uB294\uB370\\n\uAC00\uB77C\uB974\uB294 \uC815\uB9D0 \uBA4B\uC9C0\uAD70\uC694!\\c\\n\uBB34\uC5C7\uBCF4\uB2E4\uB3C4 \uAD00\uB3D9\uC9C0\uBC29\uC5D0\uC11C\\n\uC778\uAE30 \uC788\uB294 \uCE74\uB808\uC758 \uD1A0\uD551\uC744\\r\\n\uC990\uAE38 \uC218 \uC788\uC5B4\uC11C \uCD5C\uACE0\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB108\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uC88B\uC544\uD558\uB2C8?"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!\\n\uC55E\uC73C\uB85C\uB3C4 \uB9CE\uC774 \uC0AC\uB791\uD574\uC918!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC544! \uC54C\uACA0\uB2E4! \uADF8\uB0E5 \uC88B\uC544\uD558\uB294 \uAC8C \uC544\uB2C8\uB77C\\n\uC5C4\uCCAD\uB098\uAC8C \uC88B\uC544\uD55C\uB2E4\uB294 \uAC70\uC9C0?!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB85C\uD1A0\uBB34 \uB7A0\uB9AC\uC5D0 \uD479 \uBE60\uC84C\uC5B4!"
  }
]
