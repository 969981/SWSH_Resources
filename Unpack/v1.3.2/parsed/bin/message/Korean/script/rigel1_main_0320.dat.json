  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC9C4\uC9DC\uB85C\uC694?"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC544\uC73C~! \uB108 \uC815\uB9D0 \uC9DC\uC99D \uB098\uB294 \uC560\uAD6C\uB098!\\n\uB0B4 \uB2E4\uC74C\uC73C\uB85C \uC9DC\uC99D \uB098!![VAR 0114(0071)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uD06C~! \uC815\uB9D0\uC774\uC9C0 \uB2F9\uC2E0\uC740 \uC0AC\uB78C\uC744\\n\uC9DC\uC99D \uB098\uAC8C \uD558\uB294\uAD70\uC694! \uC800\uBCF4\uB2E8 \uB35C\uD558\uC9C0\uB9CC\uC694...!![VAR 0114(0072)]"
