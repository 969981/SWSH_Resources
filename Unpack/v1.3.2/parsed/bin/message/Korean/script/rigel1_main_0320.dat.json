  {
    "index": 3,
    "flags": 0,
    "text": "\uC694\uC998 \uB4E4\uC5B4\\n\uC774\uB7F0 \uC0DD\uAC01\uC774 \uB4E4\uB354\uAD6C\uB098[VAR 0114(0073)]"
