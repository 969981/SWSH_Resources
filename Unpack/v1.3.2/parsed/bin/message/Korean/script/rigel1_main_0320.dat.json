  {
    "index": 44,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC774\uAC78\uB85C \uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC758\\n\uBE44\uBC00 \uC218\uD589 \uB05D~![VAR 0114(0073)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC544, \uC6D0\uB798 \uBAA8\uC2B5\uC73C\uB85C \uB3CC\uC544\uC624\uC168\uB124[VAR 0114(0071)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC544, \uC6D0\uB798 \uBAA8\uC2B5\uC73C\uB85C \uB3CC\uC544\uC624\uC168\uC5C8\uB124\uC694[VAR 0114(0072)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "[VAR 0100(0000)]![VAR 0114(0073)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uC55E\uC73C\uB85C\uB3C4 \uAC00\uB054\\n\uB098\uC640 \uC2B9\uBD80\uD558\uBA70\\r\\n\uC11C\uB85C\uC758 \uC2E4\uB825\uC744 \uB04C\uC5B4\uC62C\uB9AC\uC790\uAFB8\uB098[VAR 0114(0073)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uB2E4\uAC00\uC62C \uADF8 \uB0A0\uC744 \uC704\uD574\uC11C\uB77C\uB3C4 \uB9D0\uC774\uB2E4[VAR 0114(0073)]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uC5B8\uC820\uAC00 \uC54C\uAC8C \uB420 \uD14C\uB2E4!\\n\uAE30\uB300\uD574\uB450\uB824\uBB34\uB098![VAR 0114(0073)]"
