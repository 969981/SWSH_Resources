    "text": "\uB0B4 \uC774\uB984\uC740 \uD53C\uC624\uB2C8![VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB098\uB984\uB300\uB85C \uAC15\uD558\uB2C8\uAE4C\\n\uB2E8\uB2E8\uD788 \uAC01\uC624\uD574\uB77C![VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uADF8\uC544~\uD558\uD558! \uC124\uB9C8 \uC774 \uB0B4\uAC00\\n\uC774\uB7F0 \uC560\uD55C\uD14C \uAF3C\uC9DD\uC5C6\uC774 \uB2F9\uD560 \uC904\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uADF8\uC544~\uD558\uD558! \uC81C\uBC95\uC774\uAE34 \uD588\uB2E4\uB9CC\\n\uC544\uC9C1 \uBB34\uB978 \uAD6C\uC11D\uC774 \uC788\uAD6C\uB098![VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "...\uC74C?[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uC6B0\uB9AC \uB538\\n\uB2C8\uC544\uAC00 \uC548 \uBCF4\uC774\uC796\uC544!![VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC0AC\uB791\uC2A4\uB7EC\uC6B4...?"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uB538...?"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uADF8\uB798! \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uC0AC\uB791\uC2A4\uB7EC\uC6B4\\n\uC6B0\uB9AC \uB538\uC774\uB780 \uB9D0\uC774\uB2E4![VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC624\uB79C\uB9CC\uC5D0 \uB458\uB9CC\uC758 \uC624\uBD93\uD55C\\n\uAC00\uC871\uC5EC\uD589\uC744 \uC704\uD574 \uC5EC\uAE30\uC5D0 \uC628 \uAC70\uB77C\uACE0...[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uADF8\uB7F0\uB370, \uCC98\uC74C \uBCF4\uB294 \uD2B8\uB808\uC774\uB108\uD55C\uD14C \uC815\uC2E0\uC744 \uD314\uAC8C\\n\uB9CC\uB4E4\uACE0 \uB3C4\uB9DD\uAC08 \uC904\uC774\uC57C! \uC5ED\uC2DC \uC6B0\uB9AC \uB2C8\uC544\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uBD84\uBA85\uD788 \uC774\uAC74 \uC544\uBE60\uB97C \uB108\uBB34 \uC0AC\uB791\uD574\uC11C\\n\uC77C\uBD80\uB7EC \uC7A5\uB09C\uC744 \uCE58\uACE0 \uC788\uB294 \uAC78 \uAC70\uC57C! \uADF8\uC544\uD558\uD558![VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uADF8\uB807\uAD70\uC694"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uAC70\uC608\uC694?"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uB538\uC740 \uADF8\uB7F0 \uC544\uC774\uB780\uB2E4!\\n\uC5B4\uB54C? \uBB34\uC9C0\uBB34\uC9C0\uD558\uAC8C \uC0AC\uB791\uC2A4\uB7FD\uC9C0 \uC54A\uB2C8?[VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "...\uADF8\uB807\uAE34 \uD574\uB3C4 \uB140\uC11D\uC774 \uC5C6\uC73C\uBA74\\n\uBAA8\uCC98\uB7FC \uC0DD\uAC01\uD574\uB0B8\\r\\n\uC804\uC124\uC758 \uD0D0\uD5D8 \uD22C\uC5B4\uB97C \uC2DC\uC791\uD560 \uC218 \uC5C6\uB294\uB370![VAR 0114(0076)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uB2C8\uC544\uAC00 \uC880 \uC804\uC5D0\\c\\n[VAR FF00(0006)]\uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74[VAR FF00(0000)]\uC774\uB77C\uB294 \uACF3\uC5D0\\n\uAC04\uB2E4\uACE0 \uD558\uC9C0 \uC54A\uC558\uB358\uAC00?[VAR 0114(0076)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC544\uBE60\uAC00 \uCAD3\uC544\uC624\uAE38 \uBC14\uB77C\uB294 \uAC70\uACA0\uC9C0!?\\n\uADF8\uB798\uADF8\uB798! \uBD84\uBA85\uD788 \uADF8\uB7F0 \uB73B\uC774\uC5C8\uC744 \uAC70\uC57C!\\r\\n\uADF8\uB807\uB2E4\uBA74 \uB2F9\uC7A5 \uC11C\uB458\uB7EC\uC57C\uACA0\uAD70![VAR 0114(0076)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB098\uB294 \uBA3C\uC800 \uAC00\uB9C8!\\n\uC88B\uC740 \uC2B9\uBD80\uC600\uB2E4![VAR 0114(0076)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC798 \uC788\uAC70\uB77C!\\n\uAC15\uD55C \uD3EC\uCF13\uBAAC\uC744 \uAC00\uC9C4 \uAF2C\uB9F9\uC544![VAR 0114(0076)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC798 \uC788\uAC70\uB77C!\\n\uCC38\uACAC\uC7C1\uC774 \uAF2C\uB9F9\uC544![VAR 0114(0076)]"
  },
  {
    "index": 34,
    "flags": 0,
