  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC5B4\uC774 \uAF2C\uB9F9\uC544![VAR 0114(0042)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC0AC\uC815\uB3C4 \uC798 \uBAA8\uB974\uBA74\uC11C\\n\uB0A8\uC758 \uC77C\uC5D0 \uB07C\uC5B4\uB4E4\uB2E4\uB2C8 \uB9C8\uC74C\uC5D0 \uC548 \uB4DC\uB294\uAD70...[VAR 0114(0042)]"
  },
  {
