[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB2E4\uC74C \uB0A0 \uC800\uB141..."
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4 \uB54C\uAC00 \uB410\uC5B4\\n\uC7A0\uC740 \uCDA9\uBD84\uD788 \uC7A4\uC9C0?[VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC2DC\uD569\uC744 \uD558\uB294 \uAC74 \uB108\uC778\uB370\\n\uAD1C\uD788 \uB0B4\uAC00 \uAE34\uC7A5\uB418\uB124...[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8\uC774\uC2DC\uAD70\uC694\\c\\n\uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\uAC00 \uACE7 \uC2DC\uC791\uB420 \uAC81\uB2C8\uB2E4\\n\uC2A4\uD0C0\uB514\uC6C0\uAE4C\uC9C0 \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC5B4\uC774! \uB108!\\n\uC5B4\uC81C \uC77C\uC740 \uC78A\uC740 \uAC70\uC57C?\\c\\n\uC774 \uD638\uBE0C\uB2D8\uACFC \uD30C\uD2B8\uB108\\n[VAR 0101(0001)][VAR 1900(0003)] \uB0A0\uB824\uBC84\uB9B0\uB2E4![VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC790 \uC7A0\uAE50\uB9CC\uC694!\\c\\n\uC800\uB294 \uC88B\uC740 \uB9AC\uADF8 \uC2A4\uD0DC\uD504\uC785\uB2C8\uB2E4\\n\uC81C \uC785\uC73C\uB85C \uB9D0\uD558\uAE34 \uC880 \uADF8\uB807\uC9C0\uB9CC..."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC5B4\uC81C \uC788\uC5C8\uB358 \uC774\uC57C\uAE30\uB294 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4\\c\\n\uC62C\uB9AC\uBE0C\uB2D8\uC740\\n\uC704\uC6D0\uC7A5\uB2D8\uC744 \uC704\uD574\uC11C\uB77C\uBA74\\r\\n\uBB34\uC2A8 \uC77C\uC774\uB4E0 \uD558\uB824\uACE0 \uD574\uC11C\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uC77C\uC744 \uB300\uBE44\uD55C \uC804\uC18D \uC2A4\uD0DC\uD504\uB97C\\n\uADF9\uBE44\uB9AC\uC5D0 \uBAA8\uC9D1\uD574\uB450\uC5C8\uB358 \uBAA8\uC591\uC785\uB2C8\uB2E4..."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uC624\uB298\uC740 \uC548\uC2EC\uD558\uC154\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4!\\n\uC81C\uB300\uB85C \uB41C \uC2A4\uD0DC\uD504\uB4E4\uBFD0\uC774\uB2C8\uAE4C\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB807\uB300\\c\\n\uADF8\uB7FC \uAC00\uC790! [VAR 0100(0000)]!\\n\uBE68\uB9AC \uB108\uC758 \uC2DC\uD569\uC744 \uBCF4\uACE0 \uC2F6\uC5B4!![VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC29B\uC2A4\uD0C0\uB514\uC6C0\uAE4C\uC9C0\\n\uC548\uB0B4\uD574\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCD9C\uBC1C\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4\\c\\n\uC81C\uAC8C \uB2E4\uC2DC \uB9D0\uC744 \uAC78\uB4E0\\n\uD638\uD154 \uC55E\uC5D0 \uC788\uB294 \uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB97C\\r\\n\uC774\uC6A9\uD558\uB4E0 \uD3B8\uD55C \uB300\uB85C \uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4"
  }
]
