  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uB97C \uBC1C\uC0DD\uC2DC\uD0A4\uB294\\n\uC18C\uC6D0\uC758\uBCC4\uC740 \uBB34\uD55C\uB2E4\uC774\uB178\uC758 \uC77C\uBD80\uC785\uB2C8\uB2E4\\c\\n\uADF8\uB7F0\uB370 \uADF8 \uBB34\uD55C\uB2E4\uC774\uB178\uAC00 \uAE68\uC5B4\uB098\uBA74\uC11C\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uBC1C\uC0DD\uC2DC\uD0A4\uB294 \uD30C\uC6CC\uAC00\\r\\n\uAC01\uC9C0\uC5D0\uC11C \uB118\uCCD0\uB098\uAE30 \uC2DC\uC791\uD588\uC8E0...[VAR 0114(000A)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB300\uB85C \uB450\uC5C8\uB2E4\uAC04 \uB2E4\uC774\uB9E5\uC2A4\uD55C\\n\uD3EC\uCF13\uBAAC\uB4E4\uC774 \uB9C8\uAD6C \uB0A0\uB6F0\uC5B4\uC11C\\c\\n\uAC00\uB77C\uB974\uAC00 \uD63C\uB780\uC5D0 \uBE60\uC9C8 \uBED4\uD588\uB294\uB370\\n[VAR 0100(0000)][VAR 1900(0004)] \uB3D9\uB8CC\uB4E4\uC774 \uD574\uACB0\uD574\uC900 \uAC81\uB2C8\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uC77C\uC774 \uC788\uC5C8\uC9C0\uB9CC \uB2E4\uC774\uB9E5\uC2A4\uB294 \uC774\uBBF8\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uC911\uC694\uD55C \uBB38\uD654\uC785\uB2C8\uB2E4\\c\\n\uC774\uC81C\uB294 \uBAA8\uB450\uAC00 \uB2E4\uC774\uB9E5\uC2A4\uC758 \uD798\uC744\\n\uC62C\uBC14\uB974\uAC8C \uC0AC\uC6A9\uD558\uAE30\uB97C \uBC14\uB784 \uBFD0\uC785\uB2C8\uB2E4[VAR 0114(000A)]"
  },
  {
