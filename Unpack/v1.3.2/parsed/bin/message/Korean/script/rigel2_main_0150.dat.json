  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uAF43\uC744 \uB465\uAE00\uAC8C \uC5EE\uACE0 \uC5EE\uC5B4\uC11C~\u266A\\n\uAC08\uAE30\uB97C \uB07C\uC6B0\uC790 \uC655\uC744 \uC704\uD574\uC11C~\u266A[VAR 0114(007A)]"
