  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBD80\uD0C1\uC774 \uC788\uC5B4\uC694!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBB50? \uC720\uB300\uC758\uACE0\uC090\uB97C\\n\uB9CC\uB4DC\uB294 \uBC29\uBC95\uC744 \uC54C\uACE0 \uC2F6\uB2E4\uACE0?[VAR 0114(007A)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uAC70 \uCC38 \uACE4\uB780\uD558\uAC8C \uB410\uAD6C\uBA3C...[VAR 0114(007A)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB0B4 \uC99D\uC870\uBD80\uAC00 \uC0B4\uC544 \uACC4\uC2E4 \uB54C\uB9CC \uD574\uB3C4\\n\uB9CC\uB4E4 \uC218 \uC788\uC5C8\uB124\uB9CC...[VAR 0114(007A)]"
