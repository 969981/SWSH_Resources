[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uC2DC\uAC8C, \uC190\uB2D8...\\n\uC544\uB2C8, \uB9C8\uC744\uC758 \uAD6C\uC138\uC8FC!\\r\\n\uCC45\uC744 \uC77D\uC73C\uB7EC \uC628 \uAC90\uAC00?[VAR 0114(007A)]"
