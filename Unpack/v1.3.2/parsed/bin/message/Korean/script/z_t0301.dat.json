[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC544\uD0AC\uB2D8\uC740 \uBC2D\uC77C \uC678\uC5D0\\n\uC608\uC05C \uAF43\uB3C4 \uD0A4\uC6B0\uACE0 \uC788\uC5B4\uC694"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC18C\uBBF8\uC18C\uBBF8..."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAF43\uC744 \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74~\\n\uD3EC\uCF13\uBAAC\uC774 \uB2E4\uAC00\uC640~"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758 \uB9AC\uADF8 \uCE74\uB4DC\uC5D0\uB294\\n\uB2E4\uC591\uD55C \uC5D0\uD53C\uC18C\uB4DC\uAC00 \uB2F4\uACA8 \uC788\uC5B4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00\uC740 \uBA87 \uBC88\uC774\uACE0 \uB3C4\uC804\uD560 \uC218 \uC788\uC5B4\\n\uAC00\uC11C \uB108\uC758 \uB048\uAE30\uB97C \uC2DC\uD5D8\uD574\uBCF4\uB3C4\uB85D \uD558\uB834"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B8\uB355 \uC800\uD3B8\uC73C\uB85C \uD3BC\uCCD0\uC9C4 \uACBD\uCE58\\n\uC544\uC9C1 \uBABB \uBD24\uB2E4\uBA74 \uAF2D \uBCF4\uACE0\\r\\n\uBD24\uC5B4\uB3C4 \uB610 \uBD10\uC57C \uD574"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC800\uAE30 \uC9C0\uC0C1\uD654 \uB9D0\uC778\uB370\\n\uC774\uB984\uC774 \uC5C6\uB2E4\uB294 \uAC83 \uAC19\uC544...\\r\\n\uBD80\uB974\uBA74 \uC548 \uB418\uB294 \uC774\uB984\uC778 \uAC78\uAE4C?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC9C0\uC0C1\uD654\uB97C \uCD2C\uC601\uD588\uB294\uB370\\n\uC2E4\uBB3C\uC5D0\uB294 \uBABB \uBBF8\uCE58\uB294 \uAC83 \uAC19\uC544\\c\\n\uD558\uC9C0\uB9CC \uCC0D\uC740 \uC0AC\uC9C4\uC744 \uBCF4\uBA74\\n\uC9C1\uC811 \uBD24\uC744 \uB54C\uC758 \uAC10\uB3D9\uC774 \uB418\uC0B4\uC544\uB0A0 \uAC70\uC57C"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5B4\uB5BB\uAC8C \uBA3C \uC61B\uB0A0\uC5D0 \uADF8\uB824\uC9C4\\n\uC9C0\uC0C1\uD654\uAC00 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uACE0 \uB0A8\uC544\uC788\uB294 \uAC78\uAE4C?\\c\\n\uAD81\uAE08\uD574\uC11C \uCC38\uC744 \uC218\uAC00 \uC5C6\uC5B4\\n\uC790\uAFB8 \uC0DD\uAC01\uC774 \uB098\uC11C \uC7A0\uC774 \uC548 \uC62C \uC815\uB3C4\uC57C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC74C... \uC5ED\uC2DC\\c\\n\uD3EC\uCF13\uBAAC\uC774 \uB3C4\uC640\uC918\uC11C\\n\uC9C0\uC0C1\uD654\uAC00 \uB9CC\uB4E4\uC5B4\uC9C4 \uAC8C \uC544\uB2D0\uAE4C?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB098\uB294 \uD06C\uBA74\\n\uAC04\uD310 \uB4A4\uC5D0 \uC11C\uC11C \uC0AC\uC9C4\uC744 \uCC0D\uC744 \uAC70\uC57C!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC54C \uC218 \uC5C6\uB294 \uB3CC\uB85C \uB41C \uC624\uBE0C\uC81C\\c\\n\uC0AC\uB78C\uC774 \uB9CC\uB4E0 \uAC83\uC778\uAC00\\n\uC544\uB2C8\uBA74 \uD3EC\uCF13\uBAAC\uC774 \uB9CC\uB4E0 \uAC83\uC778\uAC00..."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB50\uB4E0 \uAD00\uB9AC\uB97C \uC18C\uD640\uD788 \uD558\uBA74\\n\uC815\uC791 \uD544\uC694\uD560 \uB54C \uACE4\uB780\uD558\uAC8C \uB418\uC9C0"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "5\uBC88\uB3C4\uB85C\uB294 \uAE38\uC5B4\uC11C...\\n\uB0B4\uB2EC\uB9AC\uBA74 \uAE30\uBD84\uC774 \uC88B\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC9C0\uC0C1\uD654\uB97C \uBCF4\uB7EC \uC624\uB294\\n\uC0AC\uB78C\uC774 \uB298\uC5B4\uB0AC\uC5B4"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBAA8\uB450 \uC544\uD0AC\uB2D8\uC774\\n\uD0A4\uC6B4 \uAC70\uB098 \uB9C8\uCC2C\uAC00\uC9C0\uC57C"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\\n\uC815\uB9D0 \uB300\uB2E8\uD574!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\\n\uB450\uADFC\uB450\uADFC\uD574"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC544\uD0AC\uB2D8\uC774\\n\uC84C\uC5B4..."
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uC800 \uC0AC\uB78C\uC740\\n\uCC54\uD53C\uC5B8...?"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\\n\uC21C\uC11C\uB97C \uAE30\uB2E4\uB9AC\uB294 \uAC70\uC57C?"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC648\uC648\uC648\uC648\uC648!"
  }
]
