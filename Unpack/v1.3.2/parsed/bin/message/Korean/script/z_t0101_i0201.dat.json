[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B8\uC81C\uB098 \uCC54\uD53C\uC5B8\uC758 \uC2DC\uD569\uC774\\n\uB098\uC624\uACE0 \uC788\uB294 TV"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC5D0 \uB300\uD574\\n\uC4F0\uC5EC\uC9C4 \uCC45\uC774 \uC794\uB729 \uC788\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC794\uB729 \uB123\uC744 \uC218 \uC788\uB294\\n\uAC00\uC871 \uC0AC\uC774\uC988\uC758 \uB0C9\uC7A5\uACE0"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5B8\uC81C\uB098 \uAE54\uB054\uD55C \uBD80\uC5CC"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC218\uB9CE\uC740 \uD2B8\uB85C\uD53C\uB294\\n\uBAA8\uB450 \uCC54\uD53C\uC5B8\uC758 \uAC83\uC774\uB2E4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB0D0\uD6C4\uB0D0\uD6C4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD638\uBE0C\uC5D0\uAC8C \uD615\uC740\\n\uC288\uD37C\uD788\uC5B4\uB85C\uB780\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC774\uC81C\uB294 \uCC54\uD53C\uC5B8\uC774 \uC544\uB2C8\uC9C0\uB9CC\\n\uD638\uBE0C\uC5D0\uAC8C \uD615\uC774\\r\\n\uC288\uD37C\uD788\uC5B4\uB85C\uC778 \uAC74 \uBCC0\uD568\uC5C6\uB2E8\uB2E4\\c\\n\uC624\uD788\uB824 \uAC19\uC740 \uD2B8\uB808\uC774\uB108\uAC00 \uB3FC\uC11C\\n\uC5BC\uB9C8\uB098 \uB300\uB2E8\uD55C\uC9C0 \uC54C\uAC8C \uB410\uC744 \uAC70\uC57C"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB2E8\uB378\uB3C4 \uCC38, \uC5BC\uB9C8 \uC804\uC5D0 \uCC98\uC74C\uC73C\uB85C\\n\uB290\uAE0B\uD558\uAC8C \uBC25\uC744 \uBA39\uC740 \uAC70 \uC788\uC9C0!\\c\\n\uB2E4\uC74C\uC5D0 \uB610 \uB2E4 \uAC19\uC774 \uBAA8\uC5EC\uC11C\\n\uBC14\uBCA0\uD050 \uD558\uB294 \uAC74 \uC5B4\uB5A8\uAE4C?"
  }
]
