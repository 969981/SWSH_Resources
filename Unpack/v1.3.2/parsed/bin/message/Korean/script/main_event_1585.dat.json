[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC62C\uB9AC\uBE0C\uC758 \uB9AC\uADF8 \uC2A4\uD0DC\uD504...\\c\\n\uB2E4\uC2DC \uB9D0\uD574 \uB098\uC05C \uB9AC\uADF8 \uC2A4\uD0DC\uD504\uB97C\\n\uCC3E\uC544\uBCF4\uB3C4\uB85D \uD560\uAE4C?\\c\\n\uB098\uC05C \uB9AC\uADF8 \uC2A4\uD0DC\uD504\uB294 \uC560\uB9E4\uD558\uAC8C \uC0DD\uAE34\\n\uC120\uAE00\uB77C\uC2A4\uB97C \uC4F0\uACE0 \uC788\uC5C8\uC5B4[VAR 0114(0016)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB098\uC05C \uB9AC\uADF8 \uC2A4\uD0DC\uD504\uB294 \uC560\uB9E4\uD558\uAC8C \uC0DD\uAE34\\n\uC120\uAE00\uB77C\uC2A4\uB97C \uC4F0\uACE0 \uC788\uC5C8\uC5B4\\c\\n\uADF8\uB9AC\uACE0 \uC0AC\uB78C\uC744 \uC27D\uAC8C \uCC3E\uB294 \uBE44\uACB0\uC740...\\n\uBD80\uC9C0\uB7F0\uD558\uAC8C \uC815\uBCF4\uB97C \uC5BB\uC73C\uBA74 \uB3FC[VAR 0114(0016)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB098\uC05C \uB9AC\uADF8 \uC2A4\uD0DC\uD504 \uB9D0\uC778\uB370\\n\uB2E4\uB978 \uC7A5\uC18C\uC5D0\uC11C\uB294\\r\\n\uBC1C\uACAC\uB418\uC9C0 \uC54A\uC740 \uBAA8\uC591\uC774\uC57C\\c\\n\uBD84\uBA85\uD788 \uADFC\uCC98\uC5D0 \uC228\uC5B4 \uC788\uC744 \uAC70\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAD81\uC9C0\uC5D0 \uBAB0\uB9B0 \uC0AC\uB78C\uC740\\n\uC881\uC740 \uACF3\uC73C\uB85C \uB3C4\uB9DD\uCE58\uB824 \uD558\uAE30 \uC2ED\uC0C1\uC774\uC9C0\\r\\n\uC8FC\uBCC0\uC5D0 \uBC15\uC2A4 \uAC19\uC740 \uAC74 \uC548 \uBCF4\uC774\uB2C8?[VAR 0114(0016)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBE44\uC11C\uC758 \uC7A5\uB09C\uB3C4 \uC5EC\uAE30\uAE4C\uC9C0\uB124\\c\\n\uBB50 \uC610\uB2E8\uC758 \uBC29\uD574 \uC791\uC804\uB3C4\\n\uC7A5\uB09C \uC218\uC900\uC774\uC5C8\uC73C\uB2C8\uAE4C\\r\\n\uB0A8 \uB9D0\uD560 \uCC98\uC9C0\uB294 \uC544\uB2C8\uC9C0\uB9CC\\c\\n\uC790 \uADF8\uB7FC \uC5ED\uC73C\uB85C \uAC00\uBCFC\uAE4C?[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "... ... ..."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0006)]\uAD6C\uB098! \uC774 \uB140\uC11D\\n\uC218\uC0C1\uD574 \uBCF4\uC774\uB294\uB370 \uC5BC\uAD74\uC744 \uBCF4\uC5EC\uC8FC\uC9C0 \uC54A\uC544\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uC774 \uB140\uC11D\uC744 \uB4A4\uB3CC\uC544\uBCF4\uAC8C \uD560 \uC815\uB3C4\uB85C\\n\uAE5C\uC9DD \uB180\uB784 \uB9CC\uD55C \uC598\uAE30\uB97C \uD574\uBD10!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC62C\uB9AC\uBE0C\uB2D8\uC774\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD0A4\uB97C \uCC3E\uC558\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBB50\uB77C\uACE0!?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC544\uBFD4\uC2F8!\\n\uB4A4\uB3CC\uC544\uBCF4\uACE0 \uB9D0\uC558\uB2E4\\c\\n\uADFC\uB370 \uB3C4\uB9DD\uCE60 \uC218\uAC00 \uC5C6\uB124!?\\n\uADF8\uB807\uB2E4\uBA74 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC88B\uC544! \uC228\uC5B4\uBC84\uB9AC\uBA74\\n\uD0A4\uB97C \uC8FC\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB2C8\uAE4C!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB34\uC11C\uC6B4 \uC18D\uB3C4\uC600\uB2E4...\\n\uB098\uB294 \uC5B4\uB514\uC5D0 \uC228\uC5C8\uB294\uC9C0 \uBCF4\uC9C0 \uBABB\uD588\uC5B4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5B4\uB5BB\uAC8C \uB208\uCE58\uCC48 \uAC70\uC57C...?\\n\uC801\uB2F9\uD788 \uCC0D\uC5B4\uBCF8 \uAC74\uAC00?\\r\\n\uC544\uBB34\uB798\uB3C4 \uC88B\uB2E4! \uC2B9\uBD80\uB2E4!!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB098\uBB34\uB97C \uC228\uAE30\uB824\uBA74 \uC232\uC774 \uC81C\uC77C\uC774\uACE0\\n\uC0AC\uB78C\uC744 \uC228\uAE30\uB824\uBA74 \uC0AC\uB78C\uB4E4 \uD2C8\uC774 \uC81C\uC77C\uC774\uC9C0!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD55C \uAD00\uCC30\uB825\uC774\uAD70!\\n\uC774\uBC88\uC5D0\uC57C\uB9D0\uB85C \uC774\uAE30\uACE0 \uB3C4\uB9DD\uCCD0\uC8FC\uB9C8!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC774\uAC70 \uC644\uC804\uD788\\n\uAD81\uC9C0\uC5D0 \uBAB0\uB9B0 \uBAA8\uC591\uC774\uAD70...\\c\\n\uADF8\uB807\uC9C0\uB9CC \uC62C\uB9AC\uBE0C\uB2D8\uC5D0\uAC8C\\n\uD63C\uB098\uAE30 \uC2EB\uC73C\uB2C8\uAE4C \uD3EC\uAE30\uD558\uC9C0 \uC54A\uACA0\uB2E4!\\c\\n\uBAA8\uB178\uB808\uC77C\uC5D0 \uD0C0\uBA74\\n\uCAD3\uC544\uC62C \uC218 \uC5C6\uC744 \uAC70\uB2E4!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC610\uB2E8\uC740 \uD638\uBE0C\uB97C \uBD88\uB7EC\uC640!\\n\uB2E4 \uAC19\uC774 \uC5ED\uC73C\uB85C \uAC00\uB294 \uAC70\uC57C![VAR 0114(0016)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[VAR 0100(0000)]\\n\uB098\uC05C \uB9AC\uADF8 \uC2A4\uD0DC\uD504\uB97C\\r\\n\uBAB0\uC544\uB123\uB2E4\uB2C8 \uCC38 \uC798\uD588\uC5B4\\c\\n\uAE30\uD2B9\uD55C \uC77C\uC744 \uD55C \uB108\uB97C \uCE6D\uCC2C\uD558\uB294 \uB73B\uC5D0\uC11C\\n\uCD5C\uACE0\uC758 \uB178\uB798\uB97C \uBD88\uB7EC\uC904\uAC8C[VAR 0114(0016)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uBCF4\uC798\uAC83\uC5C6\uB294 \uAC00\uC218\uAC00 \uD560 \uC218 \uC788\uB294 \uAC74\\n\uBCF4\uC798\uAC83\uC5C6\uB294 \uB178\uB798\uB97C \uBD80\uB974\uB294 \uAC83\uBFD0[VAR 0114(0016)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB178\uB798\uB85C \uB204\uAD70\uAC00\uB97C \uC751\uC6D0\uD558\uB294 \uAC74\\n\uAC70\uC9D3\uB9D0\uC774\uC57C \uD798\uB4E0 \uC77C\uC774\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB178\uB798\uB85C \uB204\uAD70\uAC00\uB97C \uD589\uBCF5\uD558\uAC8C \uB9CC\uB4DC\uB294 \uAC74\\n\uB0B4\uAC8C\uB294 \uC5B4\uB824\uC6CC \uBD88\uAC00\uB2A5\uD55C \uC77C\uC774\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uB098\uB294 \uB178\uB798\uD560 \uBFD0\uC774\uC57C\\n\uBCF4\uC798\uAC83\uC5C6\uB294 \uB178\uB798\uB97C \uBD80\uB97C \uBFD0\uC774\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8!!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8~!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uB450\uC1A1\uC774\uC796\uC544!\\n\uBB34\uC2A8 \uC77C\uB85C \uAC70\uB9AC \uACF5\uC5F0\uC744 \uD558\uB294 \uAC70\uC9C0?"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uAC70\uB9AC \uACF5\uC5F0\uC774\uB77C\uAE30\uBCF4\uB2E4\uB294\\n\uC5ED\uC0AC \uACF5\uC5F0\uC774\uB124\\c\\n\uADF8\uAC74 \uB410\uACE0\\n\uB354 \uAC00\uAE4C\uC774 \uAC00\uBCF4\uC790!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8~!\\n\uD0A4\uB97C \uBE7C\uC557\uC558\uC2B5\uB2C8\uB2E4!\\c\\n\uC774\uC81C \uB85C\uC988\uD0C0\uC6CC\uAE4C\uC9C0\\n\uBAA8\uB178\uB808\uC77C\uB85C \uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
  },
  {
