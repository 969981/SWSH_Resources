[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC81C \uC774\uB984\uC740 \uBAA8\uC824\uB780\uC785\uB2C8\uB2E4\\n\uD654\uC11D\uC744 \uC5F0\uAD6C\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC5D0\uC11C \uBC1C\uACAC\uB418\uB294 \uD654\uC11D\uC740 \uC5B4\uC9F8\uC120\uC9C0\\n\uC0C1\uBC18\uC2E0 \uC544\uB2C8\uBA74 \uD558\uBC18\uC2E0\uBFD0\uC785\uB2C8\uB2E4\\c\\n\uADF8\uB7F0\uB370 \uC5B4\uB5BB\uAC8C \uC870\uD569\uD558\uB354\uB77C\uB3C4\\n\uBCF5\uC6D0\uC774 \uB418\uB294 \uAC83\uC774 \uBBF8\uC2A4\uD130\uB9AC\uC785\uB2C8\uB2E4\\c\\n\uC5B4\uCA4C\uBA74 \uC774\uAC78\uB85C \uD569\uCCB4\uD560 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC758\\n\uBE44\uBC00\uC744 \uBC1D\uD600\uB0BC \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC74C? \uD654\uC11D\uC744 \uAC00\uC9C0\uACE0 \uC788\uAD70\uC694\\n\uC774 \uBAA8\uC824\uB780\uC5D0\uAC8C \uD55C\uBC88 \uBCF4\uC5EC\uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB807\uAC8C \uC810\uC794 \uBE7C\uC2E4 \uAC83 \uC5C6\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBAA8\uC824\uB780\uC758 \uB208\uC5D0 \uB4E4\\n\uD654\uC11D\uC740 \uC5B4\uB5A4 \uAC83\uC774\uC8E0?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBAA8\uC824\uB780\uC758 \uD765\uBBF8\uB97C \uC790\uC544\uB0BC\\n\uD654\uC11D\uC740 \uC5B4\uB5A4 \uAC83\uC774\uC8E0?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD654\uC11D\uC0C8"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD654\uC11D\uBB3C\uACE0\uAE30"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD654\uC11D\uC6A9"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD654\uC11D\uAE34\uBAA9"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "[VAR 0109(0001)][VAR 1900(0004)]\\n[VAR 0109(0002)][VAR 1900(0005)]\uB85C \uBCF5\uC6D0\uD560\uAE4C\uC694?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC544\uB2CC \uAC83 \uAC19\uC544\uC694"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC624\uCF00\uC774! \uBCF5\uC6D0\uD574\uC11C\\n\uD654\uC11D\uC758 \uC218\uC218\uAED8\uB07C\uB97C \uD480\uC5B4\uBD05\uC2DC\uB2E4!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCC99\uCC99 \uBD99\uC774\uC790!\\n\uC608\uC2A4! \uC608\uC2A4! \uC608\uC2A4!!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uBAA9\uD45C \uB2EC\uC131!\\n\uD6CC\uB96D\uD558\uAC8C \uBCF5\uC6D0\uB41C \uAC83 \uAC19\uC2B5\uB2C8\uB2E4!\\c\\n\uD0DC\uACF3\uC801 \uAC00\uB77C\uB974\uC5D0\uC11C \uC0B4\uB358 \uB2F9\uC2DC\uC758 \uBAA8\uC2B5\uC774\\n\uB208\uC5D0 \uC120\uD558\uAC8C \uBCF4\uC774\uB294 \uB4EF\uD569\uB2C8\uB2E4!\\r\\n\uADC0\uC5EC\uC6CC\uD574 \uC8FC\uC138\uC694"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBC15\uC2A4\uAC00 \uAC00\uB4DD \uCC3C\uC5B4\uC694"
  }
