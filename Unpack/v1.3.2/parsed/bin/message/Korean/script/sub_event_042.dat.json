[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC73C\uC559~ \uC5B4\uB5A1\uD574!\\c\\n\uB0B4 \uCE58\uB77C\uBBF8\uAC00\\n\uC0AC\uB77C\uC838\uBC84\uB838\uC5B4~!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB3C4\uC640\uC904\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB2E4\uC2DC \uC62C\uAC8C..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC73C\uC544\uC544\uC559~!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC751? \uCE58\uB77C\uBBF8\uB97C \uCC3E\uB294 \uAC78\\n\uB3C4\uC640\uC8FC\uB294 \uAC70\uC57C? \uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB0B4 \uCE58\uB77C\uBBF8\uB294\\n\uBB3C\uC5D0\uC11C \uB178\uB294 \uAC70\uB791 \uD718\uD30C\uB78C\uC744 \uC88B\uC544\uD574!\\c\\n\uBD84\uBA85\uD788 \uBB3C\uC774 \uACE0\uC5EC \uC788\uB294 \uACF3\uC5D0\\n\uC228\uC5B4 \uC788\uC744 \uAC70\uC57C!\\c\\n\uADF8\uB7F0\uB370 \uC5D4\uC9C4\uC2DC\uD2F0\uC5D0\\n\uADF8\uB7F0 \uC7A5\uC18C\uAC00 \uC788\uC5C8\uB098...?\\c\\n\uD4E8\uAC8C~\uD558\uACE0 \uC774\uC0C1\uD55C \uC18C\uB9AC\uB85C \uC6B0\uB2C8\uAE4C\\n\uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uBA74 \uD718\uD30C\uB78C\uC73C\uB85C \uBD88\uB7EC\uBD10!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD4E8\uAC8C...?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC0AC\uB77C\uC9C4 \uCE58\uB77C\uBBF8\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCE58\uB77C\uBBF8\uB294 \uB0A8\uC790\uC544\uC774\uAC00\\n\uC788\uB294 \uACF3\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uCE58\uB77C\uBBF8?\\n\uC544\uB2C8, \uB098\uB294 \uADF8\uB0E5 \uD560\uC544\uBC84\uC9C0\uC778\uB370?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBAB0\uB798 \uBB3C\uB180\uC774\uB97C \uD558\uACE0 \uC788\uC5C8\uB294\uB370...\\n\uB108\uC5D0\uAC8C \uB4E4\uCF1C\uBC84\uB838\uAD6C\uB098!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uB9CC\uB09C \uAE30\uB150\uC73C\uB85C\\n\uB124\uAC8C \uC120\uBB3C\uC744 \uC8FC\uB9C8!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC774\uC81C \uC791\uBCC4\uC774\uB2E4!\\n\uD558\uD558\uD558\uD558!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD560\uC544\uBC84\uC9C0\uB294\\n\uB3CC\uC544\uAC14\uB2E4!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uADF8 \uC544\uC774\uB294\\n\uB0B4 \uCE58\uB77C\uBBF8\uC57C!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCE58\uB77C\uBBF8\uAC00 \uB3CC\uC544\uC654\uC5B4!\\n\uCC3E\uC544\uC918\uC11C \uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCC3E\uC544\uC900 \uBCF4\uB2F5\uC73C\uB85C\\n\uC774\uAC78 \uBC1B\uC544\uC918!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB0B4 \uC808\uCE5C \uCE58\uB77C\uBBF8\uB294\\n\uAE30\uC6B4\uC774 \uB108\uBB34 \uB118\uCCD0\uC11C \uD55C\uB208\uC744 \uD314 \uC218\uAC00 \uC5C6\uC5B4!"
  }
]
