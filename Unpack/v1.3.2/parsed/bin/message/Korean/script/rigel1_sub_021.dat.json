  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uAC00\uB77C\uB450\uAD6C\uAC00\uC9C0 [VAR 0200(0001)]\uAC1C\uB97C \uC8FC\uBA74\\n\uAC00\uB77C\uB450\uAD6C\uD314\uCC0C\uB97C \uB9CC\uB4E4\uC5B4\uC904\uAC8C"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5E5~ \uC5C4\uCCAD \uADC0\uC5EC\uC6B4\uB370~"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAC00\uB77C\uB450\uAD6C\uAC00\uC9C0\uAC00 \uBD80\uC871\uD574\\n\uAC11\uC637\uC12C\uC744 \uB3CC\uC544\uB2E4\uB2C8\uBA74\uC11C \uBAA8\uC544\uC640~"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC88B\uC558\uC5B4! \uB0B4\uAC8C \uB9E1\uACA8\uC918~"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5BC\uAE30\uC124\uAE30...\\n\uC5BC\uAE30\uC124\uAE30..."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC790, \uC5EC\uAE30 \uC788\uC5B4!\\n\uAE08\uBC29 \uB9CC\uB4E4\uC5C8\uC9C0?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC57C\uB3C8\uC5D0\uAC8C \uC815\uB9D0 \uC798 \uC5B4\uC6B8\uB9B4 \uAC70\uC57C!\\c\\n\uB354 \uAC00\uC9C0\uACE0 \uC2F6\uC73C\uBA74\\n\uAC00\uB77C\uB450\uAD6C\uAC00\uC9C0\uB97C \uAC00\uC838\uC640~"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC557! \uC57C\uB3C8\uC744 \uB370\uB9AC\uACE0 \uC788\uB124!\\c\\n\uB108, \uC57C\uB3C8\uC744 \uC88B\uC544\uD558\uB098 \uBCF4\uAD6C\uB098?\\n\uADF8\uB7FC \uC774 \uC154\uCE20\uB3C4 \uB9C8\uC74C\uC5D0 \uB4E4 \uAC70\uC57C!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC557! \uC57C\uB3C8\uC744 \uB370\uB9AC\uACE0 \uC788\uB124!\\c\\n\uB2E4\uB978 \uC9C0\uBC29\uC758 \uC57C\uB3C8\uB3C4\\n\uBA4D~\uD558\uAC8C \uC0DD\uAE34 \uAC8C \uADC0\uC5EC\uC6B4 \uAC83 \uAC19\uC544!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC557! \uC57C\uB3C4\uB780\uC744 \uB370\uB9AC\uACE0 \uC788\uB124!\\c\\n\uAC00\uB77C\uB450\uAD6C\uD314\uCC0C\uB97C \uC0AC\uC6A9\uD588\uAD6C\uB098~\\n\uADF8\uB7FC \uC774 \uC154\uCE20\uB3C4 \uBC1B\uC544\uC918~"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC557! \uC57C\uB3C4\uB780\uC744 \uB370\uB9AC\uACE0 \uC788\uB124!\\c\\n\uB2E4\uB978 \uC9C0\uBC29\uC758 \uC57C\uB3C4\uB780\uC740\\n\uAC00\uB77C\uB450\uAD6C\uD314\uCC0C\uB97C \uD558\uC9C0 \uC54A\uC544\uB3C4 \uC9C4\uD654\uD558\uB294\uAD6C\uB098~"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC2E4\uB0B4\uBCF5\uC73C\uB85C \uC785\uAE30 \uC88B\uC740\\n\uBA4D~\uD55C \uB514\uC790\uC778\uC774\uC57C~"
  },
