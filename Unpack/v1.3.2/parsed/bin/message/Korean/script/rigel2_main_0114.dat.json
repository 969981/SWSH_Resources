[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC, \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uC11C\\n\uC774\uC57C\uAE30\uB294 \uBAA8\uB450 \uB4E4\uC5C8\uACA0\uC9C0!?[VAR 0114(0079)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "...\uADF8\uB798\uC11C, \uC5B4\uB5BB\uB358\uAC00?\\n\uB098\uC5D0 \uB300\uD55C \uC774\uC57C\uAE30\uB294 \uC880 \uC788\uC5C8\uB098?[VAR 0114(0079)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBB50\uB77C \uB9D0\uD558\uAE34 \uD588\uB294\uB370..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB3D9\uD654 \uC18D \uC774\uC57C\uAE30\uB798..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD760...\\n\uC5ED\uC2DC \uB0B4\uAC00 \uC2E4\uC874\uD55C\uB2E4\uACE0 \uBBFF\uB294 \uC774\uB294 \uC5C6\uB294 \uAC74\uAC00...[VAR 0114(0079)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC778\uAC04\uB4E4\uC740 \uB098\uC640\uC758 \uC720\uB300\uB97C\\n\uC644\uC804\uD788 \uC78A\uC5B4\uBC84\uB9B0 \uBAA8\uC591\uC774\uAD70...[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "...\uADF8\uB807\uB2E4\uACE0 \uD574\uC11C\\n\uC2AC\uD37C\uD558\uACE0 \uC788\uC744 \uC218\uB294 \uC5C6\uC9C0![VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB098\uB294 \uD48D\uC694\uC758 \uC655!\\n\uC778\uAC04\uC5D0\uAC8C \uAE30\uB300\uB97C \uD488\uC744 \uC815\uB3C4\uB85C\\r\\n\uC5B4\uB9AC\uC11D\uC9C0 \uC54A\uB124[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB098\uC758 \uD798\uC744 \uB418\uCC3E\uB294 \uC77C\uC744\\n\uC778\uAC04\uC758 \uC2E0\uC559 \uB530\uC704\uC5D0\\r\\n\uB9C8\uB0E5 \uAE30\uB300\uACE0 \uC788\uC744 \uC218\uB9CC\uC740 \uC5C6\uC9C0[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB098\uC758 \uC560\uB9C8\uB9CC \uB3CC\uC544\uC628\uB2E4\uBA74\\n\uC5B4\uB290 \uC815\uB3C4 \uD798\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uC744 \uD150\uB370...[VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC560\uB9C8\uB77C\uB2C8?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC778\uB370?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD55C\uB54C \uB0B4\uAC00 \uD0C0\uACE0 \uB2E4\uB2C8\uB358\\n\uB124\uBC1C \uB2EC\uB9B0 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB124[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB9C8\uC744\uC758 \uC870\uAC01\uC0C1\uC5D0\uB3C4\\n\uB0B4\uAC00 \uD0C0\uACE0 \uC788\uB294 \uBAA8\uC2B5\uC744 \uBCFC \uC218 \uC788\uC9C0[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uBA3C \uC61B\uB0A0, \uD568\uAED8 \uC0B0\uACFC \uB4E4\uC744\\n\uB204\uBE44\uACE0 \uB2E4\uB2C8\uB358 \uC0AC\uC774\uC600\uC9C0\uB9CC...[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB098\uC758 \uD798\uC774 \uC57D\uD574\uC838\\n\uAD00\uACC4\uAC00 \uD2C0\uC5B4\uC9C4 \uB4A4\uB85C\\r\\n\uD589\uBC29\uC744 \uC54C \uC218 \uC5C6\uAC8C \uB410\uB2E4\uB124[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC124\uB839 \uC560\uB9C8\uB97C\\n\uCC3E\uB294\uB2E4\uACE0 \uD558\uB354\uB77C\uB3C4\\c\\n\uD798\uC774 \uC5C6\uB294 \uC9C0\uAE08\uC758 \uB0B4\uAC00\\n\uC81C\uB300\uB85C \uD0C8 \uC218 \uC788\uC744\uC9C0...[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC560\uB9C8\uC5D0 \uB300\uD574\uC11C\uB3C4\\n\uB9C8\uC744\uC5D0 \uC804\uD574 \uB0B4\uB824\uC624\uB294 \uC774\uC57C\uAE30\uAC00 \uC788\uC744 \uAC83\uC774\uB124\\c\\n\uB9C8\uC744\uC758 \uC6B0\uB450\uBA38\uB9AC\uC5D0\uAC8C\uC11C\\n\uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uBD10 \uC8FC\uAC8C\uB098[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uD639\uC2DC \uBB54\uAC00 \uC54C\uAC8C \uB418\uBA74\\n\uB0B4\uAC8C \uC54C\uB824\uC8FC\uAC8C[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "...\uB044\uC545!?[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uB300\uC7A5!?\\n\uC655\uBA38\uB9AC...\uAC00 \uC544\uB2C8\uB124?[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "...\uC5B4\uC774\uCFE0\uC57C, \uBBF8\uC548!\\n\uC774\uAC70, \uC120 \uCC44\uB85C \uC7A0\uC774 \uB4E0 \uBAA8\uC591\uC774\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC74C? \uBB54\uAC00 \uBAB8\uC774\\n\uBB18~\uD55C \uB290\uB08C\uC774 \uB4DC\uB124...![VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB09C \uC544\uC9C0\uD2B8\uB85C \uB3CC\uC544\uAC00\uC11C \uC26C\uACE0 \uC788\uC744\uAC8C!\\n\uC73C~ \uCDA5\uB2E4 \uCD94\uC6CC![VAR 0114(0076)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655\uC758 \uC560\uB9C8?\\n\uC61B\uB0A0\uC774\uC57C\uAE30\uC5D0 \uB530\uB974\uBA74 \uC791\uBB3C\uC744 \uB9DD\uCCD0\uB193\uB294\\r\\n\uB9DD\uB098\uB2C8\uC600\uB2E4\uC9C0?\\r\\n\uADF8\uB807\uB2E4\uBA74 \uC6B0\uB9AC\uC5D0\uAC90 \uC801\uC774\uB85C\uAD70"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC655\uC758 \uC560\uB9C8? \uC560\uB9C8\uB77C...\\c\\n\uC5D4\uC9C4\uC2DC\uD2F0\uB85C \uC774\uC0AC \uAC04\\n\uC5E0\uB9C8\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC73C\uB824\uB098 \uBAA8\uB974\uACA0\uAD6C\uBA3C"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC655\uC758 \uC560\uB9C8\uB294\\n\uC815\uB9D0\uB85C \uC544\uB984\uB2E4\uC6B4\\r\\n\uAC80\uC740 \uD138\uC744 \uAC00\uC84C\uB2E4\uB354\uAD6C\uB098"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC655\uC758 \uC560\uB9C8 \uB9D0\uC774\uB0D0?\\c\\n\uB0B4\uAC00 \uB4E3\uAE30\uB85C\uB294\\n\uB208\uCC98\uB7FC \uD558\uC580 \uBAA8\uC2B5\uC774\uC5C8\uB2E4\uB354\uAD6C\uB098"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC655\uC758 \uC560\uB9C8\uC5D0\uAC8C\uB294\\n\uC88B\uC544\uD558\uB294 \uC791\uBB3C\uC774 \uC788\uC5C8\uB2E8\uB2E4\\c\\n\uADF8\uB7EC\uB2C8\uAE4C... \uBB50\uC600\uB354\uB77C...?\\n\uCD0C\uC7A5\uB2D8\uC774\uB77C\uBA74 \uC544\uC2DC\uB824\uB098..."
  }
]
