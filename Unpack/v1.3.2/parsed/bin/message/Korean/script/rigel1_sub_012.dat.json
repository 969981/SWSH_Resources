[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBA4B\uC9C4 \uC790\uC804\uAC70\uB97C \uAC00\uC9C0\uACE0 \uC788\uAD6C\uB098!\\c\\n\uD639\uC2DC \uB0B4\uAC00\\n\uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uB97C \uD574\uB3C4 \uB420\uAE4C?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uB108\uB294...\\c\\n\uBB3C \uC704\uB97C \uB2EC\uB9B4 \uC218 \uC788\uB294 \uC790\uC804\uAC70\uB97C \uC190\uC5D0 \uB123\uC73C\uBA74\\n\uB2E4\uC2DC \uB0B4\uAC8C \uB9D0\uC744 \uAC78\uC5B4\uC918"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB098\uB294 \uC790\uC804\uAC70\uC640 \uC815\uBE44\uB97C \uC0AC\uB791\uD558\uB294\\n\uC774\uB984\uD558\uC5EC \uC790\uC804\uAC70\uC544\uAC00\uC528!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB108\uC758 \uC790\uC804\uAC70\uB97C\\n\uB0B4\uAC00 \uACE0\uC548\uD574\uB0B8 \uB514\uC790\uC778\uC73C\uB85C\\r\\n\uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD574\uC904\uAE4C?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC2A4\uD30C\uD074\uB9C1 \uD654\uC774\uD2B8"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAE00\uB9AC\uD130\uB9C1 \uBE14\uB799"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC6D0\uB798 \uB514\uC790\uC778"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC790\uC804\uAC70 \uCEE4\uC2A4\uD130\uB9C8\uC774\uC988"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC288\uD2B8 \uCEEC\uB7EC \uBC14\uAFB8\uAE30"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB3CC\uC544\uAC04\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAD1C\uCC2E\uC544\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uB514\uC790\uC778\uC73C\uB85C\\n\uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD574\uC904\uAE4C?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB108\uBB34 \uB9CE\uC774 \uAD11\uC744 \uB0B4\uC11C \uD558\uC597\uAC8C \uBE5B\uB098\uB294\\n\uC2A4\uD30C\uD074\uB9C1 \uD654\uC774\uD2B8\uB85C \uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD574\uC904\uAC8C!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD2B9\uC218\uD55C \uCF54\uD305\uC73C\uB85C \uBC88\uCA4D\uBC88\uCA4D \uBE5B\uB098\uB294\\n\uAE00\uB9AC\uD130\uB9C1 \uBE14\uB799\uC73C\uB85C \uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD574\uC904\uAC8C!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC624! \uC6D0\uB798 \uB514\uC790\uC778\uC73C\uB85C\\n\uB418\uB3CC\uB9AC\uACE0 \uC2F6\uC740\uAC00 \uBCF4\uAD6C\uB098!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD558\uD558\uD558! \uC9C0\uAE08\uC758 \uC790\uC804\uAC70\uAC00\\n\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uBAA8\uC591\uC774\uAD6C\uB098!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD558\uACE0 \uC2F6\uC5B4\uC9C0\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uCC3E\uC544\uC624\uB834"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC624\uCF00\uC774!\\n\uADF8\uB7FC \uC7A0\uAE50 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5B4!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCEE4\uC2A4\uD130\uB9C8\uC774\uC988 \uC644\uB8CC!\\n\uC2E0\uB098\uAC8C \uD0C0\uC918!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB85C\uD1A0\uBB34\uC790\uC804\uAC70\uB294\\n\uC2A4\uD30C\uD074\uB9C1 \uD654\uC774\uD2B8\uAC00 \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB85C\uD1A0\uBB34\uC790\uC804\uAC70\uB294\\n\uAE00\uB9AC\uD130\uB9C1 \uBE14\uB799\uC774 \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB85C\uD1A0\uBB34\uC790\uC804\uAC70\uB294\\n\uC6D0\uB798 \uB514\uC790\uC778\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB2E4\uB978 \uB514\uC790\uC778\uC73C\uB85C \uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD558\uACE0 \uC2F6\uC73C\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uCC3E\uC544\uC624\uB834"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAC89\uBAA8\uC2B5\uC774 \uBC14\uB00C\uBA74\\n\uAE30\uBD84\uB3C4 \uB2EC\uB77C\uC9C0\uC9C0!\\c\\n\uB108\uC758 \uC790\uC804\uAC70\uB97C\\n\uCEE4\uC2A4\uD130\uB9C8\uC774\uC988\uD574\uC904\uAE4C?"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uACB8\uC0AC\uACB8\uC0AC \uC790\uC804\uAC70\uC758 \uCC28\uC9C0 \uC18D\uB3C4\uB3C4\\n\uCD5C\uB300\uCE58\uB85C \uD574\uB480\uC5B4"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC0AC\uC774\uD074\uB9C1\uC288\uD2B8\uC758\\n\uCEEC\uB7EC\uB97C \uBC14\uAFB8\uACE0 \uC2F6\uB2C8?\\c\\n\uB124\uAC00 \uB370\uB9AC\uACE0 \uC788\uB294 [VAR 0101(0006)]\uC5D0\\n\uB9DE\uCDB0\uC11C \uCEEC\uB7EC\uB97C \uBC14\uAFD4\uC904\uAC8C!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB85C\uD1A0\uBB34 \uCEEC\uB7EC"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[VAR 0103(0004)] \uCEEC\uB7EC"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "[VAR 0103(0005)] \uCEEC\uB7EC"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB108\uC758 [VAR 0101(0006)]\uC5D0 \uB9DE\uCDB0\uC11C\\n[VAR 0103(0004)] \uCEEC\uB7EC\uB85C \uBC14\uAFB8\uB294 \uAC74 \uC5B4\uB54C?"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB108\uC758 [VAR 0101(0006)]\uC5D0 \uB9DE\uCDB0\uC11C\\n\uC5B4\uB290 \uCEEC\uB7EC\uB85C \uBC14\uAFB8\uACE0 \uC2F6\uB2C8?"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB108\uC758 [VAR 0101(0006)]\uC5D0 \uB9DE\uCDB0\uC11C\\n\uC5B4\uB290 \uCEEC\uB7EC\uB85C \uBC14\uAFB8\uACE0 \uC2F6\uB2C8?"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uB108\uC758 [VAR 0101(0006)]\uC5D0 \uB9DE\uCDB0\uC11C\\n\uC5B4\uB290 \uCEEC\uB7EC\uB85C \uBC14\uAFB8\uACE0 \uC2F6\uB2C8?"
  },
