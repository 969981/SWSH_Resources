    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC74C! \uBA4B\uC9C4 \uCEEC\uB7EC\uC57C!\\n\uC13C\uC2A4\uAC00 \uC88B\uC740 \uAC78!"
  },
