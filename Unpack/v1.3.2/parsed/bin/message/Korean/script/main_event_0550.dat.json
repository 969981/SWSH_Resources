[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC6B0\uB974!\\n\uAE30\uB2E4\uB824!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC74C\uBA54\uC5D0\uC5D0\uC5D0!!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC6B0\uB974\uB294\\n[VAR 0100(0000)][VAR 1900(0004)] \uBD80\uB52A\uD600\uC11C \uBA48\uCDC4\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC800\uAE30... \uD3EC\uCF13\uBAAC\uC758 \uBAB8\uD1B5\uBC15\uCE58\uAE30\uB97C\\n\uB9DE\uC73C\uC168\uB294\uB370 \uAD1C\uCC2E\uC73C\uC2E0\uAC00\uC694?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uB2F9\uC2E0\uC740 \uD639\uC2DC\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC774\uC2E0\uAC00\uC694?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB9DE\uC544\uC694!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC544\uB2C8\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uADF8\uB7EC\uC168\uAD70\uC694\\n\uAC1C\uD68C\uC2DD\uC5D0\uC11C \uB2F9\uC2E0\uC744 \uBD24\uAC70\uB4E0\uC694"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC774\uAC70 \uB18D\uB2F4\uB3C4 \uC798\uD558\uC2DC\uB294\uAD70\uC694...\\n\uC774\uBBF8 \uAC1C\uD68C\uC2DD\uC5D0\uC11C \uB2F9\uC2E0\uC744 \uBD24\uAC70\uB4E0\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC800\uB294 \uC544\uD0AC\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4\\c\\n\uD480\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC73C\uB85C\\n\uC2F8\uC6B0\uB294 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC8E0[VAR 0114(000E)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC774 \uCD94\uCC9C\uD588\uB2E4\uB294\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC758 \uC2E4\uB825...\\r\\n\uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C \uD655\uC778\uD574\uBCF4\uACA0\uC2B5\uB2C8\uB2E4\\c\\n\uCCB4\uC721\uAD00\uC740 \uC774 \uB3C4\uB85C\uB97C \uD1B5\uACFC\uD558\uBA74\\n\uBA40\uC9C0 \uC54A\uC740 \uACF3\uC5D0 \uC788\uC5B4\uC694[VAR 0114(000E)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC790! \uCCB4\uC721\uAD00\uC73C\uB85C \uB3CC\uC544\uAC00\uC790\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB4E4\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC73C\uB2C8\uAE4C[VAR 0114(000E)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC74C\uBA54\uC5D0~\u266A"
  }
]
