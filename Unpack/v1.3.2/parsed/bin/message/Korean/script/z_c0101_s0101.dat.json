[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5EC\uAE30\uB294 \uB9E4\uD06C\uB85C\uCF54\uC2A4\uBAA8\uC2A4 \uB808\uC77C\uC6E8\uC774\uC988\\n\uC11C\uBE44\uC2A4 \uCE74\uC6B4\uD130\uC785\uB2C8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB108\uB294 \uB9DB\uC788\uB294 \uAC8C \uC911\uC694\uD558\uB2C8?\\n\uBE68\uB9AC \uB098\uC624\uB294 \uAC8C \uC911\uC694\uD558\uB2C8?\\c\\n\uC544\uB2C8\uBA74 \uC2FC \uAC83\uC774 \uC911\uC694\uD558\uB2C8?\\n\uC804\uBD80 \uCC59\uAE30\uB824 \uD558\uB294 \uAC83\uC740 \uC695\uC2EC\uC774\uB780\uB2E4!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC751\uC6D0\uD558\uB290\uB77C \uBC30\uAC00 \uACE0\uD30C\uC84C\uC5B4!\\c\\n\uC774 \uD0C0\uC774\uBC0D\uC5D0 \uCC38\uC744 \uC218 \uC788\uB2E4\uBA74\\n\uB2E4\uC774\uC5B4\uD2B8\uB3C4 \uC26C\uC6B8 \uD150\uB370 \uB9D0\uC774\uC57C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB300\uD68C \uC704\uC6D0\uC7A5\uC778 \uB85C\uC988\uB2D8\uC740\\n\uB2E4\uC591\uD55C \uC77C\uC744 \uD558\uACE0 \uACC4\uC2E0\uB370\\r\\n\uD558\uB098\uAC19\uC774 \uAC00\uB77C\uB974\uB97C \uC704\uD55C \uC77C\uB4E4\uBFD0\uC774\uC57C"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC120\uB85C \uC704\uB97C \uACC4\uC18D\uD574\uC11C \uB2EC\uB9AC\uB294 \uAC83...\\c\\n\uC6B0\uC2B5\uAC8C \uBCF4\uC774\uAE30 \uC2ED\uC0C1\uC774\uC9C0\uB9CC \uD0C8\uC120\uD558\uC9C0 \uC54A\uACE0\\n\uB2EC\uB9AC\uB294 \uAC83\uC740 \uC5B4\uB824\uC6B4 \uC77C\uC774\uB78D\uB2C8\uB2E4"
  }
]
