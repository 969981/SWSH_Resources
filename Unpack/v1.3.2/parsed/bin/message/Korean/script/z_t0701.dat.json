[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB208\uC758 \uB9C8\uC744\uC5D0 \uC628 \uAC78 \uD658\uC601\uD55C\uB2E4!\\n\uB9C8\uC744 \uC774\uB984\uC740 \uC54C\uACE0 \uC788\uACA0\uC9C0?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD654\uC774\uD1A0\uC624!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB0B4 \uB54C\uB54C\uBB34\uB178\\n\uC628\uCC9C\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4 \uC624\uB354\uB2C8\\r\\n\uBAB8\uC774 \uB530\uB048\uB530\uB048\uD574\uC84C\uC5B4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD56B\uCE74!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBCFC\uC774\uB098 \uBC15\uC2A4 \uC548\uC5D0 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC740 \uCF8C\uC801\uD558\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC601\uC6C5\uC758 \uD0D5... \uC544\uC8FC \uC624\uB798\uC804\uBD80\uD130\\n\uC628\uCC9C\uC774 \uC19F\uC544\uB0AC\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758 \uC2DC\uD569\uC740\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uC788\uB294 \uBAA8\uB2C8\uD130\uB85C \uBCF4\uACE0 \uC788\uC5B4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB4DC\uB798\uACE4\uD0C0\uC785\uC740 \uCD94\uC704\uB97C \uD0C0\uB294\uC9C0\\n\uC5BC\uC74C\uD0C0\uC785\uC5D0 \uC57D\uD574"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADFC\uC721\uC774\uB2E4! \uADFC\uC721 \uC6B4\uB3D9\uC744 \uD558\uBA74\\n\uCD94\uC704\uB294 \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC9C0!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD558\uACE0 \uC788\uC744 \uB54C\\n\uC5BC\uC5B4\uBD99\uC73C\uBA74 \uC704\uAE30\uC57C! \uC6C0\uC9C1\uC77C \uC218 \uC5C6\uC5B4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB208\uC0AC\uB78C\uC740 \uD3EC\uCF13\uBAAC\uC774\uC57C?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC5BC\uC74C\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC740 \uC788\uC9C0\uB9CC\\n\uB208\uC0AC\uB78C \uBAA8\uC2B5\uC758 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uC5C8\uB098?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[~ 12]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB208\uC774 \uC62C \uB54C\uB294\\n\uC5BC\uC74C\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774 \uC798 \uC548 \uBCF4\uC5EC"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774 \uB4E4\uC5B4\uAC00\uB294 \uC628\uCC9C...\\n\uC624\uB298\uB3C4 \uC628\uB3C4\uAC00 \uC801\uB2F9\uD558\uAD70"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uCD94\uC6B0\uBA74 \uAE30\uBD84\uB3C4 \uAC00\uB77C\uC549\uC796\uC544\\c\\n\uADF8\uB798\uB3C4 \uB2EC\uB9C9\uD654\uB294 \uCC28\uAC00\uC6B8\uC218\uB85D\\n\uD798\uC744 \uBAA8\uC544\uB458 \uC218 \uC788\uC5B4\uC11C \uC88B\uC544"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uACE0\uB85C\uB871"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD788\uB77C\uD788\uB77C"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC288\uC640~"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB514\uB370\uB370"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCFE0~\uCFE0\uCFE0"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD6D9\uC640"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC815\uB9D0 \uC88B\uC544 \uC815\uB9D0 \uC88B\uC544~"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC8FC\uBAA9\uD558\uACE0 \uC788\uB294 \uAC74\\n\uD638\uBE0C \uC120\uC218\uC640 \uB9C8\uB9AC \uC120\uC218\uC57C"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "[VAR 0100(0000)] \uC120\uC218\uB3C4\\n\uC78A\uC73C\uBA74 \uC548 \uB3FC"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774 \uB4E4\uC5B4\uAC00\uB294 \uC628\uCC9C...\\n\uC624\uB298\uB3C4 \uC628\uB3C4\uAC00 \uC801\uB2F9\uD558\uAD70"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uBCBD\uD654\uC5D0 \uADF8\uB824\uC838 \uC788\uB294 \uAC70\\n\uD639\uC2DC \uD398\uB974\uC2DC\uC628 \uC544\uB2C8\uC57C?"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB3C4\uB3D7\uCF54\uC624!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB3CC\uD310\uC740 \uCC28\uAC00\uC6CC\uC11C\\n\uB208\uC774 \uC624\uBA74 \uBC14\uB85C \uC313\uC5EC"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uB098\uAC00\uC9C0 \uC54A\uC544\uB3C4\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uC990\uAE30\uB294 \uC0AC\uB78C\uC740\\r\\n\uB9CE\uC774 \uC788\uC5B4\\r\\n\uC560\uCD08\uC5D0 \uC2B9\uBD80\uB97C \uD558\uC9C0 \uC54A\uB294 \uC0AC\uB78C\uB3C4 \uC788\uACE0"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC601\uC6C5\uC774 \uC0C1\uCC98 \uC785\uC740 \uBAB8\uC744\\n\uCE58\uC720\uD558\uB358 \uC628\uCC9C\uC774\uB77C\uB294 \uAC83 \uAC19\uC544"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC2B9\uBD80\uC5D0\uC11C \uCD5C\uB300\uD55C\\n\uBD88\uD655\uC2E4\uD55C \uC694\uC18C\uB97C \uC81C\uAC70\uD574\uB3C4\\r\\n\uACB0\uC815\uC801\uC73C\uB85C \uADF8\uB54C\uC758 \uC6B4\uC774\uB77C\uB294 \uAC8C \uC791\uC6A9\uD574..."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC9C8 \uAC83 \uAC19\uB2E4! \uB77C\uB294 \uC0DD\uAC01\uC774 \uB4E4\uBA74\\n\uC0C1\uB300\uC758 \uAE09\uC18C\uB97C \uB9DE\uD600\uB77C!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC544\uC774\uC2A4\uC2A4"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB3C4\\n\uC774\uC81C \uC2AC\uC2AC \uB05D\uB098\uB294\uAD70"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uD1A0\uB108\uBA3C\uD2B8\uC5D0\uB294\\n\uB204\uAC00 \uB098\uAC00\uB294 \uAC78\uAE4C?"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uCC98\uC74C \uCC38\uAC00\uD574\uC11C\\n\uC6B0\uC2B9\uC774\uB77C\uB2C8 \uB300\uB2E8\uD574!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB208 \uB208 \uC88B\uC544"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uADF8\uAC74 \uB098\uC57C\\n\uD3EC\uCF13\uBAAC\uC774 \uADF8\uB807\uAC8C \uB9D0\uD588\uC5B4"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uBE44\uB294 \uD558\uB298\uC758 \uB208\uBB3C\\n\uADF8\uB7FC \uB208\uC740 \uBB50\uC9C0?"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB9C8\uC744 \uC21C\uCC30 \uC911\uC774\uC57C"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uAC78\uC5B4 \uB2E4\uB2C8\uBA74\\n\uC815\uB9D0 \uAC74\uAC15\uD574\uC9C4\uB2E8\uB2E4"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC18C\uD654\uC2DC\uD0AC \uACB8\\n\uAC78\uC5B4 \uB2E4\uB2C8\uB294 \uC911\uC774\uB780\uB2E4"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uB300\uBBF8\uC2DD\uAC00 \uBC25\uC5D0\uC11C \uBA39\uB294\\n\uCE74\uB808 \uD1A0\uD551!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uC2DD\uC7AC\uB8CC\uC640 \uBC25\uC744 \uCE74\uB808\uAC00\\n\uC798 \uC5B4\uC6B0\uB7EC\uC9C0\uAC8C \uD574\uC918!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uB2E4\uC591\uD55C \uB9DB\uC774\\n\uCE74\uB808\uB85C \uD558\uB098\uAC00 \uB41C\uB2E4"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uB3C4 \uC0AC\uB78C\uB3C4\\n\uAC74\uAC15\uC774 \uCD5C\uACE0!"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uAC74\uAC15\uD558\uBA74\\n\uBC30\uC9C0\uB3C4 \uB538 \uC218 \uC788\uC5B4!"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\\n\uBA4B\uC9C4 \uB300\uD68C\uC600\uC5B4"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC61B\uB0A0 \uC601\uC6C5\uC740\\n\uC628\uCC9C\uC744 \uC88B\uC544\uD588\uAD6C\uB098"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uC601\uC6C5\uC774\\n\uBB58 \uD588\uB294\uB370?"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC740\\n\uC601\uC6C5\uC774\uC57C?"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uC608\uB85C\uBD80\uD130 \uC804\uD574\uB0B4\uB824\uC624\uB294 \uC601\uC6C5\uC758 \uD0D5\\c\\n\uC774\uB984\uB300\uB85C \uC601\uC6C5\uC774\\n\uC0C1\uCC98\uB97C \uCE58\uC720\uD558\uAE30 \uC704\uD574 \uB4E4\uC5B4\uAC14\uC5C8\uB2E4"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uCD94\uC6B8 \uB54C \uAD73\uC774 \uCC3E\uC544\uC11C \uBA39\uB294\\n\uC544\uC774\uC2A4\uD06C\uB9BC\uB3C4 \uBCC4\uBBF8\uC9C0"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "[~ 54]"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uCD94\uC6B4 \uB9C8\uC744\uC774\uC57C\uB9D0\uB85C \uC5BC\uC74C\uD0C0\uC785\uC774 \uB531\uC774\uC57C!\\n\uB204\uB2C8\uBA38\uAE30 \uAC19\uC740 \uC560\uB4E4\uC744 \uBD10, \uC798 \uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uB2C8?"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uCD94\uC6B4 \uB9C8\uC744\uC774\uB2C8\uAE4C \uBD88\uAF43\uD0C0\uC785\uC774 \uB531\uC774\uC9C0!\\n\uD0DC\uC6B0\uC9C0\uB124\uC640 \uD568\uAED8 \uC788\uC73C\uBA74 \uB530\uB048\uB530\uB048\uD558\uB2E4\uACE0!"
  }
]
