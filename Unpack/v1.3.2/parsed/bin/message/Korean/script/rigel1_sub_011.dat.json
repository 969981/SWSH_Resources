[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB514..."
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB514!?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "......"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB514... \uB514..."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4 \uB2E4~\uC557!!!!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC557~! \uB514\uADF8\uB2E4!\\n\uC774\uB7F0 \uACF3\uC5D0 \uC788\uC5C8\uAD6C\uB098!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD558\uD558\uD558! \uC774 \uB140\uC11D!\\n\uAC71\uC815\uD588\uC796\uC544!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB514\uAE0B!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC81C \uB514\uADF8\uB2E4\uB97C\\n\uCC3E\uC544\uC918\uC11C \uACE0\uB9C8\uC6CC\uC694"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC54C\uB85C\uB77C?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774 \uB140\uC11D\uC740\\n\uC54C\uB85C\uB77C\uC9C0\uBC29\uC758 \uB514\uADF8\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC9C0\uBC29\uC5D0 \uB530\uB77C \uBAA8\uC2B5\uC774 \uB2E4\uB978\\n\uB9AC\uC804\uD3FC\uC774\uB77C\uB294 \uAC81\uB2C8\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC624\uC624! \uC124\uB9C8 \uC774\uB7F0 \uACF3\uC5D0\uC11C \uB9AC\uC804\uD3FC\uC744\\n\uC54C\uC544\uBCF4\uC2DC\uB294 \uBD84\uC744 \uB9CC\uB098\uAC8C \uB420 \uC904\uC774\uC57C!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB9DE\uC544\uC694! \uB9D0\uC500\uD558\uC2E0 \uAC83\uCC98\uB7FC\\n\uC774 \uB140\uC11D\uC740 \uC54C\uB85C\uB77C\uC9C0\uBC29\uC758 \uB514\uADF8\uB2E4\uC785\uB2C8\uB2E4"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC54C\uB85C\uB77C\uB97C \uC5EC\uD589\uD588\uC744 \uB54C\\n\uC774 \uC138 \uAC00\uB2E5 \uD138\uC5D0 \uADF8\uB9CC\\r\\n\uB9C8\uC74C\uC744 \uBE7C\uC557\uAE30\uACE0 \uB9D0\uC558\uAC70\uB4E0\uC694"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC794\uB729 \uC7A1\uC544\uC11C \uB3CC\uC544\uC654\uB294\uB370...\\c\\n\uC7A0\uAE50 \uD55C\uB208\uC744 \uD310 \uC0AC\uC774\uC5D0\\n\uB2E4\uB4E4 \uC5B4\uB518\uAC00\uB85C \uC0AC\uB77C\uC838\uBC84\uB9B0 \uAC70\uC608\uC694"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB514\uADF8\uB9BF!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uB545\uC18D\uC5D0 \uC228\uC740\\n\uB514\uADF8\uB2E4\uB97C \uCC3E\uC544\uB0BC \uC904\uC774\uC57C..."
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC740 \uB514\uADF8\uB2E4\uB97C \uBC1C\uACAC\uD574\uB0B4\uB294\\n\uC7AC\uB2A5\uC774 \uC788\uAD70\uC694!!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD639\uC2DC \uB2E4\uB978 \uB514\uADF8\uB2E4\uB3C4\\n\uCC3E\uC544\uC8FC\uC2DC\uACA0\uC5B4\uC694...?"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uCE5C\uC808\uD558\uC2E4 \uC218\uAC00!\\n\uBB50\uB77C\uACE0 \uAC10\uC0AC\uB4DC\uB824\uC57C \uD560\uC9C0 \uBAA8\uB974\uACA0\uB124\uC694!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB108\uBB34 \uC5B4\uB824\uC6CC\uD558\uC2E4 \uAC83 \uC5C6\uC5B4\uC694!\\n\uC5EC\uD589\uD558\uB2E4\uAC00 \uC138 \uAC00\uB2E5 \uD138\uC744 \uBCF4\uAC8C \uB418\uBA74\\r\\n\uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC2DC\uAE30\uB9CC \uD558\uBA74 \uB418\uB2C8\uAE4C\uC694"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uB514\uADF8\uB2E4 [VAR 0202(0001)]\uB9C8\uB9AC\uB97C\\n\uCC3E\uC544\uC8FC\uC168\uC73C\uB2C8\uAE4C\\r\\n\uB0A8\uC740 \uB514\uADF8\uB2E4\uB294 [VAR 0202(0002)]\uB9C8\uB9AC\uC785\uB2C8\uB2E4"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uBC1C\uACAC\uD558\uBA74 \uB3CC\uC544\uAC00\uB77C\uACE0\\n\uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC138\uC694!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uBC1C\uACAC\uD558\uBA74 \uB3CC\uC544\uAC00\uB77C\uACE0\\n\uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC138\uC694!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC544! \uC548\uB155\uD558\uC138\uC694!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB355\uBD84\uC5D0 \uC0C8\uB85C\\n\uB514\uADF8\uB2E4 [VAR 0202(0001)]\uB9C8\uB9AC\uAC00\\r\\n\uB3CC\uC544\uC654\uC5B4\uC694!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uAC1C\uC911\uC5D0\uB294 \uB2E5\uD2B8\uB9AC\uC624\uB85C\\n\uC9C4\uD654\uD55C \uB140\uC11D\uB3C4 \uC788\uC5C8\uC9C0\uB9CC\uC694..."
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB610 \uC138 \uAC00\uB2E5 \uD138\uC744 \uBC1C\uACAC\uD558\uC2DC\uBA74\\n\uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4\uAC00 \uC794\uB729\\n\uB3CC\uC544\uC640\uC11C \uAE30\uC058\uB124\uC694"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC774 \uD3EC\uCF13\uBAAC\uC744\\n\uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4\uC640 \uB9C8\uCC2C\uAC00\uC9C0\uB85C\\n\uC54C\uB85C\uB77C\uC9C0\uBC29\uC5D0\uC11C \uB9CC\uB09C \uD3EC\uCF13\uBAAC\uC785\uB2C8\uB2E4"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC774 \uB3C4\uAD6C\uB97C\\n\uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC74C \uADF8\uB7EC\uB2C8\uAE4C...\\n\uC9C0\uAE08\uAE4C\uC9C0 \uB3CC\uC544\uC628 \uB514\uADF8\uB2E4\uB294..."
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC5D0\uC5E5!? \uCD1D 151\uB9C8\uB9AC!?"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uACE0\uB9D9\uC2B5\uB2C8\uB2E4!\\n\uB355\uBD84\uC5D0 \uC81C \uB514\uADF8\uB2E4\uAC00\\r\\n\uBAA8\uB450 \uB3CC\uC544\uC654\uC5B4\uC694!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uB514\uC2A4\uD399!"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uB97C \uBAA8\uB450 \uCC3E\uC544\uB0B4\uB2E4\uB2C8\\n\uB108\uC5D0\uAC8C \uC874\uACBD\uC744 \uD45C\uD55C\uB2E4...\\r\\n\uB77C\uACE0 \uB9D0\uD558\uB294 \uAC83 \uAC19\uB124\uC694"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB514\uC6B0\uAC8C\uB354!"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC557! \uC874\uACBD\uD558\uB294\\n\uC774 \uD2B8\uB808\uC774\uB108\uB2D8\uC744\\r\\n\uB530\uB77C\uAC00\uACE0 \uC2F6\uB2E4\uACE0!?"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uB514\uC787!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC74C~\\n\uC870\uAE08 \uC2AC\uD504\uAE34 \uD558\uC9C0\uB9CC..."
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uADF8\uAC8C \uC774 \uB140\uC11D\uC758 \uBC14\uB78C\uC774\uB77C\uBA74\\n\uC800\uB3C4 \uC751\uC6D0\uD574\uC57C\uACA0\uC8E0!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4\uB97C \uC798 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4\uB294\\n[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC\uC774 \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4\uB294\\n\uC798 \uC9C0\uB0B4\uACE0 \uC788\uB098\uC694?\\c\\n\uC800\uD76C\uB3C4 \uB5A0\uB4E4\uC369\uD558\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uC5B4\uC694\\n150\uB9C8\uB9AC\uB098 \uC788\uC73C\uB2C8\uAE4C\uC694"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uB514... \uB514..."
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4 \uB2E4~\uC557!"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uB514\uADF8\uD574\uB530~!"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uB514\uAE30\uC789~!"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uB514\uC464\uC6B1!"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uB514\uC640\uB530\uC557~!"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uB514\uB514~\uC789!"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uB514\uB098\uB530~!"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uB514 \uB514 \uB514 \uB514!"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uB514\uBBF8\uAE00\uB77C\uC2A4!"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uB514\uB2E4\uB124~!!"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "...\uB514?"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uB514\uBC14\uC774\uB514!"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uB514\uC77C\uB9AC!"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uB514\uC640\uB545!"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uB514\uC640\uB610~!"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uB514\uC5D4\uB4DC!"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uB514\uD0C0\uB098\uB530!"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uB514\uC640~\uB530!"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uB514\uC774\uADF8!"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "...\uB514\uC640\uB530!!"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\uB514\uC789 \uB529\uB529!\\n\uB514\uB529 \uB514\uB529!!"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\uB760\uB529~"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uB514\uC601\uCC28!"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uB514\uB530\uB514\uB530\uB514\uC640\uB530!"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4\uC57C!"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uB514\uAC00\uAE30\uC2DC\uB7EC!"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uB514\uC774\uD1A0\uB098!"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uC790\uB77C\uB098\uB77C\uC557~!!"
  },
  {
    "index": 78,
    "flags": 0,
    "text": "\uB514\uADF8\uB2E4\uB294 \uD2B8\uB808\uC774\uB108\uAC00\\n\uC788\uB294 \uACF3\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4..."
  },
  {
    "index": 79,
    "flags": 0,
    "text": "\uB2E5\uD2B8\uB9AC\uC624\uB294 \uD2B8\uB808\uC774\uB108\uAC00\\n\uC788\uB294 \uACF3\uC73C\uB85C \uB3CC\uC544\uAC14\uB2E4..."
  },
  {
    "index": 80,
    "flags": 0,
    "text": "[VAR 0105(0001)]\uC5D0 \uC788\uB294\\n\uB514\uADF8\uB2E4\uB294 \uC55E\uC73C\uB85C [VAR 0201(0002)]\uB9C8\uB9AC!"
  },
  {
    "index": 81,
    "flags": 0,
    "text": "[VAR 0105(0001)]\uC5D0 \uC788\uB294\\n\uB514\uADF8\uB2E4\uB97C \uBAA8\uB450 \uBC1C\uACAC\uD588\uB2E4!"
  },
  {
    "index": 82,
    "flags": 0,
    "text": "\uC778\uC0AC\uC758 \uB4E4\uD310"
  },
  {
    "index": 83,
    "flags": 0,
    "text": "\uCCAD\uB7C9\uD55C \uC2B5\uC9C0\uCD08\uC6D0"
  },
  {
    "index": 84,
    "flags": 0,
    "text": "\uC9D1\uC911\uC758 \uC232"
  },
  {
    "index": 85,
    "flags": 0,
    "text": "\uCC4C\uB9B0\uC9C0\uBE44\uCE58"
  },
  {
    "index": 86,
    "flags": 0,
    "text": "\uD30C\uC774\uD2B8\uCF00\uC774\uBE0C"
  },
  {
    "index": 87,
    "flags": 0,
    "text": "\uCC4C\uB9B0\uC9C0\uB85C\uB4DC"
  },
  {
    "index": 88,
    "flags": 0,
    "text": "\uD22C\uC9C0\uC758 \uB3D9\uAD74"
  },
  {
    "index": 89,
    "flags": 0,
    "text": "\uC6D0\uD658\uC758 \uB9CC"
  },
  {
    "index": 90,
    "flags": 0,
    "text": "\uB2E8\uB828 \uD3C9\uC6D0"
  },
  {
    "index": 91,
    "flags": 0,
    "text": "\uC5F0\uC2B5\uC758 \uB3D9\uAD74"
  },
  {
    "index": 92,
    "flags": 0,
    "text": "\uB0C4\uBE44\uBC14\uB2E5\uC0AC\uB9C9"
  },
  {
    "index": 93,
    "flags": 0,
    "text": "\uC6CC\uD06C\uC544\uC6C3 \uBC14\uB2E4"
  },
  {
    "index": 94,
    "flags": 0,
    "text": "\uC5F4\uB3C4 \uBC14\uB2E4"
  },
  {
    "index": 95,
    "flags": 0,
    "text": "\uC678\uB534\uC12C \uD574\uC5ED"
  },
  {
    "index": 96,
    "flags": 0,
    "text": "\uD5C8\uB2C8\uCEF4 \uBC14\uB2E4"
  },
  {
    "index": 97,
    "flags": 0,
    "text": "\uD5C8\uB2C8\uCEF4\uC12C"
  },
  {
    "index": 98,
    "flags": 0,
    "text": "\uFF5E\uFF5E\uB0A8\uC740 \uB514\uADF8\uB2E4\uFF5E\uFF5E\\n\uC778\uC0AC\uC758 \uB4E4\uD310: [VAR 0201(0001)]\uB9C8\uB9AC\\n\uCCAD\uB7C9\uD55C \uC2B5\uC9C0\uCD08\uC6D0: [VAR 0201(0002)]\uB9C8\uB9AC\\n\uC9D1\uC911\uC758 \uC232: [VAR 0201(0003)]\uB9C8\uB9AC\\n\uCC4C\uB9B0\uC9C0\uBE44\uCE58: [VAR 0201(0004)]\uB9C8\uB9AC"
  },
  {
    "index": 99,
    "flags": 0,
    "text": "\uFF5E\uFF5E\uB0A8\uC740 \uB514\uADF8\uB2E4\uFF5E\uFF5E\\n\uD30C\uC774\uD2B8\uCF00\uC774\uBE0C: [VAR 0201(0001)]\uB9C8\uB9AC\\n\uCC4C\uB9B0\uC9C0\uB85C\uB4DC: [VAR 0201(0002)]\uB9C8\uB9AC\\n\uD22C\uC9C0\uC758 \uB3D9\uAD74: [VAR 0201(0003)]\uB9C8\uB9AC\\n\uC6D0\uD658\uC758 \uB9CC: [VAR 0201(0004)]\uB9C8\uB9AC"
  },
  {
