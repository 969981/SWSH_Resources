[
  {
    "index": 0,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uB098\uC639\uC774\\n\uC880\uCC98\uB7FC \uC7A1\uD788\uC9C8 \uC54A\uB124...\\c\\n\uB108 \uD639\uC2DC \uAC00\uB77C\uB974\uC758 \uB098\uC639\uC744 \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uB0B4 \uB098\uC639\uACFC \uAD50\uD658\uD558\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC640\uC544 \uADC0\uC5FD\uB2E4!\\n\uADF8 \uC544\uC774\uB85C \uAD50\uD658\uD560 \uAC70\uC57C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098! \uB098\uC911\uC5D0\uB77C\uB3C4\\n\uB9C8\uC74C\uC774 \uBC14\uB00C\uBA74 \uAD50\uD658\uD574\uC918!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC640\uC544! \uAFC8\uC5D0 \uADF8\uB9AC\uB358\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uB098\uC639\uC774\uB2E4!\\c\\n\uAC19\uC740 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB3C4\\n\uD0DC\uC5B4\uB09C \uC9C0\uBC29\uC5D0 \uB530\uB77C\\r\\n\uBAA8\uC2B5\uC774\uB098 \uD0C0\uC785\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uAD6C\uB098!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uB098\uC639\uC744 \uAD50\uD658\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC!\\n\uCA4C\uB2C8\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uB2C8?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B4\uB77C?\\n\uB108 \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uC796\uC544?\\c\\n\uAD50\uD658\uD558\uACE0 \uC2F6\uC73C\uBA74\\n2\uB9C8\uB9AC\uB294 \uB370\uB824\uC640\uC57C \uD574"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCA4C\uB2C8"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC870\uBC18\uB2C8"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD639\uC2DC \uD30C\uB974\uBE57\uC774 \uC788\uB2E4\uBA74\\n\uB0B4 \uD0D0\uB9AC\uC2A4\uC640\\r\\n\uAD50\uD658\uD558\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC640\uC544! \uADF8 \uC544\uC774\uC640\\n\uAD50\uD658\uD574\uC904 \uAC70\uC57C?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC5B4\uBA38 \uADF8\uAC70 \uC544\uC27D\uB124!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB108\uC758 \uD30C\uB974\uBE57\\n\uC18C\uC911\uD558\uAC8C \uD0A4\uC6B8\uAC8C!\\c\\n\uB0B4 \uD0D0\uB9AC\uC2A4\uB3C4\\n\uC18C\uC911\uD558\uAC8C \uD0A4\uC6CC\uC918!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB124\uAC00 \uAD50\uD658\uD574\uC900 \uD30C\uB974\uBE57\\n\uB9E4\uC77C\uAC19\uC774 \uADC0\uC5EC\uC6CC\uD574 \uC8FC\uACE0 \uC788\uC5B4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uB124?\\c\\n\uAD50\uD658\uD558\uACE0 \uC2F6\uC73C\uBA74\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 2\uB9C8\uB9AC \uC774\uC0C1\uC740 \uB3FC\uC57C \uD574!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uBCFC\uB561\uC774"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uCD08\uBBF8"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB108 \uD639\uC2DC \uCE58\uB77C\uBBF8\uB97C \uAC00\uC9C0\uACE0 \uC788\uB2C8?\\n\uAD1C\uCC2E\uB2E4\uBA74 \uB0B4 \uC18C\uBBF8\uC548\uACFC\\r\\n\uAD50\uD658\uD558\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uADF8 \uCE58\uB77C\uBBF8\uB85C\\n\uAD50\uD658\uD574\uC904 \uAC70\uB2C8?"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBB50\uC57C \uAD50\uD658\uD574\uC8FC\uC9C0 \uC54A\uB294 \uAC70\uC57C?"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!\\n\uC815\uB9D0 \uAE30\uBED0!\\r\\n\uB9CE\uC774 \uB9CE\uC774 \uADC0\uC5EC\uC6CC\uD574 \uC904\uAC8C!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCE58\uB77C\uBBF8\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4!\\n\uC18C\uBBF8\uC548\uB3C4 \uADC0\uC5EC\uC6CC\uD574 \uC918!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC774\uB7F0~ \uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774\\n1\uB9C8\uB9AC\uBFD0\uC774\uBA74 \uAD50\uD658\uD560 \uC218 \uC5C6\uC5B4\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 2\uB9C8\uB9AC \uC774\uC0C1\uC77C \uB54C\\n\uB2E4\uC2DC \uAD50\uD658\uD558\uB7EC \uC640\uC918"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC19C\uC0AC\uD0D5"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB9C8\uC774\uB4DC"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC77C\uB808\uC98C \uC815\uB9D0 \uBA4B\uC9C0\uC9C0 \uC54A\uB2C8?\\n\uAF2D \uD55C\uBC88 \uD0A4\uC6CC\uBCF4\uACE0 \uC2F6\uC5B4!\\c\\n\uD639\uC2DC \uC77C\uB808\uC98C\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4\uBA74\\n\uB0B4 \uD1A0\uAC8C\uD53C\uC640 \uAD50\uD658\uD574\uC8FC\uC9C0 \uC54A\uC744\uB798...?"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC640 \uBA4B\uC9C0\uB2E4...!\\n\uADF8 \uC77C\uB808\uC98C\uC73C\uB85C \uAD50\uD658\uD574\uC904 \uAC70\uC57C?"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098... \uBA4B\uC9C0\uB2C8\uAE4C\\n\uB193\uCE58\uACE0 \uC2F6\uC9C0 \uC54A\uACA0\uC9C0..."
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC640\uC544! \uAFC8\uC5D0 \uADF8\uB9AC\uB358\\n\uC77C\uB808\uC98C\uC774\uB2E4!\\r\\n\uC18C\uC911\uD558\uAC8C \uD0A4\uC6B8\uAC8C!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uC77C\uB808\uC98C\uC740\\n\uC465\uC465 \uD06C\uACE0 \uC788\uC5B4\\c\\n\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C\uC11C \uBC1B\uC740\\n\uD3EC\uCF13\uBAAC\uC740 \uC131\uC7A5\uD558\uAE30 \uC27D\uAC70\uB4E0"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774\\n1\uB9C8\uB9AC\uBFD0\uC774\uBA74 \uAD50\uD658\uD560 \uC218 \uC5C6\uC5B4\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 2\uB9C8\uB9AC \uC774\uC0C1\uC774 \uB418\uBA74\\n\uADF8\uB54C \uBD80\uD0C1\uD560\uAC8C"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD1A0\uAC8C\uD478\uB9C1"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uBCF4\uD76C"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB108 \uD639\uC2DC \uB9C8\uB77C\uCE74\uCE58\uB97C\\n\uB9CE\uC774 \uC7A1\uC9C4 \uC54A\uC558\uB2C8?\\c\\n\uAD1C\uCC2E\uB2E4\uBA74 \uB0B4 \uBAB8\uC9C0\uBE0C\uB9BC\uACFC\\n\uAD50\uD658\uD574\uC8FC\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uADF8 \uC544\uC774\uB85C \uAD50\uD658\uD574\uC904 \uAC70\uB2C8?"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uB9C8\uC74C\uC774 \uBC14\uB00C\uBA74\\n\uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5B4\uC918"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC774\uB7F0 \uAC8C \uAD50\uD658\uC758 \uBB18\uBBF8\uC9C0!\\c\\n\uD2B8\uB808\uC774\uB108 \uAC04\uC758\\n\uD6CC\uB96D\uD55C \uAE30\uBE0C \uC564 \uD14C\uC774\uD06C\uC600\uC5B4!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uB0B4\uAC8C\uB294 \uB9CE\uC774 \uC7A1\uC544\uC11C\\n\uD754\uD574 \uBCF4\uC774\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\c\\n\uB204\uAD70\uAC00\uC5D0\uAC8C\uB294\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC77C \uC218\uB3C4 \uC788\uC5B4\\r\\n\uADF8\uB7F4 \uB54C \uAD50\uD658\uC774 \uB9CE\uC740 \uB3C4\uC6C0\uC744 \uC8FC\uC9C0"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uC5B4\\c\\n\uAD50\uD658\uC744 \uD560 \uAC70\uBA74\\n\uD3EC\uCF13\uBAAC\uC744 \uB354 \uB370\uB9AC\uACE0 \uC624\uB834"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC554\uBAA8\uB9AC"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uB85C\uBBF8\uC624"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uB108 \uD639\uC2DC \uB9C8\uB77C\uCE74\uCE58\uB97C\\n\uB9CE\uC774 \uC7A1\uC9C4 \uC54A\uC558\uB2C8?\\c\\n\uAD1C\uCC2E\uB2E4\uBA74 \uB0B4 \uBA54\uB871\uAFCD\uACFC\\n\uAD50\uD658\uD574\uC8FC\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uADF8 \uC544\uC774\uB85C \uAD50\uD658\uD574\uC904 \uAC70\uB2C8?"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uB9C8\uC74C\uC774 \uBC14\uB00C\uBA74\\n\uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5B4\uC918"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uC774\uB7F0 \uAC8C \uAD50\uD658\uC758 \uBB18\uBBF8\uC9C0!\\c\\n\uD2B8\uB808\uC774\uB108 \uAC04\uC758\\n\uD6CC\uB96D\uD55C \uAE30\uBE0C \uC564 \uD14C\uC774\uD06C\uC600\uC5B4!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uB0B4\uAC8C\uB294 \uB9CE\uC774 \uC7A1\uC544\uC11C\\n\uD754\uD574 \uBCF4\uC774\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\c\\n\uB204\uAD70\uAC00\uC5D0\uAC8C\uB294\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC77C \uC218\uB3C4 \uC788\uC5B4\\r\\n\uADF8\uB7F4 \uB54C \uAD50\uD658\uC774 \uB9CE\uC740 \uB3C4\uC6C0\uC744 \uC8FC\uC9C0"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uC5B4\\c\\n\uAD50\uD658\uC744 \uD560 \uAC70\uBA74\\n\uD3EC\uCF13\uBAAC\uC744 \uB354 \uB370\uB9AC\uACE0 \uC624\uB834"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uB3C4\uB9AC\uB3C4\uB9AC"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uB85C\uBBF8\uC624"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uB108 \uD639\uC2DC \uAC00\uB77C\uB974\uC5D0\uC11C \uC7A1\uC740\\n\uB370\uC2A4\uB9C8\uC2A4\uB97C \uAC00\uC9C0\uACE0 \uC788\uB2C8?\\c\\n\uAD1C\uCC2E\uB2E4\uBA74\\n\uB0B4\uAC00 \uD574\uC678\uC5D0\uC11C \uC7A1\uC740\\r\\n\uB370\uC2A4\uB9C8\uC2A4\uC640 \uAD50\uD658\uD574\uC8FC\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC120\uD0DD\uD55C \uB370\uC2A4\uB9C8\uC2A4\uB85C\\n\uAD50\uD658\uD574\uC904 \uAC70\uC57C?"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uC2E4\uB9DD\uC774\uC57C..."
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uD6C4\uD6C4~ \uACE0\uB9C8\uC6CC!\\n\uB355\uBD84\uC5D0 \uC88B\uC740 \uAD50\uD658\uC744 \uD588\uC5B4!"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC7A1\uC740\\n\uB9E4\uC6B0 \uD76C\uADC0\uD55C \uB370\uC2A4\uB9C8\uC2A4\uB294\\r\\n\uCC29\uD558\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uC9C0?"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC5B4\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC744 \uB354 \uB370\uB9AC\uACE0\\n\uB2E4\uC2DC \uC640\uC918"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uCE74\uBA74"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uC774\uBE0C"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uBC14\uB2D0\uB9AC\uCE58\uB97C \uC7A1\uACE0 \uC2F6\uC740\uB370\\n\uB098\uB3C4 \uC774\uC820 \uB098\uC774\uAC00 \uB9CE\uC544\uC11C \uB9D0\uC774\uB2E4\\c\\n\uB0B4 \uB358\uC9C0\uBBF8\uB97C \uBC14\uB2D0\uB9AC\uCE58\uC640\\n\uAD50\uD658\uD574\uC904 \uC0AC\uB78C\uC774 \uC788\uB2E4\uBA74\\r\\n\uCC38 \uC88B\uACA0\uB294\uB370 \uB9D0\uC774\uC57C..."
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uD638\uD638~ \uADF8 \uC544\uC774\uB85C\\n\uAD50\uD658\uD574\uC904 \uAC8C\uB0D0?"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uB2E4\uB978 \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C\\n\uBD80\uD0C1\uD574\uC57C\uACA0\uAD6C\uBA3C..."
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uD638\uD638! \uD760\uC7A1\uC744 \uB370 \uC5C6\uB294 \uBC14\uB2D0\uB9AC\uCE58\uB85C\uAD6C\uB098\\n\uC815\uB9D0 \uACE0\uB9D9\uB2E4!"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uD638\uD638! \uBC14\uB2D0\uB9AC\uCE58\uB294 \uCC38 \uADC0\uC5FD\uAD6C\uB098\\n\uD3C9\uC0DD\uC744 \uAC19\uC774\uD558\uACE0 \uC2F6\uC744 \uC815\uB3C4\uC57C!"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uBBF8\uC548\uD558\uAD6C\uB098\\n\uAD50\uD658\uD558\uACE0 \uC2F6\uB2E4\uBA74\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC744 2\uB9C8\uB9AC \uC774\uC0C1\\n\uC900\uBE44\uD574\uC11C \uB2E4\uC2DC \uC624\uAC70\uB77C"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uC801\uC9C0\uBBF8"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uBC31\uC124"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uBC14\uB2D0\uB9AC\uCE58\uB97C \uC7A1\uACE0 \uC2F6\uC740\uB370\\n\uB098\uB3C4 \uC774\uC820 \uB098\uC774\uAC00 \uB9CE\uC544\uC11C \uB9D0\uC774\uB2E4\\c\\n\uB0B4 \uD0C0\uACA9\uADC0\uB97C \uBC14\uB2D0\uB9AC\uCE58\uC640\\n\uAD50\uD658\uD574\uC904 \uC0AC\uB78C\uC774 \uC788\uB2E4\uBA74\\r\\n\uCC38 \uC88B\uACA0\uB294\uB370 \uB9D0\uC774\uC57C..."
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uD638\uD638~ \uADF8 \uC544\uC774\uB85C\\n\uAD50\uD658\uD574\uC904 \uAC8C\uB0D0?"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uB2E4\uB978 \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C\\n\uBD80\uD0C1\uD574\uC57C\uACA0\uAD6C\uBA3C..."
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uD638\uD638! \uD760\uC7A1\uC744 \uB370 \uC5C6\uB294 \uBC14\uB2D0\uB9AC\uCE58\uB85C\uAD6C\uB098\\n\uC815\uB9D0 \uACE0\uB9D9\uB2E4!"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\uD638\uD638! \uBC14\uB2D0\uB9AC\uCE58\uB294 \uCC38 \uADC0\uC5FD\uAD6C\uB098\\n\uD3C9\uC0DD\uC744 \uAC19\uC774\uD558\uACE0 \uC2F6\uC744 \uC815\uB3C4\uC57C!"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\uBBF8\uC548\uD558\uAD6C\uB098\\n\uAD50\uD658\uD558\uACE0 \uC2F6\uB2E4\uBA74\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC744 2\uB9C8\uB9AC \uC774\uC0C1\\n\uC900\uBE44\uD574\uC11C \uB2E4\uC2DC \uC624\uAC70\uB77C"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\uD478\uB974\uADC0"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\uBC31\uC124"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uAD50\uD658\uC744\\n\uBD80\uD0C1\uB4DC\uB9AC\uACE0 \uC2F6\uC5B4\uC694\\c\\n\uB2F9\uC2E0\uC758 \uAC00\uB85C\uB9C9\uAD6C\uB9AC\uC640\\n\uC81C \uAD00\uB3D9\uC9C0\uBC29\uC758 \uB9C8\uC784\uB9E8\uC744\\r\\n\uAD50\uD658\uD574\uC8FC\uC2DC\uC9C0 \uC54A\uC744\uB798\uC694?"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uADF8 \uAC00\uB85C\uB9C9\uAD6C\uB9AC\uB85C\\n\uAD50\uD658\uD574\uC8FC\uC2E4 \uAC74\uAC00\uC694?"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB2E4\uC74C \uAE30\uD68C\uB85C \uBBF8\uB8E8\uC8E0"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uC815\uB9D0 \uAC10\uACA9\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4! \uAC10\uC0AC\uD569\uB2C8\uB2E4!\\n\uB2F9\uC2E0\uC758 \uAC00\uB85C\uB9C9\uAD6C\uB9AC\\c\\n\uD3C9\uC0DD \uC18C\uC911\uD558\uAC8C \uD0A4\uC6B0\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uB2E4\uB978 \uC0AC\uB78C\uC758 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB3C4\\n\uB2C9\uB124\uC784\uC774 \uBD99\uC5B4 \uC788\uC9C0 \uC54A\uB2E4\uBA74\\c\\n1\uBC88\uB9CC \uB2C9\uB124\uC784\uC744\\n\uBD99\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4\\c\\n\uC81C \uB9C8\uC784\uB2D8\uC740 \uB2C9\uB124\uC784\uC774\\n\uBD99\uC5B4 \uC788\uC5B4\uC11C \uBD88\uAC00\uB2A5\uD558\uC9C0\uB9CC \uB9D0\uC774\uC8E0!"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uAD50\uD658\uC744 \uD558\uAE30\uC5D0\uB294\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 \uBD80\uC871\uD558\uAD70\uC694\\c\\n\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC744\\n2\uB9C8\uB9AC \uC774\uC0C1 \uC900\uBE44\uD574\uC624\uC2DC\uBA74\\r\\n\uAD50\uD658\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4..."
