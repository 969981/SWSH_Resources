[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC0C1\uB300\uAC00 \uC2A4\uC2B9\uB2D8\uC77C\uC9C0\uB77C\uB3C4\\n\uC6B0\uB9AC\uC758 \uD300\uD50C\uB808\uC774\uB85C \uD391! \uB0A0\uB824\uBC84\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0072)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uC88B\uB2E4, \uC138\uC774\uBC84\uB9AC!\\n\uC804\uB825\uC744 \uB2E4\uD574\uC11C \uC0C1\uB300\uD574\uC8FC\uB9C8![VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5D0\uC2A4\uD37C\uB97C \uC800\uBC84\uB9B0 \uC5B4\uB9AC\uC11D\uC740 \uC790\uC758\\n\uD300\uC5D0\uAC8C\uB294 \uC9C8 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4![VAR 0114(0072)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC81C \uB355\uBD84\uC5D0 \uC5D0\uC2A4\uD37C\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774 \uB41C \uAC70\uB2C8\\n\uC624\uD788\uB824 \uACE0\uB9C8\uC6CC\uD574\uC57C \uD558\uB294 \uAC70 \uC544\uB2CC\uAC00\uC694?[VAR 0114(000C)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC2E0\uC778 \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uAC04\uC758 \uBC30\uD2C0\uC774\uB2C8\uAE4C\\n\uB108\uD76C \uD300\uC5D0\uAC8C\uB294 \uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC57C![VAR 0114(000D)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC800\uB294 \uC5D8\uB808\uAC15\uC2A4\uD568\uB3C4 \uAD00\uC7A5\uAE09\uC774\uB2C8\uAE4C\\n\uC774\uBC88 \uC2B9\uBD80\uB294 \uC6B0\uB9AC\uC758 \uC555\uC2B9\uC774\uACA0\uB124\uC694[VAR 0114(0072)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC5D0\uAC8C\uC11C \uC800\uC640 \uBE44\uC2B7\uD55C\\n\uC140\uB7EC\uBE0C\uB9AC\uD2F0\uD568\uC774 \uB290\uAEF4\uC9C0\uB294\uAD70\uC694[VAR 0114(0069)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB294 \uB2F9\uC2E0\uB3C4 \uCC38\uC73C\uB85C \uC5D8\uB808\uAC15\uC2A4\uD558\uB124\uC694\\n\uBA4B\uC7C1\uC774\uCE74\uB4DC\uC758 \uC0AC\uC6A9\uC790\uC778\uAC00 \uBCF4\uC8E0...?[VAR 0114(0072)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC2A4\uC2B9\uB2D8! \uC6B0\uC5F0\uD788 \uC774\uAE30\uB354\uB77C\uB3C4\\n\uBB50\uB77C \uD558\uAE30 \uC5C6\uAE30\uC608\uC694![VAR 0114(0071)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC6B4\uB3C4 \uC6B0\uC5F0\uB3C4 \uBAA8\uB450 \uC2E4\uB825\uC774\uC9C0!\\n\uC4F0\uB7EC\uB728\uB9B4 \uAC01\uC624\uB85C \uB364\uBE44\uAC70\uB77C~![VAR 0114(0073)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC544\uD558\uD558! \uBE44\uD2B8~\\n\uC0B4\uC0B4 \uBD80\uD0C1\uD560\uAC8C~![VAR 0114(0071)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC758 \uB3C5\uC740 \uC131\uAC00\uC2DC\uB2C8\uAE4C\\n\uBE68\uB9AC \uD0C8\uB77D\uC2DC\uCF1C\uB4DC\uB9AC\uC8E0[VAR 0114(000C)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB9C8\uB9AC \uC120\uBC30\uB2D8~!\\n\uD55C \uC218 \uBC30\uC6B0\uB3C4\uB85D \uD560\uAC8C\uC694~![VAR 0114(0071)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC2B9\uBD80\uC5D0\uB294 \uC704\uC544\uB798\uAC00 \uC5C6\uB2E4\uAD6C!\\n\uC804\uB825\uC73C\uB85C \uBD80\uB52A\uD600\uBCF4\uC790![VAR 0114(000D)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC0C1\uB300\uC758 \uC800 \uCD0C\uC2A4\uB7EC\uC6C0\uC744 \uBCF4\uC544\uD558\uB2C8\\n\uC77C\uB2E8 \uD328\uC158\uC73C\uB85C\uB294 \uC6B0\uB9AC\uC758 \uC2B9\uB9AC\uB85C\uAD70\uC694![VAR 0114(0068)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uCD0C\uC2A4\uB7FD\uB2E4\uB2C8, \uC9C0\uAE08 \uB098\uBCF4\uACE0 \uD558\uB294 \uC18C\uB9AC\uC57C?\\n\uADF8 \uC798\uB09C \uBA38\uB9AC\uB97C \uD655... \uAEBE\uC5B4\uC8FC\uACA0\uC5B4[VAR 0114(0071)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uD53C\uC624\uB2DD\uC774 \uC0C1\uB300\uB77C\uBA74\\n\uBD10\uC8FC\uC9C0 \uC54A\uACE0 \uB0A0\uB824\uBC84\uB9B4 \uC218 \uC788\uACA0\uAD70~[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC73C\uC544~! \uADF8\uB807\uAC8C \uBD80\uB974\uC9C0 \uB9D0\uB77C\uB2C8\uAE4C!\\n\uB108\uBB34 \uD798\uC8FC\uB2E4\uAC00 \uB2E4\uCE58\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uC1FC \uC601\uAC10\uB2D8![VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC624\uC608~! \uB2E8\uB378\uC774\uB85C\uAD70!\\n\uC790, \uC788\uB294 \uD798\uAECF \uB364\uBCBC \uBCF4\uAC70\uB77C![VAR 0114(0073)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB9D0\uC500\uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uADF8\uB7F4 \uAC81\uB2C8\uB2E4!\\n\uC790, [VAR 0100(0000)]\uB3C4 \uCC54\uD53C\uC5B8 \uD0C0\uC784\uC774\uB2E4![VAR 0114(0004)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC804\uC124\uC758 \uACA9\uD22C\uD0C0\uC785 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC790\\n\uC804 \uCC54\uD53C\uC5B8... \uD55C \uC218 \uBC30\uC6B0\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0011)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB108\uBB34 \uB531\uB531\uD558\uAC8C \uAD6C\uB294 \uAC74 \uBCC4\uB85C\uB77C\uAD6C~\\n\uC2E0\uBA85 \uB098\uAC8C \uB364\uBCBC \uBCF4\uAC70\uB77C![VAR 0114(0073)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB178\uC778\uB124\uB4E4\uC758 \uC2B9\uBD80\uC5D0 \uD718\uB9D0\uB9AC\uB2E4\uB2C8\\n\uCC54\uD53C\uC5B8\uB3C4 \uCC38 \uACE4\uB780\uD558\uACA0\uAD70[VAR 0114(0013)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC544\uC9C1 \uC6B0\uB9AC \uB458 \uB2E4 \uC80A\uB2E4\uACE0!\\n\uC790~ \uADF8\uB7FC \uD504\uB808\uC2DC\uD55C \uAE30\uBD84\uC73C\uB85C \uAC00\uBCFC\uAE4C![VAR 0114(0073)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC5B4\uC774! \uB098\uB294 \uC740\uD1F4\uD55C \uBAB8\uC774\uB2C8\uAE4C\\n\uC0B4\uC0B4 \uD558\uB77C\uACE0! \uB2E8\uB378![VAR 0114(0076)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC740\uD1F4\uD55C \uAC74 \uC800\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC785\uB2C8\uB2E4!\\n\uBD10\uC918\uC11C \uC774\uAE38 \uC218 \uC788\uC744 \uAC83 \uAC19\uC9C0\uB3C4 \uC54A\uC9C0\uB9CC![VAR 0114(0004)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uD53C\uC624\uB2C8! \uB108\uC758 \uAC15\uCCA0\uC740\\n\uC6B0\uB9AC\uC758 \uC5F4\uAE30\uB85C \uB179\uC5EC\uBC84\uB9AC\uACA0\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC21C\uBB34\uB294 \uC5EC\uC804\uD788 \uB728\uAC81\uAD6C\uB9CC!\\n\uADF8\uB7FC, \uC9C0\uC6D0\uC744 \uBD80\uD0C1\uD560\uAC8C \uD30C\uD2B8\uB108![VAR 0114(0076)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB2E8\uB378! 2\uB3002\uC774\uAE34 \uD558\uC9C0\uB9CC...\\n\uB108\uC758 \uD1A0\uB108\uBA3C\uD2B8\uB97C \uC5EC\uAE30\uC11C \uB05D\uB0B4\uC8FC\uACA0\uC5B4![VAR 0114(0017)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uC2DC\uD569\uC774\uB4E0 \uB09C \uC9C0\uC9C0 \uC54A\uC544!\\n\uAE08\uB791! \uC804\uB825\uC73C\uB85C \uB364\uBCBC![VAR 0114(0004)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD638\uBE0C! \uC774\uB807\uAC8C \uD070 \uBB34\uB300\uC5D0\uC11C\\n\uB108\uC640 \uACA8\uB8E8\uAC8C \uB420 \uC904\uC774\uC57C![VAR 0114(0004)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC0C1\uB300\uAC00 \uD615\uC774\uB77C\uACE0 \uD574\uB3C4 \uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC57C!\\n[VAR 0100(0000)]\uB3C4 \uB0B4 \uD65C\uC57D\uC744 \uC9C0\uCF1C\uBCF4\uB77C\uACE0![VAR 0114(0005)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC870\uAE08\uC740 \uAC15\uD574\uC9C0\uC168\uC2B5\uB2C8\uAE4C?\\n\uBC15\uC0AC \uC9C0\uB9DD\uC0DD \uD638\uBE0C\uAD70?[VAR 0114(000C)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uBC30\uBC30 \uAF2C\uC778 \uAC74 \uC5EC\uC804\uD558\uB124!\\n\uB0B4\uAC00 \uBC30\uC6B4 \uC9C0\uC2DD\uC744 \uBCF4\uC5EC\uC8FC\uACA0\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC218\uD589\uC758 \uC131\uACFC\uB97C \uBCF4\uC5EC\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4\\n\uD560\uBA38... \uD3EC\uD50C\uB7EC\uB2D8![VAR 0114(000C)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB610 \uD560\uBA38\uB2C8\uB77C\uACE0 \uBD80\uB974\uB824\uACE0 \uD588\uC9C0?\\n\uADF8 \uD0DC\uB3C4\uB294... \uB561\uC774\uB2E4![VAR 0114(0013)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uAC00\uC871\uC774\uB77C\uACE0 \uD574\uC11C\\n\uBD10\uC8FC\uC9C0 \uB9D0\uB77C\uACE0, \uC624\uBE60![VAR 0114(000D)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uBB3C\uB860 \uB098\uB3C4 \uADF8\uB7F4 \uC0DD\uAC01\uC774\uC57C...\\n\uADF8\uB798\uB3C4 \uC0B4\uC9DD \uAEC4\uB044\uB7FD\uAE34 \uD558\uB124[VAR 0114(0016)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC0C1\uB300\uAC00 \uC544\uD0AC\uC774\uBA74 \uBD88\uB9AC\uD558\uAE34 \uD558\uC9C0\uB9CC\\n\uC5EC\uAE30\uC11C \uC9C8 \uC0DD\uAC01\uC740 \uC5C6\uC5B4![VAR 0114(000F)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC5ED\uC2DC! \uC57C\uCCAD\uB2D8\uC774 \uD0C0\uC785 \uC0C1\uC131 \uC815\uB3C4\uC5D0\\n\uAE30\uC8FD\uC744 \uB9AC\uAC00 \uC5C6\uC8E0![VAR 0114(000E)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uD0C0\uBC84\uB9AC\uC9C0 \uC54A\uAC8C\\n\uC5F4\uC2EC\uD788 \uD574\uC57C\uACA0\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uB108\uC758 \uCD08\uBAA9\uC740\\n\uADF8\uB807\uAC8C \uC27D\uAC8C \uB2F9\uD558\uC9C0 \uC54A\uC744 \uD150\uB370. \uC544\uD0AC![VAR 0114(0010)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uBD10\uC8FC\uC9C0 \uC54A\uACE0\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uC0AC\uC6A9\uD558\uACA0\uC2B5\uB2C8\uB2E4, \uB450\uC1A1\uB2D8![VAR 0114(000E)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uB369\uCE58 \uD070 \uCABD\uC774 \uBB34\uC870\uAC74 \uC774\uAE30\uB294 \uAC83\uB3C4 \uC544\uB2C8\uB2C8\\n\uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uACE0 \uB9C8\uC74C\uAECF \uC4F0\uC2DC\uC8E0[VAR 0114(0016)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C \uC9C4 \uBE5A\uC744 \uAC1A\uACA0\uC2B5\uB2C8\uB2E4!\\n\uAC01\uC624\uD558\uC2DC\uC8E0, \uAE08\uB791\uB2D8![VAR 0114(000E)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uADF8\uB798! \uC774\uBC88\uC5D0\uB3C4 \uB098\uC758 \uB0A0\uC528\uC5D0\\n\uC815\uC2E0 \uBABB \uCC28\uB9AC\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uACA0\uC5B4![VAR 0114(0017)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC774\uB77C\uBA74 \uD0C0\uC785\uC758 \uBD88\uB9AC\uD568 \uC815\uB3C4\uB294\\n\uC5B4\uB835\uC9C0 \uC54A\uAC8C \uB4A4\uC9D1\uC5B4\uC8FC\uC2DC\uACA0\uC8E0?[VAR 0114(000F)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uAE30\uB300\uC5D0 \uBD80\uC751\uD560 \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uAD6C\uB098, \uC57C\uCCAD\\n\uC790, \uADF8\uB7FC \uD55C\uBC14\uD0D5 \uD0C0\uC62C\uB77C \uBCFC\uAE4C![VAR 0114(0010)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uB458 \uC911\uC5D0 \uB204\uAC00 \uC774\uAE30\uB4E0...[VAR 0114(000F)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC6D0\uB9DD\uD558\uAE30 \uC5C6\uAE30\uC785\uB2C8\uB2E4![VAR 0114(0011)]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uC57C\uCCAD\uACFC\uC758 \uC2B9\uBD80\uB77C...\\n\uC7A5\uAE30\uC804\uC744 \uAC01\uC624\uD574\uC57C\uACA0\uC5B4![VAR 0114(0015)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uC2B9\uBD80\uB294 \uAE38\uC5B4\uC9C0\uACA0\uC9C0\uB9CC\\n\uAD00\uAC1D\uB4E4\uC740 \uC990\uAC70\uC6CC\uD560 \uAC70\uC608\uC694![VAR 0114(000F)]"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uC6A9\uC744 \uC555\uB3C4\uD560 \uBE44\uCC45...\\n\uC774\uBC88 \uAE30\uD68C\uC5D0 \uC2DC\uD5D8\uD574\uBCF4\uACA0\uB124! \uAE08\uB791\uAD70![VAR 0114(0010)]"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uADF8\uAC8C \uB9C8\uC74C\uB300\uB85C \uB420\uAE4C\uC694, \uC21C\uBB34\uB2D8?\\n\uBE44\uCC45\uC774 \uD1B5\uD558\uC9C0 \uC54A\uC744 \uC815\uB3C4\uB85C \uB0A0\uB6F0\uC5B4\uB4DC\uB9AC\uC8E0![VAR 0114(0017)]"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uB450\uC1A1! \uB108\uC758 \uC545\uD0C0\uC785 \uAE30\uC220\uB85C\\n\uB098\uB97C \uD55C\uBC88 \uB9C9\uC544\uBCF4\uB77C\uACE0![VAR 0114(0017)]"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uB9AC\uD018\uC2A4\uD2B8\uB294 \uC798 \uBC1B\uC558\uC2B5\uB2C8\uB2E4\\n\uB098\uC911\uC5D0 \uD6C4\uD68C\uD574\uB3C4 \uC804 \uBAA8\uB985\uB2C8\uB2E4?[VAR 0114(0016)]"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774~\uB7F0! \uADF8\uB54C \uADF8 \uBFB0\uC871\uBA38\uB9AC \uC544\uB2D9\uB2C8\uAE4C!\\n\uAC00\uBCCD\uAC8C \uBC1F\uC544\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0068)]"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uAC70\uB9CC\uD55C \uC9D3\uB3C4 \uC815\uB3C4\uAECF \uD574\uC57C\\n\uB2F9\uD558\uACE0 \uB098\uC11C \uB35C \uBD80\uB044\uB7EC\uC6B8 \uD150\uB370 \uB9D0\uC774\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uC81C\uBC95 \uB4EC\uC9C1\uD574\uC9C4 \uAC83 \uAC19\uAD6C\uB098\\n\uC5BC\uB9C8\uB098 \uC131\uC7A5\uD588\uB294\uC9C0 \uD55C\uBC88 \uBCF4\uC5EC\uC918 \uBCF4\uB77C\uACE0[VAR 0114(0016)]"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uB098\uC758 \uC7A0\uC7AC\uB825\uC740 \uBB34\uAD81\uBB34\uC9C4\uD558\uB2E4\uAD6C\uC694!\\n\uC800\uC758 \uC131\uC7A5\uC744 \uBCF4\uC5EC\uC8FC\uACA0\uC5B4\uC694, \uB450\uC1A1\uB2D8![VAR 0114(0005)]"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uCD5C\uAC15\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uB77C\uB294 \uCE6D\uD638\uB294\\n\uC2AC\uC2AC \uC81C\uAC8C \uC591\uBCF4\uD558\uC2DC\uC8E0?[VAR 0114(0014)]"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uB108\uC758 \uC758\uC9C0\uC640 \uBC14\uC704\uAC00 \uC544\uBB34\uB9AC \uB2E8\uB2E8\uD558\uB2E4\uACE0 \uD574\uB3C4!\\n\uC6A9\uC758 \uD798\uC73C\uB85C \uBAA8\uB450 \uBD80\uC234\uBC84\uB9AC\uACA0\uC5B4![VAR 0114(0017)]"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uAE08\uB791\uC758 \uB4DC\uB798\uACE4\uD3EC\uCF13\uBAAC\uC744\\n\uC9D1\uC911\uC801\uC73C\uB85C \uB178\uB824\uC57C\uACA0\uB294\uAC78~[VAR 0114(0015)]"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uB9DE\uB300\uACB0\uC774\uC5C8\uB2E4\uBA74 \uACE0\uC804\uD558\uACA0\uC9C0\uB9CC\\n\uD300\uC758 \uD798\uC73C\uB85C \uC5BC\uC74C\uC870\uCC28\uB3C4 \uC774\uACA8\uB0B4\uACE0 \uB9D0\uACA0\uC5B4![VAR 0114(0017)]"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uACA9\uD22C\uD0C0\uC785\uC740 \uC870\uAE08 \uC131\uAC00\uC2DC\uAE34 \uD558\uC9C0\uB9CC\\n\uC27D\uAC8C \uBD80\uC11C\uC9C0\uC9C0\uB294 \uC54A\uC744 \uAC81\uB2C8\uB2E4[VAR 0114(0014)]"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uBA74 \uBD80\uC11C\uC9C8 \uB54C\uAE4C\uC9C0 \uB54C\uB9B4 \uC218\uBC16\uC5D0 \uC5C6\uC8E0!\\n\uB9C8\uCFE0\uC640\uB2D8, \uD55C \uC218 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0011)]"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uC544, \uC544\uD0AC\uB2D8...!\\n\uC800 \uC5F4\uC2EC\uD788 \uD560 \uAC70\uC608\uC694...![VAR 0114(0012)]"
  },
  {
    "index": 67,
    "flags": 0,
    "text": "\uC88B\uC740 \uC790\uC138\uC785\uB2C8\uB2E4, \uC5B4\uB2C8\uC5B8\uB2D8!\\n\uD300\uC740 \uC11C\uB85C \uB2E4\uB974\uC9C0\uB9CC \uD30C\uC774\uD305\uC785\uB2C8\uB2E4![VAR 0114(000E)]"
  },
  {
    "index": 68,
    "flags": 0,
    "text": "\uC5B4\uB2C8\uC5B8! \uC774\uBC88\uC5D0\uB294 \uC11C\uB85C \uC801\uC774\uC9C0\uB9CC\\n\uC798 \uBD80\uD0C1\uD560\uAC8C![VAR 0114(0015)]"
  },
  {
    "index": 69,
    "flags": 0,
    "text": "\uC0AC, \uC0B4\uC0B4 \uBD80\uD0C1\uB4DC\uB824\uC694...![VAR 0114(0012)]"
  },
  {
    "index": 70,
    "flags": 0,
    "text": "\uBA87 \uBC88\uC744 \uBD10\uB3C4 \uC544\uB984\uB2E4\uC6B4 \uAC00\uBA74\uC774\uAD70\uC694!\\n\uC815\uB9D0 \uC81C\uAC8C \uC8FC\uC2E4 \uC0DD\uAC01\uC740 \uC5C6\uC73C\uC2ED\uB2C8\uAE4C?[VAR 0114(0068)]"
  },
  {
    "index": 71,
    "flags": 0,
    "text": "\uC5B4, \uADF8\uAC8C...\\n\uC544, \uC548 \uB3FC\uC694...[VAR 0114(0012)]"
  },
  {
    "index": 72,
    "flags": 0,
    "text": "\uC544\uB984\uB2E4\uC6B4 \uC5BC\uC74C\uC758 \uB9C8\uB2F4\uC774\uC2DC\uC5EC!\\n\uC6B0\uB9AC\uC758 \uC140\uB7EC\uBE0C\uB9AC\uD2F0\uD568\uC744 \uBCF4\uC5EC\uB4DC\uB9AC\uC8E0![VAR 0114(0069)]"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uC5B4\uBA38, \uB9D0\uC19C\uC528\uAC00 \uD604\uB780\uD55C \uC2E0\uC0AC\uBD84\uC774\uB124\\n\uADF8\uB807\uC9C0\uB9CC \uC2DC\uD569\uC740 \uC5EC\uC804\uD788 \uD639\uB3C5\uD560 \uAC70\uB78D\uB2C8\uB2E4![VAR 0114(0015)]"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774~\uB7F0! \uC544\uC6B0\uC640\\n\uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C \uC0C1\uB300\uB85C \uB9CC\uB0A0 \uC904\uC774\uC57C![VAR 0114(0068)]"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uC774\uB7F0 \uD6CC\uB96D\uD55C \uAE30\uC801\uC744 \uAE30\uB150\uD558\uB294\\n\uD30C\uD2F0\uB97C \uC5EC\uB294 \uAC74 \uC5B4\uB5A0\uC2E0\uAC00\uC694 \uD615\uB2D8!?[VAR 0114(0069)]"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uC544\uD0AC\uB2D8! \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uB54C\uBCF4\uB2E4\\n\uAC15\uD574\uC9C4 \uC800\uB97C \uBCF4\uC5EC\uC904\uAC8C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uC774\uB7F0 \uAC8C \uCCAB \uBC88\uC9F8 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758 \uD2B9\uAD8C\uC774\uC8E0\\n\uC790, \uADF8\uB7FC \uC5B4\uB514 \uC800\uB97C \uB180\uB77C\uAC8C \uB9CC\uB4E4\uC5B4\uBCF4\uC2DC\uC8E0![VAR 0114(000E)]"
  },
  {
    "index": 78,
    "flags": 0,
    "text": "\uD034\uC988\uB97C \uB9DE\uD78C \uBCF4\uC0C1\uC774 \uC5C6\uC5B4\uB3C4\\n\uC774\uAE30\uACE0 \uB9D0 \uAC70\uC608\uC694, \uD3EC\uD50C\uB7EC\uB2D8![VAR 0114(0005)]"
  },
  {
    "index": 79,
    "flags": 0,
    "text": "\uD034\uC988\uB97C \uBAA8\uB450 \uB9DE\uD78C \uC544\uAC00\uC57C\\n\uB108\uC758 \uADF8 \uBC30\uB824\uC2EC\uC740 \uD569\uACA9\uC774\uB2E4![VAR 0114(0013)]"
  },
  {
    "index": 80,
    "flags": 0,
    "text": "\uCD5C\uACE0\uC758 \uBC15\uC0AC\uAC00 \uB418\uACE0 \uC2F6\uB2E4\uBA74\\n\uC2B9\uBD80\uC5D0 \uB300\uD55C \uC9C0\uC2DD\uB3C4 \uC5F4\uC2EC\uD788 \uC313\uC544\uB450\uB77C\uAD6C![VAR 0114(000D)]"
  },
  {
    "index": 81,
    "flags": 0,
    "text": "\uADF8\uB798! \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C\uB3C4 \uC9C0\uC9C0 \uC54A\uB294\\n\uAC15\uD55C \uBC15\uC0AC\uAC00 \uB418\uACE0 \uB9D0\uACA0\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 82,
    "flags": 0,
    "text": "\uD638\uBE0C\uAD6C\uB098!\\n\uBC15\uC0AC \uACF5\uBD80\uB294 \uC798\uB418\uACE0 \uC788\uB290\uB0D0~?[VAR 0114(0073)]"
