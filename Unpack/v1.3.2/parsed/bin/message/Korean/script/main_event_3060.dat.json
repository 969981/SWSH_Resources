    "text": "\uC0E4\uB77C\uB9AC"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD6C4\uC6B0... \uC5B4\uB5BB\uAC8C\uB4E0\\n\uC77C\uB2E8\uB77D\uB410\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4...\\n\uC5ED\uC2DC \uC88B\uC544\uD560 \uC218\uAC00 \uC5C6\uB124[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8\uC740 \uC5EC\uC804\uD788\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uC2EB\uC5B4\uD558\uC2DC\uB294\uAD70\uC694[VAR 0114(000E)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uC870\uAE08 \uC804\uC758 \uB2E4\uC774\uB9E5\uC2A4\uB294\\n\uBB54\uAC00 \uAE30\uBB18\uD588\uC5B4\uC694[VAR 0114(000E)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD2B8\uB808\uC774\uB108\uAC00 \uC5C6\uC5C8\uC5B4\uC694!\\c\\n\uAC8C\uB2E4\uAC00 \uD3EC\uCF13\uBAAC \uC790\uC2E0\uB3C4\\n\uD798\uC744 \uC81C\uC5B4\uD558\uC9C0 \uBABB\uD574\uC11C\\r\\n\uB2F9\uD669\uD574\uD558\uB294 \uB290\uB08C\uC774\uC5C8\uAD6C\uC694[VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "...\uADF8\uB807\uC8E0\\c\\n\uB2E4\uC774\uB9E5\uC2A4\uB294 \uBCF4\uD1B5\\n\uB2E4\uC774\uB9E5\uC2A4 \uBC34\uB4DC\uC5D0 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uBC18\uC751\uD574\uC11C \uBC1C\uB3D9\uD558\uB2C8\uAE4C\uC694...[VAR 0114(000E)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uACFC \uD2B8\uB808\uC774\uB108\uC758\\n\uD558\uBAA8\uB2C8\uC5D0 \uB178\uC774\uC988\uAC00 \uC788\uC5C8\uC5B4[VAR 0114(0016)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8\uC740\\n\uBB54\uAC00 \uB290\uB080 \uAC8C \uC788\uC73C\uC2E0\uAC00\uC694?[VAR 0114(000E)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC788\uC5B4\uC694"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uBAA8\uB974\uACA0\uC5B4\uC694"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8\uB3C4\\n\uC704\uD654\uAC10\uC744 \uB290\uB07C\uC168\uAD70\uC694[VAR 0114(000E)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD655\uC2E4\uD788 \uACB0\uB860\uC744 \uC9D3\uAE30\uC5D0\uB294\\n\uC774\uB97C\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC774 \uD3EC\uCF13\uBAAC\uC758\\n\uD2B8\uB808\uC774\uB108\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uACE0\\r\\n\uC218\uC218\uAED8\uB07C\uAC00 \uB04A\uC774\uC9C8 \uC54A\uB294 \uC0AC\uAC74\uC774\uB124\uC694[VAR 0114(000E)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC774 \uC544\uC774\uB294 \uD130\uD504\uCCB4\uC721\uAD00\uC5D0\uC11C\\n\uCC45\uC784\uC9C0\uACE0 \uBCF4\uD638\uD558\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(000E)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "[~ 24]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB2E4\uB4E4 \uC815\uB9D0 \uAC10\uC0AC\uD569\uB2C8\uB2E4\\n\uB355\uBD84\uC5D0 \uB9CE\uC740 \uB3C4\uC6C0\uC774 \uB410\uC5B4\uC694[VAR 0114(000E)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 [VAR 0100(0000)]\uB2D8!\\c\\n\uC81C \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uAC8C \uB418\uBA74\\n\uC5B8\uC81C\uB4E0 \uBD88\uB7EC\uC8FC\uC138\uC694[VAR 0114(000E)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC790 \uB2EC\uCF54\uD038\\n\uB098\uB97C \uB530\uB77C\uC624\uB834[VAR 0114(000E)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC0E4\uB77C\uB77C\uB77C"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC774~\uB7F0! \uC774\uB7F0 \uC774~\uB7F0!\\n\uADF8 \uB2E4\uC774\uB9E5\uC2A4\uB97C \uC9C4\uC815\uC2DC\uCF30\uAD70\uC694[VAR 0114(0068)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC774~\uB7F0! \uC774\uB7F0 \uC774~\uB7F0!\\n\uACFC\uC5F0 \uB9AC\uADF8 \uCC54\uD53C\uC5B8\uC774\uAD70\uC694![VAR 0114(0069)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC557! \uB108\uD76C\uB4E4!\\n\uC5ED\uC2DC \uC5EC\uAE30 \uC788\uC5C8\uAD6C\uB098!\\r\\n[VAR 0109(0001)][VAR 1900(0002)] \uB3CC\uB824\uC918![VAR 0114(0005)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC774~\uB7F0? \uB2F9\uC2E0 \uBB3C\uAC74\uB3C4\\n\uC544\uB2C8\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C![VAR 0114(0068)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC124\uC0AC \uB2F9\uC2E0\uC758 \uBB3C\uAC74\uC774\uB354\uB77C\uB3C4\\n\uB3CC\uB824\uC8FC\uC9C0 \uC54A\uC744 \uAC70\uC9C0\uB9CC \uB9D0\uC774\uC8E0![VAR 0114(0069)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uBB50\uC57C~!\\n\uAC70\uAE30\uC11C \uB098\uC640![VAR 0114(0005)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB204\uAD6C\uC2DC\uC8E0?[VAR 0114(0016)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uAD00\uAC1D\uACFC \uC2A4\uD0DC\uD504\uB294\\n\uBAA8\uB450 \uD53C\uB09C\uC2DC\uCF30\uC744 \uD150\uB370\uC694[VAR 0114(0016)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uC138\uC18D\uC758 \uB8F0\uC740\\n\uC6B0\uB9AC\uC640\uB294 \uC0C1\uAD00\uC5C6\uC2B5\uB2C8\uB2E4![VAR 0114(0068)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uADF8\uB807\uC2B5\uB2C8\uB2E4! \uADF8\uAC83\uC774\uC57C\uB9D0\uB85C\\n\uC9C4\uC815\uD55C \uC140\uB7EC\uBE0C\uB9AC\uD2F0\uB2C8\uAE4C\uC694![VAR 0114(0069)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "...\uBB50?[VAR 0114(0016)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uB2F9\uC2E0\uC740 \uBB61\uB2C8\uAE4C?\\n\uBA38\uB9AC \uBAA8\uC591\uB3C4 \uC774\uC0C1\uD574\uAC00\uC9C0\uACE0![VAR 0114(0068)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uAC8C\uB2E4\uAC00 \uC628\uBAB8\uC744 \uD751\uBC31\uC73C\uB85C \uAFB8\uBBF8\uB2E4\uB2C8\\n\uB09C\uC13C\uC2A4\uB124\uC694 \uD615\uB2D8[VAR 0114(0069)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uC608\uC758 \uC5C6\uB294 \uC0AC\uB78C\uC740\\n\uC2E0\uB8B0\uBC1B\uC9C0 \uBABB\uD558\uB294\uB370 \uB9D0\uC774\uC9C0[VAR 0114(0016)]"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uC2E4\uD5D8\uC740\\n\uC131\uACF5\uD55C \uBAA8\uC591\uC774\uAD6C\uB098 \uC544\uC6B0\uC57C[VAR 0114(0068)]"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uB124\uC5D0! \uBB3C\uB860\uC774\uACE0\uB9D0\uACE0\uC694!\\n\uB2E4\uC74C\uC5D0\uB294 \uC880 \uB354 \uAC15\uD55C \uD3EC\uCF13\uBAAC\uC744\\r\\n\uB2E4\uC774\uB9E5\uC2A4\uC2DC\uCF1C\uBCF4\uC8E0[VAR 0114(0069)]"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uADF8\uB798! \uBB3C\uB860\uC774\uACE0\uB9D0\uACE0! \uCD5C\uC885\uC801\uC73C\uB85C\uB294\\n\uC790\uC2DC\uC548\uACFC \uC790\uB9C8\uC820\uD0C0\uC758\\r\\n\uBCF8\uC131\uC744 \uD3ED\uB85C\uD558\uB294 \uAC70\uB2E4![VAR 0114(0068)]"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC790\uC2DC\uC548\uACFC \uC790\uB9C8\uC820\uD0C0\uB97C\\n\uBB50 \uC5B4\uCA50\uB2E4\uACE0!?[VAR 0114(0005)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uC584\uBBF8\uC6B4 \uCC54\uD53C\uC5B8\uC774\uC5EC!\\c\\n\uC6B0\uB9AC\uB294 \uC55E\uC73C\uB85C\uB3C4 \uACC4\uC18D\uD574\uC11C\\n\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC744 \uB0A0\uB6F0\uAC8C \uD560 \uAC81\uB2C8\uB2E4![VAR 0114(0069)]"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "\uBA48\uCD94\uACE0 \uC2F6\uB2E4\uBA74\\n\uC6B0\uB9AC\uC758 \uC544\uB984\uB2E4\uC6B4 \uAF41\uBB34\uB2C8\uB97C\\r\\n\uC5F4\uC2EC\uD788 \uCAD3\uC544\uB2E4\uB140 \uBCF4\uC2DC\uC8E0![VAR 0114(0068)]"
  },
  {
    "index": 49,
    "flags": 0,
    "text": "\uC73C\uC74C~ \uC140\uB7EC\uBE0C\uB9AC\uD2F0~![VAR 0114(0069)]"
  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uADF8\uB7FC... \uAD7F \uBC14\uC774![VAR 0114(006A)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824! \uC774 \uC18C\uB3D9\uC740\\n\uB108\uD76C\uAC00 \uAFB8\uBBFC \uC9D3\uC774\uC57C!?[VAR 0114(0005)]"
  },
  {
    "index": 52,
    "flags": 0,
    "text": "\uC9C4\uC815\uD574 \uD638\uBE0C\\n\uC5EC\uC804\uD788 \uB178\uC774\uC9C0\uD558\uAD6C\uB098[VAR 0114(0016)]"
  },
  {
    "index": 53,
    "flags": 0,
    "text": "\uADF8 \uADF8\uB807\uC9C0\uB9CC!\\n\uB140\uC11D\uB4E4\uC774 \uB3C4\uB9DD\uAC04\uB2E4\uAD6C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 54,
    "flags": 0,
    "text": "\uD568\uC815\uC77C \uAC00\uB2A5\uC131\uB3C4 \uC788\uC5B4\\n\uC544\uBB34 \uC900\uBE44 \uC5C6\uC774 \uCAD3\uC544\uAC00\uB294 \uAC74 \uBC18\uB300\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 55,
    "flags": 0,
    "text": "\uADF8 \uADF8\uB807\uC9C0\uB9CC![VAR 0114(0005)]"
  },
  {
    "index": 56,
    "flags": 0,
    "text": "\uC544\uB2C8...\\n\uB124 \uC54C\uC558\uC5B4\uC694[VAR 0114(0005)]"
  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uADF8\uB798 \uC798 \uC0DD\uAC01\uD588\uC5B4\\n\uC870\uAE08\uC740 \uB9C8\uC74C\uC744 \uAC00\uB77C\uC549\uD788\uB834[VAR 0114(0016)]"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uB140\uC11D\uB4E4\uC774 \uD3EC\uCF13\uBAAC\uC744\\n\uAC15\uC81C\uB85C \uB2E4\uC774\uB9E5\uC2A4\uC2DC\uCF30\uB2E4...\\c\\n\uB9D0\uD558\uB294 \uAC78 \uB4E4\uC5B4\uC11C\uB294\\n\uAC70\uC758 \uC0AC\uC2E4\uC774\uB124[VAR 0114(0016)]"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uAC8C\uB2E4\uAC00 \uC55E\uC73C\uB85C\uB3C4\\n\uACC4\uC18D\uD560 \uAC70\uB77C\uACE0 \uD588\uC5B4\uC694![VAR 0114(0005)]"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uC6A9\uC11C\uD560 \uC218 \uC5C6\uC5B4!"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uB9C9\uC544\uC57C \uD574!"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uADF8\uB798 \uB9DE\uC544![VAR 0114(0005)]"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "[VAR 0109(0001)][VAR 1900(0002)] \uB3CC\uB824\uB193\uB294 \uAC8C\\n\uC911\uC694\uD55C \uAC8C \uC544\uB2C8\uC57C!\\c\\n[VAR 0100(0000)]! \uB450\uC1A1\uB2D8!\\n\uB450 \uC0AC\uB78C\uC744 \uB9C9\uC544\uC57C \uD574\uC694![VAR 0114(0005)]"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uBC34\uB4DC\uB97C \uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uC740\\n\uB450 \uC0AC\uB78C\uC774 \uC5B4\uB5BB\uAC8C \uD3EC\uCF13\uBAAC\uC744\\r\\n\uB2E4\uC774\uB9E5\uC2A4\uC2DC\uD0A8 \uAC78\uAE4C?[VAR 0114(0016)]"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uBE68\uAC04 \uB140\uC11D\uACFC \uD30C\uB780 \uB140\uC11D\\n\uB2E4\uC74C\uC740 \uC5B4\uB514\uB85C \uAC04 \uAC78\uAE4C...?\\c\\n[VAR 0100(0000)]!\\n\uC77C\uB2E8\uC740 \uBC16\uC73C\uB85C \uB098\uAC00\uC790![VAR 0114(0005)]"
