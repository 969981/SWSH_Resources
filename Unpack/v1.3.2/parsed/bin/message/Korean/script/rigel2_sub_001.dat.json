[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB108, \uC655\uAD00\uC124\uC6D0\uC740 \uCC98\uC74C\uC774\uC9C0!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB098\uB294 \uC774\uACF3\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uC758 \uC0DD\uD0DC\uB97C \uC5F0\uAD6C\uD558\uACE0 \uC788\uC5B4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC694\uC998 \uC655\uAD00\uC124\uC6D0\uC5D0\\n\uACE0\uB300 \uD3EC\uCF13\uBAAC\uC774\uB098\\r\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC774 \uB098\uD0C0\uB098\uC11C \uB9D0\uC774\uC57C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uC5C5\uB370\uC774\uD2B8\uD574\uC904 \uD14C\uB2C8\uAE4C\\n\uAC19\uC774 \uC870\uC0AC\uD574\uC8FC\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\\n\uC5C5\uB370\uC774\uD2B8 \uC911...\\c\\n...... ...... ......\\n...... ...... ......"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC5D0\\n\uC655\uAD00\uC124\uC6D0\uB3C4\uAC10 \uD56D\uBAA9\uC774\\r\\n\uCD94\uAC00\uB418\uC5C8\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC0C8\uB85C\uC6B4 \uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\uC758\\n\uC644\uC131\uC744 \uBAA9\uD45C\uB85C \uC5F4\uC2EC\uD788 \uD574\uC918!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\uC744\\n\uBCF4\uC5EC\uC904 \uAC70\uB2C8?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC644\uC131\uD55C \uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\uC744\\n\uB610 \uBCF4\uC5EC\uC904 \uAC70\uB2C8?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB798, \uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uBCF4\uC5EC\uC918"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC5B4\uB514 \uBCF4\uC790..."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\uC758\\n\uD604\uC7AC \uC0C1\uD0DC\uB294..."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBC1C\uACAC\uD55C \uD3EC\uCF13\uBAAC [VAR 0202(0000)]!\\n\uC7A1\uC740 \uD3EC\uCF13\uBAAC [VAR 0202(0001)]!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD558\uD558, \uC870\uAE09\uD574\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB3FC\\n\uC5C5\uB370\uC774\uD2B8\uD55C \uC9C0 \uC5BC\uB9C8 \uC548 \uB410\uC796\uC544!\\c\\n\uC9C0\uAE08\uBD80\uD130\uAC00 \uBAA8\uD5D8\uC758 \uC2DC\uC791\uC774\uB2C8\uAE4C\\n\uC5F4\uC2EC\uD788 \uD574\uBCF4\uB834!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD6C4\uD6C4! \uC544\uC9C1 \uBBF8\uC219\uD558\uC9C0\uB9CC\\n\uC5F4\uC2EC\uD788 \uD558\uACE0 \uC788\uAD6C\uB098!\\c\\n\uB208\uAE38\uC774\uB098 \uB3D9\uAD74\\n\uC0B0 \uC704 \uB4F1\uB4F1...\\c\\n\uC7A5\uC18C\uC5D0 \uB530\uB77C\\n\uB9CC\uB0A0 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774 \uB2E4\uB974\uB2E8\uB2E4!\\c\\n\uB2E4\uC591\uD55C \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB098\uACE0 \uC2F6\uB2E4\uBA74\\n\uC5EC\uAE30\uC800\uAE30 \uB2E4\uB140\uBCF4\uB3C4\uB85D \uD558\uB834!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "30\uB9C8\uB9AC \uC774\uC0C1 \uC7A1\uC558\uAD6C\uB098?\\n\uAD49\uC7A5\uD788 \uC21C\uC870\uB85C\uC6B4 \uD398\uC774\uC2A4\uB124!\\c\\n\uB0A0\uC528\uB294 \uC2E0\uACBD \uC4F0\uACE0 \uC788\uB2C8?\\n\uB9D1\uC744 \uB54C\uB098 \uBE44 \uC62C \uB54C\\r\\n\uC2F8\uB77C\uAE30\uB208\uC774 \uB0B4\uB9AC\uAC70\uB098 \uBAA8\uB798\uBC14\uB78C\uC774 \uBD88 \uB54C...\\c\\n\uB0A0\uC528\uC5D0 \uB530\uB77C \uB098\uC624\uB294\\n\uD3EC\uCF13\uBAAC\uC774 \uC870\uAE08\uC529 \uB2EC\uB77C\uC9C0\uAC70\uB4E0"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "50\uB9C8\uB9AC \uC774\uC0C1 \uC7A1\uB2E4\uB2C8\\n\uC2A4\uD53C\uB4DC\uAC00 \uAD49\uC7A5\uD55C\uB370!\\c\\n\uD3EC\uD68D \uC218\uAC00 \uC804\uCCB4\uC758\\n\uC57D 4\uBD84\uC758 1\uC774 \uB418\uC5C8\uC5B4!\\c\\n\uB208\uC870\uC2EC \uD558\uBA74\uC11C\\n\uC655\uAD00\uC124\uC6D0\uC744 \uBAA8\uD5D8\uD558\uB3C4\uB85D \uD558\uB834!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB4F1\uB85D\uB41C \uD3EC\uCF13\uBAAC\uC758 \uC218\uAC00\\n\uCC99\uCC99 \uB298\uC5B4\uB098\uACE0 \uC788\uAD6C\uB098!\\c\\n\uD035\uBCFC\uC744 \uC0AC\uC6A9\uD574\uC11C\\n\uBE60\uB974\uAC8C \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC73C\uBA74\\c\\n\uC21C\uC2DD\uAC04\uC5D0 100\uB9C8\uB9AC \uB4F1\uB85D\uC758 \uBCBD\uC744\\n\uB6F0\uC5B4\uB118\uC744 \uC218 \uC788\uC9C0 \uC54A\uACA0\uC5B4?"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC21C\uC2DD\uAC04\uC5D0 \uD3EC\uD68D \uC218\uAC00\\n100\uB9C8\uB9AC\uB97C \uB118\uC5B4\uBC84\uB838\uC5B4!\\c\\n\uB108\uC5D0\uAC8C \uC5F0\uAD6C\uB97C \uB3C4\uC640\uB2EC\uB77C\uACE0\\n\uBD80\uD0C1\uD558\uAE38 \uC798\uD55C \uAC83 \uAC19\uC544!\\c\\n\uC5EC\uC815\uC740 \uAC70\uC758 \uC808\uBC18\uAE4C\uC9C0 \uC654\uC5B4!\\n\uD6C4\uBC18\uB3C4 \uC5F4\uC2EC\uD788 \uD574\uBCF4\uC790!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uC815\uBCF4\uB7C9\uC774 \uB9CE\uC740\\n\uB3C4\uAC10\uC744 \uBCF4\uB294 \uAC74 \uC990\uAC70\uC6CC\\c\\n\uBB3C\uAC00\uB098 \uB3D9\uAD74, \uC0B0 \uC704 \uB4F1\\n\uB108\uB294 \uB2E4\uC591\uD55C \uC7A5\uC18C\uB97C\\r\\n\uCC3E\uC544\uB2E4\uB2C8\uB294 \uBAA8\uC591\uC774\uAD6C\uB098\\c\\n\uC9C0\uAE08\uCC98\uB7FC \uC5F4\uC2EC\uD788 \uB2E4\uB140\uC11C\\n\uB3C4\uAC10 \uC644\uC131\uC744 \uBAA9\uD45C\uB85C \uD574\uBCF4\uB834!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C\uAE4C\uC9C0 \uB9CE\uC774 \uCC44\uC6CC\uC9C4\\n\uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\uC740\\r\\n\uC9C0\uAE08\uAECF \uBCF8 \uC801\uC774 \uC5C6\uC5B4!\\c\\n\uBD84\uBA85\uD788 \uB09A\uC2DC \uAC19\uC740 \uAC83\uB3C4\\n\uD65C\uC6A9\uD558\uACE0 \uC788\uACA0\uC9C0?!\\c\\n\uAE5C\uBE61\uD558\uACE0 \uB193\uCE58\uAE30 \uC26C\uC6B4 \uD3EC\uCF13\uBAAC\uC744\\n\uB9CC\uB0A0 \uC218 \uC788\uB294 \uBC29\uBC95\uC774\uB2C8\uAE4C"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC774\uC81C \uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\\n\uC644\uC131\uAE4C\uC9C0 \uC5BC\uB9C8 \uB0A8\uC9C0 \uC54A\uC558\uC5B4!\\c\\n\uB354 \uC774\uC0C1 \uB098\uC758 \uC870\uC5B8\uC740\\n\uD544\uC694 \uC5C6\uACA0\uC5B4!\\c\\n\uB108\uB77C\uBA74 \uD574\uB0BC \uC218 \uC788\uC744 \uD14C\uB2C8\uAE4C\\n\uBBFF\uACE0 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uCD95\uD558\uD574!\\n\uB4DC\uB514\uC5B4... \uB4DC\uB514\uC5B4...!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\\n\uC644\uC131\uC774\uC57C!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB355\uBD84\uC5D0 \uC5F0\uAD6C\uAC00\\n\uC21C\uC870\uB86D\uAC8C \uC9C4\uD589\uB410\uC5B4"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB108\uC5D0\uAC8C \uBD80\uD0C1\uD558\uAE38\\n\uC815\uB9D0 \uC798\uD55C \uAC83 \uAC19\uC544!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB108\uC758 \uD6CC\uB96D\uD55C \uACF5\uC801\uC744\\n\uAE30\uB9AC\uB294 \uB73B\uC5D0\uC11C\\r\\n\uB9AC\uADF8 \uCE74\uB4DC\uC5D0 \uD45C\uC2DD\uC744 \uBD99\uC5EC\uC904\uAC8C!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC790, \uB410\uB2E4!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB098\uC758 \uAC10\uC0AC\uC758 \uB9C8\uC74C\uB3C4\\n\uD568\uAED8 \uBC1B\uC544\uC918!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC774\uAC74 \uC544\uBB34\uB098 \uD560 \uC218 \uC788\uB294 \uC77C\uC774 \uC544\uB2C8\uC57C!\\n\uC815\uB9D0 \uCD95\uD558\uD574!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uBA87 \uBC88\uC744 \uBD10\uB3C4\\n\uD6CC\uB96D\uD55C \uC655\uAD00\uC124\uC6D0\uB3C4\uAC10\uC774\uC57C\\r\\n...\uC815\uB9D0 \uCD95\uD558\uD574!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC751? \uADF8 \uD3EC\uCF13\uBAAC\uC740..."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB108\uD2B8\uD3EC\uCF13\uBAAC\\n[VAR 0101(0001)]!?"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29\uC5D0 \uC5C6\uB294\\n\uD658\uC0C1\uC758 \uD3EC\uCF13\uBAAC\uC774\uC57C"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "[VAR 0101(0001)][VAR 1900(0002)] \uB9CC\uB098\uAC8C \uD574\uC900 \uBCF4\uB2F5\uC774\uC57C\\n\uC774\uAC78 \uBC1B\uC544\uC918"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB108\uD2B8\uD3EC\uCF13\uBAAC\uC5D0\uC11C \uCC29\uC548\uD55C\\n\uB108\uD2B8 \uBAA8\uC790\uC57C\\r\\n\uADC0\uC5FD\uC9C0?"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR 01C2(0001)] \uB514\uC790\uC778\uC758\\r\\n[VAR FF00(0008)][VAR 01C1(0002)][VAR FF00(0000)][VAR 1900(0002)]\\r\\n\uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  }
]
