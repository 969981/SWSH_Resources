[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5EC\uC5B4! \uCEA0\uD504\uC5D0 \uCCAB\uBC1C\uC744 \uB0B4\uB514\uB518\\n\uD2B8\uB808\uC774\uB108\uC57C \uC548\uB155?\\c\\n\uB098\uB294\uC57C \uC774\uB984\uD558\uC5EC \uCEA0\uD504\uD0B9!\\n\uCEA0\uD551\uC744 \uC11C\uD3EC\uD2B8\uD574\uC8FC\uB294 \uC0AC\uB78C\uC774\uC57C!\\c\\n\uB204\uAD6C\uB098 \uCC98\uC74C\uC5D0\uB294 \uCD08\uBCF4\uC778 \uBC95\uC774\uC9C0!\\n\uCEA0\uD551\uC5D0 \uB300\uD574 \uAD81\uAE08\uD55C \uAC8C \uC788\uC73C\uBA74\\r\\n\uBD80\uB2F4 \uAC16\uC9C0 \uB9D0\uACE0 \uB9D0\uC744 \uAC78\uC5B4\uC918!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5EC\uC5B4 \uC548\uB155! \uC624\uB298\uB3C4 \uCEA0\uD551\uD558\uAE30\\n\uCD5C\uACE0\uB85C \uC88B\uC740 \uB0A0\uC774\uC9C0 \uC54A\uB2C8?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uCEA0\uD551\uC5D0 \uB300\uD574 \uB098\uC758\\n\uB3C4\uC6C0\uC774 \uD544\uC694\uD55C \uC77C\uC774 \uC788\uB2C8?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD150\uD2B8\uC758 \uC0C9\uC744 \uBC14\uAFBC\uB2E4"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCE74\uB808\uB3C4\uAC10 \uD3C9\uAC00"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC694\uB9AC\uB3C4\uAD6C\uB97C \uBC14\uAFBC\uB2E4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCEA0\uD551\uC5D0 \uB300\uD55C \uAC70\uB77C\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB9D0\uC744 \uAC78\uC5B4\uC918!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB108\uC758 \uD3EC\uCF13\uBAAC\uACFC \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uCEEC\uB7EC\uB85C\\n\uD150\uD2B8\uB97C \uC5B4\uB808\uC778\uC9C0\uD574\uC904\uAC8C!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD760\uD760 \uADF8\uB807\uC9C0...\\c\\n\uB108\uC758 [VAR 0102(0000)][VAR 1900(0004)] \uC5B4\uC6B8\uB9AC\uB294...\\n[VAR 0103(0001)] \uCEEC\uB7EC\uB294 \uC5B4\uB5A0\uB2C8!?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC624\uD638... \uACFC\uC5F0 \uADF8\uB807\uAD70...\\c\\n\uB108\uC758 [VAR 0102(0000)][VAR 1900(0004)] \uC5B4\uC6B8\uB9AC\uB294 \uCEEC\uB7EC\uB294...\\n\uBB50\uAC00 \uC88B\uC744\uAE4C!?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC608"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC544\uB2C8\uC694"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0103(0000)] \uCEEC\uB7EC"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0103(0001)] \uCEEC\uB7EC"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[VAR 0103(0000)] \uCEEC\uB7EC\uB85C \uD560\uAE4C!?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[VAR 0103(0000)] \uCEEC\uB7EC\uB85C \uBC14\uAFE8\uC5B4!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uC544\uC9C1 \uD55C \uBC88\uB3C4\\n\uC694\uB9AC\uB97C \uD574\uBCF8 \uC801\uC774 \uC5C6\uB098 \uBCF4\uAD6C\uB098!\\c\\n\uB2E4\uC74C\uC5D0 \uC694\uB9AC\uB97C \uD558\uAC8C \uB418\uBA74\\n\uADF8\uB54C \uBCF4\uC5EC\uC918!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCE74\uB808\uB97C \uD1B5\uB2EC\uD55C \uB108\uC5D0\uAC8C\\n\uAC00\uB974\uCCD0 \uC904 \uAC74 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5B4...!\\c\\n\uC55E\uC73C\uB85C\uB3C4 \uACC4\uC18D\uD574\uC11C\\n\uCD5C\uACE0\uC758 \uCE74\uB808\uB97C \uB9CC\uB4E4\uC5B4\uC918!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCE74\uB808\uB3C4\uAC10\uC740 \uC21C\uC870\uB86D\uAC8C \uBAA8\uC73C\uACE0 \uC788\uB2C8?\\n\uADF8\uB7FC... \uC5B4\uB514 \uD55C \uBC88 \uD655\uC778\uD574 \uBCFC\uAE4C!\\c\\n\uC9C0\uAE08\uAE4C\uC9C0 \uB124\uAC00 \uB9CC\uB4E0\\n\uCE74\uB808\uC758 \uC885\uB958\uB294 [VAR 0202(0001)]!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC544\uC9C1\uC740 \uCEA0\uD504 \uCD08\uBCF4\uAD6C\uB098!\\c\\n\uC6B0\uC120\uC740 \uBB50\uB4E0\uC9C0\\n\uB0C4\uBE44\uC5D0 \uB123\uACE0 \uB9CC\uB4E4\uC5B4\uBCF4\uB3C4\uB85D \uD558\uB834!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774\uC81C \uC870\uAE08 \uCEA0\uD504 \uC694\uB9AC\uC5D0\uB3C4\\n\uC775\uC219\uD574\uC84C\uAD6C\uB098!\\c\\n\uB098\uBB34\uC5F4\uB9E4\uB97C \uC0AC\uC6A9\uD574\uC11C\\n\uC88B\uC544\uD558\uB294 \uCDE8\uD5A5\uC758 \uCE74\uB808\uB97C \uB9CC\uB4E4\uC5B4\uBCF4\uB834"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "10\uC885\uB958\uB098 \uB9CC\uB4E4\uC5C8\uB2E4\uBA74\\n\uC774\uC81C \uCD08\uBCF4\uB294 \uC878\uC5C5\uC774\uC57C!\\c\\n\uC55E\uC73C\uB85C\uB3C4 \uB9CE\uC774 \uB9CE\uC774\\n\uCE74\uB808\uB97C \uD0D0\uAD6C\uD574\uBCF4\uB834!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB108\uB294 \uC774\uBBF8 \uC774 \uAE38\uACE0 \uAE34\\n\uCE74\uB808 \uB85C\uB4DC \uC704\uB97C \uB2EC\uB9AC\uACE0 \uC788\uC5B4!\\c\\n\uB354 \uBA40\uB9AC \uB2EC\uB9AC\uACE0 \uC2F6\uB2E4\uBA74\\n\uC54C\uB9DE\uAC8C \uBD88 \uC870\uC808\uD558\uB294 \uBC95\uC744 \uD130\uB4DD\uD558\uACE0\\r\\n\uB118\uCE58\uC9C0 \uC54A\uAC8C \uD719\uD719 \uC800\uC73C\uB834!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC624\uC624! 30\uC885\uB958 \uC774\uC0C1\uC758\\n\uCE74\uB808\uB97C \uB9CC\uB4E4\uC5C8\uAD6C\uB098!\\c\\n\uB108\uC5D0\uAC8C\uC11C \uCE74\uB808 \uB9CC\uB4E4\uAE30\uC758\\n\uC7AC\uB2A5\uC774 \uBCF4\uC774\uB294 \uAC83 \uAC19\uC544!\\c\\n\uB108\uB77C\uBA74 \uD6E8\uC52C \uB354 \uB192\uC740 \uACBD\uC9C0\uC5D0\\n\uC774\uB97C \uC218 \uC788\uC744 \uAC70\uC57C! \uD30C\uC774\uD305!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC774\uC81C \uC2AC\uC2AC \uCE74\uB808 \uB9CC\uB4E4\uAE30\uAC00\\n\uC0DD\uD65C\uC758 \uC77C\uBD80\uAC00 \uB418\uC9C0 \uC54A\uC558\uB2C8?\\c\\n\uC2DD\uC7AC\uB8CC\uB294 \uC0B4 \uC218\uB3C4 \uC788\uACE0\\n\uAE38\uC5D0 \uB5A8\uC5B4\uC838 \uC788\uC744 \uB54C\uB3C4 \uC788\uC5B4!\\c\\n\uCC29\uC2E4\uD788 \uBAA8\uC544\uB450\uBA74\\n\uB354 \uB2E4\uC591\uD55C \uCE74\uB808\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC70\uC57C!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC774\uC81C\uB294 \uB108\uB3C4 \uCE74\uB808 \uB9CC\uB4E4\uAE30\uC758\\n\uC0C1\uAE09\uC790\uB77C\uACE0 \uD560 \uC218 \uC788\uACA0\uC5B4!\\c\\n\uC774\uBBF8 \uC54C\uACE0 \uC788\uACA0\uC9C0\uB9CC\\n\uB2E4\uB978 \uC0AC\uB78C\uC758 \uD150\uD2B8\uC5D0\uC11C \uC694\uB9AC\uD558\uBA74\\c\\n\uC790\uC2E0\uC774 \uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uC740 \uC2DD\uC7AC\uB8CC\uB85C\\n\uCE74\uB808\uB97C \uB9CC\uB4E4 \uC218\uB3C4 \uC788\uC744 \uAC70\uC57C!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB108\uC758 \uADF8 \uD45C\uC815! \uADF8\uB9AC\uACE0 \uC740\uC740\uD558\uAC8C \uD48D\uAE30\uB294\\n\uC2A4\uD30C\uC774\uC2A4\uC758 \uD5A5\uAE30!\\c\\n\uC5B4\uC5FF\uD55C \uCE74\uB808 \uC694\uB9AC\uC0AC\uAC00 \uB2E4 \uB410\uAD6C\uB098!\\n\uAC00\uB054\uC740 \uB3C4\uAC10\uC744 \uBCF4\uBA74\uC11C\\r\\n\uCD94\uC5B5\uC5D0 \uC7A0\uACA8\uBCF4\uB294 \uAC83\uB3C4 \uC88B\uB2E8\uB2E4!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC544\uB294 \uBAA8\uB4E0 \uCE74\uB808\uB97C\\n\uB9CC\uB4E4\uC5C8\uAD6C\uB098!\\r\\n\uAD49\uC7A5\uD574... \uC815\uB9D0 \uAD49\uC7A5\uD574!\\c\\n\uB108\uB77C\uBA74 \uB098\uB97C \uB6F0\uC5B4\uB118\uC5B4\uC11C\\n\uCE74\uB808\uB3C4\uAC10\uC744\\r\\n\uC644\uC131\uD560 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4!!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC624 \uC624\uC624\uC624!?\\n\uC774\uAC8C \uAFC8\uC740 \uC544\uB2C8\uACA0\uC9C0!?\\c\\n\uB4DC\uB514\uC5B4... \uB4DC\uB514\uC5B4 \uB124\uAC00\\n\uCE74\uB808\uB3C4\uAC10\uC744 \uC644\uC131\uD588\uAD6C\uB098!!\\c\\n\uC774 \uC138\uC0C1\uC758 \uBAA8\uB4E0\\n\uCE74\uB808\uB97C \uB9CC\uB4E4\uB2E4\uB2C8!\\c\\n\uB124\uAC00 \uCEA0\uD504 \uC694\uB9AC\uC758 \uACBD\uC9C0\uB97C\\n\uC5EC\uAE30\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB9B4 \uC904\uC774\uC57C\\c\\n\uB098\uB294 \uC9C0\uAE08 \uC5C4\uCCAD\uB098\uAC8C \uAC10\uB3D9\uD588\uC5B4!\\n\uC815\uB9D0 \uACE0\uB9C8\uC6CC!!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "[VAR 0202(0000)]\uC885\uB958 \uC774\uC0C1\uC744 \uB9CC\uB4E0 \uB124\uAC00\\n\uC870\uAE08 \uAE30\uBED0\uD560 \uB9CC\uD55C \uC0C1\uC744 \uC904\uAC8C!"
  },
