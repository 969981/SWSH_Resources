  },
  {
    "index": 35,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)] \uB3D9\uCC59\uBCFC\uC744\\n\uCEA0\uD504\uC138\uD2B8\uC5D0 \uB123\uC5C8\uB2E4"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)] \uCC54\uD53C\uC5B8\uBCFC\uC744\\n\uCEA0\uD504\uC138\uD2B8\uC5D0 \uB123\uC5C8\uB2E4"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uD0F1\uAE00\uD0F1\uAE00\uBD80\uC5B4\uC2A4\uD2B8\uB294\\n\uC815\uC11D\uC801\uC778 \uD1A0\uD551\uC774\uC57C!\\r\\n\uC694\uB9AC\uD560 \uB54C \uC0AC\uC6A9\uD574\uBD10!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uD504\uB808\uC2DC\uBCFC\uC740\\n\uC0C8\uB85C \uAC1C\uBC1C\uB41C \uBAAC\uC2A4\uD130\uBCFC...\\r\\n\uC774 \uC544\uB2C8\uACE0!\\c\\n\uCEA0\uD504\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uACFC \uB180 \uC218 \uC788\uB294\\n\uC7A5\uB09C\uAC10 \uBCFC\uC774\uC57C\\c\\n\uC288\uBC15\uC5F4\uB9E4\uCC98\uB7FC\\n\uD06C\uACE0 \uBB34\uAC70\uC6CC\uC11C\\r\\n\uB358\uC9C0\uB294 \uAC83\uB3C4 \uACE0\uC0DD\uC774\uB780\uB2E4!"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC744 \uB54C \uC4F0\uB294 \uAC74\\n\uD5E4\uBE44\uBCFC!\\c\\n\uC870\uAE08 \uB2EE\uC558\uC9C0\uB9CC\\n\uC774\uAC74 \uADF8\uB0E5 \uC7A5\uB09C\uAC10\uC778 \uD5E4\uBDD4\uBCFC\uC774\uC57C!\\c\\n\uD5E4\uBDD4\uBCFC\uC740 \uD280\uC5B4 \uC624\uB97C \uB54C\\n\uC5C4\uCCAD\uB098\uAC8C \uD5E4\uBDD4~\uD55C \uC18C\uB9AC\uAC00 \uB09C\uB2E8\uB2E4!\\c\\n\uAF2D \uD55C \uBC88 \uC774\uAC78\uB85C \uCEA0\uD504\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uACFC \uB180\uC544\uBD10!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uD3C9\uC628\uBCFC\uC740 \uB358\uC9C0\uBA74\\n\uAE30\uBD84 \uC88B\uC740 \uBC29\uC6B8 \uC18C\uB9AC\uAC00 \uB09C\uB2E8\uB2E4!\\c\\n\uCEA0\uD504\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uB358\uC838\uC8FC\uBA74\\c\\n\uB2E4\uB4E4 \uB9C8\uC74C\uC774\\n\uD3C9\uC628\uD574\uC9C8 \uAC70\uC57C!"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uBBF8\uB7EC\uBCFC\uC740 \uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB294\\n\uCD5C\uACE0\uB85C \uD391\uD0A4\uD55C \uBCFC\uC774\uC57C!\\c\\n\uCEA0\uD504\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uB358\uC838\uC8FC\uBA74\\r\\n\uD2C0\uB9BC\uC5C6\uC774 \uD765\uACA8\uC6CC\uD560 \uAC70\uC57C!"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "\uB3D9\uCC59\uBCFC\uC740 \uB3D9\uCC59\uC774\uB97C\\n\uB611 \uB2EE\uC740 \uC7A5\uB09C\uAC10 \uBCFC\uC774\uC57C\\c\\n\uD280\uC5B4 \uC624\uB97C \uB54C\uB9C8\uB2E4 \uB3D9\uCC59\uC774\uC758 \uC0AC\uB791\uC2A4\uB7EC\uC6B4\\n\uC6B8\uC74C\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC11C \uADC0\uC5FD\uB2E8\uB2E4!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uBCFC\uC740\\n\uB2E8\uB378\uC758 \uC5BC\uAD74\uC774 \uADF8\uB824\uC9C4 \uCF54\uBBF9\uD55C \uAD7F\uC988\uC57C!\\c\\n\uCEA0\uD504\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uB358\uC838\uC8FC\uBA74\\c\\n\uB2E8\uB378\uC758 \uC5BC\uAD74\uC774 \uD1B5\uD1B5 \uD280\uC5B4\uC11C\\n\uAD49\uC7A5\uD788 \uC7AC\uBBF8\uC788\uB2E8\uB2E4!"
  },
  {
    "index": 44,
    "flags": 0,
