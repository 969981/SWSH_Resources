[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCE74\uBB34 \uCE74\uBB34\uD06C\uB77C\uC6B0[VAR 0114(0079)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC73C\uC74C!? \uB300\uC7A5!\\n\uB204\uAD70\uAC00\uAC00 \uBD80\uB974\uB294 \uB4EF\uD55C \uB290\uB08C\uC774 \uB4E4\uC5C8\uB294\uB370...\\r\\n\uB300\uC7A5\uC774\uC5C8\uC5B4?[VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5B4\uB77C...[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB290\uC544\uC544\uC544\uC545...[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC\\n\uC560\uB9C8\uC5D0 \uB300\uD574\\r\\n\uBB54\uAC00 \uC54C\uC544\uB0B4\uC5C8\uB098?[VAR 0114(0079)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB807\uAD70...\\n\uBB54\uAC00 \uC54C\uAC8C \uB418\uBA74\\r\\n\uB0B4\uAC8C \uC54C\uB824\uC8FC\uAC8C[VAR 0114(0079)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC560\uB9C8\uAC00 \uC88B\uC544\uD558\uB294 \uAC83\uC744\\n\uC54C\uC544\uB0B8 \uAC74\uAC00![VAR 0114(0079)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD568\uAED8 \uC9C0\uB0B8 \uC9C0 \uB108\uBB34 \uC624\uB798\uB418\uB2E4 \uBCF4\uB2C8\\n\uAE4C\uB9E3\uAC8C \uC78A\uACE0 \uC788\uC5C8\uB2E4\uB124...[VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uAC83\uB9CC \uC788\uC73C\uBA74\\n\uB098\uC758 \uC560\uB9C8\uB97C \uBD88\uB7EC\uB0BC \uC218 \uC788\uC744 \uAC83\uC774\uB124!\\r\\n\uADF8\uB798, \uC560\uB9C8\uAC00 \uC88B\uC544\uD558\uB294 \uAC83\uC740 \uBB34\uC5C7\uC774\uC5C8\uC9C0?[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC720\uB300\uC758\uACE0\uC090"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB2F9\uADFC"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD504\uB9AC\uC988\uB208\uAF43\uCDA4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655 T\uC154\uCE20"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBAA8\uB974\uACA0\uC5B4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD760...\\n\uC720\uB300\uC758\uACE0\uC090\uB77C\uACE0?\\c\\n\uD655\uC2E4\uD788 \uADF8\uAC83\uB9CC \uC788\uC73C\uBA74\\n\uC560\uB9C8\uB97C \uBD99\uC7A1\uB294 \uAC83\uB3C4\\r\\n\uC5B4\uB835\uC9C0 \uC54A\uB124\uB9CC...\\c\\n\uC778\uAC04\uB4E4\uC774 \uC720\uB300\uC758\uACE0\uC090\uB97C\\n\uB0B4\uAC8C \uBC14\uCE58\uC9C0 \uC54A\uC740 \uC9C0 \uC624\uB798\uB418\uC5B4\\c\\n\uC9C0\uAE08\uC740 \uC190\uC5D0 \uB123\uC744 \uC218 \uC5C6\uB2E4\uB124[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD760...\\n\uD504\uB9AC\uC988\uB208\uAF43\uCDA4\uC774\uB77C\uACE0?\\c\\n\uBA87 \uB144 \uC804\uC5D0 \uB9C8\uC744\uC758 \uC778\uAC04\uB4E4\uC774\\n\uAE30\uBB18\uD55C \uCDA4\uC744 \uCD94\uB294 \uAC83\uC744 \uBCF8 \uC801\uC774 \uC788\uB124\uB9CC...\\c\\n\uADF8\uB7F0 \uAE30\uAD34\uD55C \uCDA4\uC73C\uB85C\uB294\\n\uC694\uC53D\uB9AC\uC2A4 \uD55C \uB9C8\uB9AC\uB3C4 \uAF80\uC5B4\uB0BC \uC218 \uC5C6\uC744 \uAC83\uC774\uB124[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD760...\\n\uB098\uC758 \uADF8\uB9BC\uC774 \uADF8\uB824\uC9C4 \uC637\uC774\uB77C\uACE0?\\c\\n\uBAA8\uC870\uD488\uC774\uB77C\uACE0\uB294 \uD574\uB3C4\\n\uB098\uC758 \uBAA8\uC2B5\uC774 \uC560\uB9C8\uC758 \uB208\uC5D0 \uB4E4\uC5B4\uC624\uBA74\\c\\n\uB140\uC11D\uC740 \uD544\uC2DC \uC21C\uC2DD\uAC04\uC5D0\\n\uB2EC\uC544\uB098\uBC84\uB9AC\uACE0 \uB9D0 \uAC83\uC774\uB124[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC624\uD638! \uB2F9\uADFC\uC774\uB77C![VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uD655\uC2E4\uD788 \uB140\uC11D\uC774\\n\uC5B4\uB5A4 \uC791\uBB3C\uC744 \uBCF4\uAE30\uB9CC \uD558\uBA74 \uB2EC\uB824\uB4DC\uB294 \uD1B5\uC5D0\\r\\n\uC9C4\uC815\uC2DC\uD0A4\uB294 \uB370 \uACE0\uC0DD\uD55C \uC801\uC774 \uC788\uC5C8\uC9C0[VAR 0114(0079)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uC0DD\uAC01\uD574\uBCF4\uB2C8\\n\uADF8\uAC8C \uB2F9\uADFC\uC774\uC5C8\uAD70!\\r\\n\uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC! \uC54C\uC544\uBD10 \uC918\uC11C \uACE0\uB9D9\uB124![VAR 0114(0079)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774\uC81C \uB2F9\uADFC\uB9CC \uAD6C\uD558\uBA74\\n\uC0AC\uB77C\uC838\uBC84\uB9B0 \uB098\uC758 \uC560\uB9C8\uB97C\\r\\n\uBD88\uB7EC\uB0BC \uC218 \uC788\uACA0\uAD70![VAR 0114(0079)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB9C8\uC744\uC758 \uC778\uAC04\uB4E4\uC774\\n\uB2F9\uADFC\uC744 \uD0A4\uC6B0\uACE0 \uC788\uB358\uAC00?[VAR 0114(0079)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC528\uAC00 \uD55C \uD1A8\uC774\uB77C\uB3C4 \uC788\uC73C\uBA74\\n\uB0B4\uAC00 \uC790\uB77C\uAC8C \uD560 \uC218 \uC788\uB124\uB9CC...[VAR 0114(0079)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB9C8\uC744\uC758 \uC778\uAC04\uB4E4\uC774\\n\uB2F9\uADFC\uC744 \uD0A4\uC6B0\uACE0 \uC788\uB358\uAC00?\\c\\n\uC528\uAC00 \uD55C \uD1A8\uC774\uB77C\uB3C4 \uC788\uC73C\uBA74\\n\uB0B4\uAC00 \uC790\uB77C\uAC8C \uD560 \uC218 \uC788\uB124\uB9CC...[VAR 0114(0079)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC548\uB410\uC9C0\uB9CC \uC774\uC81C\uB294 \uB9C8\uC744\uC5D0\uC11C\\n\uB2F9\uADFC\uC744 \uD0A4\uC6B0\uACE0 \uC788\uC9C0 \uC54A\uB2E8\uB2E4"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "[~ 25]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB2F9\uADFC?\\n\uAC10\uC790\uB77C\uBA74 \uC9D1\uC5D0 \uC788\uB2E4\uB9CC...\\c\\n\uC528\uC557 \uC815\uB3C4\uB294 \uB204\uAD70\uAC00\uAC00\\n\uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uC744\uAE4C?"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uC740\\n\uB450 \uC885\uB958\uC758 \uB2F9\uADFC\uC774\\r\\n\uD2B9\uC0B0\uD488\uC774\uC5C8\uB2E4\uB9CC\\r\\n\uC9C0\uAE08\uC740 \uC5B4\uB290 \uCABD\uB3C4 \uD0A4\uC6B0\uACE0 \uC788\uC9C0 \uC54A\uB2E8\uB2E4"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC0C8\uD558\uC580 \uB9DD\uB098\uB2C8\uAC00\\n\uCC28\uAC00\uC6B4\uB2F9\uADFC \uBA39\uC5C8\uB2E4\u266A\\c\\n\uD558\uC580\uC0C9\uC740 [VAR FF00(0006)]\uC5BC\uC74C[VAR FF00(0000)]\uC0C9\\n\uCC28\uAC00\uC6B4 \uCC44\uC18C\uB97C \uC6B0\uC801\uC6B0\uC801\u266A\\c\\n\uC0C8\uAE4C\uB9CC \uB9DD\uB098\uB2C8\uB294\\n\uAC80\uC740\uB2F9\uADFC \uBA39\uC5C8\uB2E4\u266A\\c\\n\uAC80\uC740\uC0C9\uC740 [VAR FF00(0006)]\uACE0\uC2A4\uD2B8[VAR FF00(0000)]\uC0C9\\n\uAC80\uC740 \uCC44\uC18C\uB97C \uC640\uC791\uC640\uC791\u266A"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB098\uB294 \uC6B0\uB9AC \uD560\uBA38\uB2C8 \uB178\uB798\uAC00\\n\uB108~\uBB34\uB108\uBB34 \uC88B\uC544!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "...\uB2E4\uB978 \uC815\uBCF4\uB97C \uC54C\uC544\uBD10 \uC8FC\uAC8C[VAR 0114(0079)]"
  }
]
