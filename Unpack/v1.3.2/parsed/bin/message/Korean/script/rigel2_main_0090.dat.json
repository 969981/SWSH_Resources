[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624! \uB300\uC7A5!\\n\uB0B4 \uBCA0\uAC1C\uC5D0 \uBB34\uC2A8 \uBB38\uC81C\uB77C\uB3C4 \uC788\uC5B4?[VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBCA0\uAC1C\uC694...?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBA4B\uC9C4 \uBCA0\uAC1C\uB124\uC694!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0? \uD615\uD0DC\uB3C4 \uB2E8\uB2E8\uD568\uB3C4\\n\uC644\uC804 \uB098\uC774\uC2A4\uD55C \uBCA0\uAC1C\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774\uB7F0... \uB300\uC7A5\\n\uB0B4\uAC00 \uC911\uC694\uD55C \uAC78 \uAC00\uB974\uCCD0 \uC904\uAC8C[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBA38\uB9AC\uB97C \uC5B9\uC744 \uC218 \uC788\uB2E4\uBA74\\n\uBB50\uB4E0\uC9C0 \uBCA0\uAC1C\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC0AC\uC2E4\uC740 \uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uBCA0\uAC1C\uB97C\\n\uC9D1\uC5D0 \uB450\uACE0 \uC640\uBC84\uB838\uB294\uB370 \uB9D0\uC774\uC57C...[VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB300\uC2E0 \uBCA0\uACE0 \uC798 \uAC8C \uC5C6\uB098 \uD558\uACE0\\n\uB9C8\uC744 \uC8FC\uBCC0\uC744 \uB3CC\uC544\uB2E4\uB2C8\uB2E4\uAC00\\c\\n\uBBFC\uBC15\uC9D1 \uB4A4\uD3B8\uC5D0\uC11C\\n\uADF8\uAC78 \uC9DC\uC794\uD558\uACE0 \uBC1C\uACAC\uD55C \uAC70\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC8FC\uC138\uC694!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB807\uAD70\uC694..."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC624\uB298 \uBC24\uC740 \uC544\uC8FC \uD3B8\uC548~\uD558\uAC8C\\n\uC7A0\uC744 \uCCAD\uD560 \uC218 \uC788\uACA0\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774\uC57C \uB300\uC7A5?\\n\uB0B4 \uBCA0\uAC1C\uAC00 \uADF8\uB807\uAC8C \uC2E0\uACBD \uC4F0\uC5EC?[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uADF8\uB0E5 \uBCF8 \uAC70\uC608\uC694"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD5E4\uD5E4\uD5E4!\\n\uBCF4\uACE0 \uC2F6\uC740 \uB9CC\uD07C \uBD10\uB3C4 \uB3FC!\\r\\n\uB450 \uB208\uC5D0 \uB611\uB611\uD788 \uC0C8\uACA8\uB450\uB77C\uACE0![VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uBB50, \uBB50\uC57C!? \uC774 \uB098\uC774\uC2A4\uD55C\\n\uBCA0\uAC1C\uB97C \uB118\uAE30\uB77C\uACE0!?[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC544\uBB34\uB9AC \uB300\uC7A5\uC758 \uBD80\uD0C1\uC774\uB77C\uC9C0\uB9CC\\n\uADF8\uAC74 \uBB34\uB9AC\uC57C...![VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "...\uC74C? \uBB50\uB77C\uACE0?[VAR 0114(0076)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\uACFC\\n\uBB54\uAC00 \uAD00\uACC4\uAC00 \uC788\uC744 \uAC83 \uAC19\uB2E4\uACE0?[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC5D0\uC5E5~? \uADF8\uAC8C \uC9C4\uC9DC\uC57C?!\\n\uC774 \uC8FC\uBCC0\uC5D0\uC11C \uC6B0\uC5F0\uD788 \uC8FC\uC6B4 \uAC74\uB370!?[VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uB300\uC7A5\uC774 \uC6D0\uD558\uB294\uB370\\n\uD611\uB825\uD558\uC9C0 \uC54A\uC744 \uC218 \uC5C6\uC9C0[VAR 0114(0076)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC88B\uC544, \uC54C\uC558\uC5B4!\\n\uAC00\uC838\uAC00\uB3C4\uB85D \uD574![VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC774\uC655 \uC774\uB807\uAC8C \uB41C \uAC70\\n\uC804\uC124\uC744 \uAF2D \uCC3E\uC544\uC624\uB77C\uACE0![VAR 0114(0076)]"
  }
]
