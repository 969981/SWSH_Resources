[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC!\\c\\n\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uB824\uBA74\\n\uD130\uD504\uB9C8\uC744\uC758 \uD480\uBC30\uC9C0\uC640\\r\\n\uBC14\uC6B0\uB9C8\uC744\uC758 \uBB3C\uBC30\uC9C0\uAC00 \uD544\uC694\uD558\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC624\uC624 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC!\\n2\uAC1C\uC758 \uBC30\uC9C0\uB97C \uBAA8\uC73C\uB2E4\uB2C8 \uD6CC\uB96D\uD558\uB2E4!\\c\\n\uC21C\uBB34\uB2D8\uC740 \uC9C0\uAE08 \uD2B9\uD6C8\uC744 \uD558\uB7EC\\n\uC81C2\uAD11\uC0B0\uC5D0 \uAC00\uC168\uB2E4!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC774\uB7F0... \uC624\uB298\uC740 \uB2A6\uC5C8\uC73C\uB2C8\\n\uB0B4\uC77C \uB610 \uC624\uAC70\uB77C\\c\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB294\\n\uAF2C\uBABD\uC6B8\uBE44\uC988\uB2C8\uC2A4\uD638\uD154\uC5D0\uC11C \uBB35\uC73C\uBA74 \uB41C\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB07C\uB9AC\\n\uC11C\uB85C \uCD5C\uC120\uC744 \uB2E4\uD574\uBD10\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC6B0\uC120\uC740 \uD130\uD504\uB9C8\uC744\uC5D0 \uAC00\uC57C\uACA0\uC5B4!\\n\uC790 3\uBC88\uB3C4\uB85C\uB85C \uAC00\uC790!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uAE34 \uD588\uC9C0\uB9CC...\\n\uC774\uAE38 \uC790\uC2E0\uC774 \uC5C6\uC5B4\uC84C\uC5B4\\r\\n\uD558\uC544 \uC5B4\uB5BB\uAC8C \uD558\uC9C0..."
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB108\uC758 \uD3EC\uCF13\uBAAC\\n\uC5F4\uC2EC\uD788 \uD558\uB294 \uBAA8\uC2B5\uC774 \uC815\uB9D0 \uB300\uB2E8\uD574...\\c\\n\uC2DC\uD569\uC744 \uBCF4\uACE0 \uB098\uB2C8\uAE4C\\n\uC751\uC6D0\uC744 \uBC1B\uC740 \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774 \uB4E4\uC5B4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uAC1C\uD68C\uC2DD...\\n\uAC00\uC871\uB4E4\uB3C4 TV\uB85C \uBCF4\uACE0 \uC788\uC5B4...\\c\\n\uB2E4\uC2DC \uD55C\uBC88 \uAC70\uC6B8\uB85C\\n\uBA38\uB9AC \uBAA8\uC591\uC744 \uD655\uC778\uD574\uC57C\uACA0\uC5B4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8\uC758 \uC778\uC0AC\uB97C \uBCF4\uACE0...\\n\uAC11\uC790\uAE30 \uC758\uC695\uC774 \uC0D8\uC19F\uC558\uC5B4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD480\uBC30\uC9C0... \uBB3C\uBC30\uC9C0\uB294 \uD68D\uB4DD\uD588\uB294\uB370...\\n\uBD88\uAF43\uBC30\uC9C0\uB294 \uD68D\uB4DD\uD560 \uC218 \uC788\uC744\uAE4C?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC744 \uC774\uACBC\uB2E4\uACE0!?\\n\uB10C \uC815\uB9D0 \uB300\uB2E8\uD55C \uD2B8\uB808\uC774\uB108\uC57C\\c\\n\uB2E4\uB978 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB4E4\uC774\\n\uC2B9\uBD80\uB97C \uAC78\uC5B4\uC62C\uC9C0\uB3C4 \uBAB0\uB77C"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC62C\uD574\uC5D0\uB294 \uC704\uC6D0\uC7A5\uB2D8\uACFC\\n\uCC54\uD53C\uC5B8\uC5D0\uAC8C \uCD94\uCC9C\uBC1B\uC740\\r\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB3C4 \uC788\uB300"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "8\uAC1C\uC758 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBAA8\uC73C\uB294 \uC77C...\\n\uC660\uC9C0 \uBCF4\uBB3C\uC744 \uBAA8\uC73C\uB294 \uAC83 \uAC19\uC544!\\c\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uACFC\uC758 \uC2DC\uD569\uC740\\n\uC5B4\uB5A4 \uBC30\uD2C0\uC774 \uB420\uAE4C?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB108\uB294 \uB2E8\uB378\uB2D8\uC5D0\uAC8C \uCD94\uCC9C\uBC1B\uC740\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAD6C\uB098\\r\\n\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uB2E4\uB2C8 \uACFC\uC5F0 \uB300\uB2E8\uD574"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB2E8\uB378\uB2D8\uC774\uC57C\\c\\n\uB108\uAC19\uC774 \uC6B0\uC218\uD55C \uC7AC\uB2A5\uC744 \uAC00\uC9C4\\n\uD2B8\uB808\uC774\uB108\uB97C \uCD94\uCC9C\uD558\uB2E4\uB2C8"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uAC1C\uD68C\uC2DD\uC740 \uC2DC\uC791\uD558\uAE30\uB3C4 \uC804\uC778\uB370\\n\uBC8C\uC368 \uAE34\uC7A5\uD558\uBA74 \uC5B4\uB5A1\uD558\uC790\uB294 \uAC70\uC57C...\\c\\n\uBCFC \uC548\uC5D0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uC758\uC695\uC774 \uB118\uCE58\uACE0 \uC788\uB294\uB370!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB3D9\uACBD\uD558\uB358 \uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uC130\uC5C8\uC5B4...\\n\uB2E4\uC74C\uC5D0\uB294 \uC2DC\uD569\uC5D0 \uCC38\uAC00\uD558\uACE0 \uB9D0\uACA0\uC5B4!\\c\\n\uADF8\uB9AC\uACE0 \uC2B9\uB9AC\uD574\uC11C\\n\uBAA8\uB450\uB97C \uD765\uBD84\uD558\uAC8C \uB9CC\uB4E4 \uAC70\uC57C!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uCC38\uAC00\uC790\uAC00 \uB9CE\uC740\uB370\uB3C4\\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uB0A8\uB294 \uAC74 \uC18C\uC218\uC5D0 \uBD88\uACFC\uD574..."
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC744 \uBD24\uC73C\uB2C8\uAE4C \uB9CC\uC871...\\n\uC544\uB2C8\uC9C0 \uC4F0\uB7EC\uB728\uB9AC\uB294 \uAC83\uC774 \uBAA9\uD45C\uC57C"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB3C4\\n\uB4DC\uB514\uC5B4 \uAC1C\uB9C9\uC774\uB124\uC694!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC88B\uC558\uC5B4! 3\uBC88\uB3C4\uB85C\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uC744 \uB2E8\uB828\uC2DC\uCF1C\uC57C\uC9C0"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBD88\uAF43\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\\n\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD560 \uAC70\uC608\uC694"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uC5B4\uC694\\n\uC5F4\uC2EC\uD788 \uD574\uC694!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB2E4\uB4E4 \uAE34\uC7A5\uD574\uC11C \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0\\n\uB0A8\uC744 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB974\uACA0\uC5B4"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uB0A8\uB294 \uAC74\\n\uBC14\uB85C \uB098\uC57C"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uACE0 \uC788\uB294\\n\uCC4C\uB9B0\uC800\uB3C4 \uBA87 \uBA85\uC778\uAC00 \uC788\uB124\uC694"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB098\uC758 \uC0C1\uC0C1\uC744 \uB6F0\uC5B4\uB118\uB294\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB85C\uAD70"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uD750\uC74C~ \uB2E4\uB4E4\\n\uCC4C\uB9B0\uC800\uC778 \uAC74\uAC00"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB2E4 \uAC19\uC774 \uD558\uB294 \uC11C\uBC14\uC774\uBC8C\uC774\uB2C8\uAE4C\\n\uBAA8\uB450 \uB77C\uC774\uBC8C\uC774\uB124"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC6B0\uB77C\uB77C\u266A"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC8C4\uC1A1\uD569\uB2C8\uB2E4\\c\\n\uC774 \uC55E\uC740 \uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0\\n\uB3C4\uC804\uD558\uB294 \uC120\uC218\uB9CC \uB4E4\uC5B4\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  },
