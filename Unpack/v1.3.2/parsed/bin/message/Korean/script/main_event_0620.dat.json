[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD5E4\uC774 \uD5E4\uC774 \uD5E4\uC774!\\c\\n\uAE38\uACE0 \uAE34 \uB2E4\uB9AC\uB97C \uAC74\uB108\uC57C \uD558\uB2C8\uAE4C\\n\uBE68\uB9AC \uC790\uC804\uAC70\uB97C \uB0B4\uB193\uC73C\uC2DC\uC8E0![VAR 0114(006F)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBE7C\uC557\uC740 \uC790\uC804\uAC70\uB85C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB97C \uCAD3\uC544\uAC08 \uAC81\uB2C8\uB370\uC5D8!\\r\\n\uB2E4\uC2DC \uB9D0\uD574 \uBC29\uD574\uD558\uACA0\uB2E4\uB294 \uAC81\uB2C8\uB370\uC5D8![VAR 0114(006F)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uC5B5\uC9C0\uAC00!\\c\\n\uC560\uCD08\uC5D0 \uB2F9\uC2E0\uB4E4\uC740\\n\uB85C\uD1A0\uBB34\uB97C \uB370\uB9AC\uACE0 \uC788\uC9C0 \uC54A\uC796\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAC70\uAE30 \uC788\uB294 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2D8!\\n\uC774\uB4E4\uC740 \uC790\uC804\uAC70 \uB3C4\uB451\uC785\uB2C8\uB2E4!\\c\\n\uC800\uB97C \uB3C4\uC640\uC8FC\uB294 \uC148 \uCE58\uACE0\\n\uC774\uB4E4\uC744 \uD63C\uB0B4\uC8FC\uC138\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC6B0\uB9B0 \uC790\uC804\uAC70 \uB3C4\uB451\uC774 \uC544\uB2D9\uB2C8\uB2E4!\\c\\n\uADF8\uC800 \uBE4C\uB9B0 \uC790\uC804\uAC70\uB85C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB97C\\n\uB530\uB77C\uB2E4\uB2C8\uBA74\uC11C \uC9C0\uCE58\uAC8C \uB9CC\uB4E4\uACE0 \uC2F6\uC744 \uBFD0\uC785\uB2C8\uB370\uC5D8!\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB2F9\uC2E0\uC740 \uD2B9\uBCC4\uD788 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C\\n\uB108\uB35C\uB108\uB35C\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC11C \uBC29\uD574\uD574\uC8FC\uACA0\uC2B5\uB2C8\uB370\uC5D8![VAR 0114(006F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD06C\uC73D...\\n\uBC29\uD574\uD558\uB294 \uAC78 \uBC29\uD574\uBC1B\uB2E4\uB2C8...[VAR 0114(006F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC820\uC7A5~! \uC800\uB294 \uC790\uC804\uAC70\uAC00 \uAC16\uACE0 \uC2F6\uB2E8 \uB9D0\uC785\uB2C8\uB370\uC5D8!\\n\uADF8\uB7EC\uB2C8\uAE4C \uBC29\uD574\uD558\uC9C0 \uB9C8\uC2ED\uC1FC![VAR 0114(006F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uCC98\uB7FC \uB108\uBB34 \uAC15\uD55C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00 \uC788\uC73C\uBA74\\r\\n\uADF8\uBD84\uC774 \uC62C\uB77C\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB370\uC5D8!\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uB354 \uC9D1\uC694\uD558\uAC8C \uBC29\uD574\uD574\uC8FC\uACA0\uC2B5\uB2C8\uB370\uC5D8![VAR 0114(006F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB2F9\uC2E0 \uC815\uB9D0 \uB300\uB2E8\uD558\uAD70\uC694!\\c\\n\uAC8C\uB2E4\uAC00 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC78 \uBCF4\uB2C8\\n\uB85C\uD1A0\uBB34\uB3C4 \uAC00\uC9C0\uACE0 \uC788\uACA0\uAD70\uC694!\\c\\n\uC88B\uC2B5\uB2C8\uB2E4! \uC610\uB2E8 \uB530\uC704\uC5D0\uAC8C\\n\uBE7C\uC557\uAE38 \uBC14\uC5D0\uC57C \uB2F9\uC2E0\uC5D0\uAC8C\\r\\n\uC774 \uC790\uC804\uAC70\uB97C \uC120\uBB3C\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC544\uC2DC\uACA0\uC9C0\uB9CC \uB85C\uD1A0\uBB34\uB294\\n\uBAA8\uD130\uB97C \uC544\uC8FC \uB9CE\uC774 \uC0AC\uB791\uD574\uC694\\c\\n\uBAA8\uD130\uAC00 \uB2EC\uB824 \uC788\uB294 \uAE30\uACC4 \uC548\uC5D0\\n\uB4E4\uC5B4\uAC08 \uC815\uB3C4\uB85C \uB9D0\uC774\uC5D0\uC694\\c\\n\uADF8\uB798\uC11C \uC800\uB294 \uC0DD\uAC01\uD588\uC2B5\uB2C8\uB2E4!\\n\uC790\uC804\uAC70\uC5D0 \uBAA8\uD130\uB97C \uB2EC\uBA74\\r\\n\uB85C\uD1A0\uBB34\uAC00 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC744\uAE4C? \uD558\uACE0 \uB9D0\uC774\uC8E0"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD638\uC624..."
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB807\uAD70\uC694"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC774\uB4E0 \uC2DC\uB3C4\uD558\uACE0 \uBCFC \uC77C!\\c\\n\uB2F9\uC2E0\uB3C4 \uB85C\uD1A0\uBB34\uC640 \uD568\uAED8\\n\uC790\uC804\uAC70\uB97C \uC990\uACA8\uC8FC\uC138\uC694!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC790 \uC790 \uC790!\\c\\n\uB2F9\uC2E0\uB3C4 \uB85C\uD1A0\uBB34\uC640 \uD568\uAED8\\n\uC790\uC804\uAC70\uB97C \uD0C0\uBCF4\uC138\uC694!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB9E4\uB274\uC5BC\uC744 \uC77D\uC5B4\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4\\c\\n\uB85C\uD1A0\uBB34\uC640 \uD568\uAED8 \uC790\uC804\uAC70\uB97C \uD0C0\uB824\uBA74\\n\u002B \uBC84\uD2BC\uC774\uB098 - \uBC84\uD2BC\\r\\n\uC790! \uB808\uCE20 \uC0AC\uC774\uD074\uB9C1!"
  }
]
