[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB098\uB294 \uAE30\uC220\uB9C8\uB2C8\uC544\\c\\n\uC2A4\uC2B9\uB2D8 \uBC11\uC5D0\uC11C \uBC24\uB0AE\uC73C\uB85C\\n\uD3EC\uCF13\uBAAC\uC758 \uC0C8\uB85C\uC6B4 \uAE30\uC220\uC744 \uAC1C\uBC1C\uD558\uACE0 \uC788\uC9C0"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC624\uB79C \uC2DC\uAC04\uC5D0 \uAC78\uCCD0\\n\uB0B4\uAC00 \uAC1C\uBC1C\uD574\uB0B8 \uAE30\uC220\uC740 \uC140 \uC218 \uC5C6\uC774 \uB9CE\uC544!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "[~ 2]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "[~ 3]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC57D\uAC04\uC758 \uC815\uC131\uC744 \uBCF4\uC5EC\uC900\uB2E4\uBA74\\n\uBCF4\uB2F5\uC73C\uB85C \uAE30\uC220\uC744 \uAC00\uB974\uCCD0\uC904\uAC8C..."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAC11\uC637\uAD11\uC11D 5\uAC1C\uB9CC\uD07C\uC758 \uC815\uC131\uC744 \uBCF4\uC5EC\uC8FC\uACE0\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uAE30\uC220\uC744 \uAC00\uB974\uCCD0\uBCFC\uB798?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC5B4\uB290 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uAE30\uC220\uC744 \uAC00\uB974\uCE60 \uAC70\uC9C0?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB108\uC758 \uAC11\uC637\uAD11\uC11D\uC774...\\n\uC544\uB2C8, \uC815\uC131\uC774 \uBD80\uC871\uD55C \uBAA8\uC591\uC774\uC57C\\c"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAC11\uC637\uAD11\uC11D\uC740 \uAC11\uC637\uC12C\uC758\\n\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uC5D0\uC11C \uC190\uC5D0 \uB123\uC744 \uC218 \uC788\uC5B4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB2E8\uD638\uD55C \uAC70\uC808...\\n\uC5B4\uB9AC\uAE30\uC5D0 \uAC00\uB2A5\uD55C \uAE30\uC220\uC774\uC9C0"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB7FC \uAC11\uC637\uAD11\uC11D...\\n\uC544\uB2C8, \uC815\uC131\uC744 \uBC1B\uB3C4\uB85D \uD560\uAC8C"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC0C8\uB85C\uC6B4 \uAE30\uC220\uC744 \uAC00\uB974\uCE58\uACE0 \uC2F6\uB2E4\uBA74\\n\uC815\uC131\uC744 \uC900\uBE44\uD574 \uC624\uB3C4\uB85D \uD574"
  }
]
