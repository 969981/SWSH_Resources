    "index": 128,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB0AC\uC5B4!\\n\uAD49\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uACFC \uB9CC\uB0AC\uB2E4\uACE0!\\c\\n\uB0B4\uAC00 \uBC1C\uACAC\uD55C \uAD49\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uC744\\n\uD2B9\uBCC4\uD788 [VAR 0203(0000,0000)]W\uC5D0 \uBCF4\uC5EC\uC904\uAC8C!"
  },
  {
    "index": 129,
    "flags": 0,
    "text": "\uC9C4\uC9DC!?\\n\uC9C4\uC9DC\uB85C \uBCF4\uACE0 \uC2F6\uC9C0 \uC54A\uC740 \uAC70\uC57C!?"
  },
  {
    "index": 130,
    "flags": 0,
    "text": "\uBD10\uBD10!\\n\uB0B4\uAC00 \uBC1C\uACAC\uD55C \uAD49\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uC774\uC57C!"
  },
  {
    "index": 131,
    "flags": 0,
    "text": "\uC815\uB9D0 \uAD49\uC7A5\uD558\uC9C0~!?\\c\\n\uB0A0\uC528\uC5D0 \uB530\uB77C \uB9CC\uB0A0 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774\\n\uB2EC\uB77C\uC9C0\uB2C8\uAE4C \uB108\uB3C4 \uB9E4\uC77C \uCC3E\uC544\uBD10!"
  },
  {
    "index": 132,
    "flags": 0,
    "text": "W\uAC00 \uBD80\uC871\uD574!\\nW\uB97C \uBAA8\uC544\uC624\uBA74 \uBCF4\uC5EC\uC904\uAC8C!"
  },
  {
    "index": 133,
    "flags": 0,
    "text": "\uC218\uD589 \uB3C4\uC911\uC5D0 \uC4F0\uB7EC\uC838\uBC84\uB9AC\uC168\uAD70\uC694...\\n\uC6B0\uC120 \uCE58\uACE0\uB9C8\uB97C \uD68C\uBCF5\uC2DC\uD0A4\uC8E0"
  },
  {
    "index": 134,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uB294 \uAC74\uAC15\uD574\uC84C\uC2B5\uB2C8\uB2E4!\\c\\n\uBB3C\uC758 \uD0D1 \uB3C4\uC804\uC5D0\\n\uBB34\uC6B4\uC774 \uC788\uAE30\uB97C \uAE30\uC6D0\uD558\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 135,
    "flags": 0,
    "text": "\uC77C\uB2E8 \uD3EC\uCF13\uBAAC\uC744\\n\uD68C\uBCF5\uC2DC\uD0A4\uC8E0"
  },
  {
    "index": 136,
    "flags": 0,
    "text": "\uBAA8\uB450 \uAC74\uAC15\uD574\uC84C\uC2B5\uB2C8\uB2E4!\\n\uADF8\uB7FC \uC5F4\uC2EC\uD788 \uD558\uC2ED\uC1FC!"
  },
  {
    "index": 137,
    "flags": 0,
    "text": "\uC218\uD589 \uB3C4\uC911\uC5D0 \uC4F0\uB7EC\uC838\uBC84\uB9AC\uC168\uAD70\uC694...\\n\uC6B0\uC120 \uCE58\uACE0\uB9C8\uB97C \uD68C\uBCF5\uC2DC\uD0A4\uC8E0"
  },
  {
    "index": 138,
    "flags": 0,
    "text": "\uCE58\uACE0\uB9C8\uB294 \uAC74\uAC15\uD574\uC84C\uC2B5\uB2C8\uB2E4!\\c\\n\uC545\uC758 \uD0D1 \uB3C4\uC804\uC5D0\\n\uBB34\uC6B4\uC774 \uC788\uAE30\uB97C \uAE30\uC6D0\uD558\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 139,
    "flags": 0,
    "text": "\uC77C\uB2E8 \uD3EC\uCF13\uBAAC\uC744\\n\uD68C\uBCF5\uC2DC\uD0A4\uC8E0"
  },
  {
    "index": 140,
    "flags": 0,
    "text": "\uBAA8\uB450 \uAC74\uAC15\uD574\uC84C\uC2B5\uB2C8\uB2E4!\\n\uADF8\uB7FC \uC5F4\uC2EC\uD788 \uD558\uC2ED\uC1FC!"
  },
  {
    "index": 141,
    "flags": 0,
    "text": "\uC4F0\uB7EC\uC9C4 \uD3EC\uCF13\uBAAC\uC744\\n\uB3C4\uC7A5\uC5D0\uC11C \uC26C\uAC8C \uD574\uC8FC\uC790!"
  },
  {
    "index": 142,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC740 \uBAA8\uB450\\n\uAC74\uAC15\uD574\uC84C\uB2E4!"
  },
  {
    "index": 143,
    "flags": 0,
    "text": "\uC4F0\uB7EC\uC9C4 \uD3EC\uCF13\uBAAC\uC744\\n\uC544\uC9C0\uD2B8\uC5D0\uC11C \uC26C\uAC8C \uD574\uC8FC\uC790!"
  },
  {
    "index": 144,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC740 \uBAA8\uB450\\n\uAC74\uAC15\uD574\uC84C\uB2E4!"
  },
  {
    "index": 145,
    "flags": 0,
    "text": "\uB4E4\uC5B4\uBD10 \uB4E4\uC5B4\uBD10!\\n\uB0B4\uAC00 \uC870\uAE08 \uC804\uC5D0 \uADDC\uD1A0\uB9AC\uB97C \uC794~\uB729 \uC8FC\uC6E0\uAC70\uB4E0!\\c\\n[VAR 0203(0000,0000)]W\uB9CC \uC8FC\uBA74\\n\uD2B9\uBCC4\uD788 \uB124\uAC8C \uADDC\uD1A0\uB9AC\uB97C \uB118\uACA8\uC904\uAC8C!!"
  },
  {
    "index": 146,
    "flags": 0,
    "text": "\uBB50\uC57C, \uADDC\uD1A0\uB9AC\uAC00 \uD544\uC694 \uC5C6\uB294 \uAC70\uC57C?\\n\uBAA8\uC73C\uAE30 \uC5C4\uCCAD \uD798\uB4E0 \uAC74\uB370~"
  },
  {
    "index": 147,
    "flags": 0,
    "text": "\uC790! \uC5EC\uAE30 \uC788\uC5B4!\\n\uB0B4\uAC00 \uC8FC\uC6B4 \uADDC\uD1A0\uB9AC\uC57C!"
  },
  {
    "index": 148,
    "flags": 0,
    "text": "\uB3C4\uC7A5\uC5D0 \uC788\uB294 \uC73D\uC6B0\uC9C0\uB85C\uBD07\uC774\uB77C\uB294 \uB140\uC11D\uC5D0\uAC8C\\n\uADDC\uD1A0\uB9AC\uB97C 4\uAC1C \uB123\uC73C\uBA74\\c\\n\uAC00~\uB054 \uD76C\uADC0\uD55C \uBCFC\uC774 \uB098\uC62C \uB54C\uAC00 \uC788\uB300"
  },
  {
    "index": 149,
    "flags": 0,
    "text": "W\uAC00 \uBD80\uC871\uD574!\\nW\uB97C \uBAA8\uC544\uC624\uBA74 \uADDC\uD1A0\uB9AC\uB97C \uB118\uACA8\uC904\uAC8C!"
  },
  {
    "index": 150,
    "flags": 0,
    "text": "\uC80A\uC740\uC774\uB4E4\uC740 \uB2E4\uB4E4\\n\uB3C4\uC2DC\uB85C \uAC00\uBC84\uB838\uB2E8\uB2E4\\c\\n\uB178\uC778\uB124\uB4E4\uACFC \uD3EC\uCF13\uBAAC\uB9CC \uB0A8\uC544\uC11C\\n\uADFC\uADFC\uC774 \uC0B4\uC544\uAC00\uACE0 \uC788\uC9C0"
  },
  {
    "index": 151,
    "flags": 0,
    "text": "\uC791\uBB3C\uC740 \uB9C8\uC744\uC5D0\uC11C\\n\uBA39\uC744 \uB9CC\uD07C\uB9CC \uD0A4\uC6B0\uACE0 \uC788\uC9C0\\c\\n\uB0AD\uBE44\uAC00 \uC5C6\uB294 \uC0DD\uD65C...\\n\uB9D0\uD558\uC790\uBA74 \uC790\uAE09\uC790\uC871\uC774\uB77C\uB294 \uAC8C\uC9C0"
  },
  {
    "index": 152,
    "flags": 0,
    "text": "\uB208\uAE38\uC744 \uAC78\uC744 \uB54C\uB294 \uBC1C\uBC14\uB2E5 \uC804\uCCB4\uB85C\\n\uB545\uC744 \uBC1F\uC73C\uBA74\uC11C \uAC77\uB3C4\uB85D \uD558\uB824\uBB34\uB098\\r\\n\uADF8\uB807\uAC8C \uD558\uBA74 \uB118\uC5B4\uC9C0\uC9C0 \uC54A\uC744 \uAC8C\uC57C"
  },
  {
    "index": 153,
    "flags": 0,
    "text": "\uC5B4\uC9F8 \uD574\uAC00 \uAC08\uC218\uB85D\\n\uCD94\uC704\uAC00 \uB9E4\uC11C\uC6CC\uC9C0\uB294 \uAC83 \uAC19\uAD6C\uBA3C"
  },
  {
    "index": 154,
    "flags": 0,
    "text": "\uBCF4\uC798\uAC83\uC5C6\uB294 \uB9C8\uC744\uC774\uC9C0\uB9CC\\n\uB290\uAE0B\uD558\uAC8C \uC788\uB2E4 \uAC00\uB824\uBB34\uB098\\c\\n\uC624\uB798\uB41C \uC870\uAC01\uC0C1 \uB9D0\uACE0\uB294\\n\uBCFC \uAC83\uB3C4 \uC5C6\uC9C0\uB9CC..."
  },
  {
    "index": 155,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655 \uC870\uAC01\uC0C1\uC740 \uBCF4\uC558\uB294\uAC00?[VAR 0114(007A)]"
  },
  {
    "index": 156,
    "flags": 0,
    "text": "\uCD0C\uC7A5\uC758 \uC9D1"
  },
  {
    "index": 157,
    "flags": 0,
    "text": "\uD504\uB9AC\uC988\uBBFC\uBC15"
  },
  {
    "index": 158,
    "flags": 0,
    "text": "\uC7A0\uACA8 \uC788\uC5B4\uC11C\\n\uC9C0\uAE08\uC740 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uB294 \uBAA8\uC591\uC774\uB2E4..."
  },
  {
    "index": 159,
    "flags": 0,
    "text": "...\uC5B4\uB77C?\\n\uBB38\uC5D0 \uBA54\uBAA8\uAC00 \uAF42\uD600 \uC788\uB2E4!\\c\\n\u201C\uAC70\uC778\uC758 \uCE68\uC18C\uC5D0 \uC788\uB294\\n\uBC2D\uC5D0 \uC678\uCD9C\uD569\uB2C8\uB2E4... \uCD0C\uC7A5\u201D"
  },
  {
    "index": 160,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655 \uC870\uAC01\uC0C1\uC774\uB2E4!\\n\uCEE4\uB2E4\uB780 \uC655\uAD00\uC744 \uC4F0\uACE0 \uC788\uB2E4!"
  },
  {
    "index": 161,
    "flags": 0,
    "text": "\uBE68\uAC1B\uACE0 \uD070 \uAE43\uBC1C\uC774 \uB545\uC5D0 \uAF42\uD600 \uC788\uB2E4!"
