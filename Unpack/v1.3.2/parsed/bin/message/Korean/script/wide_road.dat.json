  },
  {
    "index": 57,
    "flags": 0,
    "text": "\uB098\uB294 \uC5C4\uCCAD\uB098\uAC8C \uAC15\uD558\uB2E8\uB2E4!\\n\uC6A9\uB3C8\uB3C4 \uB9CE\uC774 \uAC00\uC9C0\uACE0 \uC788\uC5B4!\\r\\n\uC5B4\uB54C? \uB098\uC640 \uD3EC\uCF13\uBAAC \uC2B9\uBD80 \uD558\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uB108 \uC5C4\uCCAD\uB098\uAC8C \uAC15\uD558\uAD6C\uB098!\\n\uC0C1\uC73C\uB85C \uC88B\uC740 \uC815\uBCF4\uB97C \uAC00\uB974\uCCD0 \uC904\uAC8C\\c\\n\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uB294 \uB5A8\uC5B4\uC838 \uC788\uB294 \uBB3C\uAC74\uC774\\n\uC5C4\uCCAD\uB098\uAC8C \uB9CE\uC544!\\c\\n\uB9CE\uC774 \uB9CE\uC774 \uC8FC\uC6CC\uC11C \uD314\uBA74\\n\uC6A9\uB3C8\uC774 \uC794\uB729 \uBAA8\uC77C \uAC70\uC57C!"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uB098\uB294 \uB354 \uAC15\uD574\uC9C8 \uAC70\uC57C!\\n\uB2E4\uC74C\uC5D0 \uB610 \uC2B9\uBD80\uD558\uC790~!"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uC774\uACA8\uC11C \uAE30\uBD84\uC774 \uC88B\uC73C\uB2C8\uAE4C\\n\uC88B\uC740 \uC815\uBCF4\uB97C \uAC00\uB974\uCCD0 \uC904\uAC8C!\\c\\n\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uB294 \uB5A8\uC5B4\uC838 \uC788\uB294 \uBB3C\uAC74\uC774\\n\uC5C4\uCCAD\uB098\uAC8C \uB9CE\uC544!\\c\\n\uB9CE\uC774 \uB9CE\uC774 \uC8FC\uC6CC\uC11C \uD314\uBA74\\n\uC6A9\uB3C8\uC774 \uC794\uB729 \uBAA8\uC77C \uAC70\uC57C!"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uC5EC\uC5B4! \uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uC190\uC5D0 \uB123\uC740\\n\uC870\uAE08 \uD76C\uADC0\uD55C \uB3C4\uAD6C\uB97C\\r\\n[VAR 0200(0000)]W\uC5D0 \uC0AC\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uC88B\uC544! \uAC70\uB798\uB294 \uC131\uC0AC\uB410\uC5B4!\\c\\n\uB0B4\uAC00 \uBC1C\uACAC\uD55C \uC870\uAE08 \uD76C\uADC0\uD55C \uB3C4\uAD6C\uB97C\\n\uBAA8\uD5D8\uC5D0 \uC720\uC6A9\uD558\uAC8C \uC368\uC918!"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uC640\uC77C\uB4DC\uC5D0\uB9AC\uC5B4\uB294 \uC7AC\uBBF8\uC788\uAC8C \uC990\uAE30\uACE0 \uC788\uB2C8?\\c\\n\uB9E5\uC2A4 \uB808\uC774\uB4DC\uBC30\uD2C0\uC5D0\uC11C\\n\uC190\uC5D0 \uB123\uAE30 \uC26C\uC6B4 \uB3C4\uAD6C\uB3C4 \uC788\uB2E8\uB2E4!"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uD558\uD558\uD558! \uAC11\uC790\uAE30 \uBB3C\uC5B4\uBD24\uC73C\uB2C8\\n\uC758\uC2EC\uD560 \uB9CC\uB3C4 \uD558\uC9C0!\\r\\n\uB9C8\uC74C\uC774 \uBC14\uB00C\uBA74 \uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5B4\uC918!"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uC5C4\uCCAD\uB09C \uAC78 \uB09A\uC558\uC5B4!\\n\uC5C4\uCCAD\uB09C \uAC78 \uB09A\uC558\uB2E4\uACE0!\\c\\n\uC774 \uC5C4\uCCAD\uB09C \uAC83\uC744 \uC9C0\uAE08 \uC0AC\uBA74 [VAR 0203(0000,0000)]W!\\nW\uC640 \uC5C4\uCCAD\uB09C \uAC83\uC744 \uAD50\uD658\uD558\uC9C0 \uC54A\uC744\uB798!?"
  },
  {
    "index": 66,
    "flags": 0,
    "text": "\uC640\uC6B0~! \uC5C4\uCCAD\uB09C \uACB0\uB2E8\uC774\uB85C\uAD70!\\n\uC790! \uC57D\uC18D\uD55C \uC5C4\uCCAD\uB09C \uAC83\uC774\uC57C!"
