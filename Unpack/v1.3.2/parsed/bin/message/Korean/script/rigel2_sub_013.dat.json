[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC800\uB294 \uC138\uACC4\uC801\uC73C\uB85C \uC720\uBA85\uD55C\\n\uD328\uC158 \uB514\uC790\uC774\uB108\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC740 \uAC11\uC637\uC12C\uC5D0\uC11C \uBD24\uB358\\n\uC0DD\uBA85\uC758 \uC740\uC778 \uC544\uB2D9\uB2C8\uAE4C!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB54C \uADF8 \uC544\uC800\uC528\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB204\uAD6C\uC138\uC694?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uACFC\uC5F0 \uB2F9\uC2E0\uB2F5\uAC8C \uAE30\uC5B5\uB825\uB3C4 \uCC38\uC73C\uB85C\\n\uD310\uD0C0\uC2A4\uD2F1\uD558\uAD70\uC694!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "1, 2, \uC9E0! \uD558\uACE0 \uC78A\uC5B4\uBC84\uB9B0 \uCC99\uD558\uC9C0 \uB9C8\uC2DC\uC8E0!\\n\uC81C\uAC00 \uB514\uC790\uC778\uD55C \uC758\uC0C1 \uC138\uD2B8\uB97C \uC0AC\uC168\uC796\uC2B5\uB2C8\uAE4C!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0, \uC81C\uAC8C \uC870\uAE08\\n\uC1FC\uD0B9\uD55C \uC77C\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAE30\uAECF \uB2E8\uB378\uC758 \uC778\uAE30\uC5D0 \uD3B8\uC2B9\uD558\uAE30 \uC704\uD574\\n\uB2E8\uB378 \uB514\uC790\uC778\uC758 \uC637\uC744 \uB9CC\uB4E4\uC5C8\uB294\uB370..."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uAC00 \uB354\uB294 \uCC54\uD53C\uC5B8\uC774 \uC544\uB2C8\uB77C\uB294 \uAC83\\n\uC544\uB2C8\uACA0\uC2B5\uB2C8\uAE4C!!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC584\uBBF8\uC6B4 \uB274 \uCC54\uD53C\uC5B8 \uB54C\uBB38\uC5D0\\n\uC637\uC774 \uC804\uD600 \uD314\uB9AC\uC9C0 \uC54A\uAC8C \uB410\uC2B5\uB2C8\uB2E4\uB9CC\\c\\n\uC9C0\uB09C \uC77C\uC5D0 \uB300\uD574 \uBCF4\uB2F5\uB3C4 \uD560 \uACB8\\n\uC774\uAC83\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR 01C2(0001)] \uB514\uC790\uC778\uC758\\r\\n[VAR FF00(0008)][VAR 01C1(0002)][VAR FF00(0000)]\\r\\n[VAR FF00(0008)][VAR 01C1(0003)][VAR FF00(0000)][VAR 1900(0002)]\\r\\n\uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC800\uB294 \uC544\uC9C1 \uAC70\uBB3C\uC774 \uB418\uACA0\uB2E4\uB294 \uAFC8\uC744\\n\uD3EC\uAE30\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0\uC57C\uB9D0\uB85C \uADF8\uB808\uC774\uD2B8\uD55C \uBAA8\uD2F0\uBE0C\uC758\\n\uC637\uC744 \uB9CC\uB4E4\uC5B4\uC11C \uB9AC\uCE58\uD574\uC9C8 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uB798\uC11C \uB9D0\uC778\uB370,\\n\uADF8\uB808\uC774\uD2B8\uD55C \uBAA8\uD2F0\uBE0C\uAC00 \uB420 \uB9CC\uD55C \uAC70 \uC5C6\uC2B5\uB2C8\uAE4C?\\r\\n\uC608\uB97C \uB4E4\uC5B4... \uC804\uC124\uC758 \uAC70\uC778\uC774\uB77C\uB4E0\uAC00?"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC774, \uC774\uB7F4 \uC218\uAC00!\\n\uADF8 \uD3EC\uCF13\uBAAC\uC740..."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uC758 \uC804\uC124\uC758 \uAC70\uC778!?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC74C~ \uADF8\uB807\uC9C0\uB9CC \uC880 \uB354\\n\uD504\uB808\uC2DC\uD55C \uB290\uB08C\uC774\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB124\uC694!\\r\\n\uB2E4\uB978 \uAC70\uC778\uC744 \uBCF4\uC5EC\uC8FC\uC2DC\uC8E0!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC5B4\uBA54\uC774\uC9D5! \uB808\uC9C0\uB4DC\uB798\uACE0!?\\n\uC804\uC124\uC758 \uAC70\uC778\uC77C \uBFD0\uB9CC \uC544\uB2C8\uB77C\\r\\n\uAC70\uCE60\uAC8C \uC6B8\uBD80\uC9D6\uC744 \uAC83 \uAC19\uC740 \uB290\uB08C\uC774 \uCC38\uC2E0\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC5B4\uBA54\uC774\uC9D5! \uB808\uC9C0\uC5D0\uB808\uD0A4!?\\n\uC804\uC124\uC758 \uAC70\uC778\uC77C \uBFD0\uB9CC \uC544\uB2C8\uB77C\\r\\n\uC9DC\uB9BF\uC9DC\uB9BF\uD55C \uB290\uB08C\uC774 \uCC38\uC2E0\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC800\uC758 \uC601\uAC10\uC774\\n\uB9C8\uAD6C\uB9C8\uAD6C \uC0D8\uC19F\uAE30 \uC2DC\uC791\uD558\uB294\uAD70\uC694~!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC624\uCF00\uC774! \uD310\uD0C0\uC2A4\uD2F1!\\n\uC608\uC2A4! \uC608\uC2A4!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC774\uAC83\uC774 \uBC14\uB85C \uADF8\uB808\uC774\uD2B8\uD568\uACFC\\n\uD504\uB808\uC2DC\uD568\uC774 \uB4A4\uC11E\uC778 \uC804\uC124\uC758 \uC758\uC0C1\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR 01C2(0001)] \uB514\uC790\uC778\uC758\\r\\n[VAR FF00(0008)][VAR 01C1(0002)][VAR FF00(0000)][VAR 1900(0002)]\\r\\n\uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB2E4\uB978 \uAC70\uC778\uC744 \uBC1C\uACAC\uD558\uC2DC\uAC8C \uB41C\uB2E4\uBA74\\n\uC81C\uAC8C \uBCF4\uC5EC\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB108\uBB34\uB098\uB3C4 \uCC9C\uC7AC\uC801\uC774\uB77C\\n\uC800 \uC790\uC2E0\uC774 \uB450\uB824\uC6B8 \uC815\uB3C4\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC5D0\uAC8C\uB294 \uADF8\uC800\\n\uAC10\uC0AC\uD558\uACE0 \uB610 \uAC10\uC0AC\uD560 \uB530\uB984\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC5D0\uAC8C\uC11C \uBC1B\uC740\\n\uC601\uAC10\uC744 \uBC1C\uD310\uC73C\uB85C \uC0BC\uC544\\r\\n\uC800\uB294 \uB354 \uD070 \uAC70\uBB3C\uC774 \uB418\uACA0\uC2B5\uB2C8\uB2E4~!"
  }
]
