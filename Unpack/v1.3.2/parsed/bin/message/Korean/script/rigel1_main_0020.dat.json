[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC544\uD558\uD558! \uC5EC\uAE30 \uC788\uC5C8\uAD6C\uB098![VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD750\uC74C... \uC81C\uAC00 \uC548\uB0B4\uD560 \uC5EC\uD589\uC790\uAC00\\n\uB2F9\uC2E0\uC774\uAD70\uC694[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC57D\uC18D \uC2DC\uAC04\uC5D0 \uB531 \uB9DE\uCDB0\uC11C \uC624\uB2E4\uB2C8\\n\uC5B4\uB9B0 \uB098\uC774\uC5D0 \uC81C\uBC95\uC778\uAC78![VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC57D\uC18D \uC2DC\uAC04\uC5D0 \uB531 \uB9DE\uCDB0\uC11C \uC624\uB2E4\uB2C8...\\n\uC544\uC8FC \uD6CC\uB96D\uD55C \uB9C8\uC74C\uAC00\uC9D0\uC785\uB2C8\uB2E4[VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uD639\uC2DC \uC6B0\uB9AC\\n\uC5B4\uB514\uC11C \uB9CC\uB09C \uC801 \uC788\uB2C8?\\r\\n...\uBB50, \uC544\uBB34\uB834 \uC5B4\uB54C![VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD750\uC74C? \uD639\uC2DC \uC6B0\uB9AC\\n\uC5B4\uB514\uC120\uAC00 \uBCF8 \uC801 \uC788\uB098\uC694?\\c\\n...\uC544\uC544 \uC774\uB7F0 \uAC78 \uAE4C\uB9E3\uAC8C \uC78A\uC5B4\uBC84\uB9AC\uB2E4\uB2C8\\n\uB9DD\uAC01\uC220\uC744 \uC4F4 \uC57C\uB3C8\uC774 \uB41C \uAE30\uBD84\uC774\uB124\uC694[VAR 0114(0042)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB0B4 \uC774\uB984\uC740 \uB3C4\uC815!\\n\uB108\uC758 \uC120\uBC30\uB2D8\uC774\uC57C![VAR 0114(0071)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC81C \uC774\uB984\uC740 \uC138\uC774\uBC84\uB9AC\\n\uB2F9\uC2E0\uC758 \uC120\uBC30\uC785\uB2C8\uB2E4[VAR 0114(0072)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC120\uBC30\uB2D8\uC774\uC694?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC0AC\uB78C\uC744 \uC798\uBABB \uBCF4\uC2E0 \uAC83 \uAC19\uC740\uB370\uC694"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB124\uAC00 \uC624\uB298\uBD80\uD130 \uB4E4\uC5B4\uC62C\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC758 \uC120\uBC30 \uB9D0\uC774\uC57C![VAR 0114(0071)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC624\uB298\uBD80\uD130 \uB2F9\uC2E0\uC774 \uC785\uBB38\uD560\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC758 \uC120\uBC30\uB97C \uB9D0\uD558\uB294 \uAC81\uB2C8\uB2E4[VAR 0114(0072)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5B4\uB77C...? \uD639\uC2DC \uB098\uBCF4\uB2E4 \uC5B4\uB9B0 \uC8FC\uC81C\uC5D0\\n\uB098\uB97C \uB180\uB9B4 \uC0DD\uAC01\uC778 \uAC74\uAC00?\\c\\n\uC774 \uB300\uBC15 \uD504\uB9AC\uD2F0\uD558\uACE0\\n\uD37C\uD399\uD2B8\uD55C \uB3C4\uC815\uC774\uB97C?[VAR 0114(0071)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5B4\uB5BB\uAC8C \uC800\uB807\uAC8C\uB3C4 \uC774\uD574\uB825\uC774 \uBD80\uC871\uD560 \uC218 \uC788\uC9C0?\\n\uB9C8\uCE58 \uAE38\uC744 \uC783\uACE0 \uBC8C\uBC8C \uB5A0\uB294 \uC6B0\uB974\uC640\uB3C4 \uAC19\uAD70\\c\\n\uC774\uB807\uAC8C \uB41C \uAC70 \uC5D8\uB808\uAC15\uC2A4\uD55C \uB0B4\uAC00\\n\uC5B4\uB978\uB2F5\uAC8C \uC5D0\uC2A4\uCF54\uD2B8\uD574\uC57C\uACA0\uC5B4[VAR 0114(0072)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC73C\uC74C... \uC6B0\uC120\uC740 \uC2B9\uBD80\uB85C\\n\uB0B4 \uC2E4\uB825\uC744 \uB290\uAEF4\uBCF4\uB294 \uAC8C \uC88B\uACA0\uC9C0?[VAR 0114(0071)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "...\uADF8\uB7FC \uC6B0\uC120 \uC11C\uB85C\uC758 \uC2E4\uB825\uC744 \uD655\uC778\uD558\uBA70\\n\uCE5C\uBAA9\uC744 \uB2E4\uC838\uBCFC\uAE4C\uC694?[VAR 0114(0072)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uBC16\uC5D0\uC11C \uAE30\uB2E4\uB9B4 \uD14C\uB2C8\uAE4C\\n\uC900\uBE44\uAC00 \uB418\uBA74 \uC624\uB3C4\uB85D \uD574[VAR 0114(0071)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uBC16\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uD14C\uB2C8\\n\uC900\uBE44\uAC00 \uB418\uBA74 \uC624\uC138\uC694[VAR 0114(0072)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB530\uB054\uD55C \uB9DB\uC744 \uBCF4\uC5EC\uC904 \uD14C\uB2C8\uAE4C...![VAR 0114(0071)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC81C\uAC00 \uB2F9\uC2E0\uBCF4\uB2E4 \uC704\uB77C\uB294 \uAC83\uC744\\n\uB611\uB611\uD788 \uAC00\uB974\uCCD0\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4...[VAR 0114(0072)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774 \uC12C\uC5D0 \uC788\uB294 \uB3C4\uC7A5\uC5D0\\n\uC624\uB298\uBD80\uD130 \uC785\uBB38\uD560 \uAC74\uB370\\c\\n\uC774\uC0C1\uD55C \uC0AC\uB78C\uC774 \uC5ED \uC55E\uC5D0 \uC788\uC5B4\uC11C\\n\uB098\uAC00\uAE30 \uAEC4\uB044\uB7FD\uB2E8 \uB9D0\uC774\uC9C0..."
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD639\uC2DC \uC870\uAE08 \uC804\uC5D0 \uADF8 \uC0AC\uB78C... \uB3C4\uC7A5 \uC0AC\uB78C\uC774\uC57C?\\n...\uADF8\uB0E5 \uAC00\uC9C0 \uB9D0\uAE4C...\\r\\n\uB124\uAC00 \uB098 \uB300\uC2E0 \uC785\uBB38\uD558\uB294 \uAC74 \uC5B4\uB5A0\uB2C8?"
  }
]
