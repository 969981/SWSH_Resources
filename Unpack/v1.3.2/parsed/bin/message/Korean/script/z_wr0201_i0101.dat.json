    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB7B4\uB7B4\uB7B4~!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774 \uC55E\uC740\\n\uC2E0\uC131\uD55C \uBC30\uD2C0\uCF54\uD2B8\uC785\uB2C8\uB2E4\\c\\n\uC2B9\uBD80 \uBAA9\uC801 \uC774\uC678\uC5D0\uB294\\n\uCD9C\uC785\uC744 \uAE08\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBC30\uD2C0\uCF54\uD2B8\uC5D0\uC11C\\n\uB3C4\uC815\uB2D8\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4\\r\\n...\uCD5C\uC120\uC744 \uB2E4\uD574 \uC8FC\uC2ED\uC2DC\uC624!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uBC30\uD2C0\uCF54\uD2B8\uC5D0\uC11C\\n\uC138\uC774\uBC84\uB9AC\uB2D8\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4\\r\\n...\uCD5C\uC120\uC744 \uB2E4\uD574 \uC8FC\uC2ED\uC2DC\uC624!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uBC30\uD2C0\uCF54\uD2B8\uC5D0\uC11C\\n\uB9C8\uC2A4\uD130\uB4DC \uC2A4\uC2B9\uB2D8\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4\\r\\n...\uAC74\uD22C\uB97C \uAE30\uC6D0\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC5B4\uC774\uAD6C, \uAC70\uAE30 \uC788\uC73C\uBA74\\nTV\uAC00 \uC548 \uBCF4\uC778\uB2E8\uB2E4[VAR 0114(0073)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "[VAR 0100(0000)]...\\c\\n\uB0A8\uB4E4\uC774 \uC2EB\uC5B4\uD558\uB294 \uC9D3\uC740 \uD558\uB294 \uAC8C \uC544\uB2C8\uB780\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uAC11\uC637\uC12C\uC5D0 \uB3C4\uCC29\uD588\uC744 \uB54C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uB791\\r\\n\uC5ED\uC5D0\uC11C \uB9C8\uC8FC\uCCE4\uC5C8\uC5B4!\\r\\n\uAC11\uC637\uC12C \uC5B4\uB518\uAC00\uC5D0\uC11C \uB9CC\uB0A0 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C![VAR 0114(0005)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uC870\uC0AC \uC911\uC5D0\\r\\n\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC744 \uBC1C\uACAC\uD588\uC5B4![VAR 0114(0005)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uBCF4\uC5EC\uC918!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB098\uC911\uC5D0 \uBCFC\uAC8C"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC218\uD589\uD558\uB290\uB77C \uBC14\uC05C \uAC70\uC57C?\\n\uB098\uB3C4 \uC9C8 \uC218 \uC5C6\uC9C0![VAR 0114(0005)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uD5E4\uD5E4~ \uAD49\uC7A5\uD558\uC9C0!?\\n\uB124\uAC00 \uBCF8 \uC801 \uC5C6\uB294 \uD3EC\uCF13\uBAAC\uC744 \uBC1C\uACAC\uD558\uBA74\\r\\n\uB2E4\uC74C\uC5D0 \uB610 \uC54C\uB824\uC904\uAC8C![VAR 0114(0005)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC624\uB298\uC740 \uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC744\\n\uB9CC\uB098\uAC8C \uB420\uAE4C?\\r\\n\uB9E4\uC77C\uB9E4\uC77C\uC774 \uAE30\uB300\uAC00 \uB3FC![VAR 0114(0005)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uB2E4\uC591\uD55C \uB300\uD68C\uC758\\n\uBA54\uB2EC\uC774 \uC9C4\uC5F4\uB418\uC5B4 \uC788\uB2E4!"
  },
