    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130 \uB3C4\uC7A5 \uBB38\uD558\uC0DD\\c\\n...... ......\\n...\uC138\uC774\uBC84\uB9AC"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130 \uB3C4\uC7A5 \uBB38\uD558\uC0DD\\c\\n...... ......\\n\uC138\uC774\uBC84\uB9AC [VAR 0100(0000)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uADFC\uB825\uC744\\n\uB2E8\uB828\uD558\uB294 \uAE30\uAD6C\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uAE08\uBE5B\uC73C\uB85C \uBC88\uCA4D\uC774\uB294\\n\uD2B8\uB85C\uD53C\uAC00 \uC794\uB729 \uC788\uB2E4!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC774\uAC74...!\\c\\n\uB124\uBAA8\uB09C \uD3EC\uCF13\uBAAC\uC774\\n\uC794\uB729 \uB098\uC624\uB294 \uAC8C\uC784\uC774\uB2E4!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB2E4\uC591\uD55C \uAC8C\uC784\uC758\\n\uACF5\uB7B5\uC9D1\uC774 \uB098\uC5F4\uB418\uC5B4 \uC788\uB2E4!"
  },
