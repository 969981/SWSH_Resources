[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD6C4\uAC00~! \uD6C4\uAC00\uAC00\uAC00~!\\c\\n\uB09C \uD3EC\uCF13\uBAAC\uC774\uB2E4!\\n\uB108 \uB098\uC640 \uC2B9\uBD80\uD574\uB77C~!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC790 \uB4E4\uC5B4\uBD10\\c\\n\uC5FC\uBC84\uB2C8\uC640 \uD0DC\uC6B0\uC9C0\uB124\uB294\\n\uAC19\uC740 \uC885\uC871\uC778\uAC00? \uC544\uB2C8\uC9C0?\\c\\n\uD558\uC9C0\uB9CC \uC6B0\uB9AC\uB294 \uADF8\uB4E4\uC744 \uD1B5\uD2C0\uC5B4\uC11C\\n\uD3EC\uCF13\uBAAC\uC774\uB77C\uACE0 \uBD88\uB7EC\\c\\n\uC5FC\uBC84\uB2C8\uC640 \uB098\uB3C4 \uB2E4\uB978 \uC885\uC871\\n\uB098\uC640 \uD0DC\uC6B0\uC9C0\uB124\uB3C4 \uB2E4\uB978 \uC885\uC871\uC774\uC57C\\c\\n\uADF8\uB807\uB2E4\uBA74 \uB098\uB97C \uD3EC\uCF13\uBAAC\uC774\uB77C\uACE0\\n\uBD88\uB7EC\uB3C4 \uB418\uB294 \uAC70 \uC544\uB2D0\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "...\uC544\uB2C8\\n\uC2E0\uACBD \uC368\uC8FC\uC9C0 \uC54A\uC544\uB3C4 \uB3FC\\r\\n\uB9D0\uB3C4 \uC548 \uB41C\uB2E4\uB294 \uAC74 \uB098\uB3C4 \uC54C\uACE0 \uC788\uC5B4\\c\\n\uB098\uB294...\\n\uD3EC\uCF13\uBAAC\uC774 \uB418\uACE0 \uC2F6\uC5C8\uC5B4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB420 \uC218 \uC788\uC5B4\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "...\uD30C\uC774\uD305"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0?! \uD328\uC158\uC744 \uBC14\uAFB8\uBA74\\n\uAE30\uBD84\uB3C4 \uB2EC\uB77C\uC9C0\uC796\uC544\\c\\n\uC989, \uD3EC\uCF13\uBAAC\uC758 \uAE30\uBD84\uC774 \uB418\uBA74\\n\uC5B4\uB5A4 \uC758\uBBF8\uB85C\uB294 \uD3EC\uCF13\uBAAC\uC774 \uB410\uB2E4\uACE0\\r\\n\uD574\uB3C4 \uB418\uB294 \uAC70 \uC544\uB2C8\uC57C!?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB108! \uB098\uC758 \uBD88\uD0C0\uC624\uB974\uB294 \uB9C8\uC74C\uC744\\n\uD45C\uD604\uD558\uB294 \uC637\uC744!\\c\\n\uBD88\uAF43\uC774 \uB290\uAEF4\uC9C0\uB294 \uB514\uC790\uC778\uC758 \uC637\uC744!\\n\uB0B4 \uC55E\uC5D0 \uC785\uACE0 \uC640\uC8FC\uC9C0 \uC54A\uC744\uB798?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "...\uC74C\\n\uC2E0\uACBD \uC368\uC918\uC11C \uACE0\uB9D9\uC9C0\uB9CC\\r\\n\uADF8 \uCC28\uB9BC\uC73C\uB85C\uB294 \uD3EC\uCF13\uBAAC\uC774 \uB420 \uC218 \uC5C6\uC5B4\\c\\n\uBD88\uAF43\uC774 \uB290\uAEF4\uC9C0\uB294 \uB514\uC790\uC778\uC758 \uC637\uC744!\\n\uB0B4 \uC55E\uC5D0 \uC785\uACE0 \uC640\uC918!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBB50\uC57C? \uADF8\uAC83\uC740? \uB9C8\uCE58\\n\uB0B4\uAC00 \uD3EC\uCF13\uBAAC\uC774 \uB41C \uAC83 \uAC19\uC544\\c\\n\uBD88\uAF43\uC774 \uB290\uAEF4\uC9C0\uB294 \uB728\uAC70\uC6B4 \uC544\uC774\uD15C\uC774\\n\uCC29\uC6A9\uD558\uAE30\uB9CC \uD574\uB3C4 \uAE30\uBD84\uC774 \uB2EC\uB77C\uC838\uC11C\\r\\n\uB098\uB97C \uBD88\uAF43\uD3EC\uCF13\uBAAC\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC8FC\uB294 \uAC83 \uAC19\uC544!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC2E0\uACBD \uC368\uC918\uC11C \uACE0\uB9C8\uC6CC!\\n\uBCF4\uC798\uAC83\uC5C6\uB294 \uAC70\uC9C0\uB9CC \uBC1B\uC544\uC918\\c\\n\uC560\uD06C\uB7EC\uBC43 \uAE30\uC220\uC740\\n\uB3C4\uAD6C\uB97C \uC9C0\uB2C8\uC9C0 \uC54A\uC73C\uBA74\\r\\n\uB370\uBBF8\uC9C0\uAC00 \uC99D\uAC00\uD574!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC0DD\uAC01\uD574\uBD24\uB294\uB370 \uB9CC\uC57D\\n\uC73D\uC6B0\uC9C0\uAC00 \uB098\uB97C \uC0BC\uCF30\uC744 \uB54C\\r\\n\uB204\uAD70\uAC00\uC5D0\uAC8C \uC7A1\uD78C\uB2E4\uBA74\\c\\n\uB098\uB3C4 \uBAAC\uC2A4\uD130\uBCFC\uC5D0\\n\uB4E4\uC5B4\uAC00\uAC8C \uB418\uB294 \uAC70\uC9C0?\\c\\n\uADF8\uB807\uB2E4\uBA74 \uB098\uB294 \uC778\uB958 \uCD5C\uCD08\uB85C\\n\uBAAC\uC2A4\uD130\uBCFC\uC5D0 \uC7A1\uD78C \uC0AC\uB098\uC774\uAC00\\r\\n\uB418\uB294 \uAC8C \uC544\uB2D0\uAE4C?!\\c\\n\uB2E4\uC2DC \uB9D0\uD574\uC11C\\n\uB098 = \uD3EC\uCF13\uBAAC\uC778 \uAC70\uC9C0?\\r\\n\uC544\uB2C8\uC57C? \uC751 \uC544\uB2C8\uAD6C\uB098!"
  },
  {
