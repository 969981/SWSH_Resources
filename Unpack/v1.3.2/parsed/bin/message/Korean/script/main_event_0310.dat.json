[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC751?\\n\uC800\uAC8C \uBB50\uC9C0!?[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBD10\uBD10 [VAR 0100(0000)]!\\n\uC18C\uC6D0\uC758\uBCC4\uC774\uC57C!!\\c\\n\uC2EC\uC9C0\uC5B4 2\uAC1C\uB098 \uB5A8\uC5B4\uC9C0\uB2E4\uB2C8!\\n\uC790 1\uAC1C\uB294 \uB108\uD55C\uD14C \uC904\uAC8C![VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC18C\uC6D0\uC758\uBCC4\uC774 \uC788\uC73C\uBA74\\n\uB098\uB3C4 \uD3EC\uCF13\uBAAC\uC744\\r\\n\uB2E4\uC774\uB9E5\uC2A4\uC2DC\uD0AC \uC218 \uC788\uC5B4!![VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAD49\uC7A5\uD55C\uAC78!\\c\\n\uC18C\uC6D0\uC758\uBCC4\uC740 \uC9C4\uC815\uD55C \uC18C\uC6D0\uC744 \uAC00\uC9C4\\n\uC0AC\uB78C\uC5D0\uAC8C \uB5A8\uC5B4\uC9C4\uB2E4\uB294 \uC804\uC124\uC774 \uC788\uC5B4[VAR 0114(0004)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCD5C\uAC15\uC758 \uD2B8\uB808\uC774\uB108\uAC00 \uB418\uACE0 \uC2F6\uB2E4!\\c\\n\uCD5C\uAC15\uC758 \uD2B8\uB808\uC774\uB108\uAC00 \uB418\uACE0 \uC2F6\uB2E4!!\\c\\n\uCD5C\uAC15\uC758 \uD2B8\uB808\uC774\uB108\uAC00 \uB418\uACE0 \uC2F6\uB2E4!!!\\c\\n\uC88B\uC544! \uC138 \uBC88 \uC678\uCCE4\uC73C\uB2C8\uAE4C\\n\uC18C\uC6D0\uC774 \uC774\uB904\uC9C8 \uAC70\uC57C![VAR 0114(0005)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD638\uBE0C...\\c\\n\uC18C\uC6D0\uC758\uBCC4\uC740 \uBBF8\uC9C0\uC758 \uD798\uC774\\n\uB2F4\uAE34 \uC2E0\uBE44\uD55C \uB3CC...\\r\\n\uB9D0\uD558\uC790\uBA74 \uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uBCF4\uBB3C\uC774\uB780\uB2E4\\c\\n\uB2E4\uB9CC \uADF8\uB300\uB85C\uB294 \uC4F8 \uC218 \uC5C6\uC73C\uB2C8\\n\uB0B4\uAC8C \uC7A0\uAE50 \uBE4C\uB824\uC8FC\uB824\uBB34\uB098[VAR 0114(000A)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC544 \uB9DE\uB2E4! \uBC15\uC0AC\uB2D8\uC740\\n\uB2E4\uC774\uB9E5\uC2A4\uB97C \uC5F0\uAD6C\uD558\uC168\uC5C8\uC9C0!\\c\\n\uC800\uC640 [VAR 0100(0000)]\uC5D0\uAC8C\uB3C4\\n\uB2E4\uC774\uB9E5\uC2A4\uC758 \uD798\uC744 \uC8FC\uC2E4 \uC218 \uC788\uB294 \uAC70\uC8E0?[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAFB8\uBC85\uC878\uC74C\uC232\uC5D0\uC11C\uB294\\n\uC774\uC0C1\uD55C \uD3EC\uCF13\uBAAC\uACFC \uC2F8\uC6E0\uC5C8\uACE0\\r\\n\uC55E\uC73C\uB85C \uBB54\uAC00 \uAD49\uC7A5\uD55C \uC77C\uC774 \uC77C\uC5B4\uB0A0 \uAC83 \uAC19\uC544![VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB4E4\uB72C \uAE30\uBD84\uC740 \uC798 \uC54C\uACA0\uB2E4\uB9CC \uC9C4\uC815\uD558\uC9C0 \uC54A\uC73C\uBA74\\n\uB0B4\uC77C \uC5EC\uD589\uD560 \uB54C \uD798\uB4E4 \uAC70\uB780\uB2E4[VAR 0114(000A)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB3CC\uC544\uC654\uB354\uB2C8\\n\uBB54\uAC00 \uB2E4\uB4E4 \uB4E4\uB5A0 \uC788\uB124?[VAR 0114(000B)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB108\uD76C\uB4E4\\n\uC800\uB141 \uBA39\uACE0 \uAC08 \uAC70\uC9C0?\\c\\n\uB0B4\uAC00 \uC694\uC998 \uC720\uD589\uD558\uB294 \uCE74\uB808\uB77C\uC774\uC2A4\\n\uC694\uB9AC\uBC95\uC5D0 \uD479 \uBE60\uC838 \uC788\uAC70\uB4E0[VAR 0114(000B)]"
  }
]
