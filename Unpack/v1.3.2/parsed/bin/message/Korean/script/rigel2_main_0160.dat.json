[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC774\uC57C~ \uC815\uC2E0\uC744 \uCC28\uB824\uBCF4\uB2C8\\n\uB610 \uC120 \uCC44\uB85C \uBC16\uC5D0\uC11C \uC790\uACE0 \uC788\uC5C8\uC9C0 \uBB50\uC57C![VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBAB8\uB3C4 \uC73C\uC2AC\uC73C\uC2AC\uD558\uACE0\\n\uC544\uC9C0\uD2B8\uB85C \uB3CC\uC544\uAC00\uC11C \uC0E4\uC6CC\uD558\uB824\uACE0 \uD588\uB294\uB370\\r\\n\uCC28\uAC00\uC6B4 \uBB3C\uC774 \uB098\uC624\uB294 \uAC70 \uC788\uC9C0![VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAE5C\uC9DD \uB180\uB77C\uC11C \uADF8\uB9CC\\n\uC54C\uBAB8\uC778 \uCC44\uB85C...[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB290\uC544\uC544\uC544\uC545...[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC!\\n\uC720\uB300\uC758\uACE0\uC090\uB294 \uB9CC\uB4E4\uC5C8\uB294\uAC00?[VAR 0114(0079)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC9C0!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD53C\uC624\uB2C8 \uB300\uC7A5\uC774 \uB9CC\uB4E4\uC5B4\uC92C\uC5B4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC624\uC624! \uCC38\uC73C\uB85C \uAE30\uC05C \uC18C\uC2DD\uC774\uB85C\uAD70![VAR 0114(0079)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uD638\uC624, \uC774\uC790\uC5D0\uAC8C\uB294\\n\uC5EC\uB7EC\uBAA8\uB85C \uB3C4\uC6C0\uC744 \uBC1B\uAC8C \uB418\uB294\uAD70[VAR 0114(0079)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE30\uC05C \uC77C\uC740 \uC5F0\uB2EC\uC544 \uC77C\uC5B4\uB098\uB294 \uBC95!\\n\uB098\uB294 \uC870\uAE08 \uC804\uC5D0\\r\\n\uC560\uB9C8\uAC00 \uC788\uB294 \uACF3\uC744 \uC54C\uC544\uB0C8\uC9C0![VAR 0114(0079)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBE14\uB9AC\uC790\uD3EC\uC2A4\uB294 \uC655\uAD00\uC2E0\uC804\uC744\\n\uADFC\uAC70\uC9C0\uB85C \uC0BC\uACE0 \uC788\uC5C8\uB124!\\c\\n\uD55C\uB54C \uB098\uC640 \uB140\uC11D\uC774\\n\uD568\uAED8 \uC9C0\uB0B4\uB358 \uC7A5\uC18C\uC9C0![VAR 0114(0079)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB808\uC774\uC2A4\uD3EC\uC2A4\uB294 \uC655\uAD00\uC2E0\uC804\uC744\\n\uADFC\uAC70\uC9C0\uB85C \uC0BC\uACE0 \uC788\uC5C8\uB124!\\c\\n\uD55C\uB54C \uB098\uC640 \uB140\uC11D\uC774\\n\uD568\uAED8 \uC9C0\uB0B4\uB358 \uC7A5\uC18C\uC9C0![VAR 0114(0079)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC61B\uB0A0 \uC77C\uC774 \uB5A0\uC62C\uB77C\uC11C\\n\uB098\uB294 \uBC1C\uAE38\uC744 \uB04A\uC5C8\uC9C0\uB9CC...[VAR 0114(0079)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC124\uB9C8 \uB140\uC11D...\\n\uB098\uC640\uC758 \uCD94\uC5B5\uC744 \uB5A0\uC62C\uB9AC\uAE30 \uC704\uD574 \uADF8\uACF3\uC5D0...?\\r\\n\uC544\uB2C8, \uADF8\uB7F4 \uB9AC\uAC00[VAR 0114(0079)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC655\uAD00\uC2E0\uC804\uC740 \uBD81\uCABD \uC0B0\\n\uC815\uC0C1\uC5D0 \uC788\uC73C\uB2C8\uAE4C[VAR 0114(0079)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC720\uB300\uC758\uACE0\uC090\uC640 \uB2F9\uADFC\uC744 \uAC00\uC9C0\uACE0\\n\uC62C\uB77C\uAC00 \uC8FC\uAC8C[VAR 0114(0079)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB098\uB294 \uBA3C\uC800\\n\uADF8\uACF3\uC5D0 \uAC00 \uC788\uB3C4\uB85D \uD558\uACA0\uB124[VAR 0114(0079)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uADF8\uB300\uB9CC \uBBFF\uACA0\uB124...[VAR 0114(0079)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB300\uC811\uD574\uC904 \uAC83\uC774 \uC5C6\uAE34 \uD558\uB124\uB9CC\\n\uC790\uB124\uB77C\uBA74 \uB9C8\uC744\uC5D0\\r\\n\uC788\uACE0 \uC2F6\uC740 \uB9CC\uD07C \uC788\uC5B4\uB3C4 \uB418\uB124"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uC5D0\uB294 \uC218\uC0C1\uD55C \uC720\uC801\uC774\\n\uBA87 \uAD70\uB370 \uC788\uC9C0\\c\\n\uB2E4\uB9CC, \uBB38\uC744 \uBC00\uC5B4\uB3C4 \uB2F9\uACA8\uB3C4\\n\uAF3C\uC9DD\uB3C4 \uD558\uC9C0 \uC54A\uB294\uB2E4\uB124"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uAC70\uC778\uC758 \uCE68\uC18C\uC5D0\uC11C \uB3D9\uCABD\uC73C\uB85C \uAC78\uC5B4\uC11C\\n\uBD81\uCABD\uC5D0 \uC788\uB294 \uC0B0\uC744 \uC624\uB974\uBA74\\r\\n\uC624\uB798\uB41C \uC2E0\uC804\uC774 \uC788\uB2E8\uB2E4"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD639\uC2DC \uC0B0\uC744 \uC624\uB97C \uC0DD\uAC01\uC774\uB77C\uBA74\\n\uBD80\uB514 \uC870\uC2EC\uD558\uAC70\uB77C\\c\\n\uC815\uC0C1\uAE4C\uC9C0 \uAC00\uB294 \uAE38\uC774\\n\uB9E4\uC6B0 \uBA40\uB2E8\uB2E4"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uB300\uAD74\uB808\uC624\\n\uCC38\uC73C\uB85C \uB465\uAE00\uC9C0 \uC54A\uB2C8?"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB098\uB294 \uBBFC\uBC15\uC9D1\uC758 \uC0E4\uC6CC\uAE30\uB97C\\n\uACE0\uCE58\uB7EC \uAC00\uC57C\uACA0\uAD70...[VAR 0114(007A)]"
  }
]
