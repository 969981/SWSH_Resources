  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD568\uAED8 \uBAA8\uD5D8\uD558\uBA74\uC11C\\n\uB108\uD76C \uB355\uBD84\uC5D0 \uAC00\uB77C\uB974\uC758 \uC5ED\uC0AC\uB97C\\r\\n\uC880 \uB354 \uC54C\uACE0 \uC2F6\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uACE0[VAR 0114(000B)]"
