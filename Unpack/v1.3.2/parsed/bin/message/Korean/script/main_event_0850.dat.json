[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uB2D8!\\c\\n\uC18C\uC6D0\uC758\uBCC4\uB3C4 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB3C4\\n\uC21C\uC870\uB86D\uAC8C \uBAA8\uC73C\uACE0 \uC788\uC2B5\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB300\uB2E8\uD558\uC2DC\uAD70\uC694 \uBE44\uD2B8 \uC120\uC218\\c\\n\uC704\uC6D0\uC7A5\uB2D8\uC5D0\uAC8C \uC120\uD0DD\uBC1B\uC558\uB2E4\uB294 \uAC83\uC744\\n\uC78A\uC9C0 \uC54A\uACE0 \uC5F4\uC2EC\uD788 \uD574\uC8FC\uACE0 \uACC4\uC2DC\uAD70\uC694[VAR 0114(0007)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC18C\uC6D0\uC758\uBCC4\uC744 \uC794\uB729 \uBAA8\uC544\uC624\uBA74\\n\uC704\uC6D0\uC7A5\uB2D8\uC744 \uAD34\uB86D\uD788\uB294\\r\\n\uACE0\uBBFC\uC774 \uD574\uACB0\uB418\uB294 \uAC70 \uB9DE\uC8E0?[VAR 0114(000C)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC544\uB2C8, \uB098\uC758 \uACE0\uBBFC\uC774 \uC544\uB2C8\uB77C\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uBBF8\uB798\uB97C \uC704\uD55C \uC77C\uC774\uB780\uB2E4[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC18C\uC6D0\uC758\uBCC4\uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uCC54\uD53C\uC5B8\uCC98\uB7FC \uAC15\uD55C\\r\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB3C4 \uD544\uC694\uD558\uC9C0[VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "...\uADF8\uB798\uC11C \uB4DC\uB9AC\uB294 \uB9D0\uC500\uC778\uB370\\c\\n\uCC54\uD53C\uC5B8\uC774 \uCD94\uCC9C\uD588\uB2E4\uB294\\n\uD2B8\uB808\uC774\uB108 \uC911 \uD55C \uC0AC\uB78C\uC778 \uD638\uBE0C\uC5D0\uAC8C\uB294\\r\\n\uC2E4\uB825\uC758 \uCC28\uC774\uB97C \uBCF4\uC5EC\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4[VAR 0114(000C)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC800\uB77C\uBA74 \uCC54\uD53C\uC5B8\uB3C4\\n\uC774\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4! \uBC18\uB4DC\uC2DC \uC774\uAE30\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uAC70 \uBA4B\uC9C4 \uC18C\uB9AC\uAD70! \uACC4\uC18D \uADF8\uB807\uAC8C \uACBD\uC7C1\uD558\uBA74\uC11C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD765\uBBF8\uC9C4\uC9C4\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uB2E4\uC624[VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBE44\uD2B8 \uC120\uC218\\n\uB4DC\uB9B4 \uB9D0\uC500\uC774 \uC788\uC2B5\uB2C8\uB2E4\\r\\n\uC7A0\uC2DC \uAD1C\uCC2E\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?[VAR 0114(0007)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC774\uC57C\uAE30\uB294 \uB4E3\uACE0 \uC788\uC5C8\uACA0\uC9C0\\n[VAR 0100(0000)]\uAD70?[VAR 0114(0006)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB108\uB3C4 \uC54C\uB2E4\uC2DC\uD53C\\n\uC18C\uC6D0\uC758\uBCC4\uC740 \uB2E4\uC774\uB9E5\uC2A4 \uBC34\uB4DC\uC5D0\uB3C4\\r\\n\uB4E4\uC5B4 \uC788\uB294 \uC2E0\uBE44\uD55C \uB3CC\uC774\uB780\uB2E4[VAR 0114(0006)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC18C\uC6D0\uC758\uBCC4\uC740 \uB2E8\uC21C\uD788 \uD3EC\uCF13\uBAAC\uC744\\n\uAC70\uB300\uD558\uAC8C \uB9CC\uB4DC\uB294 \uAC83 \uC774\uC0C1\uC758\\r\\n\uB9CE\uC740 \uC5D0\uB108\uC9C0\uB97C \uD488\uACE0 \uC788\uC9C0![VAR 0114(0006)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC790\uC138\uD55C \uAC83\uC774 \uC54C\uACE0 \uC2F6\uB2E4\uBA74\\n\uC2A4\uD0C0\uB514\uC6C0\uC5D0 \uAC00\uBCF4\uB294 \uAC8C \uC88B\uC744 \uAC70\uB2E4!\\r\\n\uC544\uB2C8\uC9C0! \uC9C0\uAE08 \uBC14\uB85C \uAC00\uBCF4\uC790\uAFB8\uB098!\\c\\n\uAC00\uB77C\uB974\uC758 \uC5D0\uB108\uC9C0\uC5D0 \uB300\uD574\\n\uAC00\uB974\uCCD0 \uC904 \uD14C\uB2C8\uAE4C \uB530\uB77C\uC624\uAC70\uB77C![VAR 0114(0006)]"
  }
]
