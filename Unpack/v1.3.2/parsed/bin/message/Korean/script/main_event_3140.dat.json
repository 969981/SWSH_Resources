  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uD3EC\uCF13\uBAAC\uC774 \uB0A0\uB6F0\uACE0 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC2A4\uD0C0\uB514\uC6C0\uC740 \uC55E\uC73C\uB85C 1\uACF3\\r\\n\uBE68\uB9AC \uB05D\uB0B4\uBC84\uB9AC\uC790[VAR 0114(0016)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774\uC81C \uB0A8\uC740 \uAC74 \uC2E4\uC18C\uCF64\uBE44\uB77C\uB294 \uB140\uC11D\uB4E4\uC744\\n\uBD99\uC7A1\uB294 \uAC83\uBFD0\uC774\uAD70[VAR 0114(0016)]"
