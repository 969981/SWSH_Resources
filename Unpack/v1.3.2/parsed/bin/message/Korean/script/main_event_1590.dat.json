[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB85C\uC988\uD0C0\uC6CC\uB2E4!\\c\\n\uAF2D\uB300\uAE30\uAC00 \uC5BC\uB9C8\uB098 \uB192\uC774 \uC788\uB294 \uAC70\uC57C?\\n\uAD6C\uB984\uC5D0 \uAC00\uB824\uC838\uC11C \uBCF4\uC774\uC9C0\uB3C4 \uC54A\uB124[VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uADF8\uB798\uC11C \uC774\uC81C \uC5B4\uB5BB\uAC8C \uD560 \uAC70\uC57C?\\c\\n\uC610\uB2E8\uC740 \uB2E4\uB4E4\\n\uB098\uC05C \uB9AC\uADF8 \uC2A4\uD0DC\uD504\uB4E4\uC744\\r\\n\uC0C1\uB300\uD558\uACE0 \uC788\uC5B4[VAR 0114(000D)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB807\uB2E4\uB294\uB370 [VAR 0100(0000)][VAR 1900(0001)]\\n\uC5B4\uB5BB\uAC8C \uD560\uB798?[VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uBA3C\uC800 \uAC00\uC790!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBAA8\uB450 \uBAA8\uC77C \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4\uAE4C?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uAC70 \uC88B\uC740 \uC0DD\uAC01\uC774\uC57C!\\n\uADF8\uB7FC \uBE68\uB9AC \uD615\uC744 \uB370\uB9AC\uB7EC \uAC00\uC790!\\c\\n\uADF8\uB807\uC9C0 \uC54A\uC73C\uBA74 \uB124\uAC00\\n\uCC54\uD53C\uC5B8\uC5D0\uAC8C \uB3C4\uC804\uD560 \uC218 \uC5C6\uC796\uC544[VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBCC4\uB85C \uC88B\uC740 \uC0DD\uAC01\uC740 \uC544\uB2CC \uAC83 \uAC19\uC544\\c\\n\uB098\uB77C\uBA74 \uC610\uB2E8\uC758 \uB9C8\uC74C\uC744\\n\uD5DB\uB418\uAC8C \uD558\uC9C0 \uC54A\uC744 \uAC70\uC57C[VAR 0114(0005)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0100(0000)]\\n\uB124\uAC00 \uB85C\uC988\uD0C0\uC6CC\uB85C \uAC00\uB294 \uAE38\uC744 \uB9CC\uB4E0 \uAC70\uC57C\\r\\n\uC774 \uAE30\uC138\uB97C \uBAB0\uC544\uC11C \uACC4\uC18D \uAC00\uB3C4\uB85D \uD574![VAR 0114(000D)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0 \uCC38 \uBCC4\uB09C \uBE44\uC11C\uC778 \uAC83 \uAC19\uC544\\c\\n\uC704\uC6D0\uC7A5\uC744 \uAE30\uC058\uAC8C \uD558\uB824\uACE0\\n\uBAA8\uB178\uB808\uC77C\uC758 \uD0A4\uB97C \uC228\uAE30\uB2E4\uB2C8[VAR 0114(000D)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB85C\uC988 \uC704\uC6D0\uC7A5\uB3C4 \uADF8\uB798\\n\uCC54\uD53C\uC5B8\uC758 \uBC1C\uC744 \uBB36\uC5B4\uC11C \uBB58 \uC5B4\uCA4C\uB824\uB294 \uAC74\uC9C0\\r\\n\uB3C4\uD1B5 \uC774\uD574\uAC00 \uAC00\uC9C0 \uC54A\uC544[VAR 0114(000D)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uACFC\uAC70\uC758 \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC744\\n\uB5A0\uC62C\uB9AC\uAC8C \uD558\uB294 \uC5F4\uAD11\uC801\uC774\uACE0...\\r\\n\uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uB77C\uC774\uBE0C\uC600\uC5B4\\c\\n\uC575\uCF5C \uACF5\uC5F0\uC740 \uC5C6\uC9C0\uB9CC![VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB50\uC57C \uC544\uC9C1 \uC548 \uAC04 \uAC70\uC57C?[VAR 0114(0016)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC790 \uB108\uD76C\uB294 \uAC00\uB3C4\uB85D \uD574!\\n\uB098\uB294 \uC751\uC6D0\uD558\uACE0 \uC788\uC744 \uD14C\uB2C8\uAE4C![VAR 0114(0016)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uAC00\uC790\\n[VAR 0100(0000)]![VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB098\uB294 \uC624\uBE60\uAC00 \uBB34\uBAA8\uD55C \uC9D3 \uBABB \uD558\uAC8C \uC5EC\uAE30 \uC788\uC744\uAC8C\\n\uBB34\uC2A8 \uC77C \uC0DD\uAE30\uBA74 \uB3CC\uC544\uC624\uB3C4\uB85D \uD574[VAR 0114(000D)]"
  }
]
