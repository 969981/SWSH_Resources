[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uC5D0 \uAD00\uB828\uB41C \uCC45\uC774\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uB290 \uCC45\uC744 \uC77D\uC744\uAE4C?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E4\uB978 \uCC45\uB3C4 \uC77D\uC5B4\uBCFC\uAE4C?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC655\uC758 \uC560\uB9C8"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC720\uB300\uC758\uACE0\uC090"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC124\uC6D0\uC758 \uCC44\uC18C"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD504\uB9AC\uC988\uB208\uAF43\uCDA4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAE30\uB150\uD488 \uC544\uC774\uB514\uC5B4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB294 \uC774 \uB545\uC5D0\\n\uD48D\uC694\uB97C \uAC00\uC838\uB2E4\uC8FC\uB294 \uD3EC\uCF13\uBAAC\\c\\n\uC624\uB978\uC190\uC744 \uB4E4\uBA74\\n\uCD08\uBAA9\uC774 \uBB34\uC131\uD574\uC9C0\uACE0\\c\\n\uC67C\uC190\uC744 \uB4E4\uBA74\\n\uBC2D\uC5D0 \uC5F4\uB9E4\uB97C \uB9FA\uAC8C \uD574\uC8FC\uC0AC\\c\\n\uD478\uB974\uACE0 \uAC70\uB300\uD55C\\n\uC655\uAD00\uC744 \uBE5B\uB0B4\uBA70\\r\\n\uC560\uB9C8 \uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8 \uB300\uC9C0\uB97C \uB204\uBE44\uB294\\c\\n\uADF8\uC758 \uBC1C\uC18C\uB9AC\uB294 \uACE7 \uC0DD\uBA85\uC744 \uC2F9\uD2B8\uAC8C \uD558\uACE0\\n\uC9C0\uC0C1\uC5D0 \uD48D\uC694\uB97C \uAC00\uC838\uB2E4\uC8FC\uB2C8\\c\\n\uC6B0\uB9AC\uB294 \uADF8\uB97C\\n\uC655\uC73C\uB85C \uBC1B\uB4E4\uC5B4 \uBAA8\uC2DC\uC5C8\uB2E4"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC655\uC758 \uCDA9\uC9C1\uD55C \uB2E4\uB9AC\uC774\uC790\\n\uADF8\uC758 \uD798\uC744 \uB04C\uC5B4\uB0B4\uB294 \uC790\\c\\n\uC77C\uB2E8 \uB458\uC774 \uD558\uB098\uAC00 \uB418\uBA74\\n\uD558\uB8FB\uBC24 \uC0C8\uC5D0 \uC232\uC744 \uB9CC\uB4E4\uC5B4\uB0B4\uB124\\c\\n\uBCF8\uB798\uB294 \uC131\uC9C8\uC774 \uC0AC\uB098\uC6CC\\n\uB9C8\uC744\uC758 \uC791\uBB3C\uC744 \uD0D0\uB0B4\uB294\\r\\n\uB9DD\uB098\uB2C8\uC600\uC73C\uB098\\c\\n\uC655\uC774 \uADF8\uB97C \uB2E4\uC2A4\uB9AC\uC2DC\uC5B4\\n\uACE7 \uC790\uC2E0\uC758 \uC218\uD558\uB85C \uC0BC\uC558\uB2E4\\c\\n\uADF8 \uD138\uC758 \uC0C9\uC740\\n\uCC28\uB514\uCC2C [VAR FF00(0006)]\uC5BC\uC74C[VAR FF00(0000)]\uCC98\uB7FC\\r\\n\uD558\uC597\uB354\uB77C\uACE0 \uB9D0\uD558\uB294 \uC774\uAC00 \uC788\uB294\uAC00 \uD558\uBA74\\c\\n\uD55C\uBC24\uC911\uC758 [VAR FF00(0006)]\uACE0\uC2A4\uD2B8[VAR FF00(0000)]\uCC98\uB7FC\\n\uAC80\uB354\uB77C\uACE0 \uB9D0\uD558\uB294 \uC774\uB3C4 \uC788\uC73C\uB2C8\\c\\n\uC5B4\uB290 \uCABD\uC758 \uB9D0\uC774 \uC0AC\uC2E4\uC778\uC9C0\uB294\\n\uB204\uAD6C\uB3C4 \uC54C\uC9C0 \uBABB\uD55C\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC560\uB9C8\uB97C \uAE38\uB4E4\uC77C \uC801\uC5D0\\n\uC655\uC774 \uD798\uC744 \uB2F4\uC558\uB358 \uACE0\uC090\\c\\n\uACB0\uC2E4\uC744 \uAC00\uC838\uB2E4\uC900 \uC655\uC5D0\uAC8C\\n\uC6B0\uB9AC \uC778\uAC04\uB4E4\uC774 \uBC14\uCE5C \uBB3C\uAC74\uC774\uB2E4\\c\\n\uC655\uACFC \uADF8 \uC560\uB9C8\uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uC6B0\uB9AC \uC778\uAC04\uACFC\uC758 \uC720\uB300\uC758 \uC0C1\uC9D5\uC774\uAE30\uB3C4 \uD558\uB2E4\\c\\n\uD55C \uD574\uAC00 \uC2DC\uC791\uB420 \uB54C \uC655\uC5D0\uAC8C\\n\uBC14\uCE58\uB294 \uAC83\uC744 \uC78A\uC5B4\uC11C\uB294 \uC544\uB2C8 \uB418\uB2C8\\c\\n\uBE5B\uB098\uB294 \uAF43\uACFC \uB9D0\uD3EC\uCF13\uBAAC\uC758 \uAC08\uAE30\uB97C\\n\uC5EC\uB7EC \uBC88 \uACB9\uCCD0\uC11C \uC9DC\uB0B4\uC57C \uD558\uB294\\c\\n\uC774 \uC81C\uC870 \uBC29\uC2DD\uC740 \uB300\uB300\uC190\uC190\\n\uC601\uC6D0\uD1A0\uB85D \uC804\uD574 \uB0B4\uB824\uC838\uC57C \uD55C\uB2E4"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC655\uAD00\uC124\uC6D0\uC758 \uB2F9\uADFC\uC740\\n\uD2B9\uC774\uD55C \uBC29\uC2DD\uC73C\uB85C \uC790\uB78D\uB2C8\uB2E4\\c\\n\uB208 \uB36E\uC778 \uBC2D\uC5D0\uC11C\uB294\\n\uCC28\uAC00\uC6B4\uB2F9\uADFC\uC774 \uC790\uB77C\uBA70\\c\\n\uBB18\uC9C0 \uADFC\uCC98\uC758 \uBC2D\uC5D0\uC11C\uB294\\n\uAC80\uC740\uB2F9\uADFC\uC774 \uC790\uB78D\uB2C8\uB2E4\\c\\n[VAR FF00(0006)]\uC5BC\uC74C\uD0C0\uC785[VAR FF00(0000)] \uD3EC\uCF13\uBAAC\uC740\\n\uCC28\uAC00\uC6B4\uB2F9\uADFC\uC744 \uC88B\uC544\uD558\uACE0\\c\\n[VAR FF00(0006)]\uACE0\uC2A4\uD2B8\uD0C0\uC785[VAR FF00(0000)] \uD3EC\uCF13\uBAAC\uC740\\n\uAC80\uC740\uB2F9\uADFC\uC744 \uC88B\uC544\uD569\uB2C8\uB2E4\\c\\n\uB3D9\uD654\uC5D0 \uB098\uC624\uB294\\n\uD48D\uC694\uC758 \uC655\uC758 \uC560\uB9C8\uB3C4\\r\\n\uB2F9\uADFC\uC744 \uC88B\uC544\uD588\uB2E4\uB294 \uC774\uC57C\uAE30\uAC00 \uC788\uB294\uB370\\c\\n\uC5B4\uC9F8\uC120\uC9C0 \uCC45\uC5D0 \uB530\uB77C\\n\uD558\uC580 \uBAA8\uC2B5\uC758 \uC560\uB9C8\uAC00\\r\\n\uCC28\uAC00\uC6B4\uB2F9\uADFC\uC744 \uBA39\uAE30\uB3C4 \uD558\uACE0\\c\\n\uAC80\uC740 \uBAA8\uC2B5\uC758 \uC560\uB9C8\uAC00\\n\uAC80\uC740\uB2F9\uADFC\uC744 \uBA39\uAE30\uB3C4 \uD558\uB294 \uB4F1\\c\\n\uBB18\uC0AC\uB418\uB294 \uBAA8\uC2B5\uC774 \uB2E4\uB985\uB2C8\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD574\uB97C \uAC70\uB4ED\uD560\uC218\uB85D \uC2EC\uD574\uC9C0\uB294\\n\uC124\uC6D0\uC758 \uCD94\uC704\uB97C \uACAC\uB514\uAE30 \uD798\uB4DC\uC2ED\uB2C8\uAE4C?\\c\\n\uC9D1\uC5D0\uC11C \uC624\uB7AB\uB3D9\uC548 \uD3B8\uD558\uAC8C \uC9C0\uB0B4\uB2E4 \uBCF4\uB2C8\\n\uC6B4\uB3D9\uB7C9\uC774 \uBD80\uC871\uD558\uC2DC\uB2E4\uACE0\uC694?\\c\\n\uADF8\uB7F0 \uB2F9\uC2E0\uC5D0\uAC8C \uD504\uB9AC\uC988\uB208\uAF43\uCDA4\uC744 \uCD94\uCC9C\uD569\uB2C8\uB2E4!\\n\uC6C0\uC9C1\uC774\uBA74\uC11C \uCCB4\uC628\uC744 \uB192\uC774\uC2ED\uC2DC\uC624!\\c\\n\uC591\uC190\uC744 \uB192\uC774 \uB4E4\uACE0 \uC5BC\uC464 \uC5BC\uC464!\\n\uBAB8\uC744 \uC219\uC774\uACE0 \uD504\uB9AC\uC988 \uD504\uB9AC\uC988!\\c\\n\uC790! \uB2E4 \uD568\uAED8 \uC6D0\uC744 \uADF8\uB9AC\uBA70 \uCDA4\uC744 \uCDA5\uC2DC\uB2E4\\n\uD504\uB9AC\uC988\uB208\uAF43\uCDA4\uACFC \uD568\uAED8 \uAC74\uAC15\uD55C \uB178\uD6C4\uB97C!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD504\uB9AC\uC988\uB9C8\uC744 \uAD00\uAD11 \uB2F4\uB2F9\uC790 \uC8FC\uAD00\\n\uAE30\uB150\uD488 \uC544\uC774\uB514\uC5B4 \uAE30\uD68D\\c\\n\uC774\uBC88\uC5D0 \uC0C1\uD488\uD654\uD560 \uAE30\uB150\uD488\uC740\\n\uD48D\uC694\uC758 \uC655 T\uC154\uCE20\uB85C\\r\\n\uACB0\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4\\c\\n\uC61B\uB0A0 \uC790\uB8CC\uB97C \uADF8\uB300\uB85C \uCC28\uC6A9\uD55C \uB355\uBD84\uC5D0\\n\uB514\uC790\uC778 \uBE44\uC6A9\uC774 \uC0AD\uAC10\uB418\uC5C8\uC2B5\uB2C8\uB2E4!\\c\\n\uB9CE\uC774 \uC751\uBAA8\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4"
  }
]
