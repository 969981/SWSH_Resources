  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uAF2C\uBD80\uAE30\uB294\\n[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC\uC774 \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC774\uC0C1\uD574\uC528\uB294\\n[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC\uC774 \uB418\uC5C8\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAF2C\uBD80\uAE30\uB3C4 \uC790\uAE30\uB97C \uC120\uD0DD\uD574\uC918\uC11C\\n\uAE30\uC05C \uBAA8\uC591\uC774\uC57C![VAR 0114(0074)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC774\uC0C1\uD574\uC528\uB3C4 \uC790\uAE30\uB97C \uC120\uD0DD\uD574\uC918\uC11C\\n\uAE30\uC05C \uBAA8\uC591\uC774\uC57C![VAR 0114(0074)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC774\uC0C1\uD574\uC528\uB294\\n\uB0B4\uAC00 \uC560\uC815\uC744 \uB2F4\uC544\uC11C \uD0A4\uC6B8\uAC8C[VAR 0114(0074)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uAF2C\uBD80\uAE30\uB294\\n\uB0B4\uAC00 \uC560\uC815\uC744 \uB2F4\uC544\uC11C \uD0A4\uC6B8\uAC8C[VAR 0114(0074)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0101(0001)]\uC5D0\uAC8C \uC9C0\uC9C0 \uC54A\uAC8C\\n\uC6B0\uB9AC\uB3C4 \uAC15\uD574\uC9C0\uC790![VAR 0114(0074)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC528\uC774~?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uAF2C\uBD80\uC6B0?"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC0AC\uBAA8\uB2D8!\\n[VAR FF00(0006)]\uC0C8\uB85C\uC6B4 \uAE30\uC220[VAR FF00(0000)]\uC744 \uAC00\uB974\uCE58\uACE0 \uC2F6\uC73C\uC2DC\uB2E4\uBA74\\r\\n\uC81C\uAC8C \uB9E1\uACA8\uB9CC \uC8FC\uC2ED\uC1FC!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[~ 17]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC5B4\uBA38! \uADF8\uAC70 \uC798 \uB410\uB124![VAR 0114(0074)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC800 \uC544\uC774\uC5D0\uAC8C \uAC11\uC637\uAD11\uC11D\uC744 \uC8FC\uBA74\\n\uAE30\uC220\uC744 \uAC00\uB974\uCCD0\uC904 \uAC70\uC57C\\r\\n\uB108\uB3C4 \uD55C\uBC88 \uB9D0\uC744 \uAC78\uC5B4\uBCF4\uB834![VAR 0114(0074)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774 \uC544\uC774\uB4E4\uC740 2\uBC88 \uC9C4\uD654\uC2DC\uD0A4\uBA74\\n\uAC70\uB2E4\uC774\uB9E5\uC2A4\uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C\\r\\n\uC5F4\uC2EC\uD788 \uD0A4\uC6CC\uBCF4\uB834![VAR 0114(0074)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4... \uADF8\uAC83\uC740 \uAC00\uB77C\uB974\uC758\\n\uD3EC\uCF13\uBAAC\uB4E4\uC5D0\uAC8C \uC77C\uC5B4\uB098\uB294 \uC2E0\uBE44\uD55C \uD604\uC0C1...[VAR 0114(0073)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uADF8\uC911\uC5D0\uC11C\uB3C4 \uBAA8\uC2B5\uC774 \uBC14\uB00C\uACE0\\n\uC0AC\uC6A9\uD558\uB294 \uAE30\uC220\uB3C4 \uBCC0\uD558\uB294 \uAC70\uB2E4\uC774\uB9E5\uC2A4\uB294...[VAR 0114(0073)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4 \uC911\uC5D0\uC11C\uB3C4\\n\uD55C\uCE35 \uB354 \uD2B9\uBCC4\uD55C \uAC83\uC774\uC9C0...[VAR 0114(0073)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uCC38\uACE0\uB85C \uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC758 \uBE44\uC804\uC778\\n[VAR FF00(0006)]\uB2E4\uC774\uC218\uD504[VAR FF00(0000)]\uB97C \uBA39\uC73C\uBA74\\r\\n[VAR FF00(0006)]\uAC70\uB2E4\uC774\uB9E5\uC2A4[VAR FF00(0000)]\uB97C \uD560 \uC218 \uC788\uB2E8\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC544~ \uC624\uB79C\uB9CC\uC5D0\\n[VAR FF00(0006)]\uB2E4\uC774\uBC84\uC12F[VAR FF00(0000)]\uC774 \uB4EC~\uBFCD \uB4E4\uC5B4\uAC04\\r\\n\uB2E4\uC774\uC218\uD504\uAC00 \uBA39\uACE0 \uC2F6\uB124~[VAR 0114(0073)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "...\uADF8\uB7EC\uB2C8\uAE4C! \uB450 \uBC88\uC9F8 \uC218\uD589\uC740\\n\uBC84\uC12F \uCC44\uC9D1\uC774\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uAC70\uB2E4\uC774\uB9E5\uC2A4\uC758 \uC5F4\uC1E0!\\n\uB2E4\uC774\uBC84\uC12F\uC744 3\uAC1C \uB530\uC624\uB3C4\uB85D~![VAR 0114(0073)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB2E4\uC774\uBC84\uC12F\uC740\\n[VAR FF00(0006)]\uBE68\uAC04 \uC18C\uC6A9\uB3CC\uC774 \uBAA8\uC591[VAR FF00(0000)]!\\c\\n\uC5B4\uB461\uACE0 \uCD95\uCD95\uD55C \uACF3\uC5D0\uC11C\\n\uCC3E\uC744 \uC218 \uC788\uC744 \uAC70\uB780\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uBB50 \uB300\uCDA9 \uC774\uB7F0 \uC218\uD589\uC774\uB2C8\uAE4C\\n\uC9C0\uAE08 \uBC14\uB85C \uC2A4\uD0C0\uD2B8!\\r\\n\uC5F4\uC2EC\uD788 \uD574 \uBCF4\uAC70\uB77C![VAR 0114(0073)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC624... \uC6B0\uC624\uC624\uC624\uC624\uC624!!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC800\uAE30~ \uBBF8\uC548\uD558\uC9C0\uB9CC~\\n\uB098\uB294 \uC544\uC9C1 \uB108\uB97C \uC778\uC815\uD560 \uC218 \uC5C6\uAC70\uB4E0~[VAR 0114(0071)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uC774\uBC88 \uC218\uD589\uC5D0\uC11C\uB294\\n\uC808~~~\uB300\uB85C \uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC57C![VAR 0114(0071)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC81C \uC6B4\uBA85\uC740 \uC544\uC9C1 \uB2F9\uC2E0\uC744\\n\uC778\uC815\uD560 \uC218 \uC5C6\uB2E4\uACE0 \uB9D0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4...[VAR 0114(0072)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uADF8\uB7EC\uB2C8\uAE4C \uAC00\uC7A5 \uBA3C\uC800 \uB2E4\uC774\uBC84\uC12F\uC744 \uBC1C\uACAC\uD574\uC11C\\n\uD655\uC2E4\uD55C \uC2B9\uB9AC\uB97C \uC774 \uC190\uC5D0 \uAC70\uBA38\uC950\uACE0 \uB9D0\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0072)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB450 \uBC88\uC9F8 \uC218\uD589\uC740\\n\uB2E4\uC774\uBC84\uC12F 3\uAC1C \uB530\uC624\uAE30!\\c\\n\uB2E4\uC774\uBC84\uC12F\uC740\\n\uBE68\uAC04 \uC18C\uC6A9\uB3CC\uC774 \uBAA8\uC591\uC758 \uBC84\uC12F\uC774\uB780\uB2E4!\\c\\n\uC5B4\uB461\uACE0 \uCD95\uCD95\uD55C \uACF3\uC5D0\uC11C \uCC3E\uC744 \uC218 \uC788\uC744 \uAC8C\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uB098\uB294 \uB2F9\uBD84\uAC04\\n\uAC1C\uC778 \uC5F0\uC2B5\uC744 \uD558\uACE0 \uC788\uC744 \uAC70\uC57C!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB2E4\uC774\uBC84\uC12F\uC774 \uC790\uB77C\uB294 \uACF3...\\n\uC9D1\uC911\uC758 \uC232\uC774\uC5C8\uB098?\\r\\n\uADF8 \uB108\uBA38\uC5D0 \uC788\uB294 \uB3D9\uAD74\uC774\uC5C8\uB358 \uAC70 \uAC19\uAE30\uB3C4 \uD574"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC74C?\\n\uB098\uB294 \uC5EC\uAE30 \uB0A8\uC544 \uC788\uC744 \uAC70\uB2E4...\\c\\n\uC57C\uB3C8\uC758 \uC218\uD589\uC744\\n\uD074\uB9AC\uC5B4\uD558\uC9C0 \uBABB\uD588\uC73C\uB2C8\uAE4C"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC798 \uB2E4\uB140\uC640!\\n\uBC30\uB97C \uBE44\uC6CC\uB193\uACE0...\uAC00 \uC544\uB2C8\uC9C0\\r\\n\uC751\uC6D0\uD558\uBA74\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC774\uC0C1\uD574\uC528\\n\uC5F4\uC2EC\uD788 \uD0A4\uC6CC\uBD10\uC57C\uC9C0![VAR 0114(0074)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uAF2C\uBD80\uAE30\\n\uC5F4\uC2EC\uD788 \uD0A4\uC6CC\uBD10\uC57C\uC9C0![VAR 0114(0074)]"
  }
