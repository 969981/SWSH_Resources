[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB0A8\uC740 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB294...\\n\uD638\uC624... 10\uBA85\uB3C4 \uC548 \uB0A8\uC558\uB124?[VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC790 \uADF8\uB7FC [VAR 0100(0000)]!\\c\\n\uC774 \uAE08\uB791\uB2D8\uC758 \uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0 \uB300\uD574\\n\uC124\uBA85\uD574\uC904\uAC8C![VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADDC\uCE59\uC740 \uAC04\uB2E8\uD574\\c\\n\uB0B4\uAC00 \uB2E8\uB828\uC2DC\uD0A8 \uCCB4\uC721\uAD00 \uD2B8\uB808\uC774\uB108 3\uBA85\uC744\\n\uB354\uBE14\uBC30\uD2C0\uB85C \uC774\uAE30\uAE30\uB9CC \uD558\uBA74 \uB3FC![VAR 0114(0017)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB294\\n\uC5C4\uCCAD\uB098\uAC8C \uD798\uB4E0 \uB3C4\uC804\uC778 \uB9CC\uD07C\\c\\n\uC5EC\uAE30\uAE4C\uC9C0 \uB3C4\uB2EC\uD558\uB294\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB3C4 \uC5BC\uB9C8 \uC5C6\uC5B4[VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB798\uC11C \uB354\uC6B1! \uC5EC\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uC628\\n\uB108\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC774 \uBC1C\uD718\uD558\uB294\\r\\n\uAD49\uC7A5\uD55C \uCF64\uBE44\uB124\uC774\uC158\uC744\\r\\n\uAC00\uB2A5\uD55C \uD55C \uB9CE\uC774 \uBCF4\uACE0 \uC2F6\uC5B4![VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC11C\uB860\uC774 \uAE38\uC5C8\uB124\\n\uC790! \uADF8\uB7FC \uCCAB \uBC88\uC9F8 \uD2B8\uB808\uC774\uB108\uB2E4!\\c\\n\uCEF4 \uC628! \uC6A9\uAE38![VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC81C\uAC00 \uC6A9\uAE38\uC785\uB2C8\uB2E4\\c\\n\uAE08\uB791\uB2D8\uC758 \uAC00\uB974\uCE68\uC740 \uB450 \uAC00\uC9C0!\\n\uB4DC\uB798\uACE4\uC740 \uAC15\uD558\uB2E4\uB294 \uAC83!\\c\\n\uADF8\uB9AC\uACE0 \uADF8\uAC83\uC744 \uC0B4\uB9AC\uAE30 \uC704\uD574 \uD544\uB4DC\uB97C\\n\uC790\uC2E0\uC5D0\uAC8C \uC720\uB9AC\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC57C \uD55C\uB2E4\uB294 \uAC83!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uC5EC\uAE30\uAE4C\uC9C0 \uC9C4\uCD9C\uD55C\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB2F5\uAD70\uC694!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB354\uBE14\uBC30\uD2C0\uC5D0\uC11C\uB294 \uC0C1\uB300\uC758 \uD3EC\uCF13\uBAAC\uC774\\n\uAC01\uAC01 \uC5B4\uB5A4 \uC5ED\uD560\uC744 \uB9E1\uACE0 \uC788\uB294\uC9C0\uB97C\\r\\n\uD30C\uC545\uD558\uB294 \uAC83\uC774 \uC911\uC694\uD569\uB2C8\uB2E4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774\\n2\uB9C8\uB9AC\uAC00 \uB418\uC9C0 \uC54A\uB294 \uBAA8\uC591\uC774\uAD70\uC694"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uD6CC\uB96D\uD569\uB2C8\uB2E4! \uC5ED\uC2DC 7\uAC1C\uC758\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBAA8\uC740 \uD2B8\uB808\uC774\uB108\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB354\uBE14\uBC30\uD2C0...\\c\\n2\uB9C8\uB9AC\uC758 \uD798\uC73C\uB85C \uBC00\uC5B4\uBD99\uC774\uAC70\uB098\\n1\uB9C8\uB9AC\uB294 \uC11C\uD3EC\uD2B8\uB85C \uB458 \uC218 \uC788\uC8E0...\\r\\n\uB2F9\uC2E0\uC740 \uC5B4\uB5A4 \uBC29\uC2DD\uC73C\uB85C \uC2F8\uC6B0\uC2E4 \uAC70\uC8E0?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC740\\n\uB354\uBE14\uBC30\uD2C0\uB85C \uC9C4\uD589\uD569\uB2C8\uB2E4\\c\\n\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC744\\n2\uB9C8\uB9AC \uC774\uC0C1 \uB370\uB824\uC624\uC138\uC694..."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD6CC\uB96D\uD569\uB2C8\uB2E4...!\\c\\n\uB2F9\uC2E0\uCC98\uB7FC \uAC15\uD55C \uD2B8\uB808\uC774\uB108\uC640\\n\uC2F8\uC6B8 \uC218 \uC788\uC5B4\uC11C \uC601\uAD11\uC774\uC5C8\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC606\uC5D0 \uC788\uB294 \uD2B8\uB808\uC774\uB108\uB97C \uC774\uAE30\uC2DC\uBA74\\n\uC81C\uAC00 \uC0C1\uB300\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774\uB2C8 [VAR 0100(0000)]?\\n\uC544\uC9C1 \uCCB4\uC721\uAD00 \uBBF8\uC158 \uB3C4\uC911\uC778\uB370[VAR 0114(0017)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD6C4\uD6C4! \uC5B4\uC11C \uD074\uB9AC\uC5B4\uD574\uBD10!\\n\uBE68\uB9AC \uB108\uC640 \uC2F8\uC6CC\uBCF4\uACE0 \uC2F6\uC73C\uB2C8\uAE4C![VAR 0114(0017)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC815\uB9D0 \uAE30\uAD8C\uD560 \uAC70\uB2C8?[VAR 0114(0017)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC54C\uC558\uC5B4!\\c\\n\uADF8\uB807\uC9C0\uB9CC \uD3EC\uAE30\uD558\uC9C0 \uC54A\uACE0\\n\uB2E4\uC2DC \uB3C4\uC804\uD560 \uAC70\uC9C0? \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C[VAR 0114(0017)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uAD49\uC7A5\uD558\uAD6C\uB098 [VAR 0100(0000)]!\\n\uCCB4\uC721\uAD00 \uBBF8\uC158 \uD074\uB9AC\uC5B4\uC57C!\\c\\n\uC790 \uADF8\uB7FC \uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC73C\uB85C \uAC00\uC790\\n\uC774 \uAE08\uB791\uB2D8\uC774 \uC0C1\uB300\uD574\uC904\uAC8C![VAR 0114(0017)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC740 \uB450 \uBC88\uC9F8 \uD2B8\uB808\uC774\uB108!\\n\uCEF4 \uC628! \uB808\uB098![VAR 0114(0017)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC138 \uBC88\uC9F8 \uD2B8\uB808\uC774\uB108\uB2E4!\\n\uCEF4 \uC628! \uB3D9\uC219![VAR 0114(0017)]"
  }
]
