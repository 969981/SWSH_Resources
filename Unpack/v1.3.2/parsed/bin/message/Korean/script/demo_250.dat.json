    "text": "\uCD95\uD558\uD55C\uB2E4 [VAR 0100(0000)]!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC744 \uC4F0\uB7EC\uB728\uB9B0\\n\uB124\uAC00 \uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC774\uC57C!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB108\uCC98\uB7FC \uB108\uBB34\uB098\uB3C4 \uD6CC\uB96D\uD55C\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB97C \uB9CC\uB098\uAC8C \uB3FC\uC11C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC9C4\uC2EC\uC73C\uB85C \uC601\uAD11\uC774\uC57C!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB124\uAC00 \uC774\uB807\uAC8C \uAC15\uD574\uC9C4 \uAC78 \uBCF4\uACE0\\n\uB098\uB3C4 \uBBF8\uB798\uC5D0 \uB300\uD574 \uC0DD\uAC01\uD558\uAC8C \uB410\uC5B4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBBF8\uB798\uB85C \uC774\uC5B4\uC9C8 \uC624\uB298\uC744\\n\uC6B0\uB9AC \uC5B4\uB978\uB4E4\uC774 \uBCF4\uB2E4 \uC88B\uAC8C \uB9CC\uB4E4\uC5B4\uC57C \uD558\uB2C8\uAE4C!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC790 [VAR 0100(0000)]!\\n\uC55E\uC73C\uB85C\uB3C4 \uC790\uAE30 \uC790\uC2E0\uACFC!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uD30C\uD2B8\uB108 \uD3EC\uCF13\uBAAC\uC744 \uBBFF\uACE0\\n\uD798\uCC28\uAC8C \uB098\uC544\uAC00\uB834!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uAC00 \uBC14\uB77C\uB294\\n\uBC1D\uC740 \uBBF8\uB798\uB97C \uB9CC\uB4E4\uAE30 \uC704\uD574\uC11C \uB9D0\uC774\uC57C!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC758 \uC5EC\uB7EC\uBD84!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uC774 \uC790\uB9AC\uC5D0\uC11C!\\n\uC0C8\uB85C\uC6B4 \uC804\uC124\uC774 \uD0DC\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBC14\uB85C [VAR 0100(0000)]\uC785\uB2C8\uB2E4!!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774\uB807\uAC8C \uAD49\uC7A5\uD55C \uD798\uC744 \uAC00\uC9C4 \uC790\uB77C\uBA74\\n\uC5B4\uB5A4 \uBBF8\uB798\uB4E0 \uADF8\uB824\uB0BC \uC218 \uC788\uC744 \uD130!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0003)] \uBCF4\uC5EC\uC904 \uBBF8\uB798\uB97C\\n\uB2E4 \uD568\uAED8 \uAE30\uB300\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4!"
