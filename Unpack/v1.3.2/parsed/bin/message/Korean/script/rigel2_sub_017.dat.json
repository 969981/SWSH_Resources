[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBC16\uC740 \uCD94\uC6B0\uB2C8\uAE4C\\n\uBAB8\uC744 \uC880 \uB179\uC600\uB2E4 \uAC00\uAC70\uB77C"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBAA8\uADDC~"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8 \uC544\uC774\uB294 \uB465\uC2E4\uC774\uB780\uB2E4\\n\uB9C8\uC744 \uBC16\uC5D0\uC11C \uB35C\uB35C \uB5A8\uACE0 \uC788\uAE38\uB798\\r\\n\uC5EC\uAE30\uB85C \uB370\uB824\uC654\uC9C0"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5B4\uC9F8 \uADF8 \uC544\uC774\uB97C \uB9CC\uB098\uACE0 \uB098\uC11C\uBD80\uD130\\n\uC124\uC6D0\uC5D0 \uBCF8 \uC801 \uC5C6\uB294 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uB298\uC5B4\uB09C \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB465\uC2E4\uC774...\\n\uBCF8 \uC801 \uC5C6\uB294 \uD3EC\uCF13\uBAAC\uC774\uAE30\uB3C4 \uD558\uACE0\\c\\n\uBBFF\uC744 \uB9CC\uD55C \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C\\n\uB9E1\uAE30\uB294 \uD3B8\uC774 \uC88B\uC73C\uB824\uB098..."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB465\uC2E4\uC774...\\n\uBCF8 \uC801 \uC5C6\uB294 \uD3EC\uCF13\uBAAC\uC774\uAE30\uB3C4 \uD558\uACE0\\c\\n\uBBFF\uC744 \uB9CC\uD55C \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C\\n\uB9E1\uAE30\uB294 \uD3B8\uC774 \uC88B\uC744 \uAC83 \uAC19\uC544\uC11C \uB9D0\uC774\uB2E4\\c\\n\uB9C8\uC744\uC744 \uC9C0\uCF1C\uC900 \uB124\uAC00\\n\uB465\uC2E4\uC774\uB97C \uB9E1\uC544\uC92C\uC73C\uBA74 \uD558\uB294\uB370\\r\\n\uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB2C8?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB09C\uD3ED\uD55C \uD3EC\uCF13\uBAAC\uC73C\uB85C\uBD80\uD130\\n\uB9C8\uC744\uC744 \uC9C0\uCF1C\uC918\uC11C \uACE0\uB9D9\uB2E4\\c\\n\uBBFF\uC74C\uC9C1\uD55C \uB124\uAC8C \uB465\uC2E4\uC774\uB97C \uB9E1\uAE30\uACE0 \uC2F6\uC740\uB370\\n\uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB2C8?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5B4\uB5BB\uAC8C \uB465\uC2E4\uC774\uB97C \uC880\\n\uB9E1\uC544\uC904 \uC218 \uC5C6\uACA0\uB2C8?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098...\\n\uC5B4\uB824\uC6B4 \uBD80\uD0C1\uC744 \uD574\uC11C \uBBF8\uC548\uD558\uB2E4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uBA38, \uADF8\uB798?\\n\uC774\uAC70 \uCC38\uC73C\uB85C \uACE0\uB9D9\uAD6C\uB098"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC798 \uB410\uAD6C\uB098, \uB465\uC2E4\uC544!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAD6C\uC2A4\uBAA8~!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB465\uC2E4\uC774\uB97C \uC798 \uBD80\uD0C1\uD558\uB9C8"
  }
]
