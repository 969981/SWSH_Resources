  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uB9CC\uB454\uB2E4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5B4\uB290 \uD0C0\uC785\uC73C\uB85C \uB300\uB828\uD560\uC9C0\\n\uC120\uD0DD\uD574 \uC8FC\uC2ED\uC2DC\uC624!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBB34\uB9AC\uD574\uC11C \uD558\uC2E4 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4\\n\uADF8\uB7FC \uB2E4\uC74C \uAE30\uD68C\uC5D0!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC81C\uD55C\uB300\uB828\uC740\\n\uD3EC\uCF13\uBAAC\uC758 \uD0C0\uC785\uC744\\r\\n\uC81C\uD55C\uD574\uC11C \uB300\uB828\uD558\uB294 \uD2B8\uB808\uC774\uB2DD\uC785\uB2C8\uB2E4!\\c\\n\uC6B0\uC120 \uD558\uB098\uC758 \uD0C0\uC785\uC744 \uC120\uD0DD\uD558\uACE0\\n\uC120\uD0DD\uD55C \uD0C0\uC785\uC744 \uAC00\uC9C4\\r\\n\uD3EC\uCF13\uBAAC 3\uB9C8\uB9AC\uB85C \uBC30\uD2C0\uD569\uB2C8\uB2E4!\\c\\n\uAC19\uC740 \uB3C4\uAD6C\uB97C \uC9C0\uB2C8\uAC8C \uD558\uAC70\uB098\\n\uAC19\uC740 \uD3EC\uCF13\uBAAC\uC744 \uC0AC\uC6A9\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4\\c\\n5\uD68C \uC5F0\uC18D\uC73C\uB85C \uC2B9\uB9AC\uD558\uBA74\\n\uC131\uACF5\uC785\uB2C8\uB2E4\uB9CC\\c\\n\uBC18\uB300\uB85C \uD55C \uBC88\uC774\uB77C\uB3C4 \uD328\uBC30\uD558\uBA74\\n\uADF8 \uC790\uB9AC\uC5D0\uC11C \uB300\uB828\uC740 \uB05D\uB098\uAC8C \uB429\uB2C8\uB2E4...!\\c\\n\uC2B9\uBD80\uC640 \uC2B9\uBD80 \uC0AC\uC774\uC5D0 \uB450 \uBC88\uAE4C\uC9C0\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uD68C\uBCF5\uC2DC\uD0AC \uC218 \uC788\uC73C\uB2C8\\r\\n\uC798 \uD65C\uC6A9\uD574\uBCF4\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4\\c\\n...\uC124\uBA85\uC740 \uC774\uC0C1\uC785\uB2C8\uB2E4!\\n\uC81C\uD55C\uB300\uB828\uC744 \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD638\uC624, \uADF8\uB9CC\uB450\uC2DC\uB294 \uAC74\uAC00\uC694...\\n\uADF8\uB7FC \uB2E4\uC74C \uAE30\uD68C\uC5D0"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC81C1\uC2DC\uD569\uC744\\n\uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4!\\r\\n\uC900\uBE44..."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uACC4\uC18D\uD574\uC11C\\n\uC81C[VAR 0203(0001,0000)]\uC2DC\uD569!\\r\\n\uC900\uBE44..."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[~ 15]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC2DC\uC791!!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD6CC\uB96D\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC744 \uD68C\uBCF5\uD558\uACA0\uC2B5\uB2C8\uAE4C?\\n(\uC55E\uC73C\uB85C [VAR 0200(0001)]\uD68C)"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uD328\uBC30\uD558\uC168\uAD70\uC694...\\n\uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8 \uB2E8\uB828\uD574\uC11C\\r\\n\uB2E4\uC74C\uC5D0 \uB610 \uB3C4\uC804\uD574 \uC8FC\uC2ED\uC2DC\uC624!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC774\uBC88 \uC81C\uD55C\uB300\uB828\uC758 \uACB0\uACFC...\\c\\n[VAR 0103(0002)]\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC73C\uB85C \uC9C4\uD589\uD55C\\n\uC81C\uD55C\uB300\uB828\uC5D0\uC11C [VAR 0203(0001,0000)]\uC5F0\uC2B9!"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "[VAR 0103(0002)]\uD0C0\uC785\uC744 \uB2E4\uB8E8\uB294 \uC2E4\uB825\uC774\\n\uB354\uD560 \uB098\uC704 \uC5C6\uC774 \uD6CC\uB96D\uD558\uC2DC\uAD70\uC694!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC758 \uB04A\uC784\uC5C6\uB294 \uB178\uB825\uC744 \uAE30\uB9AC\uB294 \uB73B\uC5D0\uC11C\\n\uC774\uAC83\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAE30\uD68C\uAC00 \uB418\uBA74 \uB2E4\uB978 \uD0C0\uC785\uC73C\uB85C\uB3C4\\n\uC5F0\uC2B9\uC5D0 \uB3C4\uC804\uD574\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4!"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC774, \uC774\uB7F4 \uC218\uAC00!?\\n\uBAA8\uB4E0 \uD0C0\uC785\uC758 \uC81C\uD55C\uB300\uB828\uC5D0\uC11C\\r\\n5\uC5F0\uC2B9\uC744 \uAC70\uB450\uC168\uAD70\uC694!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB3C4\uC800\uD788 \uBBFF\uC744 \uC218 \uC5C6\uB294...\\n\uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uC704\uC5C5\uC744\\r\\n\uB2EC\uC131\uD558\uC168\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uB3C4\uC7A5\uC758 \uC5ED\uC0AC\uC5D0 \uB0A8\uC744\\n\uBC30\uD2C0\uC744 \uAE30\uB9AC\uB294 \uB73B\uC5D0\uC11C\\r\\n\uC774 \uC637\uC744 \uC785\uC744 \uC790\uACA9\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uACC4\uC18D\uD574\uC11C \uC790\uC2E0\uC758 \uD55C\uACC4\uB97C\\n\uB3CC\uD30C\uD574\uBCF4\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4!!"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uACC4\uC18D\uD574\uC11C \uB300\uB828\uC744 \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uD68C\uBCF5\uD558\uACE0 \uACC4\uC18D\uD55C\uB2E4"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uACC4\uC18D\uD55C\uB2E4"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uACC4\uC18D\uD574\uC11C \uB300\uB828\uC744 \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uAE4C?\\n(\uB0A8\uC740 \uD68C\uBCF5 [VAR 0200(0001)]\uD68C)"
  },
