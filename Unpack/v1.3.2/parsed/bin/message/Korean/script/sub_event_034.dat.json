[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD639\uC2DC \uB108...\\n\uADF8 \uC18C\uBB38 \uC54C\uC544?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC54C\uC544"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBAB0\uB77C"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8 \uADF8\uB807\uAD6C\uB098~\\n\uC544 \uBB50 \uB098\uB294 \uBCC4\uB85C \uAD00\uC2EC \uC5C6\uC9C0\uB9CC..."
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBB50?! \uBAA8\uB978\uB2E4\uACE0!?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uACE0\uBC31\uD560 \uB54C\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uC120\uBB3C\uD558\uBA74\\r\\n\uC131\uACF5\uD55C\uB2E4\uB294 \uC18C\uBB38 \uB9D0\uC774\uC57C!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "...\uC0AC\uC2E4\uC740 \uB0B4\uAC00\\n\uC88B\uC544\uD558\uB294 \uC544\uC774\uAC00 \uC788\uB294\uB370"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8 \uC560\uAC00 \uACE7\\n\uD574\uC678\uB85C \uAC00\uBC84\uB9B0\uB300..."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB0B4 \uB9C8\uC74C\uC744 \uC804\uB2EC\uD558\uACE0 \uC2F6\uC5B4\uC11C\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uCC3E\uC544\uB2E4\uB154\uB294\uB370\\r\\n\uC804\uD600 \uB098\uC624\uC9C8 \uC54A\uC544\uC11C \uB9D0\uC774\uC57C..."
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uD639\uC2DC \uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uC7A1\uC73C\uBA74\\n\uB098\uC5D0\uAC8C \uC904 \uC218 \uC788\uB2C8...?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098...\\n\uC774\uC0C1\uD55C \uBD80\uD0C1\uC744 \uD574\uC11C \uBBF8\uC548\uD574\\r\\n\uB0B4 \uD798\uC73C\uB85C \uC880 \uB354 \uC5F4\uC2EC\uD788 \uD574\uBCFC\uAC8C"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uD639\uC2DC\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uC8FC\uB824\uB294 \uAC70\uC57C...?"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uAC74\uB138\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC640\uC544! \uC2E0\uB09C\uB2E4!\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB2E4!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!\\n\uC815\uB9D0 \uC815\uB9D0 \uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uC900\\n\uB108\uC758 \uC218\uACE0\uC5D0 \uBCF4\uB2F5\uD558\uAE30 \uC704\uD574\uC11C\uB77C\uB3C4"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uADF8\uB140\uC5D0\uAC8C \uD655\uC2E4\uD558\uAC8C\\n\uB0B4 \uB9C8\uC74C\uC744 \uC804\uD560 \uAC70\uC57C...!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB2A6\uC5B4\uC11C \uBBF8\uC548\uD574\\n\uD560 \uB9D0\uC774 \uC788\uB2E4\uB2C8 \uAC11\uC790\uAE30 \uBB34\uC2A8 \uC77C\uC774\uC57C?"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC800\uAE30... \uADF8\uB7EC\uB2C8\uAE4C...\\n\uC774\uC0AC \uC900\uBE44\uB294 \uC798 \uB418\uACE0 \uC788\uC5B4?"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uAC70\uC758 \uB2E4 \uB05D\uB0AC\uC5B4!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB0B4\uC77C\uC774\\n\uC774\uC0AC \uAC00\uB294 \uB0A0\uC774\uB2C8\uAE4C..."
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uADF8\uB807\uAD6C\uB098..."
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC800 \uC800\uAE30!\\n\uC774 \uD3EC\uCF13\uBAAC\uC744 \uBD10\uBD10!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC557! \uACFC\uC0AC\uC0AD\uBC8C\uB808...!\\n\uAD49\uC7A5\uD558\uB2E4! \uB124\uAC00 \uC7A1\uC740 \uAC70\uC57C?"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uADF8 \uADF8\uAC8C..."
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC544 \uC544\uB2C8...\\n\uB2E4\uB978 \uC0AC\uB78C\uD55C\uD14C\uC11C \uBC1B\uC740 \uAC70\uC57C..."
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uBBF8\uC548\uD574! \uC0AC\uC2E4\uC740\\n\uB0B4\uAC00 \uC9C1\uC811 \uC7A1\uC740 \uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C\\r\\n\uB108\uC5D0\uAC8C \uC8FC\uACE0 \uC2F6\uC5C8\uB294\uB370..."
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uC548 \uB418\uACA0\uC5B4!\\n\uC774 \uACFC\uC0AC\uC0AD\uBC8C\uB808\uB294 \uC904 \uC218 \uC5C6\uC5B4..."
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC751 \uB098\uB3C4\\n\uC774 \uC544\uC774\uB97C \uBC1B\uC744 \uC218 \uC5C6\uC5B4"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "...\uC751"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC11C\uB85C \uBA40\uB9AC \uB5A8\uC5B4\uC838\uC11C\\n\uC9C0\uB0B4\uAC8C \uB418\uB354\uB77C\uB3C4"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uB124\uAC00 \uC9C1\uC811 \uC7A1\uC740 \uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C...\\n\uCB49 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uC751? \uADF8\uB807\uB2E4\uB294 \uAC74..."
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC5B4...\\n\uADF8 \uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790!!"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uC870\uAE08 \uC804\uC5D0 \uADF8 \uB9D0\\n\uB300\uCCB4 \uBB34\uC2A8 \uB73B\uC774\uC5C8\uC744\uAE4C...?"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC798\uB410\uB2E4!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uCD95\uD558\uD574!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uACE0 \uACE0\uB9C8\uC6CC...?"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "...\uC6B0\uC640~!\\n\uC5ED\uC2DC \uADF8 \uB73B\uC778 \uAC70 \uB9DE\uC9C0!?"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uC9C4\uC9DC \uC9C4\uC9DC!?\\n\uB9D0\uB3C4 \uC548 \uB3FC! \uD574\uB0C8\uB2E4~!!"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC544! \uC74C... \uBBF8 \uBBF8\uC548!\\c\\n\uC124\uB9C8 \uC11C\uB85C \uC88B\uC544\uD558\uACE0 \uC788\uC5C8\uC744 \uC904\uC740\\n\uC0C1\uC0C1\uB3C4 \uD558\uC9C0 \uBABB\uD588\uC5C8\uAC70\uB4E0"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uAC70\uACE0\\n\uC774 \uC544\uC774\uB294 \uB108\uC5D0\uAC8C \uB3CC\uB824\uC904\uAC8C"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uB3CC\uB824\uBC1B\uC558\uB2E4!"
  },
  {
    "index": 43,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC774\uAC74... \uC911\uC694\uD55C \uCCAB\uAC78\uC74C\uC744\\n\uB0B4\uB51B\uAC8C \uD574\uC900 \uBCF4\uB2F5\uC774\uC57C!"
  },
  {
    "index": 44,
    "flags": 0,
    "text": "\uB0B4 \uD798\uC73C\uB85C \uC9C1\uC811\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uC7A1\uC744 \uAC70\uC57C!"
  },
  {
    "index": 45,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC5B8\uC820\uAC00 \uB2E4\uC2DC \uADF8\uB140\uC5D0\uAC8C\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uC804\uD574\uC8FC\uB7EC \uAC00\uACA0\uC5B4!"
  },
  {
    "index": 46,
    "flags": 0,
    "text": "\uC88B\uC544~ \uADF8\uB7FC \uBC14\uB85C\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uCC3E\uC73C\uB7EC \uAC00\uBCFC\uAE4C!"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC548\uB155!"
  },
  {
    "index": 48,
    "flags": 0,
    "text": "...\uB9C8\uC74C\uC740 \uACE0\uB9D9\uC9C0\uB9CC\\n\uACFC\uC0AC\uC0AD\uBC8C\uB808\uB97C \uB370\uB9AC\uACE0 \uC640\uC11C \uB9D0\uD574\uC8FC\uC9C0 \uC54A\uC744\uB798?"
  }
]
