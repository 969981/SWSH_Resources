[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uB77C? [VAR 0100(0000)] \uADF8\uB9AC\uACE0 \uD638\uBE0C?\\c\\n\uC544\uCC28 \uAE5C\uBE61\uD588\uB2E4!\\n\uC624\uB298 \uCC54\uD53C\uC5B8\uB9E4\uCE58\uAC00 \uC788\uB294 \uB0A0\uC774\uC796\uC544!\\r\\n\uC5B4\uC9F8\uC11C \uC5EC\uAE30\uC5D0 \uC788\uB294 \uAC70\uC57C?[VAR 0114(000B)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC18C\uB2C8\uC544\uB3C4 \uCC38!\\n\uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uB294 \uBAA8\uC591\uC774\uAD6C\uB098\\c\\n\uB85C\uC988 \uC704\uC6D0\uC7A5\uC774 \uB300\uD68C\uB97C\\n\uC5C9\uB9DD\uC73C\uB85C \uB9CC\uB4E4\uC5B4 \uBC84\uB838\uC9C0 \uBB50\uB2C8![VAR 0114(0008)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB124?\\c\\n\uB124\uC5D0!?\\c\\n\uAFB8\uBC85\uC878\uC74C\uC232\uC744\\n\uC870\uC0AC\uD558\uB294 \uB3D9\uC548\uC5D0\\r\\n\uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC70\uC608\uC694?[VAR 0114(000B)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC74C \uADF8\uB7EC\uB2C8\uAE4C \uB108\uD074\uC2A4\uD0C0\uB514\uC6C0\uC774\\n\uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uC5D0 \uB4A4\uB36E\uC600\uC5B4\\c\\n\uBB50\uC600\uC9C0? \uBE14\uB799 \uB098\uC774\uD2B8\uB77C\uACE0 \uD588\uB098?\\n\uC544\uBB34\uD2BC \uB09C\uB9AC\uB3C4 \uC544\uB2C8\uC5C8\uC5B4[VAR 0114(0008)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uAD1C\uCC2E\uC744 \uAC70\uC57C!\\c\\n\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC774\\n\uC5B4\uB5BB\uAC8C\uB4E0 \uD574\uC8FC\uC9C0 \uC54A\uACA0\uC5B4?[VAR 0114(0008)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC7A0\uAE50\uB9CC\uC694 \uC544\uC8FC\uBA38\uB2C8 \uBC29\uAE08\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB77C\uACE0 \uD558\uC2E0 \uAC70\uC8E0!?[VAR 0114(000B)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBE14\uB799 \uB098\uC774\uD2B8\uB294 \uBA3C \uC61B\uB0A0\uC5D0\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC744 \uBA78\uB9DD\uC2DC\uD0AC \uBED4\uD55C\\r\\n\uAC80\uC740 \uC18C\uC6A9\uB3CC\uC774\uC758 \uC774\uB984\uC778\uB370...[VAR 0114(000B)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5B4? \uADF8\uB7EC\uBA74\\n[VAR 0100(0000)][VAR 1900(0001)] \uC5EC\uAE30\uC5D0 \uBB50\uD558\uB7EC \uC628 \uAC70\uC57C?[VAR 0114(000B)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBE14\uB799 \uB098\uC774\uD2B8\uB97C \uB9C9\uC744 \uAC70\uC608\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAC80\uC758 \uD3EC\uCF13\uBAAC\uC744 \uCC3E\uC744 \uAC70\uC608\uC694"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBC29\uD328\uC758 \uD3EC\uCF13\uBAAC\uC744 \uCC3E\uC744 \uAC70\uC608\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBE14\uB799 \uB098\uC774\uD2B8\uB97C \uB9C9\uACA0\uB2E4\uB2C8...\\c\\n\uAC80\uACFC \uBC29\uD328\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uCC3E\uACA0\uB2E4\uB294 \uB9D0\uC774\uB2C8?[VAR 0114(000B)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD655\uC2E4\uD788 \uC804\uC124\uC774 \uC0AC\uC2E4\uC774\uB77C\uBA74\\n\uAC80\uACFC \uBC29\uD328\uC758 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uBE14\uB799 \uB098\uC774\uD2B8\uB97C \uC9C4\uC815\uC2DC\uCF1C \uC904 \uAC70\uC57C...\\r\\n\uC18C\uC6A9\uB3CC\uC774\uB97C \uBB3C\uB9AC\uCE60 \uD798\uC774 \uB418\uC5B4\uC904 \uAC70\uC57C![VAR 0114(000B)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC54C\uC558\uC5B4! \uC774\uAC78 \uAC00\uC9C0\uACE0\\n\uAFB8\uBC85\uC878\uC74C\uC232\uC5D0 \uAC00\uBD10\\c\\n\uB098\uB3C4 \uC2E0\uACBD \uC4F0\uC774\uB294 \uAC78 \uC870\uC0AC\uD558\uACE0 \uB098\uC11C\\n\uB4A4\uB530\uB77C\uAC08\uAC8C[VAR 0114(000B)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB098\uB3C4 \uAC80\uACFC \uBC29\uD328\uC758 \uD3EC\uCF13\uBAAC\uC774\\n\uC5B4\uB514\uC5D0\uC11C\uBD80\uD130 \uC654\uB294\uC9C0 \uC870\uC0AC\uD574\uBD10\uC57C\uACA0\uC5B4![VAR 0114(000B)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD560 \uC218 \uC788\uB294 \uAC74 \uBAA8\uB450 \uD574\uBCF4\uB834\\c\\n\uB108\uB294 \uC774\uBBF8 \uC5B4\uC5FF\uD55C\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB2C8\uAE4C![VAR 0114(0008)]"
  }
]
