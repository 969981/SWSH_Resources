[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744...\\n\uC5B4\uC9F8\uC11C \uC154\uD130\uAC00 \uB0B4\uB824\uAC00 \uC788\uB294 \uAC70\uC9C0?\\r\\n\uC548\uC5D0\uC11C \uD30C\uD2F0\uB77C\uB3C4 \uD558\uACE0 \uC788\uB098?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC640\uC544\uC544! \uB545\uC774 \uD754\uB4E4\uB9AC\uB124!?\\c\\n\uD754\uB4E4\uB9BC\uC5D0 \uB9DE\uCDB0\uC11C\\n\uB0B4 \uBAB8\uC744 \uD754\uB4E4\uBA74...\\r\\n\uC774\uB7F0 \uD558\uB098\uB3C4 \uC18C\uC6A9\uC5C6\uC796\uC544!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "[~ 2]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\\n\uB450\uC1A1\uC740 \uC545\uD0C0\uC785 \uC804\uBB38\uAC00\uC9C0\uB9CC\\r\\n\uADF8\uB807\uAC8C \uB098\uC05C \uB140\uC11D\uC740 \uC544\uB2C8\uC57C"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB85C\uACE0\uAC00 \uC794\uB729 \uBC15\uD78C \uB9DD\uD1A0...\\n\uB2EC\uB824\uAC04 \uC0AC\uB78C\uC740 \uC124\uB9C8 \uCC54\uD53C\uC5B8!?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC154\uD130\uAC00 \uB0B4\uB824\uAC00 \uC788\uC73C\uB2C8\\n\uB204\uAD6C\uB3C4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD560 \uC218 \uC5C6\uACA0\uB124"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0...\\n\uAD1C\uCC2E\uC740 \uAC78\uAE4C?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBD89\uC740 \uBE5B\uC774\uB2E4!\\n\uC800\uAC74 \uB2E4\uC774\uB9E5\uC2A4\uC758 \uBE5B\uC778 \uAC78\uAE4C?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5B4\uB5BB\uAC8C \uB41C \uAC70\uC9C0?\\n\uC5EC\uAE30\uB294 \uD30C\uC6CC\uC2A4\uD3FF\uC774 \uC544\uB2CC\uB370\\r\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC774 \uB2E4\uC774\uB9E5\uC2A4\uB97C \uD558\uB124?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uACFC \uB9AC\uC790\uBABD\uC740\\n\uC288\uD37C\uD788\uC5B4\uB85C\uC57C!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC800\uAC74 \uC9C0\uC0C1\uD654\uC5D0 \uC788\uB358 \uADF8\uAC70\uC608\uC694!\\n\uC5B8\uB355 \uC704\uC758 \uC9C0\uC0C1\uD654\uB97C \uC7AC\uD604\uD558\uACE0 \uC788\uB294 \uAC81\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uAD34 \uAD49\uC7A5\uD55C...\\n\uC9C0 \uC9C4\uB3D9\uC774\uB2E4..."
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8!?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5B4\uC9F8\uC11C \uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC774\\n\uC774\uACF3\uC5D0\uC11C \uB2E4\uC774\uB9E5\uC2A4\uB97C?"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uBD89\uC740 \uBE5B\uC774...\\n\uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774\uC9C0?"
  }
]
