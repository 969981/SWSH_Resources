[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC774\uACF3\uAE4C\uC9C0 \uC628 \uAC83\uC744 \uD658\uC601\uD55C\uB2E4\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC![VAR 0114(000F)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uB0B4 \uC18C\uAC1C\uB97C \uD560\uAC8C, \uB098\uB294 \uC57C\uCCAD\uC774\uC57C\\n\uC870\uAE08 \uC804\uC5D0\uB294 \uC77C\uBD80\uB7EC \uB098\uB97C \uCC3E\uAC8C \uD574\uC11C \uBBF8\uC548\uD588\uC5B4[VAR 0114(000F)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB098\uC758 \uBBF8\uC158...\\n\uC2E0\uC911\uD558\uAC8C \uB3C4\uC804\uD574\uB3C4 \uC5B4\uB824\uC6E0\uC744 \uD150\uB370\\r\\n\uC6A9\uCF00 \uD074\uB9AC\uC5B4\uD588\uAD6C\uB098?\\c\\n\uB10C... \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C \uD544\uC694\uD55C\\n\uB6F0\uC5B4\uB09C \uB450\uB1CC\uB97C \uAC00\uC9C4 \uBAA8\uC591\uC774\uB124[VAR 0114(000F)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8 \uB6F0\uC5B4\uB09C \uBA38\uB9AC\uB85C\\n\uC5B4\uB5A4 \uC791\uC804\uC744 \uD3BC\uCE58\uB354\uB77C\uB3C4\\c\\n\uB098\uC640 \uB098\uC758 \uC790\uB791\uC2A4\uB7EC\uC6B4 \uD30C\uD2B8\uB108\uAC00\\n\uBB3C\uC758 \uD798\uC73C\uB85C \uB9C9\uC544 \uC8FC\uACA0\uC5B4![VAR 0114(000F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC5B4...!\\n\uC5B4\uB5BB\uAC8C \uC774\uB7F0 \uC77C\uC774!![VAR 0114(000F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uD6C4\uC6B0\\n\uC0C1\uB300\uD574\uBCF4\uB2C8 \uC54C\uACA0\uC5B4[VAR 0114(000F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB108\uC758 \uD300\uC5D0\uB294\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uC774\uACA8\uB0B4\uACE0\\c\\n\uCC54\uD53C\uC5B8\uC5D0\uAC8C \uB3C4\uC804\uD560 \uB9CC\uD55C\\n\uBA4B\uC9C4 \uC2A4\uD53C\uB9BF\uC774 \uC788\uB2E4\uB294 \uAC83\uC744 \uB9D0\uC774\uC57C[VAR 0114(000F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB108\uD76C\uB294... \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C\\n\uBC1B\uC744 \uC790\uACA9\uC774 \uCDA9\uBD84\uD574![VAR 0114(000F)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB808\uBCA8 30\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB124\uAC00 \uB2E4\uC74C\uC5D0 \uB3C4\uC804\uD560 \uC0AC\uB78C\uC740\\n\uBD88\uAF43\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uAD6C\uB098\\c\\n\uC9C0\uAE08\uC758 \uB108\uD76C\uB77C\uBA74\\n\uADF8\uBD84\uB3C4 \uC0C1\uB300\uD574\uC8FC\uC2E4 \uAC70\uC57C[VAR 0114(000F)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uB2D8! \uCCB4\uC721\uAD00 \uAD00\uC7A5\\n\uC57C\uCCAD\uB2D8\uC5D0\uAC8C \uC2B9\uB9AC\uD558\uC2E0 \uAC83\uC744\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD569\uB2C8\uB2E4!\\c\\n\uAE30\uB150\uC73C\uB85C\\n\uC774 \uAE30\uC220\uBA38\uC2E0\uC744 \uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC57C\uCCAD\uB2D8\uC758 \uB808\uD50C\uB9AC\uCE74 \uC720\uB2C8\uD3FC\uB3C4\\n\uC120\uBB3C\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB3C\uBC30\uC9C0\uB97C \uD68D\uB4DD\uD55C\\n\uC5EC\uB7EC\uBD84\uC774 \uC5B4\uB514\uAE4C\uC9C0 \uAC08 \uC218 \uC788\uC744\uC9C0\\r\\n\uC800\uB3C4 \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uC744\uAC8C\uC694!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC57C\uCCAD\uB2D8\uC5D0\uAC8C \uC2B9\uB9AC\uD55C \uAC83\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC14\uB2E4"
  }
