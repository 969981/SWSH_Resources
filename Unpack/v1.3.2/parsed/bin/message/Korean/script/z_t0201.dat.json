[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBA40\uB9AC \uBCF4\uC774\uB294\\n\uC9C0\uBD95\uC774 \uBCF4\uB77C\uC0C9\uC778 \uC9D1\uC774\\r\\n\uD3EC\uCF13\uBAAC \uBC15\uC0AC\uB2D8\uC758 \uC9D1\uC774\uC57C"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8\\n\uC2DD\uC0AC\uB97C \uD558\uBA74 \uB9DB\uC774 \uB450 \uBC30\uAC00 \uB418\uC9C0!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E8\uB378\uB2D8\uC5D0\uAC8C\uB294\\n\uB0A8\uB3D9\uC0DD\uC774 \uC788\uB2E4\uB294 \uAC83 \uAC19\uC740\uB370...\\c\\n\uBD84\uBA85 \uB2E8\uB378\uB2D8\uCC98\uB7FC \uAD49\uC7A5\uD55C\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uACA0\uC9C0?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC774 \uADFC\uBC29\uC740 \uD55C\uAC00\uB85C\uC6B4 \uC2DC\uACE8 \uB9C8\uC744\uC774\uC9C0\uB9CC\\n\uB3C4\uC2DC\uC5D0 \uB098\uAC00 \uBCF4\uBA74 \uB180\uB784 \uAC70\uC57C"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC740 \uC2F8\uC6B0\uAC8C \uD574\uC11C \uAC15\uD574\uC9C4\uB2E4\\c\\n\uADF8\uB807\uC9C0\uB9CC \uC5B4\uB5BB\uAC8C \uD0A4\uC6B0\uB294\uC9C0\uC5D0 \uB530\uB77C\\n\uD2B8\uB808\uC774\uB108 \uC2E4\uB825\uC744 \uC54C \uC218 \uC788\uC9C0"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8 \uB2E8\uB378\uC740\\n\uBAA8\uB450\uC758 \uC288\uD37C\uC2A4\uD0C0\uC57C!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB9AC\uC790\uBABD \uD3EC\uC988!\\c\\n\uD568\uAED8 \uD3EC\uC988\uB97C \uCDE8\uD558\uAE30\uB9CC \uD574\uB3C4\\n\uAC15\uD574\uC9C4 \uB290\uB08C\uC774 \uB4E4\uC5B4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC544\uCE68\uC740 \uD3EC\uCF13\uBAAC\uC774 \uAE68\uC6CC\uC8FC\uACE0\\n\uBC24\uC5D0\uB294 \uD3EC\uCF13\uBAAC\uC744 \uC7AC\uC6B0\uACE0...\\c\\n\uD3EC\uCF13\uBAAC\uC774 \uC5C6\uB294 \uC77C\uC0C1\uC740\\n\uC0C1\uC0C1\uD560 \uC218 \uC5C6\uC5B4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC774\uACF3\uC5D0 \uC788\uB358 \uAC04\uD310\uC758\\n\uBA54\uC2DC\uC9C0\uAC00 \uC0DD\uAC01\uB0AC\uC5B4\\c\\n\uC624\uB978\uCABD\uC774 \uD3EC\uCF13\uBAAC \uC5F0\uAD6C\uC18C\uC774\uACE0\\n\uBC18\uB300\uCABD\uC740 \uC5ED\uC774\uC57C"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB098\uB3C4 \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB85C\\n\uBA39\uACE0\uC0B4\uB824\uACE0 \uC0DD\uAC01\uD588\uC5C8\uB294\uB370\\c\\n\uB2E8\uB378\uB2D8\uCC98\uB7FC \uC5B8\uC81C\uB098\\n\uD3EC\uCF13\uBAAC\uB9CC \uC0DD\uAC01\uD558\uB294 \uAC74 \uBABB \uD558\uACA0\uC5B4"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBD80\uD2F0\uD06C\uC5D0\uC11C \uC1FC\uD551!\\n\uBAA8\uC790 \uD558\uB098\uB85C \uAE30\uBD84 \uC804\uD658\uC774 \uB41C\uB2E4\uACE0!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uBC15\uC0AC\uB2D8\uC740 \uB9D0\uC774\uB2E4\\n\uD3C9\uC18C\uC5D0\uB294 \uD638\uC22B\uAC00\uC5D0 \uC788\uB294 \uC9D1\uC5D0\uC11C\\r\\n\uD55C\uAC00\uB85C\uC774 \uC9C0\uB0B4\uACE0 \uACC4\uC2DC\uB2E8\uB2E4"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\\n\uAE30\uBCF8 \uADF8 \uCCAB \uBC88\uC9F8!\\c\\n\uC2B9\uBD80\uD560 \uB54C \uD280\uC5B4\uB098\uC624\uB294 \uAC74\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC \uB9AC\uC2A4\uD2B8 \uC120\uB450\uC5D0 \uC788\uB294 \uD3EC\uCF13\uBAAC"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB108\uB3C4 \uAE38\uC744 \uC783\uC73C\uBA74\\n\uD0C0\uC6B4\uB9F5\uC744 \uBCF4\uB3C4\uB85D \uD558\uB834"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5ED\uC5D0\uC11C \uCC54\uD53C\uC5B8\uC744 \uBD24\uC5B4!\\n\uBA40\uB9AC \uC788\uB294\uB370\uB3C4 \uC624\uB77C\uAC00 \uAD49\uC7A5\uD588\uC5B4!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[~ 15]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[~ 16]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "[~ 17]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "[~ 18]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "[~ 19]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB2C8\uD788\uD788\uD788"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uD6C4\uAE4C\uD6C4\uAE4C\uAE4C"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB3D7\uB3D7\uB3C4"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC751\uBA54~"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108 \uAE30\uBCF8 \uADF8 \uB450 \uBC88\uC9F8!\\n\uD2C8\uD2C8\uC774 \uB9AC\uD3EC\uD2B8!\\c\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108 \uAE30\uBCF8 \uADF8 \uC138 \uBC88\uC9F8!\\n\uD3EC\uCF13\uBAAC\uACFC \uAE30\uC220 \uD0C0\uC785\uC774\\r\\n\uAC19\uC73C\uBA74 \uC704\uB825\uC774 \uC5C5!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC758 \uD798\uC744 \uB04C\uC5B4\uB0B4\uAE30 \uC704\uD574\uC11C\uB294\\n\uD2B8\uB808\uC774\uB108\uC758 \uC9C0\uC2DD\uC774 \uC911\uC694\uD558\uB2E8\uB2E4!"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uD638\uBE0C\uB2D8\uC774 \uC0B4\uAE08\uC0B4\uAE08 \uAC78\uC5B4\uC11C\\n\uC5ED \uCABD\uC73C\uB85C \uAC14\uC5B4"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uAD50!?"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC774\\n\uC654\uB2E4~!!"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uCD5C\uAC15\uC758\\n\uB9AC\uC790\uBABD!"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB9AC\uC790\uC544!!"
  }
]
