[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624\uC624!\\n\uB300\uC7A5\uC774\uAD6C\uB098![VAR 0114(0076)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uACA8\uC6B0 \uB2C8\uC544\uC640\\n\uAC00\uC871\uB07C\uB9AC \uC815\uACA8\uC6B4 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uACE0 \uC788\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC751? \uB0B4\uAC00 \uC544\uC9C0\uD2B8\uC5D0\\n\uBA54\uBAA8\uB97C \uB5A8\uC5B4\uB728\uB838\uB2E4\uACE0?[VAR 0114(0076)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uADF8\uB7F0 \uAC78 \uAC00\uC9C0\uACE0 \uC788\uC5C8\uB098...?\\n\uC804\uD600 \uAE30\uC5B5\uC774 \uC548 \uB098\uB294\uB370[VAR 0114(0076)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC73C\uC74C? \uADF8 \uBA54\uBAA8\uC5D0\\n\uB098\uC640 \uC788\uB294 \uACF3...\\r\\n\uC5EC\uAE30 \uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74 \uC544\uB2C8\uC57C?[VAR 0114(0076)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC640\uC545~!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC751?[VAR 0114(0076)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774\uC8E0!?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74 \uC548\uC5D0...!\\c\\n\uD3EC\uCF13\uBAAC\uC778\uC9C0 \uC54C \uC218 \uC5C6\uB294 \uC0DD\uBA85\uCCB4\uAC00\\n\uBB34\uB354\uAE30\uB85C \uB098\uD0C0\uB0AC\uC5B4\uC694!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uBB50\uB77C\uAD6C\uC694!?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBAA8\uC885\uC758 \uC601\uD5A5\uC73C\uB85C\\n\uB2E4\uB978 \uC138\uACC4\uC758 \uC0DD\uBA85\uCCB4\uAC00 \uB098\uD0C0\uB0AC\uB2E4\uB77C...\\c\\n\uC9C0\uB09C\uBC88\uC5D0 \uD55C\uC21C\uAC04 \uC5F4\uB838\uB358\\n\uC6B8\uD2B8\uB77C\uD640\uACFC \uAD00\uB828\uC774 \uC788\uB294 \uAC74\uAC00...?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBB54\uC9C0 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uC5C4\uCCAD\uB09C \uC77C\uC774 \uBC8C\uC5B4\uC9C4 \uBAA8\uC591\uC774\uC57C[VAR 0114(0076)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB300\uC7A5!\\n\uC774\uAC70 \uB610 \uC0C8\uB85C\uC6B4 \uD0D0\uD5D8\uC774\\r\\n\uC2DC\uC791\uB420\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC774 \uD0D0\uD5D8\uC5D0 \uC774\uB984\uC744 \uBD99\uC774\uC790\uBA74![VAR 0114(0076)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD558\uD558! \uD558! \uB18D\uB2F4\uC774\uC5C8\uC5B4![VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC544\uBB34\uD2BC! \uBA54\uBAA8\uC5D0 \uB098\uC640 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC778\uC9C0 \uBAA8\uB97C \uB140\uC11D\uB4E4\uC744 \uC7A1\uB294 \uAC78 \uBAA9\uD45C\uB85C\\r\\n\uC5F4\uC2EC\uD788 \uC5B4\uB4DC\uBCA4\uCC98 \uD574\uBD10![VAR 0114(0076)]"
  }
]
