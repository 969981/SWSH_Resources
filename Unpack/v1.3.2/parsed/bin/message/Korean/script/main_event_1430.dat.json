[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB4DC\uB514\uC5B4 \uC0C1\uB300\uD560 \uB9CC\uD55C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00\\n\uB098\uD0C0\uB09C \uAC74\uAC00 \uD588\uB294\uB370 \uB108\uC77C \uC904\uC774\uC57C![VAR 0114(0017)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB2E8\uB378\uC774 \uB208\uC5EC\uACA8\uBCF8\\n\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB294 \uB2E4\uB974\uAD70![VAR 0114(0017)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E8\uB378\uC744 \uC774\uAE30\uB294 \uAC83...\\n\uADF8\uAC83\uC774 \uC5BC\uB9C8\uB098 \uD798\uB4E0 \uC77C\uC778\uC9C0\\c\\n\uB140\uC11D\uC758 \uB77C\uC774\uBC8C\uC778\\n\uC774 \uAE08\uB791\uB2D8\uC774 \uCCA0\uC800\uD558\uAC8C \uAC00\uB974\uCCD0\uC918 \uBCF4\uC2E4\uAE4C![VAR 0114(0017)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB098 \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uAE08\uB791\uC740\\n\uB0A0\uC528\uB97C \uC870\uC885\uD558\uB294 \uAC83\uBFD0\uB9CC \uC544\uB2C8\uB77C\\r\\n2\uB3002\uB85C \uC2F8\uC6B0\uB294 \uAC83\uC744 \uC120\uD638\uD558\uC9C0!\\c\\n\uADF8\uB7EC\uB2C8\uAE4C \uB108\uB294 \uB2E4\uC591\uD55C \uC0C1\uD669\uC5D0 \uB300\uCC98\uD558\uB294\\n\uB2A5\uB825\uC744 \uB0B4\uAC8C \uBCF4\uC5EC\uC918\uC57C \uD558\uB294 \uAC70\uC57C![VAR 0114(0017)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uACA9\uB82C\uD55C \uC2F8\uC6C0\uC744 \uB05D\uB0C8\uB354\uB2C8...\\n\uC9C0\uAE08\uC740 \uB9D1\uAC8C \uAC20 \uD558\uB298\uCC98\uB7FC\\r\\n\uC0C1\uCF8C\uD55C \uAE30\uBD84\uC774\uC57C![VAR 0114(0017)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC774\uC81C \uB098\uB97C \uBB50\uB77C \uBD88\uB7EC\uC57C \uD558\uC9C0?\\c\\n\uB2E8\uB378\uC758 \uB77C\uC774\uBC8C\uC774\uB77C \uD574\uB3C4 \uC88B\uC740 \uAC78\uAE4C?\\n\uCC54\uD53C\uC5B8\uB3C4 \uC544\uB2CC\uB370 \uB098\uC640 \uB0B4 \uD3EC\uCF13\uBAAC\uC740\\r\\n\uB108\uBB34 \uC790\uB9CC\uD558\uACE0 \uC788\uC5C8\uB358 \uBAA8\uC591\uC774\uC57C![VAR 0114(0017)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB7FC! \uC2B9\uB9AC\uC758 \uC99D\uD45C\uC778\\n\uB4DC\uB798\uACE4\uBC30\uC9C0\uB97C \uC904\uAC8C!![VAR 0114(0017)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBAA8\uB4E0 \uB808\uBCA8\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uBAA8\uB4E0\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uC190\uC5D0 \uB123\uC5C8\uAD6C\uB098![VAR 0114(0017)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8 \uB2E8\uB378\uC5D0\uAC8C \uB3C4\uC804\uD558\uB824\uBA74\\n\uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C \uC774\uAE30\uB294 \uAC70\uC57C!\\c\\n\uC544\uB2C8 \uC774\uACA8\uC57C\uB9CC \uD574!\\c\\n\uADF8\uB798! \uC6B0\uB9AC\uC758\\n\uB9AC\uBCA4\uC9C0\uB97C \uC704\uD574\uC11C\uB77C\uB3C4 \uB9D0\uC774\uC57C!![VAR 0114(0017)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBAA8\uB4E0 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBAA8\uC73C\uC168\uAD70\uC694...\\n\uADF8\uB7FC \uC774\uC81C \uCC54\uD53C\uC5B8\uCEF5\uB9CC \uB0A8\uC558\uB124\uC694!\\r\\n\uC5EC\uB7EC\uBD84\uC758 \uD65C\uC57D\uC744 \uAE30\uB300\uD558\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0 \uB3CC\uD30C\uB97C\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  }
]
