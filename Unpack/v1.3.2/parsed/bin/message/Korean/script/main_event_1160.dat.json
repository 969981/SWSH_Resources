[
  {
    "index": 0,
    "flags": 0,
    "text": "\uB108\uD074\uC2DC\uD2F0... \uC5EC\uC804\uD788\\n\uBA3C\uC9C0\uAC00 \uB9CE\uC774 \uB0A0\uB9AC\uB294 \uB9C8\uC744\uC774\uAD6C\uB098\\c\\n\uBB50 \uC774\uB7F0 \uAC78 \uC88B\uC544\uD558\uB294\\n\uD3EC\uCF13\uBAAC\uB3C4 \uC788\uC73C\uB2C8[VAR 0114(0013)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD5E4\uC5B4\uC9C4 \uC9C0 \uC5BC\uB9C8 \uB418\uC9C0\uB3C4 \uC54A\uC558\uB294\uB370\\n\uB108\uC640\uB294 \uC790\uC8FC \uB9C8\uC8FC\uCE58\uB294\uAD6C\uB098[VAR 0114(0013)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC74C? \uC800 \uC544\uC774\uB294...[VAR 0114(0013)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD551\uD06C\uAC00 \uAD49\uC7A5\uD788 \uC798 \uC5B4\uC6B8\uB9B4 \uAC83 \uAC19\uC740 \uC544\uC774\uB85C\uAD70![VAR 0114(0013)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCC4C\uB9B0\uC9C0\uBC34\uB4DC\uB97C \uBE7C\uC557\uAE30\uACE0\\n\uB354 \uC774\uC0C1\uC740 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00 \uC544\uB2CC\\r\\n\uC800\uB97C \uBCF4\uB7EC \uC62C \uC904\uC774\uC57C...\\r\\n\uADF8\uB807\uAC8C \uC5EC\uC720 \uBD80\uB824\uB3C4 \uB418\uB294 \uAC74\uAC00\uC694?[VAR 0114(000C)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC9C0"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAE00\uC384..."
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uBB50 \uADF8\uB7F4\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uAD70\uC694\\n\uC774\uC81C\uB294 \uC800\uC640 \uAC19\uC740 \uAC15\uC801\uC774 \uC5C6\uC744 \uD14C\uB2C8\uAE4C\uC694[VAR 0114(000C)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC758 \uC2E4\uB825\uC5D0 \uB9DE\uB294\\n\uC18C\uADF9\uC801\uC778 \uB300\uB2F5\uC774\uB124\uC694[VAR 0114(000C)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC!\\c\\n\uC800\uB294 \uC544\uC9C1 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!\\c\\n\uC704\uC6D0\uC7A5\uB2D8\uC744 \uC704\uD574\\n\uCC54\uD53C\uC5B8\uC774 \uB420 \uAC81\uB2C8\uB2E4! \uADF8\uB7EC\uB2C8\uAE4C\\r\\n\uB2E4\uC2DC \uD55C\uBC88 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\\r\\n\uCC38\uAC00\uD560 \uC218 \uC788\uB3C4\uB85D \uBD80\uD0C1\uD560 \uC0DD\uAC01\uC785\uB2C8\uB2E4![VAR 0114(000C)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC815\uC9C1\uD558\uBA74\uC11C\uB3C4 \uBE44\uB6A4\uC5B4\uC838 \uC788\uB294 \uC800 \uBAA8\uC2B5...\\n\uC88B\uC544... \uADF8\uB807\uC9C0 \uC54A\uACE0\uC11C\uC57C\\r\\n\uC0AC\uB78C\uC5D0\uAC8C \uC5EC\uC720\uAC00 \uC0DD\uAE38 \uC218 \uC5C6\uB294 \uBC95\uC774\uC9C0[VAR 0114(0013)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB108\uB294 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAC00 \uC544\uB2C8\uC9C0\uB9CC\\n\uD2B9\uBCC4\uD788 \uB098\uC758 \uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\r\\n\uBC1B\uC744 \uC218 \uC788\uAC8C \uD574\uC8FC\uB9C8\\c\\n\uC2EB\uB2E4\uACE0 \uD574\uB3C4 \uB193\uC544\uC8FC\uC9C0 \uC54A\uC744 \uAC70\uC9C0\uB9CC[VAR 0114(0013)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC88B\uC544 \uADF8\uB7FC \uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2DC\uC791\uC774\uB2E4![VAR 0114(0013)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uADF8 \uADF8\uAC8C \uBB34\uC2A8!?[VAR 0114(000C)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD551\uD06C![VAR 0114(0013)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uD551\uD06C!![VAR 0114(0013)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uD551\uD06C!!![VAR 0114(0013)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCD95\uD558\uD55C\uB2E4![VAR 0114(0013)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB10C \uD655\uC2E4\uD788 \uD551\uD06C\uB85C\uAD6C\uB098[VAR 0114(0013)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB2E4 \uB2F9\uC2E0\uC740 \uD3EC\uD50C\uB7EC\uB2D8!?\\n\uAC11\uC790\uAE30 \uADF8\uAC8C \uBB34\uC2A8 \uB9D0\uC500\uC774\uC2DC\uC8E0?[VAR 0114(000C)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uB108\uB294 \uC9C0\uAE08 \uC62C\uB9AC\uBE0C \uAC19\uC740 \uC790\uC5D0\uAC8C\\n\uBA4B\uB300\uB85C \uC774\uC6A9\uB2F9\uD574\uC11C\\r\\n\uAE30\uAECF \uC18C\uC6D0\uC758\uBCC4\uC744 \uC5F4\uC2EC\uD788 \uBAA8\uC558\uB354\uB2C8\\r\\n\uBC84\uB9BC\uBC1B\uC544\uC11C \uB09C\uCC98\uD55C \uC0C1\uD669\uC774\uACA0\uC9C0?[VAR 0114(0013)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB098\uB97C \uB530\uB77C \uC624\uAC70\uB77C\\n\uB0B4\uAC00 \uB3C4\uC6C0\uC744 \uC904 \uC218 \uC788\uC744 \uAC83 \uAC19\uAD6C\uB098\\c\\n\uBB3C\uB860 \uBAA8\uB4E0 \uAC74 \uB108\uC758 \uB178\uB825\uC5D0\\n\uB2EC\uB838\uC9C0\uB9CC \uB9D0\uC774\uB2E4[VAR 0114(0013)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC800\uB97C \uC2DC\uD5D8\uD558\uC2DC\uB824\uB294 \uAC74\uAC00\uC694?\\c\\n\uC88B\uC2B5\uB2C8\uB2E4! \uB2E8, \uB2F9\uC2E0\uC5D0\uAC8C \uC778\uC815\uC744 \uBC1B\uC73C\uBA74\\n\uC81C\uAC8C \uC18C\uC6D0\uC758\uBCC4\uC5D0 \uB300\uD55C \uAC83\uC744\\r\\n\uAC00\uB974\uCCD0\uC8FC\uC2DC\uC8E0![VAR 0114(000C)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uADF8\uB7FC \uB108\uB294\\n\uD0A4\uB974\uCFE0\uC2A4\uB9C8\uC744\uB85C \uAC00\uBCF4\uB824\uBB34\uB098\\r\\n7\uBC88\uB3C4\uB85C\uAC00 \uC5B4\uB518\uC9C0\uB294 \uC54C\uC9C0?[VAR 0114(0013)]"
  }
]
