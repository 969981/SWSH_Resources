[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB97C \uC751\uC6D0\uD558\uAE30 \uC704\uD574\\n\uBA40\uB9AC\uC11C \uB3C4\uC2DC\uAE4C\uC9C0 \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4\\c\\n\uC774\uB807\uAC8C \uC131\uC2E4\uD55C \uC6B0\uB9AC \uC610\uB2E8\uC744\\n\uBC29\uD574\uD558\uC2DC\uACA0\uB2E4\uBA74 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC2B9\uBD80\uD574\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC544\uB1E8 \uAD1C\uCC2E\uC544\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC800\uAE30\uC694! \uC81C\uAC00 \uBC29\uAE08 \uBC29\uD574\uD558\uC2DC\uACA0\uB2E4\uBA74\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB77C\uACE0 \uB9D0\uC500\uB4DC\uB838\uC8E0?!\\c\\n\uD55C \uD2B8\uB808\uC774\uB108\uB97C \uC774\uAE30\uAC8C \uD558\uAE30 \uC704\uD574\\n\uC751\uC6D0\uC744 \uBCF4\uB0B4\uB294...\\c\\n\uC6B0\uB9AC \uC610\uB2E8\uC758 \uAD49\uC7A5\uD568\uACFC \uBB34\uC11C\uC6C0\uC744\\n\uC81C\uB300~\uB85C \uAC00\uB974\uCCD0 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB370\uC5D8![VAR 0114(006F)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uB7F0! \uC610\uB2E8\uC758 \uB3D9\uB8CC\uBD84\uB4E4!\\n\uC800\uC758 \uBCF5\uC218\uB97C \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4![VAR 0114(006F)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC88B\uC544 \uC88B\uC544~! \uD638\uD154\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB77C\uB2C8 \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uB370![VAR 0114(006F)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uACE0\uAE09\uC2A4\uB7EC\uC6C0\uC774 \uD758\uB7EC\uB118\uCE58\uB294 \uACF5\uAC04\uC774\uB77C...\\n\uCC28\uBD84\uD558\uAC8C \uC2F8\uC6B0\uC9C0 \uBABB\uD588\uC5B4...[VAR 0114(006F)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uB108 \uCCB4\uD06C\uC778\uC744 \uCC38 \uC694\uB780\uD558\uAC8C \uD558\uB294\uAD6C\uB098...\\c\\n\uBB50\uC57C \uC774\uAC70\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD558\uACE0 \uC788\uB358 \uAC70\uC57C?[VAR 0114(0005)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC88B\uC544!\\n\uB098\uB3C4 \uD2B8\uB808\uC774\uB2DD\uC774\uB2E4!\\c\\n[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uAC74\uAC15\uD558\uAC8C \uB9CC\uB4E4\uC5B4 \uC904\uAC8C![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB098\uB294 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800 \uD638\uBE0C!\\n\uCC54\uD53C\uC5B8\uC774 \uB420 \uC0AC\uB098\uC774\uC57C!\\r\\n\uC790! 2\uB3002\uB85C \uC2B9\uBD80\uD558\uC790!![VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBCF4\uC785\uB2C8\uB2E4! \uB2F9\uC2E0\uC758 \uD328\uBC30\uAC00!\\n\uB4E4\uB9BD\uB2C8\uB2E4! \uB2F9\uC2E0\uC758 \uC6B8\uC74C\uC18C\uB9AC\uAC00![VAR 0114(006F)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBCF4\uC785\uB2C8\uB2E4... \uC6B0\uB9AC\uC758 \uD328\uBC30\uAC00...\\n\uB4E4\uB9BD\uB2C8\uB2E4... \uC6B0\uB9AC\uC758 \uC6B8\uC74C\uC18C\uB9AC\uAC00...[VAR 0114(006F)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB2E4\uB4E4 \uBB50 \uD558\uACE0 \uC788\uB294 \uAC70\uC57C?[VAR 0114(0042)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB9C8\uB9AC!?[VAR 0114(006F)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC544\uB2C8 \uC800 \uADF8\uAC8C...[VAR 0114(006F)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uB108\uD76C\uAC00 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB97C\\n\uC2E0\uACBD \uC4F0\uB294 \uAC74 \uC54C\uACA0\uB294\uB370\\r\\n\uBC29\uBC95\uC774 \uC870\uAE08 \uAC70\uCE60\uC796\uC544[VAR 0114(000D)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uBBF8\uC548! \uC610\uB2E8\uC740\\n\uB0B4 \uC751\uC6D0\uB2E8\uC778\uB370\\r\\n\uB2E4\uB4E4 \uC870\uAE08 \uD765\uBD84\uD588\uB358 \uBAA8\uC591\uC774\uC57C...[VAR 0114(000D)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC790! \uC774\uC81C \uB2E4\uB4E4\\n\uB3CC\uC544\uAC00 \uB3CC\uC544\uAC00![VAR 0114(000D)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB098\uB97C \uC751\uC6D0\uD558\uB294 \uB370 \uD479 \uBE60\uC838\uC11C\\n\uB2E4\uB978 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5D0\uAC8C\uB294\\r\\n\uAC00\uC2DC \uB3CB\uCE5C \uD0DC\uB3C4\uB97C \uBCF4\uC774\uAC70\uB4E0\\c\\n\uBD88\uCF8C\uD558\uAC8C \uD588\uB2E4\uBA74 \uC815\uB9D0 \uBBF8\uC548\uD574[VAR 0114(000D)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uB108\uB3C4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAD6C\uB098!\\n\uC610\uB2E8\uC774\uB77C\uACE0 \uD588\uB098?\\r\\n\uBC8C\uC368\uBD80\uD130 \uD32C\uC774 \uC788\uB2E4\uB2C8 \uAD49\uC7A5\uD558\uB2E4![VAR 0114(0005)]"
  }
