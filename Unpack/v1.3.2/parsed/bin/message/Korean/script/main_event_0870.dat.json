  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC790 \uBCF4\uAC70\uB77C! \uC5D0\uB108\uC9C0\uD50C\uB79C\uD2B8\uC5D0 \uB300\uD574\\n\uC774\uD574\uD558\uAE30 \uC27D\uAC8C \uC124\uBA85\uB418\uC5B4 \uC788\uB2E8\uB2E4"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB108\uD074\uC2A4\uD0C0\uB514\uC6C0\uC758 \uD0D1\uC744 \uD1B5\uD574\\n\uD761\uC218\uD55C \uC5D0\uB108\uC9C0\uB97C"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC9C0\uD558 \uD50C\uB79C\uD2B8\uC5D0\uC11C \uC804\uAE30\uB85C \uBC14\uAFB8\uC5B4\\n\uAC00\uB77C\uB974 \uC804\uC5ED\uC5D0 \uBCF4\uB0B4\uACE0 \uC788\uB2E8\uB2E4!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uC0DD\uD65C\uACFC \uC0AC\uD68C\uB294\\n\uC804\uAE30\uB098 \uAC00\uC2A4, \uBB3C\uACFC \uAC19\uC740\\r\\n\uC5D0\uB108\uC9C0\uAC00 \uC5C6\uC73C\uBA74 \uC81C\uB300\uB85C \uC720\uC9C0\uD560 \uC218 \uC5C6\uC9C0[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB798\uC11C \uB098\uC758 \uAD00\uB828 \uADF8\uB8F9\uC5D0\uC11C\uB294\\n\uC18C\uC6D0\uC758\uBCC4\uC758 \uC5D0\uB108\uC9C0\uB97C \uC774\uC6A9\uD574\uC11C\\c\\n\uBAA8\uB450\uC758 \uC0DD\uD65C\uC744 \uC720\uC9C0\uC2DC\uD0A4\uB294 \uAC83\uC744\\n\uBAA9\uD45C\uB85C \uD558\uACE0 \uC788\uB2E8\uB2E4![VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC624 \uC774\uB7F0!\\n\uC774\uC81C \uC77C\uD560 \uC2DC\uAC04\uC774\uAD70\\c\\n\uC62C\uB9AC\uBE0C\uAD70\uC5D0\uAC8C \uD63C\uB098\uAE30 \uC804\uC5D0\\n\uAC00\uBD10\uC57C\uACA0\uAD6C\uB098[VAR 0114(0006)]"
  },
  {
