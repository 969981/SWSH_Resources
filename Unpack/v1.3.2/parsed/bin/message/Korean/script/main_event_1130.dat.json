[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uB108\uB77C\\n\uD551\uD06C\uAC00 \uBD80\uC871\uD55C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC[VAR 0114(0013)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC740 \uB9D0\uC774\uB2E4\\n\uB0B4\uAC8C \uD6C4\uACC4\uC790\uAC00 \uD544\uC694\uD574\uC11C\\c\\n\uC0C8\uB85C\uC6B4 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758\\n\uC624\uB514\uC158\uB3C4 \uACB8\uD558\uACE0 \uC788\uB2E8\uB2E4[VAR 0114(0013)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC04\uB2E8\uD558\uB2C8 \uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uB9D0\uB824\uBB34\uB098\\c\\n\uC2B9\uBD80\uB97C \uD558\uBA74\uC11C \uB3C4\uC911\uC5D0 \uB098\uC624\uB294\\n\uD034\uC988\uB97C \uB9DE\uD788\uB294 \uAC83\uBFD0\uC774\uB780\uB2E4![VAR 0114(0013)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB2E8 \uC815\uB2F5\uC744 \uD2C0\uB9AC\uBA74\\n\uBC30\uD2C0 \uC911\uC778 \uB124 \uD3EC\uCF13\uBAAC\uC758\\r\\n\uB2A5\uB825\uC774 \uB5A8\uC5B4\uC9C0\uC9C0...\\c\\n\uBB3C\uB860 \uBC18\uB300\uB85C \uC815\uB2F5\uC744 \uB9DE\uD788\uBA74\\n\uB2A5\uB825\uC774 \uC62C\uB77C\uAC04\uB2E8\uB2E4\\c\\n\uBB50 \uD398\uC5B4\uB9AC\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC758\\n\uC2E0\uBE44\uD55C \uD798\uC774\uB77C\uACE0\uB098 \uD560\uAE4C?[VAR 0114(0013)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC790 \uADF8\uB7FC \uB108\uC758 \uCD5C\uC120\uC744 \uB2E4\uD558\uB294 \uBAA8\uC2B5\uC744\\n\uCC9C\uCC9C\uD788 \uBCF4\uB3C4\uB85D \uD558\uB9C8[VAR 0114(0013)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "[~ 5]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "[~ 6]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[~ 7]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[~ 8]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[~ 9]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "[~ 10]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2DC\uC791\uC785\uB2C8\uB2E4!\\n\uC2E4\uB825\uC744 \uBC1C\uD718\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBBF8\uC158\uC774 \uBB50\uC600\uC8E0?"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uD2B8\uB808\uC774\uB108\uAC00 \uB0B4\uB294 \uBB38\uC81C\uB97C\\n\uB9DE\uD788\uBA74\uC11C \uC2B9\uB9AC\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uBA74 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uD558\uAC8C \uB429\uB2C8\uB2E4\uB9CC\\n\uC815\uB9D0 \uAE30\uAD8C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCD9C\uBC1C\uD558\uC2DC\uC8E0!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC740\\n\uC990\uAC70\uC6B0\uC2E0\uAC00\uC694?"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\n\uD6CC\uB96D\uD558\uAC8C \uD074\uB9AC\uC5B4\uD558\uC168\uAD70\uC694!\\c\\n\uACFC\uC5F0 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uB2D8\uC740\\n\uC5B4\uB5A4 \uD310\uACB0\uC744 \uB0B4\uB838\uC744\uAE4C\uC694?\\c\\n[VAR 0100(0000)]\uB2D8 \uACC4\uC18D\uD574\uC11C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB3C4\uC804\uD560\uAC8C\uC694!"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC74C! \uADF8\uB807\uB2E4\uBA74 \uB4E4\uC5B4\uAC00\uC2DC\uC8E0\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uB2D8\uC744 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB9AC\uD3EC\uD2B8\uB97C \uC4F4\uB2E4\uB4E0\uC9C0\\n\uC5EC\uB7EC \uC900\uBE44\uAC00 \uD544\uC694\uD558\uACA0\uC8E0"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC790 \uADF8\uB7FC \uB124\uAC00 \uD398\uC5B4\uB9AC\uD0C0\uC785\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0 \uC5B4\uC6B8\uB9B4\uC9C0\uC5D0 \uB300\uD55C\\r\\n\uC624\uB514\uC158\uC744 \uC2DC\uC791\uD558\uC790\uAFB8\uB098"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uADF8\uB807\uAD70... \uD3EC\uD50C\uB7EC\uB2D8\uC774\\n\uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uC2E4\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\r\\n\uB098\uB294 \uADF8\uB7ED\uC800\uB7ED \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uAD6C\uB098"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB450 \uBC88\uC9F8 \uD2B8\uB808\uC774\uB108\uC785\uB2C8\uB2E4\\c\\n\uC55E\uC120 \uC9C8\uBB38\uC758 \uACB0\uACFC\uB294\\n\uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uACE0 \uACC4\uC18D \uC9C4\uD589\uD558\uC8E0"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uC815\uB2F5\uC778\uC9C0 \uC624\uB2F5\uC778\uC9C0\\n\uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uACE0 \uACC4\uC18D \uC9C4\uD589\uD558\uC138\uC694"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC740 \uB098\uB780\uB2E4\\c\\n\uB108\uB77C\uBA74 \uD398\uC5B4\uB9AC\uD0C0\uC785\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\\n\uB420 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uAD6C\uB098"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC778\uB370 \uC624\uB514\uC158\uC774\uB77C\uB2C8\\n\uD3EC\uD50C\uB7EC\uB2D8\uB3C4 \uCC38 \uACE4\uB780\uD558\uC2E0 \uBAA8\uC591\uC774\uC57C"
  },
