[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD558\uC544...\\n\uB4DC\uB514\uC5B4 \uC654\uAD6C\uB098[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB098\uB294...\\n\uC815\uB9D0 \uAE00\uB7EC\uBA39\uC740 \uB140\uC11D\uC774\uC57C\\c\\n\uADF8\uB798\uC11C \uC544\uBB34\uB3C4 \uB098\uB97C \uCC3E\uC544\uC8FC\uC9C0\\n\uC54A\uB294 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4[VAR 0114(0042)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD558\uC9C0\uB9CC \uB098\uB294 \uADC0\uAC00 \uBC1D\uC544\uC11C \uB9D0\uC774\uC57C\\n\uC154\uD130\uC5D0 \uB300\uD55C \uC77C\uC740 \uBAA8\uB450 \uB4E4\uC5C8\uB2E8\uB2E4\\c\\n\uC815\uB9D0\uC774\uC9C0 \uD63C\uC790 \uC788\uB294 \uC2DC\uAC04\uC740\\n\uC0AC\uB78C\uC758 \uAC00\uC2B4\uC744 \uC6B8\uAC8C \uB9CC\uB4E0\uB2E8 \uB9D0\uC774\uC9C0[VAR 0114(0042)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB294\\n\uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC774\uB77C\\c\\n\uC2EC\uD50C\uD55C \uC2B9\uBD80\uAC00 \uB418\uACA0\uC9C0\uB9CC\\n\uC870\uAE08\uC774\uB77C\uB3C4 \uC990\uACA8\uC92C\uC73C\uBA74 \uD574[VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uD6C4\uC6B0...[VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB098\uB294!\\n\uC2A4\uD30C\uC774\uD06C\uB9C8\uC744\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5!\\c\\n\uC545\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC758 \uCC9C\uC7AC\\n\uC774\uB984\uD558\uC5EC \uC560\uC218\uC758 \uB450\uC1A1!![VAR 0114(0016)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC9C8 \uAC83\uC744 \uBED4\uD788 \uC54C\uBA74\uC11C\uB3C4\\n\uB0B4\uAC8C \uB3C4\uC804\uD558\uB294 \uC5B4\uB9AC\uC11D\uC740 \uB108\uB97C \uC704\uD574![VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC2E0\uB098\uB294 \uB3D9\uB8CC\uB4E4\uACFC \uD568\uAED8\\n\uAC04\uB2E4~! \uC2A4\uD30C\uC774\uD06C\uB9C8\uC744!![VAR 0114(0016)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB108\uC640 \uC2F8\uC6B8 \uC218 \uC788\uC5B4\uC11C \uC990\uAC70\uC6E0\uC5B4\\c\\n\uB0B4 \uD3EC\uCF13\uBAAC\uB4E4\uC774\\n\uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uACE0 \uC788\uB294 \uBAA8\uC591\uC774\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC545\uC758 \uCCB4\uC721\uAD00 \uBC30\uC9C0\\n\uC545\uBC30\uC9C0\uB97C \uC904\uAC8C[VAR 0114(0016)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB808\uBCA8 55\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uC774 \uC720\uB2C8\uD3FC\uB3C4 \uBC1B\uC544...\\c\\n\uB0B4\uAC00 \uB77C\uC774\uBE0C \uACF5\uC5F0\uC744 \uD55C\uB2E4\uBA74\\n\uAD7F\uC988\uB85C \uD314\uACE0 \uC2F6\uC740 \uC637\uC774\uC57C[VAR 0114(0016)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0\uB294 \uBD84\uBA85 \uC5EC\uB3D9\uC0DD\uC778 \uB9C8\uB9AC\uAC00\\n\uB3C4\uC804\uD558\uB7EC \uC624\uACA0\uC9C0?[VAR 0114(0016)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  }
]
