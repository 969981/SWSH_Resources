[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC57C\\n\uC6B0\uB9AC \uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD560 \uAC70\uB2C8?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC8E0!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC0DD\uAC01\uD574 \uBCFC\uAC8C\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB3C4\uC804\uD558\uB824\uBA74\\n\uC720\uB2C8\uD3FC\uC744 \uC785\uC5B4\uC918\\r\\n\uD0C8\uC758\uC2E4\uC740 \uC800\uCABD\uC774\uC57C"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC9C0\uAE08\uBD80\uD130 \uC788\uC744\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0 \uD544\uC694\uD55C\\c\\n\uD568\uC815\uD0D0\uC9C0\uBA38\uC2E0\uC744\\n\uBC1B\uC544\uC918!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB2E4\uC18C \uBB34\uB9AC\uB97C \uD574\uC57C\uB9CC\\n\uB3CC\uD30C\uD560 \uC218 \uC788\uB294 \uAC83\uB3C4 \uC788\uC9C0"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0 \uB3C4\uC804\uD558\uB7EC \uC654\uAD6C\uB098!\\c\\n\uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uB9D0\uC740\\n\uAD73\uAC8C \uBA39\uC740 \uB9C8\uC74C\uC740 \uBC14\uC704\uB3C4 \uB6AB\uB294\uB2E4\uC57C!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC720\uB2C8\uD3FC\uC774\\n\uC815\uB9D0 \uC798 \uC5B4\uC6B8\uB9AC\uB124!"
  }
]
