    "text": "\uBA87 \uC2DC\uAC04 \uD6C4..."
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC65C \uC774\uB807\uAC8C \uB2A6\uB294 \uAC70\uC57C!\\n\uC774\uC0C1\uD574![VAR 0114(0005)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uD615\uC740 \uC5B4\uB5A4 \uC57D\uC18D\uB3C4 \uC9C0\uD0A4\uB294 \uC0AC\uB78C\uC774\uC57C\\c\\n\uCC54\uD53C\uC5B8\uC774 \uB41C \uAC83\uB3C4\\n\uB098\uC640 \uC57D\uC18D\uD588\uB358 \uAC70\uC600\uB2E4\uACE0![VAR 0114(0005)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC800\uB141 \uC57D\uC18D\uC744 \uC9C0\uD0A4\uB294 \uAC83 \uC815\uB3C4\uB294\\n\uC2DD\uC740 \uC8FD \uBA39\uAE30\uC778 \uAC70 \uC544\uB2C8\uC57C?[VAR 0114(0005)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCC38 \uC2DC\uB044\uB7EC\uC6B4 \uB140\uC11D\uC774\uAD6C\uB098\\c\\n\uADF8\uB807\uAC8C \uB5A0\uB4E4 \uC5EC\uB825\uC774 \uC788\uC5C8\uB2E4\uBA74\\n\uC2DC\uD569\uC5D0\uC11C \uC880 \uB354 \uD798\uC744 \uB0B4\uBCF4\uC9C0 \uADF8\uB7AC\uB2C8?[VAR 0114(0016)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uB098\uC05C \uC0AC\uB78C \uAC19\uC740 \uBAA8\uC2B5\uC73C\uB85C\\n\uBC14\uB978\uB9D0 \uD558\uC9C0 \uB9C8\uC138\uC694 \uB450\uC1A1\uB2D8!\\r\\n\uC800\uB294 \uC9C4\uC9C0\uD558\uB2E4\uAD6C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAC89\uBAA8\uC2B5\uC73C\uB85C \uB0A8\uC744 \uD310\uB2E8\uD558\uB294 \uAC78 \uBCF4\uB2C8\\n\uB124\uAC00 \uC774\uAE30\uC9C0 \uBABB\uD55C \uAC83\uB3C4 \uC774\uD574\uAC00 \uAC00\uB124[VAR 0114(0016)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uCC54\uD53C\uC5B8\uC774\uB77C\uBA74\\n\uB85C\uC988\uD0C0\uC6CC\uC5D0 \uAC14\uB2E8\uB2E4[VAR 0114(0016)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC5B4\uC9F8\uC11C\uC694?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB85C\uC988\uD0C0\uC6CC?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uAE00\uC384 \uC798\uC740 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uBAA8\uB178\uB808\uC77C \uD0C0\uB294 \uACF3\uC5D0\uC11C \uB9C8\uC8FC\uCCE4\uC5C8\uC5B4\\c\\n\uB85C\uC988\uD0C0\uC6CC\uC5D0 \uAC00\uC57C \uD558\uB2C8\uAE4C\\n\uC57D\uC18D\uC5D0 \uB2A6\uC744 \uAC70\uB77C\uACE0\\r\\n\uB108\uD76C\uC5D0\uAC8C \uC804\uD574\uB2EC\uB77C\uB354\uAD6C\uB098[VAR 0114(0016)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB85C\uC988\uD0C0\uC6CC\uC694?\\n\uC774\uC81C \uC640\uC11C \uBB34\uC2A8 \uC77C\uC774\uC9C0?[VAR 0114(0005)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB450\uC1A1\uB2D8 \uC804\uD574\uC8FC\uB7EC \uC624\uC2E0 \uAE40\uC5D0\\n\uB85C\uC988\uD0C0\uC6CC\uAE4C\uC9C0 \uC548\uB0B4\uD574\uC8FC\uC138\uC694\\c\\n\uC800\uB3C4 [VAR 0100(0000)]\uB3C4\\n\uB85C\uC988\uD0C0\uC6CC\uAC00 \uC5B4\uB514 \uC788\uB294\uC9C0 \uBAA8\uB974\uAC70\uB4E0\uC694[VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774\uB7F0... \uC815\uB9D0\uC774\uC9C0 \uC0AC\uB78C\uC744\\n\uC544\uBB34\uB807\uC9C0\uB3C4 \uC54A\uAC8C \uBD80\uB824\uBA39\uB294 \uD615\uC81C\uB4E4\uC774\uB85C\uAD70[VAR 0114(0016)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uADF8\uB798...\\c\\n\uB098\uB3C4 \uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\uAC00\\n\uAC1C\uCD5C\uB418\uC9C0 \uC54A\uC73C\uBA74 \uACE4\uB780\uD558\uB2C8\uAE4C \uB3C4\uC640\uC904\uAC8C\\c\\n\uBB34\uC5C7\uBCF4\uB2E4\uB3C4 \uB098\uB97C \uC774\uAE34\\n\uB108\uD76C\uB4E4\uC774 \uC369 \uC2EB\uC9C4 \uC54A\uAC70\uB4E0[VAR 0114(0016)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC88B\uC544! \uC610\uB2E8\uACFC \uB2E4 \uAC19\uC774\\n\uB85C\uC988\uD0C0\uC6CC\uB85C \uB180\uB7EC \uAC00\uBCFC\uAE4C![VAR 0114(0016)]"
  },
  {
    "index": 16,
