[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB300\uB2E8\uD558\uAD6C\uB098\\n[VAR 0100(0000)]\uAD70![VAR 0114(0006)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uACFC\uC5F0 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uAC00\uB77C\uB974\uAC00 \uC790\uB791\uD558\uB294\\n\uBB34\uC801\uC758 \uCC54\uD53C\uC5B8\uC774\\r\\n\uC120\uD0DD\uD55C \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC57C![VAR 0114(0006)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC774\uC57C~ \uB108\uC640 \uCC54\uD53C\uC5B8\uC758\\n\uCC54\uD53C\uC5B8\uB9E4\uCE58\uAC00 \uC815\uB9D0 \uBCF4\uACE0 \uC2F6\uC5C8\uB294\uB370!\\c\\n\uB108\uC758 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uBB3C\uAC70\uD488\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC11C\\n\uC815\uB9D0 \uBBF8\uC548\uD558\uB2E4![VAR 0114(0006)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0\uB9CC \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E8\uB2E4...\\c\\n\uD55C\uC2DC\uB77C\uB3C4 \uBE68\uB9AC\\n\uC5D0\uB108\uC9C0 \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uAE30 \uC704\uD574\\c\\n\uBB34\uD55C\uB2E4\uC774\uB178\uB97C \uAE68\uC6E0\uB294\uB370\\n\uC81C\uC5B4\uD558\uC9C0 \uBABB\uD588\uAC70\uB4E0\\r\\n\uADF8\uB7F0\uB370 \uCC54\uD53C\uC5B8\uC740 \uC2DC\uD569\uC744 \uD3EC\uAE30\uD558\uBA74\uC11C\uAE4C\uC9C0\\r\\n\uC774\uB7F0 \uB098\uB97C \uAD6C\uD558\uAE30 \uC704\uD574 \uB2EC\uB824\uC654\uC9C0[VAR 0114(0006)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB9C8\uCE58 \uC6A9\uC73C\uB85C\uBD80\uD130 \uACF5\uC8FC\uB2D8\uC744\\n\uC9C0\uD0A4\uB294 \uAE30\uC0AC\uCC98\uB7FC \uB9D0\uC774\uC57C![VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC6CC\uB099\\n\uC5F0\uC124\uC744 \uC88B\uC544\uD558\uB2E4 \uBCF4\uB2C8\\c\\n\uC774\uC57C\uAE30\uAC00 \uAF64 \uAE38\uC5B4\uC84C\uC9C0\uB9CC\\n\uC2AC\uC2AC \uB05D\uB0B4\uB3C4\uB85D \uD558\uB9C8[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC9C0\uAE08\uCBE4 \uC704\uCE35\uC5D0\uC11C \uCC54\uD53C\uC5B8\uC774\\n\uBB34\uD55C\uB2E4\uC774\uB178\uB97C \uC7A1\uC558\uC744 \uD14C\uB2C8\uAE4C \uB9D0\uC774\uB2E4\\c\\n\uAD81\uAE08\uD558\uBA74\\n\uB9AC\uD504\uD2B8\uB97C \uD0C0\uACE0 \uC62C\uB77C\uAC00 \uBCF4\uB834[VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC790, \uB098\uD55C\uD14C \uC838\uC11C \uB108\uB35C\uB108\uB35C\uD574\uC9C4\\n\uD638\uBE0C\uAD70\uB3C4 \uC62C\uB77C\uAC08 \uAC70\uC9C0?\\c\\n\uADF8\uB7FC \uB458\uC774\uC11C \uCC54\uD53C\uC5B8\uC758\\n\uBAA8\uC2B5\uC744 \uBCF4\uACE0 \uC624\uAC70\uB77C![VAR 0114(0006)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB108\uB35C\uB108\uB35C\uD574\uC84C\uB2E4\uAD6C\uC694...?\\n\uC704\uC6D0\uC7A5\uB2D8 \uBB58 \uBAA8\uB974\uC2DC\uB124\\r\\n\uB098\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4 \uC544\uC9C1 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC558\uB2E4\uAD6C\uC694!\\c\\n\uC704\uC6D0\uC7A5\uB2D8\uC774 \uAC1C\uCD5C\uD55C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uD1B5\uD574\uC11C \uBC30\uC6B4 \uAC8C \uC788\uC73C\uB2C8\uAE4C\uC694![VAR 0114(0005)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "[VAR 0100(0000)]!\\n\uB09C \uAC01\uC624\uB97C \uB2E4\uC84C\uC5B4!\\r\\n\uB108\uB294 \uC900\uBE44 \uB410\uC5B4?[VAR 0114(0005)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC9C0!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC7A0\uAE50 \uAE30\uB2E4\uB824"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB0B4 \uB77C\uC774\uBC8C\uC774\uC57C!\\n\uC88B\uC544! \uD615\uC744 \uB3C4\uC6B0\uB7EC \uAC00\uC790![VAR 0114(0005)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0A0\uC9C0 \uBAA8\uB974\uB2C8\uAE4C\\n\uC644\uBCBD\uD558\uAC8C \uC900\uBE44\uD574\uB450\uC790[VAR 0114(0005)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uB9AC\uD504\uD2B8\uB97C \uD0C0\uBA74\\n\uC704\uCE35\uC73C\uB85C \uAC08 \uC218 \uC788\uB2E8\uB2E4[VAR 0114(0006)]"
  }
]
