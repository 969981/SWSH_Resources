[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5D4\uC9C4\uC2DC\uD2F0 \uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC758\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC740~!\\c\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC544\uC11C\\n\uB9CE\uC740 \uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD558\uAE30\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "5\uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD558\uBA74 \uD074\uB9AC\uC5B4\uC785\uB2C8\uB2E4!\\c\\n\uCC38\uACE0\uB85C \uD3EC\uC778\uD2B8\uB294 \uD480\uC232\uC5D0 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74 1\uD3EC\uC778\uD2B8\\r\\n\uC7A1\uC73C\uBA74 2\uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4\\c\\n\uB2E8, \uD3EC\uCF13\uBAAC\uACFC\uC758 \uC2B9\uBD80\uC5D0\uB294\\n\uB2E4\uB978 \uD2B8\uB808\uC774\uB108\uB3C4 \uD568\uAED8\uD569\uB2C8\uB2E4"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uB9D0\uD574 \uC0C1\uB300\uAC00 \uC5B4\uB5BB\uAC8C \uB098\uC62C\uC9C0\\n\uC0DD\uAC01\uD558\uBA74\uC11C \uCD5C\uC120\uC758 \uD589\uB3D9\uC744 \uCDE8\uD574\\r\\n\uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD558\uB294 \uAC83\uC774 \uC911\uC694\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uADF8\uB7FC! \uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2A4\uD0C0\uD2B8!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBBF8\uC158\uC774 \uBB50\uC600\uC8E0?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uACE0 \uC2F6\uC5B4\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "5\uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD558\uBA74 \uD074\uB9AC\uC5B4\uC785\uB2C8\uB2E4!\\c\\n\uD3EC\uC778\uD2B8\uB294 \uD480\uC232\uC5D0 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74 1\uD3EC\uC778\uD2B8\\r\\n\uC7A1\uC73C\uBA74 2\uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE30\uAD8C\uD558\uBA74 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uD558\uAC8C \uB429\uB2C8\uB2E4\uB9CC\\n\uC815\uB9D0 \uAE30\uAD8C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC5D0 \uB610 \uB3C4\uC804\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD6CC\uB96D\uD558\uAC8C \uD074\uB9AC\uC5B4\uD558\uC168\uAD70\uC694!\\n\uCD95\uD558\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB2E4\uC74C\uC740 \uBD88\uAF43\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\\n\uC21C\uBB34\uB2D8\uACFC\uC758 \uC2B9\uBD80\uC785\uB2C8\uB2E4!\\r\\n\uAC00\uB77C! \uCC4C\uB9B0\uC800!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!\\n\uADF8\uB7FC \uAC00\uB77C! \uCC4C\uB9B0\uC800!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!\\n\uADF8\uB7FC \uC900\uBE44\uD574\uC8FC\uC2DC\uC8E0"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCD9C\uBC1C\uD558\uC2DC\uC8E0!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uC2A4\uD0C0\uD2B8!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uC885\uB8CC!!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC758 \uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\n\uD074\uB9AC\uC5B4\uD558\uB2E4\uB2C8! \uC774\uB807\uAC8C \uB728\uAC70\uC6B8 \uC218\uAC00!"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uD074\uB9AC\uC5B4\uB97C \uCD95\uD558\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "[~ 20]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBD88\uAF43 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\\n\uD074\uB9AC\uC5B4\uAE4C\uC9C0 \uC55E\uC73C\uB85C [VAR 0200(0001)]\uD3EC\uC778\uD2B8\\n\uD0C0\uC62C\uB77C\uB77C! (\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC21C\uBB34)"
  },
