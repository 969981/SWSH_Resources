    "text": "[~ 32]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uC774\uB7F4 \uC218\uAC00! [VAR 0100(0000)] \uC120\uC218\\n\uB180\uB78D\uAC8C\uB3C4 0\uD3EC\uC778\uD2B8\uB85C \uB9C8\uBB34\uB9AC\uD569\uB2C8\uB2E4...[VAR 0114(0018)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uBAA9\uD45C\uB294 \uC624\uB85C\uC9C0 \uC57C\uC0DD \uD3EC\uCF13\uBAAC!\\n\uD2B8\uB808\uC774\uB108\uB294 \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uACA0\uC5B4!"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uB2E4\uB978 \uCCB4\uC721\uAD00 \uD2B8\uB808\uC774\uB108\uB4E4\uC740\\n\uB098\uBCF4\uB2E4 \uAC15\uD558\uB2C8\uAE4C \uC870\uC2EC\uD558\uB77C\uACE0!"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uC0C1\uD0DC \uC774\uC0C1\uC774\uC57C\uB9D0\uB85C \uCD5C\uAC15\uC758 \uC804\uBC95\uC774\uC57C!\\n\uD654\uC0C1\uC744 \uC785\uC73C\uBA74 \uC704\uD5D8\uD558\uB2E4\uACE0!"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB9CC\uBCD1\uD1B5\uCE58\uC81C\uAC00 \uC788\uC73C\uBA74\\n\uC5B4\uB5A4 \uC0C1\uD0DC \uC774\uC0C1\uC774\uB4E0 \uB0AB\uAC8C \uD560 \uC218 \uC788\uC5B4!"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uC0C1\uD669\uC744 \uC0B4\uD53C\uBA74\uC11C\\n\uB178\uB9B4 \uC0C1\uB300\uB97C \uBC14\uAFC0 \uAC70\uC57C!"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uBD88\uAF43\uC758 \uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\n\uC27D\uAC8C \uB3CC\uD30C\uD558\uAC8C \uB450\uC9C0 \uC54A\uC544!"
  }
