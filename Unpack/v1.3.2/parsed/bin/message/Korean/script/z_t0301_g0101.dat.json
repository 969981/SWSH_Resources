[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD480\uD0C0\uC785\uC5D0 \uAC15\uD55C \uAC83\uC740\\n\uBD88\uAF43\uD0C0\uC785... \uAE30\uBCF8\uC774\uC9C0\uC694"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uD480\uBC30\uC9C0\uB97C \uBC1B\uB2E4\uB2C8\\n\uB300\uB2E8\uD558\uAD70\uC694!\\c\\n\uC9C0\uAE08\uACFC \uAC19\uC740 \uAE30\uC138\uB85C\\n\uBB3C\uBC30\uC9C0\uB3C4 \uC5BB\uC73C\uBA74 \uC88B\uACA0\uB124\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uB4E3\uC790 \uD558\uB2C8 \uCCB4\uC721\uAD00 \uBBF8\uC158\uC744\\n\uD074\uB9AC\uC5B4\uD558\uC9C0 \uC54A\uC73C\uBA74 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uACFC\\r\\n\uC2B9\uBD80\uB97C \uD560 \uC218 \uC5C6\uB300\uC694...\\c\\n\uBB58 \uD558\uAC8C \uB420\uAE4C\uC694?\\n\uC800\uB294 \uB304\uC2A4\uB77C\uBA74 \uC790\uC2E0 \uC788\uB294\uB370..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC6B0\uB974\uB97C \uB4A4\uCAD3\uC544 \uAC00\uAC8C \uD558\uB2E4\uB2C8...\\n\uC544\uD0AC\uB2D8\uC740 \uC758\uC678\uB85C \uC9D3\uAD82\uC740 \uC0AC\uB78C\uC778 \uAC83 \uAC19\uC544\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uAD6C\uB098\\c\\n\uD480\uBC30\uC9C0\uB97C \uBC1B\uC73C\uBA74\\n\uB108\uB97C \uAE30\uC5B5\uD574\uC904\uAC8C"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB108 [VAR 0100(0000)][VAR 1900(0006)]\uB77C\uACE0 \uD558\uB294\uAD6C\uB098!\\n\uAD49\uC7A5\uD558\uB2C8\uAE4C \uD32C\uC774 \uB418\uC5B4 \uC904\uAC8C"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uBD80\uAE30\uC774!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC800 \uC544\uC774\uB3C4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\\n\uCC38\uAC00\uC790\uC778\uAC00?"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC544\uD0AC\uB2D8\uC744 \uC774\uACBC\uAD6C\uB098!\\n\uBA4B\uC9C4 \uC2DC\uD569\uC774\uC5C8\uC5B4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC800 \uD2B8\uB808\uC774\uB108\\n\uB2E8\uB378\uC774 \uCD94\uCC9C\uD588\uB300"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBB50... \uC81C\uBC95 \uC798\uD558\uB124"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "TV\uC5D0\uC11C \uBCF4\uACE0 \uC788\uC5B4\u266A"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC800 \uD2B8\uB808\uC774\uB108\\n\uD638\uBE0C\uC758 \uB77C\uC774\uBC8C\uC774\uB798"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC800 \uC544\uC774...\\n\uB2E4\uD06C\uD638\uC2A4\uC77C\uC9C0\uB3C4 \uBAB0\uB77C"
  }
]
