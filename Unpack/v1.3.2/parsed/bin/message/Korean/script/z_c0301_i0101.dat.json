[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uC138\uC694\\n\uB860\uB3C4\uB85C\uC81C\uC785\uB2C8\uB2E4\\c\\n\uC800\uD76C\uB294 5\uC131\uAE09 \uD638\uD154\uB85C\uC11C\\n\uC804 \uC138\uACC4\uC5D0\uC11C \uC0AC\uB791\uBC1B\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC800\uB294 \uD504\uB85C\uD398\uC154\uB110\uD55C \uD504\uB7F0\uD2B8 \uC9C1\uC6D0\uC774\uB2C8\uAE4C\uC694!\\n\uB9D0\uC774 \uD1B5\uD558\uC9C0 \uC54A\uB294 \uD3EC\uCF13\uBAAC\uC758\\r\\n\uC0C1\uB2F4\uB3C4 \uB4E4\uC5B4\uC900\uB2F5\uB2C8\uB2E4!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5B8\uC81C\uB098 \uC6C3\uACE0 \uC788\uB2F5\uB2C8\uB2E4!\\n...\uB2E4\uB9AC\uB294 \uD241\uD241 \uBD80\uC5C8\uC9C0\uB9CC"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC790\uAC00\uC6A9 \uC81C\uD2B8\uAE30 \uB300\uC2E0\uC5D0\\n\uC6CC\uAE00\uC744 \uD0C0\uACE0 \uAC00\uB77C\uB974\uC5D0 \uC624\uB290\uB77C\\r\\n\uC9C0\uCCD0\uBC84\uB838\uC5B4...!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC544\uB0B4\uB294 \uC774\uAC83\uC800\uAC83 \uBD88\uD3C9\uC774 \uB9CE\uC9C0\uB9CC \uC0AC\uC2E4\uC740\\n\uD3EC\uCF13\uBAAC\uC744 \uD0C0\uACE0 \uC774\uB3D9\uD558\uB294 \uAC78 \uC88B\uC544\uD55C\uB2E8\uB2E4"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB9E4\uD06C\uB85C\uCF54\uC2A4\uBAA8\uC2A4\uC758 \uCD08\uB300\uB97C \uBC1B\uC544\uC11C\\n\uC2DC\uD569\uC744 \uBCF4\uB7EC \uC654\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC720\uBA85 \uC778\uC0AC\uB3C4 \uBCF4\uB7EC \uC624\uB294 \uC2DC\uD569\uC774\uB77C\uACE0 \uD558\uBA74\\n\uBAA8\uB450\uAC00 \uAD00\uC2EC\uC744 \uAC16\uAC8C \uB418\uB2C8\uAE4C\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB3C4\uC5B4\uB9E8\uC758 \uC77C\uC740 \uD798\uB4E4\uB2F5\uB2C8\uB2E4!\\c\\n\uB9CE\uC740 \uC0AC\uB78C\uC774 \uB4DC\uB098\uB4E4\uC5B4\uB3C4\\n\uC2E4\uC218\uB294 \uC6A9\uB0A9\uB418\uC9C0 \uC54A\uC73C\uB2C8\uAE4C\uC694!\\r\\n\uADF8\uB798\uC11C \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB3C4 \uB3C4\uC6C0\uC744 \uBC1B\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC6E8~\uC5D8~\uCEF4!"
  }
]
