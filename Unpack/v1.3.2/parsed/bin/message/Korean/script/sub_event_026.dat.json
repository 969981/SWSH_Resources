[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC9DC\uC794~!\\c\\n\uBAAC\uC2A4\uD130\uBCFC\uC5D0\uAC8C \uB9D0\uC744 \uAC74\\n\uB108\uC5D0\uAC8C \uC88B\uC740 \uAC83\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uCC38\uACE0\uB85C \uB098\uB294\\n\uBAAC\uC2A4\uD130\uBCFC\uC774 \uC544\uB2C8\uC57C!\\c\\n\uADF8\uB7FC \uB098\uB294 \uB204\uAD6C~\uAC8C?\\n\uC815\uB2F5\uC740 \uBCFC\uAC00\uC774\uC785\uB2C8\uBCFC~!!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC01\uC9C0\uC5D0 \uC788\uB294 \uCCB4\uC721\uAD00 \uC2A4\uD0C0\uB514\uC6C0\uC5D0\uC11C\\n\uBAA8\uB450\uB97C \uC751\uC6D0\uD558\uACE0 \uC788\uC73C\uB2C8\uAE4C\\r\\n\uB9CC\uB098\uAC8C \uB418\uBA74 \uC798 \uBD80\uD0C1\uD574\uBCFC~!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC624\uC624 \uCC54\uD53C\uC5B8!\\n\uB9CC\uB098\uACE0 \uC2F6\uC5C8\uBCFC~!!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uACFC \uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uB2E4 \uBCF4\uBA74\\n\uC5B8\uC820\uAC00\uB294 \uACF5\uC2DD \uB9C8\uC2A4\uCF54\uD2B8\uAC00 \uB420..."
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uB807\uC9C0! \uB098\uC758 \uC751\uC6D0 \uB355\uBD84\uC5D0\\n\uC6B0\uC2B9\uD560 \uC218 \uC788\uC5C8\uB358 \uBCFC\uC774\uB2C8\uAE4C!\\c\\n\uB098\uB97C \uC78A\uC9C0 \uC54A\uB3C4\uB85D\\n\uAE30\uB150 \uAD7F\uC988\uB97C \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC288\uD37C \uB808\uC5B4\uD55C \uB9AC\uADF8 \uCE74\uB4DC!\\n\uB9C8\uB2C8\uC544\uAC00 \uC6B8\uBA74\uC11C \uAE30\uBED0\uD560\\r\\n\uC774\uAC83\uC744 \uB108\uC5D0\uAC8C \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC870\uAE08 \uC6B0\uAE00\uCB48\uAE00\uD574\uC9C4 \uAC74\\n\uB2E4\uB4E4 \uAC16\uACE0 \uC2F6\uC5B4\uD558\uB2E4 \uBCF4\uB2C8 \uADF8\uB807\uAC8C \uB410\uBCFC!\\c\\n\uD3C9\uBC94\uD558\uC9C0\uB9CC \uC9C4\uC815\uD55C \uC758\uBBF8\uC758\\n\uB808\uC5B4\uD55C \uB9AC\uADF8 \uCE74\uB4DC\uC778 \uBCFC\uC774\uC9C0~!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uC55E\uC73C\uB85C\uB3C4 \uB9C8\uC2A4\uCF54\uD2B8\uB85C\uC11C\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC640\\r\\n\uBAA8\uB450\uB97C \uC751\uC6D0\uD558\uACA0\uBCFC~!"
  }
]
