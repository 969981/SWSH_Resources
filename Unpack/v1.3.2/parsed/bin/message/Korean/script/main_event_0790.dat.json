[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBC18\uAC11\uB2E4! \uB0B4\uAC00 \uBD88\uAF43\uD0C0\uC785\uC758\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC21C\uBB34\uB2E4\\c\\n\uD480\uD0C0\uC785\uC758 \uC544\uD0AC\\n\uBB3C\uD0C0\uC785\uC758 \uC57C\uCCAD\uC744 \uC774\uAE30\uACE0\\r\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB2E4\uB2C8 \uB300\uB2E8\uD558\uAD70![VAR 0114(0010)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC5B4\uB5A4 \uD2B8\uB808\uC774\uB108\uB4E0\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC774\uAE30\uAE30 \uC704\uD574\\r\\n\uD2B8\uB808\uC774\uB2DD\uC744 \uD558\uACE0 \uC788\uC9C0?\\c\\n\uD558\uC9C0\uB9CC \uC2F8\uC6B0\uB294 \uC0C1\uB300 \uC5ED\uC2DC\\n\uADF8\uB9CC\uD07C \uB178\uB825\uD558\uACE0 \uC788\uC9C0!\\c\\n\uC2B9\uBD80\uB97C \uD310\uAC00\uB984\uD558\uB294 \uAC83\uC740 \uC2E4\uC804\uC5D0\uC11C \uC5BC\uB9C8\uB9CC\uD07C\\n\uC81C \uC2E4\uB825\uC744 \uBC1C\uD718\uD560 \uC218 \uC788\uB290\uB0D0\uC5D0 \uB2EC\uB838\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC758 \uCCAB \uBC88\uC9F8 \uACE0\uBE44\uB77C\uACE0\\n\uBD88\uB9AC\uB294 \uC774 \uC21C\uBB34\uB97C \uC774\uAE30\uB2E4\uB2C8!\\c\\n\uB108\uC758 \uC7AC\uB2A5\uC774\\n\uB098\uC758 \uC624\uB79C \uACBD\uD5D8\uC744 \uC55E\uC9C8\uB800\uAD6C\uB098!\\r\\n\uB098\uB3C4 \uC544\uC9C1 \uB354 \uBC30\uC6CC\uC57C\uACA0\uC5B4![VAR 0114(0010)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB108\uD76C\uB294 \uD2C0\uB9BC\uC5C6\uC774\\n\uCD5C\uAC15\uC758 \uD300\uC774 \uB420 \uC218 \uC788\uC744 \uAC70\uB2E4!\\r\\n\uC624\uB298 \uB108\uC640 \uC2F8\uC6B8 \uC218 \uC788\uC5B4\uC11C \uCC38 \uAE30\uBEE4\uB2E4![VAR 0114(0010)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB098\uB97C \uC774\uAE34 \uC99D\uD45C\uB85C\\n\uBD88\uAF43\uBC30\uC9C0\uB97C \uC8FC\uB9C8![VAR 0114(0010)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB808\uBCA8 35\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB2E4\uC774\uB9E5\uC2A4\uB85C \uC778\uD574\\n\uC6B0\uB9AC\uC758 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB294\\r\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC758 \uBB38\uD654\uAC00 \uB418\uC5C8\uC9C0[VAR 0114(0010)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uB9AC\uACE0 \uADF8\uB7F0 \uBB38\uD654\uB97C \uC774\uC5B4\uBC1B\uB294 \uAC74\\n\uB108\uD76C \uC80A\uC740 \uD2B8\uB808\uC774\uB108\uB4E4\uC758 \uBAAB\uC774\uB2E4\\c\\n\uBB3C\uB860 \uACE0\uC218\uD558\uB294 \uAC78\uB85C \uB05D\uB0BC \uAC8C \uC544\uB2C8\uB77C\\n\uB108\uD76C \uC190\uC73C\uB85C \uB354\uC6B1 \uBC1C\uC804\uC2DC\uCF1C \uB098\uAC00\uC57C \uD55C\uB2E4!\\r\\n\uC6B0\uB9AC \uC5B4\uB978\uB4E4\uB3C4 \uC9C0\uC6D0\uC744 \uC544\uB07C\uC9C0 \uC54A\uC73C\uB9C8![VAR 0114(0010)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  }
]
