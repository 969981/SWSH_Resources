[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC2DC\uAD70\uC694\\n\uADF8\uB7FC \uC808\uCC28\uB97C \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBA3C\uC800 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uB300\uD574\\n\uAC04\uB2E8\uD558\uAC8C \uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4\\c\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4\uD558\uACE0\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C \uC2B9\uB9AC\uD574\uC11C\\r\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uBAA8\uC73C\uC2DC\uBA74 \uB429\uB2C8\uB2E4!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC54C\uC558\uC5B4\uC694!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC774\uC694?"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0\\n\uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB3C4\uC804\uD560\uAC8C\uC694!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "[VAR FF00(0001)]\uCCB4\uC721\uAD00 \uBBF8\uC158[VAR FF00(0000)]\uC774\uB780\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C \uB3C4\uC804\uD558\uAE30 \uC804\uC5D0 \uC9C4\uD589\uD558\uB294\\r\\n\uC2E4\uB825 \uD14C\uC2A4\uD2B8 \uAC19\uC740 \uAC83\uC785\uB2C8\uB2E4\\c\\n\uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC5D0 \uB530\uB77C\\n\uB2E4\uC591\uD55C \uCCB4\uC721\uAD00 \uBBF8\uC158\uC774 \uC788\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uB3C4\uC804\uD558\uC2DC\uB824\uBA74\\n\uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uC5B4 \uC8FC\uC138\uC694"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uADF8\uB7FC \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4!\\n\uCD5C\uC120\uC744 \uB2E4\uD574\uC8FC\uC138\uC694!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uB54C\uBB38\uC5D0 \uC624\uC168\uAD70\uC694?\\c\\n\uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uB9D0\uC740\\n\uB124\uBC84 \uAE30\uBE0C \uC5C5\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4\uD558\uC168\uAD70\uC694!\\c\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uACFC\uC758 \uC2DC\uD569\uC740\\n\uD3EC\uCF13\uBAAC\uACFC\uC758 \uCF64\uBE44\uB124\uC774\uC158\uC774\\r\\n\uB9E4\uC6B0 \uC911\uC694\uD558\uB2F5\uB2C8\uB2E4!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB124 \uC54C\uACA0\uC2B5\uB2C8\uB2E4!\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB3C4\uC804\uD558\uB7EC \uC624\uC138\uC694!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "[~ 14]"
  }
]
