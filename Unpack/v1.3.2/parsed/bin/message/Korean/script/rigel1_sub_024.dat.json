[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC800\uB294 \uC138\uACC4\uC801\uC73C\uB85C \uC720\uBA85\uD55C\\n\uD328\uC158 \uB514\uC790\uC774\uB108\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC740 \uAC00\uB77C\uB974 \uC0AC\uB78C\uC778\uAC00\uC694?\\n\uAC00\uB77C\uB974\uB294 \uCC98\uC74C\uC785\uB2C8\uB2E4\uB9CC\\r\\n\uC0AC\uB78C\uC744 \uC880\uCC98\uB7FC \uBCFC \uC218 \uC5C6\uB354\uAD70\uC694!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC5EC\uAE30\uB294..."
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC5EC\uAE34 \uAC11\uC637\uC12C\uC774\uC5D0\uC694!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB124\uC5D0!?\\n\uC5ED\uC744 \uD5F7\uAC08\uB838\uB098!?"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC5B4\uCC0C \uB410\uB4E0\\n\uAC00\uB974\uCCD0\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uAC00\uB77C\uB974\uC5D0\uC11C\uB294 \uCC54\uD53C\uC5B8 \uB2E8\uB378\uC758 \uC778\uAE30\uAC00\\n\uC5C4\uCCAD\uB098\uB2E4\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uB2E8\uB378\uC758 \uC778\uAE30\uB97C \uB4F1\uC5D0 \uC5C5\uACE0\\n\uC880 \uB354 \uB9AC\uCE58\uD574\uC9C0\uAE30 \uC704\uD574\\r\\n\uAC00\uB77C\uB974\uB85C \uAC00\uB824\uACE0 \uD588\uC2B5\uB2C8\uB2E4\uB9CC..."
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB4DC\uB113\uC740 \uAC00\uB77C\uB974\uC5D0 \uAC00\uAE30 \uC704\uD55C\\n\uBA38\uB2C8\uAC00 \uBD80\uC871\uD55C \uC0C1\uD669\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uAED8\uC11C \uC81C\uAC00 \uB514\uC790\uC778\uD55C\\n\uB108\uBB34\uB098\uB3C4 \uADC0\uC5EC\uC6B4 \uC758\uC0C1 \uC138\uD2B8\uB97C\\r\\n[VAR 0204(0001,0000)]\uC6D0\uC5D0 \uC0AC\uC8FC\uC2E0\uB2E4\uBA74\\r\\n\uAC00\uB77C\uB974\uB85C \uAC08 \uD0DD\uC2DC\uBE44\uAC00 \uBAA8\uC785\uB2C8\uB2E4\uB9CC..."
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC8FC\uC138\uC694"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uD544\uC694 \uC5C6\uC5B4\uC694"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC774\uB7F4 \uC218\uAC00! \uADF8\uB7FC \uC800\uB294 \uC601\uC6D0\uD788\\n\uC774 \uC12C\uC5D0\uC11C \uC0B4\uC544\uC57C \uD558\uB294 \uAC81\uB2C8\uAE4C!?"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uD6CC\uB96D\uD569\uB2C8\uB2E4!\\n\uADF8\uC57C\uB9D0\uB85C \uB204\uC774 \uC88B\uACE0 \uB9E4\uBD80 \uC88B\uC740 \uC0C1\uD669\uC774\uB124\uC694!!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC790! \uC774\uAC83\uC744 \uBC1B\uC544\uC8FC\uC2DC\uC8E0!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR 01C2(0001)] \uB514\uC790\uC778\uC758\\r\\n[VAR FF00(0008)][VAR 01C1(0002)][VAR FF00(0000)]\\r\\n[VAR FF00(0008)][VAR 01C1(0003)][VAR FF00(0000)]\\r\\n[VAR FF00(0008)][VAR 01C1(0004)][VAR FF00(0000)]\\r\\n[VAR FF00(0008)][VAR 01C1(0005)][VAR FF00(0000)][VAR 1900(0002)]\\r\\n\uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uBD84\uBA85\uD788 \uD504\uB9AC\uBBF8\uC5C4\uC774 \uBD99\uC744 \uAC81\uB2C8\uB2E4!\\n\uC81C\uAC00 \uBCF4\uC7A5\uD558\uC8E0!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC5EC\uAE30\uC11C \uC791\uBCC4\uC785\uB2C8\uB2E4!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC774\uB7F0, \uBA38\uB2C8\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4"
  }
]
