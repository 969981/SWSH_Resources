[
  {
    "index": 0,
    "flags": 0,
    "text": "\uBB50\uC57C... \uB300\uCCB4 \uC5B4\uB5BB\uAC8C \uB41C \uAC70\uC57C!\\n\uC774\uB300\uB85C \uAC00\uB2E4\uAC04 \uD615\uC744 \uB3C4\uC6B8 \uC218 \uC5C6\uC5B4...![VAR 0114(0005)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB34\uC5C7\uC744 \uD560 \uC148\uC774\uC9C0?\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800?[VAR 0114(0006)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBE14\uB799 \uB098\uC774\uD2B8\uB97C \uB9C9\uC744 \uAC70\uC608\uC694!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8\uC744 \uB3C4\uC6B8 \uAC70\uC608\uC694!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC774\uC57C~ \uADF8\uAC70 \uB180\uB77C\uC6B4\uB370?\\n\uD558\uC9C0\uB9CC \uADF8\uAC8C \uBB34\uC2A8 \uC18C\uC6A9\uC778\uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uAD6C\uB098\\c\\n\uBA48\uCD9C \uD544\uC694\uB294 \uC5C6\uC73C\uB2C8\uAE4C \uB9D0\uC774\uB2E4\\c\\n\uC65C\uB0D0\uBA74 \uBE14\uB799 \uB098\uC774\uD2B8... \uC544\uB2C8\uC9C0\\n\uCD5C\uAC15\uC758 \uD3EC\uCF13\uBAAC\\r\\n\uBB34\uD55C\uB2E4\uC774\uB178\uB294 \uC774\uBBF8 \uAE68\uC5B4\uB0AC\uAC70\uB4E0![VAR 0114(0006)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uADF8\uAC74 \uC880 \uACE4\uB780\uD55C \uC598\uAE30\uAD6C\uB098\\c\\n\uCC54\uD53C\uC5B8\uC740 \uC9C0\uAE08 \uBB34\uD55C\uB2E4\uC774\uB178\uB97C\\n\uC81C\uC5B4\uD574\uC57C \uD558\uAC70\uB4E0[VAR 0114(0006)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC124\uBA85\uC774 \uD544\uC694\uD558\uB824\uB098?\\c\\n\uB108\uD76C\uAC00 \uBCF4\uAE30\uC5D0\uB294 \uB0B4\uAC00 \uB054\uCC0D\uD55C \uC9D3\uC744\\n\uBC8C\uC774\uACE0 \uC788\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC774\uACA0\uC9C0?\\r\\n\uC870\uAE08\uB3C4 \uC774\uD574\uAC00 \uAC00\uC9C0 \uC54A\uC744 \uAC70\uC57C\\c\\n\uADF8\uB807\uC9C0\uB9CC \uB0B4\uAC8C\uB294\\n\uAC00\uB77C\uB974\uC9C0\uBC29\uC774 \uC601\uC6D0\uD788\\r\\n\uB9C8\uC74C \uB193\uACE0 \uBC1C\uC804\uD560 \uC218 \uC788\uB3C4\uB85D\\c\\n\uBB34\uD55C\uD55C \uC5D0\uB108\uC9C0\uB97C \uAC00\uC838\uB2E4 \uC918\uC57C \uD55C\uB2E4\uB294\\n\uC2E0\uB150\uACFC \uC0AC\uBA85\uC774 \uC788\uB2E4![VAR 0114(0006)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uADF8\uAC78 \uC704\uD574 \uB098\uB294 \uBB34\uD55C\uB2E4\uC774\uB178\uC5D0\uAC8C\\n\uC18C\uC6D0\uC758\uBCC4\uC744 \uC8FC\uC5C8\uB2E4!\\c\\n\uB108\uD074\uC2DC\uD2F0\uC5D0\uC11C \uC77C\uC5B4\uB09C\\n\uBD89\uC740 \uBE5B\uC758 \uC18C\uB3D9...\\c\\n\uADF8\uAC83\uC740 \uBB34\uD55C\uB2E4\uC774\uB178\uB97C \uAE68\uC6B0\uAE30 \uC704\uD55C\\n\uC77C\uC885\uC758 \uC2E4\uD5D8\uC774\uC5C8\uC9C0!\\c\\n\uC54C\uACA0\uB098? \uB2E4\uC2DC \uB9D0\uD574 \uAC00\uB77C\uB974\uC758 \uBBF8\uB798\uB97C\\n\uC9C0\uD0A4\uAE30 \uC704\uD55C \uB0B4 \uACC4\uD68D\uC744 \uBC29\uD574\uD558\uB294 \uAC74\\r\\n\uC6A9\uB0A9\uD560 \uC218 \uC5C6\uB2E4\uB294 \uB9D0\uC774\uB2E4![VAR 0114(0006)]"
  }
]
