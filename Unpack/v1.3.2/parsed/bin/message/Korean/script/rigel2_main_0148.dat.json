  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uB2E4\uCE58\uC9C0 \uC54A\uC558\uC18C!?"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC608, \uC608\uC5D0...\\n\uBB54\uAC00\uAC00 \uAD6C\uD574\uC900 \uAC83 \uAC19\uC558\uB294\uB370..."
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC190\uB2D8!\\n\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC744 \uAD6C\uD574\uC918\uC11C \uC815\uB9D0 \uACE0\uB9D9\uB124!\\r\\n\uC5B4\uB5BB\uAC8C \uBCF4\uB2F5\uC744 \uD574\uC57C \uD560\uC9C0...[VAR 0114(007A)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC124\uB9C8 \uC774\uD1A0\uB85D \uB09C\uD3ED\uD55C \uD3EC\uCF13\uBAAC\uC774\\n\uC124\uC6D0\uC5D0 \uC788\uC744 \uC904\uC774\uC57C...[VAR 0114(007A)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uB9C8\uCE58 \uB3D9\uD654 \uC18D\uC5D0 \uB098\uC624\uB358\\n\uC655\uC758 \uB09C\uD3ED\uD55C \uC560\uB9C8 \uAC19\uB354\uAD70...[VAR 0114(007A)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "...\uB108\uBB34 \uC9C0\uB098\uCE5C \uC0DD\uAC01\uC778\uAC00?[VAR 0114(007A)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uADF8\uAC83\uC740...\\n\uD558\uC580\uAC08\uAE30?[VAR 0114(007A)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC5B4\uB77C? \uADF8\uAC83\uC740...\\n\uAC80\uC740\uAC08\uAE30?[VAR 0114(007A)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB3D9\uD654 \uC18D\uC5D0\uC11C\uB294\\n\uC655\uC774 \uD53C\uC6CC\uB0B4\uB294 [VAR FF00(0006)]\uBE5B\uB098\uB294 \uAF43[VAR FF00(0000)]\uACFC\\r\\n\uC560\uB9C8\uC758 \uAC08\uAE30\uB97C \uC5EE\uC73C\uBA74[VAR 0114(007A)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uC655\uACFC \uC560\uB9C8\uB97C \uC774\uC5B4\uC8FC\uB294\\n\uC720\uB300\uC758\uACE0\uC090\uB97C \uB9CC\uB4E4 \uC218 \uC788\uB2E4\uB354\uAD70...[VAR 0114(007A)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uB098\uC758 \uC870\uC0C1\uB2D8\uB3C4\\n\uC61B\uB0A0\uC5D0\uB294 \uC804\uD1B5\uC744 \uBC1B\uB4E4\uC5B4\\r\\n\uACE0\uC090\uB97C \uB9CC\uB4E4\uC5B4 \uC654\uC5C8\uB2E4\uACE0 \uD558\uB124[VAR 0114(007A)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uBB50, \uADF8\uB7F0 \uAF43\uC740 \uBCF8 \uC801\uB3C4 \uC5C6\uACE0\\n\uACE0\uC090\uB97C \uB9CC\uB4E4\uB358 \uC804\uD1B5\uB3C4 \uC0AC\uB77C\uC838\uBC84\uB838\uB124\uB9CC...[VAR 0114(007A)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "...\uC5B4\uC774\uCFE0!\\n\uACFC\uAC70\uC758 \uC774\uC57C\uAE30\uB9CC \uD558\uACE0 \uC788\uC744 \uB54C\uAC00 \uC544\uB2C8\uC9C0![VAR 0114(007A)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC880 \uC804\uC758 \uD3EC\uCF13\uBAAC\uC774 \uB610\\n\uB9C8\uC744\uC5D0 \uB098\uC05C \uC9D3\uC744 \uD558\uC9C0 \uBABB\uD558\uAC8C\\r\\n\uB300\uCC45\uC744 \uC0DD\uAC01\uD574\uBD10\uC57C\uACA0\uB124[VAR 0114(007A)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uB2E4\uC2DC \uB9D0\uD558\uC9C0\uB9CC\\n\uB3C4\uC640\uC918\uC11C \uC815\uB9D0\uB85C \uACE0\uB9D9\uB124![VAR 0114(007A)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uC800... \uAD6C\uD574\uC918\uC11C \uACE0\uB9D9\uB124"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uBC29\uAE08 \uADF8 \uD3EC\uCF13\uBAAC\uC740 \uB3D9\uD654 \uC18D\uC758 \uADF8 \uD3EC\uCF13\uBAAC\uC778\uAC00?\\n\uB9CE\uC774 \uB2EE\uC558\uB358 \uAC83 \uAC19\uC740\uB370..."
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB124\uAC00 \uC6B0\uC5F0\uD788 \uC6B0\uB9AC \uB9C8\uC744\uC744 \uCC3E\uC544\uC640\uC918\uC11C\\n\uC5BC\uB9C8\uB098 \uB2E4\uD589\uC778\uC9C0 \uBAA8\uB974\uACA0\uAD6C\uB098!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uCE58\uC77C \uBED4\uD588\uC744 \uB54C\\n\uC655\uAD00\uC744 \uC4F4 \uD3EC\uCF13\uBAAC\uC774 \uAD6C\uD574\uC900 \uAC83 \uAC19\uC740...\\r\\n\uADF8\uB7F0 \uB290\uB08C\uC774 \uB4E4\uC5C8\uB2E8\uB2E4"
