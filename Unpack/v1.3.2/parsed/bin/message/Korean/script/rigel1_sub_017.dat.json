  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uBB50\uC5B4~!? \uB0B4, \uB0B4\uAC00\\n\uC5B4\uB514\uC11C \uBB58 \uD558\uB4E0\\r\\n\uB108\uB791 \uC0C1\uAD00\uC5C6\uB294 \uC77C\uC774\uC796\uC544![VAR 0114(0071)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD06D! \uB0A8\uBAB0\uB798 \uBD80\uC9C0\uB7F0\uD788 \uC218\uD589\uD558\uB294 \uAC74\\n\uC870\uAE08\uB3C4 \uC5D8\uB808\uAC15\uC2A4\uD558\uC9C0 \uC54A\uC740 \uC77C!\\r\\n\uC800\uC57C\uB9D0\uB85C \uB2F9\uC2E0\uC758 \uC9C8\uBB38\uC5D0 \uBBF8\uB7EC\uCF54\uD2B8\uD558\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0072)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBB50\uC5B4~!? \uC798 \uC9C0\uB0B4\uAC70\uB4E0!?\\c\\n\uB108\uB3C4 \uC798 \uC9C0\uB0B4\uB294 \uAC70 \uAC19\uC73C\uB2C8\uAE4C\\n\uCC28\uC554~ \uC798 \uB410\uB124 \uADF8\uB798~[VAR 0114(0071)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uBB50, \uBB61\uB2C8\uAE4C \uB72C\uAE08\uC5C6\uC774...\\c\\n\uB2F9\uC2E0\uBCF4\uB2E4 2\uC5B5 \uBC30\uB85C\\n\uC798 \uC9C0\uB0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4\uB9CC[VAR 0114(0072)]"
