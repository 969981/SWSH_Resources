  {
    "index": 46,
    "flags": 0,
    "text": "\uC774 \uC790\uC2DD! \uD2B8\uB9AD\uC774\uB77C\uB3C4 \uC4F4 \uAC74\uAC00!?\\n\uB0B4 \uB3C4\uBCF5\uC744 \uB3CC\uB824\uC918![VAR 0114(0072)]"
  },
  {
    "index": 47,
    "flags": 0,
    "text": "\uB3C4~\uC639? \uB3C4\uC57C\uC559...?"
