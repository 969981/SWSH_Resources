  {
    "index": 62,
    "flags": 0,
    "text": "\uC9C0\uAE08 \uC774\uB300\uB85C\uB3C4 \uAD1C\uCC2E\uC544!\\c\\n\uC7AC\uBE60\uB978 \uC57C\uB3C8\uC744\\n\uCAD3\uC544\uAC00\uC790!"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uCCAB \uBC88\uC9F8 \uC218\uD589\uC740 \uC7AC\uBE60\uB978\\n\uC57C\uB3C8 3\uB9C8\uB9AC\uB97C \uCAD3\uC544\uAC00\uB294 \uAC70\uB780\uB2E4!\\c\\n\uACB8\uC0AC\uACB8\uC0AC \uC120\uBC30\uC758 \uB3C4\uBCF5\uC138\uD2B8\uB3C4\\n\uCC3E\uC544\uC624\uB3C4\uB85D \uD558\uB834~[VAR 0114(0073)]"
  },
  {
    "index": 64,
    "flags": 0,
    "text": "\uBA4D~\uD558\uB2C8 \uC788\uB294 \uC57C\uB3C8\uB3C4\\n\uC2A4\uC2B9\uB2D8\uC758 \uC190\uC744 \uAC70\uCE58\uBA74\\r\\n\uC800\uB807\uAC8C \uBE68\uB77C\uC9C0\uB294 \uAC74\uAC00...!"
  },
  {
    "index": 65,
    "flags": 0,
    "text": "\uBC29\uAE08 \uADF8 \uBAB8\uB180\uB9BC...\\n\uBC94\uC0C1\uCE58\uAC00 \uC54A\uC558\uC5B4!\\c\\n\uC57C\uB3C8\uB4E4\uB3C4 \uB3C4\uBCF5\uC138\uD2B8\uAC00\\n\uC785\uACE0 \uC2F6\uC5C8\uB358 \uAC78\uAE4C?"
