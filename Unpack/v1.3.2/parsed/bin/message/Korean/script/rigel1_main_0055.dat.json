[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC624\uC608~!\\n\uC2B9\uBD80\uD560 \uC900\uBE44\uB294 \uB410\uB2C8?[VAR 0114(0073)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC758\uC678\uB85C \uB290\uAE0B\uD55C \uC544\uC774\uAD6C\uB098\\n\uB108\uBB34 \uAE30\uB2E4\uB9AC\uAC8C \uD558\uBA74 \uBAB8\uC774 \uADFC\uC9C8\uAC70\uB9B0\uB2E4\uAD6C~![VAR 0114(0073)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC2DC\uC791\uD574 \uBCFC\uAE4C!\\n\uB108\uC5D0 \uB300\uD574 \uB9CE\uC774 \uAC00\uB974\uCCD0\uC8FC\uB824\uBB34\uB098~![VAR 0114(0073)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC640\uD558\uD558! \uB0B4\uAC00 \uC84C\uB2E4!\\n\uB108 \uAC15\uD558\uAD6C\uB098![VAR 0114(0073)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC2A4\uC2B9\uB2D8\uC774 \uC9C4\uC9C0\uD558\uAC8C \uC2B9\uBD80\uD558\uC9C4 \uC54A\uC558\uC9C0\uB9CC\\n\uADF8\uB798\uB3C4 \uC800 \uC2E0\uC785\uC774 \uC774\uAE30\uB2E4\uB2C8...!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uB300\uCCB4 \uBB50 \uD558\uB294 \uB140\uC11D\uC785\uB2C8\uAE4C...?"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB108\uC758 \uBC30\uD2C0\uD558\uB294 \uBAA8\uC2B5\uC744 \uBCF4\uACE0\\n\uD3EC\uCF13\uBAAC\uC744 \uC18C\uC911\uD558\uAC8C \uC5EC\uAE34\uB2E4\uB294 \uAC83\uC744\\r\\n\uB290\uB084 \uC218 \uC788\uC5C8\uB2E8\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "...\uC624\uD574\uB85C \uC778\uD574 \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uB2E4\uC9C0\uB9CC\\n\uB108\uC5D0\uAC8C \uBC30\uC6B8 \uB9C8\uC74C\uC774 \uC788\uB2E4\uBA74[VAR 0114(0073)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC740 \uC5B8\uC81C\uB4E0\uC9C0\\n\uD658\uC601\uC774\uB2C8\uAE4C[VAR 0114(0073)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uCE5C\uAD6C\uB4E4\uACFC \uD568\uAED8\\n\uAC15\uD574\uC838 \uBCF4\uB824\uBB34\uB098!\\r\\n\uADF8\uB7FC, \uC798 \uBD80\uD0C1\uD55C\uB2E4~![VAR 0114(0073)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uADF8\uB7F0 \uB73B\uC5D0\uC11C\\n\uB108\uC5D0\uAC8C \uB3C4\uBCF5\uC138\uD2B8\uB97C \uC8FC\uB9C8[VAR 0114(0073)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uB3C4\uBCF5\uC744 \uC785\uC5C8\uC73C\uB2C8 \uB108\uB3C4 \uC774\uC81C\\n\uB9C8\uC2A4\uD130 \uB3C4\uC7A5\uC758 \uC5B4\uC5FF\uD55C \uC77C\uC6D0\uC774\uB780\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR FF00(0008)]\uB3C4\uBCF5\uC138\uD2B8[VAR FF00(0000)]\uB97C \uC190\uC5D0 \uB123\uC5C8\uB2E4!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC544! \uC2E0\uC785!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC637\uC744 \uAC08\uC544\uC785\uAC70\uB098 \uC26C\uACE0 \uC2F6\uC744 \uB54C\uB294\\n\uC800\uCABD\uC5D0 \uC788\uB294 \uBC29\uC744 \uC4F0\uB3C4\uB85D \uD574!"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "...\uC790 \uADF8\uB7FC![VAR 0114(0073)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[VAR 0100(0000)][VAR 1900(0003)] \uC640\uC900 \uB355\uBD84\uC5D0\\n\uB3C4\uC7A5\uC758 \uC815\uC6D0\uB3C4 \uB2E4 \uCC3C\uC73C\uB2C8\uAE4C[VAR 0114(0073)]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC9C0\uAE08\uBD80\uD130 \uB108\uD76C\uC5D0\uAC8C\\n[VAR FF00(0006)]\uC138 \uAC00\uC9C0 \uC218\uD589[VAR FF00(0000)]\uC744 \uC9C0\uC2DC\uD558\uB9C8![VAR 0114(0073)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uC138 \uAC00\uC9C0 \uC218\uD589...!?"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uB3C4\uC7A5\uC5D0\\n\uC815\uC6D0 \uAC19\uC740 \uAC8C \uC788\uC5C8\uC5B4...!?"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uC138 \uAC00\uC9C0 \uC218\uD589\uC744\\n\uBAA8\uB450 \uD074\uB9AC\uC5B4\uD55C \uC0AC\uB78C\uC5D0\uAC8C\uB294\\c\\n\uC190\uC5D0 \uB123\uC73C\uBA74 \uC2B9\uB9AC\uB97C \uBD80\uB974\uB294\\n\uB3C4\uC7A5 [VAR FF00(0006)]\uBE44\uC804\uC758 \uAC11\uC637[VAR FF00(0000)]\uC744\\r\\n\uC804\uC218\uD560 \uAC70\uB780\uB2E4![VAR 0114(0073)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBE44\uC804\uC758 \uAC11\uC637!?\\n\uAF2D \uAC00\uC9C0\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uD6C4\uD6C4\uD6C4! \uC88B\uC544 \uC88B\uC544~!\\c\\n\uBA3C\uC800 \uCCAB \uBC88\uC9F8 \uC218\uD589\uC5D0 \uB300\uD574\\n\uC124\uBA85\uD574\uC8FC...[VAR 0114(0073)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC544\uC559~ \uC2A4\uC2B9\uB2D8~!\\n\uB3C4\uC815\uC774\uB294 \uC544\uC9C1\\r\\n\uB3C4\uBCF5\uC138\uD2B8 \uC5C6\uB294\uB370~[VAR 0114(0071)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uC800\uAE30~ \uC2A4\uC2B9\uB2D8!\\n\uC800\uB294 \uC544\uC9C1\\r\\n\uB3C4\uBCF5\uC138\uD2B8\uB97C \uBC1B\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4\uB9CC![VAR 0114(0072)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uC7E4\uD55C\uD14C\uB9CC \uC8FC\uB2E4\uB2C8 \uB108\uBB34\uD574\uC694~!\\n\uB3C4\uC815\uC774 \uC2AC\uD37C\uC694~![VAR 0114(0071)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC2E0\uC785\uC5D0\uAC8C\uB9CC \uC8FC\uB294 \uAC74 \uBD88\uACF5\uD3C9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C!\\n\uC800\uB3C4 \uB3C4\uBCF5\uC73C\uB85C \uAD50\uCCB4\uB97C \uC694\uAD6C\uD569\uB2C8\uB2E4![VAR 0114(0072)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC5B4\uB77C~? \uADF8\uB7AC\uC5C8\uB098?\\n\uBBF8\uC548 \uBBF8\uC548~![VAR 0114(0073)]"
