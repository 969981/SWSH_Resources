[
  {
    "index": 0,
    "flags": 0,
    "text": "\uD658\uC601\uD569\uB2C8\uB2E4 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\\n\uC800\uB294 \uCC44\uB450\uC785\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uC774 \uACFC\uC5F0 \uC5B4\uB5A4 \uACF5\uACA9\uC5D0\uB3C4\\n\uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uB9C8\uC74C\uC744 \uAC00\uC84C\uB294\uC9C0\\r\\n\uC81C\uAC00 \uC2DC\uD5D8\uD574\uBCF4\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uD734\uC6B0...\\n\uC0C1\uB300\uD558\uBA74\uC11C \uC54C \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uB2F9\uC2E0\uACFC \uC2B9\uBD80\uD558\uBA74\uC11C...\\n\uC800\uB3C4 \uBAA8\uB974\uAC8C\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uC990\uAE30\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4\\c\\n\uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uAC83\uC774 \uC2B9\uBD80\uB77C\uBA74\\n\uC990\uAE30\uB294 \uAC83 \uB610\uD55C \uC2B9\uBD80\uACA0\uC8E0[VAR 0114(0011)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uAC10\uC0AC\uD569\uB2C8\uB2E4\\n\uACA9\uD22C\uBC30\uC9C0\uB97C \uBC1B\uC544\uC8FC\uC138\uC694[VAR 0114(0011)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB808\uBCA8 40\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uC744 \uC218 \uC788\uAC8C \uB410\uB2E4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC55E\uC73C\uB85C\uB3C4 \uB9CE\uC740\\n\uB9CC\uB0A8\uACFC \uC2DC\uD569\uC774 \uC788\uC744 \uAC81\uB2C8\uB2E4\\c\\n\uADF8 \uBAA8\uB4E0 \uAC83\uC774 \uB2F9\uC2E0\uC758 \uB9C8\uC74C\uC5D0\\n\uC790\uC591\uBD84\uC774 \uB420 \uC218 \uC788\uAE30\uB97C \uAE30\uC6D0\uD558\uACA0\uC2B5\uB2C8\uB2E4[VAR 0114(0011)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "[VAR 0100(0000)]! \uCCB4\uC721\uAD00 \uAD00\uC7A5\\n\uCC44\uB450\uB2D8\uC5D0\uAC8C \uC2B9\uB9AC\uD55C \uAC83\uC744\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD55C\uB2E4!\\c\\n\uAE30\uB150\uC73C\uB85C\\n\uC774 \uAE30\uC220\uBA38\uC2E0\uC744 \uBC1B\uC73C\uB834!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uACA9\uD22C\uD0C0\uC785\uC758 \uC720\uB2C8\uD3FC\uC774\uC57C\\n\uC774\uAC83\uB3C4 \uAE30\uB150\uC73C\uB85C \uAC00\uC838\uAC00\uB834"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uACA9\uD22C\uBC30\uC9C0\uAC00 \uC798 \uC5B4\uC6B8\uB9AC\uB294\uAD6C\uB098!\\n[VAR 0100(0000)]! \uC55E\uC73C\uB85C\uB3C4 \uD798\uB0B4\uB834!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC811\uC218\uCC98\uB85C \uB3CC\uC544\uAC00\uACA0\uC2B5\uB2C8\uAE4C?"
  }
]
