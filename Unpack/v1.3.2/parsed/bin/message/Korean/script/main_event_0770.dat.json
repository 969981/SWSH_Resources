[
  {
    "index": 0,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC!\\c\\n\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uB824\uBA74\\n\uD130\uD504\uB9C8\uC744\uC758 \uD480\uBC30\uC9C0\uC640\\r\\n\uBC14\uC6B0\uB9C8\uC744\uC758 \uBB3C\uBC30\uC9C0\uAC00 \uD544\uC694\uD558\uB2E4!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC624\uC624 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC!\\n2\uAC1C\uC758 \uBC30\uC9C0\uB97C \uBAA8\uC73C\uB2E4\uB2C8 \uD6CC\uB96D\uD558\uB2E4!\\c\\n\uC21C\uBB34\uB2D8\uC740 \uC9C0\uAE08 \uD2B9\uD6C8\uD558\uB7EC\\n\uC81C2\uAD11\uC0B0\uC5D0 \uAC00\uC168\uB2E4\\r\\n\uBC14\uC6B0\uB9C8\uC744 \uCABD\uC73C\uB85C \uAC00\uBCF4\uB3C4\uB85D \uD574\uB77C"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC774\uACF3\uAE4C\uC9C0 \uC798 \uC654\uB2E4!\\n\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uC5EC!\\c\\n\uC6B0\uB9AC\uC758 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uB294 \uC5C4\uACA9\uD574\uC11C\\n\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD560 \uC218 \uC788\uB294 \uC790\uB294 \uB9CE\uC9C0 \uC54A\uC9C0\\r\\n\uC790 \uADF8\uB7FC \uBC14\uB85C \uC808\uCC28\uB97C \uC9C4\uD589\uD558\uC790!"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uB3C4\uC804\uD560\uAC8C\uC694!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC54C\uC558\uB2E4! \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uD14C\uB2C8\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB3C4\uC804\uD558\uB7EC \uC624\uAC70\uB77C!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC9C0\uC5D0 \uB3C4\uC804\uD558\uAE30 \uC804\uC5D0\\n\uBA3C\uC800 \uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uC5B4\uB77C!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158 \uD074\uB9AC\uC5B4\uB97C\\n\uCD95\uD558\uD55C\uB2E4! \uD6CC\uB96D\uD558\uB2E4!\\c\\n\uC55E\uC73C\uB85C \uC788\uC744 \uC21C\uBB34\uB2D8\uACFC\uC758 \uC2DC\uD569...\\n\uB204\uAC00 \uB354 \uB728\uAC70\uC6CC\uC9C0\uB0D0\uC5D0 \uB2EC\uB838\uACA0\uAD70!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uBD88\uAF43\uC758 \uCCB4\uC721\uAD00 \uBBF8\uC158\uC740 \uC0C9\uB2E4\uB978 \uB290\uB08C\uC774\uC9C0!\\n\uC790 \uB4E4\uC5B4\uAC00\uB77C!"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uAE30\uB150\uC73C\uB85C\\n\uC774 \uAE30\uC220\uBA38\uC2E0\uC744 \uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC774 \uC785\uACE0 \uC788\uB294 \uAC83\uACFC\\n\uAC19\uC740 \uB514\uC790\uC778\uC758 \uC720\uB2C8\uD3FC\uB3C4 \uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC21C\uBB34\uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD560 \uC218 \uC788\uB294 \uC790\uAC00 \uC801\uC740 \uB9CC\uD07C\\n\uC21C\uBB34\uB2D8\uC744 \uC774\uAE34 \uC790\uB294 \uB354\uB354\uC6B1 \uC801\uC9C0\\r\\n\uB124\uAC00 \uC5B4\uB514\uAE4C\uC9C0 \uAC15\uD574\uC9C8 \uC218 \uC788\uC744\uC9C0 \uAE30\uB300\uB418\uB294\uAD70!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uD558\uB7EC \uC654\uAD70!\\n\uD3EC\uC778\uD2B8\uB97C \uB9C8\uAD6C \uC313\uC544\uBCF4\uC544\uB77C!"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "[~ 13]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC624! [VAR 0100(0000)]!\\n\uC21C\uBB34\uB2D8\uACFC\uC758 \uC2B9\uBD80\uB294 \uC815\uB9D0 \uB728\uAC70\uC6E0\uC5B4![VAR 0114(0005)]"
  }
]
