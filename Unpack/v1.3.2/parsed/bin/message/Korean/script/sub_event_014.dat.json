  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uCE5C\uD574\uC9C0\uACE0 \uC2F6\uB2E4\uB294 \uC99D\uD45C\uB85C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uD504\uB80C\uB4DC\uBCFC\uB85C\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC73C\uBA74\\c\\n\uB108\uB791 \uAE08\uBC29\\n\uCE5C\uD574\uC9C0\uAC8C \uB420 \uAC70\uC57C\uBCFC\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uB09A\uC2EF\uB300\uB97C \uAC00\uC9C0\uACE0 \uC788\uB294 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB8E8\uC5B4\uBCFC\uC740 \uB09A\uC2DC\uB85C \uB09A\uC544 \uC62C\uB9B0\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC838\\c\\n\uBB3C\uD0C0\uC785\uC744 \uC88B\uC544\uD55C\uB2E4\uBA74\\n\uB531 \uC88B\uC740 \uBCFC\uC774\uB2E4 \uC774 \uBCFC\uC774\uC57C~\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uB808\uBCA8\uC774 \uB192\uC544 \uBCF4\uC774\uB294 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uB808\uBCA8\uBCFC\uC740 \uB124 \uD3EC\uCF13\uBAAC\uBCF4\uB2E4\\n\uC0C1\uB300 \uD3EC\uCF13\uBAAC\uC758 \uB808\uBCA8\uC774 \uB0AE\uC744\uC218\uB85D\\r\\n\uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uB294 \uBCFC\uC774\uB2E4 \uC774 \uBCFC\uC774\uC57C~\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uAC00\uBC29\uC774 \uBB34\uAC70\uC6CC \uBCF4\uC774\uB294 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uD5E4\uBE44\uBCFC\uC740 \uBB34\uAC70\uC6B4 \uD3EC\uCF13\uBAAC\uC77C\uC218\uB85D\\n\uC7A1\uAE30 \uC26C\uC6CC\uC838\\c\\n\uC911\uB7C9\uAE09 \uD3EC\uCF13\uBAAC\uC744 \uC88B\uC544\uD55C\uB2E4\uBA74\\n\uC548\uC131\uB9DE\uCDA4\uC778 \uBCFC\uC774\uC9C0\uBCFC\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uAC00\uBC29\uC774 \uBB34\uAC70\uC6CC \uBCF4\uC774\uB294 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uD5E4\uBE44\uBCFC\uC740 \uBB34\uAC70\uC6B4 \uD3EC\uCF13\uBAAC\uC77C\uC218\uB85D\\n\uC7A1\uAE30 \uC26C\uC6CC\uC838\\c\\n\uC911\uB7C9\uAE09 \uD3EC\uCF13\uBAAC\uC744 \uC88B\uC544\uD55C\uB2E4\uBA74\\n\uC548\uC131\uB9DE\uCDA4\uC778 \uBCFC\uC774\uC9C0\uBCFC\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uB7EC\uBE0C\uAC00 \uB118\uCCD0\uB098\uB294 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uB7EC\uBE0C\uB7EC\uBE0C\uBCFC\uC740 \\n\uC2B9\uBD80\uC5D0 \uB098\uAC00 \uC788\uB294 \uB124 \uD3EC\uCF13\uBAAC\uACFC\\r\\n\uC0C1\uB300 \uD3EC\uCF13\uBAAC\uC758 \uC131\uBCC4\uC774 \uB2E4\uB974\uBA74\\r\\n\uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uB294 \uBCFC\uC774\uB2E4 \uC774 \uBCFC\uC774\uC57C~\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uC18C\uC6D0\uC758\uBCC4\uC5D0\uAC8C \uC120\uD0DD\uBC1B\uC740 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBB38\uBCFC\uC740 \\n\uB2EC\uC758\uB3CC\uB85C \uC9C4\uD654\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uB294 \uBCFC\uC774\uC9C0\uBCFC\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uC18C\uC6D0\uC758\uBCC4\uC5D0\uAC8C \uC120\uD0DD\uBC1B\uC740 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBB38\uBCFC\uC740 \\n\uB2EC\uC758\uB3CC\uB85C \uC9C4\uD654\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uB294 \uBCFC\uC774\uC9C0\uBCFC\\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uC6B0\uB9AC\uC758 \uCE5C\uAD6C\\n\uBCFC\uAC00\uC774\uAC00 \uC654\uC5B4\uBCFC~!\\c\\n\uAFC8\uC744 \uAC00\uC9C0\uACE0 \uC788\uB294 \uB108\uC5D0\uAC8C\\n\uBA4B\uC9C4 \uBCFC\uC744 \uC8FC\uACA0\uBCFC!"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB4DC\uB9BC\uBCFC\uC740 \uC7A0\uB4E0 \uD3EC\uCF13\uBAAC\uC744\\n\uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uB294\\r\\n\uAFC8 \uAC19\uC740 \uBCFC\uC774\uB2E4 \uC774 \uBCFC\uC774\uC57C\\c\\n\uCD5C\uBA74\uC220\uC774\uB098 \uD558\uD488\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC73C\uB85C \uC2DC\uD5D8\uD574\uBD10\uBCFC! \\c\\n\uC774\uC57C~ \uC815\uB9D0\uC774\uC9C0\\n\uBCFC\uC5D0\uB294 \uC2EC\uC624\uD55C \uBA74\uC774 \uC788\uC5B4\uBCFC~"
