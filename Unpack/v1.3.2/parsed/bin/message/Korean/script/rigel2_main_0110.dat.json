  },
  {
    "index": 58,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655?\\c\\n\uADF8\uB7F0 \uAC8C \uC9C4\uC9DC\uB85C \uC788\uB2E4\uBA74\\n\uC774 \uBD88\uBAA8\uC9C0\uB97C \uC5B4\uB5BB\uAC8C \uC880 \uD574\uC92C\uC74C \uC88B\uACA0\uAD6C\uBA3C"
  },
  {
    "index": 59,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655\uC774 \uBB50\uAC00 \uC5B4\uCA0C\uB2E4\uACE0?\\n\uBD84\uBA85\uD788 \uBED0\uB4DC\uB801\uB2C8\uC778\uAC00 \uD558\uB294 \uC774\uB984\uC774\uC5C8\uC9C0?\\r\\n...\uD30C\uD2B8\uB77C\uC288\uC600\uB098?"
  },
  {
    "index": 60,
    "flags": 0,
    "text": "\uC655 \uD3EC\uCF13\uBAAC \uB9D0\uC774\uB0D0?\\c\\n\uC5B4\uB838\uC744 \uC801 \uD560\uBA38\uB2C8\uC5D0\uAC8C\\n\uB4E4\uC740 \uC801\uC774 \uC788\uB2E8\uB2E4\\r\\n...\uB2E4 \uC61B\uB0A0\uC774\uC57C\uAE30\uC9C0"
  },
  {
    "index": 61,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655?\\n\uC61B\uB0A0\uC5D4 \uBBFF\uC5C8\uC5C8\uC9C0\\c\\n\uBC2D\uC5D0\uC11C \uC7A5\uB09C\uC744 \uCE58\uBA74\\n\uC655\uC5D0\uAC8C \uBAB8\uC744 \uBE7C\uC557\uAE34\uB2E4\uACE0 \uB9D0\uC774\uC57C"
  },
  {
    "index": 62,
    "flags": 0,
    "text": "\uC774\uB7F0 \uC774\uB7F0, \uBBF8\uC548\uD558\uAD6C\uB098\\n\uC9C0\uAE08\uC740 \uBA4D\uD558\uB2C8 \uC788\uB290\uB77C \uBC14\uC058\uB2E8\uB2E4"
  },
  {
    "index": 63,
    "flags": 0,
    "text": "\uD48D\uC694\uC758 \uC655\uC744 \uAE30\uC5B5\uD558\uACE0 \uC788\uB0D0\uACE0?\\n...\uBB3C\uB860\uC774\uB2E4\uB9C8\uB2E4!\\c\\n\uD504\uB9AC\uC988\uB9C8\uC744\uC758 \uAD00\uAD11 \uBA85\uBB3C\uC774\uC9C0!\\n\uC2E4\uC81C\uB85C \uC874\uC7AC\uD588\uB354\uB77C\uBA74\\r\\n\uC190\uB2D8\uC774 \uB354 \uB9CE\uC774 \uCC3E\uC544\uC654\uC744 \uD150\uB370 \uB9D0\uC774\uC9C0...[VAR 0114(007A)]"
  },
