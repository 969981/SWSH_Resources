    "index": 0,
    "flags": 0,
    "text": "\uCE74\uBB34 \uCE74\uBB34~[VAR 0114(0042)]"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC815\uCCB4\uBD88\uBA85\uC758 \uD3EC\uCF13\uBAAC\uC740\\n\uD798\uACA8\uB8E8\uAE30\uAC00 \uD558\uACE0 \uC2F6\uC740 \uBAA8\uC591\uC774\uB2E4..."
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uBCFC\uC744 \uC900\uBE44\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uCE74 \uBB34\uCE84\uBB34\uB974![VAR 0114(0042)]"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uBB34\uBB34\uBB34\uBB34...[VAR 0114(0042)]"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uBB34~\uBB34[VAR 0114(0042)]"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uC815\uCCB4\uBD88\uBA85\uC758 \uD3EC\uCF13\uBAAC\uC740\\n\uC5B4\uB9AC\uB465\uC808\uD55C \uD45C\uC815\uC744 \uC9C0\uC5B4 \uBCF4\uC600\uB2E4"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uCE74 \uCE74\uBB34~ \uD06C\uB77C\uC6B0\\n\uBE14\uB8F8 \uBB34\uCE74\uC774 \uCE84\uB9AC[VAR 0114(0042)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uB108\uB294 \uB204\uAD6C...?"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC7AC\uBC0C\uC5C8\uC5B4?"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uBB34 \uC774\uB974 \uCE74\uBD80\uB974\\n\uC6B4\uC6B4\uB77C\uC6B0 \uD06C\uB77C\uC6B0[VAR 0114(0042)]"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC6C0 \uB9AC \uD06C\uB77C\uC6B0\uCE74\uBB34\\n\uB77C\uC6B4\uC6B4 \uCE87\uCE74\uBB34[VAR 0114(0042)]"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uB9AC\uCE84 \uBB34 \uCE74\uBB34~\\n\uCE74~\uBB34 \uB9AC\uB77C\uC6B0\uBD80\uB974![VAR 0114(0042)]"
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uBB34~\uBB34\uBB34...[VAR 0114(0042)]"
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC5B4\uC774 \uC5B4\uC774, \uBB34\uC2A8 \uC77C\uC774\uC57C!?\\n\uBB50\uAC00 \uC774\uB807\uAC8C \uC18C\uB780\uC2A4\uB7EC\uC6CC!?[VAR 0114(0076)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBB50\uC57C, \uB300\uC7A5!\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD558\uACE0 \uC788\uB358 \uAC70\uC57C!?[VAR 0114(0076)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "[~ 16]"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uC544...?[VAR 0114(0076)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uBB50\uC57C \uC800 \uC655\uBA38\uB9AC\uB294!?!?[VAR 0114(0076)]"
  },
  {
    "index": 19,
    "flags": 0,
    "text": "\uC6C0 \uBB34\uC774\\n\uCE74\uBB34 \uCE74\uBB34~[VAR 0114(0042)]"
  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBB50, \uBB50\uC9C0?[VAR 0114(0076)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uB728\uC545!?[VAR 0114(0076)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uB290\uC544\uC544\uC544\uC545...[VAR 0114(0076)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "......[VAR 0114(0077)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uD760, \uC5ED\uC2DC \uAC15\uC778\uD55C \uC721\uCCB4\uB85C\uAD70[VAR 0114(0077)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uBBF8\uC548\uD558\uC9C0\uB9CC\\n\uC7A0\uC2DC \uBE4C\uB9AC\uB3C4\uB85D \uD558\uACA0\uB2E4[VAR 0114(0077)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uD53C\uC624\uB2C8 \uB300\uC7A5?"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uD3EC\uCF13\uBAAC?"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "\uB2F9\uC5F0\uD55C \uBC18\uC751\uC774\uC9C0\uB9CC\\n\uB0B4 \uB300\uB2F5\uC740 \u201C\uC544\uB2C8\uB2E4\u201D\uB2E4[VAR 0114(0077)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uD638\uC624... \uC774\uBBF8 \uC0C1\uD669\uC744 \uC774\uD574\uD558\uACE0 \uC788\uB2E4\uB2C8\\n\uADF8\uB300\uB294 \uACFC\uC5F0 \uBE44\uBC94\uD55C \uC790\uB85C\uAD70[VAR 0114(0077)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uB098\uB294 \uBC84\uB4DC\uB809\uC2A4\\n\uD48D\uC694\uC758 \uC655\uC774\uB77C \uBD88\uB9AC\uB294 \uC790\uB2E4[VAR 0114(0079)]"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uC6B0\uC120 \uADF8\uB300\uC5D0\uAC8C\\n\uAC10\uC0AC\uB97C \uD45C\uD574\uC57C\uACA0\uAD70[VAR 0114(0079)]"
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uB098\uC758 \uC870\uAC01\uC0C1\uC744 \uC6D0\uB798\uB300\uB85C \uB418\uB3CC\uB824\uC918\uC11C\\n\uB354\uD560 \uB098\uC704 \uC5C6\uC774 \uAC10\uC0AC\uD560 \uB530\uB984\uC774\uB124[VAR 0114(0079)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uBA3C \uC61B\uB0A0, \uB098\uB294 \uC774 \uB545\uC5D0\\n\uC655\uC73C\uB85C \uAD70\uB9BC\uD588\uC5C8\uB2E4[VAR 0114(0079)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uCD08\uBAA9\uC744 \uC790\uB77C\uAC8C \uD558\uACE0\\n\uBC2D\uC5D0\uB294 \uC5F4\uB9E4\uB97C \uB9FA\uAC8C \uD558\uC5EC\\r\\n\uC778\uAC04\uB4E4\uC758 \uCD94\uC559\uC744 \uBC1B\uC558\uC5C8\uC9C0[VAR 0114(0079)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uD5C8\uB098, \uC624\uB79C \uC138\uC6D4\uC774 \uD758\uB7EC\\n\uC778\uAC04\uB4E4\uC740 \uB098\uC758 \uC874\uC7AC\uB97C\\r\\n\uCC28\uCE30 \uC78A\uC5B4\uAC14\uB2E4[VAR 0114(0079)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uB9E4\uB144 \uB098\uC5D0\uAC8C \uBC14\uCE58\uB358 \uACF5\uBB3C\uB3C4\\n\uC774\uC81C\uB294 \uC5C6\uC5B4\uC9C4 \uC9C0 \uC624\uB798\uC9C0[VAR 0114(0079)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uADF8\uB4E4\uC758 \uBBFF\uC74C\uC740\\n\uB0B4 \uD798\uC758 \uC6D0\uCC9C...[VAR 0114(0079)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uACB0\uAD6D \uB098\uB294 \uACFC\uAC70\uC758 \uD798\uC744 \uC783\uC5B4\uBC84\uB9AC\uACE0\\n\uB098\uC758 \uC560\uB9C8\uB3C4 \uB2EC\uC544\uB098\uBC84\uB838\uB2E4...[VAR 0114(0079)]"
  },
  {
    "index": 39,
    "flags": 0,
    "text": "\uD558\uC9C0\uB9CC \uADF8\uB300\uAC00 \uB098\uC758 \uC870\uAC01\uC0C1 \uC870\uAC01\uC744\\n\uB07C\uC6CC\uC900 \uB355\uBD84\uC5D0...[VAR 0114(0079)]"
  },
  {
    "index": 40,
    "flags": 0,
    "text": "\uC778\uAC04\uC758 \uC721\uCCB4\uB97C \uBE4C\uB824\\n\uB9C8\uC74C\uC744 \uC804\uD560 \uC218 \uC788\uC744 \uB9CC\uD07C\uC740\\r\\n\uD798\uC744 \uB418\uCC3E\uAC8C \uB418\uC5C8\uB2E4[VAR 0114(0079)]"
  },
  {
    "index": 41,
    "flags": 0,
    "text": "\uC790\uC560\uB85C\uC6B4 \uC5B4\uB9B0 \uC778\uAC04\uC774\uC5EC...\\n\uADF8\uB300\uC5D0\uAC8C \uBD80\uD0C1\uC774 \uC788\uB2E4[VAR 0114(0079)]"
  },
  {
    "index": 42,
    "flags": 0,
    "text": "[~ 42]"
  },
  {
    "index": 43,
    "flags": 0,
