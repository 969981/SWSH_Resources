  },
  {
    "index": 50,
    "flags": 0,
    "text": "\uB9C8\uC744 \uC0AC\uB78C\uB4E4 \uBAA8\uB450\uAC00 \uD48D\uC694\uC758 \uC655\uC744\\n\uAE30\uC5B5\uD558\uACE0 \uC788\uB294\uC9C0 \uD55C\uBC88 \uBB3C\uC5B4\uBD10 \uC8FC\uAC8C[VAR 0114(0079)]"
  },
  {
    "index": 51,
    "flags": 0,
    "text": "\uB0B4\uAC00 \uC9C1\uC811 \uBB3C\uC5B4\uBCF8 \uC801\uB3C4 \uC788\uB124\uB9CC\\n\uB3D9\uD654 \uC18D \uC0DD\uBB3C \uCDE8\uAE09\uC744 \uB2F9\uD558\uAC70\uB098\\r\\n\uB9C8\uC744\uC774 \uC18C\uB780\uC2A4\uB7EC\uC6CC\uC9C4 \uC801\uB3C4 \uC788\uC5B4\uC11C \uB9D0\uC774\uC57C...[VAR 0114(0079)]"
  },
  {
