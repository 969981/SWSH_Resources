    "text": "\uD55C\uC815\uB41C \uB2E4\uC774\uBC84\uC12F\uC744 \uB450\uACE0 \uBC8C\uC5B4\uC9C4\\n\uBE8F\uACE0 \uBE7C\uC557\uAE30\uB294 \uACBD\uC7C1...\\c\\n\uC870\uAE08 \uC804\uC758 \uC218\uD589\uC740\\n\uC81C\uBC95 \uC794\uC778\uD588\uB358 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4"
  },
  {
    "index": 73,
    "flags": 0,
    "text": "\uC218\uD504 \uB2F9\uBC88\uC5D0 \uAC78\uB9AC\uC9C0 \uC54A\uC544\uC11C \uB2E4\uD589\uC774\uC57C!"
  },
  {
    "index": 74,
    "flags": 0,
    "text": "\uC2A4\uC2B9\uB2D8\uC774 \uBD80\uB974\uC9C0 \uC54A\uC558\uC5B4?\\n\uBE68\uB9AC \uAC00\uBD10"
  },
  {
    "index": 75,
    "flags": 0,
    "text": "\uC57C\uB3C8 \uCAD3\uAE30 \uB2E4\uC74C\uC740\\n\uBC84\uC12F \uCC44\uC9D1...\\c\\n\uB9C8\uC9C0\uB9C9 \uC218\uD589\uC740 \uB300\uCCB4 \uBB58\uAE4C?"
  },
  {
    "index": 76,
    "flags": 0,
    "text": "\uC218\uD589 \uD074\uB9AC\uC5B4\uD55C \uAC70 \uCD95\uD558\uD574~!"
  },
  {
    "index": 77,
    "flags": 0,
    "text": "\uC218\uD589\uC744 \uD074\uB9AC\uC5B4\uD55C \uC790\uB294\\n\uADF8\uB300\uC640 \uB3C4\uC815\uBFD0\uC778\uAC00...\\r\\n\uACB0\uC804\uC758 \uB0A0\uC774 \uB2E4\uAC00\uC624\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uB294\uAD70!"
  },
  {
    "index": 78,
    "flags": 0,
    "text": "\uC218\uD589\uC744 \uD074\uB9AC\uC5B4\uD55C \uC790\uB294\\n\uADF8\uB300\uC640 \uC138\uC774\uBC84\uB9AC\uBFD0\uC778\uAC00...\\r\\n\uACB0\uC804\uC758 \uB0A0\uC774 \uB2E4\uAC00\uC624\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uB294\uAD70!"
  },
  {
    "index": 79,
    "flags": 0,
    "text": "\uB2E4\uC774\uC218\uD504, \uB9DB\uC788\uC5C8\uC5B4!"
  },
  {
    "index": 80,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uC218\uD504 \uB2F9\uBC88\uC740\\n\uC694\uB9AC \uC2E4\uB825\uC774 \uB300\uB2E8\uD558\uB2E8\uB2E4!\\r\\n\uCC29\uC2E4\uD788 \uD2B9\uD6C8\uC744 \uD588\uAC70\uB4E0[VAR 0114(0074)]"
  }
