[
  {
    "index": 0,
    "flags": 0,
    "text": "\uC5B4\uC11C \uC624\uC138\uC694 \uCCB4\uC721\uAD00 \uCC4C\uB9B0\uC800\uB2D8!\\n\uB3C4\uC804\uD558\uC2E4 \uAC74\uAC00\uC694?"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uBB3C\uB860\uC774\uC8E0!"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uC0DD\uAC01\uD574 \uBCFC\uAC8C\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!\\c\\n\uADF8\uB7FC \uD0C8\uC758\uC2E4\uC5D0\uC11C\\n\uC720\uB2C8\uD3FC\uC73C\uB85C \uAC08\uC544\uC785\uACE0 \uB098\uC624\uC2DC\uBA74\\r\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC744 \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC9C0\uAE08\uBD80\uD130 \uC788\uC744\\n\uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0 \uD544\uC694\uD55C\\c\\n\uD568\uC815\uD0D0\uC9C0\uBA38\uC2E0\uC744\\n\uBC1B\uC544\uC8FC\uC138\uC694!"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4! \uADF8\uB7FC\\n\uB2E4\uC74C\uC5D0 \uB610 \uC640\uC8FC\uC138\uC694"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uCCB4\uC721\uAD00 \uBBF8\uC158\uC5D0 \uB3C4\uC804\uD558\uB7EC \uC624\uC168\uAD70\uC694!\\c\\n\uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uB9D0\uC740\\n\uBE59\uC0B0\uC758 \uC77C\uAC01\uC774\uB78D\uB2C8\uB2E4!"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC720\uB2C8\uD3FC\uC774\\n\uC815\uB9D0 \uC798 \uC5B4\uC6B8\uB9AC\uC2DC\uB294\uAD70\uC694!"
  }
]
