  },
  {
    "index": 5,
    "flags": 0,
    "text": "[VAR 0100(0000)]\uC784\uB2E4!"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uB108\uB791 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uC774\uB984\uC774\uB124!\\n\uBD80\uBAA8\uB2D8\uAED8 \uACE0\uB9C8\uC6CC\uD574\uC57C\uACA0\uB294\uAC78![VAR 0114(0078)]"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uC5E5? \uBB50\uC57C \uADF8 \uB9D0\uD22C\uB294?\\n\uB300\uBC15 \uC6C3\uAE30\uB2E4~[VAR 0114(0078)]"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uADF8\uAC74 \uADF8\uB807\uACE0, \uC544\uBE60\uB3C4 \uC5EC\uAE30 \uC628 \uAC70\uC57C?\\c\\n\uB09C \uBCF8 \uC801 \uC5C6\uB294\uB370...\\n\uD5E4\uB9E4\uB2E4 \uC785\uAD6C\uB85C \uB3CC\uC544\uAC14\uC73C\uB824\uB098?[VAR 0114(0078)]"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC544! \uC544\uAE4C\uB294\\n\uB110 \uC774\uC6A9\uD574\uC11C \uBBF8\uC548\uD588\uC5B4~[VAR 0114(0078)]"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uC6B0\uB9AC \uC544\uBE60\uAC00 \uC6CC\uB099 \uB048\uC9C8\uACA8\uC11C \uB9D0\uC774\uC57C~\\n\uD639\uC2DC \uBB34\uC2A8 \uC77C \uC788\uC5C8\uB358 \uAC74 \uC544\uB2C8\uC9C0?[VAR 0114(0078)]"
