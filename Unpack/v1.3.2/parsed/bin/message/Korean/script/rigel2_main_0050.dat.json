  },
  {
    "index": 20,
    "flags": 0,
    "text": "\uBB50~!?\\n\uC544\uBE60\uB97C \uC774\uACBC\uB2E4\uACE0~!?[VAR 0114(0078)]"
  },
  {
    "index": 21,
    "flags": 0,
    "text": "\uBB50~!?\\n\uC544\uBE60\uC640 \uC2B9\uBD80\uB97C \uACA8\uB918\uB2E4\uACE0~!?[VAR 0114(0078)]"
  },
  {
    "index": 22,
    "flags": 0,
    "text": "\uBC14\uCE89\uC2A4 \uC911\uC774\uB77C\uACE0\uB294 \uD558\uC9C0\uB9CC\\n\uC804\uC9C1 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC5C8\uB2E4\uAD6C![VAR 0114(0078)]"
  },
  {
    "index": 23,
    "flags": 0,
    "text": "\uC544\uBE60\uB3C4 \uCC38~\\n\uC774\uBC88 \uC5EC\uD589\uC5D0 \uC5B4\uCC0C\uB098 \uACF5\uC744 \uB4E4\uC774\uB358\uC9C0[VAR 0114(0078)]"
  },
  {
    "index": 24,
    "flags": 0,
    "text": "\uB098\uB791 \uAC19\uC774 \uC774 \uC9C0\uC5ED\uC758 \uC804\uC124\uACFC \uAD00\uB828\uB41C\\n\uD0D0\uD5D8 \uD22C\uC5B4? \uAC19\uC740 \uAC78\\r\\n\uC9C4\uC9C0\uD558\uAC8C \uD558\uB824\uB294 \uC0DD\uAC01\uC778 \uAC83 \uAC19\uC740\uB370[VAR 0114(0078)]"
  },
  {
    "index": 25,
    "flags": 0,
    "text": "\uB2E4 \uD070 \uB538 \uC785\uC7A5\uC5D0\uC11C\\n\uC774 \uB098\uC774\uC5D0 \uC544\uBE60\uC640 \uB2E8\uB458\uC774 \uADF8\uB7F0 \uAC78 \uD558\uAE30\uB294\\r\\n\uC880 \uBD80\uB044\uB7FD\uB2E4\uACE0\uB098 \uD560\uAE4C...[VAR 0114(0078)]"
  },
  {
    "index": 26,
    "flags": 0,
    "text": "\uC560\uCD08\uC5D0 \uB098\uB294 \uB2E4\uC774\uB9E5\uC2A4\uD55C \uD3EC\uCF13\uBAAC\uACFC\\n\uC2F8\uC6B0\uACE0 \uC2F6\uB2E8 \uB9D0\uC774\uC9C0~[VAR 0114(0078)]"
  },
  {
    "index": 27,
    "flags": 0,
    "text": "\uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uAC70\uB300\uD55C \uD3EC\uCF13\uBAAC\uACFC \uC2B9\uBD80\uD560 \uB54C\\n\uB290\uAEF4\uC9C0\uB294 \uADF8 \uC9DC\uB9BF~\uD55C \uCF8C\uAC10!\\r\\n\uC0C1\uC0C1\uB9CC \uD574\uB3C4... \uD6C4\uD6C4\uD6C4~[VAR 0114(0078)]"
  },
  {
    "index": 28,
    "flags": 0,
    "text": "...\uC544! \uADF8\uB807\uC9C0!\\n\uB108\uAC00 \uAC15\uD55C \uC0AC\uB78C\uC774\uB77C\uC11C \uD558\uB294 \uB9D0\uC778\uB370~[VAR 0114(0078)]"
  },
  {
    "index": 29,
    "flags": 0,
    "text": "\uB098 \uB300\uC2E0 \uC544\uBE60\uB791 \uAC19\uC774\\n\uD0D0\uD5D8 \uD22C\uC5B4\uB97C \uB3CC\uC544\uC8FC\uC9C0 \uC54A\uC744\uB798?![VAR 0114(0078)]"
  },
  {
    "index": 30,
    "flags": 0,
    "text": "\uC7AC\uBC0C\uACA0\uB2E4!"
  },
  {
    "index": 31,
    "flags": 0,
    "text": "\uADF8\uAC74 \uC880 \uACE4\uB780\uD55C\uB370..."
  },
  {
    "index": 32,
    "flags": 0,
    "text": "\uADF8\uCE58 \uADF8\uCE58?!\\n\uB0B4\uAC00 \uC0DD\uAC01\uD574\uB3C4 \uB098\uC774\uC2A4 \uC544\uC774\uB514\uC5B4\uB77C\uB2C8\uAE4C![VAR 0114(0078)]"
  },
  {
    "index": 33,
    "flags": 0,
    "text": "\uAD1C\uCC2E\uC744 \uAC70\uC57C! \uC6B0\uB9AC \uC544\uBE60\uAC00 \uC548 \uADF8\uB798 \uBCF4\uC5EC\uB3C4\\n\uB0A8\uC744 \uC798 \uCC59\uAE30\uB294 \uD0C0\uC785\uC774\uAC70\uB4E0[VAR 0114(0078)]"
  },
  {
    "index": 34,
    "flags": 0,
    "text": "\uAC8C\uB2E4\uAC00, \uC794\uB729 \uB4E4\uB5A0 \uC788\uB294 \uC544\uC800\uC528\uB97C\\n\uD63C\uC790 \uB0B4\uBC84\uB824\uB450\uAE30\uAC00 \uBD88\uC30D\uD558\uAE30\uB3C4 \uD558\uACE0[VAR 0114(0078)]"
  },
  {
    "index": 35,
    "flags": 0,
    "text": "\uC5B4\uCA4C\uBA74 \uB108\uB3C4 \uC804\uC124\uC758 \uD3EC\uCF13\uBAAC\uC744\\n\uB9CC\uB0A0 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC796\uC544![VAR 0114(0078)]"
  },
  {
    "index": 36,
    "flags": 0,
    "text": "\uB098\uB3C4 \uB9E5\uC2A4\uB2E4\uC774\uB9E5\uC2A4\uAD74\uC5D0\uC11C\\n\uB2E4 \uB180\uACE0 \uB098\uBA74 \uD569\uB958\uD560 \uD14C\uB2C8\uAE4C~[VAR 0114(0078)]"
  },
  {
    "index": 37,
    "flags": 0,
    "text": "\uB458\uC774\uC11C \uBA3C\uC800\\n\uC804\uC124\uC744 \uD0D0\uD5D8\uD558\uACE0 \uC788\uC5B4~![VAR 0114(0078)]"
  },
  {
    "index": 38,
    "flags": 0,
    "text": "\uADF8\uB7FC \uC544\uBE60\uD55C\uD14C \uB9D0 \uC798 \uC804\uD574\uC918!\\n\uC798 \uBD80\uD0C1\uD574~![VAR 0114(0078)]"
  }
]
