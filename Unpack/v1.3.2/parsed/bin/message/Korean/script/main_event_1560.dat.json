    "text": "[VAR 0100(0000)] \uC120\uC218!\\n[VAR 0100(0000)] \uC120\uC218!"
  },
  {
    "index": 1,
    "flags": 0,
    "text": "\uC7A0\uAE50 \uC9C8\uBB38\uD574\uB3C4 \uAD1C\uCC2E\uC744\uAE4C\uC694?"
  },
  {
    "index": 2,
    "flags": 0,
    "text": "\uCC54\uD53C\uC5B8 \uB2E8\uB378\uB2D8\uC774\\n\uCD94\uCC9C\uD55C \uD2B8\uB808\uC774\uB108\uB294\\r\\n[VAR 0100(0000)] \uC120\uC218\uC640 \uD638\uBE0C \uC120\uC218\uC600\uC2B5\uB2C8\uB2E4\\c\\n\uB77C\uC774\uBC8C\uC774\uB77C\uACE0 \uD560 \uC218 \uC788\uB294 \uD638\uBE0C \uC120\uC218\uB97C\\n\uC774\uAE34 \uC18C\uAC10\uC744 \uB9D0\uC500\uD574\uC8FC\uC138\uC694"
  },
  {
    "index": 3,
    "flags": 0,
    "text": "\uAE30\uBED0\uC694"
  },
  {
    "index": 4,
    "flags": 0,
    "text": "\uC2E4\uAC10\uC774 \uC548 \uB098\uC694"
  },
  {
    "index": 5,
    "flags": 0,
    "text": "\uC6B4\uC774 \uC88B\uC558\uC5B4\uC694"
  },
  {
    "index": 6,
    "flags": 0,
    "text": "\uADF8\uB807\uAD70\uC694!\\c\\n\uADF8\uB807\uB2E4\uBA74 \uD638\uBE0C \uC120\uC218\uC5D0\uAC8C\\n\uD574\uC904 \uB9D0\uC774 \uC788\uB2E4\uBA74?"
  },
  {
    "index": 7,
    "flags": 0,
    "text": "\uACE0\uB9C8\uC6CC!"
  },
  {
    "index": 8,
    "flags": 0,
    "text": "\uAC15\uD588\uC5B4"
  },
  {
    "index": 9,
    "flags": 0,
    "text": "\uC5ED\uC2DC \uB0B4 \uB77C\uC774\uBC8C\uC774\uC57C"
  },
  {
    "index": 10,
    "flags": 0,
    "text": "\uACFC\uC5F0 \uB77C\uC774\uBC8C\uB2F5\uAD70\uC694\\c\\n\uADF8\uB7FC \uB2E4\uC74C \uC9C8\uBB38\uC785\uB2C8\uB2E4! \uD30C\uC774\uB110 \uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C\\n\uC774\uAE38 \uC790\uC2E0\uC740 \uC788\uC73C\uC2E0\uAC00\uC694?"
  },
  {
    "index": 11,
    "flags": 0,
    "text": "\uC788\uC5B4\uC694!"
  },
  {
    "index": 12,
    "flags": 0,
    "text": "\uC73C\uC74C..."
  },
  {
    "index": 13,
    "flags": 0,
    "text": "\uC5C6\uC5B4\uC694..."
  },
  {
    "index": 14,
    "flags": 0,
    "text": "\uC774\uC81C \uADF8\uB9CC\uD558\uC8E0!\\n[VAR 0100(0000)][VAR 1900(0001)] \uC9C0\uAE08 \uD53C\uACE4\uD558\uB2E4\uAD6C\uC694!\\c\\n\uAC8C\uB2E4\uAC00 \uC740\uADFC\uC2AC\uCA4D \uBB34\uB840\uD55C\\n\uC9C8\uBB38\uB3C4 \uD558\uACE0 \uC788\uC796\uC544\uC694![VAR 0114(0005)]"
  },
  {
    "index": 15,
    "flags": 0,
    "text": "\uBBF8\uC548\uD558\uC9C0\uB9CC \uC6B0\uB9AC\uB294\\n\uD615\uACFC \uC57D\uC18D\uC774 \uC788\uC73C\uB2C8\uAE4C\\r\\n\uC5EC\uAE30\uAE4C\uC9C0 \uD558\uC8E0?[VAR 0114(0005)]"
  },
  {
    "index": 16,
    "flags": 0,
    "text": "\uC54C\uACA0\uC2B5\uB2C8\uB2E4! \uADF8\uB7FC \uC0C8\uB85C\uC6B4 \uC2A4\uD0C0\uC758\\n\uD0C4\uC0DD\uC744 \uAE30\uB300\uD558\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4!!"
  },
  {
    "index": 17,
    "flags": 0,
    "text": "\uD734\uC6B0...\\n\uC720\uBA85\uC778\uC774 \uB41C\uB2E4\uB294 \uAC74 \uD798\uB4E0 \uC77C\uC774\uAD6C\uB098[VAR 0114(0005)]"
  },
  {
    "index": 18,
    "flags": 0,
    "text": "\uD615\uC740 \uBE68\uB9AC \uC548 \uC624\uACE0 \uBB50 \uD558\uB294 \uAC70\uC57C~\\n\uBC30\uACE0\uD30C \uC8FD\uACA0\uB294\uB370![VAR 0114(0005)]"
  }
]
